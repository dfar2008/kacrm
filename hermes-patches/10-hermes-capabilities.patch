@@ -0,0 +1,97 @@
+"""Regression: `resolve_provider_client("custom", explicit_base_url=..., api_mode="anthropic_messages")`
+must hand the Anthropic adapter the *original* `/anthropic` URL, not the
+`_to_openai_base_url`-rewritten `/v1` form.
+
+The bug: `_resolve_auxiliary_client` Step-1 collapses a main runtime with
+`provider: custom:minimax` (and friends) into `resolved_provider="custom"`
+plus `explicit_base_url=runtime_base_url`, and calls
+`resolve_provider_client("custom", ...)`.  The `if provider == "custom":`
+branch was unconditionally running `_to_openai_base_url("https://api.minimaxi.com/anthropic")`
+→ `"https://api.minimaxi.com/v1"`, then `_wrap_if_needed` →
+`_maybe_wrap_anthropic` → `build_anthropic_client`, which strips the trailing
+`/v1` and lets the Anthropic SDK append `/v1/messages`.  The wire request
+landed on `https://api.minimaxi.com/v1/messages` — MiniMax's Anthropic
+surface lives under `/anthropic/v1/messages`, so the gateway returned the
+Go default 404 body `"404 page not found"`.  That cascaded into
+`context_compressor` / `title_generator` aux failures.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for key in (
+        "OPENAI_API_KEY", "OPENAI_BASE_URL",
+        "ANTHROPIC_API_KEY", "ANTHROPIC_TOKEN",
+    ):
+        monkeypatch.delenv(key, raising=False)
+
+
+def test_explicit_custom_anthropic_messages_preserves_anthropic_suffix():
+    """`custom` + explicit `/anthropic` base + api_mode=anthropic_messages
+    must build the Anthropic wrapper against the original URL."""
+    from agent.auxiliary_client import (
+        AnthropicAuxiliaryClient,
+        resolve_provider_client,
+    )
+
+    fake_anthropic = MagicMock(name="anthropic_client")
+    with patch(
+        "agent.anthropic_adapter.build_anthropic_client",
+        return_value=fake_anthropic,
+    ) as build_mock:
+        client, model = resolve_provider_client(
+            "custom",
+            model="MiniMax-M2.7",
+            explicit_base_url="https://api.minimaxi.com/anthropic",
+            explicit_api_key="mm-key",
+            api_mode="anthropic_messages",
+        )
+
+    assert isinstance(client, AnthropicAuxiliaryClient), (
+        f"expected AnthropicAuxiliaryClient, got {type(client).__name__}"
+    )
+    assert model == "MiniMax-M2.7"
+    assert client.base_url == "https://api.minimaxi.com/anthropic", (
+        "base_url leaked into the OpenAI-wire rewrite: SDK would target "
+        f"the wrong path. base_url={client.base_url!r}"
+    )
+    # build_anthropic_client must receive the /anthropic URL (it strips
+    # only a trailing /v1, so /anthropic survives).
+    assert build_mock.call_count == 1
+    called_base = build_mock.call_args.args[1]
+    assert called_base == "https://api.minimaxi.com/anthropic", (
+        f"build_anthropic_client got rewritten URL {called_base!r}; "
+        "the Anthropic SDK would then POST to https://host/v1/messages "
+        "(MiniMax's gateway returns 'page not found' for that path)."
+    )
+
+
+def test_explicit_custom_chat_completions_still_rewrites_to_v1():
+    """Regression guard for the non-anthropic path: a `/anthropic` base
+    with chat_completions api_mode (or no api_mode) must still rewrite
+    to /v1 so OpenAI-wire requests land on /v1/chat/completions."""
+    from agent.auxiliary_client import resolve_provider_client
+
+    with patch("agent.auxiliary_client.OpenAI") as openai_cls:
+        openai_cls.return_value = MagicMock(
+            name="openai_client", base_url="https://api.minimaxi.com/v1",
+        )
+        resolve_provider_client(
+            "custom",
+            model="MiniMax-M2.7",
+            explicit_base_url="https://api.minimaxi.com/anthropic",
+            explicit_api_key="mm-key",
+            api_mode="chat_completions",
+        )
+
+    assert openai_cls.call_count == 1
+    kwargs = openai_cls.call_args.kwargs
+    assert kwargs["base_url"] == "https://api.minimaxi.com/v1", (
+        f"OpenAI-wire path must use the /v1 rewrite, got {kwargs['base_url']!r}"
+    )
