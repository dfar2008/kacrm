+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    approval_id = int(arguments.get("approval_id") or 0)
+    from_uid = int(arguments.get("from_user_id") or 0)
+    to_uid = int(arguments.get("to_user_id") or 0)
+    if approval_id <= 0 or from_uid <= 0 or to_uid <= 0:
+        raise ValueError("approval_id, from_user_id, to_user_id are required")
+    if from_uid == to_uid:
+        raise ValueError("from_user_id and to_user_id must differ")
+
+    from hermes.crm.approval.engine import ApprovalEngine
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        # Caller must be the from-user or an admin.
+        if int(user_id) != from_uid:
+            row = db.fetchone(
+                "SELECT is_admin FROM users WHERE id = %s", (int(user_id),)
+            )
+            if not row or not row.get("is_admin"):
+                return {
+                    "success": False,
+                    "error": "Only the current approver or an admin may transfer",
+                }
+        try:
+            result = ApprovalEngine(db).transfer(approval_id, from_uid, to_uid)
+            return {
+                "success": True,
+                "approval_id": approval_id,
+                "touched_steps": result["touched_steps"],
+                "message": (
+                    f"已转交：{from_uid} → {to_uid}，"
+                    f"影响 {result['touched_steps']} 个步骤。"
+                ),
+            }
+        except ValueError as exc:
+            return {"success": False, "error": str(exc)}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
