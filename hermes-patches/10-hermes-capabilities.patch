+@pytest.mark.parametrize('mode',['chat_completions','bedrock_converse','anthropic_messages'])
+def test_dangling_cap_pairing_and_cleanup(mode):
+    from agent.turn_truncation import continue_dangling_stop, collapse_continuation_trail
+    from agent.turn_retry_state import TurnRetryState
+    normalized=NS(content='建议如下：',tool_calls=None)
+    a=NS(api_mode=mode,_is_anthropic_oauth=False,_get_transport=lambda:NS(normalize_response=lambda *a,**k:normalized),
+         _strip_think_blocks=lambda s:s,log_prefix='',_vprint=lambda *a,**k:None,
+         _build_assistant_message=lambda m,r:{'role':'assistant','content':m.content,'_gen_ms':123})
+    messages=[{'role':'user','content':'start'}]; parts=[]; retry=TurnRetryState()
+    assert continue_dangling_stop(a,object(),'stop',retry,messages,parts)
+    assert continue_dangling_stop(a,object(),'stop',retry,messages,parts)
+    assert not continue_dangling_stop(a,object(),'stop',retry,messages,parts)
+    assert [m['role'] for m in messages]==['user','assistant','user','assistant','user']
+    assert all(isinstance(p,tuple) for p in parts)
+    assert retry.restart_with_length_continuation
+    assert collapse_continuation_trail(a,messages,0,finish_reason='stop')
