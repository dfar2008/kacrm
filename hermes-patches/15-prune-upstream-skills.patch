-### Radial Gradient
-
-```javascript
-function radialGradient(cx, cy, r, innerColor, outerColor) {
-  noStroke();
-  for (let i = r; i > 0; i--) {
-    let t = 1 - i / r;
-    fill(lerpColor(innerColor, outerColor, t));
-    ellipse(cx, cy, i * 2);
-  }
-}
