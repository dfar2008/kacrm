+def _options_csv(options: List[Dict[str, str]] | None) -> str | None:
+    """``module_fields.options`` stays a comma-separated list of *values*.
+
+    The CSV is the canonical storage contract — ``Save.validate``,
+    ``edit_query`` and the ``add_field_option`` route all parse it. The
+    display *labels* for those values live separately in
+    ``field_config.option_labels`` (see :func:`_option_labels`).
+    """
+    if not options:
+        return None
+    return ",".join(
+        str(o.get("value") or "").strip()
+        for o in options
+        if str(o.get("value") or "").strip()
+    ) or None
+
+
+def _option_labels(options: List[Dict[str, str]] | None) -> Dict[str, Any] | None:
+    """Build ``field_config.option_labels`` — {value: {locale: label}}.
+
+    Keeps option display labels out of the format-constrained ``options``
+    column. ``label`` is the zh-CN primary, ``label_en`` the English
+    translation. Read back via ``localize_picklist_options``.
+    """
+    if not options:
+        return None
+    out: Dict[str, Any] = {}
+    for o in options:
+        value = str(o.get("value") or "").strip()
+        if not value:
+            continue
+        entry: Dict[str, str] = {"zh-CN": str(o.get("label") or value).strip()}
+        en = str(o.get("label_en") or "").strip()
+        if en:
+            entry["en-US"] = en
+        out[value] = entry
+    return out or None
+
+
+def _field(
+    name: str,
+    label: str,
+    ftype: str,
+    *,
+    sort_order: int,
+    required: bool = False,
+    readonly: bool = False,
+    is_default: bool = True,
+    is_system: bool = False,
+    is_summary: bool = False,
+    is_searchable: bool = True,
+    options: List[Dict[str, str]] | None = None,
+    system_options: List[str] | None = None,
+    relation: Dict[str, Any] | None = None,
+    width: int | None = None,
+    description: str | None = None,
+) -> Dict[str, Any]:
+    """Build a single ``module_fields`` row spec.
+
+    ``extra`` carries the frontend-widget hint (``interface`` + ``options``
+    / ``relation``) — the kacrm-era ``collection_fields`` table that used
+    to consume this dict is gone (alembic 0082); ``extra`` is now folded
+    into ``module_fields.field_config`` and read directly from there.
+    kacrm's frontend treats a
+    missing interface as "text" which is almost never what you want for
+    select/relation/date columns.
+    """
+    # 归一 legacy 别名 → canonical(select/radio→picklist, multipicklist→multiselect),
+    # 与 hermes_cloud field_provisioning.canonical_field_type 一致。否则 seed 的
+    # upsert(field_type = EXCLUDED.field_type)每次部署把旧命名写回,撤销归一迁移。
+    ftype = {"select": "picklist", "radio": "picklist", "multipicklist": "multiselect"}.get(ftype, ftype)
+    extra: Dict[str, Any] = {"interface": ftype}
+    if options is not None:
+        extra["options"] = options
+    if relation is not None:
+        extra["relation"] = relation
+    if width is not None:
+        extra["width"] = width
+    if required:
+        extra["required"] = True
+    if readonly:
+        extra["readonly"] = True
+
+    # ``field_label`` is the primary (zh-CN) label — the single source of
+    # truth every reader displays. ``label`` is authored in English for
+    # readability of this spec; we derive the Chinese via TEXT_TO_ZH and
+    # keep the English as the ``label_i18n['en-US']`` translation so the
+    # field is self-describing (no dependency on the global TEXT_TO_*
+    # dictionaries at read time).
+    zh_label = TEXT_TO_ZH.get(label, label)
+    field_config: Dict[str, Any] = {}
+    if label and label != zh_label:
+        field_config["label_i18n"] = {"en-US": label}
+    opt_labels = _option_labels(options)
+    if opt_labels:
+        field_config["option_labels"] = opt_labels
+    if system_options:
+        # System options are picklist values that carry semantic meaning
+        # (e.g. milestone terminal states 'won' / 'lost'); frontend renders
+        # them with a lock icon so admins know editing them ripples into
+        # backend logic that branches on the literal value. backend's
+        # PersistedOptionEditor is already append-only, so this is a UI
+        # affordance — not a hard guard.
+        field_config["system_options"] = list(system_options)
+
+    return {
+        "field_name":   name,
+        "field_label":  zh_label,
+        "field_type":   ftype,
+        "sort_order":   sort_order,
+        "is_required":  required,
+        "is_readonly":  readonly,
+        "is_default":   is_default,
+        "is_system":    is_system,
+        "is_summary":   is_summary,
+        "is_searchable": is_searchable,
+        "options":      _options_csv(options),
+        "description":  description,
+        "field_config": field_config or None,
+        "extra":        extra,
+    }
+
+
