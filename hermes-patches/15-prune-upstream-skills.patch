-# --- OKLCH (cylindrical form of OKLAB) ---
-
-def oklab_to_oklch(L, a, b):
-    """OKLAB to OKLCH. Returns (L, C, H) where H is in [0, 1] (normalized)."""
-    C = np.sqrt(a**2 + b**2)
-    H = (np.arctan2(b, a) / (2 * np.pi)) % 1.0
-    return L, C, H
-
-def oklch_to_oklab(L, C, H):
-    """OKLCH to OKLAB. H in [0, 1]."""
-    angle = H * 2 * np.pi
-    a = C * np.cos(angle)
-    b = C * np.sin(angle)
-    return L, a, b
