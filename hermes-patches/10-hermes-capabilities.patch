+def _dispatch_create_field(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str] = None,
+    agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Agent 直建字段。校验后包 provision_field(建列/序列/FK + 原子 + changelog)。"""
+    from hermes_cloud.app.crm.field_provisioning import provision_field
+    from hermes.crm.picklist import PicklistError, append_option, join_options
+    from fastapi import HTTPException
+
+    module_name = str(arguments.get("module_name") or "").strip()
+    field_name = str(arguments.get("field_name") or "").strip()
+    field_label = str(arguments.get("field_label") or "").strip()
+    field_type = str(arguments.get("field_type") or "").strip()
+    if not (module_name and field_name and field_label and field_type):
+        return {"success": False, "error": "module_name/field_name/field_label/field_type 均必填"}
+    if field_type not in _DIRECT_FIELD_TYPES:
+        return {"success": False,
+                "error": f"crm_create_field 不支持 {field_type!r};公式用 crm_create_formula_field。"}
+
+    actor = {"id": int(user_id or 0), "username": agent_name or f"agent:{profile_id or ''}"}
+
+    # picklist/multiselect 的 options → CSV
+    options_csv = None
+    if field_type in _OPTION_FIELD_TYPES:
+        opts = arguments.get("options")
+        if isinstance(opts, str):
+            opts = [s.strip() for s in opts.split(",") if s.strip()]
+        if not isinstance(opts, list) or not opts:
+            return {"success": False, "error": f"{field_type} 需要非空 options 列表"}
+        clean: list = []
+        for v in opts:
+            try:
+                clean, _ = append_option(clean, str(v))
+            except PicklistError as e:
+                return {"success": False, "error": f"options: {e}"}
+        options_csv = join_options(clean)
+
+    # 按类型组装 field_config + 只读
+    field_config = None
+    is_readonly = False
+    if field_type == "relation":
+        target = str(arguments.get("target_module") or "").strip()
+        if not target:
+            return {"success": False, "error": "relation 字段需要 target_module"}
+        field_config = {"relation": {"target_module": target}}
+    elif field_type == "autoNumber":
+        an = arguments.get("autonumber") or {}
+        field_config = {"autonumber": {
+            "prefix": str(an.get("prefix") or ""),
+            "date_token": str(an.get("date_token") or ""),
+            "digits": int(an.get("digits") or 5),
+            "start": int(an.get("start") or 1),
+        }}
+        is_readonly = True  # 系统生成,用户不可改
+
+    # AI 字段:field_type 即输出类型,把指令塞进 field_config.ai_fill。
+    # provision_field 会校验 ai_fill(T2)并惰性建 ai_meta 列;非管理员走提案 payload 一并带过。
+    ai_fill = arguments.get("ai_fill")
+    if isinstance(ai_fill, dict) and ai_fill.get("mission"):
+        _mode = str(ai_fill.get("mode") or "").strip().lower()
+        if _mode not in ("classify", "summarize", "web_agent", "prompt"):
+            _mode = "classify" if field_type in ("picklist", "multiselect") else "prompt"
+        field_config = {"ai_fill": {
+            "enabled": True,
+            "mode": _mode,
+            "output_type": field_type,
+            "mission": str(ai_fill.get("mission") or "").strip(),
+            "context_rules": str(ai_fill.get("context_rules") or "").strip(),
+            "inputs": {
+                "fields": [str(x) for x in (ai_fill.get("input_fields") or [])],
+                "interactions": {"enabled": bool(ai_fill.get("with_interactions")), "limit": 20},
+            },
+            "refresh": {"on_create": True, "on_change": True, "schedule": None},
+            "min_confidence": 0.0,
+        }}
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        mod = ModulesDb(d).get_module_by_name(module_name)
+        if not mod:
+            return {"success": False, "error": f"unknown module: {module_name!r}"}
+        if ModuleFieldsDb(d).get_field_by_name(int(mod["id"]), field_name):
+            return {"success": False, "error": f"field already exists: {field_name!r}"}
+        if field_type == "relation":
+            tgt = ModulesDb(d).get_module_by_name(field_config["relation"]["target_module"])
+            if not tgt:
+                return {"success": False,
+                        "error": f"target_module 不存在: {field_config['relation']['target_module']!r}"}
+        sort_order = max(
+            [int(f.get("sort_order") or 0)
+             for f in (ModuleFieldsDb(d).get_module_fields(int(mod["id"])) or [])] + [0]) + 1
+        field_data = {
+            "field_name": field_name,
+            "field_label": field_label,
+            "field_type": field_type,
+            "is_required": bool(arguments.get("is_required", False)),
+            "is_searchable": bool(arguments.get("is_searchable", False)),
+            "is_readonly": is_readonly,
+            "options": options_csv,
+            "default_value": None,
+            "description": None,
+            "field_config": field_config,
+            "sort_order": sort_order,
+        }
+        if not _actor_is_admin(d, user_id):
+            return _enqueue_schema_proposal(
+                d, kind="field_add", module_id=int(mod["id"]),
+                module_name=module_name, dedup_key=field_name,
+                payload=field_data, reason=arguments.get("reason"),
+                user_id=user_id, profile_id=profile_id, agent_name=agent_name,
+            )
+        try:
+            res = provision_field(d, mod, field_data, actor, arguments.get("reason"))
+        except HTTPException as e:
+            return {"success": False, "error": str(e.detail)}
+        return {"success": True, **res,
+                "message": f"已在「{mod.get('title') or module_name}」加字段"
+                           f"「{field_label}」({field_name}/{field_type})。"}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as d:
+        return _run(d)
+
+
+def _create_workflow_tool(module_names: List[str]) -> "ToolSpec":
+    """Agent 著作工作流(规则 + 按动作选执行器)。"""
+    return ToolSpec(
+        name="crm_create_workflow",
+        description=(
+            "Create an automation WORKFLOW the system runs by itself: WHEN "
+            "<trigger> AND <condition> THEN <actions>. This is intentional, "
+            "agent-authored automation — you compose it from the user's "
+            "described rule. "
+            "trigger_type='event' fires when a record of `module` is created "
+            "or updated (set trigger_on); trigger_type='schedule' fires on a "
+            "cron (set schedule_cron, 5-field e.g. '0 9 * * *'). "
+            "condition = {all:[{field, op, value}]} (ops: =, !=, >, <, >=, <=, "
+            "contains, changed, present, absent); omit for 'always'. "
+            "actions is an ordered list; EACH action picks its executor: "
+            "executor='engine' for deterministic ops (reliable, instant) — "
+            "kind='update_field'{field,value} / 'create_task'{title,priority?,"
+            "owner_by?,description?} / 'create_record'{module,data}; "
+            "executor='agent' for judgment/communication — kind='agent_task'"
+            "{instruction, timeout_sec?} runs the per-profile agent once with "
+            "the triggering record's context (use for 'draft & send a "
+            "reminder', 'summarize and notify', context-dependent decisions). "
+            "In any value/title/instruction you may interpolate the trigger "
+            "record's fields with {{field_name}}. "
+            "Rule of thumb: mechanical step -> engine; needs judgment/wording/"
+            "context -> agent. "
+            "Branching: each action may carry its own `condition` (same "
+            "{all:[{field,op,value}]} shape) — the action runs only when its "
+            "guard is true; two actions with complementary guards = if/else "
+            "(e.g. deal_amount>=1000000 -> exec-approval task; "
+            "deal_amount<1000000 -> standard follow-up)."
+        ),
+        verb="create",
+        module_name="__workflow__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "name": {"type": "string"},
+                "trigger_type": {"type": "string", "enum": ["event", "schedule"]},
+                "module": {"type": "string", "description": "Subject module (snake_case)."},
+                "trigger_on": {"type": "string", "enum": ["create", "update"],
+                               "description": "For event triggers."},
+                "schedule_cron": {"type": "string", "description": "5-field cron, for schedule triggers."},
+                "condition": {"type": "object", "description": "{all:[{field,op,value}]}; omit = always."},
+                "actions": {
+                    "type": "array",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "executor": {"type": "string", "enum": ["engine", "agent"]},
+                            "kind": {"type": "string"},
+                            "params": {"type": "object"},
+                            "condition": {"type": "object", "description": "optional per-action guard {all:[{field,op,value}]} — branch: run this action only if true."},
+                        },
+                        "required": ["executor", "kind", "params"],
+                    },
+                    "minItems": 1,
+                },
+                "reason": {"type": "string"},
+            },
+            "required": ["name", "trigger_type", "module", "actions"],
+            "additionalProperties": False,
+        },
+    )
+
