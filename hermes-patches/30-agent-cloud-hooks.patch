+def _update_prefix_probe(agent: Any, api_messages: list, tools_for_api=None) -> None:
+    """Track request-prefix byte stability across API calls (observability).
+
+    Implicit prefix caches (LongCat/DeepSeek-style) only hit when the
+    request's leading bytes match a previous request — but LongCat reports
+    ``cached_tokens=0`` even on a verified hit (measured 2026-07-07: repeat
+    36k prompt TTFT 13.5s→2.4s, cached_tokens still 0), so provider usage
+    can't observe cache health. Fingerprint the prefix server-side instead:
+    hash(system message + tools). ``prefix=stable`` on call #2+ means the
+    cache CAN hit; ``prefix=changed`` mid-session is a byte-stability bug
+    (something volatile leaked into the prefix). Sets
+    ``agent._prefix_probe_state`` ∈ {first, stable, changed, ?}.
+    """
+    try:
+        import hashlib as _hashlib
+        sys_msg = next(
+            (m for m in api_messages if m.get("role") == "system"), None
+        )
+        prefix_src = json.dumps(
+            [sys_msg, agent.tools if tools_for_api is None else tools_for_api], ensure_ascii=False,
+            sort_keys=False, default=str,
+        )
+        prefix_hash = _hashlib.sha1(prefix_src.encode()).hexdigest()[:10]
+        prev_hash = getattr(agent, "_prefix_probe_hash", None)
+        agent._prefix_probe_state = (
+            "first" if prev_hash is None
+            else ("stable" if prev_hash == prefix_hash else "changed")
+        )
+        agent._prefix_probe_hash = prefix_hash
+    except Exception:
+        agent._prefix_probe_state = "?"
+
+
