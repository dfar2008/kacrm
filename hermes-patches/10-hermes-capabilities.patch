+    assert _db_flush_row(a,{'role':'assistant','content':'first','_gen_ms':100},False)['duration_ms']==100
+    assert _db_flush_row(a,{'role':'assistant','content':'second','_gen_ms':200},False)['duration_ms']==200
+    assert _db_flush_row(a,{'role':'tool','tool_call_id':'id','duration_ms':123},False)['duration_ms']==123
+    assert _db_flush_row(a,{'role':'tool','tool_call_id':'id'},False)['duration_ms']==2500
