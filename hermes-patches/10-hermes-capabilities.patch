+"""One-shot LLM utility for skill Python entry points (Phase 4 patch 26)."""
+from __future__ import annotations
+import os
+from typing import Any, Dict, List, Optional
+import httpx
+
+_BASE_DEFAULT = "https://opencode.ai/zen/v1"
+_MODEL_DEFAULT = "big-pickle"
+_KEY_DEFAULT = "public"
+
+
+def _endpoint() -> str:
+    base = os.getenv("HERMES_OPENCODE_ZEN_BASE", _BASE_DEFAULT).rstrip("/")
+    return f"{base}/chat/completions"
+
+
+def _model() -> str:
+    return os.getenv("HERMES_OPENCODE_ZEN_MODEL", _MODEL_DEFAULT)
+
+
+def _api_key() -> str:
+    return os.getenv("HERMES_OPENCODE_ZEN_KEY", _KEY_DEFAULT) or _KEY_DEFAULT
+
+
+class SkillLLMError(RuntimeError):
+    pass
+
+
+def run_llm_utility(
+    messages: List[Dict[str, Any]], *,
+    max_tokens: Optional[int] = None,
+    temperature: float = 0.3,
+    timeout_sec: float = 60.0,
+) -> str:
+    payload: Dict[str, Any] = {"model": _model(), "messages": messages, "temperature": temperature}
+    if max_tokens is not None:
+        payload["max_tokens"] = max_tokens
+    headers = {"Authorization": f"Bearer {_api_key()}", "Content-Type": "application/json"}
+    try:
+        with httpx.Client(timeout=timeout_sec) as c:
+            resp = c.post(_endpoint(), json=payload, headers=headers)
+    except Exception as exc:
+        raise SkillLLMError(f"transport: {exc}") from exc
+    if resp.status_code >= 400:
+        raise SkillLLMError(f"http {resp.status_code}: {resp.text[:200]}")
+    try:
+        data = resp.json()
+    except Exception as exc:
+        raise SkillLLMError(f"bad json: {exc}") from exc
+    choices = data.get("choices") or []
+    if not choices:
+        raise SkillLLMError("no choices in response")
+    msg = choices[0].get("message") or {}
+    content = msg.get("content")
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts: List[str] = []
+        for p in content:
+            if isinstance(p, dict) and p.get("type") in ("text", "output_text"):
+                t = p.get("text") or p.get("content") or ""
+                if isinstance(t, str):
+                    parts.append(t)
+        return "\n".join(parts).strip()
+    return ""
