+"""Trust Engine — plan §9 (原语 ⑧).
+
+Per-(profile, agent, action_kind) trust levels gate whether an Agent
+action auto-executes, requires human approval, or is blocked outright.
+
+Phase 2 ships with all agents at L1 (require approval). Phase 4 adds
+auto-adjustment based on adoption rate and incident history.
+"""
diff --git a/trust/auto_adjust.py b/trust/auto_adjust.py
new file mode 100644
index 0000000000..84d9d0be9a
--- /dev/null
+++ b/trust/auto_adjust.py
@@ -0,0 +1,240 @@
+"""Trust level auto-adjustment — plan §9.
+
+Scheduled task that evaluates each (profile, agent, action_kind) trust
+level and promotes or demotes based on observed performance metrics:
+
+**Promotion criteria** (§9):
+- 30+ days of continuous activity
+- 100+ total gateway actions
+- Adoption rate > 85%
+- Zero reverts in the evaluation window
+- → Promote one level (capped at L5)
+
+**Demotion criteria** (§9):
+- 2+ reverted actions in the last 7 days
+- → Demote one level (floored at L0)
+
+**Emergency demotion** (§9):
+- Any data breach / compliance incident → immediate L0
+- (Not automated here — triggered manually via set_level)
+
+This module exposes :func:`auto_adjust_all` which scans all trust_levels
+rows and applies the rules. It's designed to be called by a Celery beat
+task once per day.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Dict, List, Optional, Tuple
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.trust.engine import set_level
+
+logger = logging.getLogger(__name__)
+
+# Thresholds from plan §9
+PROMOTE_MIN_DAYS = 30
+PROMOTE_MIN_ACTIONS = 100
+PROMOTE_MIN_ADOPTION_RATE = 0.85
+DEMOTE_REVERT_WINDOW_DAYS = 7
+DEMOTE_REVERT_THRESHOLD = 2
+MAX_LEVEL = 5
+MIN_LEVEL = 0
+
+
+def _get_all_trust_levels(db: DbWrapper) -> List[Dict]:
+    """Fetch all trust level rows."""
+    return db.fetchall(
+        "SELECT profile_id, agent_name, action_kind, level "
+        "FROM trust_levels ORDER BY profile_id, agent_name"
+    )
+
+
+def _get_action_stats(
+    db: DbWrapper,
+    profile_id: str,
+    agent_name: str,
+    action_kind: str,
+    days: int = 30,
+) -> Dict:
+    """Compute gateway action stats for the evaluation window.
+
+    Returns dict with: total, executed, reverted, first_action_days_ago,
+    adoption_rate.
+    """
+    row = db.fetchone(
+        """
+        SELECT
+            count(*) AS total,
+            count(*) FILTER (WHERE state = 'executed') AS executed,
+            count(*) FILTER (WHERE state = 'reverted') AS reverted,
+            count(*) FILTER (WHERE state = 'rejected') AS rejected,
+            EXTRACT(days FROM now() - min(created_at)) AS first_action_days_ago
+        FROM gateway_actions
+        WHERE profile_id = %s
+          AND agent_name = %s
+          AND kind = %s
+          AND created_at > now() - interval '%s days'
+        """,
+        (str(profile_id), str(agent_name), str(action_kind), int(days)),
+    )
+    if not row or not row["total"]:
+        return {
+            "total": 0,
+            "executed": 0,
+            "reverted": 0,
+            "rejected": 0,
+            "first_action_days_ago": 0,
+            "adoption_rate": 0.0,
+        }
+
+    total = int(row["total"])
+    executed = int(row["executed"])
+    reverted = int(row["reverted"])
+    rejected = int(row["rejected"])
+    decided = executed + rejected
+    adoption_rate = executed / decided if decided > 0 else 0.0
+
+    return {
+        "total": total,
+        "executed": executed,
+        "reverted": reverted,
+        "rejected": rejected,
+        "first_action_days_ago": float(row["first_action_days_ago"] or 0),
+        "adoption_rate": adoption_rate,
+    }
+
+
+def _get_recent_reverts(
+    db: DbWrapper,
+    profile_id: str,
+    agent_name: str,
+    action_kind: str,
+    days: int = 7,
+) -> int:
+    """Count reverts in the last N days."""
+    row = db.fetchone(
+        """
+        SELECT count(*) AS cnt
+        FROM gateway_actions
+        WHERE profile_id = %s
+          AND agent_name = %s
+          AND kind = %s
+          AND state = 'reverted'
+          AND reverted_at > now() - interval '%s days'
+        """,
+        (str(profile_id), str(agent_name), str(action_kind), int(days)),
+    )
+    return int(row["cnt"]) if row else 0
+
+
+def evaluate_trust_level(
+    profile_id: str,
+    agent_name: str,
+    action_kind: str,
+    current_level: int,
+    db: DbWrapper,
+) -> Tuple[int, str]:
+    """Evaluate whether a trust level should change.
+
+    Returns (new_level, reason). If new_level == current_level, no change.
+    """
+    # Check demotion first (safety takes priority)
+    recent_reverts = _get_recent_reverts(
+        db, profile_id, agent_name, action_kind,
+        days=DEMOTE_REVERT_WINDOW_DAYS,
+    )
+    if recent_reverts >= DEMOTE_REVERT_THRESHOLD:
+        new_level = max(MIN_LEVEL, current_level - 1)
+        if new_level < current_level:
+            return new_level, (
+                f"demoted: {recent_reverts} reverts in last "
+                f"{DEMOTE_REVERT_WINDOW_DAYS} days"
+            )
+
+    # Check promotion
+    if current_level >= MAX_LEVEL:
+        return current_level, "already at max level"
+
+    stats = _get_action_stats(
+        db, profile_id, agent_name, action_kind,
+        days=PROMOTE_MIN_DAYS,
+    )
+
+    if (
+        stats["total"] >= PROMOTE_MIN_ACTIONS
+        and stats["first_action_days_ago"] >= PROMOTE_MIN_DAYS
+        and stats["adoption_rate"] >= PROMOTE_MIN_ADOPTION_RATE
+        and stats["reverted"] == 0
+    ):
+        new_level = min(MAX_LEVEL, current_level + 1)
+        return new_level, (
+            f"promoted: {stats['total']} actions over "
+            f"{stats['first_action_days_ago']:.0f} days, "
+            f"adoption={stats['adoption_rate']:.0%}, 0 reverts"
+        )
+
+    return current_level, "no change"
+
+
+def auto_adjust_all(*, db: Optional[DbWrapper] = None) -> List[Dict]:
+    """Scan all trust levels and apply auto-adjustment rules.
+
+    Returns a list of adjustments made (for logging / reporting).
+    """
+    adjustments: List[Dict] = []
+
+    def _run(db: DbWrapper) -> None:
+        levels = _get_all_trust_levels(db)
+        for row in levels:
+            profile_id = row["profile_id"]
+            agent_name = row["agent_name"]
+            action_kind = row["action_kind"]
+            current = int(row["level"])
+
+            new_level, reason = evaluate_trust_level(
+                profile_id, agent_name, action_kind, current, db,
+            )
+
+            if new_level != current:
+                set_level(
+                    profile_id,
+                    agent_name,
+                    action_kind,
+                    new_level,
+                    rationale=f"auto: {reason}",
+                    db=db,
+                )
+                adjustment = {
+                    "profile_id": profile_id,
+                    "agent_name": agent_name,
+                    "action_kind": action_kind,
+                    "old_level": current,
+                    "new_level": new_level,
+                    "reason": reason,
+                }
+                adjustments.append(adjustment)
+                logger.info(
+                    "trust_auto_adjust %s/%s/%s: L%d → L%d (%s)",
+                    profile_id, agent_name, action_kind,
+                    current, new_level, reason,
+                )
+
+    if db is not None:
+        _run(db)
+    else:
+        with db_session() as owned:
+            _run(owned)
+
+    return adjustments
+
+
+__all__ = [
+    "auto_adjust_all",
+    "evaluate_trust_level",
+    "PROMOTE_MIN_DAYS",
+    "PROMOTE_MIN_ACTIONS",
+    "PROMOTE_MIN_ADOPTION_RATE",
+    "DEMOTE_REVERT_WINDOW_DAYS",
+    "DEMOTE_REVERT_THRESHOLD",
+]
diff --git a/trust/engine.py b/trust/engine.py
new file mode 100644
index 0000000000..d043eaee20
--- /dev/null
+++ b/trust/engine.py
@@ -0,0 +1,256 @@
+"""Trust Engine runtime — plan §9.
+
+:func:`decide` is the single entry-point the Action Gateway calls before
+executing any Agent-produced side-effect.  It reads the trust level for
+the ``(profile, agent, action_kind)`` triple, applies the level→decision
+matrix from the plan, logs the decision to ``trust_decisions``, and
+returns a :class:`Decision`.
+
+Trust levels default to **1** (require_approval) when no row exists —
+the safe fallback for newly-deployed agents.
+
+Level semantics (plan §9):
+
+* **0 — BLOCK**: action is refused unconditionally.
+* **1 — REQUIRE_APPROVAL**: action queued for human approval.
+* **2**: auto-execute if ``risk == 'low'``, else require approval.
+* **3**: auto-execute if ``risk in ('low', 'medium')``, else approval.
+* **4**: auto-execute unless ``risk == 'critical'``.
+* **5 — FULL_AUTO**: always auto-execute.
+"""
+from __future__ import annotations
+
+import enum
+import logging
+from dataclasses import dataclass
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_LEVEL = 1
+
+# create/update share the same ``crm.write`` action_kind; operation-level
+# differences are carried by params.op, not by action kind.
+# TODO(op_override): read trust_levels.op_override JSONB when present.
+DEFAULT_LEVEL_BY_KIND = {
+    "crm.write": 3,
+    "memory.write": 3,
+    "task.create": 3,
+    # agent-pool v2.2 §9: auto-execute only when risk='low'.
+    "workflow.submit": 2,
+    "email.send": 1,
+    "crm.delete": 0,
+}
+
+
+class Decision(enum.Enum):
+    """Outcome of a trust evaluation."""
+
+    EXECUTE = "auto_execute"
+    REQUIRE_APPROVAL = "require_approval"
+    BLOCK = "block"
+
+
+@dataclass
+class TrustVerdict:
+    """Full trust decision with audit context."""
+
+    decision: Decision
+    level: int
+    reason: str
+
+
+def get_level(
+    profile_id: str,
+    agent_name: str,
+    action_kind: str,
+    db: Optional[DbWrapper] = None,
+    *,
+    source_skill: Optional[str] = None,
+) -> int:
+    """Look up the trust level, defaulting to :data:`DEFAULT_LEVEL`.
+
+    Charter v2 keying: prefer ``(profile_id, action_kind, source_skill)``
+    over the legacy ``(profile_id, agent_name, action_kind)`` triple.
+    Lookup precedence:
+
+      1. If ``source_skill`` provided and a row exists for it → return
+         that level. (v2 path)
+      2. Else fall back to ``agent_name``-keyed row. (v1 compat path,
+         covers existing trust rows + main agent invocations that
+         haven't been wired to thread skill context yet.)
+      3. Else use the kind's default level.
+    """
+    def _query(db: DbWrapper) -> int:
+        if source_skill:
+            row = db.fetchone(
+                """
+                SELECT level FROM trust_levels
+                WHERE profile_id = %s
+                  AND action_kind = %s
+                  AND source_skill = %s
+                """,
+                (str(profile_id), str(action_kind), str(source_skill)),
+            )
+            if row:
+                return int(row["level"])
+        # v1-keyed fallback
+        row = db.fetchone(
+            """
+            SELECT level FROM trust_levels
+            WHERE profile_id = %s AND agent_name = %s AND action_kind = %s
+              AND source_skill IS NULL
+            """,
+            (str(profile_id), str(agent_name), str(action_kind)),
+        )
+        if row:
+            return int(row["level"])
+        return DEFAULT_LEVEL_BY_KIND.get(str(action_kind), DEFAULT_LEVEL)
+
+    if db is not None:
+        return _query(db)
+    with db_session() as owned:
+        return _query(owned)
+
+
+def set_level(
+    profile_id: str,
+    agent_name: str,
+    action_kind: str,
+    level: int,
+    *,
+    rationale: str = "",
+    updated_by: Optional[int] = None,
+    db: Optional[DbWrapper] = None,
+) -> None:
+    """Upsert a trust level."""
+    if not 0 <= level <= 5:
+        raise ValueError(f"trust level must be 0–5, got {level}")
+
+    def _upsert(db: DbWrapper) -> None:
+        db.execute(
+            """
+            INSERT INTO trust_levels
+                (profile_id, agent_name, action_kind, level, rationale, updated_by)
+            VALUES (%s, %s, %s, %s, %s, %s)
+            ON CONFLICT (profile_id, agent_name, action_kind)
+            DO UPDATE SET
+                level = EXCLUDED.level,
+                rationale = EXCLUDED.rationale,
+                updated_by = EXCLUDED.updated_by,
+                updated_at = now()
+            """,
+            (
+                str(profile_id),
+                str(agent_name),
+                str(action_kind),
+                int(level),
+                str(rationale or ""),
+                int(updated_by) if updated_by else None,
+            ),
+        )
+
+    if db is not None:
+        return _upsert(db)
+    with db_session() as owned:
+        _upsert(owned)
+
+
+def decide(
+    profile_id: str,
+    agent_name: str,
+    action_kind: str,
+    risk: str = "low",
+    *,
+    action_id: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+    source_skill: Optional[str] = None,
+) -> TrustVerdict:
+    """Evaluate trust and record the decision.
+
+    Parameters
+    ----------
+    risk:
+        ``'low'`` / ``'medium'`` / ``'high'`` / ``'critical'`` — the
+        caller (gateway dispatcher) classifies the action's risk before
+        asking the trust engine.
+    action_id:
+        UUID of the ``gateway_actions`` row, if already created. When
+        provided the decision is persisted to ``trust_decisions``.
+    source_skill:
+        Charter v2 keying. When provided, lookup prefers
+        ``(profile_id, action_kind, source_skill)`` over the legacy
+        ``(profile_id, agent_name, action_kind)`` triple.
+    """
+    def _run(db: DbWrapper) -> TrustVerdict:
+        level = get_level(
+            profile_id, agent_name, action_kind, db=db,
+            source_skill=source_skill,
+        )
+
+        if level == 0:
+            decision = Decision.BLOCK
+            reason = "trust level 0 — blocked"
+        elif level == 5:
+            decision = Decision.EXECUTE
+            reason = "trust level 5 — full auto"
+        elif level == 1:
+            decision = Decision.REQUIRE_APPROVAL
+            reason = "trust level 1 — all actions require approval"
+        elif level == 2:
+            decision = (
+                Decision.EXECUTE if risk == "low"
+                else Decision.REQUIRE_APPROVAL
+            )
+            reason = f"trust level 2 — risk={risk}"
+        elif level == 3:
+            decision = (
+                Decision.EXECUTE if risk in ("low", "medium")
+                else Decision.REQUIRE_APPROVAL
+            )
+            reason = f"trust level 3 — risk={risk}"
+        elif level == 4:
+            decision = (
+                Decision.EXECUTE if risk != "critical"
+                else Decision.REQUIRE_APPROVAL
+            )
+            reason = f"trust level 4 — risk={risk}"
+        else:
+            decision = Decision.REQUIRE_APPROVAL
+            reason = f"unknown trust level {level} — defaulting to approval"
+
+        if action_id:
+            try:
+                db.execute(
+                    """
+                    INSERT INTO trust_decisions
+                        (action_id, trust_level_snapshot, decision, reason)
+                    VALUES (%s, %s, %s, %s)
+                    """,
+                    (str(action_id), level, decision.value, reason),
+                )
+            except Exception as exc:
+                logger.warning(
+                    "trust_decision_log_failed action=%s err=%r",
+                    action_id, exc,
+                )
+
+        return TrustVerdict(decision=decision, level=level, reason=reason)
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+__all__ = [
+    "Decision",
+    "TrustVerdict",
+    "DEFAULT_LEVEL",
+    "DEFAULT_LEVEL_BY_KIND",
+    "get_level",
+    "set_level",
+    "decide",
+]
