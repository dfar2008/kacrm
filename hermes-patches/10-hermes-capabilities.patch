+def _enqueue_schema_proposal(
+    db: "DbWrapper",
+    *,
+    kind: str,
+    module_id: Optional[int],
+    module_name: str,
+    dedup_key: str,
+    payload: Dict[str, Any],
+    reason: Optional[str],
+    user_id: int,
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+) -> Dict[str, Any]:
+    """非管理员的 schema 直建请求 → 落 field_proposals(proposer_type='agent')。
+
+    返回与"非管理员写数据"一致的 pending 形状(非失败)。含跨 kind dedup:
+    同 kind+dedup_key 已有 pending 则返回既有 proposal,不重复入队。
+    """
+    proposals = FieldProposalsDb(db)
+    existing = proposals.find_pending_by_kind_key(
+        module_id=module_id, kind=kind, key=dedup_key,
+    )
+    if existing:
+        return {
+            "success": True, "deduped": True,
+            "proposal_id": int(existing["id"]), "status": "pending",
+            "message": (
+                f"已有一条相同的待审提案 #{existing['id']} 在管理员队列里,未重复提交。"
+            ),
+        }
+
+    full_payload = dict(payload)
+    full_payload["kind"] = kind
+    full_payload["_dedup_key"] = dedup_key
+    if reason is not None:
+        full_payload["reason"] = reason
+
+    pid = proposals.insert_proposal(
+        proposer_type="agent",
+        proposer_id=int(user_id) if user_id else None,
+        proposer_label=_agent_proposer_label(profile_id, agent_name),
+        module_id=module_id,
+        module_name=module_name,
+        payload=full_payload,
+    )
+    return {
+        "success": True, "proposal_id": int(pid), "status": "pending",
+        "message": (
+            "已提交管理员审批 —— 管理员在 /admin/schema(提案)通过后正式生效。"
+            "这不是失败,请转告用户'已提交审批,通过后生效',不要重试。"
+        ),
+    }
+
