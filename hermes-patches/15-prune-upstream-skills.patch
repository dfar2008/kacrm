-def _parse_only(spec: str | None) -> set[int] | None:
-    if not spec:
-        return None
-    out: set[int] = set()
-    for chunk in spec.replace(" ", "").split(","):
-        if not chunk:
-            continue
-        if "-" in chunk:
-            lo, _, hi = chunk.partition("-")
-            out.update(range(int(lo), int(hi) + 1))
-        else:
-            out.add(int(chunk))
-    return out
-
