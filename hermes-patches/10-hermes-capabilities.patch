+from types import SimpleNamespace as NS
+from unittest.mock import MagicMock, patch
+from functools import partial
+import pytest
+
+@pytest.mark.parametrize('kind', ['legacy','keyword','kwargs','partial','bound'])
+def test_callback_signature(kind):
+    from agent.tool_executor import _invoke_tool_complete_callback
+    calls=[]
+    def legacy(*args): calls.append((args, None))
+    def keyword(*args, duration=None): calls.append((args,duration))
+    def kwargs(*args, **kw): calls.append((args,kw['duration']))
+    class Handler:
+        def done(self,*args,duration=None): calls.append((args,duration))
+    cb={'legacy':legacy,'keyword':keyword,'kwargs':kwargs,'partial':partial(keyword),'bound':Handler().done}[kind]
+    for _ in range(2): _invoke_tool_complete_callback(cb,'id','tool',{},'ok',1.25)
+    assert len(calls)==2
+    assert all(d == (None if kind=='legacy' else 1.25) for _,d in calls)
+
+def test_callback_internal_typeerror_not_retried():
+    from agent.tool_executor import _invoke_tool_complete_callback
+    calls=[]
+    def broken(*args,duration=None):
+        calls.append(1)
+        raise TypeError('inside callback')
+    with pytest.raises(TypeError): _invoke_tool_complete_callback(broken,'id','tool',{},'ok',1)
+    assert len(calls)==1
+
