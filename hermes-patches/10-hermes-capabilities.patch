index 0000000000..cc876a3cc4
--- /dev/null
+++ b/crm/constants.py
@@ -0,0 +1,46 @@
+"""CRM 业务常量。
+
+集中存放代码里需要硬绑的字面量，避免每处自己写一份字符串导致漂移。
+任何引用以下常量的字段在 ``module_fields`` 里都标了 ``system_options``，
+admin 通过 UI 无法删除/改名 value——保证常量永远对得上 picklist。
+"""
+from __future__ import annotations
+
+
+# `potentials.milestone` 的终态值。代码判断「商机已结案」一律走这个常量；
+# 千万不要在 SQL 或 Python 散写 'won' / 'lost' 字面量——picklist value 一旦
+# 改动，单点更新这里、grep 所有引用即可。
+TERMINAL_MILESTONES_WON = ("won",)
+TERMINAL_MILESTONES_LOST = ("lost",)
+TERMINAL_MILESTONES = TERMINAL_MILESTONES_WON + TERMINAL_MILESTONES_LOST
+
+
+# `quotes.status` 的终态值。``accepted`` / ``rejected`` 标记报价闭环。
+# scanner / 报表用这个常量判定「报价已不再活跃」。
+TERMINAL_QUOTE_STATUSES = ("accepted", "rejected")
+
+
+# `salesorders.status` 的终态值。``delivered`` 是商品/服务交付完成,
+# ``completed`` 是订单整体闭环(含回款),``cancelled`` 是中途取消。
+# 任何后续动作(回款扫描、续费提示)看到这三档之一即视为「订单已结」。
+TERMINAL_SALESORDER_STATUSES = ("delivered", "completed", "cancelled")
+
+
+# `tasks.status` 的终态值。任务只有「已完成」一种语义结案;
+# ``deferred`` 是延期(还会回来),不算终态。
+TERMINAL_TASK_STATUSES = ("completed",)
+
+
+# `leads.convertedstatus` 的终态值。``converted`` = 已转商机,
+# ``failed`` = 已确认无法转化。线索漏斗里这两档之外都还在「待处理」。
+TERMINAL_LEAD_CONVERT_STATUSES = ("converted", "failed")
+
+
+# 记录上的「系统/审计列」——非业务数据,不进记忆图谱(memory_compounding)。
+# 与 events._BOOKKEEPING_COLS 不同:那只是 changelog diff 忽略的 4 个审计列;
+# 这里是更宽的「记忆不收录」集(含 owner/部门/软删/记忆身份指针)。两者用途不同,
+# 故各自维护,勿强并。
+SYSTEM_COLUMNS = frozenset({
+    "owner_by", "created_by", "updated_by", "department_id",
+    "created_at", "updated_at", "deleted", "memory_entity_id",
+})
diff --git a/crm/db.py b/crm/db.py
new file mode 100644
index 0000000000..e04e81692a
--- /dev/null
+++ b/crm/db.py
@@ -0,0 +1,374 @@
+"""CRM database access.
+
+We deliberately stick with kacrm's table-gateway + raw SQL style rather than
+layering SQLAlchemy ORM on top. kacrm's production code expresses intent in
+hand-written SQL and that's what we want to preserve as we port models over.
+
+The only compatibility work needed is wrapping psycopg3 in a thin ``DbWrapper``
+whose surface matches kacrm's pymysql-based one:
+
+    db.fetchone(sql, args)
+    db.fetchall(sql, args)
+    db.fetchcolumn(sql, args)
+    db.execute(sql, args)
+    db.insert(table, data) -> int (affected rows)
+    db.id() -> int (last inserted PK, scoped to the wrapper)
+    with db.transaction(): ...
+
+Both psycopg3 and pymysql honour ``%s`` placeholders, so the vast majority of
+kacrm queries port unchanged. The two gotchas to watch:
+
+1. MySQL backticks `` `col` `` must go (PostgreSQL uses double quotes for
+   identifiers; unquoted is fine for lowercase names).
+2. ``LAST_INSERT_ID()`` has no PG equivalent — we emulate ``db.id()`` via
+   ``RETURNING id`` on the most recent ``insert()`` call.
+"""
+from __future__ import annotations
+
+import logging
+import os
+import threading
+from contextlib import contextmanager
+from typing import Any, Callable, Dict, Iterator, List, Optional, Tuple
+
+import psycopg
+from pgvector.psycopg import register_vector
+from psycopg.rows import dict_row
+from psycopg_pool import ConnectionPool
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# Connection pool (module-level singleton).
+# ---------------------------------------------------------------------------
+
+_pool: ConnectionPool | None = None
+_pool_lock = threading.Lock()
+
+
+def _resolve_dsn() -> str:
+    """Resolve the CRM database DSN from env, with a local-dev fallback."""
+    dsn = os.environ.get("HERMES_CRM_DATABASE_URL") or os.environ.get("CRM_DATABASE_URL")
+    if dsn:
+        # psycopg3 accepts either ``postgresql://`` or SQLAlchemy-style
+        # ``postgresql+psycopg://``. Strip the driver prefix if present.
+        if dsn.startswith("postgresql+psycopg://"):
+            dsn = "postgresql://" + dsn[len("postgresql+psycopg://"):]
+        elif dsn.startswith("postgresql+psycopg2://"):
+            dsn = "postgresql://" + dsn[len("postgresql+psycopg2://"):]
+        return dsn
+    # Local-dev default mirrors ``alembic/env.py``.
+    user = os.environ.get("USER", "postgres")
+    return f"postgresql://{user}@localhost:5432/hermes_crm_dev"
+
+
+def resolve_crm_sa_url() -> str:
+    """Return the CRM DSN in SQLAlchemy-compatible form.
+
+    :func:`_resolve_dsn` normalises to bare ``postgresql://`` for psycopg3.
+    SQLAlchemy needs the ``+psycopg`` driver suffix so it picks the
+    psycopg3 DBAPI instead of falling back to psycopg2.  Phase 1c.4 uses
+    this to hand the SA-backed config/session/channel stores the same
+    database the CRM pool targets.
+    """
+    dsn = _resolve_dsn()
+    if dsn.startswith("postgresql://"):
+        return "postgresql+psycopg://" + dsn[len("postgresql://"):]
+    return dsn
+
+
+def _configure_connection(conn: psycopg.Connection) -> None:
+    """Per-connection setup: dict rows + pgvector type adapter.
+
+    The pool calls this once per fresh backend, so every borrowed connection
+    already knows how to marshal ``list[float]`` / ``numpy.ndarray`` into a
+    ``vector(N)`` column (and vice versa).
+    """
+    register_vector(conn)
+
+
+def get_pool() -> ConnectionPool:
+    """Return the process-wide connection pool, opening it on first access.
+
+    Pool sizing is env-tunable so each process type can size its pool to
+    its real demand. The CRM pool is a per-process singleton, so total PG
+    connections scale with process count — the cloud web server, celery
+    workers, and every per-profile hermes subprocess each open one. With
+    dozens of profiles a fixed max_size would exhaust PG ``max_connections``;
+    ProfileManager therefore injects a small ``HERMES_CRM_POOL_MAX`` /
+    ``HERMES_CRM_POOL_MIN`` for subprocesses while the web server keeps a
+    larger pool.
+
+      HERMES_CRM_POOL_MIN     — idle connections kept warm (default 1)
+      HERMES_CRM_POOL_MAX     — hard ceiling on borrowed connections
+      HERMES_CRM_POOL_TIMEOUT — seconds to wait for a free connection
+                                before raising (default 10; fail fast)
+    """
+    global _pool
+    if _pool is not None:
+        return _pool
+    with _pool_lock:
+        if _pool is None:
+            min_size = int(os.environ.get("HERMES_CRM_POOL_MIN", "1"))
+            max_size = int(os.environ.get("HERMES_CRM_POOL_MAX", "10"))
+            timeout = float(os.environ.get("HERMES_CRM_POOL_TIMEOUT", "10"))
+            _pool = ConnectionPool(
+                conninfo=_resolve_dsn(),
+                min_size=min_size,
+                max_size=max_size,
+                timeout=timeout,
+                # prepare_threshold=None disables psycopg3 server-side
+                # prepared statements. Required when the pool fronts
+                # pgbouncer in transaction mode: server connections are
+                # reassigned between clients per-transaction, so a
+                # prepared statement created on one borrow won't exist on
+                # the next. The parse-per-query cost is negligible for
+                # this OLTP workload; pgbouncer correctness wins.
+                kwargs={"row_factory": dict_row, "prepare_threshold": None},
+                configure=_configure_connection,
+                open=True,
+            )
+        return _pool
+
+
+def close_pool() -> None:
+    """Close the pool — used in test teardown."""
+    global _pool
+    with _pool_lock:
+        if _pool is not None:
+            _pool.close()
+            _pool = None
+
+
+# ---------------------------------------------------------------------------
+# DbWrapper — kacrm-compatible table-gateway facade.
+# ---------------------------------------------------------------------------
+
+class DbWrapper:
+    """Thin facade over a single psycopg3 connection.
+
+    The API matches kacrm's ``app/database/base.py`` (:class:`DbWrapper` there)
+    so ported model code doesn't need to change call sites. Transaction
+    semantics: if you call :meth:`execute` / :meth:`insert` outside a
+    :meth:`transaction` block, the wrapper commits immediately; inside one,
+    commits are deferred until the block exits.
+    """
+
+    def __init__(self, conn: psycopg.Connection) -> None:
+        self._conn = conn
+        self._transaction_depth = 0
+        self._last_insert_id: Optional[int] = None
+        # Callbacks queued via :meth:`after_commit`. Drained — in registration
+        # order — every time the underlying psycopg connection actually
+        # commits. Cleared without running on rollback.
+        self._after_commit_callbacks: List[Callable[[], None]] = []
+
+    # ---- cursor / transaction plumbing ---------------------------------
+
+    def cursor(self):  # pragma: no cover — rarely used from ported code
+        return self._conn.cursor()
+
+    def commit(self) -> None:
+        self._conn.commit()
+        self._drain_after_commit()
+
+    def rollback(self) -> None:
+        self._conn.rollback()
+        # Pending side-effects belong to the aborted txn — drop them.
+        self._after_commit_callbacks.clear()
+
+    @contextmanager
+    def transaction(self) -> Iterator[None]:
+        self._transaction_depth += 1
+        committed = False
+        try:
+            yield
+            if self._transaction_depth == 1:
+                self._conn.commit()
+                committed = True
+        except Exception:
+            self._conn.rollback()
+            self._after_commit_callbacks.clear()
+            raise
+        finally:
+            self._transaction_depth -= 1
+        if committed:
+            self._drain_after_commit()
+
+    def _maybe_commit(self, commit: bool) -> None:
+        if commit and self._transaction_depth == 0:
+            self._conn.commit()
+            self._drain_after_commit()
+
+    # ---- post-commit hooks ---------------------------------------------
+
+    def after_commit(self, callback: Callable[[], None]) -> None:
+        """Schedule ``callback`` to fire **after** the next successful commit.
+
+        Use this whenever a write-path side-effect (queue dispatch, cache
+        invalidation, webhook fan-out) must be visible only if the row it
+        depends on actually landed. The callback fires:
+
+        * Inside a ``with db.transaction(): ...`` block — when the block
+          exits normally and the outermost commit succeeds.
+        * Outside a transaction — immediately after the auto-commit that
+          ``execute()`` / ``insert()`` / ``_maybe_commit(True)`` performs.
+
+        On rollback (explicit or via exception), queued callbacks are
+        dropped without running. Callback exceptions are logged and
+        swallowed — the commit already happened, so a side-effect failure
+        must not surface as a write failure.
+
+        Callbacks see the *post-commit* state of the DB, so they can open
+        new connections / sessions safely. They run on the same thread as
+        the commit; keep them cheap (typically just ``celery.delay()``).
+        """
+        if self._transaction_depth == 0 and not self._conn_in_pending_write():
+            # No write pending → fire eagerly. This makes the hook safe to
+            # call from read-only paths without leaking callbacks across
+            # unrelated DbWrapper lifecycles.
+            try:
+                callback()
+            except Exception as exc:  # pragma: no cover — defensive
+                logger.warning("after_commit_eager_failed err=%r", exc)
+            return
+        self._after_commit_callbacks.append(callback)
+
+    def _conn_in_pending_write(self) -> bool:
+        """Heuristic: does the underlying connection have an open txn?
+
+        psycopg3 exposes ``info.transaction_status``; ``IDLE`` means no
+        in-progress transaction. Anything else (``INTRANS``, ``INERROR``)
+        means there's pending state that a future commit will flush.
+        """
+        try:
+            from psycopg.pq import TransactionStatus
+
+            return self._conn.info.transaction_status != TransactionStatus.IDLE
+        except Exception:
+            # If we can't tell, assume yes — better to defer than to fire
+            # too early.
+            return True
+
+    def _drain_after_commit(self) -> None:
+        if not self._after_commit_callbacks:
+            return
+        callbacks, self._after_commit_callbacks = self._after_commit_callbacks, []
+        for cb in callbacks:
+            try:
+                cb()
+            except Exception as exc:
+                logger.warning("after_commit_callback_failed err=%r", exc)
+
+    # ---- read helpers --------------------------------------------------
+
+    def _safe_execute(self, cur, sql, args):
+        """Execute SQL; on failure, rollback so the connection isn't left
+        in 'aborted transaction' state (poisoning the pool for the next
+        request). Re-raise the original error.
+        """
+        try:
+            cur.execute(sql, args)
+        except Exception:
+            try:
+                self._conn.rollback()
+            except Exception as rb_exc:
+                logger.warning("rollback after query failure failed: %r", rb_exc)
+            raise
+
+    def fetchone(
+        self, sql: str, args: Optional[Tuple[Any, ...]] = None
+    ) -> Optional[Dict[str, Any]]:
+        with self._conn.cursor() as cur:
+            self._safe_execute(cur, sql, args)
+            row = cur.fetchone()
+            return dict(row) if row is not None else None
+
+    def fetchall(
+        self, sql: str, args: Optional[Tuple[Any, ...]] = None
+    ) -> List[Dict[str, Any]]:
+        with self._conn.cursor() as cur:
+            self._safe_execute(cur, sql, args)
+            rows = cur.fetchall()
+            return [dict(r) for r in rows] if rows else []
+
+    def fetchcolumn(
+        self,
+        sql: str,
+        args: Optional[Tuple[Any, ...]] = None,
+        column: int = 0,
+    ) -> Any:
+        with self._conn.cursor() as cur:
+            self._safe_execute(cur, sql, args)
+            row = cur.fetchone()
+            if row is None:
+                return None
+            # ``row`` is a dict thanks to ``dict_row`` — pick the Nth key.
+            keys = list(row.keys())
+            return row[keys[column]] if keys else None
+
+    # ---- write helpers -------------------------------------------------
+
+    def execute(
+        self,
+        sql: str,
+        args: Optional[Tuple[Any, ...]] = None,
+        commit: bool = True,
+    ) -> int:
+        with self._conn.cursor() as cur:
+            self._safe_execute(cur, sql, args)
+            affected = cur.rowcount
+        self._maybe_commit(commit)
+        return affected
+
+    def insert(
+        self, table: str, data: Dict[str, Any], commit: bool = True
+    ) -> int:
+        """``INSERT INTO {table} (cols) VALUES (vals) RETURNING id``.
+
+        Stashes the returned id on the wrapper so :meth:`id` works like
+        MySQL's ``LAST_INSERT_ID()``. Returns the number of rows affected.
+        """
+        if not data:
+            return 0
+        cols = list(data.keys())
+        placeholders = ", ".join(["%s"] * len(cols))
+        col_list = ", ".join(f'"{c}"' for c in cols)
+        sql = f'INSERT INTO "{table}" ({col_list}) VALUES ({placeholders}) RETURNING id'
+        args = tuple(data[c] for c in cols)
+        with self._conn.cursor() as cur:
+            self._safe_execute(cur, sql, args)
+            row = cur.fetchone()
+            self._last_insert_id = row["id"] if row else None
+            affected = cur.rowcount
+        self._maybe_commit(commit)
+        return affected
+
+    def id(self) -> Optional[int]:
+        """Return the PK written by the most recent :meth:`insert`."""
+        return self._last_insert_id
+
+
+# ---------------------------------------------------------------------------
+# Request-scoped helpers (FastAPI dependency).
+# ---------------------------------------------------------------------------
+
+@contextmanager
+def db_session() -> Iterator[DbWrapper]:
+    """Yield a :class:`DbWrapper` backed by a pooled connection.
+
+    Usage::
+
+        with db_session() as db:
+            user = db.fetchone("SELECT * FROM users WHERE id = %s", (user_id,))
+    """
+    pool = get_pool()
+    with pool.connection() as conn:
+        yield DbWrapper(conn)
+
+
+def get_db() -> Iterator[DbWrapper]:
+    """FastAPI dependency wrapper around :func:`db_session`."""
+    with db_session() as db:
+        yield db
diff --git a/crm/detail_query.py b/crm/detail_query.py
new file mode 100644
index 0000000000..b068c00c35
--- /dev/null
+++ b/crm/detail_query.py
@@ -0,0 +1,433 @@
+"""Record detail payload — Phase 1 slim port of kacrm's
+``app/includes/detail_query.py``.
+
+kacrm's 664-line ``DetailQuery`` expands each field to its display value,
+formats currency/number fields, resolves pipeline milestone / lost-reason
+/ user / department / relation references, and rolls up product-line
+details into a nested ``products`` block.
+
+For Phase 1 we need the core of that — return the raw record plus
+``*_display`` columns for user/department/relation fields — but we DON'T
+need pipeline milestones (no pipeline module yet), currency-JSON rollups
+(no currency fields in Phase 1 modules), or product lines (no
+``has_products`` modules). The skipped branches are flagged as TODO
+comments in case Phase 2 re-enables them.
+
+The display-value resolution reuses the same pattern as
+:meth:`ListQuery._apply_display_values`, applied to a single row instead
+of a batch.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+import json
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.crm.functions import json_serializable
+from hermes.crm.i18n.field_labels import localize_field_label
+from hermes.crm.i18n.options import (
+    localize_picklist_options,
+    parse_picklist_options,
+)
+from hermes.crm.picklist import is_select_like
+from hermes.crm.models.module_fields_db import ModuleFieldsDb
+from hermes.crm.models.modules_db import ModulesDb
+
+
+# Reuse ListQuery's identifier validator — it's private but stable.
+from hermes.crm.list_query import _is_safe_sql_identifier
+
+
+def _is_empty_rel(v: Any) -> bool:
+    if v is None:
+        return True
+    if isinstance(v, (int, float)):
+        return int(v) == 0
+    if isinstance(v, str):
+        s = v.strip()
+        return s == "" or s == "0"
+    return False
+
+
+class DetailQuery:
+    """Single-record detail loader."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+        self.module_id: Optional[int] = None
+        self.module: Optional[Dict[str, Any]] = None
+        self.table_name: Optional[str] = None
+        self.record_id: int = 0
+        self.user_id: int = 0
+        self.is_admin: bool = False
+
+    def _ensure_db(self) -> DbWrapper:
+        if self._db is None:
+            ctx = db_session()
+            self._db = ctx.__enter__()
+        return self._db
+
+    # ---- setters --------------------------------------------------------
+
+    def set_module(self, module_id: int) -> "DetailQuery":
+        self.module_id = int(module_id)
+        db = self._ensure_db()
+        self.module = ModulesDb(db).get_module_info(self.module_id)
+        if not self.module:
+            raise ValueError("Module not found")
+        self.table_name = self.module.get("table_name") or self.module.get("name")
+        return self
+
+    def set_record_id(self, record_id: int) -> "DetailQuery":
+        self.record_id = int(record_id or 0)
+        if self.record_id <= 0:
+            # Verbose error: agents (esp. cheap/fast LLMs running cron with no
+            # human in the loop) need enough context in the failure to decide
+            # NOT to retry with the same id. The bare "Invalid record ID"
+            # message was getting flash models stuck in 6-retry loops.
+            module_name = (self.module or {}).get("name") or "?"
+            raise ValueError(
+                f"crm_get got invalid id={record_id!r} for module={module_name!r}: "
+                f"id must be a positive integer (≥ 1). Do NOT retry with the same "
+                f"value — pick a different id from a recent crm_search result, or "
+                f"stop and ask the user."
+            )
+        return self
+
+    def set_user(self, user_id: int, is_admin: bool = False) -> "DetailQuery":
+        self.user_id = int(user_id or 0)
+        self.is_admin = bool(is_admin)
+        return self
+
+    # ---- main -----------------------------------------------------------
+
+    def execute(self) -> Dict[str, Any]:
+        if not self.module or not self.table_name:
+            raise ValueError("Module not set")
+        db = self._ensure_db()
+        pk = f"{self.table_name}_id"
+        name_col = f"{self.table_name}_name"
+
+        # Two-phase lookup so we can distinguish "never existed" from
+        # "soft-deleted" in the error message — agents (esp. cheap LLMs in
+        # unattended cron) need that distinction to stop retrying.
+        row = db.fetchone(
+            f"SELECT *, {pk} AS id, {name_col} AS name "
+            f"FROM {self.table_name} "
+            f"WHERE {pk} = %s AND (deleted = FALSE OR deleted IS NULL)",
+            (self.record_id,),
+        )
+        if not row:
+            module_name = self.module.get("name") or self.table_name
+            # Check if the row exists but was soft-deleted, so the error
+            # message can be specific. Single extra SELECT, fired only on
+            # the rare miss path — no measurable cost.
+            deleted_row = db.fetchone(
+                f"SELECT {pk} AS id FROM {self.table_name} "
+                f"WHERE {pk} = %s AND deleted = TRUE",
+                (self.record_id,),
+            )
+            if deleted_row:
+                raise ValueError(
+                    f"crm_get: record was deleted (module={module_name!r} "
+                    f"id={self.record_id}). Soft-deleted records are not "
+                    f"retrievable. Do NOT retry crm_get with this id — it "
+                    f"will never come back. Pick a different id or stop and "
+                    f"report to the user."
+                )
+            raise ValueError(
+                f"crm_get: record not found (module={module_name!r} "
+                f"id={self.record_id}). No row with this id exists. Do NOT "
+                f"retry crm_get with the same module+id — either pick a "
+                f"different id from a recent crm_search result, or stop and "
+                f"ask the user."
+            )
+
+        fields = ModuleFieldsDb(db).get_visible_fields(self.module_id) or []
+        # Mirror ListQuery's behaviour — detail payloads would otherwise
+        # come back with the raw DB field_label (English), so the frontend
+        # shows a language mix versus the localised list page.
+        self._localize_field_labels(fields)
+        self._localize_field_options(fields)
+        self._apply_display_values(row, fields)
+
+        # Overlay contact-activity projection (charter 原语 ③) —
+        # these four fields used to live on the row in kacrm, kept in
+        # sync by the ``notes`` INSERT trigger. Under the charter they
+        # are derived from ``interactions`` at read time.
+        try:
+            from hermes.crm.projections import attach_contact_stats
+            attach_contact_stats(
+                row,
+                module=str(self.module.get("name") or ""),
+                record_id=int(self.record_id),
+                db=db,
+            )
+        except Exception:  # pragma: no cover — projection is advisory
+            pass
+
+        # ``has_products`` / ``has_approval`` aren't columns on the
+        # ``modules`` table in hermes — we pattern-match by module name.
+        # Only quotes and salesorders carry product line items in this
+        # schema (see ``quotes_products`` / ``salesorders_products``).
+        module_name = str(self.module.get("name") or "")
+        has_products = module_name in {"quotes", "salesorders"}
+        # 审批 = per-module opt-in:配了 approval_config 的模块才走审批。
+        # 审批状态真相在 approvals 表,不依赖模块上的 approval_status 字段。
+        from hermes.crm.approval.engine import ApprovalEngine
+        _eng = ApprovalEngine(db)
+        _module_id = int(self.module.get("id") or 0)
+        has_approval = _module_id > 0 and _eng.get_config(_module_id) is not None
+        approval_info: Dict[str, Any] = {}
+        if has_approval:
+            _arow = db.fetchone(
+                "SELECT id FROM approvals WHERE module_id = %s AND data_id = %s "
+                "ORDER BY created_at DESC LIMIT 1",
+                (_module_id, int(self.record_id)),
+            )
+            if _arow:
+                approval_info = _eng.get_detail(int(_arow["id"])) or {}
+
+        line_items = self._load_line_items(module_name) if has_products else []
+
+        return json_serializable(
+            {
+                "success": True,
+                "module_name": self.module.get("name"),
+                "data": row,
+                "fields": fields,
+                "has_products": has_products,
+                "has_approval": has_approval,
+                "products": line_items,
+                "details": self._load_subdetails(),
+                "approval": approval_info,
+            }
+        )
+
+    def _load_line_items(self, module_name: str) -> list[Dict[str, Any]]:
+        """Load rows from the module's line-item table (``{module}_products``).
+
+        Returns a list of plain dicts with the fields the frontend needs
+        to render an itemized table. Kept read-only here — the edit path
+        writes via ``save.py``'s product handling.
+        """
+        if module_name not in {"quotes", "salesorders"}:
+            return []
+        table = f"{module_name}_products"
+        parent_col = f"{module_name}_id"
+        db = self._ensure_db()
+        try:
+            # SELECT * 带上自定义产品行列(如 类型),与编辑表单一致。
+            rows = db.fetchall(
+                f"""
+                SELECT lp.*, lp.{table}_id AS line_id
+                  FROM {table} lp
+                 WHERE lp.{parent_col} = %s
+                 ORDER BY lp.{table}_id
+                """,
+                (int(self.record_id),),
+            )
+            return [dict(r) for r in (rows or [])]
+        except Exception:
+            return []
+
+    def _load_subdetails(self) -> Dict[str, list]:
+        """加载本记录所有 generic 子明细的行,返回 {子明细名: [行]}。
+
+        P2b:generic 子明细(collections.parent_module_id=本模块,
+        detail_kind='generic')内联在父记录里。产品行仍走上面的 products。
+        权限继承:子明细随父记录读,本方法不单独鉴权(父记录已鉴权)。
+        """
+        db = self._ensure_db()
+        mid = int(self.module.get("id") or 0)
+        if not mid:
+            return {}
+        try:
+            kids = db.fetchall(
+                "SELECT name FROM collections WHERE parent_module_id = %s "
+                "AND detail_kind = 'generic'", (mid,)
+            )
+        except Exception:
+            return {}
+        out: Dict[str, list] = {}
+        parent_col = f"{self.module.get('name')}_id"
+        for k in kids or []:
+            child = k.get("name")
+            if not child:
+                continue
+            try:
+                rows = db.fetchall(
+                    f'SELECT * FROM "{child}" WHERE "{parent_col}" = %s '
+                    f'AND (deleted = FALSE OR deleted IS NULL) '
+                    f'ORDER BY "{child}_id"',
+                    (int(self.record_id),),
+                )
+                out[child] = [dict(r) for r in (rows or [])]
+            except Exception:
+                out[child] = []
+        return out
+
+    # ---- i18n --------------------------------------------------------
+
+    def _localize_field_options(self, fields: List[Dict[str, Any]]) -> None:
+        """Resolve select-option display text for the request locale.
+
+        Mirrors ``ListQuery._localize_field_options`` so the detail edit
+        drawer's dropdown shows business labels (科技 / 金融) rather than
+        the raw storage values (technology / finance). Labels come from
+        ``field_config.option_labels``; the ``options`` column itself is
+        a format-constrained CSV/JSON contract and is not mutated on disk.
+        """
+        for field in fields or []:
+            if not is_select_like(field.get("field_type")):
+                continue
+            raw = field.get("options")
+            opts = parse_picklist_options(raw)
+            if not opts:
+                continue
+            localized = localize_picklist_options(
+                opts,
+                table_name=str(self.table_name or ""),
+                field_name=str(field.get("field_name") or ""),
+                field_id=int(field.get("id") or 0),
+                field_config=field.get("field_config"),
+            )
+            if isinstance(raw, str):
+                field["options"] = json.dumps(localized, ensure_ascii=False)
+            else:
+                field["options"] = localized
+
+    def _localize_field_labels(self, fields: List[Dict[str, Any]]) -> None:
+        """Replace each field's ``field_label`` with its localised form.
+
+        Mirrors ``ListQuery._localize_field_labels`` so detail and list
+        payloads agree on the displayed label. Per-call locale comes
+        from the request-scoped ContextVar (see
+        ``hermes_cloud.app.i18n_middleware``).
+        """
+        table_name = str(self.table_name or "")
+        for field in fields:
+            field_name = str(field.get("field_name") or "")
+            if not field_name:
+                continue
+            field["field_label"] = localize_field_label(
+                table_name=table_name,
+                field_name=field_name,
+                field_label=str(field.get("field_label") or field_name),
+                field_id=int(field.get("id") or 0) or None,
+                field_config=field.get("field_config"),
+            )
+
+    # ---- display-value resolution (subset of ListQuery's logic) --------
+
+    def _apply_display_values(
+        self, row: Dict[str, Any], fields: List[Dict[str, Any]]
+    ) -> None:
+        db = self._ensure_db()
+        modules_db = ModulesDb(db)
+        for field in fields or []:
+            fn = str(field.get("field_name") or "").strip()
+            if not fn:
+                continue
+            ft = str(field.get("field_type") or "").strip()
+            v = row.get(fn)
+
+            if ft in ("user", "ownerBy", "createdBy", "updatedBy"):
+                row[fn + "_display"] = self._lookup_user_display(v)
+            elif ft == "department":
+                row[fn + "_display"] = self._lookup_department_display(v)
+            elif ft == "relation":
+                row[fn + "_display"] = self._lookup_relation(
+                    v, field, fn, modules_db
+                )
+
+    def _lookup_user_display(self, v: Any) -> str:
+        if _is_empty_rel(v):
+            return ""
+        try:
+            uid = int(v)
+        except (TypeError, ValueError):
+            return ""
+        db = self._ensure_db()
+        u = db.fetchone(
+            "SELECT COALESCE(realname, username) AS display FROM users WHERE id = %s",
+            (uid,),
+        )
+        return (u.get("display") or "").strip() if u else ""
+
+    def _lookup_department_display(self, v: Any) -> str:
+        if _is_empty_rel(v):
+            return ""
+        try:
+            did = int(v)
+        except (TypeError, ValueError):
+            return ""
+        db = self._ensure_db()
+        d = db.fetchone("SELECT name FROM departments WHERE id = %s", (did,))
+        return (d.get("name") or "").strip() if d else ""
+
+    def _relation_target_table(
+        self, field: Dict[str, Any], field_name: str, modules_db: ModulesDb
+    ) -> str:
+        """Resolve a relation field's target table name.
+
+        Authoritative source is ``field_config.relation.target_module`` (set
+        by the schema builder), so a second relation pointing at the same
+        module — which cannot reuse the ``<table>_id`` field name — still
+        resolves. Falls back to ``datainfo`` (``module_id#...``), then the
+        legacy ``<field_name>_id`` naming convention. Returns "" if no safe
+        target can be determined. Mirrors the timeline enrichment in
+        hermes_cloud so the record form and the interaction log agree.
+        """
+        cfg = field.get("field_config")
+        if isinstance(cfg, dict):
+            rel = cfg.get("relation")
+            target = rel.get("target_module") if isinstance(rel, dict) else None
+            if target and _is_safe_sql_identifier(str(target)):
+                tbl = (modules_db.get_module_by_name(str(target)) or {}).get(
+                    "table_name"
+                )
+                if tbl and _is_safe_sql_identifier(str(tbl)):
+                    return str(tbl)
+        datainfo = field.get("datainfo")
+        if datainfo:
+            parts = str(datainfo).strip().split("#")
+            if parts and parts[0].strip().isdigit():
+                tbl = (modules_db.get_module_info(int(parts[0].strip())) or {}).get(
+                    "table_name"
+                )
+                if tbl and _is_safe_sql_identifier(str(tbl)):
+                    return str(tbl)
+        if field_name.endswith("_id"):
+            cand = field_name[:-3]
+            if _is_safe_sql_identifier(cand) and (
+                modules_db.get_module_by_table_name(cand) or {}
+            ).get("table_name") == cand:
+                return cand
+        return ""
+
+    def _lookup_relation(
+        self, v: Any, field: Dict[str, Any], field_name: str,
+        modules_db: ModulesDb,
+    ) -> str:
+        """Resolve a relation FK value to its target record's ``<table>_name``."""
+        if _is_empty_rel(v):
+            return ""
+        tbl = self._relation_target_table(field, field_name, modules_db)
+        if not tbl:
+            return ""
+        try:
+            rid = int(v)
+        except (TypeError, ValueError):
+            return ""
+        db = self._ensure_db()
+        try:
+            r = db.fetchone(
+                f"SELECT {tbl}_name AS display FROM {tbl} "
+                f"WHERE deleted = FALSE AND {tbl}_id = %s",
+                (rid,),
+            )
+        except Exception:
+            return ""
+        return (r.get("display") or "").strip() if r else ""
