+"""Tests for tools.surface_acl (Phase 4 patch 27)."""
+from __future__ import annotations
+
+import contextvars
+import pytest
+
+from tools.surface_acl import (
+    bind_surface_acl, describe_current_acl, get_current_surface_acl,
+    is_tool_allowed, reset_surface_acl,
+)
+
+
+@pytest.fixture(autouse=True)
+def _isolated_acl_context():
+    yield contextvars.copy_context()
+
+
+def test_no_acl_bound_returns_none():
+    assert get_current_surface_acl() is None
+
+
+def test_no_acl_bound_allows_anything():
+    assert is_tool_allowed("update_record") is True
+    assert is_tool_allowed("bash") is True
+
+
+def test_describe_unbound():
+    assert describe_current_acl() == "<unbound>"
+
+
+def test_bind_then_allow_within_list():
+    token = bind_surface_acl({"surface": "feishu", "allow": ["update_record"]})
+    try:
+        assert is_tool_allowed("update_record") is True
+    finally:
+        reset_surface_acl(token)
+
+
+def test_bind_then_deny_outside_list():
+    token = bind_surface_acl({"surface": "feishu", "allow": ["update_record"]})
+    try:
+        assert is_tool_allowed("bash") is False
+        assert is_tool_allowed("delete_record") is False
+    finally:
+        reset_surface_acl(token)
+
+
+def test_empty_allow_list_denies_everything():
+    token = bind_surface_acl({"surface": "x", "allow": []})
+    try:
+        assert is_tool_allowed("update_record") is False
+    finally:
+        reset_surface_acl(token)
+
+
+def test_reset_returns_to_unbound_state():
+    token = bind_surface_acl({"surface": "x", "allow": ["t"]})
+    reset_surface_acl(token)
+    assert get_current_surface_acl() is None
+    assert is_tool_allowed("anything") is True
+
+
+def test_bind_with_missing_allow_field_denies():
+    token = bind_surface_acl({"surface": "feishu"})
+    try:
+        assert is_tool_allowed("update_record") is False
+    finally:
+        reset_surface_acl(token)
+
+
+def test_bind_with_non_list_allow_denies():
+    token = bind_surface_acl({"surface": "feishu", "allow": "update_record"})
+    try:
+        assert is_tool_allowed("update_record") is False
+    finally:
+        reset_surface_acl(token)
+
+
+def test_bind_with_non_dict_payload_denies():
+    token = bind_surface_acl(["update_record"])  # type: ignore[arg-type]
+    try:
+        assert is_tool_allowed("update_record") is False
+    finally:
+        reset_surface_acl(token)
+
+
+def test_describe_well_formed():
+    token = bind_surface_acl({"surface": "feishu", "allow": ["a", "b"]})
+    try:
+        s = describe_current_acl()
+        assert "feishu" in s and "allow=2" in s
+    finally:
+        reset_surface_acl(token)
+
+
+def test_describe_malformed_allow():
+    token = bind_surface_acl({"surface": "x", "allow": "not-a-list"})
+    try:
+        assert "malformed" in describe_current_acl()
+    finally:
+        reset_surface_acl(token)
+
+
+def test_acl_doesnt_leak_across_context_copy():
+    """FastAPI request-scoped ACL must not bleed across requests."""
+    token = bind_surface_acl({"surface": "outer", "allow": ["a"]})
+    try:
+        ctx = contextvars.copy_context()
+
+        def _in_inner():
+            inner_token = bind_surface_acl({"surface": "inner", "allow": ["b"]})
+            try:
+                assert get_current_surface_acl()["surface"] == "inner"
+            finally:
+                reset_surface_acl(inner_token)
+
+        ctx.run(_in_inner)
+        assert get_current_surface_acl()["surface"] == "outer"
+    finally:
+        reset_surface_acl(token)
