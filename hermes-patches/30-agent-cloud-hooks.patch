+def _build_all_skills_fingerprint(all_dirs: list[Path]) -> str:
+    """Stable SHA-256 over mtime+size of every SKILL.md/DESCRIPTION.md across
+    every skills directory (local + external).
+
+    Used as part of the in-process LRU cache key so that any change to a
+    skill file (write/delete/add) invalidates the cached prompt — without
+    this, `build_skills_system_prompt` was returning stale prompts even
+    after files on disk changed (the LRU layer never consulted the disk
+    snapshot's manifest).
+    """
+    import hashlib
+
+    h = hashlib.sha256()
+    for skills_dir in all_dirs:
+        if not skills_dir.is_dir():
+            continue
+        # Include the dir itself in the hash so reordering or directory
+        # disappearance is reflected.
+        h.update(b"DIR\x00")
+        h.update(str(skills_dir.resolve()).encode("utf-8"))
+        h.update(b"\n")
+        for filename in ("SKILL.md", "DESCRIPTION.md"):
+            for path in iter_skill_index_files(skills_dir, filename):
+                try:
+                    st = path.stat()
+                except OSError:
+                    continue
+                h.update(str(path).encode("utf-8"))
+                h.update(b"\x00")
+                h.update(str(st.st_mtime_ns).encode("ascii"))
+                h.update(b"\x00")
+                h.update(str(st.st_size).encode("ascii"))
+                h.update(b"\n")
+    return h.hexdigest()
+
+
