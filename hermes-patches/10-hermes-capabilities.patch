new file mode 100644
index 0000000000..4027ff4abb
--- /dev/null
+++ b/crm/list_query.py
@@ -0,0 +1,1562 @@
+"""List query builder — port of kacrm's ``app/includes/list_query.py``.
+
+Structurally a one-to-one port: same classes, same method names, same control
+flow, same return shape (``success, module_name, data, fields, total, page,
+limit, context, total_summary, default_currency, default_currency_symbol``).
+The only substantive change is the SQL dialect — every MySQL-ism that would
+throw on PostgreSQL is rewritten:
+
+  * `` `col` `` backticks → unquoted identifiers (our schema uses lowercase
+    snake_case consistently)
+  * ``deleted = 0`` → ``deleted = FALSE``
+  * ``LIKE`` on human text → ``ILIKE`` (PG's case-insensitive LIKE — matches
+    MySQL's default ``utf8mb4_unicode_ci`` collation behaviour)
+  * ``JSON_UNQUOTE(JSON_EXTRACT(col, '$.key'))`` → ``col::jsonb->>'key'``
+  * ``JSON_TYPE(col)`` → ``jsonb_typeof(col::jsonb)``
+  * ``IFNULL`` → ``COALESCE``
+  * ``IF(cond, a, b)`` → ``CASE WHEN cond THEN a ELSE b END``
+  * ``CAST(x AS DECIMAL(24,6))`` → ``CAST(x AS NUMERIC(24,6))``
+  * ``CAST(x AS CHAR(1024))`` → ``CAST(x AS TEXT)``
+  * ``GROUP_CONCAT(DISTINCT x SEPARATOR ', ')`` → ``STRING_AGG(DISTINCT x, ', ')``
+  * ``is_active = 1`` on lookup tables → ``is_active = TRUE``
+
+The product-aggregate code paths (``_append_list_product_aggregate_fields``,
+``_merge_product_list_aggregates``, ``_expand_rows_with_product_lines``, the
+``_fetch_stock*_by_*`` helpers) are ported structurally but early-exit for
+every Phase-1 module because ``has_products=0`` in our ``collections`` shim.
+Phase 2 will flip those flags on when quotes / salesorders land and the
+corresponding ``{module}_products`` / ``stock_details`` tables exist.
+
+The filter grammar (``eq``, ``neq``, ``gt``, ``gte``, ``lt``, ``lte``,
+``contains``, ``not_contains``, ``starts_with``, ``ends_with``, ``is_empty``,
+``is_not_empty``, ``in``) is unchanged — normalizer and operator map are
+reused verbatim from :mod:`hermes.crm.i18n.filter_normalizer` /
+:mod:`.filter_operators`. Relation filters use kacrm's ``field#module_id``
+syntax and resolve through our :class:`ModulesDb` shim.
+"""
+from __future__ import annotations
+
+import copy
+import json
+import logging
+import re
+from collections import defaultdict
+from typing import Any, Dict, List, Optional, Tuple
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.crm.functions import (
+    ec_number_format,
+    get_currency_data,
+    json_serializable,
+)
+from hermes.crm.i18n import get_current_locale
+from hermes.crm.i18n.field_labels import localize_field_label
+from hermes.crm.i18n.filter_normalizer import normalize_filter_list
+from hermes.crm.i18n.filter_operators import normalize_filter_operator
+from hermes.crm.i18n.options import (
+    localize_picklist_options,
+    parse_picklist_options,
+)
+from hermes.crm.picklist import is_select_like
+from hermes.crm.models.module_view_fields_db import ModuleViewFieldsDb
+from hermes.crm.models.module_views_db import ModuleViewsDb
+from hermes.crm.models.modules_db import ModulesDb
+from hermes.crm.module_product_fields import (
+    parse_module_product_fields,
+    parse_view_list_product_columns,
+    virtual_stock_qty_field_stubs,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def _parse_filter_in_value(val: Any) -> List[int]:
+    """Parse ``in`` operator value — JSON array or comma-separated string."""
+    if val is None or val == "":
+        return []
+    if isinstance(val, list):
+        return [int(x) for x in val if x is not None and str(x).strip().isdigit()]
+    if isinstance(val, str):
+        val = val.strip()
+        if val.startswith("["):
+            try:
+                arr = json.loads(val)
+                return [int(x) for x in arr if x is not None and str(x).strip().isdigit()]
+            except (TypeError, ValueError):
+                pass
+        return [int(x.strip()) for x in val.split(",") if x.strip().isdigit()]
+    return []
+
+
+def _is_safe_sql_identifier(name: str) -> bool:
+    return bool(name) and re.match(r"^[A-Za-z0-9_]+$", str(name)) is not None
+
+
+# Line-item columns that are always scalar numeric even when ``product_fields``
+# mislabels them as text — stops the code from falling into the JSON-or-text
+# branch and emitting a GROUP_CONCAT that wipes the numeric summary out.
+_SCALAR_PRODUCT_SUM_FIELD_NAMES = frozenset(
+    {
+        "quantity",
+        "tax_rate",
+        "cost_price",
+        "discount_rate",
+        "stockout_quantity",
+        "stockin_quantity",
+        "reference_id",
+        "reference_products_id",
+    }
+)
+
+
+def _dict_get_ci(d: Optional[Dict[str, Any]], key: str) -> Any:
+    """Case-insensitive dict get — psycopg3 should always return lowercase
+    keys via ``dict_row``, but kacrm's code did this and we keep the habit."""
+    if not d:
+        return None
+    if key in d:
+        return d[key]
+    lk = key.lower()
+    for k, v in d.items():
+        if str(k).lower() == lk:
+            return v
+    return None
+
+
+def _is_computed_product_stock_qty_field(table_name: str, field_name: str) -> bool:
+    """``stockout_quantity`` / ``stockin_quantity`` are computed off
+    ``stock_details``, not read from the ``{module}_products`` row directly.
+    """
+    fn = (field_name or "").strip()
+    tn = (table_name or "").strip()
+    if fn == "stockout_quantity" and tn == "salesorders":
+        return True
+    if fn == "stockin_quantity" and tn == "purchasesorders":
+        return True
+    return False
+
+
+# SQL keyword set used by ``_qualify_main_where_for_join`` to avoid prefixing
+# operators / literals when aliasing bare column identifiers for a JOIN.
+_SQL_KEYWORDS = frozenset(
+    [
+        "AND", "OR", "NOT", "IS", "NULL", "TRUE", "FALSE", "IN", "LIKE",
+        "ILIKE", "BETWEEN", "CASE", "WHEN", "THEN", "ELSE", "END", "AS",
+        "COALESCE", "CAST", "NUMERIC", "INTEGER", "TEXT", "BIGINT", "BOOLEAN",
+        "DISTINCT", "SELECT", "FROM", "WHERE", "GROUP", "BY", "ORDER",
+        "HAVING", "LEFT", "RIGHT", "INNER", "JOIN", "ON", "UNION", "ALL",
+        "ASC", "DESC", "LIMIT", "OFFSET", "EXISTS", "ANY", "SOME", "USING",
+        "CROSS", "OUTER", "FULL",
+    ]
+)
+
+
+class ListQuery:
+    """List endpoint assembler.
+
+    Usage::
+
+        lq = ListQuery(db).set_module(module_id, view_id)
+        lq.set_pagination(page, limit).set_search(q).set_filters(filters, "all")
+        lq.set_sort("updated_at", "desc")
+        lq.set_extra_where(scope_sql, scope_params)
+        result = lq.execute()
+    """
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        # Caller-supplied wrapper wins; otherwise we lazy-borrow one from the
+        # pool on first use via the ``_db()`` accessor so test harnesses can
+        # stub it out.
+        self.db: Optional[DbWrapper] = db
+        self._owned_session = None
+        self.module_id: Optional[int] = None
+        self.module: Optional[Dict[str, Any]] = None
+        self.table_name: Optional[str] = None
+        self.fields_list: List[Dict[str, Any]] = []
+        self.field_map: Dict[str, Dict[str, Any]] = {}
+        self.page = 1
+        self.limit = 10
+        self.offset = 0
+        self.search = ""
+        self.filters: List[Any] = []
+        self.sort_field = "updated_at"
+        self.sort_direction = "DESC"
+        self.main_field_name = ""
+        self.entry_field_name = ""
+        self.extra_where_sql: str = ""
+        self.extra_where_params: List[Any] = []
+        self.filter_logic: str = "all"
+        self._active_view_id: Optional[int] = None
+        self._list_product_columns_spec: List[Dict[str, Any]] = []
+        self._product_field_def_by_name: Dict[str, Dict[str, Any]] = {}
+
+    def _ensure_db(self) -> DbWrapper:
+        """Resolve the :class:`DbWrapper` the ListQuery should use.
+
+        Caller can pass one explicitly (e.g. a request-scoped dependency);
+        otherwise we borrow one from :func:`db_session` which is released
+        implicitly when the Python process walks off the last reference.
+        """
+        if self.db is not None:
+            return self.db
+        if self._owned_session is None:
+            self._owned_session = db_session()
+            self.db = self._owned_session.__enter__()
+        assert self.db is not None
+        return self.db
+
+    # ------------------------------------------------------------------
+    # builder methods
+    # ------------------------------------------------------------------
+
+    def set_extra_where(self, sql: str, params: List[Any]) -> "ListQuery":
+        """Attach a view-scope / RBAC WHERE fragment alongside ``filters``."""
+        self.extra_where_sql = sql or ""
+        self.extra_where_params = list(params) if params else []
+        return self
+
+    def set_module(self, module_id: int, view_id: Optional[int]) -> "ListQuery":
+        db = self._ensure_db()
+        view_fields_db = ModuleViewFieldsDb(db)
+        self.module_id = module_id
+
+        if view_id:
+            raw_fields = view_fields_db.get_fields_with_view_settings_by_view(
+                view_id, only_in_view=True
+            )
+        else:
+            raw_fields = view_fields_db.get_fields_with_view_settings_by_module(
+                module_id
+            )
+
+        modules_db = ModulesDb(db)
+        self.module = modules_db.get_module_info(self.module_id)
+        if not self.module:
+            raise ValueError("Module not found")
+        self.table_name = self.module["table_name"]
+        self.fields_list = list(raw_fields)
+        self._active_view_id = int(view_id) if view_id else None
+        self._localize_field_labels(self.fields_list)
+        self._localize_field_options(self.fields_list)
+        self.entry_field_name = self._resolve_entry_field_name(raw_fields)
+        self._append_list_product_aggregate_fields()
+        self.field_map = {f["field_name"]: f for f in self.fields_list}
+        self.main_field_name = f"{self.table_name}_name"
+        return self
+
+    def set_pagination(self, page: int = 1, limit: int = 10) -> "ListQuery":
+        self.page = max(1, page)
+        self.limit = max(1, limit)
+        self.offset = (self.page - 1) * self.limit
+        return self
+
+    def set_search(self, search: str = "") -> "ListQuery":
+        self.search = (search or "").strip()
+        return self
+
+    def set_filters(self, filters: List[Any], filter_logic: str = "all") -> "ListQuery":
+        self.filters = filters if isinstance(filters, list) else []
+        self.filter_logic = (filter_logic or "all").strip().lower()
+        return self
+
+    def set_sort(self, field: str = "updated_at", direction: str = "desc") -> "ListQuery":
+        raw = (field or "updated_at").strip()
+        self.sort_field = raw if _is_safe_sql_identifier(raw) else "updated_at"
+        self.sort_direction = "ASC" if (direction or "").strip().lower() == "asc" else "DESC"
+        return self
+
+    # ------------------------------------------------------------------
+    # main execution
+    # ------------------------------------------------------------------
+
+    def execute(self) -> Dict[str, Any]:
+        db = self._ensure_db()
+        if not self.table_name or not self.module:
+            raise ValueError("Module not set")
+        where = " deleted = FALSE "
+        params: List[Any] = []
+        if self.search:
+            name_col = f"{self.table_name}_name"
+            where += " AND " + name_col + " ILIKE %s "
+            params.append(f"%{self.search}%")
+        filter_sql, filter_params = self._build_filters()
+        if filter_sql:
+            where += " AND " + filter_sql
+            params.extend(filter_params)
+        if self.extra_where_sql:
+            where += " AND (" + self.extra_where_sql + ")"
+            params.extend(self.extra_where_params)
+        count_sql = f"SELECT COUNT(*) AS n FROM {self.table_name} WHERE {where}"
+        total_row = db.fetchone(count_sql, tuple(params) if params else None)
+        total = int(total_row["n"]) if total_row else 0
+        total_summary = self._calculate_total_summary(where, params)
+        prod_line_totals = self._calculate_product_line_summary_totals(where, params)
+        if prod_line_totals:
+            if not isinstance(total_summary, dict):
+                total_summary = {}
+            total_summary.update(prod_line_totals)
+        pk = f"{self.table_name}_id"
+        name_col = f"{self.table_name}_name"
+        order = f" ORDER BY {self.sort_field} {self.sort_direction} LIMIT %s OFFSET %s"
+        select_sql = f"SELECT * FROM {self.table_name} WHERE {where}{order}"
+        list_params = list(params) + [self.limit, self.offset]
+        items = db.fetchall(select_sql, tuple(list_params))
+        currency_data = get_currency_data(db)
+        currencies = currency_data.get("currencies") or {}
+        default_currency = currency_data.get("default_currency") or ""
+        default_currency_symbol = (currencies.get(default_currency) or {}).get("symbol", "")
+        # Frontend TableRenderer / DetailManager look for ``id``; EditRelated
+        # widgets pull the human name from ``name``. Normalize both.
+        for row in items or []:
+            if pk and pk in row and "id" not in row:
+                row["id"] = row[pk]
+            if name_col in row:
+                name_val = (row.get(name_col) or "").strip()
+                if not name_val and self.entry_field_name and self.entry_field_name in row:
+                    name_val = str(row.get(self.entry_field_name) or "").strip()
+                if not name_val:
+                    for f in self.fields_list or []:
+                        if str(f.get("field_type") or "") != "autoNumber":
+                            continue
+                        fn = str(f.get("field_name") or "").strip()
+                        fallback_name = str(row.get(fn) or "").strip()
+                        if fallback_name:
+                            name_val = fallback_name
+                            row[name_col] = fallback_name
+                            break
+                if name_val:
+                    row[name_col] = name_val
+                if "name" not in row:
+                    row["name"] = name_val
+            self._normalize_currency_fields(row, currencies)
+        items = self._expand_rows_with_product_lines(items or [])
+        self._apply_display_values(items or [])
+        # Overlay charter-style contact projections (latest_contact_date,
+        # latest_progress, next_contact_date, contact_count, latest_kind).
+        # Single SQL round-trip for the full page. No-op for modules
+        # without a "last contact" concept.
+        try:
+            from hermes.crm.projections.contact_stats import (
+                attach_contact_stats_batch,
+            )
+            attach_contact_stats_batch(items or [], module=self.module["name"], db=db)
+        except Exception:
+            # Projection failures must never fail the list request;
+            # contact_stats is an overlay, not core data.
+            import logging
+            logging.getLogger(__name__).exception(
+                "list_contact_stats_overlay_failed module=%s",
+                self.module.get("name"),
+            )
+        return {
+            "success": True,
+            "module_name": self.module["name"],
+            "table_name": self.table_name,
+            "main_field_name": self.main_field_name,
+            "entry_field_name": self.entry_field_name,
+            "data": json_serializable(items),
+            "fields": self.fields_list,
+            "total": total,
+            "page": self.page,
+            "limit": self.limit,
+            "context": {},
+            "total_summary": total_summary,
+            "default_currency": default_currency,
+            "default_currency_symbol": default_currency_symbol,
+        }
+
+    # ------------------------------------------------------------------
+    # total summaries
+    # ------------------------------------------------------------------
+
+    def _calculate_total_summary(
+        self, where: str, params: List[Any]
+    ) -> Dict[str, float] | List[Any]:
+        """Sum numeric / currency columns across the filtered set."""
+        number_fields: List[Dict[str, Any]] = []
+        for f in self.fields_list or []:
+            fn = str(f.get("field_name") or "").strip()
+            if f.get("list_no_filter") or fn.startswith("product_agg_"):
+                continue
+            ft = str(f.get("field_type") or "").lower()
+            if ft in ("number", "currency", "currencyjson"):
+                number_fields.append(f)
+        if not number_fields:
+            return []
+
+        sum_exprs: List[str] = []
+        aliases: List[str] = []
+        for f in number_fields:
+            fname = str(f.get("field_name") or "").strip()
+            if not fname or not _is_safe_sql_identifier(fname):
+                continue
+            aliases.append(fname)
+            # All numeric-ish columns (including legacy currency /
+            # currencyjson typed metadata) are NUMERIC since alembic 0079
+            # — no jsonb_typeof dual-shape branching needed.
+            expr = f"SUM(COALESCE(CAST({fname} AS NUMERIC(24,6)), 0)) AS {fname}"
+            sum_exprs.append(expr)
+        if not sum_exprs:
+            return []
+
+        sql = f"SELECT {', '.join(sum_exprs)} FROM {self.table_name} WHERE {where}"
+        db = self._ensure_db()
+        try:
+            summary_row = db.fetchone(sql, tuple(params) if params else None) or {}
+        except Exception as e:
+            # currencyJson column may be plain text on some rows — be tolerant
+            # instead of blowing up the whole list.
+            logger.warning("total summary failed table=%s err=%s", self.table_name, e)
+            return []
+        summary: Dict[str, float] = {}
+        for alias in aliases:
+            val = summary_row.get(alias)
+            try:
+                summary[alias] = float(val) if val is not None else 0.0
+            except (TypeError, ValueError):
+                summary[alias] = 0.0
+        return summary
+
+    def _qualify_main_where_for_join(
+        self, where: str, table_name: str, alias: str
+    ) -> str:
+        """Rewrite a main-table WHERE so every bare column ref becomes
+        ``{alias}.col`` — used when we join the main table to ``{table}_products``
+        for the product-line summary query.
+
+        Unlike kacrm's regex (which assumed backticked identifiers), the PG
+        port must skip SQL keywords and literals when prefixing.
+        """
+        w = (where or "").strip()
+        if not w or not _is_safe_sql_identifier(table_name) or not _is_safe_sql_identifier(alias):
+            return w
+
+        def _prefix(match: "re.Match[str]") -> str:
+            word = match.group(0)
+            upper = word.upper()
+            if upper in _SQL_KEYWORDS:
+                return word
+            if word.isdigit():
+                return word
+            return f"{alias}.{word}"
+
+        # Skip identifiers that are already qualified (``foo.bar``) or are
+        # inside quoted strings. psycopg2 has already parameterized ``%s``
+        # placeholders, so literal values are not in the string.
+        parts: List[str] = []
+        # Tokenize into quoted vs unquoted runs so we don't qualify literals.
+        for piece in re.split(r"('(?:[^']|'')*')", w):
+            if not piece:
+                continue
+            if piece.startswith("'"):
+                parts.append(piece)
+                continue
+            piece = re.sub(r"(?<![\w.])([A-Za-z_][A-Za-z0-9_]*)\b", _prefix, piece)
+            parts.append(piece)
+        return "".join(parts)
+
+    def _product_field_sum_inner_expr_pp(self, fn: str, ftype: str) -> str:
+        """Per-row contribution expression for a SUM over the line table
+        (aliased ``pp``)."""
+        col = f"pp.{fn}"
+        if fn in _SCALAR_PRODUCT_SUM_FIELD_NAMES:
+            return f"COALESCE(CAST({col} AS NUMERIC(24,6)), 0)"
+        ft = (ftype or "text").lower()
+        numeric_types = ("number", "currency", "currencyjson", "integer", "percent", "float", "double")
+        if ft in numeric_types:
+            # All amount columns are NUMERIC since alembic 0079 — the
+            # jsonb_typeof dual-shape branch is gone.
+            return f"COALESCE(CAST({col} AS NUMERIC(24,6)), 0)"
+        return "0"
+
+    def _calculate_product_line_summary_totals(
+        self, where: str, params: List[Any]
+    ) -> Dict[str, float]:
+        """Sum ``summary=true`` numeric product-line columns across the
+        filtered parent set. Always empty for modules where ``has_products=0``.
+        """
+        out: Dict[str, float] = {}
+        tn = self.table_name or ""
+        if not tn or not self.module or int(self.module.get("has_products") or 0) != 1:
+            return out
+        if not self._list_product_columns_spec:
+            return out
+        pt = f"{tn}_products"
+        pk = f"{tn}_id"
+        if not all(_is_safe_sql_identifier(x) for x in (tn, pt, pk)):
+            return out
+
+        sum_parts: List[str] = []
+        keys: List[str] = []
+        for spec in self._list_product_columns_spec:
+            fn = str(spec.get("field_name") or "").strip()
+            if not fn or not _is_safe_sql_identifier(fn):
+                continue
+            meta = self._product_field_def_by_name.get(fn, {})
+            if not bool(meta.get("summary")):
+                continue
+            if _is_computed_product_stock_qty_field(tn, fn):
+                continue
+            ftype = str(meta.get("field_type") or "text")
+            _ft = ftype.lower()
+            if _ft not in ("number", "currency", "currencyjson", "integer", "percent", "float", "double") and fn not in _SCALAR_PRODUCT_SUM_FIELD_NAMES:
+                continue
+            inner = self._product_field_sum_inner_expr_pp(fn, ftype)
+            syn = f"product_agg_{fn}"
+            sum_parts.append(f"COALESCE(SUM({inner}), 0) AS {syn}")
+            keys.append(syn)
+        if not sum_parts:
+            return out
+
+        qualified = self._qualify_main_where_for_join(where, tn, "m")
+        sql = (
+            f"SELECT {', '.join(sum_parts)} FROM {pt} pp "
+            f"INNER JOIN {tn} m ON pp.{pk} = m.{pk} "
+            f"WHERE {qualified}"
+        )
+        try:
+            db = self._ensure_db()
+            row = db.fetchone(sql, tuple(params) if params else None) or {}
+        except Exception as e:
+            logger.warning("product line summary totals failed table=%s err=%s", tn, e)
+            return out
+        for syn in keys:
+            val = _dict_get_ci(row, syn)
+            try:
+                out[syn] = float(val) if val is not None else 0.0
+            except (TypeError, ValueError):
+                out[syn] = 0.0
+        return out
+
+    # ------------------------------------------------------------------
+    # entry-field / product-column resolution
+    # ------------------------------------------------------------------
+
+    def _resolve_entry_field_name(self, fields: List[Dict[str, Any]]) -> str:
+        main_name = f"{self.table_name}_name" if self.table_name else ""
+        visible_fields = [f for f in (fields or []) if bool(f.get("is_visible") or False)]
+        visible_names = [
+            str(f.get("field_name") or "").strip()
+            for f in visible_fields
+            if str(f.get("field_name") or "").strip()
+        ]
+        if main_name in visible_names:
+            return main_name
+        for f in visible_fields:
+            if (f.get("field_type") or "") == "autoNumber":
+                candidate = str(f.get("field_name") or "").strip()
+                if candidate:
+                    return candidate
+        if visible_names:
+            return visible_names[0]
+        return main_name
+
+    def _resolve_view_id_for_list_product_columns(self) -> Optional[int]:
+        """``list_show_products`` lives on ``module_views``: use the active
+        view if any, otherwise fall back to the module's default view."""
+        if self._active_view_id:
+            return int(self._active_view_id)
+        mid = int(self.module_id or 0)
+        if not mid:
+            return None
+        db = self._ensure_db()
+        views = ModuleViewsDb(db).get_module_views(mid)
+        if not views:
+            return None
+        for row in views:
+            if bool(row.get("is_default") or False):
+                try:
+                    return int(row["id"])
+                except (TypeError, ValueError, KeyError):
+                    break
+        try:
+            return int(views[0]["id"])
+        except (TypeError, ValueError, KeyError, IndexError):
+            return None
+
+    def _append_list_product_aggregate_fields(self) -> None:
+        self._list_product_columns_spec = []
+        self._product_field_def_by_name = {}
+        if not self.module or int(self.module.get("has_products") or 0) != 1:
+            return
+        cfg_view_id = self._resolve_view_id_for_list_product_columns()
+        if not cfg_view_id:
+            return
+        for p in parse_module_product_fields(self.module):
+            n = str(p.get("field_name") or "").strip()
+            if n and p.get("is_visible", True) is not False:
+                self._product_field_def_by_name[n] = p
+        product_table = f"{self.table_name}_products"
+        for stub in virtual_stock_qty_field_stubs(self.table_name):
+            n = str(stub.get("field_name") or "").strip()
+            if not n or n in self._product_field_def_by_name:
+                continue
+            self._product_field_def_by_name[n] = {
+                **dict(stub),
+                "field_label": localize_field_label(
+                    table_name=product_table,
+                    field_name=n,
+                    field_label=n,
+                    field_id=None,
+                ),
+            }
+        db = self._ensure_db()
+        view_row = ModuleViewsDb(db).get_view_by_id(int(cfg_view_id)) or {}
+        mode, _saved_specs = parse_view_list_product_columns(view_row.get("list_show_products"))
+
+        rows_to_add: List[Tuple[str, Any, int]] = []
+        if mode == "all":
+            rows_keys: set[str] = set()
+            for i, p in enumerate(parse_module_product_fields(self.module)):
+                fn = str(p.get("field_name") or "").strip()
+                if not fn or p.get("is_visible", True) is False:
+                    continue
+                if fn not in self._product_field_def_by_name or not _is_safe_sql_identifier(fn):
+                    continue
+                rows_to_add.append((fn, None, i))
+                rows_keys.add(fn)
+            for stub in virtual_stock_qty_field_stubs(self.table_name):
+                fn = str(stub.get("field_name") or "").strip()
+                if (
+                    fn
+                    and fn not in rows_keys
+                    and fn in self._product_field_def_by_name
+                    and _is_safe_sql_identifier(fn)
+                ):
+                    rows_to_add.append((fn, None, len(rows_to_add)))
+                    rows_keys.add(fn)
+        else:
+            return
+
+        for i, (fn, width, sort_order) in enumerate(rows_to_add):
+            meta = self._product_field_def_by_name[fn]
+            raw_lbl = str(meta.get("field_label") or fn).strip()
+            try:
+                pf_id = int(meta.get("id") or meta.get("field_id") or 0)
+            except (TypeError, ValueError):
+                pf_id = 0
+            lbl = localize_field_label(
+                table_name=product_table,
+                field_name=fn,
+                field_label=raw_lbl,
+                field_id=pf_id if pf_id > 0 else None,
+                field_config=meta.get("field_config"),
+            )
+            syn = f"product_agg_{fn}"
+            self._list_product_columns_spec.append(
+                {"field_name": fn, "width": width, "sort_order": sort_order}
+            )
+            _ft = str(meta.get("field_type") or "text").lower()
+            _is_num = _ft in (
+                "number", "currency", "currencyjson", "integer", "percent", "float", "double",
+            ) or fn in _SCALAR_PRODUCT_SUM_FIELD_NAMES
+            _summary = bool(meta.get("summary"))
+            self.fields_list.append(
+                {
+                    "id": -(1_000_000 + i + 1),
+                    "field_name": syn,
+                    "field_label": lbl,
+                    "field_type": "text",
+                    "is_visible": 1,
+                    "list_no_filter": 1,
+                    "summary": 1 if _summary else 0,
+                    "product_agg_amount": 1 if (_summary and _is_num) else 0,
+                    "product_agg_currency": 1
+                    if (_summary and _ft in ("currency", "currencyjson"))
+                    else 0,
+                }
+            )
+
+    def _product_field_agg_sql_expr(self, fn: str, ftype: str, alias: str) -> str:
+        """Aggregation expression for one product column. All amount
+        columns are NUMERIC since alembic 0079 — no jsonb_typeof
+        branching needed."""
+        col = f"{fn}"
+        if fn in _SCALAR_PRODUCT_SUM_FIELD_NAMES:
+            return f"SUM(COALESCE(CAST({col} AS NUMERIC(24,6)), 0)) AS {alias}"
+        ft = (ftype or "text").lower()
+        numeric_types = ("number", "currency", "currencyjson", "integer", "percent", "float", "double")
+        if ft in numeric_types:
+            return f"SUM(COALESCE(CAST({col} AS NUMERIC(24,6)), 0)) AS {alias}"
+        return (
+            f"STRING_AGG(DISTINCT NULLIF(TRIM(CAST({col} AS TEXT)), ''), ', ') "
+            f"AS {alias}"
+        )
+
+    # ------------------------------------------------------------------
+    # computed stock quantity helpers (Phase 2 — salesorders / purchasesorders)
+    # ------------------------------------------------------------------
+
+    def _fetch_stockout_qty_agg_by_parent(
+        self, parent_params: Tuple[int, ...], placeholders: str
+    ) -> Dict[int, float]:
+        sql = (
+            "SELECT sop.salesorders_id AS _parent_id, "
+            "(COALESCE(SUM(CASE WHEN sd.is_cancel = FALSE AND sd.stock_type = 'out' "
+            "THEN sd.quantity ELSE 0 END), 0) - "
+            "COALESCE(SUM(CASE WHEN sd.is_cancel = TRUE AND sd.stock_type = 'out_cancel' "
+            "THEN sd.quantity ELSE 0 END), 0)) AS _qty "
+            "FROM salesorders_products sop "
+            "LEFT JOIN stockouts_products sp ON sp.reference_id = sop.salesorders_id "
+            "AND sp.reference_products_id = sop.salesorders_products_id "
+            "AND sp.reference_type = 'salesorders' "
+            "LEFT JOIN stock_details sd ON sd.reference_id = sp.stockouts_id "
+            "AND sp.stockouts_products_id = sd.reference_products_id "
+            "AND sd.reference_type = 'stockouts' "
+            f"WHERE sop.salesorders_id IN ({placeholders}) "
+            "GROUP BY sop.salesorders_id"
+        )
+        out: Dict[int, float] = {}
+        db = self._ensure_db()
+        for ar in db.fetchall(sql, parent_params) or []:
+            pid = _dict_get_ci(ar, "_parent_id")
+            if pid is None:
+                continue
+            try:
+                out[int(pid)] = float(_dict_get_ci(ar, "_qty") or 0)
+            except (TypeError, ValueError):
+                continue
+        return out
+
+    def _fetch_stockin_qty_agg_by_parent(
+        self, parent_params: Tuple[int, ...], placeholders: str
+    ) -> Dict[int, float]:
+        sql = (
+            "SELECT pop.purchasesorders_id AS _parent_id, "
+            "(COALESCE(SUM(CASE WHEN sd.is_cancel = FALSE AND sd.stock_type = 'in' "
+            "THEN sd.quantity ELSE 0 END), 0) - "
+            "COALESCE(SUM(CASE WHEN sd.is_cancel = TRUE AND sd.stock_type = 'in_cancel' "
+            "THEN sd.quantity ELSE 0 END), 0)) AS _qty "
+            "FROM purchasesorders_products pop "
+            "LEFT JOIN stockins_products sp ON sp.reference_id = pop.purchasesorders_id "
+            "AND sp.reference_products_id = pop.purchasesorders_products_id "
+            "AND sp.reference_type = 'purchasesorders' "
+            "LEFT JOIN stock_details sd ON sd.reference_id = sp.stockins_id "
+            "AND sp.stockins_products_id = sd.reference_products_id "
+            "AND sd.reference_type = 'stockins' "
+            f"WHERE pop.purchasesorders_id IN ({placeholders}) "
+            "GROUP BY pop.purchasesorders_id"
+        )
+        out: Dict[int, float] = {}
+        db = self._ensure_db()
+        for ar in db.fetchall(sql, parent_params) or []:
+            pid = _dict_get_ci(ar, "_parent_id")
+            if pid is None:
+                continue
+            try:
+                out[int(pid)] = float(_dict_get_ci(ar, "_qty") or 0)
+            except (TypeError, ValueError):
+                continue
+        return out
+
+    def _fetch_stockout_qty_by_line(
+        self, parent_params: Tuple[int, ...], placeholders: str
+    ) -> Dict[Tuple[int, int], float]:
+        sql = (
+            "SELECT sop.salesorders_id AS _parent_id, "
+            "sop.salesorders_products_id AS _line_id, "
+            "(COALESCE(SUM(CASE WHEN sd.is_cancel = FALSE AND sd.stock_type = 'out' "
+            "THEN sd.quantity ELSE 0 END), 0) - "
+            "COALESCE(SUM(CASE WHEN sd.is_cancel = TRUE AND sd.stock_type = 'out_cancel' "
+            "THEN sd.quantity ELSE 0 END), 0)) AS _qty "
+            "FROM salesorders_products sop "
+            "LEFT JOIN stockouts_products sp ON sp.reference_id = sop.salesorders_id "
+            "AND sp.reference_products_id = sop.salesorders_products_id "
+            "AND sp.reference_type = 'salesorders' "
+            "LEFT JOIN stock_details sd ON sd.reference_id = sp.stockouts_id "
+            "AND sp.stockouts_products_id = sd.reference_products_id "
+            "AND sd.reference_type = 'stockouts' "
+            f"WHERE sop.salesorders_id IN ({placeholders}) "
+            "GROUP BY sop.salesorders_id, sop.salesorders_products_id"
+        )
+        out: Dict[Tuple[int, int], float] = {}
+        db = self._ensure_db()
+        for ar in db.fetchall(sql, parent_params) or []:
+            pid = _dict_get_ci(ar, "_parent_id")
+            lid = _dict_get_ci(ar, "_line_id")
+            if pid is None or lid is None:
+                continue
+            try:
+                out[(int(pid), int(lid))] = float(_dict_get_ci(ar, "_qty") or 0)
+            except (TypeError, ValueError):
+                continue
+        return out
+
+    def _fetch_stockin_qty_by_line(
+        self, parent_params: Tuple[int, ...], placeholders: str
+    ) -> Dict[Tuple[int, int], float]:
+        sql = (
+            "SELECT pop.purchasesorders_id AS _parent_id, "
+            "pop.purchasesorders_products_id AS _line_id, "
+            "(COALESCE(SUM(CASE WHEN sd.is_cancel = FALSE AND sd.stock_type = 'in' "
+            "THEN sd.quantity ELSE 0 END), 0) - "
+            "COALESCE(SUM(CASE WHEN sd.is_cancel = TRUE AND sd.stock_type = 'in_cancel' "
+            "THEN sd.quantity ELSE 0 END), 0)) AS _qty "
+            "FROM purchasesorders_products pop "
+            "LEFT JOIN stockins_products sp ON sp.reference_id = pop.purchasesorders_id "
+            "AND sp.reference_products_id = pop.purchasesorders_products_id "
+            "AND sp.reference_type = 'purchasesorders' "
+            "LEFT JOIN stock_details sd ON sd.reference_id = sp.stockins_id "
+            "AND sp.stockins_products_id = sd.reference_products_id "
+            "AND sd.reference_type = 'stockins' "
+            f"WHERE pop.purchasesorders_id IN ({placeholders}) "
+            "GROUP BY pop.purchasesorders_id, pop.purchasesorders_products_id"
+        )
+        out: Dict[Tuple[int, int], float] = {}
+        db = self._ensure_db()
+        for ar in db.fetchall(sql, parent_params) or []:
+            pid = _dict_get_ci(ar, "_parent_id")
+            lid = _dict_get_ci(ar, "_line_id")
+            if pid is None or lid is None:
+                continue
+            try:
+                out[(int(pid), int(lid))] = float(_dict_get_ci(ar, "_qty") or 0)
+            except (TypeError, ValueError):
+                continue
+        return out
+
+    def _inject_computed_stock_qty_into_product_lines(
+        self,
+        prod_rows: List[Dict[str, Any]],
+        pk: str,
+        line_pk: str,
+        parent_params: Tuple[int, ...],
+        placeholders: str,
+    ) -> None:
+        tn = self.table_name or ""
+        want_out = any(
+            _is_computed_product_stock_qty_field(tn, str(s.get("field_name") or ""))
+            and str(s.get("field_name") or "") == "stockout_quantity"
+            for s in self._list_product_columns_spec
+        )
+        want_in = any(
+            _is_computed_product_stock_qty_field(tn, str(s.get("field_name") or ""))
+            and str(s.get("field_name") or "") == "stockin_quantity"
+            for s in self._list_product_columns_spec
+        )
+        line_map: Dict[Tuple[int, int], float] = {}
+        if want_out and tn == "salesorders":
+            line_map = self._fetch_stockout_qty_by_line(parent_params, placeholders)
+        elif want_in and tn == "purchasesorders":
+            line_map = self._fetch_stockin_qty_by_line(parent_params, placeholders)
+        if not line_map:
+            return
+        for pr in prod_rows:
+            p = _dict_get_ci(pr, pk)
+            lid = _dict_get_ci(pr, line_pk)
+            if p is None or lid is None:
+                continue
+            try:
+                key = (int(p), int(lid))
+            except (TypeError, ValueError):
+                continue
+            if want_out:
+                pr["stockout_quantity"] = line_map.get(key, 0.0)
+            if want_in:
+                pr["stockin_quantity"] = line_map.get(key, 0.0)
+
+    def _inject_computed_stock_qty_aggregates(
+        self,
+        by_parent: Dict[int, Dict[str, Any]],
+        alias_meta: List[Tuple[str, str, str]],
+        parent_params: Tuple[int, ...],
+        placeholders: str,
+    ) -> None:
+        tn = self.table_name or ""
+        for fn, alias, _ftype in alias_meta:
+            if not _is_computed_product_stock_qty_field(tn, fn):
+                continue
+            if fn == "stockout_quantity":
+                col_map = self._fetch_stockout_qty_agg_by_parent(parent_params, placeholders)
+            elif fn == "stockin_quantity":
+                col_map = self._fetch_stockin_qty_agg_by_parent(parent_params, placeholders)
+            else:
+                continue
+            for pid in parent_params:
+                by_parent.setdefault(pid, {})[alias] = float(col_map.get(pid, 0) or 0)
+
+    # ------------------------------------------------------------------
+    # cell formatting
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _format_list_product_integer_qty_cell(raw: Any) -> str:
+        """Integer-only formatting for list-mode stockout/stockin quantities —
+        kacrm never formats these with decimal rules."""
+        if raw is None or raw == "":
+            return ""
+        try:
+            v = float(raw)
+        except (TypeError, ValueError):
+            return str(raw)
+        return str(int(round(v)))
+
+    def _format_product_agg_cell(self, raw: Any, ftype: str, symbol: str) -> str:
+        if raw is None:
+            return ""
+        ft = (ftype or "text").lower()
+        if ft == "number":
+            try:
+                v = float(raw)
+            except (TypeError, ValueError):
+                return str(raw)
+            if abs(v - int(v)) < 1e-9:
+                return str(int(v))
+            return str(ec_number_format(v))
+        if ft in ("currency", "currencyjson"):
+            try:
+                v = float(raw)
+            except (TypeError, ValueError):
+                return str(raw)
+            return f"{symbol} {ec_number_format(v)}".strip()
+        if ft in ("integer", "percent", "float", "double"):
+            try:
+                v = float(raw)
+            except (TypeError, ValueError):
+                return str(raw) if raw is not None else ""
+            if abs(v - int(v)) < 1e-9:
+                return str(int(v))
+            return str(ec_number_format(v))
+        return str(raw) if raw is not None else ""
+
+    def _format_product_line_cell(self, raw: Any, ftype: str, symbol: str) -> str:
+        # currency / currencyjson envelope unwrap was deleted in alembic
+        # 0079 — all amount columns are NUMERIC. Rendering is uniform
+        # with plain numbers; the ``symbol`` argument is kept for back-
+        # compat with callers that thread the default currency symbol.
+        db = self._ensure_db()
+        currency_data = get_currency_data(db)
+        currencies = currency_data.get("currencies") or {}
+        default_currency = str(currency_data.get("default_currency") or "")
+        sym_fallback = symbol or (currencies.get(default_currency) or {}).get("symbol", default_currency)
+        return self._format_product_agg_cell(raw, ftype, sym_fallback)
+
+    def _main_list_field_names_excluding_product_agg(self) -> List[str]:
+        out: List[str] = []
+        for f in self.fields_list or []:
+            fn = str(f.get("field_name") or "").strip()
+            if not fn or fn.startswith("product_agg_"):
+                continue
+            out.append(fn)
+        return out
+
+    def _fill_product_agg_cells_from_line(
+        self, row: Dict[str, Any], line: Optional[Dict[str, Any]], sym: str
+    ) -> None:
+        for spec in self._list_product_columns_spec:
+            fn = str(spec.get("field_name") or "").strip()
+            if not fn or not _is_safe_sql_identifier(fn):
+                continue
+            meta = self._product_field_def_by_name.get(fn, {})
+            ftype = str(meta.get("field_type") or "text")
+            raw = (line or {}).get(fn) if line is not None else None
+            if _is_computed_product_stock_qty_field(self.table_name or "", fn):
+                row[f"product_agg_{fn}"] = self._format_list_product_integer_qty_cell(raw)
+            else:
+                row[f"product_agg_{fn}"] = self._format_product_line_cell(raw, ftype, sym)
+
+    def _continuation_row_from_parent(
+        self, template: Dict[str, Any], line_idx: int, pk_field: str, name_col: str
+    ) -> Dict[str, Any]:
+        new_row = copy.deepcopy(template)
+        new_row["list_product_line"] = line_idx
+        for fn in self._main_list_field_names_excluding_product_agg():
+            new_row[fn] = ""
+            for suf in ("_display", "_original_amount"):
+                k = fn + suf
+                if k in new_row:
+                    new_row[k] = ""
+        if name_col and name_col in new_row:
+            new_row[name_col] = ""
+        if "name" in new_row:
+            new_row["name"] = ""
+        if pk_field and pk_field in template:
+            new_row[pk_field] = template[pk_field]
+        if "id" in template:
+            new_row["id"] = template["id"]
+        if "is_top" in new_row:
+            new_row["is_top"] = 0
+        return new_row
+
+    def _expand_rows_with_product_lines(
+        self, items: List[Dict[str, Any]]
+    ) -> List[Dict[str, Any]]:
+        """One parent row → one row per product line; first line keeps the main
+        fields, the rest carry only the product column values."""
+        if not items or not self._list_product_columns_spec:
+            return items
+        tn = self.table_name or ""
+        if not tn or not _is_safe_sql_identifier(tn):
+            return items
+        pt = f"{tn}_products"
+        pk = f"{tn}_id"
+        line_pk = f"{tn}_products_id"
+        if not all(_is_safe_sql_identifier(x) for x in (pt, pk, line_pk)):
+            return items
+
+        parent_ids: List[int] = []
+        for row in items:
+            rid = _dict_get_ci(row, pk) or _dict_get_ci(row, "id")
+            if rid is None:
+                continue
+            try:
+                parent_ids.append(int(rid))
+            except (TypeError, ValueError):
+                continue
+        if not parent_ids:
+            return items
+
+        parent_params = tuple(dict.fromkeys(parent_ids))
+        placeholders = ",".join(["%s"] * len(parent_params))
+        prod_sql = (
+            f"SELECT * FROM {pt} WHERE {pk} IN ({placeholders}) "
+            f"ORDER BY {pk} ASC, {line_pk} ASC"
+        )
+        db = self._ensure_db()
+        try:
+            prod_rows = db.fetchall(prod_sql, parent_params) or []
+        except Exception as e:
+            logger.warning("product list lines fetch failed table=%s err=%s", pt, e)
+            self._merge_product_list_aggregates(items)
+            for row in items:
+                row["list_product_line"] = 0
+            return items
+
+        try:
+            self._inject_computed_stock_qty_into_product_lines(
+                prod_rows, pk, line_pk, parent_params, placeholders
+            )
+        except Exception as e:
+            logger.warning("product list computed stock qty failed table=%s err=%s", pt, e)
+
+        by_parent: Dict[int, List[Dict[str, Any]]] = defaultdict(list)
+        for pr in prod_rows:
+            pid = _dict_get_ci(pr, pk)
+            if pid is None:
+                continue
+            try:
+                by_parent[int(pid)].append(pr)
+            except (TypeError, ValueError):
+                continue
+
+        currency_data = get_currency_data(db)
+        default_currency = str(currency_data.get("default_currency") or "")
+        sym = (currency_data.get("currencies") or {}).get(default_currency, {}).get("symbol", default_currency)
+
+        name_col = f"{tn}_name"
+        out: List[Dict[str, Any]] = []
+        for row in items:
+            rid = _dict_get_ci(row, pk) or _dict_get_ci(row, "id")
+            if rid is None:
+                out.append(row)
+                continue
+            try:
+                pid = int(rid)
+            except (TypeError, ValueError):
+                out.append(row)
+                continue
+            lines = by_parent.get(pid, [])
+            if not lines:
+                row["list_product_line"] = 0
+                self._fill_product_agg_cells_from_line(row, None, sym)
+                out.append(row)
+                continue
+            row["list_product_line"] = 0
+            self._fill_product_agg_cells_from_line(row, lines[0], sym)
+            out.append(row)
+            for idx, pline in enumerate(lines[1:], start=1):
+                cont = self._continuation_row_from_parent(row, idx, pk, name_col)
+                self._fill_product_agg_cells_from_line(cont, pline, sym)
+                out.append(cont)
+        return out
+
+    def _merge_computed_stock_qty_agg_one_column(
+        self,
+        *,
+        fn: str,
+        parent_params: Tuple[int, ...],
+        placeholders: str,
+    ) -> Dict[int, Any]:
+        if fn == "stockout_quantity":
+            m = self._fetch_stockout_qty_agg_by_parent(parent_params, placeholders)
+        elif fn == "stockin_quantity":
+            m = self._fetch_stockin_qty_agg_by_parent(parent_params, placeholders)
+        else:
+            return {}
+        return {int(pid): float(m.get(int(pid), 0) or 0) for pid in parent_params}
+
+    def _merge_product_list_aggregates_one_column(
+        self,
+        *,
+        pt: str,
+        pk: str,
+        parent_params: Tuple[Any, ...],
+        placeholders: str,
+        fn: str,
+        alias: str,
+        ftype: str,
+    ) -> Dict[int, Any]:
+        if _is_computed_product_stock_qty_field(self.table_name or "", fn):
+            return self._merge_computed_stock_qty_agg_one_column(
+                fn=fn,
+                parent_params=tuple(int(p) for p in parent_params),
+                placeholders=placeholders,
+            )
+        expr = self._product_field_agg_sql_expr(fn, ftype, alias)
+        sql = (
+            f"SELECT {pk} AS _parent_id, {expr} "
+            f"FROM {pt} WHERE {pk} IN ({placeholders}) GROUP BY {pk}"
+        )
+        out: Dict[int, Any] = {}
+        db = self._ensure_db()
+        rows = db.fetchall(sql, parent_params) or []
+        for ar in rows:
+            pid = _dict_get_ci(ar, "_parent_id")
+            if pid is None:
+                continue
+            try:
+                pid_i = int(pid)
+            except (TypeError, ValueError):
+                continue
+            out[pid_i] = _dict_get_ci(ar, alias)
+        return out
+
+    def _merge_product_list_aggregates(self, items: List[Dict[str, Any]]) -> None:
+        if not items or not self._list_product_columns_spec:
+            return
+        tn = self.table_name or ""
+        if not tn or not _is_safe_sql_identifier(tn):
+            return
+        pt = f"{tn}_products"
+        if not _is_safe_sql_identifier(pt):
+            return
+        pk = f"{tn}_id"
+        if not _is_safe_sql_identifier(pk):
+            return
+        parent_ids: List[int] = []
+        for row in items:
+            pid = _dict_get_ci(row, pk)
+            if pid is None:
+                pid = _dict_get_ci(row, "id")
+            if pid is None:
+                continue
+            try:
+                parent_ids.append(int(pid))
+            except (TypeError, ValueError):
+                continue
+        if not parent_ids:
+            return
+        parent_params = tuple(dict.fromkeys(parent_ids))
+        placeholders = ",".join(["%s"] * len(parent_params))
+
+        exprs: List[str] = []
+        alias_meta: List[Tuple[str, str, str]] = []
+        for spec in self._list_product_columns_spec:
+            fn = spec["field_name"]
+            if not _is_safe_sql_identifier(fn):
+                continue
+            meta = self._product_field_def_by_name.get(fn, {})
+            ftype = str(meta.get("field_type") or "text")
+            alias = f"pa_{fn}"
+            if _is_computed_product_stock_qty_field(tn, fn):
+                alias_meta.append((fn, alias, ftype))
+                continue
+            exprs.append(self._product_field_agg_sql_expr(fn, ftype, alias))
+            alias_meta.append((fn, alias, ftype))
+        has_computed_qty = any(
+            _is_computed_product_stock_qty_field(tn, fn) for fn, _a, _t in alias_meta
+        )
+        if not exprs and not has_computed_qty:
+            return
+
+        by_parent: Dict[int, Dict[str, Any]] = {}
+        agg_rows: List[Dict[str, Any]] = []
+        db = self._ensure_db()
+        if exprs:
+            sql_batch = (
+                f"SELECT {pk} AS _parent_id, {', '.join(exprs)} "
+                f"FROM {pt} WHERE {pk} IN ({placeholders}) GROUP BY {pk}"
+            )
+            try:
+                agg_rows = db.fetchall(sql_batch, parent_params) or []
+            except Exception as e:
+                logger.warning(
+                    "product list aggregate batch failed, fallback per column table=%s err=%s",
+                    pt, e,
+                )
+                for fn, alias, ftype in alias_meta:
+                    try:
+                        col_map = self._merge_product_list_aggregates_one_column(
+                            pt=pt, pk=pk,
+                            parent_params=parent_params,
+                            placeholders=placeholders,
+                            fn=fn, alias=alias, ftype=ftype,
+                        )
+                    except Exception as err2:
+                        logger.warning("product aggregate skip field=%s err=%s", fn, err2)
+                        continue
+                    for pid_i, val in col_map.items():
+                        by_parent.setdefault(pid_i, {})[alias] = val
+            else:
+                for ar in agg_rows:
+                    pid = _dict_get_ci(ar, "_parent_id")
+                    if pid is None:
+                        continue
+                    try:
+                        by_parent[int(pid)] = dict(ar)
+                    except (TypeError, ValueError):
+                        continue
+
+        try:
+            self._inject_computed_stock_qty_aggregates(
+                by_parent, alias_meta, parent_params, placeholders
+            )
+        except Exception as e:
+            logger.warning("product list aggregate computed stock qty failed table=%s err=%s", tn, e)
+
+        currency_data = get_currency_data(db)
+        currencies = currency_data.get("currencies") or {}
+        default_currency = str(currency_data.get("default_currency") or "")
+        sym = (currencies.get(default_currency) or {}).get("symbol", default_currency)
+        for row in items:
+            rid = _dict_get_ci(row, pk)
+            if rid is None:
+                rid = _dict_get_ci(row, "id")
+            if rid is None:
+                continue
+            try:
+                pid = int(rid)
+            except (TypeError, ValueError):
+                continue
+            bucket = by_parent.get(pid) or {}
+            for fn, alias, ftype in alias_meta:
+                raw = _dict_get_ci(bucket, alias)
+                if _is_computed_product_stock_qty_field(tn, fn):
+                    row[f"product_agg_{fn}"] = self._format_list_product_integer_qty_cell(raw)
+                else:
+                    row[f"product_agg_{fn}"] = self._format_product_agg_cell(raw, ftype, sym)
+
+    # ------------------------------------------------------------------
+    # localization / currency normalization / display name resolution
+    # ------------------------------------------------------------------
+
+    def _localize_field_options(self, fields: List[Dict[str, Any]]) -> None:
+        locale = get_current_locale()
+        for field in fields or []:
+            if not is_select_like(field.get("field_type")):
+                continue
+            raw = field.get("options")
+            opts = parse_picklist_options(raw)
+            if not opts:
+                continue
+            localized = localize_picklist_options(
+                opts,
+                locale=locale,
+                table_name=str(self.table_name or ""),
+                field_name=str(field.get("field_name") or ""),
+                field_id=int(field.get("id") or 0),
+                field_config=field.get("field_config"),
+            )
+            if isinstance(raw, str):
+                field["options"] = json.dumps(localized, ensure_ascii=False)
+            else:
+                field["options"] = localized
+
+    def _localize_field_labels(self, fields: List[Dict[str, Any]]) -> None:
+        table_name = str(self.table_name or "")
+        for field in fields or []:
+            field_name = str(field.get("field_name") or "").strip()
+            if not field_name:
+                continue
+            field["field_label"] = localize_field_label(
+                table_name=table_name,
+                field_name=field_name,
+                field_label=str(field.get("field_label") or field_name),
+                field_id=int(field.get("id") or 0),
+                field_config=field.get("field_config"),
+            )
+
+    def _normalize_currency_fields(
+        self, row: Dict[str, Any], currencies: Dict[str, Dict[str, Any]]
+    ) -> None:
+        """Emit ``<field>_display`` / ``<field>_original_amount`` for
+        currency-typed fields. Storage is plain NUMERIC since alembic
+        0079 (kacrm's ``{currency, amount, original_amount}`` envelope
+        and the ``product_currency`` row marker are both gone). Display
+        is the formatted number; ``_original_amount`` is the numeric
+        value itself, kept for SPA back-compat with old readers."""
+        if not row:
+            return
+        for field in self.fields_list or []:
+            field_name = (field.get("field_name") or "").strip()
+            field_type = (field.get("field_type") or "").strip()
+            if not field_name or field_name not in row:
+                continue
+            if field_type not in ("currency", "currencyJson"):
+                continue
+            raw = row.get(field_name)
+            if raw is None or raw == "":
+                continue
+            try:
+                amount = float(raw)
+            except (TypeError, ValueError):
+                continue
+            row[field_name + "_original_amount"] = amount
+            row[field_name + "_display"] = ec_number_format(amount)
+        _ = currencies  # unused after envelope removal; signature kept for callers
+
+    @staticmethod
+    def _is_empty_relation_value(v: Any) -> bool:
+        """Treat 0 / "0" / "" / None as "no selection" — don't display 0."""
+        if v is None or v == "":
+            return True
+        if v == 0 or v == "0":
+            return True
+        return False
+
+    def _apply_display_values(self, items: List[Dict[str, Any]]) -> None:
+        """For relation / user / department fields, batch-resolve display
+        names into ``row[fn + '_display']``."""
+        if not items:
+            return
+        db = self._ensure_db()
+        modules_db = ModulesDb(db)
+        for field in self.fields_list or []:
+            fn = (field.get("field_name") or "").strip()
+            if not fn:
+                continue
+            ft = (field.get("field_type") or "").strip()
+            if ft in ("user", "ownerBy", "createdBy", "updatedBy"):
+                ids: set[int] = set()
+                for row in items:
+                    v = row.get(fn)
+                    if not self._is_empty_relation_value(v):
+                        try:
+                            ids.add(int(v))
+                        except (TypeError, ValueError):
+                            pass
+                if not ids:
+                    continue
+                placeholders = ",".join(["%s"] * len(ids))
+                rows = db.fetchall(
+                    f"SELECT id, COALESCE(realname, username) AS display FROM users WHERE id IN ({placeholders})",
+                    tuple(ids),
+                )
+                id_to_name = {int(r["id"]): (r.get("display") or "").strip() for r in (rows or [])}
+                for row in items:
+                    v = row.get(fn)
+                    if self._is_empty_relation_value(v):
+                        row[fn + "_display"] = ""
+                    else:
+                        try:
+                            row[fn + "_display"] = id_to_name.get(int(v), "")
+                        except (TypeError, ValueError):
+                            row[fn + "_display"] = ""
+            elif ft == "department":
+                ids = set()
+                for row in items:
+                    v = row.get(fn)
+                    if not self._is_empty_relation_value(v):
+                        try:
+                            ids.add(int(v))
+                        except (TypeError, ValueError):
+                            pass
+                if not ids:
+                    continue
+                placeholders = ",".join(["%s"] * len(ids))
+                rows = db.fetchall(
+                    f"SELECT id, name FROM departments WHERE id IN ({placeholders})",
+                    tuple(ids),
+                )
+                id_to_name = {int(r["id"]): (r.get("name") or "").strip() for r in (rows or [])}
+                for row in items:
+                    v = row.get(fn)
+                    if self._is_empty_relation_value(v):
+                        row[fn + "_display"] = ""
+                    else:
+                        try:
+                            row[fn + "_display"] = id_to_name.get(int(v), "")
+                        except (TypeError, ValueError):
+                            row[fn + "_display"] = ""
+            elif ft == "relation" and field.get("datainfo"):
+                parts = str(field["datainfo"]).strip().split("#")
+                if not parts or not parts[0].strip().isdigit():
+                    continue
+                rel_module_id = int(parts[0].strip())
+                mod = modules_db.get_module_info(rel_module_id)
+                if not mod or not mod.get("table_name"):
+                    continue
+                tbl = mod["table_name"]
+                if not _is_safe_sql_identifier(tbl):
+                    continue
+                name_col = f"{tbl}_name"
+                pk_col = f"{tbl}_id"
+                ids = set()
+                for row in items:
+                    v = row.get(fn)
+                    if not self._is_empty_relation_value(v):
+                        try:
+                            ids.add(int(v))
+                        except (TypeError, ValueError):
+                            pass
+                if not ids:
+                    continue
+                placeholders = ",".join(["%s"] * len(ids))
+                try:
+                    rows = db.fetchall(
+                        f"SELECT {pk_col} AS id, {name_col} AS display FROM {tbl} "
+                        f"WHERE deleted = FALSE AND {pk_col} IN ({placeholders})",
+                        tuple(ids),
+                    )
+                except Exception:
+                    continue
+                id_to_name: Dict[int, str] = {}
+                for r in rows or []:
+                    vid = r.get("id")
+                    if vid is not None:
+                        id_to_name[int(vid)] = (r.get("display") or "").strip()
+                for row in items:
+                    v = row.get(fn)
+                    if self._is_empty_relation_value(v):
+                        row[fn + "_display"] = ""
+                    else:
+                        try:
+                            row[fn + "_display"] = id_to_name.get(int(v), "")
+                        except (TypeError, ValueError):
+                            row[fn + "_display"] = ""
+
+    # ------------------------------------------------------------------
+    # filter / relation-filter SQL building
+    # ------------------------------------------------------------------
+
+    def _build_filters(self) -> Tuple[str, List[Any]]:
+        if not self.filters:
+            return "", []
+        normalized_filters = normalize_filter_list(self.filters, self.field_map)
+        parts: List[str] = []
+        args: List[Any] = []
+        for f in normalized_filters:
+            field = (f.get("field") or "").strip()
+            if not field:
+                continue
+            op = normalize_filter_operator(f.get("operator"))
+            val = f.get("value")
+            # Legacy-UI shortcut: relation filters arrive as ``field#moduleId``.
+            if "#" in field:
+                relation_sql, relation_args = self._build_relation_filter(field, op, val)
+                if relation_sql:
+                    parts.append(relation_sql)
+                    args.extend(relation_args)
+                continue
+            if not _is_safe_sql_identifier(field):
+                continue
+            # owner_by eq sometimes arrives wrapped in ``{"id": N}`` — unwrap.
+            if op == "eq" and field == "owner_by" and isinstance(val, str) and val.strip().startswith("{"):
+                try:
+                    obj = json.loads(val)
+                    if isinstance(obj, dict) and "id" in obj:
+                        val = obj.get("id")
+                except (TypeError, ValueError):
+                    pass
+            if op == "eq":
+                parts.append(f"{field} = %s")
+                args.append(val)
+            elif op == "in" and val not in (None, ""):
+                ids = _parse_filter_in_value(val)
+                if ids:
+                    placeholders = ",".join(["%s"] * len(ids))
+                    parts.append(f"{field} IN ({placeholders})")
+                    args.extend(ids)
+            elif op == "neq":
+                parts.append(f"{field} != %s")
+                args.append(val)
+            elif op in ("like", "contains"):
+                parts.append(f"{field} ILIKE %s")
+                args.append(f"%{val}%" if val is not None else "%%")
+            elif op == "not_contains":
+                parts.append(f"{field} NOT ILIKE %s")
+                args.append(f"%{val}%" if val is not None else "%%")
+            elif op == "starts_with":
+                parts.append(f"{field} ILIKE %s")
+                args.append(f"{val}%" if val is not None else "%")
+            elif op == "ends_with":
+                parts.append(f"{field} ILIKE %s")
+                args.append(f"%{val}" if val is not None else "%")
+            elif op == "is_empty":
+                parts.append(f"({field} = '' OR {field} IS NULL)")
+            elif op == "is_not_empty":
+                parts.append(f"({field} != '' AND {field} IS NOT NULL)")
+            elif op == "gt" and val is not None:
+                parts.append(f"{field} > %s")
+                args.append(val)
+            elif op == "gte" and val is not None:
+                parts.append(f"{field} >= %s")
+                args.append(val)
+            elif op == "lt" and val is not None:
+                parts.append(f"{field} < %s")
+                args.append(val)
+            elif op == "lte" and val is not None:
+                parts.append(f"{field} <= %s")
+                args.append(val)
+        if not parts:
+            return "", []
+        join_op = " OR " if self.filter_logic == "any" else " AND "
+        return "(" + join_op.join(parts) + ")", args
+
+    def _build_relation_filter(
+        self, relation_field: str, operator: str, value: Any
+    ) -> Tuple[str, List[Any]]:
+        parts = relation_field.split("#", 1)
+        if len(parts) != 2:
+            return "", []
+        field_name = parts[0].strip()
+        relation_module_id = (parts[1] or "").strip()
+        if not field_name or not _is_safe_sql_identifier(field_name) or not relation_module_id.isdigit():
+            return "", []
+
+        db = self._ensure_db()
+        rel_module = ModulesDb(db).get_module_info(int(relation_module_id))
+        if not rel_module or not rel_module.get("table_name"):
+            return "", []
+        rel_table = rel_module["table_name"]
+        if not _is_safe_sql_identifier(rel_table):
+            return "", []
+        rel_pk = f"{rel_table}_id"
+        rel_name = f"{rel_table}_name"
+
+        op = operator or "eq"
+        if op in ("eq", "neq") and value not in (None, "") and str(value).isdigit():
+            cmp = "=" if op == "eq" else "!="
+            return f"{field_name} {cmp} %s", [int(value)]
+
+        if value in (None, ""):
+            return "", []
+
+        if op in ("contains", "like", "not_contains", "starts_with", "ends_with", "eq", "neq"):
+            if op in ("contains", "like", "not_contains", "starts_with", "ends_with"):
+                if op in ("contains", "like", "not_contains"):
+                    pattern = f"%{value}%"
+                elif op == "starts_with":
+                    pattern = f"{value}%"
+                else:
+                    pattern = f"%{value}"
+                sql = (
+                    f"SELECT {rel_pk} AS id FROM {rel_table} "
+                    f"WHERE deleted = FALSE AND {rel_name} ILIKE %s"
+                )
+                bind: Tuple[Any, ...] = (pattern,)
+            else:
+                sql = (
+                    f"SELECT {rel_pk} AS id FROM {rel_table} "
+                    f"WHERE deleted = FALSE AND {rel_name} = %s"
+                )
+                bind = (value,)
+            rows = db.fetchall(sql, bind) or []
+            ids = [int(r["id"]) for r in rows if r.get("id") is not None]
+            if not ids:
+                return ("", []) if op in ("not_contains", "neq") else ("1 = 0", [])
+            placeholders = ",".join(["%s"] * len(ids))
+            cmp = "IN" if op in ("contains", "like", "starts_with", "ends_with", "eq") else "NOT IN"
+            return f"{field_name} {cmp} ({placeholders})", ids
+
+        return "", []
