index 0000000000..85e1a7ee82
--- /dev/null
+++ b/crm/insights/decision_indicators.py
@@ -0,0 +1,385 @@
+"""Decision-grade indicators (record-level detail).
+
+Purpose: feed the ``analyze_team`` mini-agent with enough specificity
+that the LLM can propose **named** actions (e.g. "潜客#47 转给张三")
+rather than aggregate observations ("9 个 deal 休眠").
+
+Why a separate module from ``team_audit.py``:
+the dashboard helpers there return pure aggregates (counts, rates) for
+the analytics surface — that's their contract; many tests assert on
+their exact shape. Decision indicators need IDs / names / sample text
+that the dashboard doesn't carry. We compose dashboard helpers where
+useful but always RETURN a richer payload.
+
+Each helper returns JSON-serializable plain dicts so ``json.dumps`` in
+the prompt builder works without a custom encoder.
+
+Scope inversion (final migration phase): these helpers NO LONGER
+resolve RBAC scope. Each takes an already-resolved ``uids: List[int]``
+and does its SQL filtering on that. The caller resolves + audits scope.
+"""
+from __future__ import annotations
+import logging
+from typing import Any, Dict, List
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.insights.team_audit import _week_window
+
+logger = logging.getLogger(__name__)
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Sleeping deals — aggregate trend + per-deal current-state list
+# ──────────────────────────────────────────────────────────────────────
+
+
+def sleeping_deals_detail(
+    db: DbWrapper, *, uids: List[int], limit: int = 20,
+) -> Dict[str, Any]:
+    """Return BOTH the 4-week count trend (legacy shape) AND a per-deal
+    list of currently-sleeping potentials with owner names.
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Output:
+      {
+        "weeks": [{"week_start": "...", "n": int}, ...],   # for sparkline
+        "current": [
+          {"potentials_id": int, "name": str,
+           "owner_user_id": int, "owner_name": str,
+           "amount": float | None, "milestone": str,
+           "last_touch_at": str | None, "days_sleeping": int},
+          ...
+        ]
+      }
+    """
+    if not uids:
+        return {"weeks": [], "current": []}
+
+    weeks: List[Dict[str, Any]] = []
+    for w in range(3, -1, -1):
+        start, _end = _week_window(week_offset=-w)
+        try:
+            r = db.fetchone(
+                """SELECT COUNT(*) AS n
+                     FROM potentials p
+                    WHERE p.deleted = FALSE
+                      AND p.owner_by = ANY(%s::bigint[])
+                      AND p.milestone IN
+                          ('qualified', 'proposal', 'proposal_sent',
+                           'negotiation', 'verbal',
+                           '意向', '方案', '谈判', '口头确认', '商务')
+                      AND NOT EXISTS (
+                          SELECT 1 FROM interactions i
+                           WHERE (i.subjects->0->>'id')::bigint = p.potentials_id
+                             AND (i.subjects->0->>'module') = 'potentials'
+                             AND i.kind IN ('note','email','call','meeting')
+                             AND i.occurred_at > %s - interval '7 days'
+                             AND i.occurred_at <= %s
+                      )""",
+                (uids, start, start),
+            )
+            weeks.append({
+                "week_start": start.date().isoformat(),
+                "n": int(r["n"]) if r else 0,
+            })
+        except Exception:
+            logger.exception("sleeping_deals_detail weeks=%s failed", w)
+            try: db.rollback()
+            except Exception: pass
+
+    # Current-state list with owner names + days_sleeping. Limit to the
+    # N oldest-touch ones — those are the highest-priority for the LLM
+    # to consider reassigning.
+    current: List[Dict[str, Any]] = []
+    try:
+        rows = db.fetchall(
+            """SELECT p.potentials_id, p.potentials_name AS name,
+                      p.owner_by AS owner_user_id,
+                      COALESCE(NULLIF(u.realname, ''), u.username, '?')
+                        AS owner_name,
+                      p.amount, p.milestone,
+                      (SELECT MAX(i.occurred_at)
+                         FROM interactions i
+                        WHERE (i.subjects->0->>'id')::bigint = p.potentials_id
+                          AND (i.subjects->0->>'module') = 'potentials'
+                          AND i.kind IN ('note','email','call','meeting')
+                      ) AS last_touch_at
+                 FROM potentials p
+                 LEFT JOIN users u ON u.id = p.owner_by
+                WHERE p.deleted = FALSE
+                  AND p.owner_by = ANY(%s::bigint[])
+                  AND p.milestone IN
+                      ('qualified', 'proposal', 'proposal_sent',
+                       'negotiation', 'verbal',
+                       '意向', '方案', '谈判', '口头确认', '商务')
+                ORDER BY last_touch_at NULLS FIRST
+                LIMIT %s""",
+            (uids, int(limit)),
+        ) or []
+    except Exception:
+        logger.exception("sleeping_deals_detail current failed")
+        try: db.rollback()
+        except Exception: pass
+        rows = []
+
+    from datetime import datetime, timezone
+    now = datetime.now(tz=timezone.utc)
+    for r in rows:
+        last = r.get("last_touch_at")
+        days = None
+        if last is not None:
+            try:
+                days = max(0, (now - last).days)
+            except Exception:
+                days = None
+        # Only include rows that are ACTUALLY sleeping (>7 days no touch
+        # or never touched). The SQL doesn't filter — we filter here so
+        # the count matches sleeping_deals_trend semantics.
+        if days is not None and days < 7:
+            continue
+        current.append({
+            "potentials_id": int(r["potentials_id"]),
+            "name": str(r.get("name") or ""),
+            "owner_user_id": int(r["owner_user_id"]) if r.get("owner_user_id") else None,
+            "owner_name": str(r.get("owner_name") or "?"),
+            "amount": float(r["amount"]) if r.get("amount") is not None else None,
+            "milestone": str(r.get("milestone") or ""),
+            "last_touch_at": last.isoformat() if last else None,
+            "days_sleeping": days,
+        })
+
+    return {"weeks": weeks, "current": current}
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Pipeline funnel with stuck-deal drill-down
+# ──────────────────────────────────────────────────────────────────────
+
+
+def pipeline_funnel_detail(
+    db: DbWrapper, *, uids: List[int], per_stage_limit: int = 5,
+) -> Dict[str, Any]:
+    """Per-stage count + a list of the longest-stuck deals per stage.
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Output:
+      {
+        "stages": [{"stage": str, "n": int}, ...],
+        "stuck": [
+          {"stage": str, "potentials_id": int, "name": str,
+           "owner_name": str, "days_in_stage": int, "amount": float},
+          ...
+        ]
+      }
+    """
+    if not uids:
+        return {"stages": [], "stuck": []}
+
+    try:
+        stages = db.fetchall(
+            """SELECT COALESCE(NULLIF(milestone, ''), '(unknown)') AS stage,
+                      COUNT(*) AS n
+                 FROM potentials
+                WHERE deleted = FALSE
+                  AND owner_by = ANY(%s::bigint[])
+                GROUP BY stage
+                ORDER BY n DESC""",
+            (uids,),
+        ) or []
+    except Exception:
+        logger.exception("pipeline_funnel_detail stages failed")
+        try: db.rollback()
+        except Exception: pass
+        stages = []
+
+    # For each non-trivial stage (n >= 2), surface the N oldest-touched
+    # deals so the LLM can pick a specific one to recommend acting on.
+    # ``updated_at`` is a reasonable proxy for "stuck duration" — the
+    # potentials table doesn't carry a per-stage entry timestamp.
+    stuck: List[Dict[str, Any]] = []
+    target_stages = [s["stage"] for s in stages if int(s["n"]) >= 2]
+    if target_stages:
+        try:
+            rows = db.fetchall(
+                """SELECT COALESCE(NULLIF(p.milestone, ''), '(unknown)')
+                              AS stage,
+                          p.potentials_id, p.potentials_name AS name,
+                          p.owner_by AS owner_user_id,
+                          COALESCE(NULLIF(u.realname, ''), u.username, '?')
+                              AS owner_name,
+                          p.amount,
+                          GREATEST(0, EXTRACT(DAY FROM
+                              NOW() - p.updated_at))::int
+                              AS days_since_update
+                     FROM potentials p
+                     LEFT JOIN users u ON u.id = p.owner_by
+                    WHERE p.deleted = FALSE
+                      AND p.owner_by = ANY(%s::bigint[])
+                      AND COALESCE(NULLIF(p.milestone, ''), '(unknown)')
+                              = ANY(%s::text[])
+                    ORDER BY p.updated_at ASC""",
+                (uids, target_stages),
+            ) or []
+        except Exception:
+            logger.exception("pipeline_funnel_detail stuck failed")
+            try: db.rollback()
+            except Exception: pass
+            rows = []
+        # Top-N per stage in Python.
+        from collections import defaultdict
+        by_stage = defaultdict(list)
+        for r in rows:
+            by_stage[r["stage"]].append(r)
+        for st, lst in by_stage.items():
+            for r in lst[:per_stage_limit]:
+                stuck.append({
+                    "stage": st,
+                    "potentials_id": int(r["potentials_id"]),
+                    "name": str(r.get("name") or ""),
+                    "owner_user_id": (
+                        int(r["owner_user_id"])
+                        if r.get("owner_user_id") is not None else None
+                    ),
+                    "owner_name": str(r.get("owner_name") or "?"),
+                    "amount": (
+                        float(r["amount"])
+                        if r.get("amount") is not None else None
+                    ),
+                    "days_in_stage": int(r["days_since_update"]),
+                })
+
+    return {
+        "stages": [
+            {"stage": str(s["stage"]), "n": int(s["n"])} for s in stages
+        ],
+        "stuck": stuck,
+    }
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Member load + acceptance — for "transfer load" / "1:1" recommendations
+# ──────────────────────────────────────────────────────────────────────
+
+
+def member_load_and_acceptance(
+    db: DbWrapper, *, uids: List[int], window_days: int = 30,
+) -> List[Dict[str, Any]]:
+    """Per visible-team-member: open deal count, sleeping deal count,
+    AI acceptance rate, sample rejected-comment text.
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Output (one row per member):
+      {
+        "user_id": int, "name": str,
+        "open_deals": int, "sleeping_deals": int,
+        "ai_recommended": int, "ai_accepted": int, "accept_rate": float,
+        "sample_rejected_comments": [str, ...]   # ≤3 short excerpts
+      }
+
+    Empty list if ``uids`` is empty.
+    """
+    if not uids:
+        return []
+
+    out: List[Dict[str, Any]] = []
+    try:
+        rows = db.fetchall(
+            """SELECT u.id AS user_id,
+                      COALESCE(NULLIF(u.realname, ''), u.username, '?') AS name,
+                      COUNT(p.potentials_id) FILTER (
+                          WHERE p.milestone NOT IN ('won','lost','成交')
+                            AND p.milestone IS NOT NULL
+                            AND p.deleted = FALSE
+                      ) AS open_deals,
+                      COUNT(p.potentials_id) FILTER (
+                          WHERE p.milestone IN
+                                ('qualified','proposal','proposal_sent',
+                                 'negotiation','verbal',
+                                 '意向','方案','谈判','口头确认','商务')
+                            AND p.deleted = FALSE
+                            AND NOT EXISTS (
+                                SELECT 1 FROM interactions i
+                                 WHERE (i.subjects->0->>'id')::bigint
+                                       = p.potentials_id
+                                   AND (i.subjects->0->>'module') = 'potentials'
+                                   AND i.kind IN ('note','email','call','meeting')
+                                   AND i.occurred_at > NOW() - interval '7 days'
+                            )
+                      ) AS sleeping_deals
+                 FROM users u
+                 LEFT JOIN potentials p ON p.owner_by = u.id
+                WHERE u.id = ANY(%s::bigint[])
+                GROUP BY u.id, name
+                ORDER BY sleeping_deals DESC, open_deals DESC""",
+            (uids,),
+        ) or []
+    except Exception:
+        logger.exception("member_load_and_acceptance load failed")
+        try: db.rollback()
+        except Exception: pass
+        return []
+
+    # AI acceptance counts + sample rejected comments per member.
+    # Best-effort — the schema may have zero rows in dev DB, that's OK.
+    for r in rows:
+        uid = int(r["user_id"])
+        rec = acc = 0
+        comments: List[str] = []
+        try:
+            ar = db.fetchone(
+                """SELECT COUNT(*) AS recommended,
+                          COUNT(*) FILTER (
+                              WHERE NOT EXISTS (
+                                  SELECT 1 FROM interactions c
+                                   WHERE c.kind = 'auto_drive.cancelled'
+                                     AND (c.subjects->0->>'id')::bigint
+                                         = (d.subjects->0->>'id')::bigint
+                                     AND c.occurred_at >= d.occurred_at
+                                     AND c.occurred_at <= d.occurred_at + interval '6 hours'
+                              )
+                          ) AS accepted
+                     FROM interactions d
+                    WHERE d.kind = 'auto_drive.draft'
+                      AND (d.actors->0->>'id')::bigint = %s
+                      AND d.occurred_at > NOW() - (%s * interval '1 day')""",
+                (uid, window_days),
+            )
+            rec = int(ar["recommended"]) if ar and ar.get("recommended") else 0
+            acc = int(ar["accepted"]) if ar and ar.get("accepted") else 0
+        except Exception:
+            try: db.rollback()
+            except Exception: pass
+        try:
+            comment_rows = db.fetchall(
+                """SELECT content->>'reason' AS reason,
+                          content->>'comment' AS comment
+                     FROM interactions
+                    WHERE kind = 'auto_drive.cancelled'
+                      AND (actors->0->>'id')::bigint = %s
+                      AND occurred_at > NOW() - (%s * interval '1 day')
+                    ORDER BY occurred_at DESC LIMIT 3""",
+                (uid, window_days),
+            ) or []
+            for cr in comment_rows:
+                txt = cr.get("comment") or cr.get("reason")
+                if txt:
+                    comments.append(str(txt)[:120])
+        except Exception:
+            try: db.rollback()
+            except Exception: pass
+
+        rate = round(acc / rec, 4) if rec > 0 else None
+        out.append({
+            "user_id": uid,
+            "name": str(r.get("name") or "?"),
+            "open_deals": int(r.get("open_deals") or 0),
+            "sleeping_deals": int(r.get("sleeping_deals") or 0),
+            "ai_recommended": rec,
+            "ai_accepted": acc,
+            "accept_rate": rate,
+            "sample_rejected_comments": comments,
+        })
+    return out
diff --git a/crm/insights/feed.py b/crm/insights/feed.py
new file mode 100644
index 0000000000..23d7ea0b6f
--- /dev/null
+++ b/crm/insights/feed.py
@@ -0,0 +1,510 @@
+"""CRM judgement helpers for the insights daily-feed surface.
+
+Pure, deterministic helpers extracted from ``hermes_cloud.app.insights.api``:
+outcome aggregation, hint reads, record-name resolution, JSONB
+normalisation, and the mixed daily-feed builder. The FastAPI routers and
+async orchestrators stay in the cloud package; this module holds only
+the judgement logic so it lives with the rest of ``hermes.crm.insights``.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from datetime import datetime, timedelta, timezone
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# Daily-feed kind allow-list
+# ---------------------------------------------------------------------------
+# The daily feed ("今日动态" / "🤖 AI 刚替你处理") shows *business events* —
+# CRM writes and communications a human or an agent performed. It must NOT
+# show the agent's internal conversation transcript: ``kind='agent.message'``
+# is a training-corpus event (one row per LLM turn / tool call / prompt),
+# and ``copilot_*`` / ``*_message`` / ``*.tick`` / ``*_cache`` rows are
+# conversational or telemetry noise. Left unfiltered they flooded the feed
+# with raw JSON and ``[no text]`` placeholders and inflated the "AI handled"
+# count with meaningless turns. The interactions query filters on this set
+# so ``LIMIT`` lands on real events rather than transcript rows.
+FEED_BUSINESS_KINDS = (
+    "action", "crm_write",
+    "note", "doc",
+    "email", "call", "call_log", "call_transcript", "voice_memo",
+    "meeting", "chat", "message", "im_message",
+    "channel.push",
+    "auto_drive.draft",
+)
+
+
+# ---------------------------------------------------------------------------
+# Outcome aggregation
+# ---------------------------------------------------------------------------
+def _scan_outcome_events(
+    db: DbWrapper, user_id: int, *, hours: int, limit: int = 200,
+) -> List[Dict[str, Any]]:
+    """Pull outcome events (deal.won / stage.advanced / record.first_touch)
+    in the window so they can render as feed items, not just stat
+    counts. Returns one item per event with target name resolved
+    via the module table join."""
+    since = datetime.now(timezone.utc) - timedelta(hours=int(hours))
+    out: List[Dict[str, Any]] = []
+    module_pk_name = {
+        "potentials": ("potentials_id", "potentials_name"),
+        "leads":      ("leads_id",      "leads_name"),
+        "accounts":   ("accounts_id",   "accounts_name"),
+        "contacts":   ("contacts_id",   "contacts_name"),
+    }
+    for module, (pk, name_col) in module_pk_name.items():
+        try:
+            rows = db.fetchall(
+                f"""
+                SELECT e.event_type, e.value, e.occurred_at,
+                       e.ref_id, t.{name_col} AS target_name
+                  FROM rl_outcome_events e
+                  JOIN {module} t ON t.{pk} = e.ref_id
+                 WHERE e.ref_module = %s
+                   AND e.occurred_at > %s
+                   AND t.owner_by = %s
+                   AND t.deleted = false
+                 ORDER BY e.occurred_at DESC
+                 LIMIT %s
+                """,
+                (module, since, int(user_id), int(limit)),
+            ) or []
+        except Exception:
+            logger.exception("daily_feed_outcome_events_failed module=%s", module)
+            continue
+        for r in rows:
+            at = r.get("occurred_at")
+            v = r.get("value")
+            try:
+                v = float(v) if v is not None else None
+            except (TypeError, ValueError):
+                v = None
+            out.append({
+                "item_type": "outcome_event",
+                "event_type": r.get("event_type"),
+                "value": v,
+                "target": {
+                    "module": module,
+                    "record_id": int(r["ref_id"]) if r.get("ref_id") else 0,
+                    "name": r.get("target_name"),
+                },
+                "preview": None,  # SPA renders a kind-aware label
+                "at": at.astimezone(timezone.utc).isoformat() if isinstance(at, datetime) else "",
+            })
+    out.sort(key=lambda i: i.get("at") or "", reverse=True)
+    return out[: int(limit)]
+
+
+def _scan_outcomes(db: DbWrapper, user_id: int, days: int) -> Dict[str, Any]:
+    """Count outcome events in the window for records this user owns.
+
+    We join rl_outcome_events.ref_module/ref_id back to the owning CRM
+    table filtering by ``owner_by = user_id``. Unknown modules are
+    silently skipped.
+    """
+    totals = {
+        "deals_won": 0,
+        "deals_won_amount": 0.0,
+        "stages_advanced": 0,
+        "first_touch": 0,
+    }
+    # Single query per module keeps the SQL simple and readable.
+    module_pk = {
+        "potentials": "potentials_id",
+        "leads":      "leads_id",
+        "accounts":   "accounts_id",
+        "contacts":   "contacts_id",
+    }
+    for module, pk in module_pk.items():
+        rows = db.fetchall(
+            f"""
+            SELECT e.event_type, e.value
+            FROM rl_outcome_events e
+            JOIN {module} t ON t.{pk} = e.ref_id
+            WHERE e.ref_module = %s
+              AND e.occurred_at > now() - interval '%s days'
+              AND t.owner_by = %s
+              AND t.deleted = false
+            """,
+            (module, int(days), int(user_id)),
+        ) or []
+        for r in rows:
+            et = r.get("event_type")
+            if et == "deal.won":
+                totals["deals_won"] += 1
+                v = r.get("value")
+                if v is not None:
+                    try:
+                        totals["deals_won_amount"] += float(v)
+                    except (TypeError, ValueError):
+                        pass
+            elif et == "stage.advanced":
+                totals["stages_advanced"] += 1
+            elif et == "record.first_touch":
+                totals["first_touch"] += 1
+    # 0-amount looks ugly in narrative; hand back null when nobody won.
+    if totals["deals_won"] == 0:
+        totals["deals_won_amount"] = None
+    return totals
+
+
+# Severity → sort rank for the GET endpoint.
+_SEV_RANK = {"high": 0, "medium": 1, "low": 2}
+
+
+def _read_hints_from_table(
+    db: DbWrapper, user_id: int, limit: int = 3,
+) -> List[Dict[str, Any]]:
+    """Charter v2 §定律 4 — coach lives in ``gateway_actions``
+    (kind='coach.proposal'). Delegates to the shared reader in
+    ``coach_cards``; maps to the legacy hint shape (adds record_name).
+    """
+    from hermes.crm.insights.coach_cards import read_coach_proposals
+    return [
+        {
+            "id": r["id"],
+            "severity": r["severity"],
+            "signal": r["signal"],
+            "module": r.get("module"),
+            "record_id": r.get("record_id"),
+            "record_name": None,
+            "hint": r["hint"],
+            "is_read": r["is_read"],
+        }
+        for r in read_coach_proposals(db, user_id, limit=limit)
+    ]
+
+
+def _recent_interactions_for_record(
+    db: DbWrapper, module: str, record_id: int, limit: int = 5,
+) -> List[Dict[str, Any]]:
+    """The N most-recent interactions touching this record. Used as
+    LLM context for question generation — gives the model a sense of
+    what was talked about most recently."""
+    try:
+        rows = db.fetchall(
+            """
+            SELECT id, kind, occurred_at, content, source
+              FROM interactions
+             WHERE subjects @> %s::jsonb
+             ORDER BY occurred_at DESC NULLS LAST
+             LIMIT %s
+            """,
+            (json.dumps([{"module": module, "id": int(record_id)}]), int(limit)),
+        ) or []
+    except Exception:
+        return []
+    out: List[Dict[str, Any]] = []
+    for r in rows:
+        c = _jsonb(r.get("content")) or {}
+        preview = ""
+        if isinstance(c, dict):
+            for k in ("summary", "text", "body", "preview", "subject"):
+                v = c.get(k)
+                if isinstance(v, str) and v.strip():
+                    preview = v.strip()
+                    break
+        at = r.get("occurred_at")
+        out.append({
+            "kind": r.get("kind"),
+            "source": r.get("source"),
+            "preview": preview,
+            "at": at.isoformat() if at else None,
+        })
+    return out
+
+
+def _jsonb(val: Any) -> Any:
+    """psycopg returns JSONB as native dict/list OR as raw str depending
+    on driver version. Normalise to native Python."""
+    if val is None:
+        return None
+    if isinstance(val, (dict, list)):
+        return val
+    if isinstance(val, (bytes, bytearray)):
+        try:
+            return json.loads(val.decode("utf-8"))
+        except Exception:
+            return None
+    if isinstance(val, str):
+        try:
+            return json.loads(val)
+        except Exception:
+            return val
+    return val
+
+
+def _resolve_record_name(
+    db: DbWrapper, module: str, record_id: int,
+) -> Optional[str]:
+    """Best-effort name lookup. Returns None when module is unknown."""
+    if not module or not record_id:
+        return None
+    table_map = {
+        "accounts":   ("accounts",   "accounts_id",   "accounts_name"),
+        "contacts":   ("contacts",   "contacts_id",   "contacts_name"),
+        "leads":      ("leads",      "leads_id",      "leads_name"),
+        "potentials": ("potentials", "potentials_id", "potentials_name"),
+    }
+    spec = table_map.get(module)
+    if not spec:
+        return None
+    table, pk, name_col = spec
+    try:
+        row = db.fetchone(
+            f"SELECT {name_col} AS nm FROM {table} "
+            f"WHERE {pk} = %s AND deleted = false",
+            (int(record_id),),
+        )
+    except Exception:
+        return None
+    return str(row["nm"]) if row and row.get("nm") else None
+
+
+def _build_daily_feed(
+    db: DbWrapper, user_id: int, *,
+    hours: int = 24, limit: int = 200, module: Optional[str] = None,
+) -> Dict[str, Any]:
+    since = datetime.now(timezone.utc) - timedelta(hours=hours)
+
+    # Interactions in window — scoped via actors-array containing the
+    # user (or NULL for legacy rows). Two row-bounded queries keep this
+    # cheap and a Python merge by ``at`` desc is good enough at the 200
+    # row limit.
+    actor_contain = json.dumps([{"type": "user", "id": int(user_id)}])
+    try:
+        interaction_rows = db.fetchall(
+            """
+            SELECT id, kind, occurred_at, actors, subjects, content, source
+            FROM interactions
+            WHERE occurred_at > %s
+              AND kind = ANY(%s)
+              AND (actors @> %s::jsonb OR actors IS NULL)
+            ORDER BY occurred_at DESC
+            LIMIT %s
+            """,
+            (since, list(FEED_BUSINESS_KINDS), actor_contain, int(limit)),
+        ) or []
+    except Exception:
+        logger.exception("daily_feed_interactions_failed user=%s", user_id)
+        interaction_rows = []
+
+    # Coach hints in window — populated by the celery
+    # ``coach_hints_scan`` job; same source as the weekly digest.
+    # Charter v2 §定律 4 — coach lives in gateway_actions now.
+    from hermes.crm.insights.coach_cards import read_coach_proposals
+    hint_rows = read_coach_proposals(
+        db, user_id, since=since, limit=int(limit),
+    )
+
+    items: List[Dict[str, Any]] = []
+
+    for r in interaction_rows:
+        subjects = _jsonb(r.get("subjects"))
+        content = _jsonb(r.get("content"))
+        target = None
+        if isinstance(subjects, list):
+            for s in subjects:
+                if isinstance(s, dict) and s.get("module") and s.get("id"):
+                    target = {
+                        "module": s["module"],
+                        "record_id": int(s["id"]),
+                        "name": _resolve_record_name(
+                            db, s["module"], int(s["id"]),
+                        ),
+                    }
+                    break
+        preview = None
+        if isinstance(content, dict):
+            for key in ("summary", "text", "body", "preview"):
+                v = content.get(key)
+                if isinstance(v, str) and v.strip():
+                    preview = v.strip()
+                    break
+        at = r.get("occurred_at")
+        item: Dict[str, Any] = {
+            "item_type": "interaction",
+            "kind": r.get("kind"),
+            "source": r.get("source"),
+            "target": target,
+            "preview": preview,
+            "at": at.astimezone(timezone.utc).isoformat() if isinstance(at, datetime) else "",
+        }
+        # CRM-write rows (kind='action') carry no free-text summary —
+        # their content is {op, fields, changes}. Surface op + field
+        # names so the SPA can render a human-readable blurb
+        # ("新建记录" / "更新了 N 项") instead of an empty row.
+        if r.get("kind") == "action" and isinstance(content, dict):
+            op = content.get("op")
+            fields = content.get("fields")
+            if isinstance(op, str):
+                item["op"] = op
+            if isinstance(fields, list):
+                item["fields"] = [str(f) for f in fields]
+        items.append(item)
+
+    for r in hint_rows:
+        at = r.get("created_at")
+        rec_name = _resolve_record_name(
+            db, r.get("module") or "", int(r.get("record_id") or 0),
+        ) if r.get("record_id") else None
+        items.append({
+            "item_type": "coach_hint",
+            "hint_id": r["id"],  # gateway_actions uuid (str)
+            "specialist": "coach",
+            "severity": r.get("severity"),
+            "signal": r.get("signal"),
+            "preview": r.get("hint"),
+            "target": {
+                "module": r.get("module"),
+                "record_id": int(r.get("record_id") or 0),
+                "name": rec_name,
+            },
+            "is_read": r.get("read_at") is not None,
+            "is_dismissed": r.get("dismissed_at") is not None,
+            "at": at.astimezone(timezone.utc).isoformat() if isinstance(at, datetime) else "",
+        })
+
+    # Outcome events as items so the SPA can render dedicated sections
+    # ("今日成单 / 阶段推进 / 首触达") with click-through detail, not
+    # just headline counts. Same time window as interactions/hints.
+    try:
+        items.extend(_scan_outcome_events(db, user_id, hours=hours, limit=int(limit)))
+    except Exception:
+        logger.exception("daily_feed_outcome_events_failed user=%s", user_id)
+
+    # Optional module filter — keep only items whose target.module matches.
+    if module:
+        items = [
+            i for i in items
+            if (i.get("target") or {}).get("module") == module
+        ]
+
+    items.sort(key=lambda i: i.get("at") or "", reverse=True)
+    items = items[: int(limit)]
+
+    # Pipeline snapshot — reuse the weekly outcome aggregation but with
+    # a shorter window. Cheap enough to inline.
+    try:
+        outcomes = _scan_outcomes(db, user_id, max(1, hours // 24))
+    except Exception:
+        logger.exception("daily_feed_outcomes_failed user=%s", user_id)
+        outcomes = {
+            "deals_won": 0, "deals_won_amount": None,
+            "stages_advanced": 0, "first_touch": 0,
+        }
+
+    # Charter v2 §定律 5: AI 自动执行,人类事后监督。"AI 刚处理"
+    # counts AI-initiated activity in the window:
+    #   - source LIKE 'agent:%'        (legacy specialist agents)
+    #   - source LIKE 'copilot%' AND
+    #     source != 'copilot:user'     (Copilot replies + Copilot-driven
+    #                                   record writes, but NOT the
+    #                                   user's own typed questions)
+    def _is_ai_source(src: Any) -> bool:
+        if not isinstance(src, str):
+            return False
+        if src.startswith("agent:"):
+            return True
+        if src.startswith("copilot") and src != "copilot:user":
+            return True
+        return False
+
+    agent_recent = sum(
+        1 for i in items
+        if i["item_type"] == "interaction" and _is_ai_source(i.get("source"))
+    )
+    counts = {
+        "interactions": sum(1 for i in items if i["item_type"] == "interaction"),
+        "coach_hints":  sum(1 for i in items if i["item_type"] == "coach_hint"),
+        "agent_recent": agent_recent,
+    }
+
+    money: Optional[Dict[str, Any]] = None
+    if module == "receivables":
+        try:
+            row = db.fetchone(
+                """
+                SELECT
+                  COALESCE(SUM(dueamount::numeric), 0)       AS total_due,
+                  COALESCE(SUM(actualamount::numeric), 0)    AS total_received,
+                  COALESCE(SUM(CASE
+                    WHEN duedate < now()::date
+                     AND COALESCE(receivablesstatus,'') NOT IN ('received','paid')
+                    THEN (dueamount::numeric
+                          - COALESCE(actualamount::numeric, 0))
+                    ELSE 0 END), 0)                          AS total_overdue,
+                  COUNT(*) FILTER (
+                    WHERE duedate < now()::date
+                      AND COALESCE(receivablesstatus,'') NOT IN ('received','paid')
+                  )                                          AS overdue_count,
+                  COALESCE(SUM(CASE
+                    WHEN duedate < now()::date
+                     AND (now()::date - duedate) BETWEEN 0 AND 30
+                     AND COALESCE(receivablesstatus,'') NOT IN ('received','paid')
+                    THEN (dueamount::numeric
+                          - COALESCE(actualamount::numeric, 0))
+                    ELSE 0 END), 0)                          AS aging_0_30,
+                  COALESCE(SUM(CASE
+                    WHEN (now()::date - duedate) BETWEEN 31 AND 60
+                     AND COALESCE(receivablesstatus,'') NOT IN ('received','paid')
+                    THEN (dueamount::numeric
+                          - COALESCE(actualamount::numeric, 0))
+                    ELSE 0 END), 0)                          AS aging_31_60,
+                  COALESCE(SUM(CASE
+                    WHEN (now()::date - duedate) > 60
+                     AND COALESCE(receivablesstatus,'') NOT IN ('received','paid')
+                    THEN (dueamount::numeric
+                          - COALESCE(actualamount::numeric, 0))
+                    ELSE 0 END), 0)                          AS aging_60_plus
+                  FROM receivables
+                 WHERE deleted = false
+                   AND owner_by = %s
+                """,
+                (int(user_id),),
+            )
+            money = {
+                "total_due":      float(row["total_due"] or 0),
+                "total_received": float(row["total_received"] or 0),
+                "total_overdue":  float(row["total_overdue"] or 0),
+                "overdue_count":  int(row["overdue_count"] or 0),
+                "aging": {
+                    "0_30":    float(row["aging_0_30"] or 0),
+                    "31_60":   float(row["aging_31_60"] or 0),
+                    "60_plus": float(row["aging_60_plus"] or 0),
+                },
+            }
+        except Exception:
+            logger.exception("daily_feed_receivables_money_failed user=%s", user_id)
+    elif module == "payments":
+        try:
+            row = db.fetchone(
+                """
+                SELECT
+                  COALESCE(SUM(payamount::numeric), 0) AS month_received
+                  FROM payments
+                 WHERE deleted = false
+                   AND owner_by = %s
+                   AND paydate >= date_trunc('month', now())::date
+                """,
+                (int(user_id),),
+            )
+            money = {
+                "month_received": float(row["month_received"] or 0),
+            }
+        except Exception:
+            logger.exception("daily_feed_payments_money_failed user=%s", user_id)
+
+    return {
+        "range_hours": int(hours),
+        "items": items,
+        "counts": counts,
+        "outcomes": outcomes,
+        "money": money,
+    }
diff --git a/crm/insights/priority.py b/crm/insights/priority.py
new file mode 100644
index 0000000000..b184856bec
--- /dev/null
+++ b/crm/insights/priority.py
@@ -0,0 +1,307 @@
+"""CRM judgement helpers for the insights today-priority surface.
+
+Pure, deterministic helpers extracted from ``hermes_cloud.app.insights.api``:
+the cross-module urgency ranking, the signal→next-action mapping, and the
+cold-cache template fallbacks for the list-mode brief. The FastAPI routers
+and async orchestrators stay in the cloud package.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+from hermes.crm.insights.feed import _resolve_record_name
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# /api/insights/today_priority — cross-module urgency ranking that powers
+# DailyFeed's top "🚨 今天最该处理" section.
+#
+# Charter v2 alignment:
+#   §定律 1 (events-first): scores derive from events (interactions
+#       silence + coach_hints) and event-driven projections
+#       (next_contact_date), never from "this record looks important"
+#       record-level hand-waving.
+#   §定律 5 (AI 驾驶, 人类监督): the ranking is pure SQL — deterministic,
+#       cheap, no LLM. Surfaces automatically at the top of the feed
+#       without the user asking.
+#
+# Sources merged by (module, record_id):
+#   1. Unread coach_hints — high=50 / medium=20 / low=5
+#   2. accounts.next_contact_date overdue — overdue_days * 5, ≤ 100
+#   3. Active potentials silent ≥ 7d — silence_days * 2, ≤ 60
+# ---------------------------------------------------------------------------
+
+_ACTIVE_POT_MILESTONES_SQL = (
+    "lower(coalesce(milestone,'')) IN ("
+    "'qualified','proposal','negotiation','verbal',"
+    "'意向','方案','谈判','口头确认','商务')"
+)
+_TP_HINT_W = {"high": 50, "medium": 20, "low": 5}
+_TP_OVERDUE_CAP = 100
+_TP_SILENCE_CAP = 60
+
+
+def _build_today_priority(
+    db: DbWrapper, user_id: int, limit: int,
+    *, module: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Return the top-N (module, record_id) urgencies for this user.
+
+    Each item: ``{module, record_id, name, score, reasons:[{kind,text,weight}]}``.
+    Reasons are kept short (≤2 per item is enforced client-side; backend
+    returns them all so the SPA can decide).
+
+    If ``module`` is given, only items in that module are returned —
+    used by per-module daily dashboards. Without it, all four modules
+    (accounts/leads/contacts/potentials) compete on the same scoreboard.
+    """
+    # (module, record_id) -> {"name": str|None, "score": int, "reasons": [...]}
+    bucket: Dict[tuple, Dict[str, Any]] = {}
+
+    def _add(module: str, rid: int, name: Optional[str],
+             score: int, reason_kind: str, reason_text: str,
+             signal: Optional[str] = None) -> None:
+        key = (module, int(rid))
+        if key not in bucket:
+            bucket[key] = {"name": name, "score": 0, "reasons": []}
+        b = bucket[key]
+        if name and not b["name"]:
+            b["name"] = name
+        b["score"] += int(score)
+        entry: Dict[str, Any] = {
+            "kind": reason_kind, "text": reason_text, "weight": int(score),
+        }
+        if signal:
+            entry["signal"] = signal
+        b["reasons"].append(entry)
+
+    # 1) Unread coach proposals — charter v2 §定律 4: gateway_actions.
+    from hermes.crm.insights.coach_cards import read_coach_proposals
+    rows = read_coach_proposals(db, user_id, unread_only=True, limit=50)
+    for r in rows:
+        sev = (r.get("severity") or "low").lower()
+        score = _TP_HINT_W.get(sev, 5)
+        mod = r.get("module") or ""
+        rid = int(r.get("record_id") or 0)
+        # Skip proposals whose target record has been soft-deleted or
+        # never existed: clicking the priority row would navigate to
+        # /crm/<mod>/<rid> which 404s, leaving the user staring at a
+        # blank detail panel ("点了没反应"). The name resolver returns
+        # None for both cases, so it's a single guard.
+        if not mod or not rid:
+            continue
+        rec_name = _resolve_record_name(db, mod, rid)
+        if rec_name is None:
+            continue
+        _add(
+            mod, rid, rec_name, score,
+            "coach_hint",
+            r.get("hint") or "(无文本)",
+            signal=r.get("signal"),
+        )
+
+    # 2) accounts with overdue next_contact_date
+    try:
+        rows = db.fetchall(
+            """
+            SELECT accounts_id AS id, accounts_name AS name,
+                   (now()::date - next_contact_date) AS overdue_days
+              FROM accounts
+             WHERE owner_by = %s
+               AND deleted = false
+               AND next_contact_date IS NOT NULL
+               AND next_contact_date <= now()::date
+            """,
+            (int(user_id),),
+        ) or []
+    except Exception:
+        logger.exception("today_priority_overdue_failed user=%s", user_id)
+        rows = []
+    for r in rows:
+        days = int(r.get("overdue_days") or 0)
+        score = min(max(days * 5, 5), _TP_OVERDUE_CAP)
+        text = (
+            f"逾期 {days} 天未联系" if days > 0
+            else "今天到了下次联系日"
+        )
+        _add("accounts", int(r["id"]), r.get("name"), score, "overdue", text)
+
+    # 3) Active potentials silent ≥ 7 days
+    try:
+        rows = db.fetchall(
+            f"""
+            WITH last_touch AS (
+                SELECT
+                  ((s ->> 'id')::bigint) AS rid,
+                  MAX(occurred_at) AS at
+                FROM interactions, jsonb_array_elements(subjects) AS s
+                WHERE s ->> 'module' = 'potentials'
+                GROUP BY (s ->> 'id')::bigint
+            )
+            SELECT p.potentials_id AS id,
+                   p.potentials_name AS name,
+                   p.milestone,
+                   COALESCE(
+                     EXTRACT(EPOCH FROM (now() - lt.at)) / 86400.0,
+                     EXTRACT(EPOCH FROM (now() - p.created_at)) / 86400.0,
+                     0
+                   ) AS silence_days
+              FROM potentials p
+              LEFT JOIN last_touch lt ON lt.rid = p.potentials_id
+             WHERE p.owner_by = %s
+               AND p.deleted = false
+               AND {_ACTIVE_POT_MILESTONES_SQL}
+            """,
+            (int(user_id),),
+        ) or []
+    except Exception:
+        logger.exception("today_priority_silence_failed user=%s", user_id)
+        rows = []
+    for r in rows:
+        days = int(float(r.get("silence_days") or 0))
+        if days < 7:
+            continue
+        score = min(days * 2, _TP_SILENCE_CAP)
+        text = f"活跃商机({r.get('milestone') or '阶段未设'})已 {days} 天没动"
+        _add(
+            "potentials", int(r["id"]), r.get("name"), score, "silence", text,
+        )
+
+    items: List[Dict[str, Any]] = []
+    for (mod_name, rid), b in bucket.items():
+        if module and mod_name != module:
+            continue  # per-module filter
+        item = {
+            "module": mod_name,
+            "record_id": rid,
+            "name": b["name"],
+            "score": b["score"],
+            "reasons": b["reasons"],
+        }
+        item["next_action"] = _suggest_next_action(item)
+        items.append(item)
+    items.sort(key=lambda i: i["score"], reverse=True)
+    return items[: int(limit)]
+
+
+# Charter §定律 5: each priority row should not just rank — it should
+# propose the next concrete action so the user can click → execute.
+# Rule-based mapping from the row's TOP reason (highest weight) to a
+# verb-led action phrase + a kind. The SPA renders this as a "→ 处理"
+# button that prefills the Copilot input box on the record's detail
+# page; the LLM then drafts the actual artifact (email body etc).
+_SIGNAL_NEXT_ACTION: Dict[str, Dict[str, str]] = {
+    "pipeline_silence":          {"text": "拟一封紧迫跟进邮件,引用最近一次进度",      "kind": "draft"},
+    "vague_touchpoint":          {"text": "重新跟进 X,要求一个明确反馈和承诺时间",   "kind": "draft"},
+    "stage_stuck":               {"text": "复盘卡点,出一份内部讨论稿",                "kind": "analyst"},
+    "amount_missing":            {"text": "向客户委婉探询预算金额,起一段话术",        "kind": "draft"},
+    "account_silence":           {"text": "起一封问候邮件,分享行业情报",              "kind": "draft"},
+    "account_deep_silence":      {"text": "起一封关系回暖邮件,建议高管出面",          "kind": "draft"},
+    "all_deals_stalled":         {"text": "复盘所有在谈商机的共同卡点",                "kind": "analyst"},
+    "some_deals_stalled":        {"text": "逐单分析卡住的商机,定位共同卡点",          "kind": "analyst"},
+    "expansion_opportunity":     {"text": "评估续约或增购机会,起一次主动触达",        "kind": "analyst"},
+    "lead_cold":                 {"text": "拟一封重启触达邮件",                       "kind": "draft"},
+    "no_first_touch":            {"text": "拟一条首次外呼开场白",                     "kind": "draft"},
+    "convert_candidate":         {"text": "评估是否值得转商机,出理由清单",            "kind": "analyst"},
+    "contact_missing":           {"text": "查公开渠道,补全联系方式",                  "kind": "research"},
+    "contact_channels_missing":  {"text": "下次接触时把邮箱/手机补全",                "kind": "draft"},
+    "email_missing":             {"text": "通过其他渠道拿到对方邮箱",                  "kind": "draft"},
+    "silence_with_active_deal":  {"text": "起一封紧急跟进邮件,商机正在推进",          "kind": "draft"},
+    "contact_silence":           {"text": "起一封重联邮件",                           "kind": "draft"},
+    "linked_deals_stalled":      {"text": "从这位联系人入手,推动卡住的商机",          "kind": "analyst"},
+    "repeated_field_correction": {"text": "确认这个字段的标准写法,沉淀成规则",        "kind": "analyst"},
+}
+
+
+def _suggest_next_action(item: Dict[str, Any]) -> Optional[Dict[str, str]]:
+    """Pick the top-weight reason and map its signal/kind to a
+    concrete next-step action. Returns None if no rule matched (the
+    SPA will fall back to a generic "→ 让 AI 处理" with no prefill)."""
+    reasons = item.get("reasons") or []
+    if not reasons:
+        return None
+    # Highest-weight reason wins (most urgent signal).
+    top = max(reasons, key=lambda r: int(r.get("weight") or 0))
+
+    # 1) Coach-hint reasons carry an explicit signal we mapped above.
+    sig = top.get("signal")
+    if isinstance(sig, str) and sig in _SIGNAL_NEXT_ACTION:
+        a = _SIGNAL_NEXT_ACTION[sig]
+        return {"text": a["text"], "kind": a["kind"], "signal": sig}
+
+    # 2) Structured reason kinds (overdue / silence) → fixed actions.
+    rk = top.get("kind")
+    if rk == "overdue":
+        return {"text": "今天就联系一下,起一封跟进邮件", "kind": "draft", "signal": "overdue"}
+    if rk == "silence":
+        return {"text": "拟一封跟进邮件,询问当前进展", "kind": "draft", "signal": "silence"}
+
+    # 3) Fallback — generic but still useful.
+    return {"text": "查一下最新动态,然后决定下一步", "kind": "research", "signal": "fallback"}
+
+
+def _fallback_summary(
+    counts: Dict[str, int],
+    ai_noticed: List[Dict[str, Any]],
+    top_priority: List[Dict[str, Any]],
+) -> str:
+    """Cheap template summary used when the LLM hasn't responded yet
+    or returned nothing parseable."""
+    parts: List[str] = []
+    n_ai = counts.get("agent_recent") or 0
+    n_won = counts.get("outcome_won") or 0
+    n_top = len(top_priority or [])
+    n_int = counts.get("interactions") or 0
+    if n_ai:
+        parts.append(f"AI 替你处理了 {n_ai} 件事")
+    if n_int and n_int != n_ai:
+        parts.append(f"互动 {n_int} 条")
+    if n_won:
+        parts.append(f"成单 {n_won} 笔")
+    if n_top:
+        parts.append(f"{n_top} 条记录值得今天处理")
+    if not parts:
+        return "今天比较安静,暂无明显动作。"
+    return "近 24h:" + "、".join(parts) + "。"
+
+
+def _fallback_suggestions(
+    module: Optional[str],
+    top_priority: List[Dict[str, Any]],
+    ai_noticed: List[Dict[str, Any]],
+) -> List[Dict[str, Any]]:
+    """Verb-led prompts when the LLM hasn't answered (1-N, signal-driven).
+
+    The skill itself can return up to 10 (see SKILL.md + brief_generator
+    parser cap). This template fallback is the cold-cache stand-in —
+    we only emit what the local signals justify, padding-free.
+    """
+    out: List[Dict[str, Any]] = []
+    n_top = len(top_priority or [])
+    if n_top >= 2:
+        out.append({
+            "text": f"针对今天最紧迫的 {min(n_top, 5)} 条记录,各起一份下一步动作清单",
+            "agent": "analyst",
+        })
+    has_repeat = any(n.get("signal") == "repeated_field_correction"
+                     for n in (ai_noticed or []))
+    if has_repeat:
+        out.append({
+            "text": "我反复改的字段,帮我沉淀成统一规则",
+            "agent": "analyst",
+        })
+    out.append({
+        "text": "今天 AI 替我做了哪些事,1 句话总结",
+        "agent": "analyst",
+    })
+    if not any("最近的公开动态" in (s.get("text") or "") for s in out):
+        out.append({
+            "text": "查一下我们核心客户最近的公开动态",
+            "agent": "research",
+        })
+    return out[:5]
diff --git a/crm/insights/question_cache.py b/crm/insights/question_cache.py
new file mode 100644
index 0000000000..d1b4cac6e9
--- /dev/null
+++ b/crm/insights/question_cache.py
@@ -0,0 +1,143 @@
+"""Per-record cache of LLM-generated suggested questions.
+
+Charter §定律 5: the AI authors the questions, but only when the
+inputs actually changed. ``record_question_cache`` stores
+``(module, record_id) → (signature, questions, generated_at)``;
+when the next page-open's signature matches and the row is fresh
+enough, we skip the LLM call entirely.
+
+Signature inputs:
+  - sorted+dedup hint signals on the record
+  - the id of the most recent interaction touching the record
+  - the record's display name
+
+If any of those drift, the cache invalidates and the route
+regenerates. A coarse TTL also kicks in so prompts evolve over time.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+# How long a cached set of questions stays valid even when the
+# signature hasn't changed. Mostly a hedge against silent prompt /
+# model evolution: at worst we regenerate once a day per record.
+CACHE_TTL_HOURS = 24
+
+
+def compute_signature(
+    *,
+    record_name: Optional[str],
+    hint_signals: List[str],
+    last_interaction_id: Optional[str],
+) -> str:
+    """Stable hash over the inputs whose change should invalidate the
+    cache. SHA-1 truncated to 16 hex chars is plenty — this isn't a
+    security-sensitive hash, just a content fingerprint.
+
+    ``last_interaction_id`` is a UUID string (interactions.id) — any
+    new interaction touching the record changes the latest UUID and
+    invalidates this record's cached questions.
+    """
+    payload = {
+        "name": (record_name or "").strip(),
+        "signals": sorted(set(hint_signals or [])),
+        "last_int": str(last_interaction_id or ""),
+    }
+    raw = json.dumps(payload, ensure_ascii=False, sort_keys=True)
+    return hashlib.sha1(raw.encode("utf-8")).hexdigest()[:16]
+
+
+def get_cached_questions(
+    db: DbWrapper, *, module: str, record_id: int, signature: str,
+) -> Optional[List[Dict[str, Any]]]:
+    """Return cached questions if (a) the signature matches and (b) the
+    row is younger than ``CACHE_TTL_HOURS``. Otherwise None — caller
+    should regenerate."""
+    try:
+        row = db.fetchone(
+            """
+            SELECT questions
+              FROM record_question_cache
+             WHERE module = %s AND record_id = %s
+               AND signature = %s
+               AND generated_at > now() - interval '%s hours'
+            """,
+            (module, int(record_id), signature, CACHE_TTL_HOURS),
+        )
+    except Exception:
+        logger.exception(
+            "record_question_cache_get_failed module=%s id=%s",
+            module, record_id,
+        )
+        return None
+    if not row:
+        return None
+    qs = row.get("questions")
+    if isinstance(qs, str):
+        try:
+            qs = json.loads(qs)
+        except Exception:
+            return None
+    if not isinstance(qs, list):
+        return None
+    return qs
+
+
+def set_cached_questions(
+    db: DbWrapper, *, module: str, record_id: int,
+    signature: str, questions: List[Dict[str, Any]],
+) -> None:
+    """Upsert the cache row. Best-effort — failure is logged but doesn't
+    break the request (the route still returns the freshly generated
+    questions to the client)."""
+    try:
+        db.execute(
+            """
+            INSERT INTO record_question_cache (module, record_id, signature, questions, generated_at)
+            VALUES (%s, %s, %s, %s::jsonb, now())
+            ON CONFLICT (module, record_id) DO UPDATE
+              SET signature = EXCLUDED.signature,
+                  questions = EXCLUDED.questions,
+                  generated_at = now()
+            """,
+            (module, int(record_id), signature,
+             json.dumps(questions, ensure_ascii=False)),
+        )
+    except Exception:
+        logger.exception(
+            "record_question_cache_set_failed module=%s id=%s",
+            module, record_id,
+        )
+
+
+def latest_interaction_id(
+    db: DbWrapper, *, module: str, record_id: int,
+) -> Optional[str]:
+    """Most recent ``interactions.id`` (UUID) whose subjects array
+    contains ``{module, id: record_id}``. Used as the freshness pivot
+    in the signature: any new event invalidates cached questions."""
+    try:
+        row = db.fetchone(
+            """
+            SELECT id::text AS id
+              FROM interactions
+             WHERE subjects @> %s::jsonb
+             ORDER BY occurred_at DESC NULLS LAST
+             LIMIT 1
+            """,
+            (json.dumps([{"module": module, "id": int(record_id)}]),),
+        )
+    except Exception:
+        return None
+    if not row:
+        return None
+    val = row.get("id")
+    return str(val) if val else None
diff --git a/crm/insights/question_generator.py b/crm/insights/question_generator.py
new file mode 100644
index 0000000000..1b0a3e3a7e
--- /dev/null
+++ b/crm/insights/question_generator.py
@@ -0,0 +1,147 @@
+"""Generate 3 fully-contextual quick-prompt suggestions per record.
+
+Charter §定律 5: AI drives. Phase A in scanners produces signal-driven
+templated questions. This generator goes one step further — feeds the
+LLM the record's summary, hints, and last few interactions, asks for
+3 verb-led, situated questions that a smart sales colleague would ask.
+
+Returns ``[]`` on any failure; the caller (record_insight route) then
+falls back to whatever the scanner already produced.
+
+Used inside an async FastAPI handler. Bounded by the same
+``timeout_sec`` + ``max_rounds`` safeguards on the underlying LLM
+client. Uses a short prompt + low max_tokens so generation is cheap
+(typically ~200 visible tokens, sub-2s on big-pickle).
+"""
+from __future__ import annotations
+
+import json
+import logging
+import re
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _format_hints(hints: List[Dict[str, Any]]) -> str:
+    if not hints:
+        return "(暂无)"
+    out = []
+    for h in hints[:3]:
+        sev = h.get("severity") or "low"
+        sig = h.get("signal") or "?"
+        text = (h.get("hint") or "").strip()
+        out.append(f"- [{sev}/{sig}] {text}")
+    return "\n".join(out)
+
+
+def _format_interactions(items: List[Dict[str, Any]]) -> str:
+    if not items:
+        return "(暂无)"
+    out = []
+    for it in items[:5]:
+        kind = it.get("kind") or "?"
+        when = it.get("at") or it.get("occurred_at") or ""
+        when_short = str(when)[:10] if when else ""
+        text = (it.get("preview") or it.get("summary") or it.get("text") or "").strip()
+        out.append(f"- [{when_short} {kind}] {text[:120]}")
+    return "\n".join(out)
+
+
+def _build_user_prompt(
+    *, module: str, record_name: Optional[str],
+    summary: Optional[str], hints: List[Dict[str, Any]],
+    recent_interactions: List[Dict[str, Any]],
+) -> str:
+    return f"""\
+模块: {module}
+记录: {record_name or "(未命名)"}
+
+当前画像:
+{summary or "(无)"}
+
+AI 焦点(已经检测到的异常):
+{_format_hints(hints)}
+
+最近 5 条互动(从新到旧):
+{_format_interactions(recent_interactions)}
+
+请基于以上信息,生成 3 个销售下一步最该问 AI 的快捷提问。"""
+
+
+def _parse_questions(text: str) -> List[Dict[str, Any]]:
+    """Extract the JSON array from the LLM's reply. Tolerates accidental
+    code-fence wrapping or leading prose; falls back to ``[]`` if we
+    can't find a valid array."""
+    if not text:
+        return []
+    s = text.strip()
+    # Strip code fences if the model wrapped its array.
+    s = re.sub(r"^```(?:json)?\s*", "", s)
+    s = re.sub(r"\s*```$", "", s)
+    # Find the outermost array.
+    m = re.search(r"\[.*\]", s, re.DOTALL)
+    if not m:
+        return []
+    try:
+        arr = json.loads(m.group(0))
+    except Exception:
+        return []
+    if not isinstance(arr, list):
+        return []
+    out: List[Dict[str, Any]] = []
+    for item in arr:
+        if not isinstance(item, dict):
+            continue
+        text = str(item.get("text") or "").strip()
+        if not text:
+            continue
+        agent = str(item.get("agent") or "").strip()
+        if agent not in {"draft", "analyst", "research"}:
+            agent = "analyst"  # safe default
+        out.append({"text": text[:200], "agent": agent})
+        if len(out) >= 3:
+            break
+    return out
+
+
+async def generate_questions(
+    *, module: str, record_name: Optional[str],
+    summary: Optional[str], hints: List[Dict[str, Any]],
+    recent_interactions: List[Dict[str, Any]],
+    user_id: Optional[int] = None,
+    app: Optional[Any] = None,
+) -> List[Dict[str, Any]]:
+    """Charter v2 §定律 4 — route via the user's main agent +
+    ``crm-question-suggest`` skill. Returns ``[]`` on any failure;
+    caller falls back to scanner template questions.
+    """
+    if app is None or user_id is None:
+        # No FastAPI app on hand → can't reach the user's hermes
+        # subprocess. Caller's own template fallback handles this.
+        return []
+
+    user_msg = _build_user_prompt(
+        module=module, record_name=record_name,
+        summary=summary, hints=hints,
+        recent_interactions=recent_interactions,
+    )
+
+    from hermes_cloud.app.utility_via_skill import run_utility_skill
+    try:
+        reply = await run_utility_skill(
+            app=app, user_id=int(user_id),
+            skill_name="crm-question-suggest",
+            instruction=user_msg,
+            timeout_sec=45.0,
+        )
+    except Exception:
+        logger.exception("question_gen_via_skill_crashed module=%s", module)
+        return []
+    if not isinstance(reply, list):
+        logger.info(
+            "question_gen_no_parse module=%s name=%s reply_type=%s",
+            module, record_name, type(reply).__name__,
+        )
+        return []
+    return _parse_questions(json.dumps(reply, ensure_ascii=False))
diff --git a/crm/insights/registry.py b/crm/insights/registry.py
new file mode 100644
index 0000000000..e46c0e1fde
--- /dev/null
+++ b/crm/insights/registry.py
@@ -0,0 +1,44 @@
+"""Module → scanner registry.
+
+Only modules listed here get record-level insights. Unknown modules
+yield ``has_data: false`` and the frontend hides the card.
+
+Why a registry instead of auto-discovery: we want adding a new module to
+be an explicit, reviewed act (宪章 §168 — module copy is business-facing,
+not a by-product of convention).
+"""
+from __future__ import annotations
+
+from typing import Dict
+
+from .scanners import ScannerFn
+from .scanners import accounts as _accounts
+from .scanners import contacts as _contacts
+from .scanners import leads as _leads
+from .scanners import payments as _payments
+from .scanners import potentials as _potentials
+from .scanners import products as _products
+from .scanners import quotes as _quotes
+from .scanners import receivables as _receivables
+from .scanners import salesorders as _salesorders
+from .scanners import tasks as _tasks
+
+REGISTRY: Dict[str, ScannerFn] = {
+    "potentials":  _potentials.scan,
+    "leads":       _leads.scan,
+    "accounts":    _accounts.scan,
+    "contacts":    _contacts.scan,
+    "quotes":      _quotes.scan,
+    "tasks":       _tasks.scan,
+    "salesorders": _salesorders.scan,
+    "receivables": _receivables.scan,
+    "payments":    _payments.scan,
+    "products":    _products.scan,
+}
+
+
+def get(module: str) -> ScannerFn | None:
+    return REGISTRY.get(module)
+
+
+__all__ = ["REGISTRY", "get"]
diff --git a/crm/insights/revenue_indicators.py b/crm/insights/revenue_indicators.py
new file mode 100644
index 0000000000..5c46d06dde
--- /dev/null
+++ b/crm/insights/revenue_indicators.py
@@ -0,0 +1,333 @@
+"""Revenue / orders / product-sales indicators for analyze_team.
+
+Charter §对话即界面 + spec §六: when the manager asks "本月业绩如何"
+or "top 3 产品销量", the LLM needs record-level data — not just
+aggregate counts. These helpers return per-deal/per-order/per-product
+detail so the LLM can write "潜客#7 已成交 ¥120w (4/22 closed)" or
+"产品 P3 本月卖了 ¥8w / 15 单", not "本月成交 5 单".
+
+Scope inversion (final migration phase): these helpers NO LONGER
+resolve RBAC scope. Each takes an already-resolved ``uids: List[int]``
+and does its SQL filtering on that. The caller resolves + audits scope.
+"""
+from __future__ import annotations
+import logging
+from typing import Any, Dict, List
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Revenue summary — won deals + amounts, current & prior period
+# ──────────────────────────────────────────────────────────────────────
+
+
+def revenue_summary(
+    db: DbWrapper, *, uids: List[int],
+    window_days: int = 30,
+) -> Dict[str, Any]:
+    """Aggregate + per-deal detail for won potentials in the window.
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Returns:
+      {
+        "window_days": N,
+        "current_period": {
+            "won_count": N, "won_amount": float, "deals": [
+                {"potentials_id":..., "name":..., "owner_name":...,
+                 "amount":..., "actual_close_date":...},
+                ...up to 10
+            ]
+        },
+        "previous_period": {"won_count": N, "won_amount": float},
+        "by_owner": [{"owner_name":..., "won_count":N,"won_amount":...}],
+      }
+    """
+    if not uids:
+        return {
+            "window_days": int(window_days),
+            "current_period": {"won_count": 0, "won_amount": 0.0, "deals": []},
+            "previous_period": {"won_count": 0, "won_amount": 0.0},
+            "by_owner": [],
+        }
+
+    out: Dict[str, Any] = {
+        "window_days": int(window_days),
+        "current_period": {"won_count": 0, "won_amount": 0.0, "deals": []},
+        "previous_period": {"won_count": 0, "won_amount": 0.0},
+        "by_owner": [],
+    }
+
+    # Current-period detail list. ``actual_close_date`` is often NULL
+    # in seed/legacy data — fall back to ``updated_at`` so newly-won
+    # deals without a manually-set close date still surface.
+    try:
+        deals = db.fetchall(
+            """SELECT p.potentials_id, p.potentials_name AS name,
+                      p.owner_by AS owner_user_id,
+                      COALESCE(NULLIF(u.realname, ''), u.username, '?')
+                          AS owner_name,
+                      p.amount,
+                      COALESCE(p.actual_close_date, p.updated_at) AS won_at
+                 FROM potentials p
+                 LEFT JOIN users u ON u.id = p.owner_by
+                WHERE p.deleted = FALSE
+                  AND p.owner_by = ANY(%s::bigint[])
+                  AND p.milestone IN ('won', '成交')
+                  AND COALESCE(p.actual_close_date, p.updated_at) > NOW() - (%s * interval '1 day')
+                ORDER BY won_at DESC
+                LIMIT 10""",
+            (uids, int(window_days)),
+        ) or []
+    except Exception:
+        logger.exception("revenue_summary deals failed")
+        try: db.rollback()
+        except Exception: pass
+        deals = []
+    cur_count = 0
+    cur_amount = 0.0
+    deal_rows: List[Dict[str, Any]] = []
+    for d in deals:
+        amt = float(d["amount"]) if d.get("amount") is not None else 0.0
+        cur_count += 1
+        cur_amount += amt
+        deal_rows.append({
+            "potentials_id": int(d["potentials_id"]),
+            "name": str(d.get("name") or ""),
+            "owner_user_id": (
+                int(d["owner_user_id"]) if d.get("owner_user_id") else None
+            ),
+            "owner_name": str(d.get("owner_name") or "?"),
+            "amount": amt,
+            "won_at": (
+                d["won_at"].isoformat() if d.get("won_at") else None
+            ),
+        })
+    out["current_period"]["won_count"] = cur_count
+    out["current_period"]["won_amount"] = round(cur_amount, 2)
+    out["current_period"]["deals"] = deal_rows
+
+    # Previous-period aggregate (same window, immediately prior)
+    try:
+        prev = db.fetchone(
+            """SELECT count(*) AS won_count,
+                      COALESCE(sum(amount), 0)::float AS won_amount
+                 FROM potentials
+                WHERE deleted = FALSE
+                  AND owner_by = ANY(%s::bigint[])
+                  AND milestone IN ('won', '成交')
+                  AND COALESCE(actual_close_date, updated_at) <= NOW() - (%s * interval '1 day')
+                  AND COALESCE(actual_close_date, updated_at) > NOW() - (2 * %s * interval '1 day')""",
+            (uids, int(window_days), int(window_days)),
+        )
+        out["previous_period"]["won_count"] = (
+            int(prev["won_count"]) if prev else 0
+        )
+        out["previous_period"]["won_amount"] = (
+            round(float(prev["won_amount"]), 2) if prev else 0.0
+        )
+    except Exception:
+        logger.exception("revenue_summary prev period failed")
+        try: db.rollback()
+        except Exception: pass
+
+    # Per-owner breakdown
+    try:
+        rows = db.fetchall(
+            """SELECT p.owner_by AS owner_user_id,
+                      COALESCE(NULLIF(u.realname, ''), u.username, '?') AS owner_name,
+                      count(*) AS won_count,
+                      COALESCE(sum(p.amount), 0)::float AS won_amount
+                 FROM potentials p
+                 LEFT JOIN users u ON u.id = p.owner_by
+                WHERE p.deleted = FALSE
+                  AND p.owner_by = ANY(%s::bigint[])
+                  AND p.milestone IN ('won', '成交')
+                  AND COALESCE(p.actual_close_date, p.updated_at) > NOW() - (%s * interval '1 day')
+                GROUP BY p.owner_by, owner_name
+                ORDER BY won_amount DESC""",
+            (uids, int(window_days)),
+        ) or []
+        out["by_owner"] = [
+            {
+                "owner_user_id": (
+                    int(r["owner_user_id"]) if r.get("owner_user_id") else None
+                ),
+                "owner_name": str(r.get("owner_name") or "?"),
+                "won_count": int(r.get("won_count") or 0),
+                "won_amount": round(float(r.get("won_amount") or 0.0), 2),
+            }
+            for r in rows
+        ]
+    except Exception:
+        logger.exception("revenue_summary by_owner failed")
+        try: db.rollback()
+        except Exception: pass
+
+    return out
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Order pipeline — salesorders by status + recent orders
+# ──────────────────────────────────────────────────────────────────────
+
+
+def order_pipeline(
+    db: DbWrapper, *, uids: List[int],
+    window_days: int = 30,
+) -> Dict[str, Any]:
+    """salesorders aggregate by status + recent order detail.
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Returns:
+      {
+        "by_status": [{"status": str, "n": int, "total_amount": float}],
+        "recent": [
+          {"salesorders_id":..., "name":..., "owner_name":...,
+           "status":..., "amount":..., "orderdate":...},
+          ...up to 10
+        ]
+      }
+    """
+    if not uids:
+        return {"by_status": [], "recent": []}
+
+    # ``salesorders.final_amount`` is NUMERIC since alembic 0079 — the
+    # kacrm-era JSONB envelope ({"CNY": N} / {"original_amount": N}) is
+    # gone. ``owner_by`` is often NULL on orders auto-promoted from quotes
+    # — fall back to created_by so reports surface them.
+    out: Dict[str, Any] = {"by_status": [], "recent": []}
+    amount_expr = "COALESCE(s.final_amount, 0::numeric)"
+    owner_expr = "COALESCE(s.owner_by, s.created_by)"
+    try:
+        agg = db.fetchall(
+            f"""SELECT COALESCE(NULLIF(s.status, ''), '(unknown)') AS status,
+                      count(*) AS n,
+                      COALESCE(sum({amount_expr}), 0)::float AS total_amount
+                 FROM salesorders s
+                WHERE s.deleted = FALSE
+                  AND {owner_expr} = ANY(%s::bigint[])
+                  AND s.orderdate > NOW() - (%s * interval '1 day')
+                GROUP BY status
+                ORDER BY n DESC""",
+            (uids, int(window_days)),
+        ) or []
+        out["by_status"] = [
+            {
+                "status": str(r["status"]),
+                "n": int(r["n"]),
+                "total_amount": round(float(r["total_amount"] or 0.0), 2),
+            }
+            for r in agg
+        ]
+    except Exception:
+        logger.exception("order_pipeline by_status failed")
+        try: db.rollback()
+        except Exception: pass
+
+    try:
+        recent = db.fetchall(
+            f"""SELECT s.salesorders_id, s.salesorders_name AS name,
+                      COALESCE(s.owner_by, s.created_by) AS owner_user_id,
+                      COALESCE(NULLIF(u.realname, ''), u.username, '?')
+                          AS owner_name,
+                      s.status, {amount_expr} AS amount,
+                      s.orderdate
+                 FROM salesorders s
+                 LEFT JOIN users u ON u.id = COALESCE(s.owner_by, s.created_by)
+                WHERE s.deleted = FALSE
+                  AND COALESCE(s.owner_by, s.created_by) = ANY(%s::bigint[])
+                ORDER BY s.orderdate DESC NULLS LAST
+                LIMIT 10""",
+            (uids,),
+        ) or []
+        out["recent"] = [
+            {
+                "salesorders_id": int(r["salesorders_id"]),
+                "name": str(r.get("name") or ""),
+                "owner_user_id": (
+                    int(r["owner_user_id"]) if r.get("owner_user_id") else None
+                ),
+                "owner_name": str(r.get("owner_name") or "?"),
+                "status": str(r.get("status") or ""),
+                "amount": (
+                    round(float(r["amount"]), 2)
+                    if r.get("amount") is not None else None
+                ),
+                "orderdate": (
+                    r["orderdate"].isoformat() if r.get("orderdate") else None
+                ),
+            }
+            for r in recent
+        ]
+    except Exception:
+        logger.exception("order_pipeline recent failed")
+        try: db.rollback()
+        except Exception: pass
+
+    return out
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Product sales — top N products by quantity / amount
+# ──────────────────────────────────────────────────────────────────────
+
+
+def product_sales_top(
+    db: DbWrapper, *, uids: List[int],
+    window_days: int = 30, limit: int = 10,
+) -> List[Dict[str, Any]]:
+    """Top N products by amount sold within the window, scoped to
+    salesorders owned by visible team members.
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Returns:
+      [{"products_id":..., "name":..., "qty_sold":int,
+        "amount_sold":float, "n_orders":int}, ...]
+    """
+    if not uids:
+        return []
+
+    try:
+        # ``salesorders_products.total`` is NUMERIC since alembic 0079.
+        # Same ``owner_by COALESCE created_by`` fallback as
+        # ``order_pipeline`` for null-owner orders.
+        total_expr = "COALESCE(sp.total, 0::numeric)"
+        rows = db.fetchall(
+            f"""SELECT sp.products_id,
+                      MAX(sp.products_name) AS name,
+                      COALESCE(SUM(sp.quantity), 0)::float AS qty_sold,
+                      COALESCE(SUM({total_expr}), 0)::float AS amount_sold,
+                      COUNT(DISTINCT sp.salesorders_id) AS n_orders
+                 FROM salesorders_products sp
+                 JOIN salesorders s ON s.salesorders_id = sp.salesorders_id
+                WHERE s.deleted = FALSE
+                  AND COALESCE(s.owner_by, s.created_by) = ANY(%s::bigint[])
+                  AND s.orderdate > NOW() - (%s * interval '1 day')
+                  AND sp.products_id IS NOT NULL
+                GROUP BY sp.products_id
+                ORDER BY amount_sold DESC
+                LIMIT %s""",
+            (uids, int(window_days), int(limit)),
+        ) or []
+    except Exception:
+        logger.exception("product_sales_top failed")
+        try: db.rollback()
+        except Exception: pass
+        return []
+
+    return [
+        {
+            "products_id": int(r["products_id"]),
+            "name": str(r.get("name") or ""),
+            "qty_sold": round(float(r["qty_sold"] or 0.0), 2),
+            "amount_sold": round(float(r["amount_sold"] or 0.0), 2),
+            "n_orders": int(r["n_orders"] or 0),
+        }
+        for r in rows
+    ]
diff --git a/crm/insights/scanners/__init__.py b/crm/insights/scanners/__init__.py
new file mode 100644
index 0000000000..4a3aac192d
--- /dev/null
+++ b/crm/insights/scanners/__init__.py
@@ -0,0 +1,90 @@
+"""Per-module record-insight scanners.
+
+Each scanner answers a simple question: *"If a salesperson just opened this
+record, what does AI already know and what should they do next?"*
+
+**Why per-module instead of a generic scanner?** 宪章 §168 explicitly
+rejects the "universal CRM abstraction" temptation. A `lead` and a
+`potential` look structurally similar (id + owner + status) but the
+concerns a human has when opening them are totally different:
+
+- 商机 (potentials) — 推进阶段、卡点、下一步动作
+- 线索 (leads)     — 是否值得转、资料补全、首次触达
+- 客户 (accounts)  — 关系健康、续约、扩展机会
+- 联系人 (contacts) — 角色、断联、关联商机
+
+A generic "show last N activities + silence days" scanner would produce
+bland output everywhere. So each module gets its own file with its own
+SQL + its own thresholds + its own copy. Shared rendering / shape
+happens at the frontend — data stays module-specific.
+
+The shape returned by every scanner::
+
+    {
+      "has_data": bool,                # False => frontend hides the card
+      "module":   str,                 # echoes the input
+      "record_id": int,
+      "summary":  str | None,          # 1–2 sentences, rule-based, never LLM
+      "hints":    [CoachHint, ...],    # same shape as /api/insights/weekly
+      "suggested_questions": [
+        {"text": str, "agent": str | None}  # agent=None → router picks
+      ],
+    }
+
+Scanners must be cheap (< 5 queries, < 200 ms). Heavy analysis belongs in
+the per-record AnalystAgent, which the ``suggested_questions`` can
+summon explicitly.
+"""
+from __future__ import annotations
+
+from typing import Any, Callable, Dict, List, Optional, TypedDict
+
+from hermes.crm.db import DbWrapper
+
+
+class CoachHint(TypedDict, total=False):
+    severity: str            # "high" | "medium" | "low"
+    signal:   str            # e.g. "pipeline_silence"
+    module:   str
+    record_id: int
+    record_name: Optional[str]
+    hint: str                # action-oriented sentence (定律 5)
+
+
+class SuggestedQuestion(TypedDict, total=False):
+    text:  str               # verb-led Chinese prompt
+    agent: Optional[str]     # None → let intake router pick
+
+
+class RecordInsight(TypedDict, total=False):
+    has_data: bool
+    module:   str
+    record_id: int
+    summary:  Optional[str]
+    hints:    List[CoachHint]
+    suggested_questions: List[SuggestedQuestion]
+
+
+# A scanner is ``(db, record_id, user_id) -> RecordInsight``.
+ScannerFn = Callable[[DbWrapper, int, int], RecordInsight]
+
+
+def empty(module: str, record_id: int) -> RecordInsight:
+    """Safe no-op shape. Frontend hides the card when ``has_data`` is False."""
+    return {
+        "has_data": False,
+        "module": module,
+        "record_id": record_id,
+        "summary": None,
+        "hints": [],
+        "suggested_questions": [],
+    }
+
+
+__all__ = [
+    "CoachHint",
+    "SuggestedQuestion",
+    "RecordInsight",
+    "ScannerFn",
+    "empty",
+]
diff --git a/crm/insights/scanners/accounts.py b/crm/insights/scanners/accounts.py
new file mode 100644
index 0000000000..ab99a76f59
--- /dev/null
+++ b/crm/insights/scanners/accounts.py
@@ -0,0 +1,245 @@
+"""客户 (accounts) record-insight scanner.
+
+When a salesperson opens an account, they want to know:
+
+    1. 这家客户整体关系怎么样？(健康 / 断联 / 流失风险)
+    2. 在谈哪些机会？卡在哪？
+    3. 最近成交多少？有没有扩展空间？
+
+The accounts table already carries aggregate columns
+(``opportunity_count``, ``deal_count``, ``latest_contact_date``, etc.)
+maintained by CRM write triggers — we can read them directly instead of
+recomputing. That keeps this scanner cheap.
+"""
+from __future__ import annotations
+
+from datetime import date
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+from . import RecordInsight, empty
+
+_ACTIVE_MILESTONES = {
+    "qualified", "proposal", "negotiation", "verbal",
+    "意向", "方案", "谈判", "口头确认", "商务",
+}
+_ACCOUNT_SILENCE_DAYS = 30
+_ACCOUNT_DEEP_SILENCE_DAYS = 90
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.0f}万"
+    return f"¥{n:.0f}"
+
+
+def _days_since(d) -> Optional[float]:
+    if not d:
+        return None
+    if isinstance(d, date):
+        return float((date.today() - d).days)
+    return None
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT accounts_id AS id, accounts_name AS name,
+               industry, contact_count, deal_count, deal_amount,
+               opportunity_count, opportunity_amount,
+               receivables_amount, payments_amount,
+               latest_contact_date, latest_deal_date
+          FROM accounts
+         WHERE accounts_id = %s AND deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("accounts", record_id)
+
+    name = row.get("name")
+    industry = row.get("industry")
+    opp_count = int(row.get("opportunity_count") or 0)
+    opp_amount = float(row.get("opportunity_amount") or 0)
+    deal_count = int(row.get("deal_count") or 0)
+    deal_amount = float(row.get("deal_amount") or 0)
+    latest_contact_days = _days_since(row.get("latest_contact_date"))
+    latest_deal_days = _days_since(row.get("latest_deal_date"))
+
+    # Count of *active* open potentials and how many are stalled (>14d
+    # updated_at). These are the two numbers a salesperson really cares
+    # about when the account home loads.
+    pot_rows = db.fetchall(
+        """
+        SELECT milestone,
+               EXTRACT(EPOCH FROM (now() - updated_at))/86400.0 AS stage_days
+          FROM potentials
+         WHERE accounts_id = %s AND deleted = false
+           AND (milestone IS NULL OR lower(milestone) NOT IN ('成交','won','closed won','丢失','lost','closed lost'))
+        """,
+        (int(record_id),),
+    ) or []
+    active_opps = [
+        p for p in pot_rows
+        if (p.get("milestone") or "").strip().lower() in _ACTIVE_MILESTONES
+    ]
+    stalled = [p for p in active_opps if (p.get("stage_days") or 0) > 14]
+
+    # -------- summary --------
+    parts: List[str] = []
+    if industry:
+        parts.append(industry)
+    if active_opps:
+        parts.append(f"在谈 {len(active_opps)} 单")
+    if deal_count > 0:
+        amt = _fmt_amount(deal_amount) or f"{deal_count} 单"
+        parts.append(f"历史成交 {amt}")
+    if latest_contact_days is not None:
+        if latest_contact_days < 1:
+            parts.append("今天有联系")
+        else:
+            parts.append(f"最近联系 {int(latest_contact_days)} 天前")
+    elif row.get("contact_count") == 0 or row.get("contact_count") is None:
+        parts.append("尚无联系记录")
+    summary = ("客户：" + "，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if latest_contact_days is not None and latest_contact_days > _ACCOUNT_DEEP_SILENCE_DAYS:
+        hints.append({
+            "severity": "high",
+            "signal": "account_deep_silence",
+            "module": "accounts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已 {int(latest_contact_days)} 天没联系 — "
+                f"关系有流失风险，建议由高管出面做一次关系回暖"
+            ),
+        })
+    elif latest_contact_days is not None and latest_contact_days > _ACCOUNT_SILENCE_DAYS:
+        hints.append({
+            "severity": "medium",
+            "signal": "account_silence",
+            "module": "accounts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已 {int(latest_contact_days)} 天没联系 — "
+                f"建议起一封问候或分享行业情报的邮件"
+            ),
+        })
+
+    # All active opps stalled → account-wide red flag, not per-deal.
+    if active_opps and len(stalled) == len(active_opps):
+        hints.append({
+            "severity": "high",
+            "signal": "all_deals_stalled",
+            "module": "accounts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"在谈的 {len(active_opps)} 单全部 >14 天没推进 — "
+                f"建议召集一次内部复盘，判断是不是策略出了问题"
+            ),
+        })
+    elif stalled:
+        hints.append({
+            "severity": "medium",
+            "signal": "some_deals_stalled",
+            "module": "accounts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"{len(stalled)}/{len(active_opps)} 单超 14 天没推进 — "
+                f"建议逐单盘点卡点"
+            ),
+        })
+
+    # Expansion opportunity: 成交过但最近没有在谈的新机会。
+    if deal_count > 0 and opp_count == 0 and (latest_deal_days or 0) > 60:
+        hints.append({
+            "severity": "low",
+            "signal": "expansion_opportunity",
+            "module": "accounts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                "老客户但没有在谈的新机会 — "
+                "可以评估续约 / 增购点，起一次触达"
+            ),
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions ----------------------------------
+    # Charter §定律 5: questions are derived from this record's actual
+    # signals (the hints we just computed) so they're contextual, not
+    # canned. We map each signal → one verb-led question; defaults
+    # only fill in when there are no signals to drive a contextual ask.
+    nm = name or "这家客户"
+    SIGNAL_Q = {
+        "account_deep_silence": (
+            f"帮我起一封关系回暖邮件给 {nm},切入点是\"许久没联系\"", "draft"),
+        "account_silence": (
+            f"帮我起一封跟进邮件给 {nm},分享行业情报", "draft"),
+        "all_deals_stalled": (
+            f"复盘 {nm} 的在谈商机为何都卡住,给我一份内部讨论稿", "analyst"),
+        "some_deals_stalled": (
+            f"逐单分析 {nm} 卡住的商机,找出共同卡点", "analyst"),
+        "expansion_opportunity": (
+            f"评估 {nm} 的续约 / 增购机会,起一次触达", "analyst"),
+    }
+    questions: List[Dict[str, Any]] = []
+    seen: set = set()
+    for h in hints:
+        sig = h.get("signal")
+        if sig in SIGNAL_Q and sig not in seen:
+            text, agent = SIGNAL_Q[sig]
+            questions.append({"text": text, "agent": agent})
+            seen.add(sig)
+
+    # Always-on defaults to top up to 3 questions, covering 3 distinct
+    # intent dimensions so quiet records still get a useful picker:
+    #   - pipeline view  (analyst)
+    #   - outreach       (draft)
+    #   - external intel (research)
+    defaults: List[Dict[str, Any]] = []
+    if deal_count > 0:
+        defaults.append({
+            "text": f"分析 {nm} 的历史成交规律和扩展机会", "agent": "analyst",
+        })
+    else:
+        defaults.append({
+            "text": f"盘点 {nm} 在谈的所有商机状态", "agent": "analyst",
+        })
+    defaults.append({
+        "text": f"帮我起一封问候邮件给 {nm},简短打个招呼", "agent": "draft",
+    })
+    defaults.append({
+        "text": f"查一下 {nm} 的公司背景和最近动态", "agent": "research",
+    })
+    for q in defaults:
+        if len(questions) >= 3:
+            break
+        if q["text"] in {x["text"] for x in questions}:
+            continue
+        questions.append(q)
+
+    return {
+        "has_data": True,
+        "module": "accounts",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/coach.py b/crm/insights/scanners/coach.py
new file mode 100644
index 0000000000..c9cf55bba7
--- /dev/null
+++ b/crm/insights/scanners/coach.py
@@ -0,0 +1,385 @@
+"""User-level Coach scanner — rule-based signal detection.
+
+Charter v2 §定律 4 status: the v1 ``coach_hints_scan`` celery task +
+``coach_hints`` table that this fed are **gone**. What's left:
+  * :func:`active_user_ids` — still used by ``crm_daily_coach_cron``
+    to know which users to run the main-agent coach for.
+  * :func:`scan_user` — still used by ``agent/auto_drive.py`` as a
+    cheap rule-based pre-filter.
+
+⚠️ RESIDUAL CHARTER DEBT: ``scan_user`` (and ``scanners/potentials``'s
+threshold tables) are still v1 rule-based logic. ``auto_drive`` should
+eventually move to a main-agent skill too — tracked in
+docs/2026-05-15-coach-remediation-charter-v2.md §residual.
+
+Returned shape mirrors :class:`scanners.CoachHint` but adds ``payload``.
+
+Signals emitted (cheap, every-30min scan):
+  * ``pipeline_silence`` — active deal, no contact > 7 / 14 days
+  * ``vague_touchpoint`` — last interaction is buzzword-y / lacks
+    commitments
+  * ``repeated_field_correction`` — user changed same field ≥ 3 times
+    in 30 days (audit-trail signal)
+  * ``stuck_in_stage`` — deal sits in current milestone > 21 / 45 days
+  * ``stage_regression`` — milestone moved backward in sort_order
+    within the last 30 days
+
+Orphan-commitment detection is LLM-driven and lives in
+``scanners/coach_orphan_commitment.py`` on a separate daily beat to
+keep the every-30min scan free of LLM calls.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.constants import TERMINAL_MILESTONES
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+def _milestone_sort_index(db: DbWrapper) -> Dict[str, int]:
+    """Return ``{milestone_value: position}`` derived from the live
+    ``module_fields.options`` string for ``potentials.milestone``.
+
+    Replaces the old ``pipeline_milestones.sort_order`` dictionary table
+    (dropped 2026-05-25). Reading from ``module_fields`` keeps the order
+    in sync with what admins see in the SPA picklist UI without a second
+    source of truth.
+
+    Returns ``{}`` if the field row or its options are missing, in which
+    case stage-regression detection silently no-ops rather than blowing
+    up.
+    """
+    row = db.fetchone(
+        """
+        SELECT mf.options
+          FROM module_fields mf
+          JOIN collections m ON m.id = mf.module_id
+         WHERE m.name = 'potentials' AND mf.field_name = 'milestone'
+         LIMIT 1
+        """
+    )
+    if not row or not row.get("options"):
+        return {}
+    parts = [p.strip() for p in str(row["options"]).split(",") if p.strip()]
+    return {p: idx for idx, p in enumerate(parts)}
+
+# Silence thresholds (days since last interaction on an active deal).
+_SILENCE_WARN_DAYS = 7
+_SILENCE_HIGH_DAYS = 14
+# Stuck-in-stage thresholds (days since milestone last changed).
+_STUCK_WARN_DAYS = 21
+_STUCK_HIGH_DAYS = 45
+# Stage-regression lookback window.
+_REGRESSION_WINDOW_DAYS = 30
+_SCAN_RECORD_LIMIT = 50
+
+_VAGUE_TOKENS = (
+    "follow up", "check in", "touching base", "circling back",
+    "just wanted", "跟进", "回访", "再联系", "保持联系",
+)
+
+_MODULE_PK_NAME = {
+    "potentials": ("potentials_id", "potentials_name"),
+    "leads":      ("leads_id",      "leads_name"),
+    "accounts":   ("accounts_id",   "accounts_name"),
+    "contacts":   ("contacts_id",   "contacts_name"),
+}
+
+
+def scan_user(db: DbWrapper, user_id: int) -> List[Dict[str, Any]]:
+    """Run all Coach heuristics for one user. Returns unsorted hints; the
+    persistence layer decides ordering/limit at read time.
+
+    Contract: each hint has ``(module, record_id, signal)`` as its
+    idempotency key — the same signal on the same record must always
+    produce the same row so upsert works.
+    """
+    hints: List[Dict[str, Any]] = []
+
+    # Active deals owned by this user. Terminal milestones (won/lost) are
+    # filtered out via the TERMINAL_MILESTONES constant — the
+    # pipeline_milestones dictionary table that previously carried this
+    # classification was dropped 2026-05-25. NULL milestone is treated as
+    # "unknown stage" → still in scope (admin may have a half-filled
+    # record), but we don't trigger silence (is_active=False below).
+    potentials = db.fetchall(
+        """
+        SELECT p.potentials_id AS id,
+               p.potentials_name AS name,
+               p.milestone
+        FROM potentials p
+        WHERE p.owner_by = %s
+          AND p.deleted = false
+          AND (p.milestone IS NULL OR p.milestone <> ALL(%s))
+        ORDER BY p.updated_at DESC
+        LIMIT %s
+        """,
+        (int(user_id), list(TERMINAL_MILESTONES), _SCAN_RECORD_LIMIT),
+    ) or []
+
+    for p in potentials:
+        ms = p.get("milestone")
+        # 进行中（is_active）= 已落到某个阶段且非终态。NULL/空 = 未设置阶段，
+        # 仍展示在扫描列表里但不触发 silence 告警。
+        is_active = bool(ms) and ms not in TERMINAL_MILESTONES
+
+        # Silence signal ----------------------------------------------------
+        days_row = db.fetchone(
+            """
+            SELECT EXTRACT(EPOCH FROM (now() - MAX(occurred_at))) / 86400.0 AS days
+            FROM interactions
+            WHERE subjects @> jsonb_build_array(
+                    jsonb_build_object('module', 'potentials', 'id', %s)
+                  )
+            """,
+            (int(p["id"]),),
+        ) or {}
+        days = days_row.get("days")
+        if is_active and days is not None and days > _SILENCE_WARN_DAYS:
+            sev = "high" if days > _SILENCE_HIGH_DAYS else "medium"
+            hints.append({
+                "severity": sev,
+                "signal": "pipeline_silence",
+                "module": "potentials",
+                "record_id": int(p["id"]),
+                "record_name": p.get("name"),
+                "hint": f"{days:.0f} 天未联系，当前阶段 ({p.get('milestone') or '未设置'})",
+                "payload": {
+                    "days_since_contact": float(days),
+                    "milestone": p.get("milestone"),
+                },
+            })
+
+        # Stuck-in-stage signal --------------------------------------------
+        # Days since milestone last changed (from changelog audit table).
+        # Falls back to potentials.created_at if the deal hasn't moved
+        # stages since it was created.
+        stuck_row = db.fetchone(
+            """
+            SELECT EXTRACT(EPOCH FROM (now() - COALESCE(
+                       (SELECT MAX(c.updated_at) FROM changelog c
+                          JOIN collections m ON m.id = c.module_id
+                         WHERE m.name = 'potentials'
+                           AND c.data_id = %s
+                           AND c.field_name = 'milestone'),
+                       p.created_at
+                   ))) / 86400.0 AS days
+              FROM potentials p
+             WHERE p.potentials_id = %s
+            """,
+            (int(p["id"]), int(p["id"])),
+        ) or {}
+        stuck_days = stuck_row.get("days")
+        if is_active and stuck_days is not None and stuck_days > _STUCK_WARN_DAYS:
+            sev = "high" if stuck_days > _STUCK_HIGH_DAYS else "medium"
+            hints.append({
+                "severity": sev,
+                "signal": "stuck_in_stage",
+                "module": "potentials",
+                "record_id": int(p["id"]),
+                "record_name": p.get("name"),
+                "hint": (
+                    f"在『{p.get('milestone') or '当前阶段'}』停留 "
+                    f"{stuck_days:.0f} 天，比常规节奏慢"
+                ),
+                "payload": {
+                    "days_in_stage": float(stuck_days),
+                    "milestone": p.get("milestone"),
+                },
+            })
+
+        # Vague last touch --------------------------------------------------
+        last = db.fetchone(
+            """
+            SELECT content
+            FROM interactions
+            WHERE subjects @> jsonb_build_array(
+                    jsonb_build_object('module', 'potentials', 'id', %s)
+                  )
+            ORDER BY occurred_at DESC
+            LIMIT 1
+            """,
+            (int(p["id"]),),
+        )
+        if last and last.get("content"):
+            c = last["content"]
+            if isinstance(c, str):
+                try: c = json.loads(c)
+                except Exception: c = {}
+            text = ""
+            if isinstance(c, dict):
+                for k in ("text", "body", "summary", "subject"):
+                    if c.get(k):
+                        text = str(c[k]); break
+            lower = text.lower()
+            if text and len(text) < 120 and any(t in lower for t in _VAGUE_TOKENS):
+                hints.append({
+                    "severity": "low",
+                    "signal": "vague_touchpoint",
+                    "module": "potentials",
+                    "record_id": int(p["id"]),
+                    "record_name": p.get("name"),
+                    "hint": "最近一次沟通偏模糊，缺具体反馈和承诺时间",
+                    "payload": {"last_snippet": text[:200]},
+                })
+
+    # Repeated-field-correction ----------------------------------------------
+    repeats = db.fetchall(
+        """
+        SELECT module, record_id, field_name, COUNT(*) AS n
+        FROM rl_field_changelog
+        WHERE changed_by = %s::text
+          AND changed_at > now() - interval '30 days'
+          AND change_source = 'human'
+        GROUP BY module, record_id, field_name
+        HAVING COUNT(*) >= 3
+        ORDER BY n DESC
+        LIMIT 5
+        """,
+        (str(user_id),),
+    ) or []
+
+    for r in repeats:
+        agent_writes = db.fetchone(
+            """
+            SELECT COUNT(*) AS n FROM rl_field_changelog
+            WHERE module = %s AND record_id = %s AND field_name = %s
+              AND change_source LIKE 'agent%%'
+            """,
+            (r["module"], int(r["record_id"]), r["field_name"]),
+        ) or {"n": 0}
+        if (agent_writes.get("n") or 0) < 1:
+            continue
+        pk_col, name_col = _MODULE_PK_NAME.get(r["module"], (None, None))
+        rec_name: Optional[str] = None
+        if pk_col and name_col:
+            row = db.fetchone(
+                f"SELECT {name_col} AS n FROM {r['module']} "
+                f"WHERE {pk_col} = %s AND deleted = false",
+                (int(r["record_id"]),),
+            )
+            rec_name = (row or {}).get("n")
+        hints.append({
+            "severity": "medium",
+            "signal": "repeated_field_correction",
+            "module": r["module"],
+            "record_id": int(r["record_id"]),
+            "record_name": rec_name,
+            "hint": (
+                f"『{r['field_name']}』你改了 {r['n']} 次 — "
+                f"下次我会保留你的写法，建议点进去确认分类标准"
+            ),
+            "payload": {
+                "field_name": r["field_name"],
+                "correction_count": int(r["n"]),
+            },
+        })
+
+    # Stage-regression ------------------------------------------------------
+    # Most recent milestone change in the last N days where the new
+    # milestone appears earlier in the picklist than the old — i.e. the
+    # deal moved backward in the funnel. Going *to* a terminal (won/lost)
+    # is NOT a regression even if its picklist position is later.
+    #
+    # Index map comes from the live module_fields.options string (see
+    # _milestone_sort_index) so any picklist reorder by admin propagates
+    # without a code change. Empty map (no field row / no options) →
+    # silently skip regression scan.
+    #
+    # Idempotency: one hint per (user, deal). We pick the latest
+    # regression per deal so a deal that regressed twice doesn't
+    # double-fire. Comparison happens in Python because the index map
+    # lives outside the DB.
+    sort_index = _milestone_sort_index(db)
+    if sort_index:
+        raw_regressions = db.fetchall(
+            """
+            WITH user_deal_milestone_changes AS (
+                SELECT
+                    p.potentials_id AS id,
+                    p.potentials_name AS name,
+                    c.old_value, c.new_value, c.updated_at,
+                    ROW_NUMBER() OVER (
+                        PARTITION BY p.potentials_id
+                        ORDER BY c.updated_at DESC
+                    ) AS rn
+                  FROM changelog c
+                  JOIN collections m ON m.id = c.module_id
+                  JOIN potentials  p ON p.potentials_id = c.data_id
+                 WHERE m.name = 'potentials'
+                   AND c.field_name = 'milestone'
+                   AND c.updated_at > now() - make_interval(days => %s)
+                   AND p.owner_by = %s
+                   AND p.deleted = false
+                   AND c.new_value <> ALL(%s)
+            )
+            SELECT * FROM user_deal_milestone_changes WHERE rn = 1
+             LIMIT %s
+            """,
+            (
+                _REGRESSION_WINDOW_DAYS,
+                int(user_id),
+                list(TERMINAL_MILESTONES),
+                _SCAN_RECORD_LIMIT,
+            ),
+        ) or []
+        for r in raw_regressions:
+            old_idx = sort_index.get(r.get("old_value") or "")
+            new_idx = sort_index.get(r.get("new_value") or "")
+            if old_idx is None or new_idx is None:
+                continue  # unknown stage (legacy free-text) — skip silently
+            if new_idx >= old_idx:
+                continue  # not a regression
+            hints.append({
+                "severity": "high",
+                "signal": "stage_regression",
+                "module": "potentials",
+                "record_id": int(r["id"]),
+                "record_name": r.get("name"),
+                "hint": (
+                    f"阶段倒退：从『{r['old_value']}』"
+                    f"回到『{r['new_value']}』，"
+                    f"客户可能在动摇，建议主动了解原因"
+                ),
+                "payload": {
+                    "from_milestone": r["old_value"],
+                    "to_milestone":   r["new_value"],
+                    "regressed_at":   r["updated_at"].isoformat()
+                                      if r.get("updated_at") else None,
+                },
+            })
+
+    return hints
+
+
+def active_user_ids(db: DbWrapper, days: int = 7) -> List[int]:
+    """Return users who touched a CRM record in the window. Scan input
+    for Celery beat so we don't waste cycles on inactive accounts."""
+    # Drive-by fix: this used to read ``interval '%s days'`` which
+    # psycopg silently leaves un-substituted (the ``%s`` is inside a
+    # string literal). PG then parses ``'%s days'`` as ``'1 day'``, so
+    # the function was effectively returning "users active in the last
+    # *1* day" regardless of the ``days`` arg. ``make_interval`` takes
+    # a real bind param.
+    rows = db.fetchall(
+        """
+        SELECT DISTINCT owner_by::int AS uid
+        FROM (
+            SELECT owner_by FROM potentials
+             WHERE deleted = false AND updated_at > now() - make_interval(days => %s)
+            UNION
+            SELECT owner_by FROM leads
+             WHERE deleted = false AND updated_at > now() - make_interval(days => %s)
+            UNION
+            SELECT owner_by FROM accounts
+             WHERE deleted = false AND updated_at > now() - make_interval(days => %s)
+        ) t
+        WHERE owner_by IS NOT NULL
+        """,
+        (int(days), int(days), int(days)),
+    ) or []
+    return [r["uid"] for r in rows if r.get("uid") is not None]
diff --git a/crm/insights/scanners/contacts.py b/crm/insights/scanners/contacts.py
new file mode 100644
index 0000000000..00d31cda4d
--- /dev/null
+++ b/crm/insights/scanners/contacts.py
@@ -0,0 +1,219 @@
+"""联系人 (contacts) record-insight scanner.
+
+Opening a contact, a salesperson wants:
+
+    1. 这个人在哪家客户？最近断联没有？
+    2. 关联哪些在谈商机？卡住了吗？
+    3. 联系方式够不够触达？
+
+The ``contacts`` table is thin (no role / decision-level field today),
+so this scanner leans on interactions + linked potentials instead of
+contact-level fields.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+from . import RecordInsight, empty
+
+_ACTIVE_MILESTONES = {
+    "qualified", "proposal", "negotiation", "verbal",
+    "意向", "方案", "谈判", "口头确认", "商务",
+}
+_CONTACT_SILENCE_DAYS = 30
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT c.contacts_id AS id, c.contacts_name AS name,
+               c.mobile, c.email, c.phone,
+               a.accounts_name AS account_name,
+               a.accounts_id  AS account_id
+          FROM contacts c
+          LEFT JOIN accounts a ON a.accounts_id = c.accounts_id
+         WHERE c.contacts_id = %s AND c.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("contacts", record_id)
+
+    name = row.get("name")
+    account_name = row.get("account_name")
+    has_email = bool(row.get("email"))
+    has_phone = bool(row.get("mobile") or row.get("phone"))
+
+    # Silence
+    last = db.fetchone(
+        """
+        SELECT kind, EXTRACT(EPOCH FROM (now() - occurred_at))/86400.0 AS days_ago
+          FROM interactions
+         WHERE subjects @> jsonb_build_array(
+                 jsonb_build_object('module', 'contacts', 'id', %s)
+               )
+         ORDER BY occurred_at DESC
+         LIMIT 1
+        """,
+        (int(record_id),),
+    )
+    days_ago = (last or {}).get("days_ago")
+    last_kind = (last or {}).get("kind")
+
+    # Linked active deals
+    deals = db.fetchall(
+        """
+        SELECT potentials_name AS name, milestone,
+               EXTRACT(EPOCH FROM (now() - updated_at))/86400.0 AS stage_days
+          FROM potentials
+         WHERE contacts_id = %s AND deleted = false
+           AND (milestone IS NULL OR lower(milestone) NOT IN ('成交','won','closed won','丢失','lost','closed lost'))
+        """,
+        (int(record_id),),
+    ) or []
+    active_deals = [
+        d for d in deals
+        if (d.get("milestone") or "").strip().lower() in _ACTIVE_MILESTONES
+    ]
+    stalled = [d for d in active_deals if (d.get("stage_days") or 0) > 14]
+
+    # -------- summary --------
+    parts: List[str] = []
+    if account_name:
+        parts.append(f"{account_name} 的联系人")
+    if active_deals:
+        parts.append(f"关联 {len(active_deals)} 单在谈商机")
+    if days_ago is not None:
+        if days_ago < 1:
+            parts.append("今天有过互动")
+        else:
+            tag = f"（{last_kind}）" if last_kind else ""
+            parts.append(f"最近互动 {int(days_ago)} 天前{tag}")
+    else:
+        parts.append("尚无互动记录")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if not has_email and not has_phone:
+        hints.append({
+            "severity": "high",
+            "signal": "contact_channels_missing",
+            "module": "contacts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "邮箱和电话都没填 — 先补齐一个触达渠道",
+        })
+    elif not has_email:
+        hints.append({
+            "severity": "low",
+            "signal": "email_missing",
+            "module": "contacts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "邮箱没填 — 方案 / 报价类沟通会不方便，建议补一下",
+        })
+
+    if active_deals and days_ago is not None and days_ago > _CONTACT_SILENCE_DAYS:
+        hints.append({
+            "severity": "high",
+            "signal": "silence_with_active_deal",
+            "module": "contacts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"关联 {len(active_deals)} 单在谈但已 {int(days_ago)} 天没互动 — "
+                f"建议马上起一次重联，别丢单"
+            ),
+        })
+    elif days_ago is not None and days_ago > 60:
+        hints.append({
+            "severity": "medium",
+            "signal": "contact_silence",
+            "module": "contacts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已 {int(days_ago)} 天没互动 — 可以起一次轻量问候保持关系"
+            ),
+        })
+
+    if active_deals and len(stalled) == len(active_deals):
+        hints.append({
+            "severity": "medium",
+            "signal": "linked_deals_stalled",
+            "module": "contacts",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"关联的 {len(active_deals)} 单全部 >14 天没推进 — "
+                f"从人这边入手做一次推动"
+            ),
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions ----------------------------------
+    # Charter §定律 5: derive from this contact's signals first,
+    # top up with defaults.
+    who = name or "这位联系人"
+    SIGNAL_Q = {
+        "contact_channels_missing": (
+            f"提醒下次接触 {who} 时把邮箱 / 手机补全", "draft"),
+        "email_missing": (
+            f"如何通过其他渠道(微信 / 电话)拿到 {who} 的邮箱", "draft"),
+        "silence_with_active_deal": (
+            f"帮我起一封紧急跟进邮件给 {who},商机正在推进", "draft"),
+        "contact_silence": (
+            f"帮我起一封重联邮件给 {who}", "draft"),
+        "linked_deals_stalled": (
+            f"从 {who} 这边入手,推动卡住的商机", "analyst"),
+    }
+    questions: List[Dict[str, Any]] = []
+    seen: set = set()
+    for h in hints:
+        sig = h.get("signal")
+        if sig in SIGNAL_Q and sig not in seen:
+            text, agent = SIGNAL_Q[sig]
+            questions.append({"text": text, "agent": agent})
+            seen.add(sig)
+
+    defaults: List[Dict[str, Any]] = []
+    if active_deals:
+        defaults.append({
+            "text": f"盘点 {who} 关联的商机状态和下一步", "agent": "analyst",
+        })
+    if account_name:
+        defaults.append({
+            "text": f"查一下 {who} 在 {account_name} 的角色和决策权",
+            "agent": "research",
+        })
+    else:
+        defaults.append({
+            "text": f"查 {who} 的公开背景", "agent": "research",
+        })
+    defaults.append({
+        "text": f"帮我起一封重联邮件给 {who}", "agent": "draft",
+    })
+    for q in defaults:
+        if len(questions) >= 3:
+            break
+        if q["text"] in {x["text"] for x in questions}:
+            continue
+        questions.append(q)
+
+    return {
+        "has_data": True,
+        "module": "contacts",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/leads.py b/crm/insights/scanners/leads.py
new file mode 100644
index 0000000000..af8d0a1343
--- /dev/null
+++ b/crm/insights/scanners/leads.py
@@ -0,0 +1,230 @@
+"""线索 (leads) record-insight scanner.
+
+What a salesperson wants to know when opening a lead:
+
+    1. 值不值得花时间？来源是什么？资料全不全？
+    2. 创建多久了？有没有人打过？
+    3. 该转商机还是该放弃？
+
+Different from ``potentials`` — leads are pre-qualification, so silence
+thresholds are shorter, and the dominant question is "convert or cut"
+rather than "推进到下一阶段".
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.constants import TERMINAL_LEAD_CONVERT_STATUSES
+
+from . import RecordInsight, empty
+
+# Leads that haven't been touched in this many days while still open are
+# basically dead — flag high.
+_COLD_DAYS = 10
+# First contact should happen within this window after creation.
+_FIRST_TOUCH_SLA_DAYS = 3
+# 单一来源:hermes.crm.constants。``converted`` / ``failed`` 是 leads 漏斗
+# 的两条出口,scanner 看到任何一档就停止推进建议。中文 ``已转化`` /
+# ``已转商机`` 是历史遗留兼容,新 seed 不会出现。
+_TERMINAL_CONVERT_STATUSES = set(TERMINAL_LEAD_CONVERT_STATUSES)
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id  # reserved
+
+    row = db.fetchone(
+        """
+        SELECT leads_id AS id, leads_name AS name,
+               phone, mobile, email,
+               status, source,
+               convertedstatus,
+               created_at,
+               EXTRACT(EPOCH FROM (now() - created_at))/86400.0 AS age_days
+          FROM leads
+         WHERE leads_id = %s AND deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("leads", record_id)
+
+    # 终态线索:scanner 不再推进建议 —— 转化成功的去看商机,
+    # 转化失败的尊重 admin 的判定。
+    _cs = (row.get("convertedstatus") or "").lower()
+    if _cs in _TERMINAL_CONVERT_STATUSES:
+        if _cs == "failed":
+            summary = "此线索已被标记为转化失败,不再推进。"
+        else:
+            summary = "此线索已转化,详情去对应商机里看。"
+        return {
+            "has_data": True,
+            "module": "leads",
+            "record_id": record_id,
+            "summary": summary,
+            "hints": [],
+            "suggested_questions": [],
+        }
+
+    age = row.get("age_days") or 0
+    last = db.fetchone(
+        """
+        SELECT kind, EXTRACT(EPOCH FROM (now() - occurred_at))/86400.0 AS days_ago
+          FROM interactions
+         WHERE subjects @> jsonb_build_array(
+                 jsonb_build_object('module', 'leads', 'id', %s)
+               )
+         ORDER BY occurred_at DESC
+         LIMIT 1
+        """,
+        (int(record_id),),
+    )
+    days_ago = (last or {}).get("days_ago")
+    last_kind = (last or {}).get("kind")
+
+    has_phone = bool(row.get("phone") or row.get("mobile"))
+    has_email = bool(row.get("email"))
+    name = row.get("name")
+    source = row.get("source")
+    status = row.get("status")
+
+    # -------- summary --------
+    parts: List[str] = []
+    if source:
+        parts.append(f"来源 {source}")
+    if status:
+        parts.append(f"状态 {status}")
+    if age >= 1:
+        parts.append(f"创建于 {int(age)} 天前")
+    if days_ago is not None:
+        tag = f"（{last_kind}）" if last_kind else ""
+        parts.append(f"最近互动 {int(days_ago)} 天前{tag}")
+    elif age >= 1:
+        parts.append("尚未接触过")
+    summary = ("线索：" + "，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if not has_phone and not has_email:
+        hints.append({
+            "severity": "high",
+            "signal": "contact_missing",
+            "module": "leads",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "手机 / 邮箱都没填 — 先把联系方式补齐，否则后续没法触达",
+        })
+
+    if days_ago is None and age > _FIRST_TOUCH_SLA_DAYS:
+        hints.append({
+            "severity": "high",
+            "signal": "no_first_touch",
+            "module": "leads",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已创建 {int(age)} 天还没人碰 — "
+                f"我可以帮你起一条首次外呼脚本或开场邮件"
+            ),
+        })
+    elif days_ago is not None and days_ago > _COLD_DAYS:
+        hints.append({
+            "severity": "medium",
+            "signal": "lead_cold",
+            "module": "leads",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已 {int(days_ago)} 天没动 — 要么重启触达，要么标记为不跟进，"
+                f"别让它挂着拖低转化率"
+            ),
+        })
+
+    # Hot-ish lead — has contact info + 2+ interactions already. Nudge
+    # toward conversion.
+    if has_phone or has_email:
+        n_rows = db.fetchone(
+            """
+            SELECT COUNT(*) AS n
+              FROM interactions
+             WHERE subjects @> jsonb_build_array(
+                     jsonb_build_object('module', 'leads', 'id', %s)
+                   )
+            """,
+            (int(record_id),),
+        )
+        n = int((n_rows or {}).get("n") or 0)
+        if n >= 2:
+            hints.append({
+                "severity": "low",
+                "signal": "convert_candidate",
+                "module": "leads",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"已互动 {n} 次，资料齐 — 可以评估是否直接转商机了"
+                ),
+            })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions ----------------------------------
+    nm = name or "这条线索"
+    SIGNAL_Q = {
+        "contact_missing": (
+            f"如何拿到 {nm} 的联系方式(电话 / 邮箱 / 微信)", "research"),
+        "no_first_touch": (
+            f"帮我起一条给 {nm} 的首次外呼开场白", "draft"),
+        "lead_cold": (
+            f"帮我拟一封重启触达的邮件给 {nm}", "draft"),
+        "convert_candidate": (
+            f"评估 {nm} 是否值得转成商机,出一份理由清单", "analyst"),
+    }
+    questions: List[Dict[str, Any]] = []
+    seen: set = set()
+    for h in hints:
+        sig = h.get("signal")
+        if sig in SIGNAL_Q and sig not in seen:
+            text, agent = SIGNAL_Q[sig]
+            questions.append({"text": text, "agent": agent})
+            seen.add(sig)
+
+    # Defaults cover 3 distinct intents (outreach / qualification /
+    # intel) so we don't accidentally produce a near-duplicate of a
+    # signal-driven question (e.g. convert_candidate already gives an
+    # "评估转商机" question, the default takes a different angle).
+    defaults: List[Dict[str, Any]] = []
+    if days_ago is None:
+        defaults.append({
+            "text": f"帮我起一条给 {nm} 的首次外呼开场白", "agent": "draft",
+        })
+    else:
+        defaults.append({
+            "text": f"帮我拟一封重启触达的邮件给 {nm}", "agent": "draft",
+        })
+    defaults.append({
+        "text": f"查 {nm} 的公司背景和决策链",  # research, not "评估转商机"
+        "agent": "research",
+    })
+    defaults.append({
+        "text": f"找找同公司的历史线索或客户记录",
+        "agent": "research",
+    })
+    for q in defaults:
+        if len(questions) >= 3:
+            break
+        if q["text"] in {x["text"] for x in questions}:
+            continue
+        questions.append(q)
+
+    return {
+        "has_data": True,
+        "module": "leads",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/payments.py b/crm/insights/scanners/payments.py
new file mode 100644
index 0000000000..6b23e981e3
--- /dev/null
+++ b/crm/insights/scanners/payments.py
@@ -0,0 +1,178 @@
+"""收款 (payments) record-insight scanner.
+
+A payment record is almost always terminal (money has arrived). The
+interesting questions are:
+
+    1. 对不对得上应收？金额匹配吗？
+    2. 客户还有别的未收款项吗？
+    3. 这是不是一个交叉销售的契机？
+"""
+from __future__ import annotations
+
+import json
+from datetime import date
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+from . import RecordInsight, empty
+
+
+def _amount_from_jsonb(val: Any) -> Optional[float]:
+    if val is None:
+        return None
+    if isinstance(val, str):
+        try:
+            val = json.loads(val)
+        except Exception:
+            return None
+    if isinstance(val, (int, float)):
+        return float(val) if val else None
+    if isinstance(val, dict):
+        for v in val.values():
+            if isinstance(v, (int, float)) and v:
+                return float(v)
+    return None
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.1f}万"
+    return f"¥{n:.0f}"
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT p.payments_id AS id, p.payments_name AS name,
+               p.paydate, p.payamount, p.remark,
+               r.receivables_id, r.dueamount AS receivable_due,
+               r.duedate AS receivable_duedate,
+               r.receivablesstatus AS receivable_status,
+               a.accounts_name AS account_name,
+               s.salesorders_name AS order_name
+          FROM payments p
+          LEFT JOIN receivables r ON r.receivables_id = p.receivables_id
+          LEFT JOIN accounts a    ON a.accounts_id = r.accounts_id
+          LEFT JOIN salesorders s ON s.salesorders_id = r.salesorders_id
+         WHERE p.payments_id = %s AND p.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("payments", record_id)
+
+    name = row.get("name")
+    pay_amount = _amount_from_jsonb(row.get("payamount"))
+    due_amount = _amount_from_jsonb(row.get("receivable_due"))
+    paydate = row.get("paydate")
+
+    # Pull account-level rollup: any other outstanding receivables?
+    other_open = db.fetchone(
+        """
+        SELECT count(*)::int AS n,
+               COALESCE(SUM(CASE WHEN duedate < CURRENT_DATE THEN 1 ELSE 0 END), 0)::int AS n_overdue
+          FROM receivables r
+          JOIN payments p ON p.receivables_id = %s
+         WHERE r.accounts_id = (SELECT accounts_id FROM receivables WHERE receivables_id = p.receivables_id)
+           AND r.receivablesstatus != 'paid'
+           AND r.deleted = false
+        """,
+        (int(record_id),),
+    ) or {"n": 0, "n_overdue": 0}
+    n_open = int(other_open.get("n") or 0)
+    n_overdue = int(other_open.get("n_overdue") or 0)
+
+    # -------- summary --------
+    parts: List[str] = []
+    amt = _fmt_amount(pay_amount)
+    if amt:
+        parts.append(f"收到 {amt}")
+    else:
+        parts.append("收款记录")
+    if isinstance(paydate, date):
+        parts.append(f"到账日 {paydate.isoformat()}")
+    if row.get("account_name"):
+        parts.append(f"客户 {row['account_name']}")
+    if row.get("order_name"):
+        parts.append(f"订单 {row['order_name']}")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if pay_amount and due_amount:
+        if pay_amount < due_amount * 0.95:
+            short = due_amount - pay_amount
+            hints.append({
+                "severity": "medium",
+                "signal": "payment_short",
+                "module": "payments",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"到账金额比应收少 {_fmt_amount(short)} — "
+                    f"核对银行凭证和发票是否匹配，必要时和客户确认"
+                ),
+            })
+        elif pay_amount > due_amount * 1.05:
+            over = pay_amount - due_amount
+            hints.append({
+                "severity": "low",
+                "signal": "payment_over",
+                "module": "payments",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"到账金额超出应收 {_fmt_amount(over)} — "
+                    f"确认是否混入了其他单子的款项"
+                ),
+            })
+
+    if n_overdue > 0:
+        hints.append({
+            "severity": "high",
+            "signal": "account_other_overdue",
+            "module": "payments",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"该客户还有 {n_overdue} 笔逾期应收未收回 — "
+                f"趁这次到账的契机顺势推一下"
+            ),
+        })
+    elif n_open > 0:
+        hints.append({
+            "severity": "low",
+            "signal": "account_other_open",
+            "module": "payments",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": f"该客户还有 {n_open} 笔未结清应收 — 保持节奏即可",
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions --------
+    who = row.get("account_name") or "客户"
+    questions: List[Dict[str, Any]] = [
+        {"text": f"帮我起一封致谢 + 确认到账的邮件给 {who}", "agent": "draft"},
+        {"text": "这笔收款对应的订单和应收记录完整吗？", "agent": "analyst"},
+        {"text": f"盘点 {who} 的后续销售机会", "agent": "research"},
+    ]
+
+    return {
+        "has_data": True,
+        "module": "payments",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/potentials.py b/crm/insights/scanners/potentials.py
new file mode 100644
index 0000000000..bab0989380
--- /dev/null
+++ b/crm/insights/scanners/potentials.py
@@ -0,0 +1,230 @@
+"""商机 (potentials) record-insight scanner.
+
+What a salesperson wants to know at a glance when they open a deal:
+
+    1. 这单多大，卡在哪个阶段？
+    2. 多久没动？最近一次互动是什么？
+    3. 下一步谁做？有什么风险？
+
+That drives the three output channels:
+
+- **summary**  : one factual sentence the human can scan in < 1 s.
+- **hints**    : Coach-style warnings with an action verb (定律 5).
+- **suggested_questions** : verb-led quick prompts the human can click.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.constants import TERMINAL_MILESTONES
+
+from . import RecordInsight, empty
+
+# Stages we treat as "live pipeline" — silence in these is a red flag.
+_ACTIVE_MILESTONES = {
+    "qualified", "proposal", "negotiation", "verbal",
+    "意向", "方案", "谈判", "口头确认", "商务",
+}
+# Stages where the deal has effectively ended. 单一来源:
+# hermes.crm.constants.TERMINAL_MILESTONES。其它 ``closed won`` / ``成交``
+# 等字面量是早期兼容,现已废止(seed 强制 won/lost,system_options 锁定)。
+_TERMINAL_MILESTONES = set(TERMINAL_MILESTONES)
+
+_SILENCE_WARN_DAYS = 7
+_SILENCE_HIGH_DAYS = 14
+_STAGE_STUCK_DAYS = 14
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.0f}万"
+    return f"¥{n:.0f}"
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    """Scan a single potential. ``user_id`` is accepted for future
+    per-user gating (e.g. "don't surface hints on deals you don't own")
+    but currently not used — a salesperson covering a teammate's deal
+    still needs the same insights."""
+    _ = user_id  # reserved
+
+    row = db.fetchone(
+        """
+        SELECT p.potentials_id AS id,
+               p.potentials_name AS name,
+               p.amount,
+               p.milestone,
+               p.expected_close_date,
+               p.updated_at,
+               a.accounts_name AS account_name,
+               c.contacts_name AS contact_name
+          FROM potentials p
+          LEFT JOIN accounts a ON a.accounts_id = p.accounts_id
+          LEFT JOIN contacts c ON c.contacts_id = p.contacts_id
+         WHERE p.potentials_id = %s AND p.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("potentials", record_id)
+
+    milestone = (row.get("milestone") or "").strip()
+    ms_l = milestone.lower()
+    is_active = ms_l in _ACTIVE_MILESTONES
+    is_terminal = ms_l in _TERMINAL_MILESTONES
+
+    # Most-recent interaction on this deal.
+    last = db.fetchone(
+        """
+        SELECT kind, occurred_at,
+               EXTRACT(EPOCH FROM (now() - occurred_at)) / 86400.0 AS days_ago
+          FROM interactions
+         WHERE subjects @> jsonb_build_array(
+                 jsonb_build_object('module', 'potentials', 'id', %s)
+               )
+         ORDER BY occurred_at DESC
+         LIMIT 1
+        """,
+        (int(record_id),),
+    )
+    days_ago = (last or {}).get("days_ago")
+    last_kind = (last or {}).get("kind")
+
+    # Days since stage last changed (using updated_at as a proxy — we don't
+    # have a dedicated milestone-change log yet; good enough for v1).
+    stage_days = None
+    if row.get("updated_at"):
+        r2 = db.fetchone(
+            "SELECT EXTRACT(EPOCH FROM (now() - %s))/86400.0 AS d",
+            (row["updated_at"],),
+        )
+        stage_days = (r2 or {}).get("d")
+
+    # -------- summary --------
+    parts: List[str] = []
+    amt = _fmt_amount(row.get("amount"))
+    if amt:
+        parts.append(f"{amt} 商机")
+    else:
+        parts.append("商机")
+    if milestone:
+        parts.append(f"当前 {milestone} 阶段")
+    if days_ago is not None:
+        if days_ago < 1:
+            parts.append("今天有过互动")
+        else:
+            tag = f"（{last_kind}）" if last_kind else ""
+            parts.append(f"最近互动 {int(days_ago)} 天前{tag}")
+    else:
+        parts.append("尚无互动记录")
+    summary = "，".join(parts) + "。"
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+    name = row.get("name")
+
+    if is_active and days_ago is not None and days_ago > _SILENCE_WARN_DAYS:
+        sev = "high" if days_ago > _SILENCE_HIGH_DAYS else "medium"
+        hints.append({
+            "severity": sev,
+            "signal": "pipeline_silence",
+            "module": "potentials",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已 {int(days_ago)} 天没联系 — "
+                f"我可以帮你起一封针对 {milestone} 阶段的跟进邮件"
+            ),
+        })
+
+    if is_active and stage_days is not None and stage_days > _STAGE_STUCK_DAYS:
+        hints.append({
+            "severity": "medium",
+            "signal": "stage_stuck",
+            "module": "potentials",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"在 {milestone} 阶段已 {int(stage_days)} 天未推进 — "
+                f"建议盘点卡点，或下调赢率预期"
+            ),
+        })
+
+    if not row.get("amount") and not is_terminal:
+        hints.append({
+            "severity": "low",
+            "signal": "amount_missing",
+            "module": "potentials",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "金额未填 — 团队 forecast / 周报统计看不到这单的体量",
+        })
+
+    # NOTE: ``missing_next_action`` was considered here but the ``tasks``
+    # schema currently has no ``potentials_id`` FK — only accounts / contacts
+    # scoped. Cross-joining via the deal's account/contact would over-report
+    # (other-deal tasks would satisfy it). Deferred to Phase 2 when tasks
+    # grow an explicit deal link or we scan interactions for "next action"
+    # verbs instead.
+
+    # Cap hints: highest severity first, max 3.
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions (动词开头) -----------------------
+    # Charter §定律 5: derive from this deal's signals first.
+    who = row.get("contact_name") or row.get("account_name") or "客户"
+    SIGNAL_Q = {
+        "pipeline_silence": (
+            f"帮我拟一封紧迫跟进邮件给 {who},解释当前阶段的下一步",
+            "draft",
+        ),
+        "stage_stuck": (
+            f"分析这单卡在当前阶段的可能原因,给我推动建议",
+            "analyst",
+        ),
+        "amount_missing": (
+            f"如何向 {who} 探询预算金额,起一段委婉的话术",
+            "draft",
+        ),
+    }
+    questions: List[Dict[str, Any]] = []
+    seen: set = set()
+    for h in hints:
+        sig = h.get("signal")
+        if sig in SIGNAL_Q and sig not in seen:
+            text, agent = SIGNAL_Q[sig]
+            questions.append({"text": text, "agent": agent})
+            seen.add(sig)
+
+    defaults: List[Dict[str, Any]] = [
+        {"text": f"帮我拟一封跟进邮件给 {who}",        "agent": "draft"},
+        {"text": "盘点这单目前的卡点和下一步建议",       "agent": "analyst"},
+    ]
+    if row.get("account_name"):
+        defaults.append({
+            "text": f"对比 {row['account_name']} 的历史商机,这单赢率如何?",
+            "agent": "research",
+        })
+    for q in defaults:
+        if len(questions) >= 3:
+            break
+        if q["text"] in {x["text"] for x in questions}:
+            continue
+        questions.append(q)
+
+    return {
+        "has_data": True,
+        "module": "potentials",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
+
+
diff --git a/crm/insights/scanners/products.py b/crm/insights/scanners/products.py
new file mode 100644
index 0000000000..c0c2d11366
--- /dev/null
+++ b/crm/insights/scanners/products.py
@@ -0,0 +1,171 @@
+"""产品 (products) record-insight scanner.
+
+A product is more of a *catalog entry* than a workflow — but "no Copilot"
+would violate charter 定律 5 (AI 驾驶). When a salesperson opens a
+product record the useful questions are commercial, not operational:
+
+    1. 最近在哪些报价 / 订单里被选用？热度如何？
+    2. 毛利空间 (price vs cost_price) 还行吗？
+    3. 库存低于安全线了吗？
+    4. 资料齐全可对客户讲了吗？(description / specifications)
+
+So the scanner does a cheap rollup over ``quotes_products`` and
+``salesorders_products`` plus a field-completeness check. No workflow
+state machine, no expiry — just the "health card" for the SKU.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+from . import RecordInsight, empty
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.1f}万"
+    return f"¥{n:.0f}"
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT products_id AS id, products_name AS name,
+               catalog, status, price, cost_price,
+               reference_price, stock, safe_stock,
+               description, specifications, model
+          FROM products
+         WHERE products_id = %s AND deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("products", record_id)
+
+    name = row.get("name")
+    status = (row.get("status") or "").strip()
+    price = float(row.get("price") or 0)
+    cost = float(row.get("cost_price") or 0)
+    stock = int(row.get("stock") or 0)
+    safe_stock = int(row.get("safe_stock") or 0)
+
+    # Usage rollup — how much action is this SKU actually seeing?
+    usage = db.fetchone(
+        """
+        SELECT
+          (SELECT count(*) FROM quotes_products qp
+             JOIN quotes q ON q.quotes_id = qp.quotes_id
+            WHERE qp.products_id = %s AND q.deleted = false) AS n_quotes,
+          (SELECT count(*) FROM salesorders_products sp
+             JOIN salesorders s ON s.salesorders_id = sp.salesorders_id
+            WHERE sp.products_id = %s AND s.deleted = false) AS n_orders
+        """,
+        (int(record_id), int(record_id)),
+    ) or {"n_quotes": 0, "n_orders": 0}
+    n_quotes = int(usage.get("n_quotes") or 0)
+    n_orders = int(usage.get("n_orders") or 0)
+
+    # -------- summary --------
+    parts: List[str] = []
+    parts.append(f"{row.get('catalog') or '产品'}")
+    if price:
+        parts.append(f"定价 {_fmt_amount(price)}")
+    if status:
+        parts.append(f"状态 {status}")
+    if n_quotes or n_orders:
+        parts.append(f"被 {n_quotes} 份报价 / {n_orders} 张订单引用")
+    else:
+        parts.append("暂未被引用")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    # Commercial health: margin.
+    if price and cost and cost > 0:
+        margin = (price - cost) / price
+        if margin < 0.1:
+            hints.append({
+                "severity": "high",
+                "signal": "product_margin_thin",
+                "module": "products",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"定价 {_fmt_amount(price)} 对成本 {_fmt_amount(cost)} "
+                    f"毛利仅 {margin*100:.0f}% — 建议复核定价或谈判折扣下限"
+                ),
+            })
+
+    # Operational: stock warning (only if safe_stock > 0 is tracked).
+    if safe_stock > 0 and stock < safe_stock:
+        hints.append({
+            "severity": "medium",
+            "signal": "product_stock_low",
+            "module": "products",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"库存 {stock} 低于安全线 {safe_stock} — "
+                f"提醒采购 / 运营补货，避免下单后交付拉胯"
+            ),
+        })
+
+    # Zero traction: catalog dead weight.
+    if n_quotes == 0 and n_orders == 0:
+        hints.append({
+            "severity": "low",
+            "signal": "product_no_traction",
+            "module": "products",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                "没进过任何报价或订单 — "
+                "要么还在冷启动，要么该下架让目录更干净"
+            ),
+        })
+
+    # Content completeness — salespeople can't pitch what isn't written.
+    missing = []
+    if not (row.get("description") or "").strip():
+        missing.append("产品介绍")
+    if not (row.get("specifications") or "").strip():
+        missing.append("规格")
+    if missing:
+        hints.append({
+            "severity": "low",
+            "signal": "product_info_missing",
+            "module": "products",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"{' / '.join(missing)} 未填 — "
+                f"销售现场讲解时会尴尬，建议尽快补齐"
+            ),
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions --------
+    questions: List[Dict[str, Any]] = [
+        {"text": f"盘点最近谁在询问「{name}」，有无转化机会",            "agent": "analyst"},
+        {"text": f"对比同类产品，「{name}」的差异化卖点和常见异议是什么？",  "agent": "research"},
+        {"text": f"帮我写一段给客户的「{name}」一句话推荐",                "agent": "draft"},
+    ]
+
+    return {
+        "has_data": True,
+        "module": "products",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/quotes.py b/crm/insights/scanners/quotes.py
new file mode 100644
index 0000000000..a9ff8629af
--- /dev/null
+++ b/crm/insights/scanners/quotes.py
@@ -0,0 +1,218 @@
+"""报价 (quotes) record-insight scanner.
+
+Quotes are short-lived documents — the questions a salesperson has when
+they open one:
+
+    1. 这个报价还在走什么状态？多久了？
+    2. 有效期到哪天？要过期了吗？
+    3. 金额填全了吗？
+    4. 客户看过 / 回复过没？
+
+``validity_end`` was added in migration 0019 so we can drive
+``expiring_soon`` / ``expired`` hints directly. When a tenant hasn't
+filled ``validity_end`` we fall back to the coarser ``quote_stale``
+signal (age > 14d with non-terminal status).
+"""
+from __future__ import annotations
+
+import json
+from datetime import date
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.constants import TERMINAL_QUOTE_STATUSES
+
+from . import RecordInsight, empty
+
+# 单一来源:常量从 hermes.crm.constants 来,seed_metadata 把同一组值标了
+# system_options,UI 和 backend 都拒绝改动。scanner 在 lower-case 比较前
+# 就过 set,移除历史的中文/旧名兼容(``closed``、``已接受`` 之类) ——
+# 那些值在新 seed 里不会出现,旧数据如果有再补到 constants 里。
+_TERMINAL_STATUS = set(TERMINAL_QUOTE_STATUSES)
+_QUOTE_STALE_DAYS = 14
+_EXPIRING_SOON_DAYS = 7  # validity_end within this many days → warn
+
+
+def _amount_from_jsonb(val: Any) -> Optional[float]:
+    """``final_amount`` is stored as jsonb — shape varies by tenant
+    (e.g. ``{"CNY": 150000}`` or ``{"amount": 150000, "currency": "CNY"}``).
+    Return the first numeric value we can find, or None."""
+    if val is None:
+        return None
+    if isinstance(val, str):
+        try:
+            val = json.loads(val)
+        except Exception:
+            return None
+    if isinstance(val, (int, float)):
+        return float(val) if val else None
+    if isinstance(val, dict):
+        for v in val.values():
+            if isinstance(v, (int, float)) and v:
+                return float(v)
+    return None
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.0f}万"
+    return f"¥{n:.0f}"
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT q.quotes_id AS id, q.quotes_name AS name,
+               q.status, q.quotedate, q.final_amount,
+               q.validity_end,
+               q.created_at,
+               EXTRACT(EPOCH FROM (now() - q.created_at))/86400.0 AS age_days,
+               a.accounts_name AS account_name,
+               p.potentials_name AS deal_name
+          FROM quotes q
+          LEFT JOIN accounts a ON a.accounts_id = q.accounts_id
+          LEFT JOIN potentials p ON p.potentials_id = q.potentials_id
+         WHERE q.quotes_id = %s AND q.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("quotes", record_id)
+
+    name = row.get("name")
+    status = (row.get("status") or "").strip()
+    status_l = status.lower()
+    is_terminal = status_l in _TERMINAL_STATUS
+    age = float(row.get("age_days") or 0)
+    amount = _amount_from_jsonb(row.get("final_amount"))
+    amount_s = _fmt_amount(amount)
+    validity_end = row.get("validity_end")
+    days_to_expiry: Optional[int] = None
+    if isinstance(validity_end, date):
+        days_to_expiry = (validity_end - date.today()).days
+
+    # -------- summary --------
+    parts: List[str] = []
+    if amount_s:
+        parts.append(f"{amount_s} 报价")
+    else:
+        parts.append("报价")
+    if status:
+        parts.append(f"状态 {status}")
+    if row.get("account_name"):
+        parts.append(f"客户 {row['account_name']}")
+    if days_to_expiry is not None:
+        if days_to_expiry < 0:
+            parts.append(f"已过期 {-days_to_expiry} 天")
+        elif days_to_expiry == 0:
+            parts.append("今天过期")
+        else:
+            parts.append(f"还剩 {days_to_expiry} 天过期")
+    elif age >= 1:
+        parts.append(f"创建 {int(age)} 天")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    # Validity hints take priority over age-based quote_stale — they're
+    # more actionable (a real deadline, not a heuristic).
+    if days_to_expiry is not None and not is_terminal:
+        if days_to_expiry < 0:
+            hints.append({
+                "severity": "high",
+                "signal": "quote_expired",
+                "module": "quotes",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"有效期已过 {-days_to_expiry} 天 — "
+                    f"客户现在签也不生效，建议重发新报价或延期"
+                ),
+            })
+        elif days_to_expiry <= _EXPIRING_SOON_DAYS:
+            hints.append({
+                "severity": "high" if days_to_expiry <= 2 else "medium",
+                "signal": "quote_expiring_soon",
+                "module": "quotes",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"还剩 {days_to_expiry} 天就过期 — "
+                    f"我可以帮你起一封催签邮件或延期通知"
+                ),
+            })
+
+    if not amount:
+        hints.append({
+            "severity": "medium",
+            "signal": "quote_amount_missing",
+            "module": "quotes",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "最终金额未填 — 发给客户前务必补齐，否则没办法走下一步",
+        })
+
+    # quote_stale is a fallback for quotes without validity_end filled —
+    # skip it if we already have a validity-based hint queued.
+    already_has_validity_hint = any(
+        h["signal"] in ("quote_expired", "quote_expiring_soon") for h in hints
+    )
+    if not is_terminal and age > _QUOTE_STALE_DAYS and not already_has_validity_hint \
+            and days_to_expiry is None:
+        hints.append({
+            "severity": "high" if age > 30 else "medium",
+            "signal": "quote_stale",
+            "module": "quotes",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已 {int(age)} 天没有结论 — "
+                f"要么催促客户签署，要么标记失效，避免数据污染 pipeline"
+            ),
+        })
+
+    if not status and not is_terminal:
+        hints.append({
+            "severity": "low",
+            "signal": "quote_status_missing",
+            "module": "quotes",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "状态未填 — 建议至少标 draft / sent / accepted 之一",
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions --------
+    who = row.get("account_name") or "客户"
+    questions: List[Dict[str, Any]] = [
+        {"text": f"帮我起一封报价跟进邮件给 {who}", "agent": "draft"},
+        {"text": "核对这份报价的条款和折扣结构是否常规", "agent": "compliance"},
+    ]
+    if row.get("deal_name"):
+        questions.append({
+            "text": f"关联商机『{row['deal_name']}』的最新卡点是什么？",
+            "agent": "analyst",
+        })
+    else:
+        questions.append({
+            "text": f"查 {who} 对过往报价的反馈历史",
+            "agent": "research",
+        })
+
+    return {
+        "has_data": True,
+        "module": "quotes",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/receivables.py b/crm/insights/scanners/receivables.py
new file mode 100644
index 0000000000..aafeaeed00
--- /dev/null
+++ b/crm/insights/scanners/receivables.py
@@ -0,0 +1,173 @@
+"""应收 (receivables) record-insight scanner.
+
+On opening a receivable the rep / finance person wants to know:
+
+    1. 到没到期？逾期多久？
+    2. 还差多少钱没回来？
+    3. 要不要催一下客户？
+"""
+from __future__ import annotations
+
+import json
+from datetime import date
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+from . import RecordInsight, empty
+
+_PAID_STATUS = {"paid", "已付", "已收"}
+_OVERDUE_SOON_DAYS = 7
+
+
+def _amount_from_jsonb(val: Any) -> Optional[float]:
+    if val is None:
+        return None
+    if isinstance(val, str):
+        try:
+            val = json.loads(val)
+        except Exception:
+            return None
+    if isinstance(val, (int, float)):
+        return float(val) if val else None
+    if isinstance(val, dict):
+        for v in val.values():
+            if isinstance(v, (int, float)) and v:
+                return float(v)
+    return None
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.1f}万"
+    return f"¥{n:.0f}"
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT r.receivables_id AS id, r.receivables_name AS name,
+               r.receivablesstatus AS status, r.duedate, r.actualdate,
+               r.dueamount, r.balance,
+               a.accounts_name AS account_name,
+               s.salesorders_name AS order_name
+          FROM receivables r
+          LEFT JOIN accounts a    ON a.accounts_id = r.accounts_id
+          LEFT JOIN salesorders s ON s.salesorders_id = r.salesorders_id
+         WHERE r.receivables_id = %s AND r.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("receivables", record_id)
+
+    name = row.get("name")
+    status = (row.get("status") or "").strip()
+    is_paid = status.lower() in _PAID_STATUS
+    due_amount = _amount_from_jsonb(row.get("dueamount"))
+    balance = _amount_from_jsonb(row.get("balance"))
+    duedate = row.get("duedate")
+    days_to_due: Optional[int] = None
+    if isinstance(duedate, date):
+        days_to_due = (duedate - date.today()).days
+
+    # -------- summary --------
+    parts: List[str] = []
+    amt = _fmt_amount(due_amount)
+    if amt:
+        parts.append(f"{amt} 应收")
+    else:
+        parts.append("应收")
+    if status:
+        parts.append(f"状态 {status}")
+    if row.get("account_name"):
+        parts.append(f"客户 {row['account_name']}")
+    if is_paid:
+        parts.append("已结清")
+    elif days_to_due is not None:
+        if days_to_due < 0:
+            parts.append(f"已逾期 {-days_to_due} 天")
+        elif days_to_due == 0:
+            parts.append("今天到期")
+        else:
+            parts.append(f"还剩 {days_to_due} 天到期")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if not is_paid and days_to_due is not None:
+        if days_to_due < 0:
+            hints.append({
+                "severity": "high",
+                "signal": "receivable_overdue",
+                "module": "receivables",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"已逾期 {-days_to_due} 天未收回 — "
+                    f"建议立刻发催款函或电话，拖得越久回款风险越大"
+                ),
+            })
+        elif days_to_due <= _OVERDUE_SOON_DAYS:
+            hints.append({
+                "severity": "medium",
+                "signal": "receivable_due_soon",
+                "module": "receivables",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"还剩 {days_to_due} 天到期 — "
+                    f"提前一周提醒客户，避免到期被动催"
+                ),
+            })
+
+    if not is_paid and balance is not None and due_amount and balance < due_amount:
+        recovered = due_amount - balance
+        hints.append({
+            "severity": "low",
+            "signal": "receivable_partial",
+            "module": "receivables",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已部分收回 {_fmt_amount(recovered)}，"
+                f"余 {_fmt_amount(balance)} 未到账 — 跟踪剩余款项"
+            ),
+        })
+
+    if not status:
+        hints.append({
+            "severity": "low",
+            "signal": "receivable_status_missing",
+            "module": "receivables",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "状态未填 — 建议至少标 unpaid / partial / paid",
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions --------
+    who = row.get("account_name") or "客户"
+    questions: List[Dict[str, Any]] = [
+        {"text": f"帮我起一封给 {who} 的催款邮件（措辞克制）", "agent": "draft"},
+        {"text": "这笔应收的历史互动和回款记录能串一下吗？", "agent": "analyst"},
+        {"text": f"查 {who} 的历史回款习惯是否守时", "agent": "research"},
+    ]
+
+    return {
+        "has_data": True,
+        "module": "receivables",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/salesorders.py b/crm/insights/scanners/salesorders.py
new file mode 100644
index 0000000000..8e4ef9c418
--- /dev/null
+++ b/crm/insights/scanners/salesorders.py
@@ -0,0 +1,191 @@
+"""销售订单 (salesorders) record-insight scanner.
+
+When a rep opens an order the questions are:
+
+    1. 这单签了多久了？有没有卡在确认 / 发货环节？
+    2. 应收款回来了吗？进度如何？
+    3. 客户那边还有后续动作需要我推？
+"""
+from __future__ import annotations
+
+import json
+from datetime import date
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.constants import TERMINAL_SALESORDER_STATUSES
+
+from . import RecordInsight, empty
+
+# 单一来源:hermes.crm.constants(注意 seed 改成 ``completed`` 替代旧
+# ``closed``,中文 ``已交付`` 等遗留值在新数据里不会出现;system_options
+# 锁定后 admin 也不能改名 value)。
+_TERMINAL_STATUS = set(TERMINAL_SALESORDER_STATUSES)
+_SIGNED_BUT_NOT_INVOICED_DAYS = 10
+
+
+def _amount_from_jsonb(val: Any) -> Optional[float]:
+    if val is None:
+        return None
+    if isinstance(val, str):
+        try:
+            val = json.loads(val)
+        except Exception:
+            return None
+    if isinstance(val, (int, float)):
+        return float(val) if val else None
+    if isinstance(val, dict):
+        for v in val.values():
+            if isinstance(v, (int, float)) and v:
+                return float(v)
+    return None
+
+
+def _fmt_amount(n: Optional[float]) -> str:
+    if not n:
+        return ""
+    n = float(n)
+    if n >= 10000:
+        return f"¥{n / 10000:.0f}万"
+    return f"¥{n:.0f}"
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT s.salesorders_id AS id, s.salesorders_name AS name,
+               s.status, s.orderdate, s.final_amount,
+               s.created_at,
+               EXTRACT(EPOCH FROM (now() - s.created_at))/86400.0 AS age_days,
+               a.accounts_name AS account_name,
+               p.potentials_name AS deal_name
+          FROM salesorders s
+          LEFT JOIN accounts a ON a.accounts_id = s.accounts_id
+          LEFT JOIN potentials p ON p.potentials_id = s.potentials_id
+         WHERE s.salesorders_id = %s AND s.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("salesorders", record_id)
+
+    name = row.get("name")
+    status = (row.get("status") or "").strip()
+    status_l = status.lower()
+    is_terminal = status_l in _TERMINAL_STATUS
+    age = float(row.get("age_days") or 0)
+    amount = _amount_from_jsonb(row.get("final_amount"))
+    amount_s = _fmt_amount(amount)
+
+    # Receivables / payments rollup — drives "回款缓慢" signal.
+    rec = db.fetchone(
+        """
+        SELECT count(*)::int AS n_total,
+               COALESCE(SUM(CASE WHEN receivablesstatus = 'paid' THEN 1 ELSE 0 END), 0)::int AS n_paid,
+               COALESCE(SUM(CASE WHEN receivablesstatus != 'paid'
+                                  AND duedate < CURRENT_DATE THEN 1 ELSE 0 END), 0)::int AS n_overdue
+          FROM receivables
+         WHERE salesorders_id = %s AND deleted = false
+        """,
+        (int(record_id),),
+    ) or {"n_total": 0, "n_paid": 0, "n_overdue": 0}
+    n_total = int(rec.get("n_total") or 0)
+    n_paid = int(rec.get("n_paid") or 0)
+    n_overdue = int(rec.get("n_overdue") or 0)
+
+    # -------- summary --------
+    parts: List[str] = []
+    if amount_s:
+        parts.append(f"{amount_s} 订单")
+    else:
+        parts.append("订单")
+    if status:
+        parts.append(f"状态 {status}")
+    if row.get("account_name"):
+        parts.append(f"客户 {row['account_name']}")
+    if n_total:
+        parts.append(f"应收 {n_paid}/{n_total} 已回款")
+    elif age >= 1:
+        parts.append(f"签约 {int(age)} 天")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if n_overdue > 0:
+        hints.append({
+            "severity": "high",
+            "signal": "order_receivable_overdue",
+            "module": "salesorders",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"有 {n_overdue} 笔应收已过到期日 — "
+                f"我可以帮你起一封催款邮件或安排电话"
+            ),
+        })
+
+    if not is_terminal and n_total == 0 and age > _SIGNED_BUT_NOT_INVOICED_DAYS:
+        hints.append({
+            "severity": "medium",
+            "signal": "order_no_receivable",
+            "module": "salesorders",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": (
+                f"已签约 {int(age)} 天但还没拆应收计划 — "
+                f"建议尽快和财务拆分账期，避免回款节奏失控"
+            ),
+        })
+
+    if n_total and n_paid == 0 and age > 30:
+        hints.append({
+            "severity": "medium",
+            "signal": "order_no_payment_yet",
+            "module": "salesorders",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": f"签约 {int(age)} 天了一分钱还没到账 — 建议主动推动首款",
+        })
+
+    if not status and not is_terminal:
+        hints.append({
+            "severity": "low",
+            "signal": "order_status_missing",
+            "module": "salesorders",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "订单状态留空 — 建议至少标 confirmed / shipping / delivered",
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions --------
+    who = row.get("account_name") or "客户"
+    questions: List[Dict[str, Any]] = [
+        {"text": f"拟一封给 {who} 的回款进度确认邮件", "agent": "draft"},
+        {"text": "这单的应收 / 回款全链路是什么状态？", "agent": "analyst"},
+    ]
+    if row.get("deal_name"):
+        questions.append({
+            "text": f"关联商机『{row['deal_name']}』有没有增购可能？",
+            "agent": "research",
+        })
+    else:
+        questions.append({
+            "text": f"查 {who} 的历史订单，是否有交叉销售机会",
+            "agent": "research",
+        })
+
+    return {
+        "has_data": True,
+        "module": "salesorders",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/scanners/tasks.py b/crm/insights/scanners/tasks.py
new file mode 100644
index 0000000000..9e736256f2
--- /dev/null
+++ b/crm/insights/scanners/tasks.py
@@ -0,0 +1,143 @@
+"""任务 (tasks) record-insight scanner.
+
+A salesperson opening a task wants to know, in this order:
+
+    1. Is it overdue? By how long?
+    2. Is it still actionable (status)?
+    3. What / whom is it for?
+    4. Should it just be closed?
+
+Overdue is the dominant signal — everything else is context.
+"""
+from __future__ import annotations
+
+from datetime import date
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.constants import TERMINAL_TASK_STATUSES
+
+from . import RecordInsight, empty
+
+# 单一来源:hermes.crm.constants。seed 里 task.status 只有
+# not_started / in_progress / completed / deferred 四档,没有 ``cancelled`` /
+# ``done`` / 中文遗留值——那些原来的 set 项是早期兼容,现已废止。
+# ``deferred`` 不算终态(任务还会回来),所以 TERMINAL_TASK_STATUSES 只有
+# ``completed``。
+_TERMINAL_STATUS = set(TERMINAL_TASK_STATUSES)
+
+
+def scan(db: DbWrapper, record_id: int, user_id: int) -> RecordInsight:
+    _ = user_id
+
+    row = db.fetchone(
+        """
+        SELECT t.tasks_id AS id, t.tasks_name AS name,
+               t.status, t.priority, t.startdate, t.enddate,
+               t.created_at, t.updated_at,
+               EXTRACT(EPOCH FROM (now() - t.created_at))/86400.0 AS age_days,
+               a.accounts_name AS account_name,
+               c.contacts_name AS contact_name
+          FROM tasks t
+          LEFT JOIN accounts a ON a.accounts_id = t.accounts_id
+          LEFT JOIN contacts c ON c.contacts_id = t.contacts_id
+         WHERE t.tasks_id = %s AND t.deleted = false
+        """,
+        (int(record_id),),
+    )
+    if not row:
+        return empty("tasks", record_id)
+
+    name = row.get("name")
+    status = (row.get("status") or "").strip()
+    status_l = status.lower()
+    is_terminal = status_l in _TERMINAL_STATUS
+    priority = (row.get("priority") or "").strip()
+    enddate = row.get("enddate")
+    days_to_due: Optional[int] = None
+    if isinstance(enddate, date):
+        days_to_due = (enddate - date.today()).days
+
+    # -------- summary --------
+    parts: List[str] = []
+    if priority:
+        parts.append(f"{priority} 优先级")
+    parts.append("任务")
+    if status:
+        parts.append(f"状态 {status}")
+    if row.get("account_name"):
+        parts.append(f"归属 {row['account_name']}")
+    if days_to_due is not None:
+        if days_to_due < 0:
+            parts.append(f"已逾期 {-days_to_due} 天")
+        elif days_to_due == 0:
+            parts.append("今天到期")
+        else:
+            parts.append(f"还剩 {days_to_due} 天到期")
+    summary = ("，".join(parts) + "。") if parts else None
+
+    # -------- hints --------
+    hints: List[Dict[str, Any]] = []
+
+    if days_to_due is not None and not is_terminal:
+        if days_to_due < 0:
+            hints.append({
+                "severity": "high",
+                "signal": "task_overdue",
+                "module": "tasks",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": (
+                    f"已逾期 {-days_to_due} 天 — "
+                    f"要么立即处理，要么重新定档或关闭，避免 pipeline 里挂死任务"
+                ),
+            })
+        elif days_to_due == 0:
+            hints.append({
+                "severity": "high",
+                "signal": "task_due_today",
+                "module": "tasks",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": "今天到期 — 处理完记得标记完成",
+            })
+        elif days_to_due <= 2:
+            hints.append({
+                "severity": "medium",
+                "signal": "task_due_soon",
+                "module": "tasks",
+                "record_id": record_id,
+                "record_name": name,
+                "hint": f"还剩 {days_to_due} 天到期 — 别拖到最后一刻",
+            })
+
+    if not status and not is_terminal:
+        hints.append({
+            "severity": "low",
+            "signal": "task_status_missing",
+            "module": "tasks",
+            "record_id": record_id,
+            "record_name": name,
+            "hint": "状态未填 — 建议至少标 pending / in_progress / completed",
+        })
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    hints.sort(key=lambda h: sev_rank.get(h["severity"], 3))
+    hints = hints[:3]
+
+    # -------- suggested questions --------
+    who = row.get("account_name") or row.get("contact_name") or "相关方"
+    questions: List[Dict[str, Any]] = [
+        {"text": f"帮我起一封给 {who} 的跟进邮件推进这个任务", "agent": "draft"},
+        {"text": "这条任务的历史动作和当前卡点是什么？", "agent": "analyst"},
+        {"text": f"查一下 {who} 近期的互动，是否有新进展可以借力", "agent": "research"},
+    ]
+
+    return {
+        "has_data": True,
+        "module": "tasks",
+        "record_id": record_id,
+        "summary": summary,
+        "hints": hints,
+        "suggested_questions": questions[:3],
+    }
diff --git a/crm/insights/team_audit.py b/crm/insights/team_audit.py
new file mode 100644
index 0000000000..aa1d88dfc3
--- /dev/null
+++ b/crm/insights/team_audit.py
@@ -0,0 +1,485 @@
+"""Team statistics / AI behavior audit panels — native hermes capability.
+
+Per plan v1.2 §4.7. Five panels:
+  1. AI 行为日历 (ai_actions_summary)
+  2. 推荐准确率 (recommendation_accuracy)
+  3. 团队 sleeping deals 趋势 (sleeping_deals_trend)
+  4. 成员 AI 接受度 (member_ai_acceptance)
+  5. pipeline 漏斗 (pipeline_funnel)
+
+All panels are real-time SQL aggregate. NO cache table — per plan
+§5 / §7 CI #2 / charter §三 第1条. Performance is enforced by:
+  · BRIN index on audit_log (5.5)
+  · partial index on interactions(occurred_at, kind) WHERE kind LIKE
+    'auto_drive.%' (added in 5.6 if EXPLAIN says it's needed)
+
+drill-down: every aggregate row exposes a ``filter`` payload that
+``/api/insights/timeline?filter=...`` consumes to return the raw
+interaction list (5.6 §4 v1.2 — "no panel's drill-down may be
+砍掉").
+
+Scope inversion (final migration phase): these panels NO LONGER
+resolve RBAC scope. Each panel receives an already-resolved
+``uids: List[int]`` — the viewable user-id list — and does its SQL
+filtering on that. The caller (cloud HTTP route or the hermes
+analyze_team agent) is responsible for resolving + auditing scope
+before invoking these panels. This keeps the panels pure
+``hermes.crm.db`` + stdlib with NO cloud coupling.
+"""
+from __future__ import annotations
+
+import logging
+from datetime import datetime, timedelta, timezone
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+def _week_window(week_offset: int = 0) -> tuple[datetime, datetime]:
+    """Resolve start/end of the week window. ``week_offset=0`` means
+    current week; ``-1`` last week; etc."""
+    now = datetime.now(tz=timezone.utc)
+    # Monday of current week
+    monday = now - timedelta(
+        days=now.weekday(),
+        hours=now.hour, minutes=now.minute,
+        seconds=now.second, microseconds=now.microsecond,
+    )
+    monday = monday + timedelta(weeks=week_offset)
+    return monday, monday + timedelta(weeks=1)
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Panel 1: AI 行为日历 — by day / by member / by intent
+# ──────────────────────────────────────────────────────────────────────
+
+
+def ai_actions_summary(
+    db: DbWrapper, *,
+    uids: List[int],
+    week_offset: int = 0,
+) -> Dict[str, Any]:
+    """Counts AI's actions over a 1-week window broken down by day,
+    member, and intent. All non-cache, all SoT.
+
+    ``uids`` is the already-resolved viewable user-id list — the caller
+    resolves + audits scope. An empty ``uids`` yields an empty summary.
+
+    Returns:
+        {
+            "total": int,
+            "approved": int, "cancelled": int, "pending": int,
+            "by_day":    [{"day": "2026-05-09", "n": 5}, ...],
+            "by_member": [{"user_id": 11, "name": "...", "n": 3}, ...],
+            "by_intent": [{"intent": "重启沉默商机", "n": 4}, ...],
+            "filter": {"week_start": ..., "week_end": ...},
+        }
+
+    Per plan v1.2 §4.7 5.6.5: no AI confidence score added; just counts.
+    """
+    if not uids:
+        return _empty_summary()
+
+    start, end = _week_window(week_offset)
+
+    # Total + status split. ``kind='auto_drive.draft'`` rows carry
+    # the draft; ``approved`` / ``cancelled`` come from later state
+    # transitions. For now we approximate:
+    #   - approved = drafts with no matching cancellation by week-end
+    #   - cancelled = drafts with kind='auto_drive.cancelled' downstream
+    #   - pending = drafts whose latest state is still 'pending'
+    try:
+        total_row = db.fetchone(
+            """
+            SELECT COUNT(*) AS n
+              FROM interactions
+             WHERE kind = 'auto_drive.draft'
+               AND occurred_at >= %s AND occurred_at < %s
+               AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+            """,
+            (start, end, uids),
+        )
+        cancelled_row = db.fetchone(
+            """
+            SELECT COUNT(*) AS n
+              FROM interactions
+             WHERE kind = 'auto_drive.cancelled'
+               AND occurred_at >= %s AND occurred_at < %s
+               AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+            """,
+            (start, end, uids),
+        )
+        # by_day, by_member, by_intent
+        by_day_rows = db.fetchall(
+            """
+            SELECT (occurred_at AT TIME ZONE 'UTC')::date AS day,
+                   COUNT(*) AS n
+              FROM interactions
+             WHERE kind = 'auto_drive.draft'
+               AND occurred_at >= %s AND occurred_at < %s
+               AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+             GROUP BY day
+             ORDER BY day
+            """,
+            (start, end, uids),
+        ) or []
+        by_member_rows = db.fetchall(
+            """
+            SELECT (actors->0->>'id')::bigint AS user_id, COUNT(*) AS n
+              FROM interactions
+             WHERE kind = 'auto_drive.draft'
+               AND occurred_at >= %s AND occurred_at < %s
+               AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+             GROUP BY user_id
+             ORDER BY n DESC
+            """,
+            (start, end, uids),
+        ) or []
+        by_intent_rows = db.fetchall(
+            """
+            SELECT content->>'intent' AS intent, COUNT(*) AS n
+              FROM interactions
+             WHERE kind = 'auto_drive.draft'
+               AND occurred_at >= %s AND occurred_at < %s
+               AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+             GROUP BY intent
+             ORDER BY n DESC
+            """,
+            (start, end, uids),
+        ) or []
+    except Exception:
+        logger.exception(
+            "dashboard.ai_actions_summary failed uids=%s", uids,
+        )
+        try:
+            db.rollback()
+        except Exception:
+            pass
+        return _empty_summary()
+
+    total = int(total_row["n"]) if total_row else 0
+    cancelled = int(cancelled_row["n"]) if cancelled_row else 0
+    approved = max(0, total - cancelled)  # pending lumped into approved
+    return {
+        "total": total,
+        "approved": approved,
+        "cancelled": cancelled,
+        "pending": 0,  # 5.6 v1: simple; refine when gateway_actions wired
+        "by_day": [
+            {"day": str(r["day"]), "n": int(r["n"])} for r in by_day_rows
+        ],
+        "by_member": [
+            {"user_id": int(r["user_id"]), "n": int(r["n"])}
+            for r in by_member_rows
+        ],
+        "by_intent": [
+            {"intent": r["intent"] or "(unknown)", "n": int(r["n"])}
+            for r in by_intent_rows
+        ],
+        "filter": {
+            "week_start": start.isoformat(),
+            "week_end": end.isoformat(),
+        },
+    }
+
+
+def _empty_summary() -> Dict[str, Any]:
+    return {
+        "total": 0, "approved": 0, "cancelled": 0, "pending": 0,
+        "by_day": [], "by_member": [], "by_intent": [], "filter": {},
+    }
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Panel 2: 推荐准确率
+# ──────────────────────────────────────────────────────────────────────
+
+
+def recommendation_accuracy(
+    db: DbWrapper, *,
+    uids: List[int],
+    intent: Optional[str] = None,
+    window_days: int = 30,
+) -> List[Dict[str, Any]]:
+    """For each intent (or filtered to one), count:
+        recommended (auto_drive.draft)
+        accepted    (no later .cancelled within 6h grace)
+        outcome_signed (the underlying potential reached stage='won')
+
+    ``uids`` is the already-resolved viewable user-id list.
+
+    Returns:
+        [{
+            "intent": "重启沉默商机",
+            "recommended": 12, "accepted": 8, "outcome_signed": 3,
+            "transition_rate": 0.25,  # outcome_signed / recommended
+            "filter": {"intent": ..., "window_days": 30},
+        }, ...]
+    """
+    if not uids:
+        return []
+
+    try:
+        rows = db.fetchall(
+            """
+            WITH drafts AS (
+                SELECT id,
+                       content->>'intent' AS intent,
+                       (subjects->0->>'id')::bigint AS rec_id,
+                       (subjects->0->>'module') AS rec_module,
+                       occurred_at
+                  FROM interactions
+                 WHERE kind = 'auto_drive.draft'
+                   AND occurred_at > NOW() - (%s * interval '1 day')
+                   AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+                   AND (%s::text IS NULL OR content->>'intent' = %s)
+            ),
+            cancellations AS (
+                SELECT (subjects->0->>'id')::bigint AS rec_id,
+                       (subjects->0->>'module') AS rec_module,
+                       occurred_at
+                  FROM interactions
+                 WHERE kind = 'auto_drive.cancelled'
+                   AND occurred_at > NOW() - (%s * interval '1 day')
+            ),
+            wins AS (
+                SELECT potentials_id AS rec_id, 'potentials' AS rec_module
+                  FROM potentials
+                 WHERE status = 'won'
+                   AND deleted = FALSE
+            )
+            SELECT d.intent,
+                   COUNT(DISTINCT d.id) AS recommended,
+                   COUNT(DISTINCT d.id) FILTER (
+                       WHERE NOT EXISTS (
+                           SELECT 1 FROM cancellations c
+                            WHERE c.rec_id = d.rec_id
+                              AND c.rec_module = d.rec_module
+                              AND c.occurred_at >= d.occurred_at
+                              AND c.occurred_at <= d.occurred_at + interval '6 hours'
+                       )
+                   ) AS accepted,
+                   COUNT(DISTINCT d.id) FILTER (
+                       WHERE EXISTS (
+                           SELECT 1 FROM wins w
+                            WHERE w.rec_id = d.rec_id
+                              AND w.rec_module = d.rec_module
+                       )
+                   ) AS outcome_signed
+              FROM drafts d
+             GROUP BY d.intent
+             ORDER BY recommended DESC
+            """,
+            (window_days, uids, intent, intent, window_days),
+        ) or []
+    except Exception:
+        logger.exception(
+            "dashboard.recommendation_accuracy failed uids=%s", uids,
+        )
+        try:
+            db.rollback()
+        except Exception:
+            pass
+        return []
+
+    out = []
+    for r in rows:
+        rec = int(r.get("recommended") or 0)
+        out.append({
+            "intent": r.get("intent") or "(unknown)",
+            "recommended": rec,
+            "accepted": int(r.get("accepted") or 0),
+            "outcome_signed": int(r.get("outcome_signed") or 0),
+            "transition_rate": (
+                round(float(r.get("outcome_signed") or 0) / rec, 4)
+                if rec > 0 else 0.0
+            ),
+            "filter": {
+                "intent": intent,
+                "window_days": window_days,
+            },
+        })
+    return out
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Panel 3: sleeping deals trend (4 weeks)
+# ──────────────────────────────────────────────────────────────────────
+
+
+def sleeping_deals_trend(
+    db: DbWrapper, *, uids: List[int], weeks: int = 4,
+) -> List[Dict[str, Any]]:
+    """N-week count of potentials with no activity in the last 7+ days.
+
+    For each week: count potentials owned by viewable users where the
+    most recent interaction is older than 7 days. ``uids`` is the
+    already-resolved viewable user-id list.
+    """
+    if not uids:
+        return []
+    out: List[Dict[str, Any]] = []
+    for w in range(weeks - 1, -1, -1):
+        # Compute "as of" point at start of week w
+        start, _end = _week_window(week_offset=-w)
+        try:
+            r = db.fetchone(
+                """
+                SELECT COUNT(*) AS n
+                  FROM potentials p
+                 WHERE p.deleted = FALSE
+                   AND p.owner_by = ANY(%s::bigint[])
+                   AND p.milestone IN
+                       ('qualified', 'proposal', 'proposal_sent',
+                        'negotiation', 'verbal',
+                        '意向', '方案', '谈判', '口头确认', '商务')
+                   AND NOT EXISTS (
+                       SELECT 1 FROM interactions i
+                        WHERE (i.subjects->0->>'id')::bigint = p.potentials_id
+                          AND (i.subjects->0->>'module') = 'potentials'
+                          AND i.kind IN ('note','email','call','meeting')
+                          AND i.occurred_at > %s - interval '7 days'
+                          AND i.occurred_at <= %s
+                   )
+                """,
+                (uids, start, start),
+            )
+        except Exception:
+            logger.exception("sleeping_deals_trend week=%s failed", w)
+            try:
+                db.rollback()
+            except Exception:
+                pass
+            continue
+        out.append({
+            "week_start": start.date().isoformat(),
+            "n": int(r["n"]) if r else 0,
+        })
+    return out
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Panel 4: 成员 AI 接受度
+# ──────────────────────────────────────────────────────────────────────
+
+
+def member_ai_acceptance(
+    db: DbWrapper, *, uids: List[int],
+    window_days: int = 30,
+) -> List[Dict[str, Any]]:
+    """Per-member: how many AI drafts targeted them, how many accepted,
+    acceptance rate (%). Default-off ⭐ rating per v1.2 fix —
+    just plain percentage, drill-down to cancel reasons.
+
+    ``uids`` is the already-resolved viewable user-id list.
+    """
+    if not uids:
+        return []
+    try:
+        rows = db.fetchall(
+            """
+            WITH per_member AS (
+                SELECT (actors->0->>'id')::bigint AS user_id,
+                       id, occurred_at, subjects, content
+                  FROM interactions
+                 WHERE kind = 'auto_drive.draft'
+                   AND occurred_at > NOW() - (%s * interval '1 day')
+                   AND (actors->0->>'id')::bigint = ANY(%s::bigint[])
+            )
+            SELECT user_id,
+                   COUNT(*) AS recommended,
+                   COUNT(*) FILTER (
+                       WHERE NOT EXISTS (
+                           SELECT 1 FROM interactions c
+                            WHERE c.kind = 'auto_drive.cancelled'
+                              AND (c.subjects->0->>'id')::bigint
+                                  = (per_member.subjects->0->>'id')::bigint
+                              AND c.occurred_at >= per_member.occurred_at
+                              AND c.occurred_at <= per_member.occurred_at + interval '6 hours'
+                       )
+                   ) AS accepted
+              FROM per_member
+             GROUP BY user_id
+             ORDER BY accepted DESC
+            """,
+            (window_days, uids),
+        ) or []
+    except Exception:
+        logger.exception("member_ai_acceptance failed")
+        try:
+            db.rollback()
+        except Exception:
+            pass
+        return []
+    out = []
+    for r in rows:
+        rec = int(r["recommended"]) if r.get("recommended") is not None else 0
+        acc = int(r["accepted"]) if r.get("accepted") is not None else 0
+        out.append({
+            "user_id": int(r["user_id"]),
+            "recommended": rec,
+            "accepted": acc,
+            "rate": round(acc / rec, 4) if rec > 0 else 0.0,
+            # No ⭐ rating per plan v1.2 §9 decision
+        })
+    return out
+
+
+# ──────────────────────────────────────────────────────────────────────
+# Panel 5: pipeline funnel
+# ──────────────────────────────────────────────────────────────────────
+
+
+def pipeline_funnel(
+    db: DbWrapper, *, uids: List[int],
+) -> List[Dict[str, Any]]:
+    """Pipeline stage distribution for the visible team's potentials.
+
+    ``uids`` is the already-resolved viewable user-id list. Each row is
+    drillable: ``{"stage": ..., "n": int, "amount_total": float, "filter": {...}}``.
+    Honest funnel — count + sum(amount) per stage, no probability weighting.
+    """
+    if not uids:
+        return []
+    try:
+        rows = db.fetchall(
+            """
+            SELECT COALESCE(milestone, '(unknown)') AS stage,
+                   COUNT(*) AS n,
+                   COALESCE(SUM(COALESCE(amount, 0)), 0)::numeric AS amount_total
+              FROM potentials
+             WHERE deleted = FALSE
+               AND owner_by = ANY(%s::bigint[])
+             GROUP BY stage
+             ORDER BY n DESC
+            """,
+            (uids,),
+        ) or []
+    except Exception:
+        logger.exception("pipeline_funnel failed")
+        try:
+            db.rollback()
+        except Exception:
+            pass
+        return []
+    return [
+        {
+            "stage": r["stage"],
+            "n": int(r["n"]),
+            "amount_total": float(r["amount_total"] or 0),
+            "filter": {"milestone": r["stage"]},
+        }
+        for r in rows
+    ]
+
+
+__all__ = [
+    "_week_window",
+    "ai_actions_summary",
+    "recommendation_accuracy",
+    "sleeping_deals_trend",
+    "member_ai_acceptance",
+    "pipeline_funnel",
+]
