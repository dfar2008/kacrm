+        "title": str(arguments.get("title") or "").strip(),
+        "title_en": arguments.get("title_en"),
+        "detail_kind": arguments.get("detail_kind") or "generic",
+        "initial_fields": arguments.get("initial_fields") or [],
+    }
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        if not _actor_is_admin(d, user_id):
+            parent_row = ModulesDb(d).get_module_by_name(parent)
+            if not parent_row:
+                return {"success": False, "error": f"unknown parent module: {parent!r}"}
+            try:
+                _validate_module_name_pure(d, spec["name"])
+            except ValueError as e:
+                return {"success": False, "error": str(e)}
+            return _enqueue_schema_proposal(
+                d, kind="subdetail_add", module_id=int(parent_row["id"]),
+                module_name=parent, dedup_key=spec["name"],
+                payload={"parent_name": parent, **spec},
+                reason=arguments.get("reason"),
+                user_id=user_id, profile_id=profile_id, agent_name=agent_name,
+            )
+        try:
+            res = provision_subdetail(d, parent, spec, actor, arguments.get("reason"))
+        except HTTPException as e:
+            return {"success": False, "error": str(e.detail)}
+        return {"success": True, **res,
+                "message": f"已为「{parent}」创建子明细「{spec['title']}」({res['name']})。"}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as d:
+        return _run(d)
+
+
+def dispatch(
+    *,
+    tool_name: str,
+    arguments: Dict[str, Any],
+    user_id: int,
+    source: str = "manual",
+    profile_id: Optional[str] = None,
+    agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Invoke a CRM tool on behalf of *user_id*.
+
+    Supports both the unified tool names (``crm_search``, ``crm_get``,
+    ``crm_write``) and legacy per-module names (``crm_search_accounts``)
+    for backwards compatibility.
+
+    When ``source`` starts with ``'agent:'``, create/update writes
+    are routed through the Action Gateway so the Trust Engine can gate
+    them.
+
+    Phase 5.0 prep (2026-05-09 plan v1.2 §4.1) — ``arguments`` MAY now
+    carry a ``scope`` key that callers (cloud surface layer) start
+    setting. 5.0 silently ignores it. 5.1 (this same file, patch 30+)
+    will replace this pop with a real consumer that reads the bound
+    ``X-Hermes-Scope`` ContextVar (set by gateway/platforms/api_server
+    same as patch 27 surface_acl) and applies a viewable_user_ids
+    filter at the SQL layer of every CRM tool. Until then, popping
+    here keeps the CRM tools free of an unexpected kwarg.
+    """
+    arguments = dict(arguments or {})  # local copy for safe pop
+    arguments.pop("scope", None)  # Phase 5.0: silent ignore — see docstring
+
+    # ── Consolidated structural dispatchers ─────────────────────────────
+    # crm_schema / crm_workflow / crm_dashboard collapse 14 structural tools
+    # into 3 (smaller tool prompt). Rewrite to the underlying tool_name and
+    # let the existing routing + each handler's own RBAC run unchanged.
+    _DISPATCHER_ACTIONS = {
+        "crm_schema": {
+            "create_module": "crm_create_module",
+            "create_field": "crm_create_field",
+            "create_formula_field": "crm_create_formula_field",
+            "create_subdetail": "crm_create_subdetail",
+            "rename_module": "crm_rename_module",
+            "propose_new_field": "crm_propose_new_field",
+            "propose_picklist_option": "crm_propose_picklist_option",
+            "set_writeback_rule": "crm_set_field_writeback_rule",
+            "list_writeback_rules": "crm_list_field_writeback_rules",
+            "remove_writeback_rule": "crm_remove_field_writeback_rule",
+        },
+        "crm_workflow": {
+            "create": "crm_create_workflow",
+            "list": "crm_list_workflows",
+            "remove": "crm_remove_workflow",
+            "toggle": "crm_toggle_workflow",
+        },
+        "crm_dashboard": {
+            "create_chart": "crm_create_dashboard_chart",
+            "list_entities": "crm_list_dashboard_entities",
+            "entity_subgraph": "crm_entity_subgraph",
+        },
+    }
+    if tool_name in _DISPATCHER_ACTIONS:
+        _action = str(arguments.pop("action", "")).strip()
+        _real = _DISPATCHER_ACTIONS[tool_name].get(_action)
+        if not _real:
+            _valid = ", ".join(_DISPATCHER_ACTIONS[tool_name])
+            return {
+                "error": (
+                    f"{tool_name}: unknown or missing action '{_action}'. "
+                    f"Valid actions: {_valid}"
+                )
+            }
+        tool_name = _real
+
+    # Phase 4 patch 28 — note + relation-walk
+    if tool_name == "crm_note_create":
+        return _dispatch_note_create(
+            arguments,
+            user_id=user_id,
+            agent_name=agent_name,
+            db=db,
+        )
+    if tool_name == "crm_list_related":
+        return _dispatch_list_related(arguments, db=db)
+    # Handle crm_task_create — routes through gateway as kind=task.create.
+    # Accept the legacy "task_create" alias so any in-flight agent prompts
+    # / memorised tool names from earlier turns keep working through the
+    # rename window.
+    if tool_name == "coach_proposal_submit":
+        return _dispatch_coach_proposal_submit(
+            arguments,
+            user_id=user_id,
+            source=source,
+            profile_id=profile_id,
+            agent_name=agent_name,
+            db=db,
+        )
+    if tool_name == "crm_draft_feedback_collect":
+        return _dispatch_draft_feedback_collect(
+            arguments, user_id=user_id, profile_id=profile_id, db=db,
+        )
+    if tool_name == "crm_convert_lead":
+        return _dispatch_convert_lead(
+            arguments,
+            user_id=user_id,
+            source=source,
+            profile_id=profile_id,
+            agent_name=agent_name,
+            db=db,
+        )
+    if tool_name == "crm_delete":
+        return _dispatch_crm_delete(
+            arguments,
+            user_id=user_id,
+            source=source,
+            profile_id=profile_id,
+            agent_name=agent_name,
+            db=db,
+        )
+    # Handle crm_memory_write — routes through gateway as kind=memory.write.
+    if tool_name == "crm_memory_write":
+        return _dispatch_memory_write(
+            arguments,
+            user_id=user_id,
+            source=source,
+            profile_id=profile_id,
+            agent_name=agent_name,
+            db=db,
+        )
+    if tool_name in ("crm_task_create", "task_create"):
+        return _dispatch_task_create(
+            arguments,
+            user_id=user_id,
+            source=source,
+            profile_id=profile_id,
+            agent_name=agent_name,
+            db=db,
+        )
+    # Handle metadata tools
+    if tool_name == "crm_list_modules":
+        return _dispatch_list_modules(db=db)
+    if tool_name == "crm_get_schema":
+        return _dispatch_get_schema(arguments, db=db)
+    # Handle agent tools
+    # Handle gateway approval tools
+    if tool_name == "crm_pending_approvals":
+        return _dispatch_pending_approvals(
+            arguments, user_id=user_id, profile_id=profile_id, db=db,
+        )
+    if tool_name == "crm_approve_action":
+        return _dispatch_approve_action(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_reject_action":
+        return _dispatch_reject_action(
+            arguments, user_id=user_id, db=db,
+        )
+    # Handle approval chain tools (kacrm port)
+    if tool_name == "crm_submit_approval":
+        return _dispatch_submit_approval(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_pending_approval_chains":
+        return _dispatch_pending_approval_chains(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_approve_chain_step":
+        return _dispatch_approve_chain_step(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_reject_chain_step":
+        return _dispatch_reject_chain_step(
+            arguments, user_id=user_id, db=db,
+        )
+    # Handle approval config tools (admin only)
+    if tool_name == "crm_set_approval_chain":
+        return _dispatch_set_approval_chain(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_get_approval_chain":
+        return _dispatch_get_approval_chain(
+            arguments, db=db,
+        )
+    if tool_name == "crm_remove_approval_chain":
+        return _dispatch_remove_approval_chain(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_transfer_approval":
+        return _dispatch_transfer_approval(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_back_approval":
+        return _dispatch_back_approval(
+            arguments, user_id=user_id, db=db,
+        )
+    # Memory Substrate tools (原语 ②)
+    if tool_name == "crm_semantic_search":
+        return _dispatch_semantic_search(
+            arguments, user_id=user_id, db=db,
+        )
+    if tool_name == "crm_entity_subgraph":
+        return _dispatch_entity_subgraph(
+            arguments, user_id=user_id, db=db,
+        )
+    # Schema-evolution propose-only tools (charter v2 §定律 5)
+    if tool_name == "crm_create_module":
+        return _dispatch_create_module(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_create_subdetail":
+        return _dispatch_create_subdetail(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_rename_module":
+        return _dispatch_rename_module(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_create_formula_field":
+        return _dispatch_create_formula_field(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_create_field":
+        return _dispatch_create_field(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_list_dashboard_entities":
+        return _dispatch_list_dashboard_entities(arguments, user_id=user_id, db=db)
+    if tool_name == "crm_create_dashboard_chart":
+        return _dispatch_create_dashboard_chart(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_create_workflow":
+        return _dispatch_create_workflow(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_list_workflows":
+        return _dispatch_list_workflows(arguments, db=db)
+    if tool_name == "crm_remove_workflow":
+        return _dispatch_remove_workflow(arguments, db=db)
+    if tool_name == "crm_toggle_workflow":
+        return _dispatch_toggle_workflow(arguments, db=db)
+    if tool_name == "crm_propose_new_field":
+        return _dispatch_propose_new_field(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_propose_picklist_option":
+        return _dispatch_propose_picklist_option(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    # Field-writeback admin tools
+    if tool_name == "crm_set_field_writeback_rule":
+        return _dispatch_set_field_writeback_rule(
+            arguments, user_id=user_id,
+            profile_id=profile_id, agent_name=agent_name, db=db,
+        )
+    if tool_name == "crm_list_field_writeback_rules":
+        return _dispatch_list_field_writeback_rules(
+            arguments, db=db,
+        )
+    if tool_name == "crm_remove_field_writeback_rule":
+        return _dispatch_remove_field_writeback_rule(
+            arguments, user_id=user_id, db=db,
+        )
+
+    # --- Resolve verb + module_name ---
+    # Unified tools: crm_search, crm_get, crm_write carry module in arguments
+    if tool_name == "crm_search":
+        verb = "search"
+        module_name = arguments.get("module", "")
+    elif tool_name == "crm_get":
+        verb = "get"
+        module_name = arguments.get("module", "")
+    elif tool_name == "crm_write":
+        write_action = arguments.get("action", "")
+        if write_action not in ("create", "update"):
+            raise ValueError(f"crm_write action must be 'create' or 'update', got {write_action!r}")
+        verb = write_action
+        module_name = arguments.get("module", "")
+    else:
+        # Legacy per-module names (crm_search_accounts, etc.)
+        parsed = _parse_tool_name(tool_name)
+        if parsed is None:
+            raise ToolNotFoundError(f"unknown tool: {tool_name!r}")
+        verb, module_name = parsed
+
+    if not module_name:
+        raise ValueError("module is required")
+
+    # Fail-fast id validation for crm_get — happens BEFORE module
+    # resolution / permission check / DB connection so a stray UUID or
+    # missing id from a confused agent burns no work and gets a clear
+    # signal back. The verbose messages are deliberate: a cheap/fast
+    # LLM in an unattended cron retries blindly without them. Regression
+    # cover for the 2026-05-31 daily-coach loop in
+    # ~/.kacrm/profiles/admin/logs/gateway.log.
+    if verb == "get":
+        rid_raw = arguments.get("id")
+        if rid_raw is None:
+            raise ValueError(
+                f"crm_get: id is required (module={module_name!r}). "
+                f"Provide an integer id from a recent crm_search result."
+            )
+        try:
+            rid_validated = int(rid_raw)
+        except (TypeError, ValueError):
+            raise ValueError(
+                f"crm_get: id must be a positive integer, got "
+                f"{rid_raw!r} (type={type(rid_raw).__name__}). "
+                f"Module={module_name!r}. Do NOT retry with the same "
+                f"value — ids are integers, not UUIDs or strings."
+            )
+        if rid_validated <= 0:
+            raise ValueError(
+                f"crm_get: id must be ≥ 1, got {rid_validated}. "
+                f"Module={module_name!r}. Do NOT retry with the same value."
+            )
+        # Stash the validated int for _run() to use, replacing whatever
+        # type the caller passed.
+        arguments["id"] = rid_validated
+
+    action = _VERB_TO_ACTION[verb]
+    _agent_sourced = source.startswith("agent:")
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        mod = ModulesDb(db).get_module_by_name(module_name)
+        if not mod:
+            raise ToolNotFoundError(f"unknown module: {module_name!r}")
+
+        user_row = UsersDb(db).get_user_by_id(int(user_id))
+        is_admin = bool(user_row and user_row.get("is_admin"))
+
+        if not is_admin:
+            allowed = Permission(db).check_permission_by_module_name(
+                int(user_id), module_name, action
+            )
+            if not allowed:
+                raise ToolPermissionError(
+                    f"user {user_id} lacks {action} on {module_name}"
+                )
+
+        module_id = int(mod["id"])
+
+        if verb == "search":
+            lq = ListQuery(db).set_module(module_id, None)
+            if arguments.get("search"):
+                lq.set_search(str(arguments["search"]))
+            raw_filters = arguments.get("filters")
+            if isinstance(raw_filters, list) and raw_filters:
+                _assert_search_filter_fields(db, str(mod["table_name"]), raw_filters)
+                lq.set_filters(
+                    raw_filters, str(arguments.get("filter_logic", "all") or "all")
+                )
+            lq.set_pagination(
+                int(arguments.get("page", 1) or 1),
+                int(arguments.get("limit", 20) or 20),
+            )
+            # owner="me" — server-resolved self scope. The current user's real
+            # identity lives at the data layer (user_id), NOT in the agent's
+            # prompt, so the agent must never filter by a *guessed* name. We
+            # resolve "me" to owner_by/created_by = caller here (the SPA "my
+            # records" = owned OR created convention). Because {caller} ⊆ the
+            # caller's RBAC viewable set, this self-scope fully subsumes the
+            # non-admin RBAC filter below (no read leak) AND correctly narrows an
+            # admin's otherwise-global search to their own records.
+            owner_arg = str(arguments.get("owner", "") or "").strip().lower()
+            if owner_arg == "me":
+                lq.set_extra_where(
+                    "owner_by = %s OR created_by = %s",
+                    [int(user_id), int(user_id)],
+                )
+            elif owner_arg:
+                raise ValueError(
+                    'crm_search: owner only accepts "me". To filter by another '
+                    'person pass filters=[{"field":"owner_by","operator":"eq",'
+                    '"value":<user_id>}].'
+                )
+            # Phase 5.1 patch 30 — row-level RBAC on search, mirroring the
+            # SPA's _build_owner_scope. A NON-ADMIN may only search records they
+            # can see: owner_by/created_by ∈ their viewable set (self for an IC,
+            # self + managed-departments for a manager). The viewable set is
+            # bound by the cloud's X-Hermes-Scope header (surface.inject_context,
+            # scope='team'); when no header is bound it falls back to [caller] =
+            # self (fail-closed).
+            #
+            # This filter is applied for EVERY non-admin search — including the
+            # self-only case. The previous ``len>1 or != [caller]`` skip left a
+            # self/unbound scope UNFILTERED, so the agent returned every tenant's
+            # records (a cross-department read leak: a salesperson could ask the
+            # agent for records the SPA correctly hides). Admins stay unrestricted.
+            elif not is_admin:
+                try:
+                    from tools.scope import viewable_user_ids_or_caller
+                    scope_uids = viewable_user_ids_or_caller(int(user_id))
+                except ImportError:
+                    # scope module absent (patch 30 not applied) → self-only,
+                    # fail-closed (never widen on a missing dependency).
+                    scope_uids = [int(user_id)]
+                lq.set_extra_where(
+                    "owner_by = ANY(%s) OR created_by = ANY(%s)",
+                    [scope_uids, scope_uids],
+                )
+            return lq.execute()
+
+        if verb == "get":
+            # id was validated and coerced to int at the dispatch entry
+            # (see fail-fast block above), so DetailQuery gets a clean int.
+            return (
+                DetailQuery(db)
+                .set_module(module_id)
+                .set_record_id(int(arguments["id"]))
+                .set_user(int(user_id), is_admin)
+                .execute()
+            )
+
+        # For crm_write, field values are in arguments["data"]
+        if verb == "create":
+            payload = arguments.get("data") or {
+                k: v for k, v in arguments.items()
+                if k not in ("id", "module", "action", "data")
+            }
+            if _agent_sourced:
+                return _dispatch_via_gateway(
+                    profile_id=profile_id,
+                    agent_name=agent_name or source,
+                    module_id=module_id,
+                    module_name=module_name,
+                    op="create",
+                    data=payload,
+                    user_id=user_id,
+                    db=db,
+                )
+            new_id = (
+                Save(db)
+                .set_module(module_id)
+                .set_user(int(user_id), is_admin)
+                .insert(payload)
+            )
+            return {"success": True, "id": int(new_id)}
+
+        if verb == "update":
+            rid = arguments.get("id")
+            if rid is None:
+                raise ValueError("id is required for update")
+            payload = arguments.get("data") or {
+                k: v for k, v in arguments.items()
+                if k not in ("id", "module", "action", "data")
+            }
+            if _agent_sourced:
+                return _dispatch_via_gateway(
+                    profile_id=profile_id,
+                    agent_name=agent_name or source,
+                    module_id=module_id,
+                    module_name=module_name,
+                    op="update",
+                    data=payload,
+                    record_id=int(rid),
+                    user_id=user_id,
+                    db=db,
+                )
+            Save(db).set_module(module_id).set_user(
+                int(user_id), is_admin
+            ).set_record_id(int(rid)).update(payload)
+            return {"success": True, "id": int(rid)}
+
+        raise ToolNotFoundError(f"unhandled verb: {verb}")  # pragma: no cover
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
