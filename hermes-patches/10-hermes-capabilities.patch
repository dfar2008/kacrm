@@ -0,0 +1,62 @@
+from __future__ import annotations
+
+from typing import Any
+
+
+def normalize_filter_operator(raw: Any) -> str:
+    op = str(raw or "eq").strip().lower()
+    mapping = {
+        "=": "eq",
+        "==": "eq",
+        "eq": "eq",
+        "in": "in",
+        "!=": "neq",
+        "<>": "neq",
+        "neq": "neq",
+        ">": "gt",
+        "gt": "gt",
+        ">=": "gte",
+        "gte": "gte",
+        "<": "lt",
+        "lt": "lt",
+        "<=": "lte",
+        "lte": "lte",
+        "like": "contains",
+        "contains": "contains",
+        "not like": "not_contains",
+        "not_contains": "not_contains",
+        "starts_with": "starts_with",
+        "ends_with": "ends_with",
+        "is_empty": "is_empty",
+        "is_not_empty": "is_not_empty",
+    }
+    return mapping.get(op, "eq")
+
+
+def to_sql_operator(filter_operator: str) -> str | None:
+    return {
+        "eq": "=",
+        "neq": "!=",
+        "gt": ">",
+        "gte": ">=",
+        "lt": "<",
+        "lte": "<=",
+    }.get(filter_operator)
+
+
+def to_legacy_operator(filter_operator: str) -> str:
+    return {
+        "eq": "=",
+        "in": "in",
+        "neq": "!=",
+        "gt": ">",
+        "gte": ">=",
+        "lt": "<",
+        "lte": "<=",
+        "contains": "like",
+        "not_contains": "not like",
+        "starts_with": "starts_with",
+        "ends_with": "ends_with",
+        "is_empty": "is_empty",
+        "is_not_empty": "is_not_empty",
+    }.get(filter_operator, "=")
diff --git a/crm/i18n/options.py b/crm/i18n/options.py
new file mode 100644
index 0000000000..bfde8fc7f2
--- /dev/null
+++ b/crm/i18n/options.py
@@ -0,0 +1,195 @@
+from __future__ import annotations
+
+import json
+from typing import Any, Optional, Tuple
+
+def parse_picklist_options(raw: Any) -> list[dict[str, Any]]:
+    if not raw:
+        return []
+    data = raw
+    if isinstance(raw, str):
+        s = raw.strip()
+        if not s:
+            return []
+        if s[0] in "[{":
+            try:
+                data = json.loads(s)
+            except Exception:
+                return []
+        else:
+            # kacrm-classic storage: a bare comma-separated list of values.
+            data = [p.strip() for p in s.split(",") if p.strip()]
+    if isinstance(data, dict) and isinstance(data.get("options"), list):
+        data = data.get("options")
+    if not isinstance(data, list):
+        return []
+
+    out: list[dict[str, Any]] = []
+    for item in data:
+        if not isinstance(item, dict):
+            text = str(item or "").strip()
+            if not text:
+                continue
+            out.append({
+                "value": text, "text": text, "color": "",
+                "label_key": "", "label_i18n": {},
+            })
+            continue
+        raw_value = item.get("value")
+        raw_text = item.get("text")
+        value = str(raw_value if raw_value not in (None, "") else raw_text or "").strip()
+        text = str(raw_text if raw_text not in (None, "") else value).strip()
+        if not value and not text:
+            continue
+        i18n = item.get("label_i18n")
+        out.append(
+            {
+                "value": value or text,
+                "text": text or value,
+                "color": str(item.get("color") or "").strip(),
+                "label_key": str(item.get("label_key") or "").strip(),
+                "label_i18n": i18n if isinstance(i18n, dict) else {},
+            }
+        )
+    return out
+
+
+def _coerce_dict(raw: Any) -> dict:
+    """Normalise a JSON column value (dict or JSON string) to a dict."""
+    if isinstance(raw, dict):
+        return raw
+    if isinstance(raw, str) and raw.strip():
+        try:
+            parsed = json.loads(raw)
+            return parsed if isinstance(parsed, dict) else {}
+        except (ValueError, TypeError):
+            return {}
+    return {}
+
+
+def localize_picklist_options(
+    options: list[dict[str, Any]],
+    locale: str | None = None,
+    table_name: str = "",
+    field_name: str = "",
+    field_id: int | None = None,
+    *,
+    field_config: Any = None,
+) -> list[dict[str, Any]]:
+    """Resolve each option's display ``text`` for the requested locale.
+
+    Label resolution priority, highest first:
+
+    1. ``field_config.option_labels[value][locale]`` — the canonical
+       per-option label store (the ``options`` column itself stays a
+       format-constrained CSV of values; labels live in field_config).
+    2. ``option.label_i18n[locale]`` — inline translation, for picklists
+       stored in the JSON ``[{value,text,label_i18n}]`` form.
+    3. The option's stored ``text`` — left unchanged.
+
+    ``table_name`` / ``field_name`` / ``field_id`` are accepted for
+    call-signature compatibility but no longer used.
+    """
+    _ = (table_name, field_name, field_id)
+    picked = locale
+    if not picked:
+        try:
+            from hermes.crm.i18n.service import get_current_locale
+            picked = get_current_locale()
+        except Exception:
+            picked = ""
+
+    option_labels = _coerce_dict(field_config).get("option_labels")
+    if not isinstance(option_labels, dict):
+        option_labels = {}
+
+    out: list[dict[str, Any]] = []
+    for opt in (options or []):
+        if not isinstance(opt, dict):
+            continue
+        o = dict(opt)
+        if picked:
+            ext = option_labels.get(str(o.get("value") or ""))
+            i18n = o.get("label_i18n")
+            translated = ""
+            if isinstance(ext, dict):
+                translated = str(ext.get(picked) or "").strip()
+            if not translated and isinstance(i18n, dict):
+                translated = str(i18n.get(picked) or "").strip()
+            if translated:
+                o["text"] = translated
+        out.append(o)
+    return out
+
+
+def option_matches_value(option: dict[str, Any], value: Any) -> bool:
+    candidate = str(value or "").strip()
+    if not candidate:
+        return False
+    opt_value = str(option.get("value") or "").strip()
+    opt_text = str(option.get("text") or "").strip()
+    return candidate == opt_value or candidate == opt_text
+
+
+def display_text_for_picklist_key(raw_options: Any, key: str) -> Optional[str]:
+    """
+    根据选项定义中 value/key 解析应显示在主列的文案（优先 options[].text，否则 value）。
+    用于业务表 `{field_name}_key` → `{field_name}` 回填。
+    """
+    k = str(key or "").strip()
+    if not k:
+        return None
+    for opt in parse_picklist_options(raw_options):
+        if option_matches_value(opt, k):
+            text = str(opt.get("text") if opt.get("text") not in (None, "") else "").strip()
+            value = str(opt.get("value") if opt.get("value") not in (None, "") else opt.get("text") or "").strip()
+            disp = text or value
+            return disp if disp else None
+    return None
+
+
+def normalize_submitted_picklist_value(raw_options: Any, submitted: Any) -> Any:
+    if submitted in (None, ""):
+        return submitted
+    submitted_str = str(submitted).strip()
+    if not submitted_str:
+        return submitted
+    for opt in parse_picklist_options(raw_options):
+        if option_matches_value(opt, submitted_str):
+            normalized = str(opt.get("value") or "").strip()
+            return normalized or submitted_str
+    return submitted
+
+
+def select_display_and_key_for_db(options_raw: Any, processed_value: Any) -> Tuple[Any, Any]:
+    """
+    业务表 select 双列存储：主列存展示文案，`{field}_key` 存选项 value（与 module_fields.options[].value 一致）。
+    processed_value 为 SaveValidator.validate_field / normalize_submitted_picklist_value 之后的值（选项 key 或空）。
+    返回 (main_column_value, key_column_value)；清空时为 (None, None) 以便写入 NULL。
+    """
+    if processed_value is None:
+        return None, None
+    if isinstance(processed_value, str) and not str(processed_value).strip():
+        return None, None
+    pk_s = str(processed_value).strip()
+    disp = display_text_for_picklist_key(options_raw, pk_s)
+    main = disp if disp is not None else pk_s
+    return main, pk_s
+
+
+def normalize_submitted_multiselect_values(raw_options: Any, values: list[Any]) -> list[str]:
+    options = parse_picklist_options(raw_options)
+    out: list[str] = []
+    for value in values or []:
+        if value in (None, ""):
+            continue
+        value_str = str(value).strip()
+        if not value_str:
+            continue
+        normalized = value_str
+        for opt in options:
+            if option_matches_value(opt, value_str):
+                normalized = str(opt.get("value") or value_str).strip() or value_str
+                break
+        out.append(normalized)
+    return out
diff --git a/crm/i18n/response_localizer.py b/crm/i18n/response_localizer.py
