+    m=NS(content='', tool_calls=[_mock_tool_call(name='web_search',call_id='id')])
+    target=patch.object(a,'_invoke_tool',return_value='ok') if concurrent else patch('model_tools.handle_function_call',return_value='ok')
+    with target, patch('agent.tool_executor.maybe_persist_tool_result',side_effect=lambda **kw:kw['content']):
+        (a._execute_tool_calls_concurrent if concurrent else a._execute_tool_calls_sequential)(m,messages,'task')
