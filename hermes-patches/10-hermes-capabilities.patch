+"""Pull a CRM record + recent interactions into a dict for skill prompts."""
+from __future__ import annotations
+from typing import Any, Dict, List, Optional
+from hermes.crm.db import db_session
+
+
+def _select_safe_fields(table: str, fields: List[str]) -> List[str]:
+    with db_session() as db:
+        rows = db.fetchall(
+            "SELECT column_name FROM information_schema.columns "
+            "WHERE table_schema = current_schema() AND table_name = %s",
+            (table,),
+        ) or []
+    cols = {r["column_name"] for r in rows}
+    return [f for f in fields if f in cols]
+
+
+def fetch_record_for_skill(
+    module: str, record_id: int, *, interaction_limit: int = 5,
+) -> Optional[Dict[str, Any]]:
+    pk_col = f"{module}_id"
+    name_col = f"{module}_name"
+    candidates = [pk_col, name_col, "milestone", "amount", "probability",
+                  "next_step", "closing_date", "accounts_id", "contacts_id",
+                  "owner_user_id", "creator_user_id", "updated_at", "created_at"]
+    fields = _select_safe_fields(module, candidates)
+    if pk_col not in fields or name_col not in fields:
+        return None
+    select_sql = ", ".join(fields)
+    with db_session() as db:
+        row = db.fetchone(
+            f"SELECT {select_sql} FROM {module} WHERE {pk_col} = %s AND deleted = false",
+            (int(record_id),),
+        )
+        if not row:
+            return None
+        out: Dict[str, Any] = dict(row)
+        out["__module"] = module
+        out["__record_id"] = int(record_id)
+        try:
+            ints = db.fetchall(
+                "SELECT i.kind, i.occurred_at, i.content "
+                "FROM interactions i JOIN interaction_subjects s ON s.interaction_id = i.id "
+                "WHERE s.module = %s AND s.record_id = %s "
+                "ORDER BY i.occurred_at DESC LIMIT %s",
+                (module, int(record_id), int(interaction_limit)),
+            ) or []
+        except Exception:
+            ints = []
+        out["__recent_interactions"] = [
+            {"kind": str(r["kind"]), "at": str(r["occurred_at"]),
+             "preview": _interaction_preview(r["content"])} for r in ints
+        ]
+    return out
+
+
+def _interaction_preview(content: Any) -> str:
+    if not isinstance(content, dict):
+        return ""
+    for key in ("text", "preview", "summary", "note", "subject"):
+        v = content.get(key)
+        if isinstance(v, str) and v.strip():
+            return v.strip()[:120]
+    return ""
