+def _dispatch_set_approval_chain(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    module_name = str(arguments.get("module_name") or "").strip()
+    steps = arguments.get("steps") or []
+    allow_edit = int(arguments.get("allow_edit_after_approve") or 0)
+    if not module_name:
+        raise ValueError("module_name is required")
+    if not isinstance(steps, list) or not steps:
+        raise ValueError("steps must be a non-empty array")
+
+    # Normalize + validate: every step needs approver_ids, step_name optional.
+    norm_steps: List[Dict[str, Any]] = []
+    for i, s in enumerate(steps):
+        if not isinstance(s, dict):
+            raise ValueError(f"step {i} must be an object")
+        ids = s.get("approver_ids") or s.get("users") or []
+        if not isinstance(ids, list) or not ids:
+            raise ValueError(f"step {i}: approver_ids must be a non-empty array")
+        norm_steps.append({
+            "step_name": str(s.get("step_name") or f"Step {i + 1}"),
+            "approver_ids": [int(x) for x in ids],
+        })
+
+    from hermes.crm.approval.engine import ApprovalEngine
+    from hermes.crm.models.modules_db import ModulesDb
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        _require_admin(db, user_id)
+        mod = ModulesDb(db).get_module_by_name(module_name)
+        if not mod:
+            raise ValueError(f"module {module_name!r} not found")
+        ApprovalEngine(db).save_config(
+            int(mod["id"]), norm_steps, allow_edit_after_approve=allow_edit
+        )
+        return {
+            "success": True,
+            "module_name": module_name,
+            "steps": norm_steps,
+            "allow_edit_after_approve": allow_edit,
+            "message": f"已为 {module_name} 设置 {len(norm_steps)} 级审批链。",
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
