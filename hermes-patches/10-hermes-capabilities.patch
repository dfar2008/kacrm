diff --git a/tests/skills/conftest.py b/tests/skills/conftest.py
new file mode 100644
index 0000000000..1af9457464
--- /dev/null
+++ b/tests/skills/conftest.py
@@ -0,0 +1,96 @@
+"""hermes_cloud overlay (patch 10) — skip skill tests whose skill was pruned.
+
+Patch 15 deletes the upstream-bundled skills the CRM deployment doesn't ship
+(apple / creative / productivity / research / ...). Upstream's tests/skills
+read those skill dirs at module import time with no existence guard
+(``SETUP_PY.read_text()``, ``sys.path.insert(<skill scripts dir>)``), so
+collecting them raises FileNotFoundError / ModuleNotFoundError — hundreds of
+red tests that say nothing about the port.
+
+Instead of hand-maintaining a file list (which breaks every upgrade when
+upstream adds skill tests), scan each test module's source for the skill
+directories it references and ignore the module iff any referenced skill no
+longer exists. New upstream skill tests are auto-ignored exactly when their
+skill is pruned, and auto-collected again if the skill is ever un-pruned.
+"""
+from __future__ import annotations
+
+import re
+
+import pytest
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent
+_SKILLS_ROOT = _HERE.parents[1] / "skills"
+
+# Both reference styles used by upstream skill tests:
+#   REPO / "skills" / "creative" / ...      (pathlib segments)
+#   "skills/productivity/google-workspace"  (plain path strings)
+_PATHLIB_REF = re.compile(
+    r'["\']skills["\']((?:\s*/\s*["\'][\w.-]+["\'])+)'
+)
+_SEGMENT = re.compile(r'["\']([\w.-]+)["\']')
+_STRING_REF = re.compile(r'(?<![\w-])skills/([\w.-]+(?:/[\w.-]+)*)')
+
+
+def _referenced_skill_dirs(source):
+    paths = [_SEGMENT.findall(match.group(1)) for match in _PATHLIB_REF.finditer(source)]
+    paths += [match.split("/") for match in _STRING_REF.findall(source)]
+    for parts in paths:
+        # Categories can survive the prune while an individual skill is gone
+        # (media/youtube-content). Only the category and skill identify the
+        # shipped skill; scripts and filenames belong to its contents.
+        yield Path(*parts[:2])
+
+# Upstream editorial CI over the WHOLE skills/ tree. After the prune, every
+# remaining skill is a cloud-authored one (crm-* / kacrm-guide /
+# schema-evolution), so these modules would only lint OUR skills against
+# upstream's authoring standards for THEIR skill authors (English marketing-
+# word bans, size caps, population counts) — noise for this deployment.
+collect_ignore = [
+    "test_authoring_standards.py",
+    # Generated upstream pages and the upstream blueprint catalog describe
+    # the bundled skills deliberately removed by patch 15.
+    "test_skill_pages_match_shipped_skills.py",
+    "test_weekly_review_planning_skill.py",
+    # optional-skills/ is not pruned, but this optional skill's
+    # ``related_skills`` frontmatter cross-references ``xurl``, which lived
+    # under the pruned skills/social-media/ — the resolve-in-repo assertion
+    # can never pass without restoring that skill.
+    "test_social_media_content_calendar_skill.py",
+]
+for _test_file in _HERE.glob("test_*.py"):
+    try:
+        _src = _test_file.read_text(encoding="utf-8", errors="ignore")
+    except OSError:
+        continue
+    _referenced = set(_referenced_skill_dirs(_src))
+    _missing = [
+        name for name in _referenced
+        if not (_SKILLS_ROOT / name).is_dir()
+    ]
+    if _missing:
+        collect_ignore.append(_test_file.name)
+
+
+class _PrunedSkillModule(pytest.Module):
+    def collect(self):
+        # The isolated runner passes individual files explicitly, bypassing
+        # pytest's directory-level collect_ignore. Never import a pruned skill.
+        return []
+
+
+def pytest_pycollect_makemodule(module_path, parent):
+    if module_path.name in collect_ignore:
+        return _PrunedSkillModule.from_parent(parent, path=module_path)
+
+
+def pytest_collection_modifyitems(items):
+    for item in items:
+        if (item.path.name == "test_skill_blueprint_contracts.py"
+                and item.originalname == "test_every_blueprint_skill_is_bundled"):
+            item.add_marker(pytest.mark.skip(reason=(
+                "KaCRM patch 15 prunes skills referenced by upstream's optional "
+                "blueprints; their bundled-skill completeness check does not "
+                "apply. Blueprint rendering and scheduling tests still run."
+            )))
diff --git a/tests/test_hermes_state_cloud_tap.py b/tests/test_hermes_state_cloud_tap.py
new file mode 100644
index 0000000000..ef9e8ec4d9
--- /dev/null
+++ b/tests/test_hermes_state_cloud_tap.py
@@ -0,0 +1,150 @@
+"""Charter §一定律 1 + 原语 ① — agent message → cloud Interaction Log tap.
+
+When ``HERMES_CLOUD_AGENT_EVENT_URL`` + ``HERMES_CLOUD_INTERNAL_KEY``
+are set (hermes-cloud's ProfileManager sets them when launching this
+subprocess), every successful ``SessionDB.append_message()`` POSTs the
+message to cloud's ``/internal/agent/event`` so it lands in the
+canonical ``interactions`` table. State.db is dual-written so hermes'
+own agent loop (compaction / context replay) keeps reading sqlite
+unchanged; cloud-side endpoints read PG exclusively.
+
+These tests pin:
+
+* No env vars → no POST (CLI / test environments stay quiet).
+* Env vars set → POST fires with the right shape and auth header.
+* Cloud unreachable → exception swallowed, sqlite still writes.
+* Profile ID derives from path when env var absent (legacy fallback).
+"""
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import urllib.request
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def db():
+    tmpdir = Path(tempfile.mkdtemp())
+    inst = SessionDB(db_path=tmpdir / "state.db")
+    inst.create_session("sess-test", source="test", user_id="42")
+    yield inst
+    inst.close()
+
+
+@pytest.fixture
+def clean_env(monkeypatch):
+    """Strip cloud env vars so each test starts from a known state."""
+    for k in ("HERMES_CLOUD_AGENT_EVENT_URL",
+              "HERMES_CLOUD_INTERNAL_KEY",
+              "HERMES_CLOUD_PROFILE_ID",
+              "HERMES_AGENT_NAME"):
+        monkeypatch.delenv(k, raising=False)
+
+
+def _fake_urlopen_capturing():
+    posted: list = []
+    def _fake(req, timeout=None):
+        posted.append({"url": req.full_url, "data": req.data,
+                       "headers": dict(req.headers)})
+        m = MagicMock()
+        m.__enter__ = MagicMock(return_value=MagicMock(status=200))
+        m.__exit__ = MagicMock(return_value=False)
+        return m
+    return _fake, posted
+
+
+def test_no_post_without_env_vars(db, clean_env):
+    """CLI / test path: env vars not set → no cloud call."""
+    fake, posted = _fake_urlopen_capturing()
+    with patch.object(urllib.request, "urlopen", fake):
+        db.append_message(session_id="sess-test", role="assistant", content="hi")
+    assert posted == []
+
+
+def test_post_fires_with_env_vars(db, monkeypatch, clean_env):
+    monkeypatch.setenv("HERMES_CLOUD_AGENT_EVENT_URL",
+                       "http://cloud.local/internal/agent/event")
+    monkeypatch.setenv("HERMES_CLOUD_INTERNAL_KEY", "secret-key")
+    monkeypatch.setenv("HERMES_CLOUD_PROFILE_ID", "42")
+
+    fake, posted = _fake_urlopen_capturing()
+    with patch.object(urllib.request, "urlopen", fake):
+        db.append_message(
+            session_id="sess-test", role="user", content="my question",
+            token_count=15,
+        )
+
+    assert len(posted) == 1
+    assert posted[0]["url"] == "http://cloud.local/internal/agent/event"
+    assert posted[0]["headers"]["X-internal-key"] == "secret-key"
+    payload = json.loads(posted[0]["data"])
+    assert payload["profile_id"] == "42"
+    assert payload["session_id"] == "sess-test"
+    assert payload["role"] == "user"
+    assert payload["text"] == "my question"
+    assert payload["agent_name"] == "hermes"  # default when HERMES_AGENT_NAME unset
+    assert payload["tokens"] == {"input": 15}
+
+
+def test_agent_name_env_var_overrides_default(db, monkeypatch, clean_env):
+    monkeypatch.setenv("HERMES_CLOUD_AGENT_EVENT_URL", "http://x/y")
+    monkeypatch.setenv("HERMES_CLOUD_INTERNAL_KEY", "k")
+    monkeypatch.setenv("HERMES_CLOUD_PROFILE_ID", "42")
+    monkeypatch.setenv("HERMES_AGENT_NAME", "research")
+
+    fake, posted = _fake_urlopen_capturing()
+    with patch.object(urllib.request, "urlopen", fake):
+        db.append_message(session_id="sess-test", role="assistant", content="x")
+
+    payload = json.loads(posted[0]["data"])
+    assert payload["agent_name"] == "research"
+
+
+def test_cloud_unreachable_does_not_break_sqlite(db, monkeypatch, clean_env):
+    """A cloud blip must not lose the message: sqlite still writes."""
+    monkeypatch.setenv("HERMES_CLOUD_AGENT_EVENT_URL", "http://cloud.local/x")
+    monkeypatch.setenv("HERMES_CLOUD_INTERNAL_KEY", "k")
+    monkeypatch.setenv("HERMES_CLOUD_PROFILE_ID", "42")
+
+    def _boom(*a, **kw):
+        raise ConnectionError("cloud down")
+
+    with patch.object(urllib.request, "urlopen", _boom):
+        msg_id = db.append_message(
+            session_id="sess-test", role="tool", content="result",
+            tool_call_id="c1", tool_name="crm_write",
+        )
+    assert msg_id  # sqlite write succeeded; lastrowid returned
+
+    msgs = db.get_messages("sess-test")
+    assert any(m["role"] == "tool" and m["content"] == "result" for m in msgs)
+
+
+def test_profile_id_falls_back_to_path(monkeypatch, clean_env, tmp_path):
+    """When HERMES_CLOUD_PROFILE_ID is unset (legacy / non-managed boot),
+    derive profile_id from the db path so the cloud endpoint's
+    profile_id-required validator doesn't 400 us."""
+    profile_dir = tmp_path / "profiles" / "user-99"
+    profile_dir.mkdir(parents=True)
+    db = SessionDB(db_path=profile_dir / "state.db")
+    db.create_session("s1", source="test", user_id="99")
+    try:
+        monkeypatch.setenv("HERMES_CLOUD_AGENT_EVENT_URL", "http://x/y")
+        monkeypatch.setenv("HERMES_CLOUD_INTERNAL_KEY", "k")
+        # NB: HERMES_CLOUD_PROFILE_ID intentionally NOT set.
+
+        fake, posted = _fake_urlopen_capturing()
+        with patch.object(urllib.request, "urlopen", fake):
+            db.append_message(session_id="s1", role="assistant", content="x")
+
+        payload = json.loads(posted[0]["data"])
+        assert payload["profile_id"] == "user-99"
+    finally:
+        db.close()
