+# Schema-evolution propose-only handlers (Charter v2 §定律 5, 2026-05-06)
+# ---------------------------------------------------------------------------
+
+
+import re as _re_field_name
+_FIELD_NAME_RE_LOCAL = _re_field_name.compile(r"^[a-zA-Z][a-zA-Z0-9_]{0,31}$")
+_OPTION_VALUE_RE = _re_field_name.compile(r"^[a-zA-Z][a-zA-Z0-9_]{0,31}$")
+
+
+def _agent_proposer_label(
+    profile_id: Optional[str], agent_name: Optional[str]
+) -> str:
+    """Build a proposer label that identifies which profile/agent filed
+    the proposal — mirrors the ``agent:<profile>:<agent>`` convention
+    used by ``interactions.source`` so the admin queue surfaces the
+    actual originator instead of a flat ``agent:hermes``."""
+    pid = (profile_id or "").strip()
+    aname = (agent_name or "").strip()
+    if pid and aname:
+        return f"agent:{pid}:{aname}"
+    if pid:
+        return f"agent:{pid}"
+    if aname:
+        return f"agent:{aname}"
+    return "agent"
+
+
+def _dispatch_propose_new_field(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str] = None,
+    agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Drop a pending row in ``field_proposals`` for admin review.
+
+    Mirrors :func:`hermes_cloud.app.copilot.tools._exec_propose_new_field`
+    but runs in the main-agent dispatch path (not the per-record copilot).
+    Same safety rails: type whitelist, dedup, collision check.
+    """
+
+    module_name = str(arguments.get("module_name") or "").strip()
+    field_name = str(arguments.get("field_name") or "").strip()
+    field_label = str(arguments.get("field_label") or "").strip()
+    field_type = str(arguments.get("field_type") or "").strip()
+    reason = str(arguments.get("reason") or "").strip()
+    options_in = arguments.get("options")
+    is_required = bool(arguments.get("is_required") or False)
+
+    if not module_name:
+        return {"success": False, "error": "module_name is required"}
+    if not field_name or not _FIELD_NAME_RE_LOCAL.match(field_name):
+        return {"success": False, "error": "Invalid 'field_name' — letters/digits/underscore, must start with a letter, ≤32 chars."}
+    if not field_label or len(field_label) > _FIELD_LABEL_MAX_LEN:
+        return {"success": False, "error": f"Invalid 'field_label' (1-{_FIELD_LABEL_MAX_LEN} chars)."}
+    if field_type not in _AGENT_PROPOSABLE_FIELD_TYPES:
+        return {"success": False, "error": f"Invalid 'field_type' '{field_type}'. Allowed: {sorted(_AGENT_PROPOSABLE_FIELD_TYPES)}"}
+    if len(reason) < _REASON_MIN_LEN:
+        return {"success": False, "error": f"'reason' too short (<{_REASON_MIN_LEN} chars) — explain what conversation data motivates this field."}
+
+    options_csv: List[str] = []
+    if field_type == "picklist":
+        if not isinstance(options_in, list) or not options_in:
+            return {"success": False, "error": "'picklist' field requires non-empty 'options' array."}
+        for raw in options_in:
+            v = str(raw).strip()
+            if not v:
+                continue
+            if v in options_csv:
+                continue
+            options_csv.append(v)
+        if not options_csv:
+            return {"success": False, "error": "'options' had no usable values"}
+    elif options_in:
+        return {"success": False, "error": f"'options' valid only for picklist, not '{field_type}'"}
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        mod = ModulesDb(db).get_module_by_name(module_name)
+        if not mod:
+            return {"success": False, "error": f"unknown module {module_name!r}"}
+        module_id = int(mod["id"])
+
+        existing = ModuleFieldsDb(db).get_field_by_name(module_id, field_name)
+        if existing is not None:
+            return {
+                "success": False,
+                "error": f"Field '{field_name}' already exists on '{module_name}' "
+                         f"(type={existing.get('field_type')}). Use crm_write or "
+                         f"crm_propose_picklist_option instead.",
+            }
+
+        proposals = FieldProposalsDb(db)
+
+        # Dedup against pending proposals on same field_name + module.
+        pending = proposals.find_pending_by_field_name(module_id, field_name)
+        if pending:
+            return {
+                "success": True,
+                "deduped": True,
+                "proposal_id": int(pending["id"]),
+                "status": "pending",
+                "message": f"Existing pending proposal #{pending['id']} for '{field_name}' "
+                           f"already in admin queue — not creating a duplicate.",
+            }
+
+        payload = {
+            "kind": "field_add",
+            "field_name": field_name,
+            "field_label": field_label,
+            "field_type": field_type,
+            "is_required": is_required,
+            "reason": reason,
+        }
+        if options_csv:
+            payload["options"] = options_csv
+
+        pid = proposals.insert_proposal(
+            proposer_type="agent",
+            proposer_id=int(user_id) if user_id else None,
+            proposer_label=_agent_proposer_label(profile_id, agent_name),
+            module_id=module_id,
+            module_name=module_name,
+            payload=payload,
+        )
+        return {
+            "success": True,
+            "proposal_id": int(pid),
+            "status": "pending",
+            "message": f"Proposal #{pid} queued for admin review at /admin/schema (Proposals tab).",
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _dispatch_propose_picklist_option(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str] = None,
+    agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Drop a pending picklist-option proposal in ``field_proposals``.
+
+    Payload shape ``{"kind": "picklist_option_add", "field_name": ...,
+    "value": ..., "label": ..., "reason": ...}``. Approval handler in
+    ``crm/routes/__init__.py`` dispatches on ``payload.kind``.
+    """
+
+    module_name = str(arguments.get("module_name") or "").strip()
+    field_name = str(arguments.get("field_name") or "").strip()
+    value = str(arguments.get("value") or "").strip()
+    label = str(arguments.get("label") or "").strip()
+    reason = str(arguments.get("reason") or "").strip()
+
+    if not module_name:
+        return {"success": False, "error": "module_name is required"}
+    if not field_name:
+        return {"success": False, "error": "field_name is required"}
+    if not value or not _OPTION_VALUE_RE.match(value):
+        return {"success": False, "error": "Invalid 'value' — letters/digits/underscore, must start with a letter, ≤32 chars (snake_case)."}
+    if not label or len(label) > _FIELD_LABEL_MAX_LEN:
+        return {"success": False, "error": f"Invalid 'label' (1-{_FIELD_LABEL_MAX_LEN} chars)."}
+    if len(reason) < _REASON_MIN_LEN:
+        return {"success": False, "error": f"'reason' too short (<{_REASON_MIN_LEN} chars) — cite the user phrasing that didn't fit."}
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        mod = ModulesDb(db).get_module_by_name(module_name)
+        if not mod:
+            return {"success": False, "error": f"unknown module {module_name!r}"}
+        module_id = int(mod["id"])
+
+        target_field = ModuleFieldsDb(db).get_field_by_name(module_id, field_name)
+        if target_field is None:
+            return {
+                "success": False,
+                "error": f"Field '{field_name}' not found on '{module_name}'. "
+                         f"If you want a brand-new field, use crm_propose_new_field.",
+            }
+        ftype = str(target_field.get("field_type") or "").lower()
+        if ftype not in ("picklist", "select", "radio"):
+            return {
+                "success": False,
+                "error": f"Field '{field_name}' is type '{ftype}', not a picklist. "
+                         f"Cannot propose options for non-picklist fields.",
+            }
+
+        # Already-present check — tolerate dict {value, text} or string forms.
+        existing_opts = parse_picklist_options(target_field.get("options"))
+        for opt in existing_opts:
+            opt_v = str(opt.get("value") or "").strip()
+            opt_t = str(opt.get("text") or "").strip()
+            if opt_v == value or opt_t == label:
+                return {
+                    "success": True,
+                    "noop": True,
+                    "message": f"Option value={value!r}/label={label!r} already exists on "
+                               f"'{module_name}.{field_name}' (no-op).",
+                }
+
+        proposals = FieldProposalsDb(db)
+
+        # Dedup: same kind + field_name + value combination already pending?
+        pending = db.fetchone(
+            """
+            SELECT id FROM field_proposals
+            WHERE module_id = %s AND status = 'pending'
+              AND payload->>'kind' = 'picklist_option_add'
+              AND payload->>'field_name' = %s
+              AND payload->>'value' = %s
+            ORDER BY ts DESC LIMIT 1
+            """,
+            (module_id, field_name, value),
+        )
+        if pending:
+            return {
+                "success": True,
+                "deduped": True,
+                "proposal_id": int(pending["id"]),
+                "status": "pending",
+                "message": f"Existing pending proposal #{pending['id']} already covers "
+                           f"value={value!r} on '{field_name}'.",
+            }
+
+        payload = {
+            "kind": "picklist_option_add",
+            "field_name": field_name,
+            "value": value,
+            "label": label,
+            "reason": reason,
+        }
+        pid = proposals.insert_proposal(
+            proposer_type="agent",
+            proposer_id=int(user_id) if user_id else None,
+            proposer_label=_agent_proposer_label(profile_id, agent_name),
+            module_id=module_id,
+            module_name=module_name,
+            payload=payload,
+        )
+        return {
+            "success": True,
+            "proposal_id": int(pid),
+            "status": "pending",
+            "message": f"Proposal #{pid} queued — once admin approves, "
+                       f"'{label}' becomes a selectable value on '{field_name}'.",
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _dispatch_semantic_search(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    query = str(arguments.get("query") or "").strip()
+    if not query:
+        raise ValueError("query is required")
+    kind = arguments.get("kind") or None
+    top_k = int(arguments.get("top_k") or 10)
+    min_sim = float(arguments.get("min_similarity") or 0.0)
+
+    from hermes.memory.vector_store import search_memories
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        rows = search_memories(
+            query=query,
+            user_id=int(user_id) if user_id else None,
+            kind=kind,
+            top_k=top_k,
+            min_similarity=min_sim,
+            db=db,
+        )
+        return {
+            "query": query,
+            "count": len(rows),
+            "results": rows,
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _dispatch_entity_subgraph(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    entity_type = str(arguments.get("entity_type") or "").strip()
+    canonical = str(arguments.get("canonical") or "").strip()
+    depth = int(arguments.get("depth") or 1)
+    if not (entity_type and canonical):
+        raise ValueError("entity_type and canonical are required")
+
+    from hermes.memory.entities import find_entity, subgraph
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        ent = find_entity(
+            entity_type=entity_type, canonical=canonical,
+            user_id=int(user_id) if user_id else None, db=db,
+        )
+        if not ent:
+            # Also try org-scoped
+            ent = find_entity(
+                entity_type=entity_type, canonical=canonical,
+                user_id=None, db=db,
+            )
+        if not ent:
+            return {
+                "entity_type": entity_type,
+                "canonical": canonical,
+                "found": False,
+                "entities": [],
+                "edges": [],
+            }
+        graph = subgraph(entity_id=int(ent["id"]), depth=depth, db=db)
+        graph.update({
+            "entity_type": entity_type,
+            "canonical": canonical,
+            "found": True,
+            "root_id": int(ent["id"]),
+        })
+        return graph
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
