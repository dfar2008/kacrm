diff --git a/crm/models/changelog_db.py b/crm/models/changelog_db.py
new file mode 100644
index 0000000000..85ea38088c
--- /dev/null
+++ b/crm/models/changelog_db.py
@@ -0,0 +1,98 @@
+"""Changelog gateway — ported from kacrm's ``app/models/changelog_db.py``.
+
+Every field change is recorded as one row. kacrm's ItemDelete / SaveBase /
+Approve all funnel through :meth:`log_field_change`, so the shape and
+argument order are kept identical for drop-in compatibility.
+
+Port notes:
+  * ``updated_at`` is TIMESTAMPTZ (set via DB default ``now()`` — we don't
+    pass an explicit timestamp like kacrm's ``strftime("%Y-%m-%d %H:%M:%S")``
+    any more, PG handles it).
+  * ``field_type`` is truncated to 20 chars (matches kacrm's VARCHAR(20)
+    column width).
+"""
+from __future__ import annotations
+
+from typing import Any, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class ChangelogDb:
+    """Table gateway over ``changelog``."""
+
+    FIELD_TYPE_MAX_LEN = 20
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    def get_by_module_and_data(
+        self,
+        module_id: int,
+        data_id: int,
+        limit: Optional[int] = None,
+        offset: Optional[int] = None,
+    ) -> List[dict]:
+        sql = (
+            "SELECT c.*, u.realname AS updater_name FROM changelog c "
+            "LEFT JOIN users u ON c.updated_by = u.id "
+            "WHERE c.module_id = %s AND c.data_id = %s "
+            "ORDER BY c.updated_at DESC, c.tracking_id DESC"
+        )
+        if limit is not None:
+            sql += f" LIMIT {int(limit)}"
+            if offset is not None:
+                sql += f" OFFSET {int(offset)}"
+        return self._run(
+            lambda db: db.fetchall(sql, (int(module_id), int(data_id)))
+        )
+
+    def log_field_change(
+        self,
+        module_id: int,
+        data_id: int,
+        field_name: str,
+        field_label: str,
+        field_type: str,
+        old_value: Any,
+        new_value: Any,
+        updated_by: int,
+        tracking_id: Optional[str] = None,
+        commit: bool = True,
+    ) -> None:
+        safe_field_type = (field_type or "text").strip() or "text"
+        if len(safe_field_type) > self.FIELD_TYPE_MAX_LEN:
+            safe_field_type = safe_field_type[: self.FIELD_TYPE_MAX_LEN]
+        params = (
+            int(module_id),
+            int(data_id),
+            field_name,
+            field_label or "",
+            safe_field_type,
+            str(old_value) if old_value is not None else "",
+            str(new_value) if new_value is not None else "",
+            int(updated_by) if updated_by is not None else None,
+        )
+        # ``tracking_id`` in kacrm is a VARCHAR correlation token; our PG
+        # schema made ``tracking_id`` the BIGSERIAL PK instead, so we don't
+        # pass it through — let the DB assign the PK. The name stays in the
+        # kwarg list for call-site compat (ItemDelete / SaveBase).
+        _ = tracking_id
+        self._run(
+            lambda db: db.execute(
+                """
+                INSERT INTO changelog
+                    (module_id, data_id, field_name, field_label,
+                     field_type, old_value, new_value, updated_by)
+                VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
+                """,
+                params,
+                commit=commit,
+            )
+        )
diff --git a/crm/models/departments_db.py b/crm/models/departments_db.py
new file mode 100644
index 0000000000..e83d94b64b
--- /dev/null
+++ b/crm/models/departments_db.py
@@ -0,0 +1,251 @@
+"""Departments table gateway — ported from kacrm's
+``app/models/departments_db.py``.
+
+Port notes (kacrm MySQL → hermes_crm PostgreSQL):
+  - ``deleted = 0 OR deleted IS NULL`` → ``deleted = FALSE`` (users side).
+  - kacrm stored ``manager_ids`` as a ``#1#2#3#`` delimited string and searched
+    with ``LIKE '%#<id>#%'``. In PG we store it as ``JSONB`` (a JSON array of
+    ints), so the manager lookup becomes a JSON containment query. This is a
+    breaking change for any kacrm code that formats the delimited string — it's
+    documented here so callers know not to pass the old format.
+  - kacrm's ``get_department_users_paginated`` joined ``users u`` with
+    ``d, r`` aliases and selected ``u.*`` — preserved verbatim.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class DepartmentsDb:
+    """Table gateway over the ``departments`` table."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_all_departments(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall("SELECT * FROM departments ORDER BY name")
+        )
+
+    def get_department_by_id(self, dept_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM departments WHERE id = %s", (dept_id,)
+            )
+        )
+
+    def get_department_list(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT id, name FROM departments ORDER BY name"
+            )
+        )
+
+    def get_department_id_by_name(self, name: str) -> Optional[int]:
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT id FROM departments WHERE name = %s", (name,)
+            )
+        )
+        return int(row["id"]) if row and row.get("id") else None
+
+    def name_exists(self, name: str, exclude_id: Optional[int] = None) -> bool:
+        def _q(db: DbWrapper) -> int:
+            if exclude_id is not None:
+                return db.fetchcolumn(
+                    "SELECT COUNT(*) FROM departments WHERE name = %s AND id != %s",
+                    (name, exclude_id),
+                )
+            return db.fetchcolumn(
+                "SELECT COUNT(*) FROM departments WHERE name = %s", (name,)
+            )
+
+        return (self._run(_q) or 0) > 0
+
+    def department_exists(self, dept_id: int) -> bool:
+        n = self._run(
+            lambda db: db.fetchcolumn(
+                "SELECT COUNT(*) FROM departments WHERE id = %s", (dept_id,)
+            )
+        )
+        return (n or 0) > 0
+
+    def get_departments_by_level(
+        self, parent_id: Optional[int] = None
+    ) -> List[Dict[str, Any]]:
+        if parent_id is None:
+            return self._run(
+                lambda db: db.fetchall(
+                    "SELECT d.* FROM departments d WHERE d.parent_id IS NULL"
+                )
+            )
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT d.* FROM departments d WHERE d.parent_id = %s",
+                (parent_id,),
+            )
+        )
+
+    def _get_child_department_ids(
+        self, db: DbWrapper, parent_id: int
+    ) -> List[int]:
+        rows = db.fetchall(
+            "SELECT id FROM departments WHERE parent_id = %s", (parent_id,)
+        )
+        children = [int(r["id"]) for r in rows]
+        for r in rows:
+            children.extend(self._get_child_department_ids(db, int(r["id"])))
+        return children
+
+    def get_department_and_children_ids(self, department_id: int) -> List[int]:
+        return self._run(
+            lambda db: [department_id]
+            + self._get_child_department_ids(db, department_id)
+        )
+
+    # ---- users-in-departments views (kacrm parity) --------------------
+
+    def get_users_with_department_info(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                """
+                SELECT u.id, u.realname, u.username, u.avatar, u.department_id,
+                       d.name AS department_name
+                FROM users u
+                LEFT JOIN departments d ON u.department_id = d.id
+                WHERE u.status = 1 AND u.deleted = FALSE
+                ORDER BY d.name, u.realname
+                """
+            )
+        )
+
+    def get_users_with_department_info_by_department_ids(
+        self, department_ids: List[int]
+    ) -> List[Dict[str, Any]]:
+        if not department_ids:
+            return []
+        placeholders = ",".join(["%s"] * len(department_ids))
+        return self._run(
+            lambda db: db.fetchall(
+                f"""
+                SELECT u.id, u.realname, u.username, u.avatar, u.department_id,
+                       d.name AS department_name
+                FROM users u
+                LEFT JOIN departments d ON u.department_id = d.id
+                WHERE u.status = 1 AND u.deleted = FALSE
+                  AND u.department_id IN ({placeholders})
+                ORDER BY d.name, u.realname
+                """,
+                tuple(department_ids),
+            )
+        )
+
+    def get_manager_department_users(self, manager_id: int) -> List[int]:
+        """Users under any department whose ``manager_ids`` JSON array contains
+        *manager_id*.
+        """
+        rows = self._run(
+            lambda db: db.fetchall(
+                """
+                SELECT u.id FROM departments d
+                LEFT JOIN users u ON u.department_id = d.id
+                WHERE d.manager_ids @> %s::jsonb
+                  AND u.id IS NOT NULL
+                  AND u.deleted = FALSE
+                """,
+                (json.dumps([manager_id]),),
+            )
+        )
+        return [int(r["id"]) for r in (rows or []) if r.get("id")]
+
+    def get_department_users_paginated(
+        self, department_ids: List[int], limit: int, offset: int
+    ) -> Dict[str, Any]:
+        if not department_ids:
+            return {"users": [], "total": 0}
+        placeholders = ",".join(["%s"] * len(department_ids))
+
+        def _q(db: DbWrapper) -> Dict[str, Any]:
+            total = (
+                db.fetchcolumn(
+                    f"SELECT COUNT(*) FROM users WHERE deleted = FALSE "
+                    f"AND department_id IN ({placeholders})",
+                    tuple(department_ids),
+                )
+                or 0
+            )
+            users = db.fetchall(
+                f"""
+                SELECT u.*, d.name AS department_name, r.name AS role_name
+                FROM users u
+                LEFT JOIN departments d ON u.department_id = d.id
+                LEFT JOIN roles r       ON u.role_id = r.id
+                WHERE u.deleted = FALSE
+                  AND u.department_id IN ({placeholders})
+                ORDER BY u.id
+                LIMIT %s OFFSET %s
+                """,
+                tuple(department_ids) + (limit, offset),
+            )
+            return {"users": users, "total": int(total)}
+
+        return self._run(_q)
+
+    # ---- writes --------------------------------------------------------
+
+    def insert(self, data: Dict[str, Any]) -> int:
+        manager_ids = data.get("manager_ids")
+        if manager_ids is not None and not isinstance(manager_ids, str):
+            manager_ids = json.dumps(manager_ids)
+
+        def _q(db: DbWrapper) -> int:
+            db.insert(
+                "departments",
+                {
+                    "name": data.get("name"),
+                    "parent_id": data.get("parent_id"),
+                    "manager_ids": manager_ids,
+                    "description": data.get("description"),
+                },
+            )
+            return db.id() or 0
+
+        return self._run(_q)
+
+    def update(self, dept_id: int, data: Dict[str, Any]) -> None:
+        manager_ids = data.get("manager_ids")
+        if manager_ids is not None and not isinstance(manager_ids, str):
+            manager_ids = json.dumps(manager_ids)
+
+        def _q(db: DbWrapper) -> None:
+            db.execute(
+                "UPDATE departments SET name = %s, parent_id = %s, "
+                "manager_ids = %s, description = %s WHERE id = %s",
+                (
+                    data.get("name"),
+                    data.get("parent_id"),
+                    manager_ids,
+                    data.get("description"),
+                    dept_id,
+                ),
+            )
+
+        self._run(_q)
+
+    def delete(self, dept_id: int) -> None:
+        self._run(
+            lambda db: db.execute(
+                "DELETE FROM departments WHERE id = %s", (dept_id,)
+            )
+        )
diff --git a/crm/models/field_proposals_db.py b/crm/models/field_proposals_db.py
new file mode 100644
index 0000000000..16d488c91f
--- /dev/null
+++ b/crm/models/field_proposals_db.py
@@ -0,0 +1,185 @@
+"""Gateway over ``field_proposals`` — AI-originated field-addition queue.
+
+When the copilot wants to introduce a new field it cannot insert it
+directly (see ADR 2026-04-20 §Decision). It writes a proposal here; an
+admin later approves or rejects via the admin UI (Wave B) or the
+``/crm/field_proposals/{id}/review`` endpoint.
+
+This gateway is CRUD-only — the approval side-effect (actually creating
+the ``module_fields`` row) lives in the route handler so it can share
+the same transaction and produce a matching ``schema_changelog`` entry.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+VALID_STATUSES = ("pending", "approved", "rejected", "withdrawn")
+
+
+class FieldProposalsDb:
+    """Table gateway over ``field_proposals``."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- writes --------------------------------------------------------
+
+    def insert_proposal(
+        self,
+        *,
+        proposer_type: str,
+        proposer_id: Optional[int],
+        proposer_label: Optional[str],
+        module_id: Optional[int],
+        module_name: str,
+        payload: Dict[str, Any],
+    ) -> int:
+        row = {
+            "proposer_type":  proposer_type,
+            "proposer_id":    proposer_id,
+            "proposer_label": proposer_label,
+            "module_id":      module_id,
+            "module_name":    module_name,
+            "payload":        json.dumps(payload),
+            "status":         "pending",
+        }
+
+        def _q(db: DbWrapper) -> int:
+            db.insert("field_proposals", row)
+            return db.id() or 0
+
+        return self._run(_q)
+
+    def mark_reviewed(
+        self,
+        proposal_id: int,
+        *,
+        status: str,
+        reviewer_id: int,
+        review_note: Optional[str],
+        created_field_id: Optional[int] = None,
+    ) -> None:
+        if status not in VALID_STATUSES:
+            raise ValueError(f"invalid status: {status}")
+        self._run(
+            lambda db: db.execute(
+                "UPDATE field_proposals SET "
+                "status = %s, reviewer_id = %s, review_ts = NOW(), "
+                "review_note = %s, created_field_id = %s "
+                "WHERE id = %s",
+                (status, reviewer_id, review_note, created_field_id, proposal_id),
+            )
+        )
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_by_id(self, proposal_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM field_proposals WHERE id = %s", (proposal_id,)
+            )
+        )
+
+    def count_agent_proposals_since(self, since_hours: int = 24) -> int:
+        """Rate-limit support for the copilot ``propose_new_field`` tool.
+        Counts every proposal an agent has filed in the window (any
+        status — a flood of rejected asks is still a flood)."""
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT COUNT(*) AS n FROM field_proposals "
+                "WHERE proposer_type = 'agent' "
+                "AND ts > NOW() - INTERVAL '1 hour' * %s",
+                (int(since_hours),),
+            )
+        )
+        return int((row or {}).get("n") or 0)
+
+    def find_pending_by_field_name(
+        self, module_id: int, field_name: str
+    ) -> Optional[Dict[str, Any]]:
+        """Dedup lookup: is there already a pending proposal for this
+        module+field_name? Used by the copilot ``propose_new_field`` tool
+        to avoid spamming the review queue with repeated asks.
+        """
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM field_proposals "
+                "WHERE module_id = %s AND status = 'pending' "
+                "AND payload->>'field_name' = %s "
+                "ORDER BY ts DESC LIMIT 1",
+                (module_id, field_name),
+            )
+        )
+
+    def find_pending_by_kind_key(
+        self,
+        *,
+        module_id: Optional[int],
+        kind: str,
+        key: str,
+    ) -> Optional[Dict[str, Any]]:
+        """Generic dedup across proposal kinds. ``key`` is the natural
+        identifier for that kind (module/subdetail machine name for
+        ``module_add``/``subdetail_add``; target module name for
+        ``module_rename``; workflow name for ``workflow_add``; field_name
+        for ``field_add``). When ``module_id`` is given the lookup is
+        scoped to it; ``module_add`` passes ``module_id=None`` (no module
+        yet) and dedups by key alone. The natural key is written into the
+        payload as ``_dedup_key`` by the enqueue helper so each kind uses
+        one consistent column. Mirrors :meth:`find_pending_by_field_name`
+        for the non-field kinds.
+        """
+        clauses = [
+            "status = 'pending'",
+            "payload->>'kind' = %s",
+            "payload->>'_dedup_key' = %s",
+        ]
+        params: List[Any] = [kind, key]
+        if module_id is not None:
+            clauses.append("module_id = %s")
+            params.append(int(module_id))
+        where = " AND ".join(clauses)
+        params_t = tuple(params)
+        return self._run(
+            lambda db: db.fetchone(
+                f"SELECT * FROM field_proposals WHERE {where} "
+                "ORDER BY ts DESC LIMIT 1",
+                params_t,
+            )
+        )
+
+    def list_by_status(
+        self, status: str = "pending", limit: int = 100
+    ) -> List[Dict[str, Any]]:
+        if status not in VALID_STATUSES:
+            raise ValueError(f"invalid status: {status}")
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM field_proposals WHERE status = %s "
+                "ORDER BY ts DESC, id DESC LIMIT %s",
+                (status, max(1, min(int(limit), 500))),
+            )
+        )
+
+    def count_by_status(self, status: str = "pending") -> int:
+        """Total proposals in a given status — backs the admin review-queue
+        badge in the SPA nav (no LIMIT, unlike :meth:`list_by_status`)."""
+        if status not in VALID_STATUSES:
+            raise ValueError(f"invalid status: {status}")
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT COUNT(*) AS n FROM field_proposals WHERE status = %s",
+                (status,),
+            )
+        )
+        return int((row or {}).get("n") or 0)
diff --git a/crm/models/module_fields_db.py b/crm/models/module_fields_db.py
new file mode 100644
index 0000000000..6b09d2f0cd
--- /dev/null
+++ b/crm/models/module_fields_db.py
@@ -0,0 +1,235 @@
+"""Module fields gateway — ported from kacrm's
+``app/models/module_fields_db.py``.
+
+``module_fields`` is the list-layer metadata. Each row is a normalized field
+definition (label/type/visibility/sort) keyed by ``(module_id, field_name)``
+where ``module_id`` references ``collections.id``.
+
+The list query builder reads :meth:`get_visible_fields` to decide which
+columns to SELECT. Views further narrow via :class:`ModuleViewFieldsDb` but
+the starting set always comes from here.
+
+Port notes:
+  * ``is_hidden = 0`` → ``is_hidden = FALSE`` (PG BOOLEAN).
+  * Backtick identifiers from kacrm's dynamic UPDATE removed — psycopg3 just
+    uses bare names (all our column names are lowercase).
+  * kacrm joined a separate ``modules`` table. We collapsed ``modules`` into
+    ``collections`` so the few kacrm methods that touched ``modules.table_name``
+    now resolve via ``collections.name`` (kacrm's ``modules.table_name`` == our
+    ``collections.name``).
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class ModuleFieldsDb:
+    """Table gateway over ``module_fields``."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_module_fields(self, module_id: int) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM module_fields WHERE module_id = %s "
+                "ORDER BY sort_order ASC, id ASC",
+                (module_id,),
+            )
+        )
+
+    # 审批专用字段:仅在模块「激活审批」(存在 approval_configs 行)时显示,
+    # 未激活则不返回——审批状态/审批人/审批时间随审批开关联动出现或隐藏。
+    _APPROVAL_FIELDS = ("approval_status", "approval_user_id", "approval_time")
+
+    def get_visible_fields(self, module_id: int) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM module_fields mf "
+                "WHERE mf.module_id = %s AND mf.is_hidden = FALSE "
+                "  AND (NOT (mf.field_name = ANY(%s)) "
+                "       OR EXISTS (SELECT 1 FROM approval_configs ac "
+                "                  WHERE ac.module_id = mf.module_id)) "
+                "ORDER BY mf.sort_order ASC, mf.id ASC",
+                (module_id, list(self._APPROVAL_FIELDS)),
+            )
+        )
+
+    def get_visible_fields_by_name(
+        self, module_id: int
+    ) -> Dict[str, Dict[str, Any]]:
+        return {f["field_name"]: f for f in self.get_visible_fields(module_id)}
+
+    def get_fields_by_type(
+        self, module_id: int, field_type: str
+    ) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM module_fields "
+                "WHERE module_id = %s AND is_hidden = FALSE "
+                "AND field_type = %s "
+                "ORDER BY sort_order ASC, id ASC",
+                (module_id, field_type),
+            )
+        )
+
+    def get_fields_by_types(
+        self, module_id: int, field_types: List[str]
+    ) -> List[Dict[str, Any]]:
+        if not field_types:
+            return []
+        placeholders = ",".join(["%s"] * len(field_types))
+        return self._run(
+            lambda db: db.fetchall(
+                f"SELECT * FROM module_fields "
+                f"WHERE module_id = %s AND field_type IN ({placeholders}) "
+                f"ORDER BY sort_order ASC, id ASC",
+                (module_id, *field_types),
+            )
+        )
+
+    def get_editable_fields(self, module_id: int) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM module_fields "
+                "WHERE module_id = %s AND is_hidden = FALSE "
+                "AND is_readonly = FALSE "
+                "ORDER BY sort_order ASC, id ASC",
+                (module_id,),
+            )
+        )
+
+    def get_searchable_field_names(self, module_id: int) -> List[str]:
+        """Text columns to OR-across when the user types into a search box.
+
+        The list endpoint uses this to assemble ``(col ILIKE %s OR col ILIKE %s
+        OR ...)``.
+        """
+        rows = self._run(
+            lambda db: db.fetchall(
+                "SELECT field_name FROM module_fields "
+                "WHERE module_id = %s AND is_hidden = FALSE "
+                "AND is_searchable = TRUE "
+                "AND field_type IN ('text','textarea','phone','email','url') "
+                "ORDER BY sort_order ASC",
+                (module_id,),
+            )
+        )
+        return [r["field_name"] for r in rows]
+
+    def get_field_by_id(self, field_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM module_fields WHERE id = %s", (field_id,)
+            )
+        )
+
+    def get_field_by_name(
+        self, module_id: int, field_name: str
+    ) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM module_fields "
+                "WHERE module_id = %s AND field_name = %s",
+                (module_id, field_name),
+            )
+        )
+
+    def get_relation_fields(self, module_id: int) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM module_fields "
+                "WHERE module_id = %s AND field_type = 'relation' "
+                "ORDER BY sort_order ASC, id ASC",
+                (module_id,),
+            )
+        )
+
+    def get_duplicate_check_field(
+        self, module_id: int
+    ) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT field_name, field_label FROM module_fields "
+                "WHERE module_id = %s "
+                "AND (is_duplicate_check = TRUE OR field_type = 'autoNumber') "
+                "LIMIT 1",
+                (module_id,),
+            )
+        )
+
+    # ---- writes --------------------------------------------------------
+
+    def insert_field(self, data: Dict[str, Any]) -> int:
+        payload = {
+            "module_id":          data.get("module_id"),
+            "field_label":        data.get("field_label"),
+            "field_name":         data.get("field_name"),
+            "field_type":         data.get("field_type"),
+            "field_length":       data.get("field_length"),
+            "is_required":        bool(data.get("is_required", False)),
+            "is_system":          bool(data.get("is_system", False)),
+            "is_default":         bool(data.get("is_default", False)),
+            "is_hidden":          bool(data.get("is_hidden", False)),
+            "is_summary":         bool(data.get("is_summary", False)),
+            "is_readonly":        bool(data.get("is_readonly", False)),
+            "is_searchable":      bool(data.get("is_searchable", True)),
+            "is_duplicate_check": bool(data.get("is_duplicate_check", False)),
+            "sort_order":         int(data.get("sort_order", 0)),
+            "options":            data.get("options"),
+            "datainfo":           data.get("datainfo"),
+            "default_value":      data.get("default_value"),
+            "description":        data.get("description"),
+            "field_config":       data.get("field_config"),
+        }
+
+        def _q(db: DbWrapper) -> int:
+            db.insert("module_fields", payload)
+            return db.id() or 0
+
+        return self._run(_q)
+
+    def update_field(self, field_id: int, data: Dict[str, Any]) -> None:
+        if not data:
+            return
+        cols = []
+        args: List[Any] = []
+        for k, v in data.items():
+            cols.append(f"{k} = %s")
+            args.append(v)
+        args.append(field_id)
+        sql = f"UPDATE module_fields SET {', '.join(cols)} WHERE id = %s"
+        self._run(lambda db: db.execute(sql, tuple(args)))
+
+    def delete_field(self, field_id: int) -> None:
+        self._run(
+            lambda db: db.execute(
+                "DELETE FROM module_fields WHERE id = %s", (field_id,)
+            )
+        )
+
+    # ---- picklist options (see crm/picklist.py for the pure helpers) ----
+
+    def set_field_options(self, field_id: int, options_csv: str) -> None:
+        """Overwrite the ``options`` column on one field.
+
+        Callers are expected to have gone through
+        :func:`hermes.crm.picklist.append_option` (or similar)
+        for validation/dedup — this method trusts the CSV it receives.
+        """
+        self._run(
+            lambda db: db.execute(
+                "UPDATE module_fields SET options = %s WHERE id = %s",
+                (options_csv, field_id),
+            )
+        )
diff --git a/crm/models/module_view_fields_db.py b/crm/models/module_view_fields_db.py
new file mode 100644
index 0000000000..d43f09bf8e
--- /dev/null
+++ b/crm/models/module_view_fields_db.py
@@ -0,0 +1,163 @@
+"""Module view fields gateway — ported from kacrm's
+``app/models/module_view_fields_db.py``.
+
+A row here picks one field (``field_id`` → ``module_fields.id``) to appear in
+one view (``view_id`` → ``module_views.id``), at a given ``sort_order`` and
+``width``. If a module_field has no row in ``module_view_fields`` for a given
+view, it's absent from that view's table — NOT automatically included.
+
+The list query builder JOINs this table with ``module_fields`` to obtain the
+SELECT list in display order. See :class:`ListQuery`.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class ModuleViewFieldsDb:
+    """Table gateway over ``module_view_fields``."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_fields_for_view(self, view_id: int) -> List[Dict[str, Any]]:
+        """Display-order-ordered ``module_view_fields`` rows + their
+        ``module_fields`` counterpart.
+
+        Returned columns: ``mvf.id AS mvf_id, mvf.sort_order AS mvf_sort, width,
+        mf.*`` (mf columns win on name collision except ``id``).
+        """
+        return self._run(
+            lambda db: db.fetchall(
+                """
+                SELECT
+                    mvf.id          AS mvf_id,
+                    mvf.sort_order  AS mvf_sort,
+                    mvf.width,
+                    mf.*
+                FROM module_view_fields mvf
+                JOIN module_fields mf ON mf.id = mvf.field_id
+                WHERE mvf.view_id = %s
+                ORDER BY mvf.sort_order ASC, mf.sort_order ASC
+                """,
+                (view_id,),
+            )
+        )
+
+    # ---- kacrm-compat aliases (used by ported list_query / detail_query) ----
+
+    def get_fields_with_view_settings_by_view(
+        self, view_id: int, only_in_view: bool = True
+    ) -> List[Dict[str, Any]]:
+        """kacrm method: fields for a view joined with the view-level config.
+
+        ``only_in_view`` is always True in our port — hermes doesn't
+        distinguish "all fields with view overlay" vs "only fields pinned to
+        the view" since every module_view_fields row is already an explicit
+        inclusion. Signature kept for drop-in call compatibility.
+        """
+        _ = only_in_view
+        return self.get_fields_for_view(view_id)
+
+    def get_fields_with_view_settings_by_module(
+        self, module_id: int
+    ) -> List[Dict[str, Any]]:
+        """kacrm method: module-wide field list, no view filtering.
+
+        Returns every ``module_fields`` row for the module, ordered by
+        ``sort_order``. Used when the caller did not pass a ``view_id`` —
+        typically the initial cold-open before the default view resolves.
+        """
+        return self._run(
+            lambda db: db.fetchall(
+                """
+                SELECT
+                    NULL::bigint    AS mvf_id,
+                    mf.sort_order   AS mvf_sort,
+                    NULL::int       AS width,
+                    mf.*
+                FROM module_fields mf
+                WHERE mf.module_id = %s
+                ORDER BY mf.sort_order ASC, mf.id ASC
+                """,
+                (module_id,),
+            )
+        )
+
+    def get_field_names_for_view(self, view_id: int) -> List[str]:
+        """Just the ``field_name`` list — sufficient when you already have the
+        rest of the metadata cached elsewhere.
+        """
+        rows = self._run(
+            lambda db: db.fetchall(
+                """
+                SELECT mf.field_name
+                FROM module_view_fields mvf
+                JOIN module_fields mf ON mf.id = mvf.field_id
+                WHERE mvf.view_id = %s
+                ORDER BY mvf.sort_order ASC, mf.sort_order ASC
+                """,
+                (view_id,),
+            )
+        )
+        return [r["field_name"] for r in rows]
+
+    # ---- writes --------------------------------------------------------
+
+    def set_view_fields(
+        self, view_id: int, entries: List[Dict[str, Any]]
+    ) -> None:
+        """Replace the full field set for *view_id*.
+
+        ``entries`` is a list of dicts with ``field_id``, ``sort_order``,
+        optional ``width``. The replacement is atomic — delete then bulk
+        insert inside a single transaction so intermediate states don't
+        leak to readers.
+        """
+
+        def _q(db: DbWrapper) -> None:
+            with db.transaction():
+                db.execute(
+                    "DELETE FROM module_view_fields WHERE view_id = %s",
+                    (view_id,),
+                )
+                if not entries:
+                    return
+                values_sql: List[str] = []
+                params: List[Any] = []
+                for e in entries:
+                    values_sql.append("(%s, %s, %s, %s)")
+                    params.extend(
+                        [
+                            view_id,
+                            int(e["field_id"]),
+                            int(e.get("sort_order", 0)),
+                            e.get("width"),
+                        ]
+                    )
+                sql = (
+                    "INSERT INTO module_view_fields "
+                    "(view_id, field_id, sort_order, width) VALUES "
+                    + ", ".join(values_sql)
+                )
+                db.execute(sql, tuple(params))
+
+        self._run(_q)
+
+    def delete_for_view(self, view_id: int) -> None:
+        self._run(
+            lambda db: db.execute(
+                "DELETE FROM module_view_fields WHERE view_id = %s",
+                (view_id,),
+            )
+        )
diff --git a/crm/models/module_views_db.py b/crm/models/module_views_db.py
new file mode 100644
index 0000000000..043743986b
--- /dev/null
+++ b/crm/models/module_views_db.py
@@ -0,0 +1,156 @@
+"""Module views gateway — ported from kacrm's
+``app/models/module_views_db.py``.
+
+A row in ``module_views`` is a saved query — name, type, filter JSON, optional
+role-visibility list. The kacrm defaults are "My Records" / "My Created
+Records" / "Subuser Records" / "Subuser Created Records" / "Team Records",
+all of which store a one-element filter like
+``[{"field": "owner_by", "operator": "eq", "value": "current"}]``.
+
+Views do NOT embed their column list — that lives in ``module_view_fields``.
+
+Port notes:
+  * ``filters`` / ``role_ids`` are JSONB in our schema; psycopg3 returns them
+    as Python dict/list automatically (we registered ``dict_row`` factory), so
+    callers get parsed JSON out of the box.
+  * Visibility combines ``is_public = TRUE`` with ``role_ids``. A public view
+    is visible to everyone by default; ``role_ids`` narrows public views to
+    specific roles when set.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class ModuleViewsDb:
+    """Table gateway over ``module_views``."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_view_by_id(self, view_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM module_views WHERE id = %s", (view_id,)
+            )
+        )
+
+    def get_views_for_module(
+        self, module_id: int, user_id: Optional[int] = None,
+        role_id: Optional[int] = None,
+    ) -> List[Dict[str, Any]]:
+        """Views the caller can see for *module_id*.
+
+        Visibility rule (kacrm parity):
+          * ``is_public = TRUE`` and ``role_ids IS NULL`` → everyone
+          * ``is_public = TRUE`` and ``role_ids ?? [role_id]`` → only roles in list
+          * ``is_public = FALSE`` → only the creator
+        """
+        # We keep the filter SQL-side so pagination on large view lists stays cheap.
+        clauses: List[str] = ["module_id = %s"]
+        params: List[Any] = [module_id]
+
+        if user_id is None and role_id is None:
+            # Admin bypass — no filter.
+            pass
+        else:
+            public_clauses: List[str] = []
+            public_clauses.append("role_ids IS NULL")
+            if role_id is not None:
+                # JSONB containment: role_ids @> [role_id]
+                public_clauses.append("role_ids @> %s::jsonb")
+                params.append(json.dumps([int(role_id)]))
+            visibility_sql = (
+                "(is_public = TRUE AND (" + " OR ".join(public_clauses) + "))"
+            )
+            if user_id is not None:
+                visibility_sql += " OR (is_public = FALSE AND created_by = %s)"
+                params.append(user_id)
+            clauses.append("(" + visibility_sql + ")")
+
+        sql = (
+            "SELECT * FROM module_views WHERE "
+            + " AND ".join(clauses)
+            + " ORDER BY sort_order ASC, id ASC"
+        )
+        return self._run(lambda db: db.fetchall(sql, tuple(params)))
+
+    def get_module_views(self, module_id: int) -> List[Dict[str, Any]]:
+        """kacrm-compat alias: unfiltered view list for a module.
+
+        Ordered by ``sort_order``, ``id`` — used by the list-product-columns
+        resolver when it needs to find the default view for a cold open.
+        """
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM module_views WHERE module_id = %s "
+                "ORDER BY sort_order ASC, id ASC",
+                (module_id,),
+            )
+        )
+
+    def get_default_view(self, module_id: int) -> Optional[Dict[str, Any]]:
+        """First ``is_default`` view for the module — what the UI loads on cold open."""
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM module_views "
+                "WHERE module_id = %s AND is_default = TRUE "
+                "ORDER BY sort_order ASC, id ASC LIMIT 1",
+                (module_id,),
+            )
+        )
+
+    # ---- writes --------------------------------------------------------
+
+    def insert(self, data: Dict[str, Any]) -> int:
+        payload = {
+            "module_id":   data.get("module_id"),
+            "name":        data.get("name"),
+            "type":        data.get("type", "table"),
+            "filters":     json.dumps(data.get("filters") or []),
+            "is_default":  bool(data.get("is_default", False)),
+            "is_public":   bool(data.get("is_public", True)),
+            "role_ids":
+                json.dumps(data["role_ids"]) if data.get("role_ids") else None,
+            "sort_order":  int(data.get("sort_order", 0)),
+            "created_by":  data.get("created_by"),
+            "updated_by":  data.get("updated_by"),
+        }
+
+        def _q(db: DbWrapper) -> int:
+            db.insert("module_views", payload)
+            return db.id() or 0
+
+        return self._run(_q)
+
+    def update(self, view_id: int, data: Dict[str, Any]) -> None:
+        if not data:
+            return
+        cols: List[str] = []
+        args: List[Any] = []
+        for k, v in data.items():
+            if k in ("filters", "role_ids") and v is not None and not isinstance(v, str):
+                v = json.dumps(v)
+            cols.append(f"{k} = %s")
+            args.append(v)
+        args.append(view_id)
+        sql = f"UPDATE module_views SET {', '.join(cols)} WHERE id = %s"
+        self._run(lambda db: db.execute(sql, tuple(args)))
+
+    def delete(self, view_id: int) -> None:
+        self._run(
+            lambda db: db.execute(
+                "DELETE FROM module_views WHERE id = %s", (view_id,)
+            )
+        )
diff --git a/crm/models/modules_db.py b/crm/models/modules_db.py
new file mode 100644
index 0000000000..beb377649b
--- /dev/null
+++ b/crm/models/modules_db.py
@@ -0,0 +1,118 @@
+"""Modules gateway — shim over ``collections`` for kacrm-compat.
+
+kacrm's ``ModulesDb`` fronts a ``modules`` table with columns like
+``table_name``, ``has_products``, ``product_fields``, ``allow_adjust_product_
+total``, ``modules_approval`` join, etc. Hermes merged that registry into
+``collections`` (id, name, title) during Phase 0 — so this shim synthesizes
+the extra fields kacrm's list/detail queries expect.
+
+Mapping
+-------
+* ``table_name`` → ``collections.name`` (we use identical short names
+  ``accounts`` / ``contacts`` / ``leads`` for both logical module name AND
+  the physical record table — so the two are the same string)
+* ``has_products`` → ``0`` (Phase 1 modules never expose product lines)
+* ``product_fields`` → ``None`` (no line-item column config)
+* ``has_approval`` → ``0`` (no ``modules_approval`` table yet)
+* ``allow_edit_after_approve`` → ``0``
+* ``allow_adjust_product_total`` → ``0``
+
+When Phase 2 adds quotes / salesorders (the product-bearing modules), we'll
+extend ``collections`` with a ``has_products BOOLEAN`` column and flip the
+right fields on this shim rather than rewiring every call-site.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+def _synthesize_kacrm_fields(row: Optional[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
+    if not row:
+        return None
+    name = row.get("name") or ""
+    enriched = dict(row)
+    enriched.setdefault("table_name", name)
+    enriched.setdefault("has_products", 0)
+    enriched.setdefault("product_fields", None)
+    enriched.setdefault("has_approval", 0)
+    enriched.setdefault("allow_edit_after_approve", 0)
+    enriched.setdefault("allow_adjust_product_total", 0)
+    # ``headline_fields`` is the per-module chip-row customization
+    # (JSONB array of field_name strings, NULL = use frontend default).
+    # See migration 0020 and the HeadlineCustomizer UI.
+    enriched.setdefault("headline_fields", row.get("headline_fields"))
+    return enriched
+
+
+class ModulesDb:
+    """Table gateway fronting ``collections`` — adds kacrm-shaped fields."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    def get_module_by_id(self, module_id: int) -> Optional[Dict[str, Any]]:
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM collections WHERE id = %s", (module_id,)
+            )
+        )
+        return _synthesize_kacrm_fields(row)
+
+    def get_module_info(self, module_id: int) -> Optional[Dict[str, Any]]:
+        """kacrm method: same as ``get_module_by_id`` plus the modules_approval
+        join. We don't have modules_approval yet, so return the plain row with
+        zeroed approval flags.
+        """
+        return self.get_module_by_id(module_id)
+
+    def get_module_by_table_name(self, table_name: str) -> Optional[Dict[str, Any]]:
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM collections WHERE name = %s", (table_name,)
+            )
+        )
+        return _synthesize_kacrm_fields(row)
+
+    def get_module_by_name(self, name: str) -> Optional[Dict[str, Any]]:
+        return self.get_module_by_table_name(name)
+
+    def get_all_modules(self) -> List[Dict[str, Any]]:
+        rows = self._run(
+            lambda db: db.fetchall("SELECT * FROM collections ORDER BY id ASC")
+        )
+        out: List[Dict[str, Any]] = []
+        for row in rows or []:
+            enriched = _synthesize_kacrm_fields(row)
+            if enriched is not None:
+                out.append(enriched)
+        return out
+
+    def set_headline_fields(self, name: str, fields: Optional[List[str]]) -> None:
+        """Write the per-module chip-row pick list. ``None`` clears the
+        override (frontend default takes over). Caller is responsible
+        for validating the names exist and the list is ≤5 items.
+        """
+        import json
+        payload = None if fields is None else json.dumps(list(fields))
+        self._run(
+            lambda db: db.execute(
+                "UPDATE collections SET headline_fields = %s::jsonb WHERE name = %s",
+                (payload, name),
+            )
+        )
+
+    def module_exists(self, module_id: int) -> bool:
+        n = self._run(
+            lambda db: db.fetchcolumn(
+                "SELECT COUNT(*) FROM collections WHERE id = %s", (module_id,)
+            )
+        )
+        return (n or 0) > 0
diff --git a/crm/models/permissions_db.py b/crm/models/permissions_db.py
new file mode 100644
index 0000000000..4fbf527409
--- /dev/null
+++ b/crm/models/permissions_db.py
@@ -0,0 +1,131 @@
+"""Permissions + role_permissions gateway — ported from kacrm's
+``app/models/permissions_db.py``.
+
+Port notes (kacrm MySQL → hermes_crm PostgreSQL):
+  - ``has_permission`` is now ``BOOLEAN NOT NULL`` (kacrm used ``tinyint(1)``),
+    so the old ``= 1`` comparisons still work because psycopg3 returns Python
+    bools from ``BOOLEAN`` columns — any truthy check works.
+  - The bulk-insert "VALUES (%s, %s, ...), (%s, %s, ...)" pattern is identical
+    between pymysql and psycopg3, no changes needed.
+  - ``get_user_permission_modules`` originally joined a ``modules`` table with
+    ``is_hidden``. hermes_crm has ``collections`` instead (no ``is_hidden``
+    concept yet), so the join is simplified. When/if we add a hidden flag on
+    collections we'll restore the filter.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class PermissionsDb:
+    """Table gateway over ``permissions`` + ``role_permissions``."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_all_permissions(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall("SELECT * FROM permissions ORDER BY id")
+        )
+
+    def get_permission_id_by_code(self, code: str) -> Optional[int]:
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT id FROM permissions WHERE code = %s", (code,)
+            )
+        )
+        return int(row["id"]) if row and row.get("id") else None
+
+    def get_role_module_permissions(self, role_id: int) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT module_id, permission_id, has_permission "
+                "FROM role_permissions WHERE role_id = %s",
+                (role_id,),
+            )
+        )
+
+    def has_permission(
+        self, role_id: int, module_id: int, permission_id: int
+    ) -> bool:
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT has_permission FROM role_permissions "
+                "WHERE role_id = %s AND module_id = %s AND permission_id = %s "
+                "LIMIT 1",
+                (role_id, module_id, permission_id),
+            )
+        )
+        return bool(row and row.get("has_permission"))
+
+    def get_user_permission_modules(self, user_id: int) -> List[int]:
+        """Collection ids the user has the ``index`` permission on.
+
+        kacrm joined a ``modules`` table here; we use ``collections``.
+        """
+        rows = self._run(
+            lambda db: db.fetchall(
+                """
+                SELECT c.id
+                FROM collections c
+                JOIN role_permissions rp ON c.id = rp.module_id
+                JOIN permissions p       ON rp.permission_id = p.id
+                JOIN users u             ON u.role_id = rp.role_id
+                WHERE u.id = %s
+                  AND rp.has_permission = TRUE
+                  AND p.code = 'index'
+                """,
+                (user_id,),
+            )
+        )
+        return [int(r["id"]) for r in (rows or [])]
+
+    # ---- writes --------------------------------------------------------
+
+    def delete_role_permissions(self, role_id: int) -> None:
+        self._run(
+            lambda db: db.execute(
+                "DELETE FROM role_permissions WHERE role_id = %s", (role_id,)
+            )
+        )
+
+    def insert_role_permissions(
+        self, role_id: int, permissions: List[Dict[str, Any]]
+    ) -> None:
+        """Bulk insert ``role_permissions`` rows for *role_id*.
+
+        ``permissions`` is a list of dicts with ``module_id``, ``permission_id``,
+        and optional ``has_permission``. kacrm-compatible shape.
+        """
+        if not permissions:
+            return
+        values_sql: List[str] = []
+        params: List[Any] = []
+        for p in permissions:
+            values_sql.append("(%s, %s, %s, %s)")
+            params.extend(
+                [
+                    role_id,
+                    p.get("permission_id"),
+                    p.get("module_id"),
+                    bool(p.get("has_permission", False)),
+                ]
+            )
+        sql = (
+            "INSERT INTO role_permissions "
+            "(role_id, permission_id, module_id, has_permission) VALUES "
+            + ", ".join(values_sql)
+            + " ON CONFLICT (role_id, module_id, permission_id) DO UPDATE "
+              "SET has_permission = EXCLUDED.has_permission"
+        )
+        self._run(lambda db: db.execute(sql, tuple(params)))
diff --git a/crm/models/roles_db.py b/crm/models/roles_db.py
new file mode 100644
index 0000000000..cbf3719eb8
--- /dev/null
+++ b/crm/models/roles_db.py
@@ -0,0 +1,117 @@
+"""Roles table gateway — ported from kacrm's ``app/models/roles_db.py``.
+
+Port notes (kacrm MySQL → hermes_crm PostgreSQL):
+  - ``deleted = 0 OR deleted IS NULL`` → ``deleted = FALSE`` (users side only;
+    ``roles`` itself has no ``deleted`` column).
+  - kacrm's ``get_all_roles`` sorted ``(is_default = 1 OR is_default IS NULL)``
+    because kacrm had nullable tinyint(1); our PG column is ``NOT NULL BOOLEAN``,
+    so ``is_default DESC`` is equivalent.
+  - ``LAST_INSERT_ID()`` → :meth:`DbWrapper.insert` + :meth:`DbWrapper.id`.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class RolesDb:
+    """Table gateway over the ``roles`` table."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- reads ---------------------------------------------------------
+
+    def get_role_by_id(self, role_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone("SELECT * FROM roles WHERE id = %s", (role_id,))
+        )
+
+    def get_role_list(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall("SELECT id, name FROM roles ORDER BY name")
+        )
+
+    def get_all_roles(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM roles ORDER BY is_default DESC, id ASC"
+            )
+        )
+
+    def role_exists(self, role_id: int) -> bool:
+        n = self._run(
+            lambda db: db.fetchcolumn(
+                "SELECT COUNT(*) FROM roles WHERE id = %s", (role_id,)
+            )
+        )
+        return (n or 0) > 0
+
+    def name_exists(self, name: str, exclude_id: Optional[int] = None) -> bool:
+        def _q(db: DbWrapper) -> int:
+            if exclude_id is not None:
+                return db.fetchcolumn(
+                    "SELECT COUNT(*) FROM roles WHERE name = %s AND id != %s",
+                    (name, exclude_id),
+                )
+            return db.fetchcolumn(
+                "SELECT COUNT(*) FROM roles WHERE name = %s", (name,)
+            )
+
+        return (self._run(_q) or 0) > 0
+
+    def get_role_name(self, role_id: Optional[int]) -> str:
+        if not role_id:
+            return ""
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT name FROM roles WHERE id = %s", (role_id,)
+            )
+        )
+        return (row.get("name") or "") if row else ""
+
+    def is_role_in_use(self, role_id: int) -> bool:
+        n = self._run(
+            lambda db: db.fetchcolumn(
+                "SELECT COUNT(*) FROM users WHERE role_id = %s AND deleted = FALSE",
+                (role_id,),
+            )
+        )
+        return (n or 0) > 0
+
+    # ---- writes --------------------------------------------------------
+
+    def insert(self, data: Dict[str, Any]) -> int:
+        def _q(db: DbWrapper) -> int:
+            db.insert(
+                "roles",
+                {
+                    "name": data.get("name"),
+                    "description": data.get("description"),
+                    "is_default": bool(data.get("is_default", False)),
+                },
+            )
+            return db.id() or 0
+
+        return self._run(_q)
+
+    def update(self, role_id: int, data: Dict[str, Any]) -> None:
+        def _q(db: DbWrapper) -> None:
+            db.execute(
+                "UPDATE roles SET name = %s, description = %s WHERE id = %s",
+                (data.get("name"), data.get("description"), role_id),
+            )
+
+        self._run(_q)
+
+    def delete(self, role_id: int) -> None:
+        self._run(
+            lambda db: db.execute("DELETE FROM roles WHERE id = %s", (role_id,))
+        )
diff --git a/crm/models/schema_changelog_db.py b/crm/models/schema_changelog_db.py
new file mode 100644
index 0000000000..c067e2b55f
--- /dev/null
+++ b/crm/models/schema_changelog_db.py
@@ -0,0 +1,115 @@
+"""Gateway over ``schema_changelog`` — audit trail for every module_fields mutation.
+
+Written to transactionally with the actual mutation (see
+``hermes_cloud/app/crm/routes/__init__.py`` handlers). This gateway just
+exposes ``insert`` and a handful of read queries for the admin UI.
+
+Charter §168 — the AI is allowed to touch schema, but every touch must
+be inspectable and reversible. That inspectability lives here.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class SchemaChangelogDb:
+    """Table gateway over ``schema_changelog``."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ---- writes --------------------------------------------------------
+
+    def insert_entry(
+        self,
+        *,
+        actor_type: str,
+        actor_id: Optional[int],
+        actor_label: Optional[str],
+        module_id: int,
+        module_name: str,
+        field_id: Optional[int],
+        field_name: Optional[str],
+        op: str,
+        before: Optional[Dict[str, Any]] = None,
+        after: Optional[Dict[str, Any]] = None,
+        reason: Optional[str] = None,
+    ) -> int:
+        """Insert one audit row. Returns the new row's id."""
+        payload = {
+            "actor_type":  actor_type,
+            "actor_id":    actor_id,
+            "actor_label": actor_label,
+            "module_id":   module_id,
+            "module_name": module_name,
+            "field_id":    field_id,
+            "field_name":  field_name,
+            "op":          op,
+            # psycopg3 adapts dicts → jsonb only if the column type is
+            # known to the cursor; encoding defensively keeps the
+            # contract explicit and survives driver quirks.
+            "before_json": json.dumps(before) if before is not None else None,
+            "after_json":  json.dumps(after) if after is not None else None,
+            "reason":      reason,
+        }
+
+        def _q(db: DbWrapper) -> int:
+            db.insert("schema_changelog", payload)
+            return db.id() or 0
+
+        return self._run(_q)
+
+    # ---- reads ---------------------------------------------------------
+
+    def list_recent(
+        self,
+        *,
+        module_id: Optional[int] = None,
+        actor_type: Optional[str] = None,
+        limit: int = 100,
+    ) -> List[Dict[str, Any]]:
+        """Most-recent-first audit log, optionally scoped to one module
+        or one actor type."""
+        clauses: List[str] = []
+        args: List[Any] = []
+        if module_id is not None:
+            clauses.append("module_id = %s")
+            args.append(int(module_id))
+        if actor_type is not None:
+            clauses.append("actor_type = %s")
+            args.append(actor_type)
+        where = ("WHERE " + " AND ".join(clauses)) if clauses else ""
+        args.append(max(1, min(int(limit), 500)))
+        sql = (
+            "SELECT id, ts, actor_type, actor_id, actor_label, "
+            "module_id, module_name, field_id, field_name, op, "
+            "before_json, after_json, reason "
+            "FROM schema_changelog "
+            f"{where} "
+            "ORDER BY ts DESC, id DESC "
+            "LIMIT %s"
+        )
+        return self._run(lambda db: db.fetchall(sql, tuple(args)))
+
+    def count_agent_ops_since(self, op: str, since_hours: int = 24) -> int:
+        """Rate-limit support — how many ``op`` rows has any agent
+        written in the last ``since_hours``. Global (not per-agent);
+        per-conversation throttling is out of scope for v1."""
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT COUNT(*) AS n FROM schema_changelog "
+                "WHERE actor_type = 'agent' AND op = %s "
+                "AND ts > NOW() - INTERVAL '1 hour' * %s",
+                (op, int(since_hours)),
+            )
+        )
+        return int((row or {}).get("n") or 0)
