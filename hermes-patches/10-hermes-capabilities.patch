@@ -0,0 +1,167 @@
+"""Regression tests for R3-1: EmailAdapter.connect() must offload the blocking
+IMAP/SMTP handshake to the adapter I/O executor instead of running it on the
+shared event loop.
+
+Under multiplex (single process, one shared loop across every tenant), a
+``connect(is_reconnect=True)`` that ran ``imaplib.IMAP4_SSL(...).login()`` and
+the SMTP ``login()`` synchronously on the loop would freeze send/receive for
+*all* tenants for the duration of the ~30s-timeout handshakes. The fetch/send
+paths already offload via ``self._get_io_executor()``; connect() must too.
+"""
+
+import asyncio
+import os
+import time
+import threading
+import unittest
+from unittest.mock import AsyncMock, patch
+
+from gateway.config import PlatformConfig
+
+
+def _make_adapter():
+    env = {
+        "EMAIL_ADDRESS": "hermes@test.com",
+        "EMAIL_PASSWORD": "secret",
+        "EMAIL_IMAP_HOST": "imap.test.com",
+        "EMAIL_IMAP_PORT": "993",
+        "EMAIL_SMTP_HOST": "smtp.test.com",
+        "EMAIL_SMTP_PORT": "587",
+        "EMAIL_POLL_INTERVAL": "15",
+    }
+    with patch.dict(os.environ, env, clear=False):
+        from plugins.platforms.email.adapter import EmailAdapter
+        return EmailAdapter(PlatformConfig(enabled=True))
+
+
+class _SleepyIMAP:
+    """Stub IMAP4_SSL whose construction blocks for 0.5s (like a slow TLS
+    handshake against a remote server)."""
+
+    capabilities = ()
+
+    def __init__(self, host, port, timeout=None, ssl_context=None):
+        time.sleep(0.5)
+
+    def login(self, user, password):
+        time.sleep(0.5)
+
+    def xatom(self, *args, **kwargs):
+        return ("OK", [b""])
+
+    def select(self, mailbox):
+        return ("OK", [b"0"])
+
+    def uid(self, command, *args):
+        return ("OK", [b""])
+
+    def logout(self):
+        return ("BYE", [b""])
+
+
+class _SleepySMTP:
+    """Stub smtplib.SMTP whose construction + login block."""
+
+    def __init__(self, host, port, timeout=None):
+        time.sleep(0.5)
+
+    def starttls(self, context=None):
+        return None
+
+    def login(self, user, password):
+        time.sleep(0.5)
+
+    def quit(self):
+        return None
+
+    def close(self):
+        return None
+
+
+class TestConnectHandshakeDoesNotBlockLoop(unittest.TestCase):
+    """The blocking handshake must not stall the event loop heartbeat."""
+
+    def test_connect_does_not_freeze_event_loop(self):
+        adapter = _make_adapter()
+        started, release = threading.Event(), threading.Event()
+
+        class BlockingIMAP(_SleepyIMAP):
+            def __init__(self, host, port, timeout=None, ssl_context=None):
+                started.set()
+                if not release.wait(3):
+                    raise TimeoutError("event loop could not release the handshake")
+
+        async def scenario():
+            with patch("imaplib.IMAP4_SSL", BlockingIMAP), \
+                    patch("smtplib.SMTP", _SleepySMTP), \
+                    patch.object(adapter, "_poll_loop", new=AsyncMock()):
+                task = asyncio.create_task(adapter.connect(is_reconnect=True))
+                try:
+                    assert await asyncio.to_thread(started.wait, 2)
+                    # Only this loop can release the worker. An inline TLS
+                    # handshake times out before we get here and connect fails.
+                    release.set()
+                    return await task
+                finally:
+                    release.set()
+                    await task
+                    await adapter.disconnect()
+
+        self.assertTrue(asyncio.run(scenario()))
+
+
+class TestConnectHandshakeUsesIoExecutor(unittest.TestCase):
+    """Structural: both handshakes go through run_in_executor with the
+    adapter-owned pool (never the default/None executor)."""
+
+    def test_handshakes_dispatched_to_io_executor(self):
+        adapter = _make_adapter()
+        pool = adapter._get_io_executor()
+
+        async def scenario():
+            loop = asyncio.get_running_loop()
+            real_run_in_executor = loop.run_in_executor
+            calls = []
+
+            async def _spy(executor, func, *args):
+                calls.append(executor)
+                return await real_run_in_executor(executor, func, *args)
+
+            with patch("imaplib.IMAP4_SSL", _SleepyIMAP), \
+                    patch("smtplib.SMTP", _SleepySMTP), \
+                    patch.object(loop, "run_in_executor", _spy), \
+                    patch.object(adapter, "_poll_loop", new=AsyncMock()):
+                ok = await adapter.connect(is_reconnect=False)
+
+            adapter._running = False
+            if adapter._poll_task:
+                adapter._poll_task.cancel()
+                try:
+                    await adapter._poll_task
+                except asyncio.CancelledError:
+                    pass
+            return ok, calls
+
+        ok, calls = asyncio.run(scenario())
+        adapter._shutdown_io_executor()
+
+        self.assertTrue(ok)
+        # At least the IMAP and SMTP handshakes must be dispatched.
+        self.assertGreaterEqual(
+            len(calls), 2,
+            "expected both IMAP and SMTP handshakes to be offloaded",
+        )
+        for executor in calls:
+            self.assertIsNotNone(
+                executor,
+                "handshake was dispatched to the default (None) executor — "
+                "must use the adapter-owned I/O pool",
+            )
+            self.assertIs(
+                executor, pool,
+                "handshake must use self._get_io_executor(), not another pool",
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/gateway/test_feishu_multiplex_loop_shim.py b/tests/gateway/test_feishu_multiplex_loop_shim.py
new file mode 100644
index 0000000000..ad5d0a2f37
--- /dev/null
+++ b/tests/gateway/test_feishu_multiplex_loop_shim.py
@@ -0,0 +1,101 @@
+"""Feishu's native WS dispatcher isolates multiplexed loops and ping settings.
+
+Each worker registers its own loop/connect kwargs in the native thread-local
+state; the process-wide install must be idempotent and preserve SDK globals
+for callers outside a WS worker.
+"""
+from __future__ import annotations
+
+import asyncio
+import threading
+from types import SimpleNamespace
+
+import pytest
+from plugins.platforms.feishu import adapter as feishu
+
+
+@pytest.fixture
+def ws_module(monkeypatch):
+    # Exercise installation without touching the real SDK singleton.
+    monkeypatch.setattr(feishu, "_WS_ISOLATION_INSTALLED", False)
+    monkeypatch.setattr(feishu, "_ws_isolation_state", threading.local())
+    loop = asyncio.new_event_loop()
+
+    class Websockets:
+        def connect(self, *args, **kwargs):
+            return ("connected", args, kwargs)
+
+        def some_other_attr(self):
+            return "delegated"
+
+    class Client:
+        async def _receive_message_loop(self):
+            return None
+
+    module = SimpleNamespace(loop=loop, websockets=Websockets(), Client=Client)
+    try:
+        yield module
+    finally:
+        loop.close()
+
+
+def test_install_routes_loop_and_preserves_websocket_module(ws_module):
+    fallback, websockets = ws_module.loop, ws_module.websockets
+    feishu._install_lark_ws_isolation(ws_module)
+    assert ws_module.loop.create_task.__self__ is fallback
+    assert ws_module.websockets is websockets
+    assert ws_module.websockets.some_other_attr() == "delegated"
+
+
+def test_install_is_idempotent(ws_module):
+    feishu._install_lark_ws_isolation(ws_module)
+    loop = ws_module.loop
+    connect = ws_module.websockets.connect
+    receive = ws_module.Client._receive_message_loop
+    feishu._install_lark_ws_isolation(ws_module)
+    assert ws_module.loop is loop
+    assert ws_module.websockets.connect is connect
+    assert ws_module.Client._receive_message_loop is receive
+
+
+def test_loop_and_ping_dispatch_resolve_calling_threads_state(ws_module):
+    feishu._install_lark_ws_isolation(ws_module)
+    results, errors = {}, []
+    barrier = threading.Barrier(2, timeout=3)
+
+    def worker(tag, interval):
+        loop = asyncio.new_event_loop()
+        feishu._ws_isolation_state.loop = loop
+        feishu._ws_isolation_state.connect_kwargs = {"ping_interval": interval, "ping_timeout": interval + 1}
+        try:
+            barrier.wait()
+            resolved = ws_module.loop.create_task.__self__
+            kwargs = ws_module.websockets.connect("wss://test")[2]
+            results[tag] = (id(resolved), id(loop), kwargs)
+        except BaseException as exc:
+            errors.append(exc)
+        finally:
+            del feishu._ws_isolation_state.loop
+            del feishu._ws_isolation_state.connect_kwargs
+            loop.close()
+
+    threads = [threading.Thread(target=worker, args=("A", 11)), threading.Thread(target=worker, args=("B", 22))]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=5)
+    assert not any(thread.is_alive() for thread in threads)
+    assert not errors
+    assert results["A"][0] == results["A"][1]
+    assert results["B"][0] == results["B"][1]
+    assert results["A"][0] != results["B"][0]
+    assert results["A"][2] == {"ping_interval": 11, "ping_timeout": 12}
+    assert results["B"][2] == {"ping_interval": 22, "ping_timeout": 23}
+
+
+def test_connect_preserves_explicit_ping_and_no_worker_defaults(ws_module):
+    feishu._install_lark_ws_isolation(ws_module)
+    assert ws_module.websockets.connect("wss://test")[2] == {}
+    feishu._ws_isolation_state.connect_kwargs = {"ping_interval": 11, "ping_timeout": 22}
+    assert ws_module.websockets.connect("wss://test")[2] == {"ping_interval": 11, "ping_timeout": 22}
+    assert ws_module.websockets.connect("wss://test", ping_interval=99)[2] == {"ping_interval": 99, "ping_timeout": 22}
diff --git a/tests/gateway/test_feishu_qr_async.py b/tests/gateway/test_feishu_qr_async.py
new file mode 100644
index 0000000000..a20b11663c
--- /dev/null
+++ b/tests/gateway/test_feishu_qr_async.py
@@ -0,0 +1,201 @@
+"""Non-blocking QR primitives for Feishu/Lark device-code registration.
+
+``qr_register()`` blocks in a poll loop, which doesn't fit an HTTP
+request-response context. ``qr_start()`` + ``qr_poll_once()`` let
+cloud's SPA endpoints drive the loop themselves.
+"""
+from __future__ import annotations
+
+from unittest.mock import patch
+
+import pytest
+
+from plugins.platforms.feishu.adapter import qr_poll_once, qr_start
+
+
+# ---------------------------------------------------------------------------
+# qr_start
+# ---------------------------------------------------------------------------
+
+
+def test_qr_start_returns_device_code_and_qr_url():
+    """The start call must return everything the SPA needs to render
+    the QR code: device_code (opaque), qr_url (to display), interval
+    (suggested poll cadence), expire_in (countdown)."""
+    init_mock = {"supported_auth_methods": ["client_secret"]}
+    begin_mock = {
+        "device_code": "dc_xyz",
+        "user_code": "ABCD-EFGH",
+        # Feishu's API returns the QR URL under ``verification_uri_complete``;
+        # _begin_registration reads from that key and appends from/tp params.
+        "verification_uri_complete": "https://applink.feishu.cn/client/passport/code_login?action=dc_xyz",
+        "interval": 5,
+        "expire_in": 600,
+    }
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.side_effect = [init_mock, begin_mock]
+        result = qr_start(domain="feishu")
+    assert result["device_code"] == "dc_xyz"
+    assert result["user_code"] == "ABCD-EFGH"
+    assert "applink.feishu.cn" in result["qr_url"]
+    assert result["interval"] == 5
+    assert result["expire_in"] == 600
+    assert result["domain"] == "feishu"
+
+
+def test_qr_start_supports_lark_domain():
+    """Passing domain='lark' should hit Lark's registration endpoint
+    (different base URL) — verifies we don't hardcode 'feishu'."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.side_effect = [
+            {"supported_auth_methods": ["client_secret"]},
+            {"device_code": "x", "user_code": "u",
+             "verification_uri_complete": "https://lark.x/y",
+             "interval": 5, "expire_in": 600},
+        ]
+        result = qr_start(domain="lark")
+    assert result["domain"] == "lark"
+
+
+def test_qr_start_raises_on_unsupported_auth():
+    """If Feishu's environment doesn't support client_secret auth
+    (rare misconfiguration), the start call raises with a clear
+    message rather than silently producing a broken device_code."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.return_value = {"supported_auth_methods": ["password"]}
+        with pytest.raises(RuntimeError, match="client_secret"):
+            qr_start(domain="feishu")
+
+
+def test_qr_start_uses_default_interval_when_server_omits():
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.side_effect = [
+            {"supported_auth_methods": ["client_secret"]},
+            {"device_code": "x", "user_code": "u",
+             "verification_uri_complete": "https://x.y"},
+        ]
+        result = qr_start()
+    assert result["interval"] == 5  # default fallback
+    assert result["expire_in"] == 600
+
+
+# ---------------------------------------------------------------------------
+# qr_poll_once
+# ---------------------------------------------------------------------------
+
+
+def test_qr_poll_pending_returns_pending():
+    """authorization_pending is the expected state while the user is
+    still scanning — caller keeps polling."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.return_value = {"error": "authorization_pending"}
+        result = qr_poll_once("dc_xyz", domain="feishu")
+    assert result["status"] == "pending"
+
+
+def test_qr_poll_pending_propagates_detected_domain():
+    """User's tenant brand is reported mid-flow — caller switches
+    base URL on next poll if Lark was detected."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.return_value = {
+            "error": "authorization_pending",
+            "user_info": {"tenant_brand": "lark"},
+        }
+        result = qr_poll_once("dc_xyz", domain="feishu")
+    assert result["status"] == "pending"
+    assert result["domain"] == "lark"
+
+
+def test_qr_poll_completed_returns_creds_with_bot_info():
+    """When the user confirms, Feishu returns client_id/client_secret.
+    qr_poll_once also probes /bot/v3/info best-effort to enrich with
+    bot_name/bot_open_id for the SPA's "Connected — {bot_name}" pill."""
+    poll_resp = {
+        "client_id": "cli_provisioned",
+        "client_secret": "secret_provisioned",
+        "user_info": {"open_id": "ou_user_who_scanned", "tenant_brand": "feishu"},
+    }
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post, \
+         patch("plugins.platforms.feishu.adapter.probe_bot") as mock_probe:
+        mock_post.return_value = poll_resp
+        mock_probe.return_value = {
+            "bot_name": "hermes-personalagent-1",
+            "bot_open_id": "ou_bot_xyz",
+        }
+        result = qr_poll_once("dc_xyz", domain="feishu")
+    assert result["status"] == "completed"
+    assert result["creds"]["app_id"] == "cli_provisioned"
+    assert result["creds"]["app_secret"] == "secret_provisioned"
+    assert result["creds"]["domain"] == "feishu"
+    assert result["creds"]["bot_name"] == "hermes-personalagent-1"
+    assert result["creds"]["bot_open_id"] == "ou_bot_xyz"
+
+
+def test_qr_poll_completed_tolerates_bot_probe_failure():
+    """probe_bot returning None must not crash the poll — bot_name
+    falls back to None and the caller can re-probe later."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post, \
+         patch("plugins.platforms.feishu.adapter.probe_bot") as mock_probe:
+        mock_post.return_value = {
+            "client_id": "x", "client_secret": "y",
+            "user_info": {"open_id": "ou"},
+        }
+        mock_probe.return_value = None
+        result = qr_poll_once("dc", domain="feishu")
+    assert result["status"] == "completed"
+    assert result["creds"]["bot_name"] is None
+
+
+def test_qr_poll_auto_switches_to_lark_when_tenant_brand_lark():
+    """If start hit Feishu but the scanning user's tenant is Lark, the
+    detected domain in the completed creds reflects that — so cloud
+    saves the right domain into config.yaml."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post, \
+         patch("plugins.platforms.feishu.adapter.probe_bot") as mock_probe:
+        mock_post.return_value = {
+            "client_id": "x", "client_secret": "y",
+            "user_info": {"tenant_brand": "lark", "open_id": "ou"},
+        }
+        mock_probe.return_value = None
+        result = qr_poll_once("dc", domain="feishu")
+    assert result["status"] == "completed"
+    assert result["creds"]["domain"] == "lark"
+    assert result["domain"] == "lark"
+
+
+def test_qr_poll_denied_returns_denied():
+    """User rejected on phone — distinct from expired so the SPA can
+    show "您拒绝了授权" instead of "二维码过期"."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.return_value = {"error": "access_denied"}
+        result = qr_poll_once("dc", domain="feishu")
+    assert result["status"] == "denied"
+
+
+def test_qr_poll_expired_returns_expired():
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.return_value = {"error": "expired_token"}
+        result = qr_poll_once("dc", domain="feishu")
+    assert result["status"] == "expired"
+
+
+def test_qr_poll_unknown_error_returns_error():
+    """Anything Feishu sends back that isn't pending/completed/denied/
+    expired surfaces as a structured error (so logs preserve the raw
+    message for debugging)."""
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.return_value = {"error": "slow_down"}
+        result = qr_poll_once("dc", domain="feishu")
+    assert result["status"] == "error"
+    assert "slow_down" in result["message"]
+
+
+def test_qr_poll_handles_transport_failure():
+    """Network failures during poll shouldn't kill the loop — return
+    a structured error and let the caller retry."""
+    from urllib.error import URLError
+    with patch("plugins.platforms.feishu.adapter._post_registration") as mock_post:
+        mock_post.side_effect = URLError("connection refused")
+        result = qr_poll_once("dc", domain="feishu")
+    assert result["status"] == "error"
+    assert "transport" in result["message"]
