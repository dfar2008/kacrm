+class TestDmApprovalClickAuthorization(unittest.TestCase):
+    """Regression: an inbound-DM approval card's Approve click must be
+    authorized (live-verified 2026-08-16).
+
+    Inbound Feishu DMs carry "oc_"-prefixed chat ids (same prefix as
+    groups); only open_id-keyed proactive sends use "ou_". The DM bypass
+    used to key on the "ou_" prefix alone, so every click on a card raised
+    from a normal DM conversation fell through to the GROUP policy gate and
+    was rejected ("Unauthorized approval click"). Detection now also keys
+    on the stored gateway session_key ("agent:<profile>:feishu:dm:<chat>").
+    """
+
+    def _make_adapter(self, group_policy="allowlist"):
+        from plugins.platforms.feishu.adapter import FeishuAdapter
+
+        adapter = object.__new__(FeishuAdapter)
+        adapter._approval_state = {}
+        adapter._admins = set()
+        adapter._allowed_group_users = set()
+        adapter._group_rules = {}
+        adapter._default_group_policy = ""
+        adapter._group_policy = group_policy
+        adapter._sender_name_cache = {}
+        adapter._submitted = []
+        adapter._submit_on_loop = lambda loop, coro: (
+            adapter._submitted.append(coro), coro.close(), True
+        )[-1]
+        return adapter
+
+    def _click(self, adapter, chat_id, approval_id="ap1"):
+        operator = SimpleNamespace(open_id="ou_clicker", user_id="")
+        context = SimpleNamespace(open_chat_id=chat_id)
+        event = SimpleNamespace(operator=operator, context=context)
+        return adapter._handle_approval_card_action(
+            event=event,
+            action_value={"approval_id": approval_id, "hermes_action": "approve"},
+            loop=None,
+        )
+
+    def test_inbound_dm_click_is_authorized(self):
+        adapter = self._make_adapter()
+        adapter._approval_state["ap1"] = {
+            "session_key": "agent:main:feishu:dm:oc_dmchat",
+            "message_id": "om_1",
+            "chat_id": "oc_dmchat",  # inbound DM: oc_-prefixed, NOT ou_
+        }
+        self._click(adapter, "oc_dmchat")
+        self.assertEqual(
+            len(adapter._submitted), 1,
+            "DM approval click must reach _resolve_approval, not the group gate",
+        )
+
+    def test_openid_keyed_dm_click_still_authorized(self):
+        adapter = self._make_adapter()
+        adapter._approval_state["ap1"] = {
+            "session_key": "",
+            "message_id": "om_1",
+            "chat_id": "ou_peer",  # proactive open_id-keyed send
+        }
+        self._click(adapter, "ou_peer")
+        self.assertEqual(len(adapter._submitted), 1)
+
+    def test_click_rejected_when_operator_not_in_configured_allowlist(self):
+        """v0.21.0 moved the card-action gate from the GROUP policy to
+        ``_is_interactive_operator_authorized``: with no admins/allowlist
+        configured every operator is authorized (which is precisely the
+        root-cause fix for the DM rejection we hit live on 2026-08-16 —
+        upstream now owns it). The guard that remains is the allowlist
