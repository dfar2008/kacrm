+# ----------------------------------------------------------------------
+# View specs. Every module gets the same five-view package kacrm ships —
+# "All Records" is the neutral default; the rest filter by the current user.
+#
+# ``filter.value = "current"`` is kacrm's sentinel for "substitute caller's
+# user_id at query time". "team" substitutes the caller's department tree.
+# ----------------------------------------------------------------------
+
+DEFAULT_VIEWS: List[Dict[str, Any]] = []  # cloud: views start empty; users create their own (Spec 2)
+
+# The first N is_default=True fields of each module become the initial column
+# set for every seeded view. Six fits in a typical table viewport without
+# horizontal scroll.
+DEFAULT_VIEW_FIELD_COUNT = 6
+
+
+# ----------------------------------------------------------------------
+# Seed routines
+# ----------------------------------------------------------------------
+
+def _upsert_module_field(
+    db: DbWrapper,
+    module_id: int,
+    spec: Dict[str, Any],
+) -> int:
+    """Upsert one module_fields row. Returns the row id (needed for view_fields)."""
+    row = db.fetchone(
+        """
+        INSERT INTO module_fields (
+            module_id, field_label, field_name, field_type,
+            is_required, is_readonly, is_default, is_system,
+            is_summary, is_searchable, sort_order, options, description,
+            field_config
+        )
+        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s,
+                CAST(%s AS json))
+        ON CONFLICT (module_id, field_name) DO UPDATE SET
+            field_label  = EXCLUDED.field_label,
+            field_type   = EXCLUDED.field_type,
+            is_required  = EXCLUDED.is_required,
+            is_readonly  = EXCLUDED.is_readonly,
+            is_default   = EXCLUDED.is_default,
+            is_system    = EXCLUDED.is_system,
+            is_summary   = EXCLUDED.is_summary,
+            is_searchable = EXCLUDED.is_searchable,
+            sort_order   = EXCLUDED.sort_order,
+            options      = EXCLUDED.options,
+            description  = EXCLUDED.description,
+            -- field_config holds admin-owned config (autonumber / formula /
+            -- label_i18n edits); never clobber it on re-seed — only fill it
+            -- in when the row has none yet.
+            field_config = COALESCE(module_fields.field_config, EXCLUDED.field_config)
+        RETURNING id
+        """,
+        (
+            module_id,
+            spec["field_label"],
+            spec["field_name"],
+            spec["field_type"],
+            spec["is_required"],
+            spec["is_readonly"],
+            spec["is_default"],
+            spec["is_system"],
+            spec["is_summary"],
+            spec["is_searchable"],
+            spec["sort_order"],
+            spec["options"],
+            spec["description"],
+            json.dumps(spec["field_config"], ensure_ascii=False)
+            if spec.get("field_config") else None,
+        ),
+    )
+    return int(row["id"]) if row else 0
+
+
+def _upsert_view(
+    db: DbWrapper,
+    module_id: int,
+    admin_user_id: int,
+    view: Dict[str, Any],
+) -> int:
+    """Insert-or-update by ``(module_id, name)``.
+
+    No DB-level unique index on that pair (kacrm allows duplicates for custom
+    views), so we emulate it in the seed: look up first, then insert or update.
+    """
+    existing = db.fetchone(
+        "SELECT id FROM module_views WHERE module_id = %s AND name = %s",
+        (module_id, view["name"]),
+    )
+    filters_json = json.dumps(view.get("filters") or [])
+    is_default = bool(view.get("is_default", False))
+    sort_order = int(view.get("sort_order", 0))
+
+    if existing:
+        view_id = int(existing["id"])
+        db.execute(
+            """
+            UPDATE module_views
+            SET filters = %s::jsonb,
+                is_default = %s,
+                sort_order = %s,
+                updated_by = %s
+            WHERE id = %s
+            """,
+            (filters_json, is_default, sort_order, admin_user_id, view_id),
+        )
+        return view_id
+
+    row = db.fetchone(
+        """
+        INSERT INTO module_views
+            (module_id, name, type, filters, is_default, is_public,
+             sort_order, created_by, updated_by)
+        VALUES (%s, %s, 'table', %s::jsonb, %s, TRUE, %s, %s, %s)
+        RETURNING id
+        """,
+        (
+            module_id,
+            view["name"],
+            filters_json,
+            is_default,
+            sort_order,
+            admin_user_id,
+            admin_user_id,
+        ),
+    )
+    return int(row["id"]) if row else 0
+
+
+def seed_module_metadata(db: DbWrapper, admin_user_id: int) -> None:
+    """Populate module_fields / module_views / module_view_fields.
+
+    Expects ``collections`` rows to already exist (they're seeded earlier in
+    :func:`seed`). ``admin_user_id`` owns every default view — the record
+    layer doesn't have user-created views yet.
+    """
+    # Map collection name → id once so we don't round-trip per field.
+    rows = db.fetchall("SELECT id, name FROM collections")
+    collection_id_by_name = {r["name"]: int(r["id"]) for r in rows}
+
+    mvf_gateway = ModuleViewFieldsDb(db)
+
+    for collection_name, specs in MODULE_FIELDS_SPEC.items():
+        module_id = collection_id_by_name.get(collection_name)
+        if module_id is None:
+            # Collection not seeded yet — skip gracefully. Loud warnings here
+            # would break re-runs when someone temporarily removes a collection.
+            continue
+
+        # ``collection_fields`` was kacrm's form-layer metadata table; the
+        # hermes seed used to upsert into it here, but the table is a
+        # zombie — nothing in tools / skills / SPA reads it (module_fields
+        # is the single source). Dropped 2026-05-26 along with the table
+        # itself (alembic 0082).
+
+        # module_fields — normalized list-layer row per field. Collect
+        # ids so the default view can pick its column set without re-querying.
+        field_id_by_name: Dict[str, int] = {}
+        for spec in specs:
+            field_id = _upsert_module_field(db, module_id, spec)
+            field_id_by_name[spec["field_name"]] = field_id
+
+        # (3) module_views — default view package.
+        view_ids: List[int] = []
+        for view in DEFAULT_VIEWS:
+            view_ids.append(_upsert_view(db, module_id, admin_user_id, view))
+
+        # (4) module_view_fields — first N is_default fields, in spec order.
+        default_field_names: List[str] = [
+            s["field_name"] for s in specs if s["is_default"]
+        ][:DEFAULT_VIEW_FIELD_COUNT]
+        entries = [
+            {"field_id": field_id_by_name[name], "sort_order": i, "width": None}
+            for i, name in enumerate(default_field_names)
+        ]
+        for view_id in view_ids:
+            # set_view_fields is DELETE + bulk INSERT inside a transaction;
+            # matches the "seed is idempotent, reconverges on declared state"
+            # discipline we use elsewhere.
+            mvf_gateway.set_view_fields(view_id, entries)
