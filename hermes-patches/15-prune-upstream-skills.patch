-// Clifford Attractor
-function cliffordAttractor(a, b, c, d, iterations) {
-  let x = 0, y = 0;
-  beginShape(POINTS);
-  for (let i = 0; i < iterations; i++) {
-    let nx = Math.sin(a * y) + c * Math.cos(a * x);
