index 0000000000..0a6e79e90d
--- /dev/null
+++ b/tools/crm_tools.py
@@ -0,0 +1,224 @@
+"""CRM tools — first-class hermes built-in (Charter v2 Phase 4b'.1.a, 2026-05-06).
+
+Replaces the ``hermes_cloud.plugins.crm_tools`` entry-point plugin with
+a native ``hermes/tools/`` module that ``discover_builtin_tools()``
+auto-imports at hermes startup. Makes CRM tools first-class agent
+capabilities of hermes — same pattern as ``cronjob_tools.py`` —
+rather than dynamically injected by an outside plugin at boot.
+
+Implementation note (4b'.1.a is the FIRST slice of a larger move):
+the actual ToolSpec construction (``build_crm_tools``) and SQL
+dispatch (``dispatch``) still live in ``hermes_cloud.app.bridge``.
+This module is the THIN registration shim that imports them and
+hands each tool to ``registry.register()``. Subsequent slices
+(4b'.1.b onward) move the implementations into hermes.
+
+Activation:
+- ``CRM_USER_ID`` env var is set by ``ProfileManager`` when spawning a
+  per-profile hermes subprocess. Standalone hermes (no cloud) leaves
+  it unset and this module skips registration entirely — preserving
+  upstream's "hermes works without hermes_cloud" property.
+- ``HERMES_HOME`` basename = profile slug (e.g. ``admin``); identifies
+  which profile the registered tools are bound to for RBAC.
+
+The AST detector in ``tools/registry.discover_builtin_tools`` checks
+for a top-level ``registry.register(...)`` call to decide whether to
+import this module — so registration happens at module body level
+(in a try/except block) rather than inside a function.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+
+# Resolve the hermes registry up front. The relative ``tools.registry``
+# path matches how upstream tool modules (e.g. cronjob_tools.py) import
+# it; the ``hermes.tools.registry`` fallback covers callers running
+# hermes as a package.
+try:
+    from tools.registry import registry  # type: ignore[import-not-found]
+except Exception:
+    from hermes.tools.registry import registry  # type: ignore[no-redef]
+
+# Per-turn identity primitives. Under the kacrm single-process multiplexer
+# these resolve the ACTIVE profile per call (context-local HERMES_HOME
+# override), so a CRM handler must never bake identity at registration time.
+try:
+    from hermes_constants import get_hermes_home, get_hermes_home_override
+except Exception:  # pragma: no cover - package-layout fallback
+    from hermes.hermes_constants import get_hermes_home, get_hermes_home_override
+
+try:
+    from agent.secret_scope import is_multiplex_active
+except Exception:  # pragma: no cover - package-layout fallback
+    from hermes.agent.secret_scope import is_multiplex_active
+
+
+class UnscopedCrmIdentityError(RuntimeError):
+    """Raised when a CRM handler runs under multiplexing with no per-turn scope.
+
+    Fail-closed twin of ``hermes_cloud.app.identity.UnscopedIdentityError``,
+    defined locally so ``hermes/tools/crm_tools.py`` keeps hermes standalone
+    (no reverse import into ``hermes_cloud``). Resolving the process default
+    here would dispatch the CRM write under the wrong tenant.
+    """
+
+
+# Per-slug bigint cache — keyed by profile slug so a multiplexer serving many
+# tenants never collapses two tenants onto one id. Slugs are immutable.
+_uid_by_slug: dict[str, int] = {}
+
+
+def _resolve_user_id_int(profile_slug: str) -> int:
+    """Resolve bigint ``users.id`` for a profile slug, per call (cached by slug).
+
+    Inlined (rather than importing ``hermes_cloud.app.identity``) to avoid a
+    hermes → hermes_cloud reverse dependency and preserve this module's
+    "hermes works without hermes_cloud" property. Uses the same ``crm.db``
+    session the CRM dispatch already runs on.
+    """
+    cached = _uid_by_slug.get(profile_slug)
+    if cached is not None:
+        return cached
+    try:
+        from crm.db import db_session
+    except Exception:  # pragma: no cover - package-layout fallback
+        from hermes.crm.db import db_session
+    with db_session() as db:
+        row = db.fetchone(
+            "SELECT id FROM users WHERE username = %s AND deleted = FALSE LIMIT 1",
+            (profile_slug,),
+        )
+    if row is None:
+        raise RuntimeError(
+            f"No active user with username={profile_slug!r}; "
+            f"HERMES_HOME basename must match a users.username row."
+        )
+    uid = int(row["id"])
+    _uid_by_slug[profile_slug] = uid
+    return uid
+
+
+def _resolve_identity(import_uid, import_pid):
+    """Resolve ``(profile_id, user_id)`` for the CURRENT turn.
+
+    - Multiplex active: resolve per turn from the context-local profile scope.
+      Fail closed (``UnscopedCrmIdentityError``) when no scope is installed —
+      never fall back to import-time identity, which would be the wrong tenant.
+    - Multiplex off (single-profile default): return the identity baked at
+      registration time, byte-for-byte identical to the legacy handler.
+    """
+    if is_multiplex_active():
+        if get_hermes_home_override() is None:
+            raise UnscopedCrmIdentityError(
+                "CRM handler invoked with no per-turn profile scope while "
+                "multiplexing is on. Identity must resolve inside a "
+                "set_hermes_home_override(...) block; dispatching with the "
+                "process default would write under the wrong tenant."
+            )
+        profile_id = get_hermes_home().name
+        return profile_id, _resolve_user_id_int(profile_id)
+    return import_pid, import_uid
+
+
+def _make_handler(tool_name: str, uid, pid: str, dispatch_fn):
+    def handler(args: dict, **_kw) -> str:
+        try:
+            profile_id, user_id = _resolve_identity(uid, pid)
+            result = dispatch_fn(
+                tool_name=tool_name,
+                arguments=args,
+                user_id=user_id,
+                source="agent:hermes",
+                profile_id=profile_id,
+            )
+            return json.dumps(result, ensure_ascii=False, default=str)
+        except Exception as exc:
+            return json.dumps(
+                {"error": f"{type(exc).__name__}: {exc}"},
+                ensure_ascii=False,
+            )
+    return handler
+
+
+# ---------------------------------------------------------------------------
+# Module-load registration. Wrapped in a single try/except so any failure
+# (CRM_USER_ID unset / cloud not installed / DB unreachable) is logged
+# but does NOT abort hermes startup. The first ``registry.register()``
+# below is at module body level so the AST detector recognises us as
+# a self-registering tool module — even when the surrounding logic
+# short-circuits, the literal call satisfies the marker.
+# ---------------------------------------------------------------------------
+
+_user_id_raw = os.environ.get("CRM_USER_ID", "").strip()
+_hermes_home = os.environ.get("HERMES_HOME", "")
+_profile_id = os.path.basename(_hermes_home) if _hermes_home else _user_id_raw or "_no_profile_"
+
+try:
+    _user_id = int(_user_id_raw) if _user_id_raw else None
+except (TypeError, ValueError):
+    _user_id = None
+    logger.warning("crm_tools: CRM_USER_ID=%r is not an integer", _user_id_raw)
+
+# Sentinel registration — always succeeds, satisfies the AST detector,
+# never collides with a real tool. The handler is a no-op so even if
+# something probes it, nothing breaks. Stable name so a re-import
+# (worker reload) is idempotent.
+registry.register(
+    name="_crm_tools_loaded_marker",
+    toolset="crm",
+    schema={"name": "_crm_tools_loaded_marker", "description": "internal", "parameters": {"type": "object", "properties": {}}},
+    handler=lambda args, **_kw: json.dumps({"ok": True}, ensure_ascii=False),
+    description="Internal sentinel — confirms hermes/tools/crm_tools.py loaded.",
+    emoji="\U0001f4bc",
+)
+
+# Register the real CRM tools when either:
+#   - CRM_USER_ID is set at import (per-profile subprocess, non-multiplex), OR
+#   - the process is a profile multiplexer (identity resolves per turn, so a
+#     concrete import-time user_id is NOT required — the handler fails closed
+#     if a turn ever reaches it without a scope).
+# Standalone hermes (no cloud, not multiplexed) still registers only the
+# sentinel, preserving upstream's "hermes works without hermes_cloud" property.
+try:
+    _multiplex = is_multiplex_active()
+except Exception:  # pragma: no cover - defensive
+    _multiplex = False
+
+if _user_id is not None or _multiplex:
+    try:
+        # Phase 4b'.1.b: dispatch moved to hermes/tools/crm/dispatch.py.
+        try:
+            from tools.crm.dispatch import build_crm_tools, dispatch
+        except Exception:
+            from hermes.tools.crm.dispatch import build_crm_tools, dispatch
+        _specs = build_crm_tools()
+        for _spec in _specs:
+            registry.register(
+                name=_spec.name,
+                toolset="crm",
+                schema={
+                    "name": _spec.name,
+                    "description": _spec.description,
+                    "parameters": _spec.input_schema,
+                },
+                handler=_make_handler(_spec.name, _user_id, _profile_id, dispatch),
+                description=_spec.description,
+                emoji="\U0001f4bc",
+            )
+        logger.info(
+            "crm_tools: registered %d native built-in tools "
+            "(import user_id=%s profile=%s multiplex=%s; identity resolves "
+            "per turn when multiplexed)",
+            len(_specs), _user_id, _profile_id, _multiplex,
+        )
+    except Exception:
+        logger.exception("crm_tools: registration failed (cloud not available?)")
+else:
+    logger.debug(
+        "crm_tools: CRM_USER_ID unset and not multiplexed, only sentinel "
+        "registered (standalone hermes mode)"
+    )
diff --git a/tools/scope.py b/tools/scope.py
new file mode 100644
index 0000000000..2235426983
--- /dev/null
+++ b/tools/scope.py
@@ -0,0 +1,90 @@
+"""Surface-aware team scope binding (Phase 5.1 patch 30).
+
+Cloud surface layers (SPA Copilot / 飞书 / iLink / auto_drive) tell
+hermes which user_ids the current request may read via the
+``X-Hermes-Scope`` HTTP header. The gateway parses the header into
+a ``dict`` and binds it to a ContextVar here. CRM tools' dispatch
+(``tools/crm/dispatch.py``) consume the bound user_ids list and apply
+``WHERE owner_by = ANY(...)`` filters at the SQL layer.
+
+**The LLM never sees the ACL'd user_id list** — pure dispatch-layer
+concern. LLM may pass ``arguments.scope='team'`` to opt INTO a
+narrower view (subset only), but it cannot expand beyond what was
+bound by the cloud (no privilege escalation).
+
+Security model:
+
+* No scope bound → fall back to caller-only ('self' default).
+* Scope bound with valid ``user_ids`` list → enforcement on.
+* Scope bound but malformed → fall back to 'self' (fail-closed).
+"""
+from __future__ import annotations
+
+import contextvars
+from typing import Any, Dict, List, Optional
+
+
+# Bound payload: {"kind": "team"|"org"|"self", "user_ids": [int, ...]}
+_surface_scope: contextvars.ContextVar[Optional[Dict[str, Any]]] = (
+    contextvars.ContextVar("surface_scope", default=None)
+)
+
+
+def bind_surface_scope(
+    payload: Dict[str, Any],
+) -> contextvars.Token[Optional[Dict[str, Any]]]:
+    """Bind ``payload`` as the current request's surface scope."""
+    return _surface_scope.set(payload)
+
+
+def reset_surface_scope(
+    token: contextvars.Token[Optional[Dict[str, Any]]],
+) -> None:
+    _surface_scope.reset(token)
+
+
+def get_current_surface_scope() -> Optional[Dict[str, Any]]:
+    return _surface_scope.get()
+
+
+def viewable_user_ids_or_caller(caller_id: int) -> List[int]:
+    """Resolve the user_id list a CRM SQL filter should use this turn.
+
+    * No scope bound → ``[caller_id]`` (back-compat / 'self').
+    * Scope bound with valid user_ids → that list (subset enforcement
+      applied: caller cannot see beyond what was bound).
+    * Scope bound but malformed → ``[caller_id]`` (fail-closed).
+
+    The returned list is always non-empty; if ``caller_id`` not in
+    the bound list (shouldn't happen but defensive), still includes
+    caller_id.
+    """
+    payload = _surface_scope.get()
+    if not isinstance(payload, dict):
+        return [int(caller_id)]
+    raw = payload.get("user_ids")
+    if not isinstance(raw, list):
+        return [int(caller_id)]
+    out: List[int] = []
+    for x in raw:
+        try:
+            out.append(int(x))
+        except (TypeError, ValueError):
+            continue
+    if not out:
+        return [int(caller_id)]
+    if int(caller_id) not in out:
+        out.append(int(caller_id))
+    return out
+
+
+def describe_current_scope() -> str:
+    """Compact log/audit summary."""
+    payload = _surface_scope.get()
+    if payload is None:
+        return "<unbound>"
+    if not isinstance(payload, dict):
+        return f"<malformed:{type(payload).__name__}>"
+    kind = payload.get("kind", "?")
+    n = len(payload.get("user_ids") or [])
+    return f"kind={kind!r} user_ids_count={n}"
diff --git a/tools/surface_acl.py b/tools/surface_acl.py
