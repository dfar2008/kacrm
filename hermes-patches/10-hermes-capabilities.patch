+"""Draft an outbound email/message for a CRM record (Phase 4 patch 26)."""
+from __future__ import annotations
+import logging
+from typing import Optional
+from hermes.skills._utils.llm import SkillLLMError, run_llm_utility
+from hermes.skills._utils.records import fetch_record_for_skill
+from hermes.skills._utils.skill_md import load_skill_body
+
+logger = logging.getLogger(__name__)
+_REQUIRED_SECTIONS = ("【主题】", "【正文】", "【备注】", "【Compliance 扫描】")
+
+
+def draft_email(*, module: str, record_id: int, intent: str = "reactivation") -> Optional[str]:
+    record = fetch_record_for_skill(module, record_id)
+    if record is None:
+        return None
+    try:
+        skill_body = load_skill_body("crm-email-drafting")
+    except FileNotFoundError as exc:
+        logger.error("crm-email-drafting SKILL.md missing: %s", exc)
+        return None
+    user_prompt = _build_user_prompt(record, intent)
+    try:
+        text = run_llm_utility(
+            [{"role": "system", "content": skill_body},
+             {"role": "user", "content": user_prompt}],
+            temperature=0.4,
+        )
+    except SkillLLMError as exc:
+        logger.info("crm_email_drafting llm failed module=%s id=%s err=%s",
+                    module, record_id, exc)
+        return None
+    text = text.strip()
+    missing = [s for s in _REQUIRED_SECTIONS if s not in text]
+    if missing:
+        logger.info("crm_email_drafting malformed sections=%s module=%s id=%s",
+                    missing, module, record_id)
+        return None
+    return text
+
+
+def _build_user_prompt(record: dict, intent: str) -> str:
+    name = record.get(f"{record['__module']}_name") or "(未命名)"
+    milestone = record.get("milestone") or "(unknown)"
+    interactions = record.get("__recent_interactions") or []
+    int_lines = "\n".join(
+        f"- [{i.get('at', '')[:10]} {i.get('kind', '?')}] {i.get('preview', '')[:120]}"
+        for i in interactions[:5]
+    ) or "(无最近互动)"
+    return f"""为下列 {record['__module']} 记录起草一封外发邮件：
+
+记录: {name}
+阶段: {milestone}
+场景 (intent): {intent}
+
+最近互动（从新到旧）：
+{int_lines}
+
+按 SKILL.md 的 4 段式输出，**Compliance 扫描段不可省略**。
+仅输出 4 段内容，不要前后解释、不要 markdown 章节标题。"""
