+# =============================================================================
+# Non-blocking iLink QR primitives — for hermes-cloud SPA scan-to-connect.
+#
+# qr_login() blocks the entire scan flow in one async function — fine
+# for the CLI wizard but doesn't fit HTTP request-response cycles.
+# qr_start_async() / qr_poll_once_async() let the SPA poll discretely
+# from the browser.
+# =============================================================================
+
+
+async def qr_start_async(
+    *, bot_type: str = "3", timeout_seconds: int = 480,
+) -> Dict[str, Any]:
+    """Fetch a fresh QR code from iLink. Non-blocking.
+
+    Returns::
+
+        {
+            "qrcode":     str,   # hex token — pass to qr_poll_once_async
+            "qrcode_url": str,   # full liteapp URL — caller renders into <img>
+            "base_url":   str,   # initial poll target (may change mid-flow)
+            "expire_in":  int,   # seconds until QR expires
+        }
+
+    Raises ``RuntimeError`` if aiohttp isn't installed or iLink rejects
+    the request (network error wrapped with a clearer message).
+    """
+    if not AIOHTTP_AVAILABLE:
+        raise RuntimeError("aiohttp is required for Weixin QR login")
+
+    async with aiohttp.ClientSession(
+        trust_env=True, connector=_make_ssl_connector(),
+    ) as session:
+        try:
+            qr_resp = await _api_get(
+                session,
+                base_url=ILINK_BASE_URL,
+                endpoint=f"{EP_GET_BOT_QR}?bot_type={bot_type}",
+                timeout_ms=QR_TIMEOUT_MS,
+            )
+        except Exception as exc:
+            raise RuntimeError(f"iLink QR fetch failed: {exc}") from exc
+
+    qrcode_value = str(qr_resp.get("qrcode") or "")
+    qrcode_url = str(qr_resp.get("qrcode_img_content") or "")
+    if not qrcode_value:
+        raise RuntimeError("iLink QR response missing 'qrcode' field")
+    return {
+        "qrcode": qrcode_value,
+        "qrcode_url": qrcode_url,
+        "base_url": ILINK_BASE_URL,
+        "expire_in": timeout_seconds,
+    }
+
+
+async def qr_poll_once_async(
+    qrcode: str,
+    base_url: str = ILINK_BASE_URL,
+    *,
+    hermes_home: Optional[str] = None,
+) -> Dict[str, Any]:
+    """Poll iLink for QR scan status exactly once. Non-blocking.
+
+    Returns one of (status discriminated union)::
+
+        {"status": "pending"}
+        {"status": "scanned"}                 # user scanned, awaiting confirm
+        {"status": "redirect", "base_url": str}  # poll on a new host
+        {"status": "expired"}
+        {"status": "completed", "creds": {...}}
+        {"status": "error", "message": str}
+
+    When ``hermes_home`` is set on a ``completed`` result, the creds
+    are also persisted via ``save_weixin_account`` so the next process
+    boot finds them already in env. Pass ``None`` to skip persistence
+    (cloud writes via its own ``_write_channel_config`` path).
+    """
+    if not AIOHTTP_AVAILABLE:
+        return {"status": "error", "message": "aiohttp not installed"}
+
+    try:
+        async with aiohttp.ClientSession(
+            trust_env=True, connector=_make_ssl_connector(),
+        ) as session:
+            status_resp = await _api_get(
+                session,
+                base_url=base_url,
+                endpoint=f"{EP_GET_QR_STATUS}?qrcode={qrcode}",
