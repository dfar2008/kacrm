index 0000000000..1d1e3d1974
--- /dev/null
+++ b/tests/gateway/test_stream_consumer_reasoning.py
@@ -0,0 +1,122 @@
+"""IM live-thinking preview regressions (2026-07-07 latency plan).
+
+While no answer text has streamed yet, reasoning tokens render as a
+transient "💭 …" preview in the streaming message; the first real content
+edit overwrites it, and a content-less turn retracts it.
+"""
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.stream_consumer import (
+    GatewayStreamConsumer,
+    StreamConsumerConfig,
+)
+
+
+def _adapter():
+    a = MagicMock()
+    a.MAX_MESSAGE_LENGTH = 4096
+    a.send = AsyncMock(return_value=SimpleNamespace(success=True, message_id="m1"))
+    a.edit_message = AsyncMock(return_value=SimpleNamespace(success=True, message_id="m1"))
+    a.delete_message = AsyncMock(return_value=SimpleNamespace(success=True))
+    return a
+
+
+def _consumer(adapter, **cfg_kwargs):
+    cfg = StreamConsumerConfig(edit_interval=0.0, buffer_threshold=10_000, **cfg_kwargs)
+    return GatewayStreamConsumer(adapter, "chat_1", cfg)
+
+
+@pytest.mark.asyncio
+async def test_reasoning_preview_then_content_overwrites():
+    adapter = _adapter()
+    c = _consumer(adapter, reasoning_preview=True)
+    task = asyncio.get_event_loop().create_task(c.run())
+    c.on_reasoning("用户在问今天的任务,我先查 CRM。")
+    await asyncio.sleep(0.15)
+    # Preview sent with 💭 prefix
+    sent_texts = [
+        (call.kwargs.get("content") or (call.args[1] if len(call.args) > 1 else ""))
+        for call in adapter.send.call_args_list
+    ]
+    assert any(t.startswith("💭") for t in sent_texts), sent_texts
+    # Real content arrives → next edit shows content, not the preview
+    c.on_delta("你今天有两件事:")
+    await asyncio.sleep(0.15)
+    c.finish()
+    await asyncio.wait_for(task, timeout=5)
+    edited = [
+        (call.kwargs.get("content")
+         or (call.args[2] if len(call.args) > 2 else ""))
+        for call in adapter.edit_message.call_args_list
+    ]
+    assert any("你今天有两件事" in t and "💭" not in t for t in edited), edited
+
+
+@pytest.mark.asyncio
+async def test_contentless_turn_retracts_preview():
+    adapter = _adapter()
+    c = _consumer(adapter, reasoning_preview=True)
+    task = asyncio.get_event_loop().create_task(c.run())
+    c.on_reasoning("thinking only, no answer")
+    await asyncio.sleep(0.15)
+    c.finish()
+    await asyncio.wait_for(task, timeout=5)
+    # Preview message deleted; nothing claimed as delivered.
+    assert adapter.delete_message.called
+    assert not c._final_response_sent
+
+
+@pytest.mark.asyncio
+async def test_preview_off_by_default():
+    # 2026-07-07 field verdict: raw reasoning is not user-grade content —
+    # preview must be opt-in.
+    adapter = _adapter()
+    c = _consumer(adapter)
+    task = asyncio.get_event_loop().create_task(c.run())
+    c.on_reasoning("should be ignored")
+    await asyncio.sleep(0.15)
+    c.finish()
+    await asyncio.wait_for(task, timeout=5)
+    assert not adapter.send.called
+
+
+@pytest.mark.asyncio
+async def test_segment_break_retracts_preview_and_resets(adapter=None):
+    """复刻 2026-07-07 飞书截图 bug:思考→工具边界→正文,预览被孤儿化。
+
+    段边界处纯预览消息必须撤回(而非定稿),思考累积必须清零,正文落在
+    新消息里。
+    """
+    adapter = _adapter()
+    c = _consumer(adapter, reasoning_preview=True)
+    task = asyncio.get_event_loop().create_task(c.run())
+    c.on_reasoning("round-1 thinking before the tool call")
+    await asyncio.sleep(0.15)
+    assert any(
+        (call.kwargs.get("content") or "").startswith("💭")
+        for call in adapter.send.call_args_list
+    )
+    # 工具边界(agent 在工具执行前发 None)
+    c.on_delta(None)
+    await asyncio.sleep(0.15)
+    # 预览消息被删除;思考状态清零
+    assert adapter.delete_message.called
+    assert c._reasoning_accum == ""
+    assert not c._reasoning_preview_shown
+    # 正文落新消息,不含 💭 也不含 round-1 思考
+    c.on_delta("最终回答内容")
+    await asyncio.sleep(0.15)
+    c.finish()
+    await asyncio.wait_for(task, timeout=5)
+    finals = [
+        (call.kwargs.get("content") or "") for call in adapter.send.call_args_list
+    ] + [
+        (call.kwargs.get("content") or "") for call in adapter.edit_message.call_args_list
+    ]
+    assert any("最终回答内容" in t and "💭" not in t and "round-1" not in t for t in finals), finals
