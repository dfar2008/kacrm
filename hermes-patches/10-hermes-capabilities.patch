+def _dispatch_list_modules(
+    *, db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Return all CRM modules with their names and labels."""
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        modules = ModulesDb(db).get_all_modules()
+        return {
+            "modules": [
+                {
+                    "name": m.get("name", ""),
+                    "title": m.get("title", ""),
+                    "id": int(m["id"]),
+                }
+                for m in modules
+                if m.get("name")
+            ],
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _dispatch_get_schema(
+    arguments: Dict[str, Any],
+    *, db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Return field-level schema for a CRM module."""
+    module_name = arguments.get("module_name", "")
+    if not module_name:
+        raise ValueError("module_name is required")
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        mod = ModulesDb(db).get_module_by_name(module_name)
+        if not mod:
+            raise ToolNotFoundError(f"unknown module: {module_name!r}")
+
+        module_id = int(mod["id"])
+        mfields = ModuleFieldsDb(db)
+        all_fields = mfields.get_module_fields(module_id)
+
+        fields = []
+        for f in all_fields:
+            field_info: Dict[str, Any] = {
+                "field_name": f.get("field_name", ""),
+                "field_label": f.get("field_label", ""),
+                "field_type": f.get("field_type", "text"),
+                "required": bool(f.get("is_required")),
+                "readonly": bool(f.get("is_readonly")),
+            }
+            # Include picklist options for select-type fields
+            ftype = (f.get("field_type") or "").strip()
+            if ftype in _SELECT_TYPES | _MULTISELECT_TYPES:
+                options = parse_picklist_options(f.get("options"))
+                field_info["options"] = [
+                    {"value": o.get("value", ""), "label": o.get("label", "")}
+                    for o in options
+                ]
+            # Include JSON schema representation
+            field_info["json_schema"] = _field_to_json_schema(f)
+            fields.append(field_info)
+
+        subdetails = []
+        for kid in (db.fetchall(
+            "SELECT id, name, title, detail_kind FROM collections "
+            "WHERE parent_module_id = %s ORDER BY id", (module_id,)) or []):
+            kid_fields = []
+            for kf in (mfields.get_module_fields(int(kid["id"])) or []):
+                fn = kf.get("field_name") or ""
+                if kf.get("is_hidden") or fn in (
+                        f"{kid['name']}_id", f"{module_name}_id",
+                        "created_at", "updated_at", "deleted"):
+                    continue
+                kid_fields.append({
+                    "field_name": fn,
+                    "field_label": kf.get("field_label", ""),
+                    "field_type": kf.get("field_type", "text"),
+                    "readonly": bool(kf.get("is_readonly")),
+                })
+            subdetails.append({
+                "name": kid["name"],
+                "title": kid.get("title"),
+                "detail_kind": kid.get("detail_kind"),
+                "write_via": ("data.products"
+                              if kid.get("detail_kind") == "product"
+                              else "data.details"),
+                "fields": kid_fields,
+            })
+
+        return {
+            "module_name": module_name,
+            "module_title": mod.get("title", ""),
+            "fields": fields,
+            "subdetails": subdetails,
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _dispatch_task_create(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    source: str,
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """Submit a ``task.create`` action through the gateway dispatcher.
+
+    Mirrors the crm_write path: construct ``params``, hand to
+    ``gateway_dispatcher.submit(kind="task.create", ...)``, fold the
+    state-aware response into the standard ``{success, id, action_id}``
+    /``{success=false, pending_approval=true}`` shape the LLM expects.
+    """
+    title = str(arguments.get("title") or "").strip()
+    if not title:
+        return {"success": False, "error": "task_create_title_required"}
+
+    import hermes.action_gateway  # noqa: F401 — ensure executor registered
+    from hermes.action_gateway import dispatcher as gateway_dispatcher
+    from hermes_cloud.app.bridge import origin_context
+
+    params: Dict[str, Any] = {"title": title}
+    for key in (
+        "description", "due_at", "owner_user_id",
+        "related_module", "related_record_id", "meta",
+    ):
+        val = arguments.get(key)
+        if val is not None and val != "":
+            params[key] = val
+    # Stamp source_agent so task_create executor records who proposed it.
+    if agent_name:
+        params.setdefault("source_agent", agent_name)
+
+    if not (source or "").startswith("agent:"):
+        # Manual / non-agent caller — still go through gateway so trust
+        # decisions (and revert tokens) apply uniformly.
+        pass
+
+    try:
+        result = gateway_dispatcher.submit(
+            profile_id=profile_id or "",
+            agent_name=agent_name or "",
+            kind="task.create",
+            target={"title": title},
+            params=params,
+            user_id=user_id,
+            origin=origin_context.current(),
+            executing_specialist=agent_name or None,
+            db=db,
+        )
+    except Exception as exc:  # surfaced upstream; map to LLM-friendly error
+        return {
+            "success": False,
+            "error": f"task_create_dispatch_failed: {type(exc).__name__}: {exc}",
+        }
+
+    if result["state"] == "executed":
+        token = result.get("revert_token") or {}
+        tid = token.get("task_id")
+        # task_create is the LLM-facing primitive for "follow-up work";
+        # cronjob is its scheduling backend, NOT a peer tool the LLM
+        # picks between. When due_at is set, auto-schedule a hermes
+        # cronjob so the user gets a real-time push at due_at AND the
+        # CRM agent_tasks row for accountability. The two are composed,
+        # not competing — the LLM only needs to reason about
+        # task_create.
+        cron_job_id: Optional[str] = None
+        due_at = arguments.get("due_at")
+        if due_at and isinstance(due_at, str):
+            try:
+                from tools.cronjob_tools import cronjob as _cronjob_tool
+                _related = arguments.get("related_module")
+                _rid = arguments.get("related_record_id")
+                _ctx = ""
+                if _related and _rid:
+                    _ctx = f"（关联 {_related} #{_rid}）"
+                cron_resp = _cronjob_tool(
+                    action="create",
+                    prompt=f"⏰ CRM 任务到期提醒: {title}{_ctx}",
+                    schedule=str(due_at),
+                    name=f"task #{tid}: {title}"[:80] if tid else f"task: {title}"[:80],
+                )
+                # cronjob returns a JSON string; pluck job_id if present.
+                import json as _json_local
+                try:
+                    cron_data = _json_local.loads(cron_resp) if isinstance(cron_resp, str) else cron_resp
+                    if isinstance(cron_data, dict) and cron_data.get("success"):
+                        cron_job_id = str(cron_data.get("job_id") or "")
+                except Exception:
+                    cron_job_id = None
+            except Exception:
+                logger.exception(
+                    "task_create_cronjob_autoschedule_failed task_id=%s due_at=%s",
+                    tid, due_at,
+                )
+        out: Dict[str, Any] = {
+            "success": True,
+            "id": int(tid) if tid else 0,
+            "action_id": str(result["id"]),
+        }
+        if cron_job_id:
+            out["cron_job_id"] = cron_job_id
+            out["scheduled_at"] = str(due_at)
+        return out
+    if result["state"] == "pending_approval":
+        return {
+            "success": False,
+            "pending_approval": True,
+            "action_id": str(result["id"]),
+            "summary": result.get("summary") or f"task '{title}' 等待人工审批",
+            "message": (
+                "该任务已提交并等待人工审批；这不是失败，"
+                "不要重试或改写后再次调用。"
+            ),
+        }
+    return {
+        "success": False,
+        "error": f"task_create_unexpected_state: {result.get('state')}",
+        "action_id": str(result.get("id") or ""),
+    }
+
+
+def _dispatch_memory_write(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    source: str,
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """Submit a ``memory.write`` action through the gateway dispatcher.
+
+    Persists a distilled research fact into the CRM memory substrate.
+    Mirrors :func:`_dispatch_task_create`: build ``params``, hand to
+    ``gateway_dispatcher.submit(kind="memory.write", ...)``, fold the
+    state-aware response into the ``{success, memory_id, action_id,
+    linked}`` shape the LLM expects. When ``related_module`` /
+    ``related_record_id`` are given, resolve the record's identity
+    entity so the executor can link the new memory to that customer's
+    detail-page panel.
+    """
+    content = str(arguments.get("content") or "").strip()
+    if not content:
+        return {"success": False, "error": "memory_write_content_required"}
+
+    related_module = arguments.get("related_module") or None
+    related_record_id = arguments.get("related_record_id")
+    if related_record_id is not None:
+        related_record_id = int(related_record_id)
+    if (related_module is None) != (related_record_id is None):
+        return {"success": False, "error": "memory_write_related_pair_required"}
+    if (
+        related_module is not None
+        and related_module not in _MEMORY_WRITE_LINKABLE_MODULES
+    ):
+        return {
+            "success": False,
+            "error": "memory_write_related_module_unsupported",
+        }
+
+    import hermes.action_gateway  # noqa: F401 — ensure executor registered
+    from hermes.action_gateway import dispatcher as gateway_dispatcher
+    from hermes.crm.memory_identity import resolve_record_entity
+    from hermes_cloud.app.bridge import origin_context
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        link_entity_id: Optional[int] = None
+        record_had_no_entity = False
+        if related_module is not None and related_record_id is not None:
+            exists, entity_id = resolve_record_entity(
+                db, str(related_module), related_record_id,
+            )
+            if not exists:
+                return {
+                    "success": False,
+                    "error": "memory_write_record_not_found",
+                }
+            if entity_id is None:
+                record_had_no_entity = True
+            else:
+                link_entity_id = entity_id
+
+        meta: Dict[str, Any] = {"source_skill": "crm-research"}
+        if related_module is not None:
+            meta["related_module"] = related_module
+            meta["related_record_id"] = related_record_id
+
+        params: Dict[str, Any] = {
+            "content": content,
+            "kind": str(arguments.get("kind") or "fact"),
+            "scope": "user",
+            "user_id": user_id,
+            "meta": meta,
+        }
+        title = arguments.get("title")
+        if title:
+            params["title"] = str(title)
+        if agent_name:
+            params.setdefault("source_agent", agent_name)
+        if link_entity_id:
+            params["link_entity_id"] = int(link_entity_id)
+            params["link_role"] = "subject"
+
+        try:
+            result = gateway_dispatcher.submit(
+                profile_id=profile_id or "",
+                agent_name=agent_name or "",
+                kind="memory.write",
+                target={"module": "memories", "op": "create"},
+                params=params,
+                user_id=user_id,
+                origin=origin_context.current(),
+                executing_specialist=agent_name or None,
+                db=db,
+            )
+        except Exception as exc:  # guard ValueError / SecretDetected / blocked
+            return {
+                "success": False,
+                "error": (
+                    f"memory_write_dispatch_failed: "
+                    f"{type(exc).__name__}: {exc}"
+                ),
+            }
+
+        if result["state"] == "executed":
+            token = result.get("revert_token") or {}
+            memory_id = token.get("memory_id")
+            out: Dict[str, Any] = {
+                "success": True,
+                "memory_id": int(memory_id) if memory_id else 0,
+                "action_id": str(result["id"]),
+                "linked": link_entity_id is not None,
+            }
+            if token.get("op") == "noop":
+                if token.get("reason") == "dedupe":
+                    out["deduped"] = True
+                else:
+                    # soft-cap — quota exhausted, nothing inserted and the
+                    # executor never linked anything (it only links on
+                    # commit / dedupe). Never report linked=True here.
+                    out["soft_capped"] = True
+                    out["linked"] = False
+            if record_had_no_entity:
+                out["linked"] = False
+                out["reason"] = "record_has_no_entity"
+            return out
+        if result["state"] == "pending_approval":
+            return {
+                "success": False,
+                "pending_approval": True,
+                "action_id": str(result["id"]),
+                "summary": result.get("summary") or "memory 写入等待人工审批",
+                "message": (
+                    "该写入已提交并等待人工审批；这不是失败，"
+                    "不要重试或改写后再次调用。"
+                ),
+            }
+        return {
+            "success": False,
+            "error": f"memory_write_unexpected_state: {result.get('state')}",
+            "action_id": str(result.get("id") or ""),
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _dispatch_coach_proposal_submit(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    source: Optional[str],
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+    db: Any,
+) -> Dict[str, Any]:
+    """Submit one coach proposal as a ``gateway_actions`` row.
+
+    Used by ``crm-daily-coach`` skill (and similar). The skill calls
+    this once per card it produces. For ``crm-daily-coach`` the cron
+    scheduler renders the delivered digest from these cards; the
+    agent's final response is not itself delivered.
+    """
+    import hermes.action_gateway  # noqa: F401 — ensure executor registered
+    from hermes.action_gateway import dispatcher as gateway_dispatcher
+    from hermes_cloud.app.bridge import origin_context
+
+    summary = str(arguments.get("summary") or "").strip()
+    action = arguments.get("action") or {}
+    severity = str(arguments.get("severity") or "medium").lower()
+    if not summary:
+        return {"success": False, "error": "coach_proposal_summary_required"}
+    if not isinstance(action, dict) or not action.get("type"):
+        return {"success": False, "error": "coach_proposal_action_type_required"}
+    if action.get("type") == "send_message":
+        return {
+            "success": False,
+            "error": "coach_proposal_send_message_forbidden — use draft_message or task_create",
+        }
+
+    params: Dict[str, Any] = {
+        "user_id": str(int(user_id)),
+        "summary": summary,
+        "action": action,
+        "severity": severity,
+        "reasoning": str(arguments.get("reasoning") or ""),
+    }
+    context_line = str(arguments.get("context_line") or "").strip()
+    if context_line:
+        params["context_line"] = context_line[:60]
+    if arguments.get("notification_channels"):
+        params["notification_channels"] = list(arguments["notification_channels"])
+    target = arguments.get("target") or {}
+
+    try:
+        result = gateway_dispatcher.submit(
+            profile_id=profile_id or "",
+            agent_name=agent_name or "agent:crm-daily-coach",
+            kind="coach.proposal",
+            target=target,
+            params=params,
+            user_id=user_id,
+            origin=origin_context.current() or {"channel": "auto_drive"},
+            executing_specialist="crm-daily-coach",
+            db=db,
+        )
+    except Exception as exc:
+        return {
+            "success": False,
+            "error": f"coach_proposal_dispatch_failed: {type(exc).__name__}: {exc}",
+        }
+
+    return {
+        "success": True,
+        "action_id": str(result.get("id") or ""),
+        "state": result.get("state"),
+    }
+
