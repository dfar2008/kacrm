+
+def _parse_tool_name(name: str) -> Optional[tuple[str, str]]:
+    """Parse legacy per-module tool names for backwards compatibility.
+
+    ``crm_search_accounts`` → ``("search", "accounts")``.
+    """
+    if not name.startswith("crm_"):
+        return None
+    rest = name[len("crm_"):]
+    for verb in ("search", "get", "create", "update"):
+        prefix = verb + "_"
+        if rest.startswith(prefix):
+            module_name = rest[len(prefix):]
+            if module_name:
+                return verb, module_name
+    return None
+
+
+_VERB_TO_ACTION = {
+    "search": "index",
+    "get": "view",
+    "create": "create",
+    "update": "update",
+}
+
