index 0000000000..0d51bd4e9e
--- /dev/null
+++ b/plugins/cloud-approval/__init__.py
@@ -0,0 +1,171 @@
+"""cloud-approval plugin — slash commands for hermes-cloud Action Gateway.
+
+Charter §一原语 ⑤ + B9 from `docs/2026-04-25-deferred-upstream-features.md`.
+
+Registers two slash commands native to every gateway platform:
+
+* ``/approve <action_id>`` — approve a pending action.
+* ``/reject <action_id> [reason]`` — reject a pending action.
+
+The handlers POST to hermes_cloud's existing
+`/api/gateway/actions/{id}/approve` and `/api/gateway/actions/{id}/reject`
+endpoints using the `HERMES_CLOUD_INTERNAL_KEY` for auth. The
+``approver_id`` comes from the gateway session's bound user
+(``HERMES_CLOUD_PROFILE_ID`` env var, set by ProfileManager).
+
+On Discord, the SDK turns ``/approve`` + the ``args_hint=<action_id>``
+into a native slash command picker with an argument field — users see
+auto-complete instead of having to remember the ``通过 abc12345``
+prefix syntax. Slack and Telegram get equivalent BotCommand entries.
+
+For wecom_ilink (which doesn't support slash commands), the existing
+text-prefix parser at
+``hermes.action_gateway.text_commands.parse_command`` continues to
+handle ``通过 <prefix>`` / ``拒绝 <prefix>`` as a fallback. The
+prefix path stays for at least 6 months for muscle-memory continuity.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from typing import Optional
+
+logger = logging.getLogger(__name__)
+
+
+_DEFAULT_CLOUD_URL = "http://127.0.0.1:8765"
+
+
+def _cloud_base_url() -> str:
+    return (
+        os.environ.get("HERMES_CLOUD_INTERNAL_URL")
+        or os.environ.get("CLOUD_INTERNAL_URL")
+        or _DEFAULT_CLOUD_URL
+    ).rstrip("/")
+
+
+def _internal_key() -> Optional[str]:
+    return os.environ.get("HERMES_CLOUD_INTERNAL_KEY")
+
+
+def _profile_id() -> Optional[str]:
+    return os.environ.get("HERMES_CLOUD_PROFILE_ID")
+
+
+def _post_to_cloud(action_id: str, decision: str, reason: str = "") -> str:
+    """POST approve/reject to the cloud's gateway API. Returns a short
+    human-readable status string for the gateway to echo back."""
+    key = _internal_key()
+    if not key:
+        return (
+            "❌ 未连接到 hermes-cloud（HERMES_CLOUD_INTERNAL_KEY 未设置）。"
+            "请在 cloud 端的 ProfileManager 启动场景下使用此命令。"
+        )
+
+    profile_id = _profile_id()
+    headers = {
+        "Content-Type": "application/json",
+        "X-Internal-Key": key,
+    }
+    if profile_id:
+        # Cloud's /api/gateway endpoints expect dashboard auth; for
+        # plugin invocations from within a hermes subprocess we use the
+        # internal key. The cloud route then resolves the approver via
+        # X-Profile-Id (set by the cloud middleware to map back to a
+        # users.id row).
+        headers["X-Profile-Id"] = str(profile_id)
+
+    url = f"{_cloud_base_url()}/api/gateway/actions/{action_id}/{decision}"
+    body: dict = {}
+    if decision == "reject" and reason:
+        body["reason"] = reason
+
+    try:
+        import urllib.request
+        import urllib.error
+        import json as _json
+        req = urllib.request.Request(
+            url,
+            data=_json.dumps(body).encode("utf-8"),
+            headers=headers,
+            method="POST",
+        )
+        with urllib.request.urlopen(req, timeout=10.0) as resp:
+            payload = _json.loads(resp.read().decode("utf-8") or "{}")
+    except urllib.error.HTTPError as exc:  # type: ignore[name-defined]
+        # Body has the cloud's structured error.
+        try:
+            err_body = _json.loads(exc.read().decode("utf-8"))
+            err = err_body.get("error", {})
+            code = err.get("code") or ""
+            msg = err.get("message") or str(exc)
+        except Exception:
+            code, msg = "", str(exc)
+        if exc.code == 409 or "wrong_channel" in code.lower():
+            return (
+                "🔒 该审批由其他渠道触发，请在原渠道处理。"
+                f"（{action_id[:8]}…）"
+            )
+        if exc.code == 404 or "not_found" in code.lower():
+            return f"⚠️ 审批 {action_id[:8]} 不存在或已过期。"
+        if exc.code == 400:
+            return f"⚠️ {msg}"
+        return f"❌ cloud 返回 {exc.code}: {msg}"
+    except Exception as exc:
+        logger.warning("cloud-approval: POST failed: %s", exc)
+        return f"❌ 调用 cloud 失败：{exc}"
+
+    decision_label = "✅ 已通过" if decision == "approve" else "🚫 已拒绝"
+    return f"{decision_label} 审批 {action_id[:8]}"
+
+
+def _handle_approve(raw_args: str) -> str:
+    """``/approve <action_id>`` — slash command handler."""
+    argv = (raw_args or "").strip().split(maxsplit=1)
+    if not argv or argv[0] in ("help", "-h", "--help"):
+        return (
+            "用法: /approve <action_id>\n"
+            "  通过指定 ID 的待审批操作（前缀 8 字符也可，例如 abc12345）。\n"
+            "对应 cloud 端 POST /api/gateway/actions/{id}/approve。"
+        )
+    action_id = argv[0].strip()
+    if not action_id:
+        return "用法: /approve <action_id>"
+    return _post_to_cloud(action_id, "approve")
+
+
+def _handle_reject(raw_args: str) -> str:
+    """``/reject <action_id> [reason]`` — slash command handler."""
+    argv = (raw_args or "").strip().split(maxsplit=1)
+    if not argv or argv[0] in ("help", "-h", "--help"):
+        return (
+            "用法: /reject <action_id> [reason]\n"
+            "  拒绝指定 ID 的待审批操作。reason 可选（会写入审计日志）。"
+        )
+    action_id = argv[0].strip()
+    reason = argv[1].strip() if len(argv) > 1 else ""
+    if not action_id:
+        return "用法: /reject <action_id> [reason]"
+    return _post_to_cloud(action_id, "reject", reason=reason)
+
+
+def register(ctx) -> None:
+    """Plugin entry point — wire the two slash commands.
+
+    ``args_hint`` makes Discord render a native argument field in its
+    slash command picker. Slack and Telegram BotCommand pickers also
+    consume it.
+    """
+    ctx.register_command(
+        "approve",
+        handler=_handle_approve,
+        description="Approve a pending hermes-cloud Action Gateway action.",
+        args_hint="<action_id>",
+    )
+    ctx.register_command(
+        "reject",
+        handler=_handle_reject,
+        description="Reject a pending hermes-cloud Action Gateway action.",
+        args_hint="<action_id> [reason]",
+    )
