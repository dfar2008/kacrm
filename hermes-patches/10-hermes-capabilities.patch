index 0000000000..f2f3026746
--- /dev/null
+++ b/tools/surface_acl.py
@@ -0,0 +1,73 @@
+"""Surface-aware tool ACL enforcement (Phase 4 patch 27).
+
+Cloud surface layers (SPA Copilot / 飞书 / iLink / auto_drive) tell
+hermes which tools the current request is allowed to use via the
+``X-Hermes-Surface-ACL`` HTTP header. The gateway parses the header
+into a ``dict`` and binds it to a ContextVar here. The agent's tool
+dispatch (``run_agent.AIAgent._invoke_tool``) hard-checks the bound
+ACL **before** any tool is executed.
+
+**The LLM never sees the ACL** — pure dispatch-layer concern that
+defeats prompt-injection.
+
+Security model:
+
+* No ACL bound → enforcement OFF (back-compat for chatbox / hermes CLI).
+* ACL bound but malformed (``allow`` not a list, etc.) → fail-closed.
+* ACL bound and well-formed → strict allowlist.
+"""
+from __future__ import annotations
+
+import contextvars
+from typing import Any, Dict, Optional
+
+
+_surface_acl: contextvars.ContextVar[Optional[Dict[str, Any]]] = (
+    contextvars.ContextVar("surface_acl", default=None)
+)
+
+
+def bind_surface_acl(
+    payload: Dict[str, Any],
+) -> contextvars.Token[Optional[Dict[str, Any]]]:
+    """Bind ``payload`` as the current request's surface ACL."""
+    return _surface_acl.set(payload)
+
+
+def reset_surface_acl(token: contextvars.Token[Optional[Dict[str, Any]]]) -> None:
+    _surface_acl.reset(token)
+
+
+def get_current_surface_acl() -> Optional[Dict[str, Any]]:
+    """``None`` = no enforcement; dict = enforce."""
+    return _surface_acl.get()
+
+
+def is_tool_allowed(tool_name: str) -> bool:
+    """Hard ACL check.
+
+    * No ACL bound → True (back-compat).
+    * ACL bound but ``allow`` missing/malformed → False (fail-closed).
+    * ACL bound with valid ``allow`` list → ``tool_name in allow``.
+    """
+    acl = _surface_acl.get()
+    if acl is None:
+        return True
+    allow = acl.get("allow") if isinstance(acl, dict) else None
+    if not isinstance(allow, list):
+        return False
+    return tool_name in allow
+
+
+def describe_current_acl() -> str:
+    """Compact log/audit summary."""
+    acl = _surface_acl.get()
+    if acl is None:
+        return "<unbound>"
+    if not isinstance(acl, dict):
+        return f"<malformed:{type(acl).__name__}>"
+    surface = acl.get("surface", "?")
+    allow = acl.get("allow")
+    if not isinstance(allow, list):
+        return f"surface={surface} <malformed:allow not a list>"
+    return f"surface={surface} allow={len(allow)}"
