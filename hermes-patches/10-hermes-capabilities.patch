@@ -0,0 +1,235 @@
+"""Blocking multiplex work executes outside the shared event-loop thread.
+
+Drive the current native call sites and inspect the thread executing each
+blocking collaborator. Inline disk/SQL/CPU work fails these behavioral checks,
+without depending on private helper names or source formatting.
+"""
+import asyncio
+import json
+import sys
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+
+def _event(**kwargs):
+    from gateway.config import Platform
+    from gateway.platforms.event import MessageEvent
+    from gateway.session import SessionSource
+    return MessageEvent(text="question", message_id="in-1", source=SessionSource(
+        platform=Platform.TELEGRAM, chat_id="chat", chat_type="dm", user_id="user",
+    ), **kwargs)
+
+
+def _wecom():
+    from gateway.config import PlatformConfig
+    from plugins.platforms.wecom.adapter import WeComAdapter
+    return WeComAdapter(PlatformConfig(enabled=True, extra={"bot_id": "b", "secret": "s"}))
+
+
+class TestB3WecomMediaOffload:
+    @pytest.mark.asyncio
+    async def test_load_outbound_media_does_not_block_loop(self, tmp_path, monkeypatch):
+        media = tmp_path / "pic.png"
+        media.write_bytes(b"seed")
+        loop_thread, reads = threading.get_ident(), []
+        real_read = Path.read_bytes
+
+        def read(path):
+            reads.append(threading.get_ident())
+            return real_read(path)
+
+        monkeypatch.setattr(Path, "read_bytes", read)
+        data, _ctype, name = await _wecom()._load_outbound_media(str(media))
+        assert data == b"seed"
+        assert name == "pic.png"
+        assert reads and all(thread != loop_thread for thread in reads)
+
+    @pytest.mark.asyncio
+    async def test_upload_media_md5_is_offloaded(self, monkeypatch):
+        from plugins.platforms.wecom import media
+        adapter = _wecom()
+        loop_thread, hashes, requests = threading.get_ident(), [], []
+        md5 = media.hashlib.md5
+        payload = b"media payload"
+        expected = md5(payload).hexdigest()
+
+        def hash_payload(data):
+            hashes.append(threading.get_ident())
+            return md5(data)
+
+        async def request(command, body, label):
+            requests.append(body)
+            if label == "media upload init":
+                return {"body": {"upload_id": "upload"}}
+            if label == "media upload finish":
+                return {"body": {"media_id": "media", "type": "image"}}
+            return {"body": {}}
+
+        monkeypatch.setattr(media.hashlib, "md5", hash_payload)
+        monkeypatch.setattr(adapter, "_checked_request", request)
+        result = await adapter._upload_media_bytes(payload, "image", "pic.png")
+        assert requests[0]["md5"] == expected
+        assert result["media_id"] == "media"
+        assert hashes and all(thread != loop_thread for thread in hashes)
+
+
+class TestB1LedgerOffload:
+    @pytest.mark.asyncio
+    @pytest.mark.parametrize("success", [True, False])
+    async def test_ledger_calls_offloaded(self, monkeypatch, success):
+        from gateway import delivery_ledger as ledger
+        from gateway.platforms.base import BasePlatformAdapter
+        event = _event()
+        adapter = SimpleNamespace(typed_command_prefix="!", _owner_profile="tenant", gateway_runner=None)
+        loop_thread, calls = threading.get_ident(), []
+
+        def capture(name):
+            def call(*args, **kwargs):
+                calls.append((name, threading.get_ident(), args, kwargs))
+                return True if name == "enabled" else None
+            return call
+
+        for name in ("record_obligation", "mark_attempting", "mark_delivered", "mark_failed"):
+            monkeypatch.setattr(ledger, name, capture(name))
+        monkeypatch.setattr(ledger, "ledger_enabled", capture("enabled"))
+        monkeypatch.setattr(ledger, "is_reconnect_only", lambda error: False)
+        obligation = await BasePlatformAdapter._record_delivery_obligation(
+            adapter, event, "session", "reply", adapter, False,
+        )
+        assert obligation
+        await BasePlatformAdapter._finalize_delivery_obligation(
+            adapter, obligation, SimpleNamespace(success=success, error="temporary error"), event, adapter,
+        )
+        assert [row[0] for row in calls] == [
+            "enabled", "record_obligation", "mark_attempting",
+            "mark_delivered" if success else "mark_failed",
+        ]
+        assert all(row[1] != loop_thread for row in calls)
+        assert calls[1][3]["content"] == "reply"
+        assert calls[1][3]["adapter_profile"] == "tenant"
+        assert calls[-1][2][0] == obligation
+
+
+class TestB2InboundExtractOffload:
+    @pytest.mark.asyncio
+    async def test_extract_text_offloaded(self, tmp_path, monkeypatch):
+        from gateway.run import GatewayRunner
+        document = tmp_path / "notes.txt"
+        document.write_bytes(b"document bytes")
+        event = _event(media_urls=[str(document)], media_types=["text/plain"])
+        runner = object.__new__(GatewayRunner)
+        runner._consume_pending_native_image_paths = lambda key: []
+        runner._prefix_inbound_sender_context = lambda event, source, text: text
+        runner._classify_inbound_media = lambda event, pending: ([], [], [], [])
+        loop_thread, extracts = threading.get_ident(), []
+
+        def extract(name, data):
+            extracts.append((threading.get_ident(), name, data))
+            return "extracted document"
+
+        monkeypatch.setitem(sys.modules, "hermes_cloud.app.llm.attachments", SimpleNamespace(extract_text=extract))
+        monkeypatch.setattr("gateway.run_inbound.rehome_inbound_media", lambda event: None)
+        text = await runner._prepare_inbound_message_text(
+            event=event, source=event.source, history=[], session_key="session",
+        )
+        assert "extracted document" in text
+        assert text.endswith("question")
+        assert len(extracts) == 1
+        assert extracts[0][1:] == ("notes.txt", b"document bytes")
+        assert extracts[0][0] != loop_thread
+
+
+class TestB4FeishuImageReadOffload:
+    @pytest.mark.asyncio
+    async def test_image_read_offloaded(self, tmp_path, monkeypatch):
+        from gateway.config import PlatformConfig
+        from plugins.platforms.feishu.adapter import FeishuAdapter
+        adapter = FeishuAdapter(PlatformConfig())
+        image = tmp_path / "pic.png"
+        image.write_bytes(b"image bytes")
+        loop_thread, reads, uploads = threading.get_ident(), [], []
+        real_read = Path.read_bytes
+
+        def read(path):
+            reads.append(threading.get_ident())
+            return real_read(path)
+
+        def upload(body):
+            uploads.append(body["image"].getvalue())
+            return {"image_key": "key"}
+
+        adapter._client = SimpleNamespace(im=SimpleNamespace(v1=SimpleNamespace(image=SimpleNamespace(create=upload))))
+        monkeypatch.setattr(Path, "read_bytes", read)
+        monkeypatch.setattr(adapter, "_build_image_upload_body", lambda **kwargs: kwargs)
+        monkeypatch.setattr(adapter, "_build_image_upload_request", lambda body: body)
+        monkeypatch.setattr(adapter, "_extract_response_field", lambda response, key: response[key])
+        send = AsyncMock(return_value=SimpleNamespace(success=True))
+        monkeypatch.setattr(adapter, "_send_uploaded_key", send)
+        monkeypatch.setattr(adapter, "_finalize_send_result", lambda response, error: response)
+        try:
+            result = await adapter.send_image_file("chat", str(image))
+            assert result.success
+            assert uploads == [b"image bytes"]
+            assert reads and all(thread != loop_thread for thread in reads)
+            assert send.call_args.kwargs["key_payload"] == {"image_key": "key"}
+        finally:
+            adapter._shutdown_sdk_executor()
+
+
+class TestB5TurnMetaOffload:
+    @pytest.mark.asyncio
+    async def test_set_turn_meta_offloaded(self, monkeypatch):
+        from gateway.config import PlatformConfig
+        from gateway.platforms.api_server import APIServerAdapter
+        adapter = APIServerAdapter(PlatformConfig())
+        response = SimpleNamespace(write=AsyncMock())
+        monkeypatch.setattr(adapter, "_prepare_sse_response", AsyncMock(return_value=response))
+        loop_thread, writes = threading.get_ident(), []
+
+        def set_meta(session, meta):
+            writes.append((threading.get_ident(), session, meta))
+
+        agent = SimpleNamespace(_session_db=SimpleNamespace(set_turn_meta=set_meta), _api_call_count=2, _tool_durations={"tool": 1})
+        completed = asyncio.get_running_loop().create_future()
+        completed.set_result(({"final_response": "reply"}, {}))
+        queue = asyncio.Queue()
+        await queue.put(None)
+        await adapter._write_sse_chat_completion(
+            None, "completion", "model", 0, queue, completed,
+            agent_ref=[agent], session_id="session",
+        )
+        assert len(writes) == 1
+        assert writes[0][0] != loop_thread
+        assert writes[0][1] == "session"
+        assert writes[0][2]["api_calls"] == 2
+        assert writes[0][2]["tool_count"] == 1
+        assert any(b"event: hermes.turn.done" in call.args[0] for call in response.write.call_args_list)
+
+
+class TestB6ReadinessOffload:
+    @pytest.mark.asyncio
+    async def test_collect_runtime_readiness_offloaded(self, monkeypatch):
+        from gateway.config import PlatformConfig
+        from gateway.platforms.api_server import APIServerAdapter
+        adapter = APIServerAdapter(PlatformConfig())
+        loop_thread, probes = threading.get_ident(), []
+
+        def probe(**kwargs):
+            probes.append((threading.get_ident(), kwargs))
+            return {"status": "ok"}
+
+        monkeypatch.setattr("gateway.platforms.api_server.collect_runtime_readiness", probe)
+        monkeypatch.setattr("gateway.status.read_runtime_status", lambda: {"gateway_state": "running"})
+        monkeypatch.setattr("gateway.run._resolve_gateway_model", lambda: "test/model")
+        monkeypatch.setattr(adapter, "_api_server_status_payload", lambda **kwargs: {"metrics_today": {}, "last_heartbeat": None})
+        monkeypatch.setattr(adapter, "_readiness_work_counts", lambda: (0, 0, 0))
+        # Bypass only the HTTP authentication wrapper; exercise the real handler.
+        response = await adapter._handle_health_detailed.__wrapped__(adapter, None)
+        assert json.loads(response.text)["status"] == "ok"
+        assert len(probes) == 1
+        assert probes[0][0] != loop_thread
+        assert probes[0][1]["configured_model"] == "test/model"
diff --git a/tests/gateway/test_multiplex_reload_swap.py b/tests/gateway/test_multiplex_reload_swap.py
new file mode 100644
index 0000000000..dfac720724
--- /dev/null
+++ b/tests/gateway/test_multiplex_reload_swap.py
@@ -0,0 +1,330 @@
+"""Regression tests for two multiplex gateway bugs found in review.
+
+R2-2 (HIGH) — ``_resolve_profile_home_for_source`` must NOT fall back to the
+default/active tenant's HERMES_HOME when it cannot resolve the inbound source's
+*specific* profile while multiplexing is active. Falling back returns a
+non-None override (the default tenant's home), which slips past the identity
+layer's fail-closed (that only trips when the override is None) and silently
+records tenant B's turn under the default tenant. Under multiplex the resolver
+must raise ``ProfileResolutionError`` so the turn fails closed. When multiplex
+is OFF the legacy ``get_hermes_home()`` fallback is preserved byte-for-byte.
+
+R3-2 (MEDIUM) — ``reload_profile_adapters`` must swap the freshly-connected
+adapters into ``_profile_adapters[profile]`` BEFORE disconnecting the old ones
+(swap-then-disconnect), so an in-flight final delivery in the reload window
+always resolves a live adapter instead of hitting an empty map and falling back
+to the closing (feishu ``_sdk_executor_closing``) adapter. The rebuilt
+``claimed`` de-dup map must EXCLUDE this profile's own old adapters (their
+tokens are about to be released) or the same-token new adapter would
+self-conflict and refuse to connect.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from agent.secret_scope import is_multiplex_active, set_multiplex_active
+from gateway.run import GatewayRunner, ProfileResolutionError
+
+
+# ─────────────────────────────────────────────────────────────────────────
+# Shared helpers
+# ─────────────────────────────────────────────────────────────────────────
+class _FakeAdapter:
+    def __init__(self, name: str):
+        self.name = name
+        self.closing = False
+
+
+def _make_runner():
+    runner = GatewayRunner.__new__(GatewayRunner)
+    runner.adapters = {}
+    runner._profile_adapters = {}
+    runner._profile_failed_platforms = {}
+    return runner
+
+
+def _src(profile="bob"):
+    return SimpleNamespace(
+        profile=profile,
+        platform=SimpleNamespace(value="feishu"),
+        chat_id="c1",
+        guild_id=None,
+    )
+
+
+@pytest.fixture
+def mux_flag():
+    """Restore the process-global multiplex flag after each test."""
+    prev = is_multiplex_active()
+    try:
+        yield set_multiplex_active
+    finally:
+        set_multiplex_active(prev)
+
+
+@pytest.fixture
+def patched_profiles(monkeypatch):
+    import hermes_cli.profiles as profiles
+
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+    monkeypatch.setattr(
+        profiles,
+        "profiles_to_serve",
+        lambda multiplex=False: [("alice", Path("/tmp/alice-home"))],
+    )
+    monkeypatch.setattr(
+        profiles, "get_profile_dir", lambda name: Path(f"/tmp/{name}-home")
+    )
+    return profiles
+
+
+# ─────────────────────────────────────────────────────────────────────────
+# R2-2 — resolver fail-closed under multiplex
+# ─────────────────────────────────────────────────────────────────────────
+def _patch_resolver_deps(monkeypatch, *, exists=True, get_dir=None):
+    import hermes_cli.profiles as profiles
+    import hermes_constants
+
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+    monkeypatch.setattr(
+        profiles, "get_profile_dir", get_dir or (lambda name: Path(f"/tmp/{name}"))
+    )
+    monkeypatch.setattr(profiles, "profile_exists", lambda name: exists)
+    monkeypatch.setattr(
+        hermes_constants, "get_hermes_home", lambda: Path("/tmp/DEFAULT")
+    )
+
+
+def test_resolve_raises_on_missing_explicit_profile_under_multiplex(
+    monkeypatch, mux_flag
+):
+    _patch_resolver_deps(monkeypatch, exists=False)
+    mux_flag(True)
+    runner = GatewayRunner.__new__(GatewayRunner)
+    with pytest.raises(ProfileResolutionError):
+        runner._resolve_profile_home_for_source(_src("bob"))
+
+
+def test_resolve_raises_on_exception_under_multiplex(monkeypatch, mux_flag):
+    def boom(name):
+        raise RuntimeError("normalization blew up")
+
+    _patch_resolver_deps(monkeypatch, get_dir=boom)
+    mux_flag(True)
+    runner = GatewayRunner.__new__(GatewayRunner)
+    with pytest.raises(ProfileResolutionError):
+        runner._resolve_profile_home_for_source(_src("bob"))
+
+
+def test_resolve_falls_back_to_default_when_not_multiplex(monkeypatch, mux_flag):
+    """Single-tenant behavior is preserved byte-for-byte: missing explicit
+    profile still returns get_hermes_home()."""
+    _patch_resolver_deps(monkeypatch, exists=False)
+    mux_flag(False)
+    runner = GatewayRunner.__new__(GatewayRunner)
+    result = runner._resolve_profile_home_for_source(_src("bob"))
+    assert result == Path("/tmp/DEFAULT")
+
+
+def test_resolve_returns_specific_profile_dir_when_it_exists(monkeypatch, mux_flag):
+    """A resolvable explicit profile still returns its own dir under multiplex —
+    fail-closed only fires when the profile can't be resolved."""
+    _patch_resolver_deps(monkeypatch, exists=True)
+    mux_flag(True)
+    runner = GatewayRunner.__new__(GatewayRunner)
+    result = runner._resolve_profile_home_for_source(_src("bob"))
+    assert result == Path("/tmp/bob")
+
+
+# ─────────────────────────────────────────────────────────────────────────
+# R3-2 — reload swap-then-disconnect
+# ─────────────────────────────────────────────────────────────────────────
+@pytest.mark.asyncio
+async def test_reload_swaps_new_before_disconnecting_old(monkeypatch, patched_profiles):
+    runner = _make_runner()
+    old = _FakeAdapter("old")
+    runner._profile_adapters["alice"] = {"feishu": old}
+
+    events: list = []
+
+    async def fake_disconnect(adapter, platform):
+        # At disconnect time the NEW adapter must already be published so an
+        # in-flight delivery never sees an empty/closing map.
+        current = runner._profile_adapters["alice"].get(platform)
+        events.append(("disconnect", adapter.name, current.name if current else None))
+        adapter.closing = True
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        # Old adapter stays live in the registry throughout the rebuild.
+        assert runner._profile_adapters["alice"].get("feishu") is old
+        assert not old.closing
+        new = _FakeAdapter("new")
+        events.append(("connect", new.name))
+        target_map["feishu"] = new
+        if stats is not None:
+            stats["attempted"] = 1
+        return 1
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    connected = await runner.reload_profile_adapters("alice")
+
+    assert connected == 1
+    kinds = [e[0] for e in events]
+    assert "connect" in kinds and "disconnect" in kinds
+    # new adapter connected BEFORE old adapter disconnected.
+    assert kinds.index("connect") < kinds.index("disconnect")
+    # At the disconnect point the map already served the NEW adapter.
+    disc = next(e for e in events if e[0] == "disconnect")
+    assert disc == ("disconnect", "old", "new")
+    # Final map holds only the fresh adapter; old was torn down.
+    assert runner._profile_adapters["alice"]["feishu"].name == "new"
+    assert old.closing is True
+
+
+@pytest.mark.asyncio
+async def test_reload_map_always_has_live_adapter_across_swap(
+    monkeypatch, patched_profiles
+):
+    """Assert the invariant directly: at no observed point does the profile's
+    map serve a closing/None adapter for the platform being reloaded."""
+    runner = _make_runner()
+    old = _FakeAdapter("old")
+    runner._profile_adapters["alice"] = {"feishu": old}
+    observations: list = []
+
+    def _snapshot():
+        # Record (present, closing) of the served adapter AT THIS INSTANT so a
+        # later disconnect of the old adapter can't retroactively fail the check.
+        cur = runner._profile_adapters["alice"].get("feishu")
+        observations.append((cur is not None, bool(cur and cur.closing)))
+
+    async def fake_disconnect(adapter, platform):
+        _snapshot()
+        adapter.closing = True
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        _snapshot()
+        target_map["feishu"] = _FakeAdapter("new")
+        if stats is not None:
+            stats["attempted"] = 1
+        return 1
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    await runner.reload_profile_adapters("alice")
+
+    # At every observed instant the map served a live, non-closing adapter.
+    assert observations, "expected at least one observation"
+    for present, closing in observations:
+        assert present is True
+        assert closing is False
+
+
+@pytest.mark.asyncio
+async def test_reload_claimed_excludes_own_old_adapter(monkeypatch, patched_profiles):
+    runner = _make_runner()
+    old = _FakeAdapter("old")
+    runner._profile_adapters["alice"] = {"feishu": old}
+    # Also give an unrelated profile the SAME token to prove only THIS profile's
+    # old adapter is excluded, not every same-token adapter.
+    other = _FakeAdapter("carol-feishu")
+    runner._profile_adapters["carol"] = {"telegram": other}
+
+    def fp(adapter):
+        return {id(old): "TOKEN", id(other): "OTHER"}.get(id(adapter))
+
+    monkeypatch.setattr(runner, "_adapter_credential_fingerprint", fp)
+
+    seen: dict = {}
+
+    async def fake_disconnect(adapter, platform):
+        pass
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        seen["claimed"] = dict(claimed)
+        target_map["feishu"] = _FakeAdapter("new")
+        if stats is not None:
+            stats["attempted"] = 1
+        return 1
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    await runner.reload_profile_adapters("alice")
+
+    # This profile's own old token is NOT pre-claimed (it's about to release it),
+    # so the same-token new adapter can connect.
+    assert ("feishu", "TOKEN") not in seen["claimed"]
+    # Another profile's token IS still claimed (must not double-poll it).
+    assert seen["claimed"].get(("telegram", "OTHER")) == "carol"
+
+
+@pytest.mark.asyncio
+async def test_reload_keeps_old_when_all_new_connects_fail(
+    monkeypatch, patched_profiles
+):
+    runner = _make_runner()
+    old = _FakeAdapter("old")
+    runner._profile_adapters["alice"] = {"feishu": old}
+    disconnected: list = []
+
+    async def fake_disconnect(adapter, platform):
+        disconnected.append(adapter)
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        # Attempted one platform but connected none (network failure).
+        if stats is not None:
+            stats["attempted"] = 1
+        return 0
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    connected = await runner.reload_profile_adapters("alice")
+
+    assert connected == 0
+    # Old adapter kept live (never disconnected) — profile is never adapter-less.
+    assert runner._profile_adapters["alice"]["feishu"] is old
+    assert old not in disconnected
+
+
+@pytest.mark.asyncio
+async def test_reload_unbind_drops_old_adapters(monkeypatch, patched_profiles):
+    """Fresh config enables no adapters (unbind): swap to empty, disconnect old."""
+    runner = _make_runner()
+    old = _FakeAdapter("old")
+    runner._profile_adapters["alice"] = {"feishu": old}
+    disconnected: list = []
+
+    async def fake_disconnect(adapter, platform):
+        disconnected.append(adapter)
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        # Nothing to connect — no platforms enabled.
+        if stats is not None:
+            stats["attempted"] = 0
+        return 0
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    await runner.reload_profile_adapters("alice")
+
+    assert runner._profile_adapters["alice"] == {}
+    assert old in disconnected
diff --git a/tests/gateway/test_stream_consumer_reasoning.py b/tests/gateway/test_stream_consumer_reasoning.py
