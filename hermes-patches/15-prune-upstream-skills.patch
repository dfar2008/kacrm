-    attractor presets:
-        "clifford":  sin(a*y) + c*cos(a*x), sin(b*x) + d*cos(b*y)
-        "de_jong":   sin(a*y) - cos(b*x), sin(c*x) - cos(d*y)
-        "bedhead":   sin(x*y/b) + cos(a*x - y), x*sin(a*y) + cos(b*x - y)
