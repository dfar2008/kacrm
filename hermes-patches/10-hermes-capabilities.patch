+def _unified_write_tool(
+    module_names: List[str],
+    field_hints: Dict[str, Dict[str, List[str]]],
+) -> ToolSpec:
+    """Single write tool for create/update across all CRM modules.
+
+    ``field_hints`` maps module name → {"required": [...], "optional": [...]}
+    so the LLM can write records directly without calling crm_get_schema first.
+    """
+    # Build compact field hint string per module
+    hints_parts: List[str] = []
+    for mod_name in module_names:
+        hint = field_hints.get(mod_name, {})
+        req = hint.get("required", [])
+        opt = hint.get("optional", [])
+        fields = [f"*{f}" for f in req] + opt
+        hints_parts.append(f"{mod_name}({', '.join(fields)})")
+
+    return ToolSpec(
+        name="crm_write",
+        description=(
+            "Create or update a CRM record. ALWAYS pass module as one of "
+            "the exact module names listed below — do NOT use 'record', "
+            "'Lead', 'lead' or other variants; for new customer/lead "
+            "records the correct module is 'leads'. For updates, include "
+            "only the fields you want to change. Fields marked with * are "
+            "required. " + "; ".join(hints_parts) + ". "
+            "For salesorders and quotes you MUST include at least one "
+            "product line under data.products — a list of "
+            "{products_id, quantity, price, discount_rate, tax_rate} objects. "
+            "Amounts (subtotal/total/final_amount) are computed server-side "
+            "from these lines, so do NOT pass final_amount yourself. "
+            "discount_rate and tax_rate are percentages (e.g. 13 means 13%). "
+            "A salesorder/quote with no product line is rejected. "
+            "CRITICAL — never fabricate product lines. If the user gives only "
+            "an amount (or no products at all), DO NOT pick a product, DO NOT "
+            "create the order: stop and ASK which products, quantities, and "
+            "unit prices. Never use a stated total as the unit price, and never "
+            "override a product's catalog price just to make the total match a "
+            "number the user mentioned. An order's amount must FOLLOW from real "
+            "products the user actually named — you may not invent it the other "
+            "way around. "
+            "For GENERIC sub-details (line-item child tables such as 费用明细), "
+            "pass data.details = {\"<subdetail_name>\": [ {column: value}, ... ]}; "
+            "the list REPLACES that record's existing rows for that sub-detail. "
+            "Product lines (data.products) may ALSO carry any column the product "
+            "sub-detail defines beyond the core ones above (e.g. a custom 类型). "
+            "Call crm_get_schema to discover a module's sub-details and columns. "
+            "If the response carries pending_approval=true, the write has "
+            "been queued for human review on its originating channel — "
+            "this is NOT a failure: do not retry the call or rewrite the "
+            "same data with different fields."
+        ),
+        verb="create",  # permission checked dynamically in dispatch
+        module_name="__unified__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "module": {
+                    "type": "string",
+                    "enum": module_names,
+                    "description": "CRM module to write to",
+                },
+                "action": {
+                    "type": "string",
+                    "enum": ["create", "update"],
+                    "description": "Whether to create a new record or update an existing one",
+                },
+                "id": {
+                    "type": "integer",
+                    "minimum": 1,
+                    "description": "Record id (required for update, omit for create)",
+                },
+                "data": {
+                    "type": "object",
+                    "description": "Field values for the record",
+                },
+            },
+            "required": ["module", "action", "data"],
+            "additionalProperties": False,
+        },
+    )
+
+
+def _note_create_tool() -> ToolSpec:
+    """Tool spec for ``crm_note_create`` — agents append a free-form
+    note to a CRM record's timeline.
+
+    Different from :func:`_task_create_tool`: notes record what already
+    happened (no due_date, no owner, no Trust Engine gating), tasks
+    schedule what's coming. Both write to the interactions table but
+    with distinct ``kind`` values.
+
+    Replaces cloud's ``copilot/tools.py:_exec_add_note`` so SPA Copilot
+    retirement (Phase 4 §4.2) doesn't lose the note-writing surface.
+    """
+    return ToolSpec(
+        name="crm_note_create",
+        description=(
+            "Append a free-form note to a CRM record's timeline. Use for "
+            "recording observations, decisions, or context that doesn't "
+            "fit a task — e.g. \"customer mentioned Q3 timeline concerns\", "
+            "\"internal: legal review found 3 issues\". Notes are read-only "
+            "history; they don't have due dates or owners. For future-action "
+            "items use crm_task_create instead."
+        ),
+        verb="create",
+        module_name="__interaction__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "module": {
+                    "type": "string",
+                    "description": "Target CRM module (e.g. 'accounts', 'potentials').",
+                    "enum": ["leads", "accounts", "contacts", "potentials",
+                             "quotes", "salesorders", "tasks", "products",
+                             "receivables", "payments"],
+                },
+                "record_id": {
+                    "type": "integer",
+                    "description": "Target record id within that module.",
+                    "minimum": 1,
+                },
+                "text": {
+                    "type": "string",
+                    "description": "Note body. Markdown OK. Max 2000 chars.",
+                    "minLength": 1,
+                    "maxLength": 2000,
+                },
+            },
+            "required": ["module", "record_id", "text"],
+            "additionalProperties": False,
+        },
+    )
+
+
+# Relation map for crm_list_related — port of cloud-side
+# copilot/tools.py:_RELATION_MAP. Each entry:
+#   (from_module, to_module) → (target_table, pk_col, name_col,
+#                               fk_col_in_target, status_col_or_None)
+# The ``_self_`` prefix on fk_col signals reverse direction:
+# the FK lives on the FROM record, not the target.
+# The ``_poly_<from>`` form signals a polymorphic FK on the target
+# table — matches WHERE related_module='<from>' AND
+# related_record_id=<id>. Used for tasks (one column pair links to
+# any of leads/accounts/contacts/potentials).
+_RELATED_RECORDS_MAP: Dict[tuple, tuple] = {
+    ("accounts", "potentials"):
+        ("potentials", "potentials_id", "potentials_name", "accounts_id", "milestone"),
+    ("accounts", "contacts"):
+        ("contacts",   "contacts_id",   "contacts_name",   "accounts_id", None),
+    ("contacts", "potentials"):
+        ("potentials", "potentials_id", "potentials_name", "contacts_id", "milestone"),
+    # Reverse edges — fixed in cloud during chatbox-warning fix; ported here.
+    ("potentials", "accounts"):
+        ("accounts",  "accounts_id",  "accounts_name",  "_self_accounts_id", None),
+    ("potentials", "contacts"):
+        ("contacts",  "contacts_id",  "contacts_name",  "_self_contacts_id", None),
+    # Polymorphic edges → tasks. Backed by tasks.related_module +
+    # tasks.related_record_id (added in alembic 0094). Coach uses
+    # potentials→tasks to find overdue follow-ups for active deals.
+    ("potentials", "tasks"):
+        ("tasks", "tasks_id", "tasks_name", "_poly_potentials", "status"),
+    ("accounts", "tasks"):
+        ("tasks", "tasks_id", "tasks_name", "_poly_accounts",   "status"),
+    ("contacts", "tasks"):
+        ("tasks", "tasks_id", "tasks_name", "_poly_contacts",   "status"),
+    ("leads", "tasks"):
+        ("tasks", "tasks_id", "tasks_name", "_poly_leads",      "status"),
+}
+
+_RELATED_EXTRA_COLS: Dict[str, List[str]] = {
+    "potentials": ["amount", "milestone", "next_step", "closing_date"],
+    "contacts":   ["mobile", "email", "department", "position"],
+    "accounts":   ["industry", "website", "phone"],
+    # ``due_at`` is the agent-task timestamp (added 0094); ``enddate``
+    # is the legacy CRM date column. Coach needs both to flag overdue.
+    "tasks":      ["status", "priority", "due_at", "enddate", "source_agent"],
+}
