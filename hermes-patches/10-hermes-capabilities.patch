+                api_start_time=999.5, effective_task_id='task', turn_id='turn',
+                _preflight_compression_blocked=True, _last_preflight_pressure='pending',
+            )
+        accounting.assert_called_once()
+        assert accounting.call_args.kwargs['api_duration'] == 0.5
+        completed.assert_called_once_with('dangling-call', outcome='success')
+        assert events == ['usage', 'complete']
+        assert agent.session_api_calls == 1
+        assert agent.session_total_tokens == (107 if with_usage else 0)
+        assert agent.session_prompt_tokens == (100 if with_usage else 0)
+        assert agent.session_completion_tokens == (7 if with_usage else 0)
+        assert agent._session_db.queue_token_counts.call_count == int(with_usage)
+        if with_usage:
+            queued = agent._session_db.queue_token_counts.call_args.kwargs
+            assert queued['input_tokens'] == 100 and queued['output_tokens'] == 7
+            assert queued['api_call_count'] == 1
+            assert verdict.compression_attempts == 0
+            assert not verdict._preflight_compression_blocked
+            assert verdict._last_preflight_pressure is None
+        else:
+            compressor.update_from_response.assert_called_once_with({})
+            compressor.note_usage_less_response.assert_called_once()
+        assert verdict.action == 'break' and retry.restart_with_length_continuation
+        assert not retry.has_retried_429
+        assert agent._last_api_duration_ms == 500
+        assert [m['role'] for m in messages] == ['user', 'assistant', 'user']
+        assert messages[-2]['_length_continuation_fragment']
+        assert messages[-1]['_length_continuation_nudge']
+        assert parts == [('Results:', False)]
+    finally:
+        agent.close()
