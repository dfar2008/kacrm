@@ -0,0 +1,124 @@
+"""MiniMax CLI web-search provider (no API scraping).
+
+Calls ``mmx search query --q <query> --output json`` and normalizes the
+``organic`` array. MiniMax runs the search server-side, so there is no
+anti-bot / datacenter-IP-flagging fragility (the failure mode that made
+Baidu scraping unreliable), and it works from mainland China.
+
+Auth: ``MINIMAX_CODING_API_KEY`` (the coding-plan key already configured for
+the agent's LLM). Region ``cn`` matches the api.minimaxi.com platform.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import shutil
+import subprocess
+from typing import Any, Dict, List
+
+from agent.web_search_provider import WebSearchProvider
+
+logger = logging.getLogger(__name__)
+
+
+def _mmx_bin() -> str | None:
+    return shutil.which("mmx") or ("/usr/bin/mmx" if os.path.exists("/usr/bin/mmx") else None)
+
+
+def _api_key() -> str:
+    return (
+        os.environ.get("MINIMAX_CODING_API_KEY")
+        or os.environ.get("MINIMAX_API_KEY")
+        or ""
+    ).strip()
+
+
+class MiniMaxCLIWebSearchProvider(WebSearchProvider):
+    """Web search via the MiniMax CLI. No key needed beyond the coding key."""
+
+    @property
+    def name(self) -> str:
+        return "minimax"
+
+    @property
+    def display_name(self) -> str:
+        return "MiniMax (mmx CLI)"
+
+    def is_available(self) -> bool:
+        # No network I/O — just probe the binary + key (runs at registration
+        # time and every web_search dispatch).
+        return bool(_mmx_bin()) and bool(_api_key())
+
+    def supports_search(self) -> bool:
+        return True
+
+    def supports_extract(self) -> bool:
+        return False
+
+    def search(self, query: str, limit: int = 5) -> Dict[str, Any]:
+        mmx = _mmx_bin()
+        key = _api_key()
+        if not mmx:
+            return {"success": False, "error": "mmx CLI not installed (npm i -g mmx-cli)"}
+        if not key:
+            return {"success": False, "error": "MINIMAX_CODING_API_KEY not set"}
+
+        cmd = [
+            mmx, "search", "query", "--q", query,
+            "--api-key", key, "--region", "cn",
+            "--output", "json", "--non-interactive", "--quiet",
+            "--no-color", "--timeout", "60",
+        ]
+        try:
+            proc = subprocess.run(
+                cmd, capture_output=True, text=True, timeout=75,
+            )
+        except subprocess.TimeoutExpired:
+            return {"success": False, "error": "mmx search timed out"}
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("mmx search spawn error: %s", exc)
+            return {"success": False, "error": f"mmx search failed to run: {exc}"}
+
+        if proc.returncode != 0:
+            detail = (proc.stderr or proc.stdout or "").strip()[:200]
+            return {"success": False, "error": f"mmx search exit {proc.returncode}: {detail}"}
+
+        out = (proc.stdout or "").strip()
+        data: Dict[str, Any] = {}
+        try:
+            data = json.loads(out)
+        except Exception:  # noqa: BLE001 — tolerate any banner before the JSON
+            i = out.find("{")
+            if i >= 0:
+                try:
+                    data = json.loads(out[i:])
+                except Exception:  # noqa: BLE001
+                    data = {}
+        organic = data.get("organic") or data.get("results") or []
+        safe_limit = max(1, int(limit))
+        results: List[Dict[str, Any]] = []
+        for hit in organic[:safe_limit]:
+            url = str(hit.get("link") or hit.get("url") or "")
+            title = str(hit.get("title") or "")
+            if not title and not url:
+                continue
+            results.append({
+                "title": title,
+                "url": url,
+                "description": str(hit.get("snippet") or hit.get("description") or ""),
+                "position": len(results) + 1,
+            })
+        if not results:
+            return {"success": False, "error": "mmx search returned no results"}
+        logger.info("mmx search '%s': %d results (limit %d)", query, len(results), limit)
+        return {"success": True, "data": {"web": results}}
+
+    def get_setup_schema(self) -> Dict[str, Any]:
+        return {
+            "name": "MiniMax (mmx CLI)",
+            "badge": "MiniMax-hosted · coding-plan · CN-reachable",
+            "tag": "Web search via the MiniMax CLI — no scraping, uses the coding-plan key",
+            "env_vars": [],
+        }
