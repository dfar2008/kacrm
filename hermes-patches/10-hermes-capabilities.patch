+
+@dataclass
+class ToolSpec:
+    """One MCP-shaped tool.
+
+    ``name`` is the stable id (``crm_search_accounts``). ``verb`` is the
+    RBAC action the dispatcher checks before running (``index`` / ``view``
+    / ``create`` / ``update``). ``module_name`` is the collection the
+    tool acts on — also how the dispatcher re-resolves the module when
+    invoked. ``input_schema`` / ``output_schema`` are JSON Schema
+    ``object`` types ready to hand to an MCP ``tools/list`` response.
+    """
+
+    name: str
+    description: str
+    verb: str
+    module_name: str
+    input_schema: Dict[str, Any]
+    output_schema: Dict[str, Any] = field(default_factory=dict)
+
+
+def _unified_search_tool(module_names: List[str]) -> ToolSpec:
+    """Single search tool for all CRM modules."""
+    return ToolSpec(
+        name="crm_search",
+        description=(
+            "Search CRM records within one module. "
+            f"Available modules: {', '.join(module_names)}. "
+            "Results are ALWAYS limited to records the current user is allowed "
+            "to see — you never need to add an owner filter for permission "
+            "reasons. To answer questions about the CURRENT user's own work "
+            "(\"my tasks\", \"what do I need to handle today\", \"records I own\"), "
+            "pass owner=\"me\" — the server resolves it to the logged-in user; "
+            "NEVER type or guess the user's name. The `search` parameter is a "
+            "NAME-only fuzzy match, NOT a query language: do NOT pass "
+            "field:value expressions such as \"owner_by:张三 status:open\" — they "
+            "match nothing. Filter on field values with `filters` instead. "
+            "When looking up a company or person by name (e.g. to attach an order "
+            "or find an existing record), a single module is not enough: a "
+            "'customer' may still live in 'leads' (not yet converted). If 'accounts' "
+            "returns no match, you MUST also search 'leads' (and 'contacts' for "
+            "people) BEFORE telling the user the record doesn't exist. Never report "
+            "'not found' after searching only one module."
+        ),
+        verb="index",
+        module_name="__unified__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "module": {
+                    "type": "string",
+                    "enum": module_names,
+                    "description": "CRM module to search",
+                },
+                "search": {
+                    "type": "string",
+                    "description": (
+                        "Fuzzy match on the record NAME only (company/person/"
+                        "record title). NOT a query language — no field:value "
+                        "syntax. Use `filters`/`owner` for field conditions."
+                    ),
+                },
+                "owner": {
+                    "type": "string",
+                    "enum": ["me"],
+                    "description": (
+                        "Pass \"me\" to return ONLY records owned or created by "
+                        "the current logged-in user. Server-resolved — never "
+                        "pass a name. Use for \"my …\" / \"what do I have to do\"."
+                    ),
+                },
+                "filters": {
+                    "type": "array",
+                    "description": (
+                        "Structured field conditions, ANDed by default. Each: "
+                        "{\"field\": <real column of the module>, \"operator\": "
+                        "eq|neq|in|gt|gte|lt|lte|like|contains|is_empty|"
+                        "is_not_empty, \"value\": <v>}. Discover real field names "
+                        "via crm_schema; unknown fields are rejected with the "
+                        "valid list."
+                    ),
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "field": {"type": "string"},
+                            "operator": {"type": "string"},
+                            "value": {},
+                        },
+                        "required": ["field", "operator"],
+                    },
+                },
+                "filter_logic": {
+                    "type": "string",
+                    "enum": ["all", "any"],
+                    "default": "all",
+                    "description": "Combine `filters` with AND (all) or OR (any).",
+                },
+                "page": {"type": "integer", "minimum": 1, "default": 1},
+                "limit": {
+                    "type": "integer",
+                    "minimum": 1,
+                    "maximum": 100,
+                    "default": 20,
+                },
+            },
+            "required": ["module"],
+            "additionalProperties": False,
+        },
+    )
+
+
+def _assert_search_filter_fields(
+    db: DbWrapper, table_name: str, filters: List[Any]
+) -> None:
+    """Reject crm_search ``filters`` that reference a non-existent column.
+
+    ``ListQuery._build_filters`` silently DROPS unknown filter fields (they are
+    guarded only by ``_is_safe_sql_identifier``), so a fabricated field name
+    would quietly widen the result set instead of erroring — the same
+    silent-miss class as the free-text ``owner_by:name`` misuse this tool now
+    guards against. We validate against ``information_schema`` (the drift-proof
+    source of truth: the module ``fields_list`` omits system columns and can
+    drift) and raise with the real column list so the agent self-corrects
+    rather than trusting an over-broad result.
+    """
+    cols: List[str] = []
+    for f in filters:
+        if not isinstance(f, dict):
+            continue
+        raw = str(f.get("field") or "").strip()
+        if not raw:
+            continue
+        # Relation filters arrive as ``field#moduleId`` — validate the column.
+        col = raw.split("#", 1)[0].strip()
+        if col:
+            cols.append(col)
+    if not cols:
+        return
+    rows = db.fetchall(
+        "SELECT column_name FROM information_schema.columns "
+        "WHERE table_name = %s",
+        (table_name,),
+    )
+    valid = {str(r["column_name"]) for r in (rows or [])}
+    unknown = sorted({c for c in cols if c not in valid})
+    if unknown:
+        raise ValueError(
+            f"crm_search: unknown filter field(s) {unknown} for "
+            f"'{table_name}'. Valid fields: {', '.join(sorted(valid))}. "
+            "Do NOT invent field names — filter only on real columns."
+        )
+
+
+def _unified_get_tool(module_names: List[str]) -> ToolSpec:
+    """Single get tool for all CRM modules."""
+    return ToolSpec(
+        name="crm_get",
+        description=(
+            "Fetch a single CRM record by module name and id. "
+            f"Available modules: {', '.join(module_names)}. "
+            "Id must be a positive integer (from a recent crm_search result) "
+            "— never a UUID, never a string. If the response is an error "
+            "'crm_get: record not found' or 'record was deleted', the id is "
+            "permanently unavailable: DO NOT retry crm_get with the same "
+            "module+id. Either pick a different id, or stop and report to "
+            "the user that the record is missing."
+        ),
+        verb="view",
+        module_name="__unified__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "module": {
+                    "type": "string",
+                    "enum": module_names,
+                    "description": "CRM module to fetch from",
+                },
+                "id": {"type": "integer", "minimum": 1},
+            },
+            "required": ["module", "id"],
+            "additionalProperties": False,
+        },
+    )
+
