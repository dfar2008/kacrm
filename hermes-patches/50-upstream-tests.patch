+    history += [{"role": "assistant", "content": f"a{i}"} for i in range(25)]
+    _build(agent, conversation_history=history)
+    # 25 assistant messages % interval(10) == 5 → counter now accumulates
+    # across turns instead of resetting to 0 every stateless turn.
+    assert agent._iters_since_skill == 5
