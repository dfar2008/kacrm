+def _dispatch_create_dashboard_chart(
+    arguments: Dict[str, Any], *, user_id: int,
+    profile_id: Optional[str] = None, agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    import uuid as _uuid
+    tab_title = str(arguments.get("tab_title") or "").strip()
+    chart_title = str(arguments.get("chart_title") or "").strip()
+    dsl = arguments.get("dsl") or {}
+    if not (tab_title and chart_title and isinstance(dsl, dict) and dsl):
+        return {"success": False, "error": "tab_title/chart_title/dsl 必填"}
+    uid = int(user_id or 0)
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        try:
+            from hermes_cloud.app.dashboards.routes import _registry, _user_context
+            from hermes_cloud.app.dashboards.ops import apply_ops
+            from hermes_cloud.app.dashboards.store import create_tab
+        except Exception as e:  # noqa: BLE001
+            return {"success": False, "error": f"看板模块不可用: {e}"}
+        reg = _registry(d)
+        grants = set(_user_context(d, uid).get("grants") or set())
+        # 找/建用户的同名 tab
+        existing = d.fetchone(
+            "SELECT id FROM dashboard_tabs WHERE owner_user_id=%s AND title=%s "
+            "AND COALESCE(is_deleted,FALSE)=FALSE ORDER BY position LIMIT 1",
+            (uid, tab_title)) if _tab_has_deleted_col(d) else d.fetchone(
+            "SELECT id FROM dashboard_tabs WHERE owner_user_id=%s AND title=%s ORDER BY position LIMIT 1",
+            (uid, tab_title))
+        if existing:
+            tab_id = existing["id"]
+        else:
+            tab = create_tab(d, owner_user_id=uid, title=tab_title)
+            tab_id = tab.id if hasattr(tab, "id") else tab["id"]
+        op = {"action": "add", "chart": {
+            "id": str(_uuid.uuid4()), "title": chart_title, "dsl": dsl}}
+        results = apply_ops(d, tab_id=tab_id, user_id=uid, ops=[op],
+                            registry=reg, caller_grants=grants)
+        d.commit()
+        errs = [r for r in (results or []) if r.get("type") == "op_error" or r.get("error")]
+        if errs:
+            return {"success": False, "error": "图表校验失败", "detail": errs}
+        return {"success": True, "tab": tab_title, "tab_id": str(tab_id),
+                "message": f"已在看板「{tab_title}」加图表「{chart_title}」。"}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as d:
+        return _run(d)
+
