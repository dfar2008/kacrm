index 0000000000..a143808bf2
--- /dev/null
+++ b/tests/gateway/test_multiplex_identity_resolution.py
@@ -0,0 +1,216 @@
+"""Multiplex identity resolution: module-level HERMES_HOME-derived paths must
+resolve per profile at CALL time, not freeze onto the import-time profile.
+
+kacrm runs a single-process multiplexer that serves many profiles. Modules
+that evaluated ``X = get_hermes_home() / ...`` at import time froze onto
+whichever profile happened to be active on first import, so every subsequent
+tenant read/wrote the first profile's skills, credentials, channel directory,
+sticker cache, snapshot store, etc. Each such site was converted to a per-call
+helper (mirroring ``tools/skills_tool.py::_skills_dir``): honor an explicitly
+patched module-level constant (tests / external patchers), otherwise resolve
+from the live profile-scoped ``get_hermes_home()`` on every call.
+
+Every test below drives the per-call helper under two distinct HERMES_HOME
+override scopes and asserts each resolves to its OWN profile home. A frozen
+module-level constant would return the first profile's path inside the second
+scope — exactly the cross-tenant leak these fixes close.
+"""
+
+import contextlib
+import json
+from pathlib import Path
+
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+
+@contextlib.contextmanager
+def _scope(home: Path):
+    """Enter a profile scope by overriding the context-local HERMES_HOME.
+
+    Mirrors the single seam ``gateway.run._profile_runtime_scope`` installs for
+    home resolution (``set_hermes_home_override``), without pulling in the
+    secret-scope machinery the full multiplex path also uses.
+    """
+    token = set_hermes_home_override(str(home))
+    try:
+        yield
+    finally:
+        reset_hermes_home_override(token)
+
+
+def _two_homes(tmp_path):
+    a = tmp_path / "profile_a"
+    b = tmp_path / "profile_b"
+    a.mkdir()
+    b.mkdir()
+    return a, b
+
+
+# ---------------------------------------------------------------------------
+# 1. tools/skills_sync.py  (the most important — cross-tenant skill pollution)
+# ---------------------------------------------------------------------------
+
+def test_skills_sync_resolves_per_scope(tmp_path):
+    import tools.skills_sync as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._hermes_home() == a
+        assert m._skills_dir() == a / "skills"
+        assert m._manifest_file() == a / "skills" / ".bundled_manifest"
+    with _scope(b):
+        # A frozen impl would still return `a` here.
+        assert m._hermes_home() == b
+        assert m._skills_dir() == b / "skills"
+        assert m._manifest_file() == b / "skills" / ".bundled_manifest"
+
+
+def test_skills_sync_honors_patched_constant(tmp_path):
+    """Explicitly patched module constants still win (tests / external patchers)."""
+    import tools.skills_sync as m
+
+    patched = tmp_path / "patched_skills"
+    original = m.SKILLS_DIR
+    m.SKILLS_DIR = patched
+    try:
+        # Even inside a live override scope, the patched constant is authoritative.
+        with _scope(tmp_path / "other"):
+            assert m._skills_dir() == patched
+    finally:
+        m.SKILLS_DIR = original
+
+
+# ---------------------------------------------------------------------------
+# 2. agent/auxiliary_client.py  (per-profile auth.json credentials)
+# ---------------------------------------------------------------------------
+
+def test_auth_json_path_resolves_per_scope(tmp_path):
+    import agent.auxiliary_client as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._auth_json_path() == a / "auth.json"
+    with _scope(b):
+        assert m._auth_json_path() == b / "auth.json"
+
+
+# ---------------------------------------------------------------------------
+# 3. gateway/channel_directory.py
+# ---------------------------------------------------------------------------
+
+def test_channel_directory_paths_resolve_per_scope(tmp_path):
+    import gateway.channel_directory as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._directory_path() == a / "channel_directory.json"
+        assert m._aliases_path() == a / "channel_aliases.json"
+    with _scope(b):
+        assert m._directory_path() == b / "channel_directory.json"
+        assert m._aliases_path() == b / "channel_aliases.json"
+
+
+# ---------------------------------------------------------------------------
+# 4. gateway/hooks.py
+# ---------------------------------------------------------------------------
+
+def test_hooks_dir_resolves_per_scope(tmp_path):
+    import gateway.hooks as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._resolve_hooks_dir() == a / "hooks"
+    with _scope(b):
+        assert m._resolve_hooks_dir() == b / "hooks"
+
+
+# ---------------------------------------------------------------------------
+# 5. gateway/mirror.py
+# ---------------------------------------------------------------------------
+
+def test_mirror_paths_resolve_per_scope(tmp_path):
+    import gateway.mirror as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._resolve_sessions_index() == a / "sessions" / "sessions.json"
+    with _scope(b):
+        assert m._resolve_sessions_index() == b / "sessions" / "sessions.json"
+
+
+# ---------------------------------------------------------------------------
+# 6. gateway/sticker_cache.py
+# ---------------------------------------------------------------------------
+
+def test_sticker_cache_path_resolves_per_scope(tmp_path):
+    import gateway.sticker_cache as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._resolve_cache_path() == a / "sticker_cache.json"
+    with _scope(b):
+        assert m._resolve_cache_path() == b / "sticker_cache.json"
+
+
+# ---------------------------------------------------------------------------
+# 7. plugins/platforms/feishu/feishu_comment_rules.py
+#    (paths AND the mtime-cache key must follow the current profile)
+# ---------------------------------------------------------------------------
+
+def test_feishu_comment_rules_paths_resolve_per_scope(tmp_path):
+    import plugins.platforms.feishu.feishu_comment_rules as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._rules_file() == a / "feishu_comment_rules.json"
+        assert m._pairing_file() == a / "feishu_comment_pairing.json"
+    with _scope(b):
+        assert m._rules_file() == b / "feishu_comment_rules.json"
+        assert m._pairing_file() == b / "feishu_comment_pairing.json"
+
+
+def test_feishu_comment_rules_cache_keyed_per_scope(tmp_path):
+    """The mtime cache must be per-profile-path, not a single frozen-path cache."""
+    import plugins.platforms.feishu.feishu_comment_rules as m
+
+    a, b = _two_homes(tmp_path)
+    # Native _MtimeCache shares an object, but keys its entries by the live
+    # resolved path. Equal mtimes must still yield separate tenant data.
+    import os
+    for home, peer in ((a, "ou_a"), (b, "ou_b")):
+        path = home / "feishu_comment_pairing.json"
+        path.write_text(json.dumps({"approved": {peer: {"name": peer}}}))
+        os.utime(path, (1700000000, 1700000000))
+    with _scope(a):
+        assert m.pairing_list() == {"ou_a": {"name": "ou_a"}}
+    with _scope(b):
+        assert m.pairing_list() == {"ou_b": {"name": "ou_b"}}
+        m.pairing_add("ou_new")
+    with _scope(a):
+        assert m.pairing_list() == {"ou_a": {"name": "ou_a"}}
+    with _scope(b):
+        assert set(m.pairing_list()) == {"ou_b", "ou_new"}
+
+
+# ---------------------------------------------------------------------------
+# 8. tools/environments/singularity.py  and  tools/environments/modal.py
+# ---------------------------------------------------------------------------
+
+def test_singularity_snapshot_store_resolves_per_scope(tmp_path):
+    import tools.environments.singularity as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._snapshot_store() == a / "singularity_snapshots.json"
+    with _scope(b):
+        assert m._snapshot_store() == b / "singularity_snapshots.json"
+
+
+def test_modal_snapshot_store_resolves_per_scope(tmp_path):
+    import tools.environments.modal as m
+
+    a, b = _two_homes(tmp_path)
+    with _scope(a):
+        assert m._snapshot_store() == a / "modal_snapshots.json"
+    with _scope(b):
+        assert m._snapshot_store() == b / "modal_snapshots.json"
