-    case STATES.IDLE:
-      // waiting...
-      break;
-    case STATES.ENTER:
-      let t = constrain(stateTime() / 1000, 0, 1);
-      let alpha = easeOutCubic(t) * 255;
-      // fade in...
-      if (t >= 1) setState(STATES.ACTIVE);
-      break;
-    case STATES.ACTIVE:
-      // main animation...
-      break;
-    case STATES.EXIT:
-      let t2 = constrain(stateTime() / 500, 0, 1);
