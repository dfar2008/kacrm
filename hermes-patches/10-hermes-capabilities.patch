new file mode 100644
index 0000000000..e4eb0f334c
--- /dev/null
+++ b/memory/entities.py
@@ -0,0 +1,408 @@
+"""Entity graph CRUD — charter 原语 ②.
+
+Backing tables (migration 0015):
+- ``memory_entities``        canonical entity rows
+- ``memory_edges``           typed relations
+- ``memory_entity_sources``  M:N link to the ``memories`` rows that
+                             support each entity
+
+Canonicalization: entities are deduped on (entity_type, lower(canonical),
+user_id) by the unique index in 0015. :func:`upsert_entity` relies on
+that to merge aliases into an existing row rather than duplicate.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Dict, List, Optional, Tuple
+
+from hermes.crm.db import DbWrapper, db_session
+
+logger = logging.getLogger(__name__)
+
+
+def find_entity(
+    *,
+    entity_type: str,
+    canonical: str,
+    user_id: Optional[int] = None,
+    db: Optional[DbWrapper] = None,
+) -> Optional[Dict[str, Any]]:
+    def _run(db: DbWrapper) -> Optional[Dict[str, Any]]:
+        return db.fetchone(
+            "SELECT * FROM memory_entities "
+            "WHERE entity_type = %s AND lower(canonical) = lower(%s) "
+            "AND COALESCE(user_id, 0) = COALESCE(%s, 0)",
+            (entity_type, canonical, user_id),
+        )
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def upsert_entity(
+    *,
+    entity_type: str,
+    canonical: str,
+    aliases: Optional[List[str]] = None,
+    attributes: Optional[Dict[str, Any]] = None,
+    user_id: Optional[int] = None,
+    confidence: float = 1.0,
+    db: Optional[DbWrapper] = None,
+) -> int:
+    """Insert or merge an entity. Returns the row id.
+
+    If a matching row exists (type + canonical + user_id), new aliases
+    are merged (union, dedup), attributes are shallow-merged (new wins),
+    and ``last_seen_at`` is bumped. ``confidence`` is the max of the
+    two.
+    """
+    aliases = aliases or []
+    attrs = attributes or {}
+
+    def _run(db: DbWrapper) -> int:
+        existing = db.fetchone(
+            "SELECT id, aliases, attributes, confidence "
+            "FROM memory_entities "
+            "WHERE entity_type = %s AND lower(canonical) = lower(%s) "
+            "AND COALESCE(user_id, 0) = COALESCE(%s, 0)",
+            (entity_type, canonical, user_id),
+        )
+        if existing:
+            merged_aliases = set(existing.get("aliases") or [])
+            merged_aliases.update(aliases)
+            merged_attrs = dict(existing.get("attributes") or {})
+            merged_attrs.update(attrs)
+            new_conf = max(
+                float(existing.get("confidence") or 1.0), float(confidence)
+            )
+            db.execute(
+                """
+                UPDATE memory_entities
+                SET aliases = %s::jsonb,
+                    attributes = %s::jsonb,
+                    confidence = %s,
+                    last_seen_at = now(),
+                    updated_at = now()
+                WHERE id = %s
+                """,
+                (
+                    json.dumps(sorted(merged_aliases)),
+                    json.dumps(merged_attrs),
+                    new_conf,
+                    int(existing["id"]),
+                ),
+            )
+            return int(existing["id"])
+
+        row = db.fetchone(
+            """
+            INSERT INTO memory_entities
+                (entity_type, canonical, aliases, attributes,
+                 user_id, confidence)
+            VALUES (%s, %s, %s::jsonb, %s::jsonb, %s, %s)
+            RETURNING id
+            """,
+            (
+                entity_type, canonical,
+                json.dumps(aliases), json.dumps(attrs),
+                user_id, float(confidence),
+            ),
+        )
+        return int(row["id"])
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def add_edge(
+    *,
+    src_entity_id: int,
+    dst_entity_id: int,
+    relation: str,
+    attributes: Optional[Dict[str, Any]] = None,
+    confidence: float = 1.0,
+    db: Optional[DbWrapper] = None,
+) -> int:
+    """Idempotent edge insert: (src, dst, relation) unique. Re-asserting
+    bumps last_seen_at + takes max(confidence)."""
+    attrs = attributes or {}
+
+    def _run(db: DbWrapper) -> int:
+        row = db.fetchone(
+            """
+            INSERT INTO memory_edges
+                (src_entity_id, dst_entity_id, relation,
+                 attributes, confidence)
+            VALUES (%s, %s, %s, %s::jsonb, %s)
+            ON CONFLICT (src_entity_id, dst_entity_id, relation)
+            DO UPDATE SET
+                last_seen_at = now(),
+                confidence = GREATEST(memory_edges.confidence, EXCLUDED.confidence),
+                attributes = memory_edges.attributes || EXCLUDED.attributes
+            RETURNING id
+            """,
+            (
+                int(src_entity_id), int(dst_entity_id), relation,
+                json.dumps(attrs), float(confidence),
+            ),
+        )
+        return int(row["id"])
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def link_memory_to_entity(
+    *,
+    entity_id: int,
+    memory_id: int,
+    role: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> None:
+    """Attach a ``memories.id`` as supporting evidence for an entity.
+    Idempotent on (entity_id, memory_id)."""
+    def _run(db: DbWrapper) -> None:
+        db.execute(
+            """
+            INSERT INTO memory_entity_sources (entity_id, memory_id, role)
+            VALUES (%s, %s, %s)
+            ON CONFLICT (entity_id, memory_id) DO NOTHING
+            """,
+            (int(entity_id), int(memory_id), role),
+        )
+    if db is not None:
+        _run(db)
+    else:
+        with db_session() as owned:
+            _run(owned)
+
+
+def subgraph(
+    *,
+    entity_id: int,
+    depth: int = 1,
+    max_edges: int = 100,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Return entities + edges reachable within ``depth`` hops.
+
+    depth=1: direct neighbors only. depth=2: neighbors-of-neighbors.
+    Capped at ``max_edges`` to avoid pathological traversals.
+    """
+    if depth < 1:
+        raise ValueError("depth must be >= 1")
+    depth = min(depth, 3)
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        seen: Dict[int, Dict[str, Any]] = {}
+        edges: List[Dict[str, Any]] = []
+        frontier = {int(entity_id)}
+        for _ in range(depth):
+            if not frontier or len(edges) >= max_edges:
+                break
+            placeholders = ",".join(["%s"] * len(frontier))
+            rows = db.fetchall(
+                f"""
+                SELECT id, src_entity_id, dst_entity_id, relation,
+                       attributes, confidence
+                FROM memory_edges
+                WHERE src_entity_id IN ({placeholders})
+                   OR dst_entity_id IN ({placeholders})
+                LIMIT %s
+                """,
+                (*frontier, *frontier, max_edges - len(edges)),
+            ) or []
+            next_frontier = set()
+            for r in rows:
+                edges.append({
+                    "id": int(r["id"]),
+                    "src": int(r["src_entity_id"]),
+                    "dst": int(r["dst_entity_id"]),
+                    "relation": r["relation"],
+                    "attributes": r.get("attributes"),
+                    "confidence": float(r.get("confidence") or 1.0),
+                })
+                for eid in (int(r["src_entity_id"]), int(r["dst_entity_id"])):
+                    if eid not in seen:
+                        next_frontier.add(eid)
+            frontier = next_frontier
+
+        all_ids = set(seen.keys()) | frontier | {int(entity_id)}
+        if all_ids:
+            placeholders = ",".join(["%s"] * len(all_ids))
+            ent_rows = db.fetchall(
+                f"SELECT * FROM memory_entities "
+                f"WHERE id IN ({placeholders})",
+                tuple(all_ids),
+            ) or []
+            for r in ent_rows:
+                seen[int(r["id"])] = {
+                    "id": int(r["id"]),
+                    "entity_type": r.get("entity_type"),
+                    "canonical": r.get("canonical"),
+                    "aliases": r.get("aliases"),
+                    "attributes": r.get("attributes"),
+                    "confidence": float(r.get("confidence") or 1.0),
+                }
+        return {"entities": list(seen.values()), "edges": edges}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def merge_entities(
+    *,
+    src_id: int,
+    dst_id: int,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Merge ``src_id`` into ``dst_id`` and delete ``src_id``.
+
+    Dedup tool for the operator: when two rows ended up representing the
+    same real-world entity (e.g. "Acme Corp" and "ACME Corp." slipping
+    past the canonicalizer), merge them rather than leave dangling
+    duplicates.
+
+    Semantics:
+      * aliases = union(dst.aliases, src.aliases, src.canonical)
+      * attributes = shallow merge, dst wins on key collision
+      * confidence = max
+      * memory_entity_sources rewritten src → dst (dedup)
+      * memory_edges rewritten on both ends; self-loops and exact
+        (src,dst,relation) collisions are dropped
+      * src row is deleted
+    Returns the updated dst row.
+    """
+    if int(src_id) == int(dst_id):
+        raise ValueError("cannot merge an entity into itself")
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        src = db.fetchone("SELECT * FROM memory_entities WHERE id = %s", (int(src_id),))
+        dst = db.fetchone("SELECT * FROM memory_entities WHERE id = %s", (int(dst_id),))
+        if not src or not dst:
+            raise ValueError("entity not found")
+
+        merged_aliases = set(dst.get("aliases") or [])
+        merged_aliases.update(src.get("aliases") or [])
+        if src.get("canonical"):
+            merged_aliases.add(src["canonical"])
+        # Don't duplicate dst's own canonical as an alias.
+        merged_aliases.discard(dst.get("canonical"))
+
+        merged_attrs = dict(src.get("attributes") or {})
+        merged_attrs.update(dst.get("attributes") or {})
+
+        new_conf = max(
+            float(src.get("confidence") or 1.0),
+            float(dst.get("confidence") or 1.0),
+        )
+
+        db.execute(
+            """
+            UPDATE memory_entities
+            SET aliases = %s::jsonb,
+                attributes = %s::jsonb,
+                confidence = %s,
+                last_seen_at = now(),
+                updated_at = now()
+            WHERE id = %s
+            """,
+            (
+                json.dumps(sorted(merged_aliases)),
+                json.dumps(merged_attrs),
+                new_conf,
+                int(dst_id),
+            ),
+        )
+
+        # Rewrite sources. Drop src-linked rows that would collide on
+        # (entity_id, memory_id) before the UPDATE.
+        db.execute(
+            """
+            DELETE FROM memory_entity_sources
+            WHERE entity_id = %s
+              AND memory_id IN (
+                SELECT memory_id FROM memory_entity_sources WHERE entity_id = %s
+              )
+            """,
+            (int(src_id), int(dst_id)),
+        )
+        db.execute(
+            "UPDATE memory_entity_sources SET entity_id = %s WHERE entity_id = %s",
+            (int(dst_id), int(src_id)),
+        )
+
+        # Rewrite edges. Drop self-loops and (src,dst,relation) collisions.
+        db.execute(
+            """
+            DELETE FROM memory_edges
+            WHERE (src_entity_id = %s AND dst_entity_id = %s)
+               OR (src_entity_id = %s AND dst_entity_id = %s)
+            """,
+            (int(src_id), int(dst_id), int(dst_id), int(src_id)),
+        )
+        # Collisions on src side.
+        db.execute(
+            """
+            DELETE FROM memory_edges e1
+            WHERE e1.src_entity_id = %s
+              AND EXISTS (
+                SELECT 1 FROM memory_edges e2
+                WHERE e2.src_entity_id = %s
+                  AND e2.dst_entity_id = e1.dst_entity_id
+                  AND e2.relation = e1.relation
+              )
+            """,
+            (int(src_id), int(dst_id)),
+        )
+        db.execute(
+            "UPDATE memory_edges SET src_entity_id = %s WHERE src_entity_id = %s",
+            (int(dst_id), int(src_id)),
+        )
+        # Collisions on dst side.
+        db.execute(
+            """
+            DELETE FROM memory_edges e1
+            WHERE e1.dst_entity_id = %s
+              AND EXISTS (
+                SELECT 1 FROM memory_edges e2
+                WHERE e2.dst_entity_id = %s
+                  AND e2.src_entity_id = e1.src_entity_id
+                  AND e2.relation = e1.relation
+              )
+            """,
+            (int(src_id), int(dst_id)),
+        )
+        db.execute(
+            "UPDATE memory_edges SET dst_entity_id = %s WHERE dst_entity_id = %s",
+            (int(dst_id), int(src_id)),
+        )
+
+        db.execute("DELETE FROM memory_entities WHERE id = %s", (int(src_id),))
+
+        return db.fetchone(
+            "SELECT * FROM memory_entities WHERE id = %s", (int(dst_id),)
+        )
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+__all__ = [
+    "find_entity",
+    "upsert_entity",
+    "add_edge",
+    "link_memory_to_entity",
+    "subgraph",
+    "merge_entities",
+]
