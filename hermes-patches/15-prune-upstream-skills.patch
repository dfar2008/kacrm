-function deJongAttractor(a, b, c, d, iterations) {
-  let x = 0, y = 0;
-  beginShape(POINTS);
-  for (let i = 0; i < iterations; i++) {
-    let nx = Math.sin(a * y) - Math.cos(b * x);
-    let ny = Math.sin(c * x) - Math.cos(d * y);
-    x = nx; y = ny;
-    let px = map(x, -2.5, 2.5, 0, width);
