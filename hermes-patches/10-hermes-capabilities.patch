new file mode 100644
index 0000000000..b913fccf9d
--- /dev/null
+++ b/action_gateway/__init__.py
@@ -0,0 +1,27 @@
+"""Action Gateway — plan §8 (原语 ⑤).
+
+Every Agent-produced external side-effect flows through
+:func:`dispatcher.submit`. The gateway:
+
+1. Records the action in ``gateway_actions``.
+2. Asks the Trust Engine for a verdict.
+3. Either auto-executes, queues for approval, or blocks.
+4. Logs an ``interactions`` row for auditability.
+
+Executors are pluggable per ``kind`` (crm.write, email.send, …).
+Phase 2 ships only ``crm.write``; others are stubs.
+"""
+from hermes.action_gateway.dispatcher import register_executor
+from hermes.action_gateway.executors.crm_write import execute as _crm_write_exec
+from hermes.action_gateway.executors.email_send import execute as _email_send_exec
+from hermes.action_gateway.executors.memory_write import execute as _memory_write_exec
+from hermes.action_gateway.executors.task_create import execute as _task_create_exec
+from hermes.action_gateway.executors.coach_proposal import execute as _coach_proposal_exec
+from hermes.action_gateway.executors.lead_convert import execute as _lead_convert_exec
+
+register_executor("crm.write", _crm_write_exec)
+register_executor("email.send", _email_send_exec)
+register_executor("memory.write", _memory_write_exec)
+register_executor("task.create", _task_create_exec)
+register_executor("coach.proposal", _coach_proposal_exec)
+register_executor("lead.convert", _lead_convert_exec)
diff --git a/action_gateway/channel_reply.py b/action_gateway/channel_reply.py
new file mode 100644
index 0000000000..671a5b6f27
--- /dev/null
+++ b/action_gateway/channel_reply.py
@@ -0,0 +1,115 @@
+"""Send a one-shot reply back to a channel via origin payload.
+
+The celery intake fast-path (see :mod:`text_commands`) approves /
+rejects gateway actions when an operator types ``通过 <prefix>`` /
+``拒绝 <prefix>`` on a non-WebUI channel. Without a confirmation
+回弹, the user sees their command vanish into the void — the cloud
+silently approved the action but the IM chat shows no acknowledgement,
+which makes them think it didn't work and try again.
+
+This helper sends the confirmation back through the same channel using
+the origin payload that came in. Mapping channel → platform string
+mirrors how the notifiers dispatch outbound prompts (see
+:mod:`text_notifier` for the symmetric outbound path).
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+
+# Channel name → platform value for /internal/channel/push. Mirrors the
+# notifier registration in channels/*.py — keep in sync.
+_CHANNEL_TO_PLATFORM: Dict[str, str] = {
+    "feishu":      "feishu",
+    "wecom_ilink": "weixin",
+    "discord":     "discord",
+    "telegram":    "telegram",
+    "slack":       "slack",
+    "dingtalk":    "dingtalk",
+}
+
+
+def reply_via_origin(
+    *,
+    origin: Dict[str, Any],
+    profile_id: str,
+    text: str,
+) -> bool:
+    """POST ``text`` back to the channel that produced ``origin``.
+
+    Uses ``origin.external_user_id`` (DM) or, missing that,
+    ``origin.external_chat_id`` (group room) — same precedence as the
+    text notifier on the outbound side. Returns True on successful
+    push, False otherwise. Failures are logged but never raised: a
+    flaky channel adapter must not crash the celery task that already
+    successfully approved/rejected the action.
+    """
+    from hermes.action_gateway.eval_mode import is_eval_mode, dry_run_capture
+    if is_eval_mode():
+        dry_run_capture("channel.reply", {
+            "params": {
+                "origin": origin,
+                "profile_id": profile_id,
+                "text": text,
+            },
+        })
+        return True
+
+    from hermes_cloud.app.insights.notify import _post_via_cloud
+
+    channel = str(origin.get("channel") or "").strip()
+    platform = _CHANNEL_TO_PLATFORM.get(channel)
+    if not platform:
+        logger.warning(
+            "channel_reply: no platform mapping for channel=%r — skipping reply",
+            channel,
+        )
+        return False
+
+    target = (
+        str(origin.get("external_user_id") or "").strip()
+        or str(origin.get("external_chat_id") or "").strip()
+    )
+    if not target:
+        logger.warning(
+            "channel_reply: no external_user_id/chat_id in origin — skipping reply",
+        )
+        return False
+
+    profile_id_s = str(profile_id or "").strip()
+    if not profile_id_s:
+        logger.warning("channel_reply: missing profile_id — skipping reply")
+        return False
+
+    try:
+        user_id_for_log = int(profile_id_s) if profile_id_s.isdigit() else 0
+    except Exception:
+        user_id_for_log = 0
+
+    try:
+        ok = _post_via_cloud(
+            user_id=user_id_for_log,
+            profile_id=profile_id_s,
+            platform=platform,
+            channel_id=target,
+            text=text,
+        )
+    except Exception:
+        logger.exception(
+            "channel_reply: post failed channel=%s target=%s",
+            channel, target,
+        )
+        return False
+
+    if not ok:
+        logger.warning(
+            "channel_reply: post returned False channel=%s target=%s",
+            channel, target,
+        )
+    return ok
+
+
+__all__ = ["reply_via_origin"]
diff --git a/action_gateway/dispatcher.py b/action_gateway/dispatcher.py
new file mode 100644
index 0000000000..b3f570dff8
--- /dev/null
+++ b/action_gateway/dispatcher.py
@@ -0,0 +1,893 @@
+"""Action Gateway dispatcher — plan §8.
+
+:func:`submit` is the **only** entry-point for Agent-produced
+side-effects. It:
+
+1. Inserts a ``gateway_actions`` row (state ``pending_approval``).
+2. Calls :func:`trust.engine.decide` to get a verdict.
+3. Based on the verdict:
+   - ``EXECUTE`` → calls the executor, transitions to ``executed``.
+   - ``REQUIRE_APPROVAL`` → stays ``pending_approval``.
+   - ``BLOCK`` → transitions to ``blocked``.
+4. Returns the action record with its current state.
+
+:func:`approve` / :func:`reject` handle the human-in-the-loop path.
+:func:`revert` undoes an executed action using the stored
+``revert_token``.
+"""
+from __future__ import annotations
+
+import logging
+import uuid
+from typing import Any, Callable, Dict, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.trust.engine import Decision, decide as trust_decide
+
+logger = logging.getLogger(__name__)
+
+
+def _emit_interaction(*args, **kwargs):
+    """Lazy adapter — hermes/* must not import hermes_cloud/* at module load."""
+    from hermes_cloud.app.interactions import emit
+    return emit(*args, **kwargs)
+
+
+# ---------------------------------------------------------------------------
+# Executor registry
+# ---------------------------------------------------------------------------
+
+_executors: Dict[str, Callable] = {}
+
+
+def register_executor(kind: str, fn: Callable) -> None:
+    """Register an executor for an action kind.
+
+    The callable signature is ``fn(action: dict, db: DbWrapper) -> dict``
+    where the return value is a dict of extra fields to merge into the
+    gateway_actions row (e.g. ``revert_token``).
+    """
+    _executors[kind] = fn
+
+
+def _get_executor(kind: str) -> Optional[Callable]:
+    return _executors.get(kind)
+
+
+# ---------------------------------------------------------------------------
+# Core operations
+# ---------------------------------------------------------------------------
+
+
+class ActionBlockedError(Exception):
+    """Raised when the trust engine or compliance check blocks an action."""
+
+
+class ActionWrongChannelError(Exception):
+    """Raised when approve/reject is attempted from a channel that did not
+    originate the action.
+
+    Charter §1 (渠道闭环): an action must be approved on the channel it
+    came from. The originator is recorded in ``gateway_actions.origin->>'channel'``
+    at submit time; ``approve``/``reject`` callers pass ``via_channel=...``
+    naming where the human clicked, and we refuse mismatches so a Feishu
+    pending can't be silently approved from the WebUI dashboard (or vice
+    versa). Rows whose ``origin`` is NULL (legacy, pre-2028 migration)
+    are treated as ``webui``-originated for backwards-compat.
+    """
+
+
+# Charter 原语 ④ role Compliance (§11) — which action kinds leave the
+# tenant boundary and must pass a pre-egress review. Internal writes
+# (``crm.write``) don't — they're covered by trust + undo.
+_EGRESS_KINDS = frozenset({
+    "email.send",
+    "im.send",
+    "doc.share",
+    "contract.send",
+})
+
+# Internal-only action kinds — never leave the tenant boundary, fully
+# revertable via the executor's revert_token. Approval was a vestigial
+# gate from the early Charter draft; in practice it produced an inbox
+# of "✓ I saw it" clicks with no real review value. These kinds now
+# auto-execute on submit (BLOCK from trust/compliance still wins).
+# Egress kinds (``_EGRESS_KINDS`` above) continue to require approval.
+_FORCE_AUTO_EXECUTE_KINDS: frozenset[str] = frozenset({
+    "crm.write",
+    "task.create",
+    "coach.proposal",
+    "memory.write",
+    "lead.convert",
+})
+
+
+def _compliance_precheck(
+    kind: str, params: Optional[Dict[str, Any]],
+) -> Dict[str, Any]:
+    """No-op compliance pre-check stub.
+
+    Charter v2 Phase 2 (2026-05-05): the deterministic ComplianceAgent
+    pre-check was removed when the specialist was folded into the
+    ``compliance-check`` markdown skill. Compliance review is now an
+    LLM-side concern: the main agent is expected to run the
+    ``compliance-check`` skill (via ``skill_view``) before submitting any
+    egress action — see ``email-drafting`` skill's pre-send checklist.
+    The dispatcher no longer carries a redundant rule-based gate; this
+    stub keeps the call-site signature stable while returning ``clean``.
+    """
+    return {"severity": "clean", "findings": []}
+
+
+# Charter §A2 — action kinds that participate in cross-agent record-state
+# coordination. Only ``crm.write`` (with ``op=='update'`` + ``record_id``)
+# is gated today; create has no record_id yet so the lock is skipped.
+_RECORD_LOCK_KINDS = frozenset({"crm.write"})
+
+
+def _record_lock_target(
+    kind: str, params: Optional[Dict[str, Any]],
+) -> Optional[tuple[str, int]]:
+    """Extract ``(module, record_id)`` from a submit() call when the
+    kind opts into the record-state lock and the call targets an
+    existing record. Returns None for unsupported kinds, creates
+    (no record_id), or malformed params.
+    """
+    if kind not in _RECORD_LOCK_KINDS or not params:
+        return None
+    if str(params.get("op", "")) != "update":
+        return None
+    raw_module = params.get("module_id") or params.get("module")
+    raw_record = params.get("record_id")
+    if raw_module is None or raw_record is None:
+        return None
+    try:
+        return (str(raw_module), int(raw_record))
+    except (TypeError, ValueError):
+        return None
+
+
+def submit(
+    *,
+    profile_id: str,
+    agent_name: str,
+    kind: str,
+    target: Optional[Dict[str, Any]] = None,
+    params: Optional[Dict[str, Any]] = None,
+    risk: str = "low",
+    user_id: Optional[int] = None,
+    draft_id: Optional[int] = None,
+    origin: Optional[Dict[str, Any]] = None,
+    executing_specialist: Optional[str] = None,
+    delegation_parent_draft_id: Optional[str] = None,
+    delegation_root_draft_id: Optional[str] = None,
+    source_skill: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Submit an Agent action through the gateway.
+
+    Returns the ``gateway_actions`` row as a dict.
+
+    Raises :class:`ActionBlockedError` if the trust engine blocks the
+    action outright.
+
+    The ``origin`` dict records *where this action came from* so the
+    notifier can deliver any approval prompt back to the same channel
+    (Charter §1 渠道闭环). Required key is ``channel`` (e.g. ``"feishu"``,
+    ``"wecom_ilink"``, ``"webui"``). Channel adapters may attach
+    arbitrary additional keys (``external_user_id`` / ``external_message_id``
+    / ``external_chat_id`` / ``interaction_id``) — they round-trip into
+    the ``origin`` JSONB column unchanged. ``origin=None`` falls back to
+    ``{"channel": "webui"}`` so legacy callers keep working.
+    """
+    if origin is None:
+        origin = {"channel": "webui"}
+    elif not (isinstance(origin, dict) and origin.get("channel")):
+        # Defensive — never persist a half-formed origin.
+        logger.warning(
+            "gateway_submit_invalid_origin_coerced_to_webui got=%r", origin,
+        )
+        origin = {"channel": "webui"}
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        # Bug A fix (2026-05-04) — wrap the entire submit pipeline in a
+        # single transaction. Previously each ``db.execute`` auto-committed
+        # because we were never inside a ``db.transaction()`` block. That
+        # meant: INSERT gateway_actions (state='pending_approval') committed,
+        # trust_decisions row committed, THEN if ``_execute_action`` raised
+        # — e.g. because the LLM emitted a row shape the underlying
+        # ``Save.insert`` rejected — the row stayed forever in
+        # ``pending_approval`` despite the trust verdict being EXECUTE.
+        # Worse, the LLM read the ``pending_approval`` response and told
+        # the user "CRM 工具暂时不可用", masking a real executor failure
+        # (see DB rows for action 80e6c9c8 — verdict auto_execute, state
+        # pending_approval, no executed_at). Wrapping in a transaction
+        # makes the executor's exception roll back the INSERT too, so the
+        # caller sees a normal error and the row never appears at all.
+        #
+        # Test fakes that lack ``transaction()`` fall back to the legacy
+        # auto-commit path — they don't simulate the failure mode we're
+        # fixing here, so the production guard would just trip on
+        # AttributeError.
+        if hasattr(db, "transaction") and callable(getattr(db, "transaction")):
+            with db.transaction():
+                return _run_in_txn(db)
+        return _run_in_txn(db)
+
+    def _run_in_txn(db: DbWrapper) -> Dict[str, Any]:
+        action_id = str(uuid.uuid4())
+
+        # 0. Cross-agent record-state lock (Charter §A2). Acquire BEFORE
+        # inserting pending_approval so a colliding agent never sees a
+        # half-formed gateway_actions row.
+        record_write_token: Optional[int] = None
+        lock_target = _record_lock_target(kind, params)
+        if lock_target is not None:
+            module_str, record_id_int = lock_target
+            try:
+                from hermes.action_gateway.record_state import (
+                    WriteCollisionError, begin_write,
+                )
+                record_write_token = begin_write(
+                    module=module_str,
+                    record_id=record_id_int,
+                    agent_name=str(executing_specialist or agent_name),
+                    profile_id=str(profile_id),
+                    fields=dict(params.get("data") or {}) if params else None,
+                )
+            except WriteCollisionError as exc:
+                raise ActionBlockedError(
+                    f"record_state: {exc}"
+                ) from exc
+            except Exception:
+                # Lock infra failure is non-fatal — log and proceed
+                # without the token (fall back to existing behaviour).
+                logger.exception(
+                    "record_state_begin_write_failed kind=%s module=%s "
+                    "record_id=%s",
+                    kind, module_str, record_id_int,
+                )
+
+        # 1. Insert the action record
+        db.execute(
+            """
+            INSERT INTO gateway_actions
+                (id, profile_id, agent_name, kind, target, params,
+                 state, draft_id, origin,
+                 executing_specialist,
+                 delegation_parent_draft_id,
+                 delegation_root_draft_id,
+                 record_write_token,
+                 source_skill)
+            VALUES (%s, %s, %s, %s, %s::jsonb, %s::jsonb,
+                    'pending_approval', %s, %s::jsonb,
+                    %s, %s, %s,
+                    %s, %s)
+            """,
+            (
+                action_id,
+                str(profile_id),
+                str(agent_name),
+                str(kind),
+                _json_or_null(target),
+                _json_or_null(params),
+                int(draft_id) if draft_id else None,
+                _json_or_null(origin),
+                str(executing_specialist) if executing_specialist else None,
+                str(delegation_parent_draft_id)
+                if delegation_parent_draft_id is not None else None,
+                str(delegation_root_draft_id)
+                if delegation_root_draft_id is not None else None,
+                record_write_token,
+                str(source_skill) if source_skill else None,
+            ),
+        )
+
+        # 1b. Compliance pre-egress review (Charter §11). Stub since
+        # Phase 2 (2026-05-05) — the deterministic ComplianceAgent gate
+        # was removed when the specialist was folded into the
+        # ``compliance-check`` skill; this call always returns
+        # ``severity="clean"`` and the block-branch below is dead code
+        # we keep so the schema stays compatible if a future deterministic
+        # gate is reintroduced.
+        compliance = _compliance_precheck(kind, params)
+        if compliance["severity"] == "block":
+            _release_record_lock(record_write_token, committed=False)
+            db.execute(
+                """
+                UPDATE gateway_actions
+                SET state = 'blocked',
+                    params = coalesce(params, '{}'::jsonb)
+                            || %s::jsonb
+                WHERE id = %s
+                """,
+                (_json_or_null({"_compliance": compliance}) or "{}", action_id),
+            )
+            try:
+                _emit_interaction(
+                    kind="gateway_action_blocked",
+                    subjects=None,
+                    actors=[{"type": "agent", "name": str(agent_name)}],
+                    content={
+                        "action_id": action_id,
+                        "kind": kind,
+                        "reason": "compliance_block",
+                        "findings": compliance["findings"][:10],
+                    },
+                    source="gateway:compliance",
+                    db=db,
+                )
+            except Exception:
+                pass  # audit best-effort
+            raise ActionBlockedError(
+                "compliance: blocked by pre-egress review "
+                f"({len(compliance['findings'])} finding(s))"
+            )
+
+        # 2. Trust Engine verdict — keying precedence:
+        #   v2 (preferred): (profile_id, action_kind, source_skill)
+        #   v1 (fallback):  (profile_id, agent_name, action_kind)  with
+        #     ``executing_specialist`` taking precedence over
+        #     ``agent_name`` so trust_levels rows attached to the
+        #     specialist apply even if the call site set agent_name to
+        #     a wrapper / legacy name (Charter §2.5.D).
+        # ``trust_decide.get_level`` consults source_skill first then
+        # falls back to the v1 keying — so callers transitioning to
+        # skill-based trust simply start passing source_skill while
+        # legacy callers keep working unchanged.
+        trust_key_agent = executing_specialist or agent_name
+        verdict = trust_decide(
+            profile_id=profile_id,
+            agent_name=trust_key_agent,
+            action_kind=kind,
+            risk=risk,
+            action_id=action_id,
+            source_skill=source_skill,
+            db=db,
+        )
+
+        # 3. Update state + store trust_level snapshot
+        db.execute(
+            "UPDATE gateway_actions SET trust_level = %s WHERE id = %s",
+            (verdict.level, action_id),
+        )
+
+        if verdict.decision == Decision.BLOCK:
+            db.execute(
+                "UPDATE gateway_actions SET state = 'blocked' WHERE id = %s",
+                (action_id,),
+            )
+            _release_record_lock(record_write_token, committed=False)
+            raise ActionBlockedError(verdict.reason)
+
+        # Policy override: some kinds are always auto-executed (still allow
+        # explicit BLOCK from trust/compliance).
+        executed_now = False
+        if (
+            verdict.decision == Decision.REQUIRE_APPROVAL
+            and kind in _FORCE_AUTO_EXECUTE_KINDS
+        ):
+            logger.info(
+                "gateway_force_auto_execute kind=%s profile=%s agent=%s action=%s",
+                kind,
+                profile_id,
+                agent_name,
+                action_id,
+            )
+            try:
+                _execute_action(action_id, kind, target, params, user_id, db)
+                executed_now = True
+            except Exception:
+                _release_record_lock(record_write_token, committed=False)
+                raise
+        elif verdict.decision == Decision.EXECUTE:
+            try:
+                _execute_action(action_id, kind, target, params, user_id, db)
+                executed_now = True
+            except Exception:
+                _release_record_lock(record_write_token, committed=False)
+                raise
+
+        if executed_now:
+            _release_record_lock(record_write_token, committed=True)
+
+        # 4. Return final row
+        final_row = _fetch_action(action_id, db)
+
+        # 5. Channel-closed-loop pending notification (Charter §1).
+        # Only deliver if the action is *still* pending after trust /
+        # auto-execute decisions, and only after the caller's transaction
+        # actually commits (after_commit hook) — a notifier cannot push a
+        # card to Feishu for an action that subsequently rolled back.
+        if final_row and final_row.get("state") == "pending_approval":
+            try:
+                from hermes.action_gateway.notifiers import notify_pending
+
+                _origin = origin  # close over the validated dict
+                _action_snapshot = dict(final_row)
+
+                def _deliver():
+                    notify_pending(_action_snapshot, _origin)
+
+                if hasattr(db, "after_commit"):
+                    db.after_commit(_deliver)
+                else:
+                    # No transaction wrapper — caller is owning the
+                    # connection and we already wrote the row, so it's
+                    # safe to fire now.
+                    _deliver()
+            except Exception:
+                logger.exception(
+                    "gateway_submit_notify_setup_failed action_id=%s",
+                    action_id,
+                )
+
+        return final_row
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _origin_channel(row: Dict[str, Any]) -> str:
+    """Read ``origin->>'channel'`` from a fetched action row, defaulting
+    to ``'webui'`` for legacy NULL rows so the cross-channel guard does
+    not lock out backfilled history."""
+    origin = row.get("origin")
+    if isinstance(origin, dict):
+        ch = origin.get("channel") or ""
+        return str(ch) if ch else "webui"
+    return "webui"
+
+
+def _enforce_channel_match(
+    *, action_id: str, row: Dict[str, Any], via_channel: str,
+) -> None:
+    """Raise :class:`ActionWrongChannelError` if ``via_channel`` does not
+    match the action's recorded origin channel. See Charter §1."""
+    origin_ch = _origin_channel(row)
+    if (via_channel or "").strip() != origin_ch:
+        raise ActionWrongChannelError(
+            f"action {action_id} originated on channel={origin_ch!r}; "
+            f"approve/reject must come from that channel, "
+            f"got via_channel={via_channel!r}"
+        )
+
+
+def approve(
+    action_id: str,
+    approver_id: int,
+    *,
+    via_channel: str = "webui",
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Approve a pending action and execute it.
+
+    ``via_channel`` is the channel the human clicked from. It must match
+    the action's recorded ``origin.channel`` or :class:`ActionWrongChannelError`
+    is raised — Charter §1 (渠道闭环): a Feishu pending must be approved
+    on Feishu, a WebUI pending on WebUI, etc.
+    """
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        row = _fetch_action(action_id, db)
+        if not row:
+            raise ValueError(f"action {action_id} not found")
+        if row["state"] != "pending_approval":
+            raise ValueError(
+                f"action {action_id} is {row['state']}, not pending_approval"
+            )
+        _enforce_channel_match(
+            action_id=action_id, row=row, via_channel=via_channel,
+        )
+
+        db.execute(
+            """
+            UPDATE gateway_actions
+            SET state = 'approved', approver = %s, approved_at = now()
+            WHERE id = %s
+            """,
+            (int(approver_id), str(action_id)),
+        )
+
+        try:
+            _execute_action(
+                action_id,
+                row["kind"],
+                row.get("target"),
+                row.get("params"),
+                approver_id,
+                db,
+            )
+        except Exception:
+            _release_record_lock(
+                row.get("record_write_token"), committed=False,
+            )
+            raise
+
+        # Charter §A2 — close out any open record-state lock now that
+        # the action actually landed.
+        _release_record_lock(
+            row.get("record_write_token"), committed=True,
+        )
+
+        # Record adoption in rl_agent_drafts
+        _record_draft_adoption(row, adopted=True, db=db)
+
+        return _fetch_action(action_id, db)
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+_VALID_REJECT_REASON_TYPES = frozenset({
+    "action_bad",
+    "routing_bad",
+    "objective_bad",
+})
+
+
+def reject(
+    action_id: str,
+    approver_id: Optional[int] = None,
+    *,
+    reason: str = "",
+    reason_type: str = "action_bad",
+    approver: Optional[Any] = None,
+    via_channel: str = "webui",
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Reject a pending action.
+
+    ``via_channel`` must match the action's ``origin.channel`` — see
+    :func:`approve` for the rationale.
+
+    ``reason_type`` (Charter §2.5.D / Task 21) routes the reward signal:
+
+      - ``"action_bad"`` (default) — the executing specialist produced
+        the wrong content. Writes a ``quality:reject`` signal against
+        ``executing_specialist``.
+      - ``"routing_bad"`` — the parent specialist routed to the wrong
+        child. One ``routing:bad`` signal per edge whose child is this
+        draft, attributed to the edge's parent.
+      - ``"objective_bad"`` — the chain root took on a bad ask. One
+        ``objective:bad`` signal against the root's executing specialist
+        (falls back to this draft's executing specialist if no chain).
+
+    ``approver`` is an optional alternate identifier (str or int) for
+    callers that don't have a numeric user id (e.g. agent tests).
+    Either ``approver_id`` or ``approver`` may be supplied; the integer
+    one wins for the gateway_actions FK and the string is dropped on
+    the floor (the audit trail lives on the originating channel).
+    """
+    if reason_type not in _VALID_REJECT_REASON_TYPES:
+        raise ValueError(
+            f"unknown reason_type: {reason_type!r} (expected one of "
+            f"{sorted(_VALID_REJECT_REASON_TYPES)})"
+        )
+
+    # Reconcile approver / approver_id: if a numeric was passed via
+    # approver, promote it; otherwise the FK column stays NULL.
+    if approver_id is None and isinstance(approver, int):
+        approver_id = approver
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        row = _fetch_action(action_id, db)
+        if not row:
+            raise ValueError(f"action {action_id} not found")
+        if row["state"] != "pending_approval":
+            raise ValueError(
+                f"action {action_id} is {row['state']}, not pending_approval"
+            )
+        _enforce_channel_match(
+            action_id=action_id, row=row, via_channel=via_channel,
+        )
+
+        db.execute(
+            """
+            UPDATE gateway_actions
+            SET state = 'rejected',
+                approver = %s,
+                approved_at = now(),
+                reject_reason_type = %s
+            WHERE id = %s
+            """,
+            (
+                int(approver_id) if approver_id is not None else None,
+                str(reason_type),
+                str(action_id),
+            ),
+        )
+
+        # Charter §A2 — release the lock so other agents can proceed.
+        _release_record_lock(
+            row.get("record_write_token"), committed=False,
+        )
+
+        # Charter v2 Phase 3 (2026-05-06): RL reject-signal routing
+        # removed (agents/reward_signals + rl/drafts deleted). Reject
+        # is now a state transition only.
+        _record_draft_adoption(row, adopted=False, db=db)
+
+        return _fetch_action(action_id, db)
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def revert(
+    action_id: str,
+    user_id: int,
+    *,
+    force: bool = False,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Revert an executed action using its stored revert_token.
+
+    The executor's revert function receives
+    ``(revert_token, db, *, stored_hash=..., force=...)`` and is
+    responsible for undoing the side-effect.
+
+    Phase 4.2: if the executor raises :class:`ConflictError` (live row
+    no longer matches the hash captured at execute time), park the
+    action in ``state='conflict'`` instead of flipping the soft-delete.
+    Re-reverting an already-reverted action is a noop. ``force=True``
+    bypasses the conflict guard (kept opt-in for Phase 4.3 chat ops).
+    """
+    from hermes.action_gateway.executors import ConflictError
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        row = _fetch_action(action_id, db)
+        if not row:
+            raise ValueError(f"action {action_id} not found")
+
+        # Phase 4.2: re-revert is a benign noop, so callers can retry
+        # without flipping soft-delete twice or double-emitting.
+        if row["state"] == "reverted":
+            return row
+
+        if row["state"] != "executed":
+            raise ValueError(
+                f"action {action_id} is {row['state']}, cannot revert"
+            )
+
+        executor = _get_executor(row["kind"])
+        revert_fn = getattr(executor, "revert", None) if executor else None
+
+        try:
+            if revert_fn and row.get("revert_token"):
+                revert_fn(
+                    row["revert_token"],
+                    db,
+                    stored_hash=row.get("record_hash"),
+                    force=force,
+                )
+        except ConflictError as exc:
+            logger.warning(
+                "gateway_revert_conflict action=%s entity=%s "
+                "stored=%s live=%s",
+                action_id, exc.entity, exc.stored_hash, exc.live_hash,
+            )
+            db.execute(
+                """
+                UPDATE gateway_actions
+                SET state = 'conflict',
+                    params = coalesce(params, '{}'::jsonb)
+                            || %s::jsonb
+                WHERE id = %s
+                """,
+                (
+                    _json_or_null({
+                        "_conflict": {
+                            "entity": exc.entity,
+                            "stored_hash": exc.stored_hash,
+                            "live_hash": exc.live_hash,
+                            "record_id": exc.record_id,
+                        },
+                    }) or "{}",
+                    str(action_id),
+                ),
+            )
+            try:
+                _emit_interaction(
+                    kind="action",
+                    subjects=row.get("target") and [row["target"]],
+                    actors=[{"type": "user", "id": int(user_id)}],
+                    content={
+                        "op": "revert_conflict",
+                        "action_id": action_id,
+                        "entity": exc.entity,
+                        "stored_hash": exc.stored_hash,
+                        "live_hash": exc.live_hash,
+                    },
+                    source="gateway:revert",
+                    db=db,
+                )
+            except Exception as iexc:
+                logger.warning(
+                    "revert_conflict_interaction_failed action=%s err=%r",
+                    action_id, iexc,
+                )
+            return _fetch_action(action_id, db)
+
+        db.execute(
+            """
+            UPDATE gateway_actions
+            SET state = 'reverted', reverted_at = now()
+            WHERE id = %s
+            """,
+            (str(action_id),),
+        )
+
+        # Log revert as an interaction
+        try:
+            _emit_interaction(
+                kind="action",
+                subjects=row.get("target") and [row["target"]],
+                actors=[{"type": "user", "id": int(user_id)}],
+                content={"op": "revert", "action_id": action_id},
+                source="manual",
+                db=db,
+            )
+        except Exception as exc:
+            logger.warning("revert_interaction_failed action=%s err=%r", action_id, exc)
+
+        return _fetch_action(action_id, db)
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+
+def _release_record_lock(token: Any, *, committed: bool) -> None:
+    """Close a Charter §A2 record-state intent. ``committed=True`` marks
+    the write as landed; ``False`` rolls it back so other agents may
+    proceed. Failures are swallowed — a stuck lock row never breaks the
+    user-visible action flow (the partial index ignores closed rows; a
+    cleanup pass can sweep orphans).
+    """
+    if not token:
+        return
+    try:
+        from hermes.action_gateway.record_state import (
+            commit_write, rollback_write,
+        )
+        if committed:
+            commit_write(int(token))
+        else:
+            rollback_write(int(token))
+    except Exception:
+        logger.exception(
+            "record_state_release_failed token=%s committed=%s",
+            token, committed,
+        )
+
+
+def _record_draft_adoption(
+    action_row: Dict[str, Any],
+    *,
+    adopted: bool,
+    db: DbWrapper,
+) -> None:
+    """No-op stub — Charter v2 Phase 3 (2026-05-06): RL draft
+    adoption tracking removed along with rl/drafts. Action approve /
+    reject still update gateway_actions.state, but no longer write
+    a corresponding rl_agent_drafts.adopted column.
+    """
+    return None
+
+
+def _execute_action(
+    action_id: str,
+    kind: str,
+    target: Any,
+    params: Any,
+    user_id: Optional[int],
+    db: DbWrapper,
+) -> None:
+    """Run the executor and transition to 'executed'."""
+    executor = _get_executor(kind)
+    extra: Dict[str, Any] = {}
+    if executor:
+        # Phase 4.0c — surface profile_id / agent_name / draft_id to the
+        # executor so kinds like ``task.create`` can stamp the row with
+        # who-asked-for-it without callers having to repeat it in params.
+        ctx_row = db.fetchone(
+            "SELECT profile_id, agent_name, draft_id "
+            "FROM gateway_actions WHERE id = %s",
+            (str(action_id),),
+        ) or {}
+        action_dict = {
+            "id": action_id,
+            "kind": kind,
+            "target": target,
+            "params": params,
+            "user_id": user_id,
+            "profile_id": ctx_row.get("profile_id"),
+            "agent_name": ctx_row.get("agent_name"),
+            "draft_id": ctx_row.get("draft_id"),
+        }
+        result = executor(action_dict, db)
+        if isinstance(result, dict):
+            extra = result
+
+    revert_token = extra.get("revert_token")
+    interaction_id = extra.get("interaction_id")
+
+    db.execute(
+        """
+        UPDATE gateway_actions
+        SET state = 'executed',
+            executed_at = now(),
+            revert_token = %s::jsonb,
+            interaction_id = %s
+        WHERE id = %s
+        """,
+        (
+            _json_or_null(revert_token),
+            str(interaction_id) if interaction_id else None,
+            str(action_id),
+        ),
+    )
+
+
+def _fetch_action(action_id: str, db: DbWrapper) -> Optional[Dict[str, Any]]:
+    return db.fetchone(
+        "SELECT * FROM gateway_actions WHERE id = %s",
+        (str(action_id),),
+    )
+
+
+def _json_default(obj: Any) -> Any:
+    # psycopg returns NUMERIC as Decimal and TIMESTAMPTZ/DATE as
+    # datetime/date; UUID columns come back as uuid.UUID. Any revert_token
+    # or params that snapshots a DB row carries these types — without a
+    # default handler json.dumps blows up inside the gateway txn and the
+    # whole write rolls back.
+    from datetime import date, datetime
+    from decimal import Decimal
+    from uuid import UUID
+    if isinstance(obj, Decimal):
+        return str(obj)
+    if isinstance(obj, datetime):
+        return obj.isoformat()
+    if isinstance(obj, date):
+        return obj.isoformat()
+    if isinstance(obj, UUID):
+        return str(obj)
+    # A stray set/frozenset (e.g. an aggregate field on params/origin) must
+    # not abort the whole gateway write with a TypeError — coerce to a
+    # deterministic list. Mirrors the set-safe JSON handling on the cloud's
+    # interactions encoder and Celery serializer (commit 9eb919c).
+    if isinstance(obj, (set, frozenset)):
+        return sorted(obj, key=str)
+    raise TypeError(
+        f"_json_default: unsupported type {type(obj).__name__}"
+    )
+
+
+def _json_or_null(val: Any) -> Optional[str]:
+    if val is None:
+        return None
+    import json
+    return json.dumps(val, default=_json_default, ensure_ascii=False)
+
+
+__all__ = [
+    "ActionBlockedError",
+    "register_executor",
+    "submit",
+    "approve",
+    "reject",
+    "revert",
+]
diff --git a/action_gateway/eval_mode.py b/action_gateway/eval_mode.py
new file mode 100644
index 0000000000..af4cda7e71
--- /dev/null
+++ b/action_gateway/eval_mode.py
@@ -0,0 +1,72 @@
+"""Eval-mode dry-run capture for Action Gateway executors.
+
+Charter v2 §十 — Offline Evaluation Substrate, Phase B.
+
+When ``HERMES_EVAL_MODE=1`` is set in the environment, executors that
+have real-world side effects (CRM writes, task creation, email send,
+channel reply) short-circuit through :func:`dry_run_capture` instead of
+running their normal logic. The intended action payload is appended to
+a JSONL log (path from ``HERMES_EVAL_LOG``, default
+``/tmp/hermes-eval-intents.jsonl``) and a no-op success result is
+returned so the agent's trajectory continues as if the action
+succeeded.
+
+This is NOT a generic developer/test mock. Only set ``HERMES_EVAL_MODE=1``
+on the hermes_cloud process when running an offline eval batch via
+``scripts/eval/runner.py``.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+from typing import Any, Dict
+
+logger = logging.getLogger(__name__)
+
+
+def is_eval_mode() -> bool:
+    """True when ``HERMES_EVAL_MODE=1`` is set."""
+    return os.environ.get("HERMES_EVAL_MODE") == "1"
+
+
+def dry_run_capture(kind: str, action: Dict[str, Any]) -> Dict[str, Any]:
+    """Log the intended action and return a safe no-op executor result.
+
+    Returns a dict shaped like a successful executor result so the
+    dispatcher continues normally. The ``revert_token`` uses an
+    ``eval_noop`` op that :func:`is_eval_noop_token` flags so revert
+    paths can short-circuit too.
+    """
+    payload = {
+        "kind": kind,
+        "action_id": str(action.get("id") or ""),
+        "user_id": action.get("user_id"),
+        "profile_id": action.get("profile_id"),
+        "agent_name": action.get("agent_name"),
+        "params": action.get("params") or {},
+    }
+    log_path = os.environ.get(
+        "HERMES_EVAL_LOG", "/tmp/hermes-eval-intents.jsonl"
+    )
+    try:
+        with open(log_path, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(payload, ensure_ascii=False, default=str) + "\n")
+    except Exception:
+        logger.exception("eval_dry_run_log_failed kind=%s", kind)
+    logger.info(
+        "eval_dry_run kind=%s action_id=%s", kind, payload["action_id"],
+    )
+    return {
+        "revert_token": {"op": "eval_noop", "kind": kind},
+        "dry_run": True,
+        "would_do": payload,
+    }
+
+
+def is_eval_noop_token(token: Any) -> bool:
+    """True if this revert token came from a dry-run; revert should no-op."""
+    return isinstance(token, dict) and token.get("op") == "eval_noop"
+
+
+__all__ = ["is_eval_mode", "dry_run_capture", "is_eval_noop_token"]
diff --git a/action_gateway/executors/__init__.py b/action_gateway/executors/__init__.py
new file mode 100644
index 0000000000..49db7ac768
--- /dev/null
+++ b/action_gateway/executors/__init__.py
@@ -0,0 +1,112 @@
+"""Gateway executors — one per action ``kind``.
+
+Phase 4.2 utilities live here too:
+
+- :class:`ConflictError` — raised by an executor's ``revert`` when the
+  live row's content hash no longer matches the hash stored at execute
+  time. The dispatcher catches this, transitions the action to
+  ``state='conflict'`` and refuses to flip the soft-delete.
+- :func:`compute_record_hash` — stable SHA-256 over the user-meaningful
+  fields of a fetched row, with a default exclude set covering pure
+  bookkeeping columns.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any, Dict, Iterable, Mapping, Optional
+
+
+# Default excludes: pure bookkeeping that *must not* trigger a conflict
+# even though it changes between execute and revert. Each executor may
+# extend with its own kind-specific bookkeeping.
+DEFAULT_HASH_EXCLUDE = frozenset({
+    "updated_at",
+    "created_at",
+    "deleted",
+    "deleted_at",
+    "cancelled_at",
+    # gateway bookkeeping that lives in meta:
+    "gateway_action_id",
+})
+
+
+class ConflictError(Exception):
+    """Raised by an executor's ``revert`` when the live row no longer
+    matches the hash captured at execute time. The dispatcher catches
+    this and parks the action in ``state='conflict'`` without flipping
+    soft-delete.
+    """
+
+    def __init__(
+        self,
+        *,
+        entity: str,
+        stored_hash: Optional[str],
+        live_hash: Optional[str],
+        record_id: Any = None,
+    ) -> None:
+        super().__init__(
+            f"revert conflict on {entity} id={record_id}: "
+            f"stored={stored_hash} live={live_hash}"
+        )
+        self.entity = entity
+        self.stored_hash = stored_hash
+        self.live_hash = live_hash
+        self.record_id = record_id
+
+
+def _normalize(value: Any) -> Any:
+    """Make values JSON-serializable + order-stable for hashing."""
+    if isinstance(value, Mapping):
+        return {str(k): _normalize(value[k]) for k in sorted(value.keys())}
+    if isinstance(value, (list, tuple)):
+        return [_normalize(v) for v in value]
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        return value
+    # datetime / Decimal / UUID / etc. — fall back to a stable str().
+    return str(value)
+
+
+def compute_record_hash(
+    row: Optional[Mapping[str, Any]],
+    *,
+    exclude: Optional[Iterable[str]] = None,
+) -> Optional[str]:
+    """Return a stable SHA-256 over the user-meaningful fields of ``row``.
+
+    Excluded by default: ``updated_at``, ``created_at``, ``deleted``,
+    ``deleted_at``, ``cancelled_at``, ``meta.gateway_action_id``. Pass
+    ``exclude=`` to extend (caller's set is unioned with the default).
+
+    Returns ``None`` when ``row`` is ``None`` so callers can pass-through
+    "no live row" signals without special-casing.
+    """
+    if row is None:
+        return None
+    excl = set(DEFAULT_HASH_EXCLUDE)
+    if exclude:
+        excl.update(exclude)
+
+    payload: Dict[str, Any] = {}
+    for k, v in row.items():
+        key = str(k)
+        if key in excl:
+            continue
+        if key == "meta" and isinstance(v, Mapping):
+            payload[key] = {
+                str(mk): _normalize(v[mk])
+                for mk in sorted(v.keys())
+                if str(mk) not in excl
+            }
+        else:
+            payload[key] = _normalize(v)
+    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=False)
+    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()
+
+
+__all__ = [
+    "ConflictError",
+    "DEFAULT_HASH_EXCLUDE",
+    "compute_record_hash",
+]
diff --git a/action_gateway/executors/coach_proposal.py b/action_gateway/executors/coach_proposal.py
new file mode 100644
index 0000000000..99e1e5450b
--- /dev/null
+++ b/action_gateway/executors/coach_proposal.py
@@ -0,0 +1,49 @@
+"""``coach.proposal`` executor — charter v2 §定律 5 conservative form.
+
+Each card produced by the ``crm-daily-coach`` skill becomes one
+``gateway_actions`` row of kind=``coach.proposal``. The "execute" verb
+here means **"user copied the draft to clipboard"** — there is no
+side-effect to run server-side (the clipboard write happens in the
+browser; for IM channels the user long-presses the message text).
+
+So this executor is a no-op that just records that the user approved
+the draft. Revert is trivially supported (un-mark as executed) — but
+since there's no external effect to undo, revert is mostly symbolic.
+
+``params`` shape (passed by the cron + skill output):
+- ``summary`` (str, required) — one-line fact
+- ``action`` (dict, required) — ``{"type": "draft_message"|"task_create",
+                                   "draft": "...",
+                                   "intended_channel": "wechat|email|feishu"}``
+- ``notification_channels`` (list[str]) — ``["wechat"]`` | ``["inbox"]``
+- ``severity`` (str) — ``"high" | "medium" | "low"``
+- ``reasoning`` (str, optional)
+
+Returns ``{"revert_token": {"op": "noop"}}`` — nothing to undo, but a
+token is required by the dispatcher contract.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+def execute(action: Dict[str, Any], db: DbWrapper) -> Dict[str, Any]:
+    """No-op executor — the clipboard copy is a client-side effect.
+
+    Side note: we could enrich this later to also write an
+    ``interactions`` row (kind=``coach_proposal_copied``) for the
+    memory substrate to consume, but for now the ``gateway_actions``
+    state transition (``pending → executed``) carries the signal.
+    """
+    params = action.get("params") or {}
+    summary = (params.get("summary") or "")[:120]
+    logger.info(
+        "coach_proposal copied: action=%s summary=%r",
+        action.get("id"), summary,
+    )
+    return {"revert_token": {"op": "noop"}}
diff --git a/action_gateway/executors/crm_write.py b/action_gateway/executors/crm_write.py
new file mode 100644
index 0000000000..9cb382fa0d
--- /dev/null
+++ b/action_gateway/executors/crm_write.py
@@ -0,0 +1,306 @@
+"""CRM write executor — ``kind='crm.write'``.
+
+Executes a CRM record create or update through :class:`Save`, records a
+``revert_token`` that enables undo, and returns the interaction_id.
+
+Revert for creates: soft-delete the record.
+Revert for updates: write back the old values.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.save import Save
+from hermes.action_gateway.executors import (
+    ConflictError,
+    _normalize,
+    compute_record_hash,
+)
+
+logger = logging.getLogger(__name__)
+
+
+# CRM rows can have plenty of bookkeeping fields beyond the framework
+# defaults. Treat audit timestamps and tombstone columns as bookkeeping
+# so a row that's only had ``updated_at`` bumped doesn't fail revert.
+_CRM_HASH_EXCLUDE = frozenset({
+    "modified_time",
+    "modified_by",
+    "modified_user_id",
+    "last_activity_time",
+})
+
+
+def _hash_crm_row(table_name: str, pk_col: str, record_id: int, db: DbWrapper):
+    if db is None:
+        return None, None
+    row = db.fetchone(
+        f'SELECT * FROM "{table_name}" WHERE {pk_col} = %s',
+        (record_id,),
+    )
+    return row, compute_record_hash(row, exclude=_CRM_HASH_EXCLUDE)
+
+
+def _store_record_hash(action: Dict[str, Any], record_hash, db: DbWrapper) -> None:
+    aid = action.get("id")
+    if not aid or record_hash is None or db is None:
+        return
+    try:
+        db.execute(
+            "UPDATE gateway_actions SET record_hash = %s WHERE id = %s",
+            (str(record_hash), str(aid)),
+        )
+    except Exception:
+        logger.exception("crm_write_store_hash_failed action=%s", aid)
+
+
+def execute(action: Dict[str, Any], db: DbWrapper) -> Dict[str, Any]:
+    """Run a CRM write action.
+
+    ``action["params"]`` must contain:
+    - ``module_id``: int — the collection id
+    - ``op``: ``"create"`` or ``"update"``
+    - ``data``: dict — field values to write
+    - ``record_id``: int (required for update)
+
+    Returns ``{"revert_token": {...}}`` for undo support.
+    """
+    from hermes.action_gateway.eval_mode import is_eval_mode, dry_run_capture
+    if is_eval_mode():
+        return dry_run_capture("crm.write", action)
+    params = action.get("params") or {}
+    module_id = int(params["module_id"])
+    op = str(params.get("op", "create"))
+    data = dict(params.get("data") or {})
+    user_id = action.get("user_id")
+    record_id = params.get("record_id")
+
+    saver = Save(db).set_module(module_id)
+    if user_id:
+        saver.set_user(int(user_id), is_admin=False)
+    saver.set_source(f"agent:{action.get('profile_id', '')}:{action.get('agent_name', '')}")
+
+    if op == "create":
+        new_id = saver.insert(data)
+        table_name = saver.table_name
+        pk_col = f"{table_name}_id"
+        # Phase 4.2: capture content hash so revert can detect external mutation.
+        _row, content_hash = _hash_crm_row(table_name, pk_col, int(new_id), db)
+        _store_record_hash(action, content_hash, db)
+        return {
+            "revert_token": {
+                "op": "delete",
+                "table_name": table_name,
+                "pk_col": pk_col,
+                "record_id": new_id,
+            },
+        }
+
+    if op == "update":
+        if not record_id:
+            raise ValueError("record_id required for update")
+        rid = int(record_id)
+        saver.set_record_id(rid)
+
+        # Snapshot old values for revert
+        table_name = saver.table_name
+        pk_col = f"{table_name}_id"
+        old_row = db.fetchone(
+            f'SELECT * FROM "{table_name}" WHERE {pk_col} = %s',
+            (rid,),
+        )
+        # Normalize through _normalize so revert_token stays JSON-pure —
+        # NUMERIC → Decimal, TIMESTAMPTZ → datetime, UUID → UUID would
+        # otherwise blow up _json_or_null when the gateway txn tries to
+        # persist the revert_token, rolling back the whole write.
+        old_values = {
+            k: _normalize(old_row[k]) for k in data if k in (old_row or {})
+        }
+
+        # Charter §A2 — soft warning: did another specialist commit a
+        # write to this record between this action's begin and now?
+        # Don't auto-abort — just emit an interaction so the agent's
+        # next prompt sees the diff and can decide.
+        _soft_warn_concurrent_writes(
+            action=action,
+            module=str(module_id),
+            record_id=rid,
+            db=db,
+        )
+
+        saver.update(data)
+        # Phase 4.2: hash the post-update row so revert can detect that
+        # someone else clobbered our values before we got back here.
+        _row, content_hash = _hash_crm_row(table_name, pk_col, rid, db)
+        _store_record_hash(action, content_hash, db)
+        return {
+            "revert_token": {
+                "op": "restore",
+                "table_name": table_name,
+                "pk_col": pk_col,
+                "record_id": rid,
+                "old_values": old_values,
+            },
+        }
+
+    if op == "delete":
+        if not record_id:
+            raise ValueError("record_id required for delete")
+        rid = int(record_id)
+        table_name = saver.table_name
+        pk_col = f"{table_name}_id"
+        # ItemDelete runs the same RBAC + business-rule checks as the SPA
+        # delete route and soft-deletes (deleted = TRUE), so the row is
+        # preserved and revert is a simple un-delete.
+        from hermes.crm.item_delete import ItemDelete
+
+        ItemDelete(db).set_source(
+            f"agent:{action.get('profile_id', '')}:{action.get('agent_name', '')}"
+        ).set_params(
+            module_id=module_id,
+            record_id=rid,
+            user_id=int(user_id) if user_id else 0,
+        ).execute()
+        return {
+            "revert_token": {
+                "op": "restore_delete",
+                "table_name": table_name,
+                "pk_col": pk_col,
+                "record_id": rid,
+            },
+        }
+
+    raise ValueError(f"unsupported CRM write op: {op}")
+
+
+def _soft_warn_concurrent_writes(
+    *, action: Dict[str, Any], module: str, record_id: int, db: DbWrapper,
+) -> None:
+    """Charter §A2 soft-warning tier.
+
+    Look up this action's ``record_write_token`` from gateway_actions
+    and call :func:`writes_since` to find committed writes by *other*
+    specialists that landed after this token's begin. If any are found,
+    log a warning + emit an interaction event so the agent's next
+    prompt can re-evaluate before issuing its next action.
+    """
+    action_id = action.get("id")
+    if not action_id:
+        return
+    try:
+        row = db.fetchone(
+            "SELECT record_write_token FROM gateway_actions WHERE id = %s",
+            (str(action_id),),
+        )
+    except Exception:
+        logger.exception("crm_write_soft_warn_fetch_token_failed action=%s", action_id)
+        return
+    if not row or row.get("record_write_token") is None:
+        return
+    token = int(row["record_write_token"])
+    try:
+        from hermes.action_gateway.record_state import writes_since
+        rows = writes_since(
+            module=module, record_id=record_id, since_token=token,
+        )
+    except Exception:
+        logger.exception(
+            "crm_write_soft_warn_writes_since_failed action=%s token=%s",
+            action_id, token,
+        )
+        return
+    if not rows:
+        return
+    logger.warning(
+        "crm_write_concurrent_writes_detected action=%s module=%s "
+        "record_id=%s others=%d",
+        action_id, module, record_id, len(rows),
+    )
+    try:
+        from hermes_cloud.app.interactions import emit as emit_interaction
+        emit_interaction(
+            kind="record_state_concurrent_write",
+            subjects=[{"type": "crm_record", "module": module, "id": record_id}],
+            actors=[{"type": "agent", "name": str(action.get("agent_name") or "")}],
+            content={
+                "action_id": str(action_id),
+                "module": module,
+                "record_id": record_id,
+                "others": rows[:10],
+                "message": (
+                    "another specialist modified this record between "
+                    "snapshot and commit"
+                ),
+            },
+            source="gateway:record_state",
+            db=db,
+        )
+    except Exception:
+        logger.exception(
+            "crm_write_soft_warn_emit_failed action=%s", action_id,
+        )
+
+
+def revert(
+    token: Dict[str, Any],
+    db: DbWrapper,
+    *,
+    stored_hash: Any = None,
+    force: bool = False,
+) -> None:
+    """Undo a CRM write using the stored revert token.
+
+    Phase 4.2: if ``stored_hash`` is provided (non-NULL), recompute the
+    live row's hash and refuse with :class:`ConflictError` if it
+    differs. ``force=True`` bypasses the guard. Legacy NULL hashes
+    skip the guard for back-compat.
+    """
+    from hermes.action_gateway.eval_mode import is_eval_noop_token
+    if is_eval_noop_token(token):
+        return
+    op = token.get("op")
+    table_name = token["table_name"]
+    pk_col = token["pk_col"]
+    record_id = int(token["record_id"])
+
+    # Phase 4.2 conflict guard.
+    if stored_hash and not force:
+        _row, live_hash = _hash_crm_row(table_name, pk_col, record_id, db)
+        if live_hash != stored_hash:
+            raise ConflictError(
+                entity=table_name,
+                stored_hash=str(stored_hash),
+                live_hash=str(live_hash) if live_hash else None,
+                record_id=record_id,
+            )
+
+    if op == "delete":
+        # Soft-delete a created record
+        db.execute(
+            f'UPDATE "{table_name}" SET deleted = TRUE WHERE {pk_col} = %s',
+            (record_id,),
+        )
+    elif op == "restore":
+        # Restore old field values for an updated record
+        old_values = token.get("old_values") or {}
+        if old_values:
+            cols = list(old_values.keys())
+            set_sql = ", ".join(f'"{c}" = %s' for c in cols)
+            db.execute(
+                f'UPDATE "{table_name}" SET {set_sql} WHERE {pk_col} = %s',
+                tuple(old_values[c] for c in cols) + (record_id,),
+            )
+    elif op == "restore_delete":
+        # Un-delete a soft-deleted record
+        db.execute(
+            f'UPDATE "{table_name}" SET deleted = FALSE WHERE {pk_col} = %s',
+            (record_id,),
+        )
+    else:
+        logger.warning("unknown revert op=%s for action on %s", op, table_name)
+
+
+# Attach revert to the execute function so the dispatcher can find it
+execute.revert = revert  # type: ignore[attr-defined]
diff --git a/action_gateway/executors/email_send.py b/action_gateway/executors/email_send.py
new file mode 100644
index 0000000000..b39c1d86e2
--- /dev/null
+++ b/action_gateway/executors/email_send.py
@@ -0,0 +1,137 @@
+"""Email send executor — ``kind='email.send'``.
+
+Sends an email via SMTP on behalf of an Agent. The Action Gateway
+records a revert_token containing the Message-ID so the email can
+be recalled (if the mail server supports RECALL/UNDO) or at minimum
+flagged in the audit trail.
+
+Phase 2 implementation: sends via :mod:`smtplib` using env-configured
+SMTP credentials. If no SMTP is configured, the executor raises so the
+gateway transitions the action to ``failed``.
+
+Environment variables:
+- ``HERMES_SMTP_HOST``: SMTP server hostname (required)
+- ``HERMES_SMTP_PORT``: SMTP port (default 587)
+- ``HERMES_SMTP_USER``: SMTP username
+- ``HERMES_SMTP_PASS``: SMTP password
+- ``HERMES_SMTP_FROM``: Default sender address
+- ``HERMES_SMTP_TLS``: ``"true"`` to use STARTTLS (default true)
+"""
+from __future__ import annotations
+
+import email.message
+import logging
+import os
+import smtplib
+from typing import Any, Dict
+
+logger = logging.getLogger(__name__)
+
+
+def _get_smtp_config() -> Dict[str, Any]:
+    """Read SMTP config from environment."""
+    host = os.environ.get("HERMES_SMTP_HOST", "")
+    if not host:
+        raise RuntimeError(
+            "email.send executor requires HERMES_SMTP_HOST — "
+            "SMTP not configured"
+        )
+    return {
+        "host": host,
+        "port": int(os.environ.get("HERMES_SMTP_PORT", "587")),
+        "user": os.environ.get("HERMES_SMTP_USER", ""),
+        "password": os.environ.get("HERMES_SMTP_PASS", ""),
+        "from_addr": os.environ.get("HERMES_SMTP_FROM", ""),
+        "use_tls": os.environ.get("HERMES_SMTP_TLS", "true").lower() == "true",
+    }
+
+
+def execute(action: Dict[str, Any], db: Any) -> Dict[str, Any]:
+    """Send an email.
+
+    ``action["params"]`` must contain:
+    - ``to``: str or list[str] — recipient address(es)
+    - ``subject``: str — email subject
+    - ``body``: str — email body (plain text)
+    - ``html``: str (optional) — HTML body
+
+    Returns ``{"revert_token": {"message_id": ..., "to": ...}}``.
+    """
+    from hermes.action_gateway.eval_mode import is_eval_mode, dry_run_capture
+    if is_eval_mode():
+        return dry_run_capture("email.send", action)
+    params = action.get("params") or {}
+    to = params.get("to")
+    subject = params.get("subject", "")
+    body = params.get("body", "")
+    html = params.get("html")
+
+    if not to:
+        raise ValueError("email.send: 'to' is required")
+    if not subject:
+        raise ValueError("email.send: 'subject' is required")
+
+    # Normalize recipients
+    recipients = [to] if isinstance(to, str) else list(to)
+
+    config = _get_smtp_config()
+
+    # Build message
+    msg = email.message.EmailMessage()
+    msg["From"] = config["from_addr"] or config["user"]
+    msg["To"] = ", ".join(recipients)
+    msg["Subject"] = subject
+
+    if html:
+        msg.set_content(body)
+        msg.add_alternative(html, subtype="html")
+    else:
+        msg.set_content(body)
+
+    # Send
+    smtp_cls = smtplib.SMTP
+    with smtp_cls(config["host"], config["port"], timeout=30) as server:
+        if config["use_tls"]:
+            server.starttls()
+        if config["user"] and config["password"]:
+            server.login(config["user"], config["password"])
+        server.send_message(msg)
+        message_id = msg["Message-ID"] or ""
+
+    logger.info(
+        "email_send to=%s subject=%r message_id=%s",
+        recipients, subject, message_id,
+    )
+
+    return {
+        "revert_token": {
+            "op": "email_recall",
+            "message_id": message_id,
+            "to": recipients,
+            "subject": subject,
+        },
+    }
+
+
+def revert(token: Dict[str, Any], db: Any, **_: Any) -> None:
+    """Attempt to recall/flag a sent email.
+
+    Most SMTP servers don't support true recall, so this logs the
+    recall attempt for audit purposes. A future integration with
+    Exchange/Gmail API could support actual recall.
+    """
+    from hermes.action_gateway.eval_mode import is_eval_noop_token
+    if is_eval_noop_token(token):
+        return
+    message_id = token.get("message_id", "")
+    recipients = token.get("to", [])
+    logger.warning(
+        "email_recall requested: message_id=%s to=%s — "
+        "SMTP does not support recall; flagged in audit trail",
+        message_id,
+        recipients,
+    )
+
+
+# Attach revert to the execute function
+execute.revert = revert  # type: ignore[attr-defined]
diff --git a/action_gateway/executors/lead_convert.py b/action_gateway/executors/lead_convert.py
new file mode 100644
index 0000000000..3d950f5afa
--- /dev/null
+++ b/action_gateway/executors/lead_convert.py
@@ -0,0 +1,208 @@
+"""lead.convert executor — 把一条 lead 转化成 account + contact + potential。
+
+``params`` 形状:
+- ``lead_id`` (int, required)
+- ``potential_name`` / ``potential_amount`` / ``potential_milestone``
+  / ``potential_closing_date`` (可选)
+
+executor 在 dispatcher 的事务内运行 —— 任一步抛异常,全部写入回滚。
+revert:软删 3 条新建记录 + 还原 lead 的转化字段。
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.save import Save
+from hermes.crm.models.modules_db import ModulesDb
+from hermes.action_gateway.executors import ConflictError, compute_record_hash
+
+logger = logging.getLogger(__name__)
+
+
+# 与 crm_write.py 一致:审计型 bookkeeping 列在 execute→revert 之间会变,
+# 不应触发 revert 的内容冲突。
+_CRM_HASH_EXCLUDE = frozenset({
+    "modified_time",
+    "modified_by",
+    "modified_user_id",
+    "last_activity_time",
+})
+
+
+def _hash_account(account_id: int, db: DbWrapper):
+    if db is None:
+        return None, None
+    row = db.fetchone(
+        "SELECT * FROM accounts WHERE accounts_id = %s", (int(account_id),))
+    return row, compute_record_hash(row, exclude=_CRM_HASH_EXCLUDE)
+
+
+def _store_record_hash(action: Dict[str, Any], record_hash, db: DbWrapper) -> None:
+    aid = action.get("id")
+    if not aid or record_hash is None or db is None:
+        return
+    try:
+        db.execute(
+            "UPDATE gateway_actions SET record_hash = %s WHERE id = %s",
+            (str(record_hash), str(aid)),
+        )
+    except Exception:
+        logger.exception("lead_convert_store_hash_failed action=%s", aid)
+
+
+def execute(action: Dict[str, Any], db: DbWrapper) -> Dict[str, Any]:
+    """转化一条 lead;在 dispatcher 事务内运行,异常即整体回滚。"""
+    from hermes.action_gateway.eval_mode import is_eval_mode, dry_run_capture
+    if is_eval_mode():
+        return dry_run_capture("lead.convert", action)
+
+    params = action.get("params") or {}
+    lead_id = int(params["lead_id"])
+    user_id = action.get("user_id")
+    source = (
+        f"agent:{action.get('profile_id', '')}:{action.get('agent_name', '')}"
+    )
+
+    lead = db.fetchone(
+        "SELECT * FROM leads WHERE leads_id = %s "
+        "AND NOT COALESCE(deleted, FALSE)",
+        (lead_id,),
+    )
+    if not lead:
+        raise ValueError(f"lead.convert: lead {lead_id} not found")
+    if str(lead.get("convertedstatus") or "").lower() == "converted":
+        raise ValueError(f"lead.convert: lead {lead_id} already converted")
+
+    mods = ModulesDb(db)
+    acc_mod = int(mods.get_module_by_name("accounts")["id"])
+    con_mod = int(mods.get_module_by_name("contacts")["id"])
+    pot_mod = int(mods.get_module_by_name("potentials")["id"])
+
+    owner = lead.get("owner_by")
+    lead_name = lead.get("leads_name") or ""
+
+    def _saver(module_id: int) -> Save:
+        s = Save(db).set_module(module_id)
+        if user_id:
+            s.set_user(int(user_id), is_admin=False)
+        s.set_source(source)
+        return s
+
+    # 1. account
+    account_id = _saver(acc_mod).insert({
+        "accounts_name": lead_name,
+        "mobile": lead.get("mobile"),
+        "email": lead.get("email"),
+        "description": lead.get("remarks"),
+        "owner_by": owner,
+        "leads_id": lead_id,
+    })
+
+    # 2. contact —— 联系人名缺省退回 lead 名
+    contact_id = _saver(con_mod).insert({
+        "contacts_name": lead.get("contact") or lead_name,
+        "mobile": lead.get("mobile"),
+        "phone": lead.get("phone"),
+        "email": lead.get("email"),
+        "accounts_id": account_id,
+        "is_main": True,
+        "owner_by": owner,
+    })
+
+    # 3. potential —— deal 字段可选
+    pot_data: Dict[str, Any] = {
+        "potentials_name": params.get("potential_name") or f"{lead_name} 商机",
+        "accounts_id": account_id,
+        "contacts_id": contact_id,
+        "owner_by": owner,
+    }
+    if params.get("potential_amount") is not None:
+        pot_data["amount"] = params["potential_amount"]
+    if params.get("potential_milestone"):
+        pot_data["milestone"] = params["potential_milestone"]
+    if params.get("potential_closing_date"):
+        pot_data["closingdate"] = params["potential_closing_date"]
+    potential_id = _saver(pot_mod).insert(pot_data)
+
+    # 4. 翻转 lead 转化状态
+    db.execute(
+        "UPDATE leads SET convertedstatus = 'converted', "
+        "convertedby = %s, converteddate = NOW() WHERE leads_id = %s",
+        (user_id, lead_id),
+    )
+
+    _row, content_hash = _hash_account(int(account_id), db)
+    _store_record_hash(action, content_hash, db)
+
+    return {
+        "revert_token": {
+            "op": "lead_convert",
+            "account_id": int(account_id),
+            "contact_id": int(contact_id),
+            "potential_id": int(potential_id),
+            "lead_id": lead_id,
+            "prior_convertedstatus": lead.get("convertedstatus"),
+            "prior_convertedby": lead.get("convertedby"),
+            "prior_converteddate": lead.get("converteddate"),
+        },
+    }
+
+
+def revert(
+    token: Dict[str, Any],
+    db: DbWrapper,
+    *,
+    stored_hash: Any = None,
+    force: bool = False,
+) -> None:
+    """撤销转化:软删 account/contact/potential,还原 lead 转化字段。
+
+    冲突保护:以 account 为锚 —— 若 account 在转化后被实质改动,
+    抛 :class:`ConflictError`,dispatcher 把动作停在 ``state='conflict'``。
+    """
+    from hermes.action_gateway.eval_mode import is_eval_noop_token
+    if is_eval_noop_token(token):
+        return
+    if token.get("op") != "lead_convert":
+        return
+
+    account_id = int(token["account_id"])
+    contact_id = int(token["contact_id"])
+    potential_id = int(token["potential_id"])
+    lead_id = int(token["lead_id"])
+
+    if stored_hash and not force:
+        _row, live_hash = _hash_account(account_id, db)
+        if live_hash != stored_hash:
+            raise ConflictError(
+                entity="accounts",
+                stored_hash=str(stored_hash),
+                live_hash=str(live_hash) if live_hash else None,
+                record_id=account_id,
+            )
+
+    db.execute(
+        "UPDATE accounts SET deleted = TRUE, leads_id = NULL "
+        "WHERE accounts_id = %s",
+        (account_id,))
+    db.execute(
+        "UPDATE contacts SET deleted = TRUE WHERE contacts_id = %s",
+        (contact_id,))
+    db.execute(
+        "UPDATE potentials SET deleted = TRUE WHERE potentials_id = %s",
+        (potential_id,))
+    db.execute(
+        "UPDATE leads SET convertedstatus = %s, convertedby = %s, "
+        "converteddate = %s WHERE leads_id = %s",
+        (
+            token.get("prior_convertedstatus"),
+            token.get("prior_convertedby"),
+            token.get("prior_converteddate"),
+            lead_id,
+        ),
+    )
+
+
+execute.revert = revert  # type: ignore[attr-defined]
diff --git a/action_gateway/executors/memory_write.py b/action_gateway/executors/memory_write.py
new file mode 100644
index 0000000000..d5e7678571
--- /dev/null
+++ b/action_gateway/executors/memory_write.py
@@ -0,0 +1,211 @@
+"""Memory write executor — ``kind='memory.write'``.
+
+Phase 4.0b: route specialist memory writes (research, intake, …) through
+the gateway so each landed memory row gets:
+
+- a ``gateway_actions`` audit row (who wrote what, when, attached to a
+  draft + executing_specialist),
+- a ``revert_token`` enabling Phase 4.2 inverse-op (delete the memory),
+- the same trust / compliance guards every other side-effect goes through.
+
+``params`` shape (mirror :func:`hermes.memory.upsert_memory`):
+
+- ``content`` (str, required)
+- ``title`` (str)
+- ``kind`` (str — fact / summary / preference; default ``"fact"``)
+- ``scope`` (str — user / org; default ``"user"``)
+- ``user_id`` (int, optional)
+- ``source_agent`` (str — specialist name; required for per-agent quota)
+- ``meta`` (dict, optional)
+
+Returns ``{"revert_token": {"memory_id": <id>}}`` so :func:`revert` can
+delete the row. Soft-cap / dedupe outcomes (no row created) record a
+``noop`` revert_token — revert becomes a no-op.
+"""
+from __future__ import annotations
+
+import ast
+import json
+import logging
+from typing import Any, Dict
+
+from hermes.crm.db import DbWrapper
+from hermes.memory import upsert_memory, delete_memory
+from hermes.memory.entities import link_memory_to_entity
+from hermes.action_gateway.executors import (
+    ConflictError,
+    compute_record_hash,
+)
+
+logger = logging.getLogger(__name__)
+
+
+# Memory bookkeeping beyond framework defaults: ``embedding`` is large
+# and may be re-embedded asynchronously; ``confidence`` may be re-tuned
+# by background scoring; ``expires_at`` by TTL sweeps. None of those
+# should trip a revert conflict.
+_MEMORY_HASH_EXCLUDE = frozenset({
+    "embedding",
+    "confidence",
+    "expires_at",
+})
+
+
+def _hash_memory_row(memory_id: int, db: DbWrapper):
+    if db is None:
+        return None, None
+    row = db.fetchone(
+        "SELECT id, user_id, agent_id, scope, kind, title, content, "
+        "source_refs, meta, created_at, updated_at, expires_at "
+        "FROM memories WHERE id = %s",
+        (int(memory_id),),
+    )
+    return row, compute_record_hash(row, exclude=_MEMORY_HASH_EXCLUDE)
+
+
+def _store_record_hash(action: Dict[str, Any], record_hash, db: DbWrapper) -> None:
+    aid = action.get("id")
+    if not aid or record_hash is None or db is None:
+        return
+    try:
+        db.execute(
+            "UPDATE gateway_actions SET record_hash = %s WHERE id = %s",
+            (str(record_hash), str(aid)),
+        )
+    except Exception:
+        logger.exception("memory_write_store_hash_failed action=%s", aid)
+
+
+def _is_serialized_payload(content: str) -> bool:
+    """True if ``content`` is a serialized object rather than a prose fact.
+
+    A distilled memory fact is always human-readable prose. Content that
+    deserializes to a dict/list — JSON or a Python ``repr`` — is an
+    agent-run object dumped by mistake (e.g. a research agent passing its
+    whole ``{'final_response': ..., 'messages': [...]}`` conversation
+    result) and must be rejected at the gateway boundary so it never
+    reaches the customer-facing "facts" surface.
+    """
+    s = (content or "").strip()
+    if not s or s[0] not in "{[":
+        return False
+    for parser in (json.loads, ast.literal_eval):
+        try:
+            parsed = parser(s)
+        except (ValueError, SyntaxError):
+            continue
+        if isinstance(parsed, (dict, list)):
+            return True
+    return False
+
+
+def execute(action: Dict[str, Any], db: DbWrapper) -> Dict[str, Any]:
+    """Run a memory.write through :func:`upsert_memory`."""
+    params = action.get("params") or {}
+    content = str(params.get("content") or "").strip()
+    if not content:
+        raise ValueError("memory.write: 'content' is required")
+    if _is_serialized_payload(content):
+        raise ValueError(
+            "memory.write: 'content' is a serialized object, not a distilled "
+            "fact — pass the final prose answer, not the raw agent-run payload."
+        )
+
+    user_id = params.get("user_id")
+    raw_meta = params.get("meta") or {}
+    meta = dict(raw_meta) if isinstance(raw_meta, dict) else {}
+    # Ensure the gateway action id round-trips into memory.meta so an
+    # operator can correlate ``memories.id`` ↔ ``gateway_actions.id``.
+    if action.get("id"):
+        meta.setdefault("gateway_action_id", str(action["id"]))
+
+    result = upsert_memory(
+        content=content,
+        kind=str(params.get("kind") or "fact"),
+        scope=str(params.get("scope") or ("user" if user_id else "org")),
+        user_id=int(user_id) if user_id else None,
+        title=str(params.get("title") or "") or None,
+        source_agent=str(params.get("source_agent") or "") or None,
+        meta=meta,
+        db=db,
+    )
+
+    # Optional entity link — the dispatch layer resolves a CRM record's
+    # memory_entity_id and passes it so the new fact surfaces on that
+    # customer's detail-page memory panel. Linking shares this executor's
+    # transaction with the INSERT, so a link failure rolls back the whole
+    # write (atomic). On dedupe we still link the pre-existing memory —
+    # one fact can legitimately support multiple entities.
+    link_entity_id = params.get("link_entity_id")
+    link_role = str(params.get("link_role") or "subject")
+
+    def _maybe_link(memory_id: Any) -> None:
+        if link_entity_id and memory_id:
+            link_memory_to_entity(
+                entity_id=int(link_entity_id),
+                memory_id=int(memory_id),
+                role=link_role,
+                db=db,
+            )
+
+    if not result.committed:
+        # Soft-cap or dedupe — nothing inserted. Dedupe still links the
+        # existing row; soft-cap has no memory_id so _maybe_link is a noop.
+        if result.reason == "dedupe":
+            _maybe_link(result.memory_id)
+        return {
+            "revert_token": {
+                "op": "noop",
+                "reason": result.reason,
+                "memory_id": result.memory_id,
+            },
+        }
+    # Phase 4.2: capture content hash for revert conflict guard.
+    _maybe_link(result.memory_id)
+    _row, content_hash = _hash_memory_row(int(result.memory_id), db)
+    _store_record_hash(action, content_hash, db)
+    return {
+        "revert_token": {
+            "op": "delete",
+            "memory_id": int(result.memory_id),
+        },
+    }
+
+
+def revert(
+    token: Dict[str, Any],
+    db: DbWrapper,
+    *,
+    stored_hash: Any = None,
+    force: bool = False,
+) -> None:
+    """Undo a memory.write by deleting the inserted memory row.
+
+    Phase 4.2: refuses with :class:`ConflictError` if the live row's
+    content hash differs from ``stored_hash`` (legacy NULL skips the
+    guard). ``force=True`` bypasses.
+    """
+    op = token.get("op")
+    memory_id = token.get("memory_id")
+    if op != "delete" or not memory_id:
+        # noop tokens (soft-cap / dedupe) — nothing landed, nothing to undo.
+        return
+
+    if stored_hash and not force:
+        _row, live_hash = _hash_memory_row(int(memory_id), db)
+        if live_hash != stored_hash:
+            raise ConflictError(
+                entity="memories",
+                stored_hash=str(stored_hash),
+                live_hash=str(live_hash) if live_hash else None,
+                record_id=int(memory_id),
+            )
+
+    try:
+        delete_memory(int(memory_id), db=db)
+    except Exception:
+        logger.exception("memory_write_revert_failed memory_id=%s", memory_id)
+
+
+# Attach revert to the execute function so the dispatcher can find it
+execute.revert = revert  # type: ignore[attr-defined]
diff --git a/action_gateway/executors/task_create.py b/action_gateway/executors/task_create.py
new file mode 100644
index 0000000000..c4d55fb9f2
--- /dev/null
+++ b/action_gateway/executors/task_create.py
@@ -0,0 +1,161 @@
+"""task.create executor — Phase 4.0c.
+
+Specialists (coach today, others later) emit follow-up tasks via
+``proposed_actions=[{"kind": "task.create", ...}]``. This executor
+materializes them in ``agent_tasks`` and registers a soft-delete
+revert_token so :func:`gateway.dispatcher.revert` can undo.
+
+``params`` shape:
+
+- ``title`` (str, required)
+- ``description`` (str, optional)
+- ``due_at`` (str, ISO-8601 timestamp; optional)
+- ``owner_user_id`` (int, optional)
+- ``related_module`` (str, optional)
+- ``related_record_id`` (int, optional)
+- ``source_agent`` (str, optional — specialist name)
+- ``meta`` (dict, optional)
+
+Returns ``{"revert_token": {"op": "soft_delete", "task_id": <id>}}``.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict
+
+from hermes.crm.db import DbWrapper
+from hermes.action_gateway.executors import (
+    ConflictError,
+    compute_record_hash,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def create_task(*args, **kwargs):
+    """Lazy adapter — hermes/* must not import hermes_cloud/* at module load."""
+    from hermes_cloud.app.tasks import create_task as _impl
+    return _impl(*args, **kwargs)
+
+
+def cancel_task(*args, **kwargs):
+    """Lazy adapter — hermes/* must not import hermes_cloud/* at module load."""
+    from hermes_cloud.app.tasks import cancel_task as _impl
+    return _impl(*args, **kwargs)
+
+
+# Task bookkeeping beyond framework defaults: ``status`` flips on
+# mark-done — a legitimate user action that shouldn't fail revert.
+_TASK_HASH_EXCLUDE = frozenset({
+    "status",
+})
+
+
+def _hash_task_row(task_id: int, db: DbWrapper):
+    if db is None:
+        return None, None
+    row = db.fetchone(
+        "SELECT * FROM tasks WHERE tasks_id = %s",
+        (int(task_id),),
+    )
+    return row, compute_record_hash(row, exclude=_TASK_HASH_EXCLUDE)
+
+
+def _store_record_hash(action: Dict[str, Any], record_hash, db: DbWrapper) -> None:
+    aid = action.get("id")
+    if not aid or record_hash is None or db is None:
+        return
+    try:
+        db.execute(
+            "UPDATE gateway_actions SET record_hash = %s WHERE id = %s",
+            (str(record_hash), str(aid)),
+        )
+    except Exception:
+        logger.exception("task_create_store_hash_failed action=%s", aid)
+
+
+def execute(action: Dict[str, Any], db: DbWrapper) -> Dict[str, Any]:
+    """Run a task.create through :func:`create_task`."""
+    from hermes.action_gateway.eval_mode import is_eval_mode, dry_run_capture
+    if is_eval_mode():
+        return dry_run_capture("task.create", action)
+    params = action.get("params") or {}
+    title = str(params.get("title") or "").strip()
+    if not title:
+        raise ValueError("task.create: 'title' is required")
+
+    profile_id = str(action.get("profile_id") or params.get("profile_id") or "")
+    if not profile_id:
+        raise ValueError("task.create: 'profile_id' is required")
+
+    raw_meta = params.get("meta") or {}
+    meta = dict(raw_meta) if isinstance(raw_meta, dict) else {}
+    if action.get("id"):
+        meta.setdefault("gateway_action_id", str(action["id"]))
+
+    task_id = create_task(
+        profile_id=profile_id,
+        title=title,
+        owner_user_id=params.get("owner_user_id") or action.get("user_id"),
+        description=str(params.get("description") or "") or None,
+        due_at=str(params.get("due_at") or "") or None,
+        related_module=str(params.get("related_module") or "") or None,
+        related_record_id=params.get("related_record_id"),
+        source_agent=str(
+            params.get("source_agent") or action.get("agent_name") or ""
+        ) or None,
+        source_draft_id=action.get("draft_id"),
+        gateway_action_id=str(action["id"]) if action.get("id") else None,
+        meta=meta,
+        db=db,
+    )
+
+    # Phase 4.2: capture content hash so revert can detect mutation.
+    _row, content_hash = _hash_task_row(int(task_id), db)
+    _store_record_hash({"id": action.get("id")}, content_hash, db)
+    return {
+        "revert_token": {
+            "op": "soft_delete",
+            "task_id": int(task_id),
+        },
+    }
+
+
+def revert(
+    token: Dict[str, Any],
+    db: DbWrapper,
+    *,
+    stored_hash: Any = None,
+    force: bool = False,
+) -> None:
+    """Undo a task.create by soft-deleting the row.
+
+    Phase 4.2: refuses with :class:`ConflictError` if the live row's
+    content hash differs from ``stored_hash`` (NULL skips the guard).
+    ``force=True`` bypasses.
+    """
+    from hermes.action_gateway.eval_mode import is_eval_noop_token
+    if is_eval_noop_token(token):
+        return
+    op = token.get("op")
+    task_id = token.get("task_id")
+    if op != "soft_delete" or not task_id:
+        return
+
+    if stored_hash and not force:
+        _row, live_hash = _hash_task_row(int(task_id), db)
+        if live_hash != stored_hash:
+            raise ConflictError(
+                entity="tasks",
+                stored_hash=str(stored_hash),
+                live_hash=str(live_hash) if live_hash else None,
+                record_id=int(task_id),
+            )
+
+    try:
+        cancel_task(int(task_id), db=db)
+    except Exception:
+        logger.exception("task_create_revert_failed task_id=%s", task_id)
+
+
+execute.revert = revert  # type: ignore[attr-defined]
diff --git a/action_gateway/im_push.py b/action_gateway/im_push.py
new file mode 100644
index 0000000000..a71af9e01c
--- /dev/null
+++ b/action_gateway/im_push.py
@@ -0,0 +1,153 @@
+"""Push auto-executed action results back to the originating IM channel.
+
+Phase 4.3 — sales are mobile-first (WeChat / Feishu on phones, not the
+dashboard). When a specialist auto-executes a gateway action, the
+dashboard chat path renders a markdown reply via
+:func:`hermes_cloud.app.main._render_specialist_markdown`, but an IM
+channel never sees that — the reply only goes back to whoever called
+``/v1/chat/completions``. This module is the IM equivalent: after a
+specialist invocation completes with an auto-executed action AND the
+origin was an IM channel, we render a plain-text version of the result
+and POST it back through :func:`channel_reply.reply_via_origin`.
+
+The text body intentionally mirrors the dashboard markdown content but
+strips markdown decorations (** bold, leading bullets) so it reads
+cleanly in plain-text-only IM clients (notably WeChat). Each line is at
+most ~80 chars so it doesn't wrap awkwardly on phone screens.
+
+Best-effort: any exception is logged and swallowed — a flaky channel
+adapter must never abort the calling specialist's response (the action
+already executed; the IM push is a courtesy回弹).
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _short(action_id: Any) -> str:
+    s = str(action_id or "")
+    return s[:8] if s else ""
+
+
+def render_auto_execute_text(
+    agent_name: str, result: Dict[str, Any],
+) -> Optional[str]:
+    """Build the IM-friendly text body for an auto-executed result.
+
+    Returns ``None`` when the result has no executed action — the
+    caller should skip the push in that case (no point sending an IM
+    that says nothing useful happened).
+
+    Mirrors the dashboard markdown structure but is markdown-free.
+    """
+    lines: List[str] = []
+
+    # Single-action path (Phase 4.0a — intake → crm.write).
+    action_state = result.get("action_state")
+    action_id = result.get("action_id")
+    executed_module = result.get("executed_module")
+    executed_record_id = result.get("executed_record_id")
+    if action_state == "executed" and executed_record_id and executed_module:
+        short = _short(action_id)
+        lines.append(
+            f"✅ {agent_name} 已自动创建 {executed_module} #{executed_record_id}"
+        )
+        if short:
+            lines.append(f"—— 不对就回 \"撤销 {short}\"")
+
+    # Multi-action path (Phase 4.0b/c — research / coach).
+    executed_actions = result.get("executed_actions") or []
+    if isinstance(executed_actions, list) and executed_actions:
+        memory_count = 0
+        task_count = 0
+        short_ids: List[str] = []
+        errors: List[str] = []
+        for ea in executed_actions:
+            if not isinstance(ea, dict):
+                continue
+            kind = ea.get("kind") or ""
+            state = ea.get("action_state")
+            if state == "executed":
+                short = _short(ea.get("action_id"))
+                if short:
+                    short_ids.append(short)
+                if kind == "memory.write":
+                    memory_count += 1
+                elif kind == "task.create":
+                    task_count += 1
+            elif ea.get("action_blocked"):
+                errors.append(
+                    f"⛔ {ea.get('action_blocked_reason') or 'blocked'}"
+                )
+            elif ea.get("action_error"):
+                errors.append(f"⚠️ {ea.get('action_error')}")
+
+        if memory_count > 0:
+            lines.append(f"✅ {agent_name} 已写入 {memory_count} 条记忆")
+        if task_count > 0:
+            lines.append(f"✅ {agent_name} 已创建 {task_count} 个跟进任务")
+        for e in errors:
+            lines.append(e)
+        if short_ids:
+            lines.append(
+                "—— 不对就回 \"撤销 <id>\"，可选 id：" + " / ".join(short_ids)
+            )
+
+    if not lines:
+        return None
+    return "\n".join(lines)
+
+
+def push_auto_execute_result(
+    *,
+    agent_name: str,
+    result: Optional[Dict[str, Any]],
+    origin: Optional[Dict[str, Any]],
+    profile_id: str,
+) -> bool:
+    """Push the auto-execute summary back to the originating IM channel.
+
+    Skips silently when:
+
+    - ``origin`` is missing / not an IM channel (``webui`` is no-op —
+      dashboard already gets the markdown reply).
+    - ``result`` has no executed action to mention.
+
+    Returns True on successful push, False otherwise (or skip).
+    """
+    if not isinstance(result, dict) or not isinstance(origin, dict):
+        return False
+    channel = str(origin.get("channel") or "").strip()
+    if not channel or channel == "webui":
+        # Dashboard path — markdown renderer covers it. No push.
+        return False
+
+    text = render_auto_execute_text(agent_name, result)
+    if not text:
+        return False
+
+    try:
+        from hermes.action_gateway.channel_reply import reply_via_origin
+
+        return bool(
+            reply_via_origin(
+                origin=origin,
+                profile_id=str(profile_id or ""),
+                text=text,
+            )
+        )
+    except Exception:
+        logger.exception(
+            "im_push_failed agent=%s channel=%s profile=%s",
+            agent_name, channel, profile_id,
+        )
+        return False
+
+
+__all__ = [
+    "render_auto_execute_text",
+    "push_auto_execute_result",
+]
diff --git a/action_gateway/notifiers.py b/action_gateway/notifiers.py
new file mode 100644
index 0000000000..cb213e56fc
--- /dev/null
+++ b/action_gateway/notifiers.py
@@ -0,0 +1,122 @@
+"""Pending-approval notifier registry — Charter §1 渠道闭环.
+
+When :func:`hermes.action_gateway.dispatcher.submit` lands an action
+in ``pending_approval`` state, the dispatcher must reach back to the
+**originating channel** so the human there can approve or reject.
+That delivery is channel-specific (Feishu sends a card, WeCom posts a
+structured message, Discord/Slack post a button, etc.), so we hand
+each channel adapter its own slot:
+
+    notifiers.register("feishu", _send_feishu_card)
+
+The dispatcher calls :func:`notify_pending(action, origin)` after the
+write is durable. The action row is the freshly-committed
+``gateway_actions`` dict (same shape that ``dispatcher.submit`` returns);
+``origin`` is the JSONB payload — same one persisted in the row, passed
+through here so notifiers don't have to re-parse it.
+
+Design constraints
+------------------
+
+* **Best-effort only.** A notifier crash must not roll back or hide the
+  pending action. Errors are logged and swallowed; the operator still
+  sees the row in the WebUI pending list as a fallback.
+* **One notifier per channel.** Re-registering replaces the previous
+  callback. This is intentional: each channel has exactly one delivery
+  semantics.
+* **WebUI is no-op.** The WebUI pending table is pull-based (the SPA
+  polls ``/api/gateway/pending``); there is no push. Registering a
+  no-op makes the lookup uniform — every channel goes through the
+  registry, no special-casing in the dispatcher.
+* **Unknown channel logs and returns.** If a channel adapter forgets
+  to register itself (or the origin payload was malformed), we log a
+  warning so it's visible in ops but don't raise.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Callable, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+
+PendingNotifier = Callable[[Dict[str, Any], Dict[str, Any]], None]
+"""Signature: ``fn(action_row, origin) -> None``."""
+
+_notifiers: Dict[str, PendingNotifier] = {}
+
+
+def register(channel: str, fn: PendingNotifier) -> None:
+    """Register the pending-approval notifier for a channel.
+
+    ``channel`` matches ``origin.channel`` recorded by the dispatcher
+    (e.g. ``"feishu"``, ``"wecom_ilink"``, ``"discord"``, ``"webui"``).
+    Re-registering overwrites the previous slot — the channel module
+    is the single source of truth for its own delivery.
+    """
+    if not channel:
+        raise ValueError("channel must be non-empty")
+    if not callable(fn):
+        raise TypeError(f"notifier must be callable, got {type(fn)!r}")
+    _notifiers[channel] = fn
+
+
+def get(channel: str) -> Optional[PendingNotifier]:
+    """Return the registered notifier (or ``None``) — for tests."""
+    return _notifiers.get(channel)
+
+
+def channels() -> list[str]:
+    """Return the list of channels with a registered notifier."""
+    return sorted(_notifiers.keys())
+
+
+def _noop_webui_notifier(
+    action: Dict[str, Any],  # noqa: ARG001
+    origin: Dict[str, Any],  # noqa: ARG001
+) -> None:
+    """WebUI is pull-based — the SPA polls the pending list, no push."""
+    return None
+
+
+# Self-register the WebUI no-op at import time so the dispatcher never
+# has to special-case the absence of a notifier for the default channel.
+register("webui", _noop_webui_notifier)
+
+
+def notify_pending(action: Dict[str, Any], origin: Dict[str, Any]) -> None:
+    """Dispatch a pending-approval notification to the originating channel.
+
+    Best-effort: any exception inside the notifier is logged and
+    swallowed so a flaky channel adapter cannot prevent the action from
+    being recorded. Unknown / unregistered channels also return cleanly
+    after a warning.
+    """
+    channel = ""
+    if isinstance(origin, dict):
+        channel = str(origin.get("channel") or "")
+
+    fn = _notifiers.get(channel)
+    if fn is None:
+        logger.warning(
+            "notify_pending_no_notifier_for_channel channel=%r action_id=%s",
+            channel, action.get("id"),
+        )
+        return
+
+    try:
+        fn(action, origin)
+    except Exception:
+        logger.exception(
+            "notify_pending_failed channel=%s action_id=%s",
+            channel, action.get("id"),
+        )
+
+
+__all__ = [
+    "PendingNotifier",
+    "register",
+    "get",
+    "channels",
+    "notify_pending",
+]
diff --git a/action_gateway/record_state.py b/action_gateway/record_state.py
new file mode 100644
index 0000000000..af5756012c
--- /dev/null
+++ b/action_gateway/record_state.py
@@ -0,0 +1,207 @@
+"""Cross-agent CRM record state registry — Charter §A2.
+
+Two-tier write protection so concurrent specialists don't silently
+overwrite each other's work on the same CRM record:
+
+  (1) **Hard lock** — :func:`begin_write` raises
+      :class:`WriteCollisionError` if another agent has an open
+      (un-committed, un-rolled-back) write on the same
+      ``(module, record_id)``. Same agent re-acquiring is allowed —
+      the second token is independent (the agent may legitimately
+      retry / split work).
+  (2) **Soft warning** — :func:`writes_since` returns committed writes
+      by *other* agents that began after this token's ``began_at``.
+      Caller (the ``crm_write`` executor) logs / emits an interaction
+      so the agent's next prompt can re-evaluate.
+
+The token is just the ``record_writes.id`` — pass it back to
+:func:`commit_write` / :func:`rollback_write` / :func:`writes_since`.
+
+Engine resolution mirrors the existing pattern in
+:mod:`hermes_cloud.app.agents.delegate_edges` /
+:mod:`hermes_cloud.app.agents.toolset_builder`: callers may inject
+``engine`` for tests, otherwise a module-level singleton is built
+lazily and threadsafely from
+:func:`hermes.crm.db.resolve_crm_sa_url` +
+:func:`hermes_cloud.app.db.make_engine`.
+"""
+from __future__ import annotations
+
+import json
+import threading
+from typing import Any, Optional
+
+from sqlalchemy import text
+from sqlalchemy.engine import Engine
+
+
+# ---------------------------------------------------------------------------
+# Engine resolution
+# ---------------------------------------------------------------------------
+_engine: Optional[Engine] = None
+_engine_lock = threading.Lock()
+
+
+def _default_engine() -> Engine:
+    global _engine
+    if _engine is None:
+        with _engine_lock:
+            if _engine is None:
+                from hermes.crm.db import resolve_crm_sa_url
+                from hermes_cloud.app.db import make_engine
+
+                _engine = make_engine(resolve_crm_sa_url())
+    return _engine
+
+
+# ---------------------------------------------------------------------------
+# Errors
+# ---------------------------------------------------------------------------
+
+
+class WriteCollisionError(RuntimeError):
+    """Raised when :func:`begin_write` finds an open intent on the same
+    ``(module, record_id)`` held by a different agent.
+    """
+
+
+# ---------------------------------------------------------------------------
+# Public API
+# ---------------------------------------------------------------------------
+
+
+def begin_write(
+    *,
+    module: str,
+    record_id: int,
+    agent_name: str,
+    profile_id: str,
+    fields: Optional[dict[str, Any]] = None,
+    engine: Optional[Engine] = None,
+) -> int:
+    """Acquire a write intent. Returns a token (record_writes.id).
+
+    Raises :class:`WriteCollisionError` if any open intent exists for
+    the same ``(module, record_id)`` held by a different agent. Same
+    agent re-acquiring is allowed; the new token is independent.
+    """
+    eng = engine if engine is not None else _default_engine()
+    with eng.begin() as conn:
+        existing = conn.execute(
+            text(
+                "SELECT id, agent_name FROM record_writes "
+                "WHERE module = :m AND record_id = :r "
+                "AND committed_at IS NULL AND rolled_back_at IS NULL"
+            ),
+            {"m": module, "r": int(record_id)},
+        ).fetchall()
+        for row in existing:
+            if row.agent_name != agent_name:
+                raise WriteCollisionError(
+                    f"record {module}:{record_id} has open write by "
+                    f"{row.agent_name!r} (token={row.id}); "
+                    f"current agent={agent_name!r}"
+                )
+        result = conn.execute(
+            text(
+                "INSERT INTO record_writes "
+                "(module, record_id, agent_name, profile_id, fields) "
+                "VALUES (:m, :r, :a, :p, CAST(:f AS JSONB)) "
+                "RETURNING id"
+            ),
+            {
+                "m": module,
+                "r": int(record_id),
+                "a": agent_name,
+                "p": profile_id,
+                "f": json.dumps(fields or {}),
+            },
+        ).fetchone()
+    return int(result.id)
+
+
+def commit_write(token: int, *, engine: Optional[Engine] = None) -> None:
+    """Mark the intent as successfully committed. Idempotent."""
+    eng = engine if engine is not None else _default_engine()
+    with eng.begin() as conn:
+        conn.execute(
+            text(
+                "UPDATE record_writes SET committed_at = now() "
+                "WHERE id = :i AND committed_at IS NULL "
+                "AND rolled_back_at IS NULL"
+            ),
+            {"i": int(token)},
+        )
+
+
+def rollback_write(token: int, *, engine: Optional[Engine] = None) -> None:
+    """Mark the intent as rolled back. Idempotent."""
+    eng = engine if engine is not None else _default_engine()
+    with eng.begin() as conn:
+        conn.execute(
+            text(
+                "UPDATE record_writes SET rolled_back_at = now() "
+                "WHERE id = :i AND rolled_back_at IS NULL "
+                "AND committed_at IS NULL"
+            ),
+            {"i": int(token)},
+        )
+
+
+def writes_since(
+    *,
+    module: str,
+    record_id: int,
+    since_token: int,
+    engine: Optional[Engine] = None,
+) -> list[dict[str, Any]]:
+    """Return committed writes by *other* agents on
+    ``(module, record_id)`` that began after ``since_token``'s
+    ``began_at``. Empty list if the token is unknown.
+    """
+    eng = engine if engine is not None else _default_engine()
+    with eng.begin() as conn:
+        anchor = conn.execute(
+            text(
+                "SELECT began_at, agent_name FROM record_writes WHERE id = :i"
+            ),
+            {"i": int(since_token)},
+        ).fetchone()
+        if anchor is None:
+            return []
+        rows = conn.execute(
+            text(
+                "SELECT id, agent_name, began_at, committed_at, fields "
+                "FROM record_writes "
+                "WHERE module = :m AND record_id = :r "
+                "AND committed_at IS NOT NULL "
+                "AND began_at > :since "
+                "AND agent_name <> :self_agent "
+                "ORDER BY began_at"
+            ),
+            {
+                "m": module,
+                "r": int(record_id),
+                "since": anchor.began_at,
+                "self_agent": anchor.agent_name,
+            },
+        ).fetchall()
+    return [
+        {
+            "token": int(r.id),
+            "agent_name": r.agent_name,
+            "began_at": r.began_at.isoformat() if r.began_at else None,
+            "committed_at": r.committed_at.isoformat() if r.committed_at else None,
+            "fields": r.fields,
+        }
+        for r in rows
+    ]
+
+
+__all__ = [
+    "WriteCollisionError",
+    "begin_write",
+    "commit_write",
+    "rollback_write",
+    "writes_since",
+]
diff --git a/action_gateway/text_commands.py b/action_gateway/text_commands.py
new file mode 100644
index 0000000000..b3c3888bb2
--- /dev/null
+++ b/action_gateway/text_commands.py
@@ -0,0 +1,305 @@
+"""Text-command parser for channel-based gateway approvals AND reverts.
+
+Channels that can't render interactive buttons (notably WeChat via iLink
+— Charter §1 渠道闭环) deliver an approval prompt as plain text and ask
+the operator to reply with ``通过 <prefix>`` / ``拒绝 <prefix>`` (or the
+English aliases). Phase 4.3 extends this to executed-action revert
+commands so sales on WeChat / Feishu can undo an auto-executed write
+straight from chat:
+
+    撤销 <prefix>          -> dispatcher.revert(force=False)  -- conflict-guarded
+    强制撤销 <prefix>      -> dispatcher.revert(force=True)   -- bypass guard
+    改 <prefix> field=value-> stubbed (returns redirect message; Phase 4.4)
+
+This module turns those replies into the matching dispatcher call and
+returns a human-readable reply string for the bot to echo back. The
+prefix is the first 8 chars of the action UUID — short enough to type,
+plenty collision-resistant against the ≤dozen pending/executed actions
+a single user has open at once. Lookup walks the user's actions
+filtered by ``via_channel`` so a Feishu prefix can't accidentally
+revert from a wechat reply.
+"""
+from __future__ import annotations
+
+import logging
+import re
+from typing import Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.action_gateway import dispatcher
+
+logger = logging.getLogger(__name__)
+
+
+# Accept Chinese + English; tolerant of fullwidth spaces and an optional
+# leading "/" so "/approve abc12345" works for keyboard users.
+_APPROVE_RE = re.compile(
+    r"^\s*/?\s*(?:通过|同意|approve|✅)\s+([0-9a-fA-F-]{4,40})\s*$",
+)
+_REJECT_RE = re.compile(
+    r"^\s*/?\s*(?:拒绝|否决|reject|❌|🚫)\s+([0-9a-fA-F-]{4,40})\s*$",
+)
+# Phase 4.3 — revert / force-revert. ``强制撤销`` MUST be matched before
+# plain ``撤销`` because the latter is a substring.
+_FORCE_REVERT_RE = re.compile(
+    r"^\s*/?\s*(?:强制撤销|强撤|force[\s_-]?revert|force[\s_-]?undo)\s+"
+    r"([0-9a-fA-F-]{4,40})\s*$",
+    re.IGNORECASE,
+)
+_REVERT_RE = re.compile(
+    r"^\s*/?\s*(?:撤销|撤回|revert|undo|↩️)\s+([0-9a-fA-F-]{4,40})\s*$",
+    re.IGNORECASE,
+)
+# Phase 4.3 — edit stub. Match ``改 <prefix> field=value`` (or 修改/edit).
+# We don't actually parse the field=value pair yet — full edit support
+# is Phase 4.4. The handler replies with a redirect message.
+_EDIT_RE = re.compile(
+    r"^\s*/?\s*(?:改|修改|edit)\s+([0-9a-fA-F-]{4,40})\b.*$",
+    re.IGNORECASE,
+)
+
+
+def parse_command(text: str) -> Optional[tuple[str, str]]:
+    """Return ``(decision, prefix)`` if ``text`` is a gateway command,
+    else ``None``. ``decision`` is one of:
+
+    - ``"approve"``       — Phase 1
+    - ``"reject"``        — Phase 1
+    - ``"revert"``        — Phase 4.3
+    - ``"force_revert"``  — Phase 4.3
+    - ``"edit"``          — Phase 4.3 stub (returns redirect message)
+    """
+    if not isinstance(text, str):
+        return None
+    s = text.replace("　", " ").strip()  # normalize fullwidth space
+    m = _APPROVE_RE.match(s)
+    if m:
+        return ("approve", m.group(1).lower())
+    m = _REJECT_RE.match(s)
+    if m:
+        return ("reject", m.group(1).lower())
+    # Order matters: 强制撤销 contains 撤销 as substring, so check force first.
+    m = _FORCE_REVERT_RE.match(s)
+    if m:
+        return ("force_revert", m.group(1).lower())
+    m = _REVERT_RE.match(s)
+    if m:
+        return ("revert", m.group(1).lower())
+    m = _EDIT_RE.match(s)
+    if m:
+        return ("edit", m.group(1).lower())
+    return None
+
+
+def _resolve_pending_action_id(
+    db: DbWrapper, *, prefix: str, via_channel: str, user_id: int,
+) -> Optional[str]:
+    """Find a *pending* action whose UUID starts with ``prefix`` and
+    whose origin matches ``via_channel``. Returns ``"__ambiguous__"``
+    when ≥2 rows match, ``None`` for no match, otherwise the full id.
+    """
+    rows = db.fetchall(
+        """
+        SELECT id::text AS id
+          FROM gateway_actions
+         WHERE state = 'pending_approval'
+           AND id::text LIKE %s
+           AND (origin->>'channel') = %s
+           AND profile_id = %s
+         ORDER BY created_at DESC
+         LIMIT 2
+        """,
+        (f"{prefix}%", via_channel, str(user_id)),
+    ) or []
+    if not rows:
+        return None
+    if len(rows) > 1:
+        return "__ambiguous__"
+    return rows[0]["id"]
+
+
+def _resolve_revert_target(
+    db: DbWrapper, *, prefix: str, via_channel: str, user_id: int,
+) -> Optional[tuple[str, str]]:
+    """Find an *executed* / *reverted* / *conflict* action for revert.
+
+    Returns ``(action_id, current_state)`` so the caller can produce a
+    state-aware reply (e.g. "已经撤销过了" for already-reverted).
+    Filters by ``origin.channel`` + ``profile_id`` for the same
+    cross-channel safety as the approve path.
+
+    Returns:
+      - ``None`` — no match
+      - ``("__ambiguous__", "")`` — ≥2 matches, ask for longer prefix
+      - ``(action_id, state)`` — unique match
+    """
+    rows = db.fetchall(
+        """
+        SELECT id::text AS id, state
+          FROM gateway_actions
+         WHERE state IN ('executed', 'reverted', 'conflict')
+           AND id::text LIKE %s
+           AND (origin->>'channel') = %s
+           AND profile_id = %s
+         ORDER BY executed_at DESC NULLS LAST, created_at DESC
+         LIMIT 2
+        """,
+        (f"{prefix}%", via_channel, str(user_id)),
+    ) or []
+    if not rows:
+        return None
+    if len(rows) > 1:
+        return ("__ambiguous__", "")
+    return (rows[0]["id"], rows[0]["state"])
+
+
+def try_approval_command(
+    text: str, *, user_id: int, via_channel: str, db: DbWrapper,
+) -> Optional[str]:
+    """Attempt to interpret ``text`` as a gateway command (approve /
+    reject / revert / force-revert / edit-stub).
+
+    Returns a reply string for the bot to echo back, or ``None`` if the
+    text isn't a recognized gateway command (caller falls through to
+    normal agent invocation).
+
+    NOTE: name kept for backwards-compat with celery_app.py — it now
+    handles revert commands too. Use :func:`try_gateway_command` as an
+    alias in new call sites.
+    """
+    parsed = parse_command(text)
+    if parsed is None:
+        return None
+    decision, prefix = parsed
+
+    if decision in ("approve", "reject"):
+        return _handle_approve_reject(
+            decision, prefix,
+            user_id=user_id, via_channel=via_channel, db=db,
+        )
+    if decision in ("revert", "force_revert"):
+        return _handle_revert(
+            decision, prefix,
+            user_id=user_id, via_channel=via_channel, db=db,
+        )
+    if decision == "edit":
+        # Phase 4.3 stub — full edit support is Phase 4.4. Redirect the
+        # operator to the existing revert-then-redo flow.
+        return (
+            f"暂不支持直接修改 {prefix}，请回复 '撤销 {prefix}' 后重新发指令。"
+        )
+    return None
+
+
+# Alias for new call sites — name reflects the broader scope.
+try_gateway_command = try_approval_command
+
+
+def _handle_approve_reject(
+    decision: str, prefix: str, *,
+    user_id: int, via_channel: str, db: DbWrapper,
+) -> str:
+    action_id = _resolve_pending_action_id(
+        db, prefix=prefix, via_channel=via_channel, user_id=user_id,
+    )
+    if action_id is None:
+        return f"未找到匹配的审批（前缀 {prefix}）。"
+    if action_id == "__ambiguous__":
+        return f"前缀 {prefix} 匹配多条审批，请提供更长的 ID。"
+
+    try:
+        if decision == "approve":
+            dispatcher.approve(
+                action_id, user_id, via_channel=via_channel, db=db,
+            )
+            return f"✅ 已通过审批 {action_id[:8]}"
+        else:
+            dispatcher.reject(
+                action_id, user_id, via_channel=via_channel, db=db,
+            )
+            return f"🚫 已拒绝审批 {action_id[:8]}"
+    except dispatcher.ActionWrongChannelError:
+        return "请到原始审批渠道处理。"
+    except ValueError as exc:
+        msg = str(exc)
+        if "not found" in msg:
+            return "审批已过期或不存在。"
+        return "该审批已被处理。"
+    except Exception:
+        logger.exception(
+            "text_commands: gateway %s failed action=%s",
+            decision, action_id,
+        )
+        return "处理失败，请稍后重试。"
+
+
+def _handle_revert(
+    decision: str, prefix: str, *,
+    user_id: int, via_channel: str, db: DbWrapper,
+) -> str:
+    """Handle ``撤销 <prefix>`` (decision="revert") and ``强制撤销
+    <prefix>`` (decision="force_revert"). The latter sets force=True
+    on the dispatcher call to bypass the Phase 4.2 conflict guard.
+
+    Reply patterns (per Phase 4.3 spec):
+      success            -> "已撤销 <short> ✅"
+      force success      -> "已强制撤销 <short> ✅"
+      conflict           -> "❌ 不能撤销 <short> —— 这条记录已被改过…"
+      not found          -> "找不到 <prefix>，请检查 id 是否正确"
+      already reverted   -> "<short> 已经撤销过了"
+      ambiguous          -> "找到多条匹配 <prefix>，请提供更长的 id"
+    """
+    force = decision == "force_revert"
+
+    resolved = _resolve_revert_target(
+        db, prefix=prefix, via_channel=via_channel, user_id=user_id,
+    )
+    if resolved is None:
+        return f"找不到 {prefix}，请检查 id 是否正确。"
+    action_id, state = resolved
+    if action_id == "__ambiguous__":
+        return f"找到多条匹配 {prefix}，请提供更长的 id。"
+    short = action_id[:8]
+
+    if state == "reverted":
+        return f"{short} 已经撤销过了。"
+
+    try:
+        result = dispatcher.revert(
+            action_id, int(user_id), force=force, db=db,
+        )
+    except ValueError as exc:
+        msg = str(exc)
+        if "not found" in msg:
+            return f"找不到 {prefix}，请检查 id 是否正确。"
+        if "cannot revert" in msg:
+            return f"{short} 当前状态不允许撤销。"
+        return f"撤销失败：{msg}"
+    except Exception:
+        logger.exception(
+            "text_commands: revert failed action=%s force=%s",
+            action_id, force,
+        )
+        return "撤销处理失败，请稍后重试。"
+
+    new_state = (result or {}).get("state")
+    if new_state == "reverted":
+        return (
+            f"已强制撤销 {short} ✅" if force
+            else f"已撤销 {short} ✅"
+        )
+    if new_state == "conflict":
+        # Phase 4.2 conflict guard fired — record was externally mutated
+        # since execute. Surface the force-revert escape hatch.
+        return (
+            f"❌ 不能撤销 {short} —— 这条记录已被改过，"
+            f"要继续请回复 '强制撤销 {short}'。"
+        )
+    return f"撤销已处理（state={new_state}）。"
+
+
+__all__ = [
+    "parse_command",
+    "try_approval_command",
+    "try_gateway_command",
+]
diff --git a/action_gateway/text_notifier.py b/action_gateway/text_notifier.py
new file mode 100644
index 0000000000..20c511f25a
--- /dev/null
+++ b/action_gateway/text_notifier.py
@@ -0,0 +1,125 @@
+"""Generic text-based pending-approval notifier (Charter §1 渠道闭环).
+
+Channels that don't ship interactive primitives (or whose primitives we
+haven't wired yet — discord/telegram/slack/dingtalk) deliver the
+approval prompt as plain text. The operator replies with
+``通过 <prefix>`` / ``拒绝 <prefix>`` and the celery intake task's
+fast-path (see :mod:`hermes.action_gateway.text_commands`) routes
+that into ``dispatcher.approve``/``reject``.
+
+This module is the *outbound* half: it builds a uniform text body and
+POSTs it through the cloud's ``/internal/channel/push`` endpoint, which
+delegates to the per-profile hermes subprocess that owns the user's
+bot session. Each channel module just calls :func:`make_notifier` with
+its own ``platform`` string and registers the result — the prompt body
+is identical across channels so operators don't have to learn N
+slightly-different reply syntaxes.
+
+A future commit can replace any one of these with a richer card-based
+notifier (Discord components, Slack blocks, …) without touching the
+others; the registry's per-channel slot keeps them decoupled.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Callable, Dict
+
+logger = logging.getLogger(__name__)
+
+
+_TEMPLATE = (
+    "🛡️ 等待审批\n"
+    "{kind}（由 {agent} 提交）\n"
+    "{summary}\n\n"
+    "回复 “通过 {prefix}” 或 “拒绝 {prefix}” 来处理。"
+)
+
+
+def build_approval_text(action: Dict[str, Any]) -> str:
+    """Render an Action Gateway approval prompt as channel-agnostic text.
+
+    The prefix is the first 8 chars of the action UUID — short enough
+    for an operator to type, plenty collision-resistant against the
+    handful of pending actions one user has open at once. The text
+    parser in :mod:`text_commands` matches by prefix and refuses on
+    ambiguity.
+    """
+    action_id = str(action.get("id") or "")
+    prefix = action_id[:8] if action_id else ""
+    return _TEMPLATE.format(
+        kind=str(action.get("kind") or ""),
+        agent=str(action.get("agent_name") or ""),
+        summary=(str(action.get("summary") or "").strip() or "（无摘要）"),
+        prefix=prefix,
+    )
+
+
+def make_notifier(
+    *, channel: str, platform: str,
+) -> Callable[[Dict[str, Any], Dict[str, Any]], None]:
+    """Build a notifier callable for a text-only channel.
+
+    ``channel`` is the registry key (``"discord"`` / ``"telegram"`` /
+    ``"slack"`` / ``"dingtalk"``) — used only for log lines so operators
+    can grep failures by name. ``platform`` is the value passed to the
+    cloud's ``/internal/channel/push`` endpoint, which dispatches to
+    the matching hermes-subprocess platform adapter.
+
+    The returned function reads ``origin.external_user_id`` (the IM
+    user/chat handle the touchpoint adapter stamped on the user actor)
+    and the action's ``profile_id``. Either one missing → log + bail;
+    the WebUI dashboard remains the safety-net path so the action
+    isn't lost.
+    """
+    def _notifier(action: Dict[str, Any], origin: Dict[str, Any]) -> None:
+        from hermes_cloud.app.insights.notify import _post_via_cloud
+
+        # Most channels send DMs to the user (external_user_id). For
+        # channels where notifications belong in the original chat
+        # rather than a DM (discussion threads, group rooms), the
+        # adapter can prefer external_chat_id by passing a different
+        # origin shape — for now we keep it simple and DM the user.
+        target = (
+            str(origin.get("external_user_id") or "").strip()
+            or str(origin.get("external_chat_id") or "").strip()
+        )
+        if not target:
+            logger.warning(
+                "%s pending notifier: missing external_user_id/chat_id "
+                "(action=%s) — falling back to webui dashboard",
+                channel, action.get("id"),
+            )
+            return
+
+        profile_id = str(action.get("profile_id") or "").strip()
+        if not profile_id:
+            logger.warning(
+                "%s pending notifier: missing profile_id (action=%s)",
+                channel, action.get("id"),
+            )
+            return
+
+        try:
+            user_id_for_log = int(profile_id) if profile_id.isdigit() else 0
+        except Exception:
+            user_id_for_log = 0
+
+        text = build_approval_text(action)
+        ok = _post_via_cloud(
+            user_id=user_id_for_log,
+            profile_id=profile_id,
+            platform=platform,
+            channel_id=target,
+            text=text,
+        )
+        if not ok:
+            logger.warning(
+                "%s pending notifier: text POST failed action=%s target=%s",
+                channel, action.get("id"), target,
+            )
+
+    _notifier.__name__ = f"_{channel}_pending_notifier"
+    return _notifier
+
+
+__all__ = ["build_approval_text", "make_notifier"]
diff --git a/agent/overlay_resolver.py b/agent/overlay_resolver.py
new file mode 100644
index 0000000000..0ed1b163a9
--- /dev/null
+++ b/agent/overlay_resolver.py
@@ -0,0 +1,309 @@
+"""Three-layer overlay resolver shared by specialists and skills.
+
+Overlay precedence (highest first):
+
+    ~/.hermes/profiles/<profile_id>/<kind>/    -> "profile_local"
+    ~/.hermes/system_<kind>/                   -> "system_shared"
+    <hermes_root>/<kind>/                      -> "bundled"
+
+For ``kind = "specialists"`` each entry is a directory containing
+``SPECIALIST.md``; for ``kind = "skills"`` each entry is a directory
+containing ``SKILL.md``.
+
+This module builds a stable per-layer manifest (path / mtime / size) that
+callers turn into a cache key via :func:`manifest_hash`, plus minimal
+lookup helpers used by ``prompt_builder`` and the upcoming
+``specialist_manager`` / ``delegate_specialist`` tools (v3.3.2b/d).
+
+Design notes
+------------
+
+* The resolver does **no** caching of its own.  Callers that want to
+  memoize derived work should incorporate :func:`manifest_hash` into
+  their cache keys.  This keeps invalidation explicit and correct.
+* ``profile_local`` overlays may carry ``disabled: true`` in YAML
+  frontmatter; that acts as a *tombstone* preventing fall-through to
+  ``system_shared``/``bundled``.
+* Slug names are validated to ``^[a-z0-9_-]+$`` to defeat path
+  traversal attempts.
+* Missing layer roots are tolerated silently — bundled-only is a
+  legitimate state.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterable, List, Literal, Optional
+
+from agent.skill_utils import parse_frontmatter
+from hermes_constants import get_default_hermes_root, get_hermes_home
+
+logger = logging.getLogger(__name__)
+
+# ---------------------------------------------------------------------------
+# Types
+# ---------------------------------------------------------------------------
+
+LayerName = Literal["profile_local", "system_shared", "bundled"]
+KindName = Literal["specialists", "skills"]
+
+_KIND_INDEX_FILE = {
+    "specialists": "SPECIALIST.md",
+    "skills": "SKILL.md",
+}
+
+_LAYER_ORDER: tuple[LayerName, ...] = ("profile_local", "system_shared", "bundled")
+
+_SLUG_RE = re.compile(r"^[a-z0-9_-]+$")
+_HIDDEN_PREFIXES = (".",)
+_IGNORED_NAMES = frozenset({"__pycache__"})
+
+
+@dataclass(frozen=True)
+class OverlayManifest:
+    """One file's contribution to the manifest used as a cache key."""
+
+    layer: LayerName
+    path: Path
+    mtime: float
+    size: int
+
+
+@dataclass
+class OverlayEntry:
+    """One resolved overlay entry (specialist or skill)."""
+
+    name: str
+    layer: LayerName
+    path: Path
+    metadata: dict
+    body: str
+
+
+# ---------------------------------------------------------------------------
+# Layer roots
+# ---------------------------------------------------------------------------
+
+
+def _layer_root(kind: KindName, layer: LayerName, profile_id: str, hermes_root: Path) -> Path:
+    # v3.3.2d-fix4: profile-mode HERMES_HOME points at ~/.hermes/profiles/<id>,
+    # but profile_local/system_shared layouts are anchored at the *root*
+    # (~/.hermes), not the per-profile home. Use get_default_hermes_root()
+    # which returns the correct root in both standalone and profile modes.
+    root = get_default_hermes_root()
+    if layer == "profile_local":
+        return root / "profiles" / str(profile_id) / kind
+    if layer == "system_shared":
+        # Disk path is "system_<kind>" (e.g. system_specialists, system_skills)
+        return root / f"system_{kind}"
+    if layer == "bundled":
+        return Path(hermes_root) / kind
+    raise ValueError(f"unknown layer: {layer!r}")
+
+
+def _is_valid_slug(name: str) -> bool:
+    if not name or len(name) > 128:
+        return False
+    if name in _IGNORED_NAMES:
+        return False
+    if name.startswith(_HIDDEN_PREFIXES):
+        return False
+    return bool(_SLUG_RE.match(name))
+
+
+# ---------------------------------------------------------------------------
+# Manifest construction
+# ---------------------------------------------------------------------------
+
+
+def _iter_layer_files(
+    kind: KindName,
+    layer: LayerName,
+    profile_id: str,
+    hermes_root: Path,
+) -> Iterable[tuple[str, Path]]:
+    """Yield ``(slug, file_path)`` for each valid index file in *layer*.
+
+    ``file_path`` is the index file (``SPECIALIST.md`` / ``SKILL.md``); the
+    *slug* is its containing directory name.  Slug validation is enforced
+    here so that traversal attempts never reach the manifest.
+    """
+    root = _layer_root(kind, layer, profile_id, hermes_root)
+    if not root.is_dir():
+        return
+    index_filename = _KIND_INDEX_FILE[kind]
+    try:
+        children = sorted(root.iterdir(), key=lambda p: p.name)
+    except OSError as exc:
+        logger.warning("overlay: cannot list %s: %s", root, exc)
+        return
+    for child in children:
+        slug = child.name
+        if not _is_valid_slug(slug):
+            continue
+        if not child.is_dir():
+            continue
+        index_file = child / index_filename
+        if not index_file.is_file():
+            continue
+        yield slug, index_file
+
+
+def build_overlay_manifest(
+    kind: KindName,
+    profile_id: str,
+    hermes_root: Path,
+) -> List[OverlayManifest]:
+    """Return a stable manifest of every visible index file across layers.
+
+    Sorted by ``(layer rank, slug)`` so :func:`manifest_hash` is stable.
+    Includes entries from every layer (no tombstone resolution); the hash
+    must change whenever any underlying file changes regardless of which
+    layer wins.
+    """
+    out: list[OverlayManifest] = []
+    for layer in _LAYER_ORDER:
+        items = list(_iter_layer_files(kind, layer, profile_id, hermes_root))
+        items.sort(key=lambda kv: kv[0])
+        for _slug, path in items:
+            try:
+                st = path.stat()
+            except OSError as exc:
+                logger.warning("overlay: stat failed for %s: %s", path, exc)
+                continue
+            out.append(
+                OverlayManifest(
+                    layer=layer,
+                    path=path,
+                    mtime=st.st_mtime,
+                    size=st.st_size,
+                )
+            )
+    return out
+
+
+def manifest_hash(manifests: List[OverlayManifest]) -> str:
+    """Stable SHA-256 over (layer, path, mtime_ns, size).
+
+    The hash changes when any file is added, removed, or its mtime/size
+    changes — exactly what we need as a cache-busting key for prompt
+    builders.
+    """
+    h = hashlib.sha256()
+    for m in manifests:
+        # mtime is a float; format with high precision so sub-second
+        # changes still flip the hash.
+        h.update(m.layer.encode("utf-8"))
+        h.update(b"\x00")
+        h.update(str(m.path).encode("utf-8"))
+        h.update(b"\x00")
+        h.update(f"{m.mtime:.9f}".encode("ascii"))
+        h.update(b"\x00")
+        h.update(str(m.size).encode("ascii"))
+        h.update(b"\n")
+    return h.hexdigest()
+
+
+# ---------------------------------------------------------------------------
+# Entry parsing / resolution
+# ---------------------------------------------------------------------------
+
+
+def _read_entry(slug: str, layer: LayerName, path: Path) -> Optional[OverlayEntry]:
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except OSError as exc:
+        logger.warning("overlay: read failed for %s: %s", path, exc)
+        return None
+    try:
+        frontmatter, body = parse_frontmatter(raw)
+    except Exception as exc:  # noqa: BLE001 — defensive: never let one bad file break listing
+        logger.warning("overlay: YAML parse failed for %s: %s", path, exc)
+        return None
+    if not isinstance(frontmatter, dict):
+        frontmatter = {}
+    return OverlayEntry(
+        name=slug,
+        layer=layer,
+        path=path,
+        metadata=frontmatter,
+        body=body,
+    )
+
+
+def _is_tombstoned(entry: OverlayEntry) -> bool:
+    """``profile_local`` entries with ``disabled: true`` block fall-through."""
+    if entry.layer != "profile_local":
+        return False
+    return bool(entry.metadata.get("disabled"))
+
+
+def resolve_overlay_entry(
+    kind: KindName,
+    name: str,
+    profile_id: str,
+    hermes_root: Path,
+) -> Optional[OverlayEntry]:
+    """Return the highest-priority entry for *name*, or None.
+
+    Profile-local tombstones (``disabled: true``) suppress the entry
+    entirely (they do **not** silently fall through to the next layer).
+    """
+    if not _is_valid_slug(name):
+        logger.warning("overlay: rejected invalid slug %r", name)
+        return None
+    for layer in _LAYER_ORDER:
+        root = _layer_root(kind, layer, profile_id, hermes_root)
+        index_file = root / name / _KIND_INDEX_FILE[kind]
+        if not index_file.is_file():
+            continue
+        entry = _read_entry(name, layer, index_file)
+        if entry is None:
+            continue
+        if _is_tombstoned(entry):
+            return None
+        return entry
+    return None
+
+
+def list_overlay_entries(
+    kind: KindName,
+    profile_id: str,
+    hermes_root: Path,
+) -> List[OverlayEntry]:
+    """List every visible entry across all layers (deduplicated by name).
+
+    Higher-priority layers shadow lower ones; tombstones suppress the
+    name entirely.  Returned list is sorted by ``name``.
+    """
+    seen_names: set[str] = set()
+    tombstoned: set[str] = set()
+    out: list[OverlayEntry] = []
+    for layer in _LAYER_ORDER:
+        for slug, path in _iter_layer_files(kind, layer, profile_id, hermes_root):
+            if slug in seen_names or slug in tombstoned:
+                continue
+            entry = _read_entry(slug, layer, path)
+            if entry is None:
+                continue
+            if _is_tombstoned(entry):
+                tombstoned.add(slug)
+                continue
+            seen_names.add(slug)
+            out.append(entry)
+    out.sort(key=lambda e: e.name)
+    return out
+
+
+__all__ = [
+    "OverlayEntry",
+    "OverlayManifest",
+    "build_overlay_manifest",
+    "list_overlay_entries",
+    "manifest_hash",
+    "resolve_overlay_entry",
+]
diff --git a/agent/tool_executor_cloud.py b/agent/tool_executor_cloud.py
new file mode 100644
index 0000000000..1b13671d2b
--- /dev/null
+++ b/agent/tool_executor_cloud.py
@@ -0,0 +1,115 @@
+"""Cloud dispatch hardening and per-tool timing shared by all executor paths."""
+
+import inspect
+
+# ── KaCRM patch — secret/private read hard-block (defense-in-depth) ────
+# Runs unconditionally on BOTH dispatch paths (next to the surface-ACL
+# hard-check) so it can't be bypassed via the pre_tool_call-skipping
+# sequential path. ① 机密文件(任何工具读/写都拦);② 私有用户数据
+# USER/MEMORY/SOUL.md(仅"读类"工具拦,放行写以保留 distill/memory 自我演化);
+# ③ 读类工具的显式 path 复用 agent.file_safety 维护的读保护(oauth/MCP/.env)。
+import re as _re_sfg
+_SECRET_FILE_RE = _re_sfg.compile(
+    r"(?:^|[\s\"'=:`(])(?:[\w./~-]*/)?("
+    r"\.env(?:\.(?!example|sample)[\w-]+)?|\.envrc|config\.ya?ml|auth\.json"
+    r"|\.anthropic_oauth\.json|google_oauth\.json|webhook_subscriptions\.json"
+    r"|\.pgpass[0-9]*|\.git-credentials|\.npmrc|\.pypirc|\.secrets|userlist\.txt"
+    r"|id_rsa|id_ed25519|[\w.-]+\.(?:pem|key|pfx|p12)"
+    r")(?=$|[\s\"'`):;,&|/])",
+    _re_sfg.IGNORECASE,
+)
+_PRIVATE_DOC_RE = _re_sfg.compile(
+    r"(?:^|[\s\"'=:`(/])(USER|MEMORY|SOUL)\.md(?=$|[\s\"'`):;,&|])",
+    _re_sfg.IGNORECASE,
+)
+_SFG_ARG_KEYS = ("command","cmd","script","shell","path","file_path","filename","file","paths","input","args")
+_SFG_PATH_KEYS = ("path","file_path","filename","file","paths")
+_SFG_READ_TOOLS = ("terminal","read_file","file_read","code_execution","read","cat")
+_SFG_SECRET_MSG = ("secret-file-guard:此命令疑似读取机密文件(.env / config.yaml / 凭据 / 密钥 / 证书 / OAuth 令牌)。"
+                   "出于安全策略,助手不能读取或泄露机密;了解配置结构请改读 .env.example,排障请转管理员或售后。")
+_SFG_PRIVATE_MSG = ("secret-file-guard:USER.md / MEMORY.md / SOUL.md 属于用户私有数据(画像 / 记忆 / 人设),"
+                    "为保护隐私不能被读取或外泄;如需了解相关功能请改用使用指南或转管理员。")
+def _secret_file_read_block(function_name, function_args):
+    try:
+        if not isinstance(function_args, dict):
+            return None
+        parts = []; path_args = []
+        for k in _SFG_ARG_KEYS:
+            v = function_args.get(k)
+            if isinstance(v, str):
+                parts.append(v)
+                if k in _SFG_PATH_KEYS: path_args.append(v)
+            elif isinstance(v, (list, tuple)):
+                for x in v:
+                    if isinstance(x, str):
+                        parts.append(x)
+                        if k in _SFG_PATH_KEYS: path_args.append(x)
+        text = "  ".join(parts)
+        if not text:
+            return None
+        if _SECRET_FILE_RE.search(text):
+            return _SFG_SECRET_MSG
+        if function_name in _SFG_READ_TOOLS and _PRIVATE_DOC_RE.search(text):
+            return _SFG_PRIVATE_MSG
+        if function_name in _SFG_READ_TOOLS and path_args:
+            try:
+                from agent.file_safety import get_read_block_error
+                for _pth in path_args:
+                    if get_read_block_error(_pth):
+                        return _SFG_SECRET_MSG
+            except Exception:
+                pass
+    except Exception:
+        return None
+    return None
+
+
+def _record_tool_duration(agent, tool_call_id: str, duration: float) -> None:
+    """Stash per-tool wall time on the agent for the DB flush.
+
+    run_agent's flush (``_duration_ms`` for role="tool" rows) reads
+    ``agent._tool_durations``; recording here — at the executor, not in a
+    platform callback — covers EVERY surface (IM adapters, /v1/responses,
+    runs, CLI), not just the chat-completions SSE path.
+    """
+    if not tool_call_id or duration is None:
+        return
+    _td = getattr(agent, "_tool_durations", None)
+    if not isinstance(_td, dict):
+        _td = {}
+        agent._tool_durations = _td
+    _td[tool_call_id] = duration
+
+
+def _invoke_tool_complete_callback(cb, tool_call_id, name, args, result, duration):
+    """Call ``tool_complete_callback``, passing ``duration=`` only if accepted.
+
+    Several upstream surfaces still register 4-positional callbacks
+    (cli.py inline diffs, tui_gateway tool.complete emitters, gateway/run.py
+    Slack native task cards). Passing ``duration=`` unconditionally raises
+    TypeError, which the call sites swallow at DEBUG — silently killing
+    those surfaces' completion events. Signature inspection (not
+    try/except-retry, which would double-invoke a callback that raised
+    TypeError internally) decides; the result is cached on the callback
+    object so the inspect cost is paid once per callback.
+    """
+    accepts = getattr(cb, "_hermes_accepts_duration", None)
+    if accepts is None:
+        try:
+            params = inspect.signature(cb).parameters
+            accepts = ("duration" in params and params["duration"].kind is not inspect.Parameter.POSITIONAL_ONLY) or any(
+                p.kind is p.VAR_KEYWORD for p in params.values()
+            )
+        except (TypeError, ValueError):
+            accepts = False
+        try:
+            cb._hermes_accepts_duration = accepts
+        except Exception:
+            pass  # bound methods / partials without settable attrs
+    if accepts:
+        cb(tool_call_id, name, args, result, duration=duration)
+    else:
+        cb(tool_call_id, name, args, result)
+
+
+
