+"""CRM insights — native hermes capability.
+
+Sales-domain judgement logic (per-record scanners, AI-noticed pattern
+detection, brief/question generation, priority ranking, team-audit
+panels). Migrated out of ``hermes_cloud/app/insights/`` so the
+judgement is a first-class hermes capability; the cloud keeps only the
+thin HTTP route layer.
+"""
diff --git a/crm/insights/ai_noticed.py b/crm/insights/ai_noticed.py
new file mode 100644
index 0000000000..90122eea7c
--- /dev/null
+++ b/crm/insights/ai_noticed.py
@@ -0,0 +1,208 @@
+"""Cross-record patterns that the daily-brief panel surfaces as
+"AI 发现"  — observations that span multiple records and would be
+hard for a human to spot just by scrolling.
+
+Each detector is a pure SQL aggregation. We don't go through the LLM
+here — these are deterministic, cheap, and run on every list_brief
+load (cache TTL of brief still applies; the detector itself is fast).
+
+A detector returns a list of ``{signal, severity, text, payload}``
+dicts; the route picks the top 2-3 across all detectors by severity.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+_TRACKED_MODULES = {"accounts", "contacts", "leads", "potentials"}
+
+
+def _detect_repeated_field_corrections(
+    db: DbWrapper, user_id: int, module: Optional[str],
+) -> List[Dict[str, Any]]:
+    """User changed the same field on the same record 3+ times in 30
+    days → suggest standardising the value. Same source as the
+    coach scanner's ``repeated_field_correction`` signal but here we
+    surface ANY 3+ count, not just per-record."""
+    where_module = "AND module = %s" if module else ""
+    params: List[Any] = [str(user_id)]
+    if module:
+        params.append(module)
+    try:
+        rows = db.fetchall(
+            f"""
+            SELECT module, field_name, COUNT(*) AS n
+              FROM rl_field_changelog
+             WHERE changed_by = %s::text
+               AND changed_at > now() - interval '30 days'
+               AND change_source = 'human'
+               {where_module}
+             GROUP BY module, field_name
+             HAVING COUNT(*) >= 3
+             ORDER BY n DESC
+             LIMIT 3
+            """,
+            tuple(params),
+        ) or []
+    except Exception:
+        logger.exception("ai_noticed_repeated_field_failed user=%s", user_id)
+        rows = []
+    return [
+        {
+            "signal": "repeated_field_correction",
+            "severity": "medium",
+            "text": (
+                f"你在「{r['module']}.{r['field_name']}」上改了 {r['n']} 次 — "
+                f"是不是该统一一下分类标准?"
+            ),
+            "payload": {"module": r["module"], "field_name": r["field_name"], "n": int(r["n"])},
+        }
+        for r in rows
+    ]
+
+
+def _detect_cold_records_pile_up(
+    db: DbWrapper, user_id: int, module: Optional[str],
+) -> List[Dict[str, Any]]:
+    """Many open potentials silent 7+ days → batch-action candidate."""
+    if module and module != "potentials":
+        return []
+    try:
+        row = db.fetchone(
+            """
+            SELECT COUNT(*) AS n
+              FROM potentials p
+             WHERE p.owner_by = %s
+               AND p.deleted = false
+               AND (p.milestone IS NULL OR
+                    lower(p.milestone) NOT IN ('成交','won','closed won','丢失','lost','closed lost'))
+               AND COALESCE(
+                     (SELECT MAX(occurred_at) FROM interactions i
+                       WHERE i.subjects @> jsonb_build_array(
+                                jsonb_build_object('module','potentials','id', p.potentials_id))),
+                     p.created_at
+                   ) < now() - interval '7 days'
+            """,
+            (int(user_id),),
+        ) or {}
+    except Exception:
+        logger.exception("ai_noticed_cold_records_failed user=%s", user_id)
+        return []
+    n = int(row.get("n") or 0)
+    if n < 3:
+        return []
+    sev = "high" if n >= 8 else "medium" if n >= 5 else "low"
+    return [{
+        "signal": "many_silent_potentials",
+        "severity": sev,
+        "text": f"你有 {n} 条在谈商机已经超 7 天没动 — 要不要批量起一轮跟进?",
+        "payload": {"count": n},
+    }]
+
+
+def _detect_uncontacted_new_records(
+    db: DbWrapper, user_id: int, module: Optional[str],
+) -> List[Dict[str, Any]]:
+    """Records created in the last 7 days with no interaction yet."""
+    out: List[Dict[str, Any]] = []
+    module_specs = {
+        "accounts":   ("accounts",   "accounts_id",   "accounts_name"),
+        "leads":      ("leads",      "leads_id",      "leads_name"),
+        "potentials": ("potentials", "potentials_id", "potentials_name"),
+    }
+    if module:
+        module_specs = {module: module_specs[module]} if module in module_specs else {}
+
+    for mod, (table, pk, name_col) in module_specs.items():
+        try:
+            row = db.fetchone(
+                f"""
+                SELECT COUNT(*) AS n
+                  FROM {table} t
+                 WHERE t.owner_by = %s
+                   AND t.deleted = false
+                   AND t.created_at > now() - interval '7 days'
+                   AND NOT EXISTS (
+                     SELECT 1 FROM interactions i
+                      WHERE i.subjects @> jsonb_build_array(
+                              jsonb_build_object('module', %s::text, 'id', t.{pk}))
+                        AND i.kind IN ('email','call','meeting','message',
+                                       'inbound_message','contact_log','chat',
+                                       'im_message')
+                   )
+                """,
+                (int(user_id), mod),
+            ) or {}
+        except Exception:
+            logger.exception("ai_noticed_uncontacted_new_failed user=%s mod=%s", user_id, mod)
+            continue
+        n = int(row.get("n") or 0)
+        if n >= 2:
+            out.append({
+                "signal": "uncontacted_new_records",
+                "severity": "medium" if n >= 5 else "low",
+                "text": f"本周新建 {n} 条 {{'accounts':'客户','leads':'线索','potentials':'商机'}}.get('{mod}','记录') 还没有任何联系记录 — 要不要批量起一份首次触达计划?",
+                "payload": {"module": mod, "count": n},
+            })
+    # Render the f-string lookup correctly (above used a literal).
+    label = {"accounts": "客户", "leads": "线索", "potentials": "商机"}
+    for o in out:
+        m = o["payload"]["module"]
+        n = o["payload"]["count"]
+        o["text"] = (
+            f"本周新建 {n} 条{label.get(m, '记录')}还没有任何联系记录 — "
+            f"要不要批量起一份首次触达计划?"
+        )
+    return out
+
+
+def _detect_unread_coach_pile_up(
+    db: DbWrapper, user_id: int, module: Optional[str],
+) -> List[Dict[str, Any]]:
+    """5+ unread Coach proposals → "AI 焦点 inbox 满了".
+
+    Charter v2 §定律 4 — coach lives in gateway_actions now.
+    """
+    from .coach_cards import count_unread_coach
+    counts = count_unread_coach(db, user_id, module=module)
+    n = int(counts.get("n") or 0)
+    if n < 5:
+        return []
+    n_high = int(counts.get("n_high") or 0)
+    sev = "high" if n_high >= 2 else "medium"
+    return [{
+        "signal": "many_unread_hints",
+        "severity": sev,
+        "text": (
+            f"你有 {n} 条 AI 焦点没看 ({n_high} 条高优先级) — "
+            f"今天先解决最关键的几条吗?"
+        ),
+        "payload": {"count": n, "high": n_high},
+    }]
+
+
+def compute_ai_noticed(
+    db: DbWrapper, user_id: int, module: Optional[str] = None,
+    *, max_items: int = 3,
+) -> List[Dict[str, Any]]:
+    """Run all detectors, sort by severity, take the top N."""
+    if module and module not in _TRACKED_MODULES and module != "":
+        # For modules that aren't accounts/contacts/leads/potentials,
+        # most of these patterns don't make sense. Only the
+        # repeated-field detector is module-agnostic.
+        return _detect_repeated_field_corrections(db, user_id, module)[:max_items]
+
+    bucket: List[Dict[str, Any]] = []
+    bucket.extend(_detect_repeated_field_corrections(db, user_id, module))
+    bucket.extend(_detect_cold_records_pile_up(db, user_id, module))
+    bucket.extend(_detect_uncontacted_new_records(db, user_id, module))
+    bucket.extend(_detect_unread_coach_pile_up(db, user_id, module))
+
+    sev_rank = {"high": 0, "medium": 1, "low": 2}
+    bucket.sort(key=lambda h: sev_rank.get(h.get("severity"), 3))
+    return bucket[:max_items]
diff --git a/crm/insights/brief_cache.py b/crm/insights/brief_cache.py
new file mode 100644
index 0000000000..f7e4505f71
--- /dev/null
+++ b/crm/insights/brief_cache.py
@@ -0,0 +1,100 @@
+"""Per-(user, module) cache of the LLM-generated daily brief.
+
+Mirrors :mod:`question_cache` but at the day/module granularity. See
+``alembic/versions/0047_daily_brief_cache.py`` for schema rationale.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+from datetime import date as _date
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+CACHE_TTL_HOURS = 24
+
+
+def compute_signature(
+    *,
+    user_id: int,
+    module: Optional[str],
+    today: _date,
+    counts: Dict[str, int],
+) -> str:
+    """Stable hash. Inputs we want to invalidate on:
+      - date (new day → re-roll)
+      - aggregate event counts (user actually did things)
+      - module + user_id (scope)
+    """
+    payload = {
+        "user_id": int(user_id),
+        "module": (module or "").strip(),
+        "date": today.isoformat(),
+        "counts": {k: int(v or 0) for k, v in (counts or {}).items()},
+    }
+    raw = json.dumps(payload, ensure_ascii=False, sort_keys=True)
+    return hashlib.sha1(raw.encode("utf-8")).hexdigest()[:16]
+
+
+def get_cached_brief(
+    db: DbWrapper, *, user_id: int, module: Optional[str], signature: str,
+) -> Optional[Dict[str, Any]]:
+    mod = (module or "").strip()
+    try:
+        row = db.fetchone(
+            """
+            SELECT brief
+              FROM daily_brief_cache
+             WHERE user_id = %s AND module = %s
+               AND signature = %s
+               AND generated_at > now() - interval '%s hours'
+            """,
+            (int(user_id), mod, signature, CACHE_TTL_HOURS),
+        )
+    except Exception:
+        logger.exception(
+            "daily_brief_cache_get_failed user=%s module=%s",
+            user_id, module,
+        )
+        return None
+    if not row:
+        return None
+    brief = row.get("brief")
+    if isinstance(brief, str):
+        try:
+            brief = json.loads(brief)
+        except Exception:
+            return None
+    if not isinstance(brief, dict):
+        return None
+    return brief
+
+
+def set_cached_brief(
+    db: DbWrapper, *, user_id: int, module: Optional[str],
+    signature: str, brief: Dict[str, Any],
+) -> None:
+    mod = (module or "").strip()
+    try:
+        db.execute(
+            """
+            INSERT INTO daily_brief_cache (user_id, module, signature, brief, generated_at)
+            VALUES (%s, %s, %s, %s::jsonb, now())
+            ON CONFLICT (user_id, module) DO UPDATE
+              SET signature = EXCLUDED.signature,
+                  brief = EXCLUDED.brief,
+                  generated_at = now()
+            """,
+            (int(user_id), mod, signature,
+             json.dumps(brief, ensure_ascii=False)),
+        )
+    except Exception:
+        logger.exception(
+            "daily_brief_cache_set_failed user=%s module=%s",
+            user_id, module,
+        )
diff --git a/crm/insights/brief_generator.py b/crm/insights/brief_generator.py
new file mode 100644
index 0000000000..37b2862f52
--- /dev/null
+++ b/crm/insights/brief_generator.py
@@ -0,0 +1,146 @@
+"""Generate the daily brief's LLM portions (summary line + 3 action
+suggestions) for the Copilot panel's empty state on event-stream and
+per-module dashboards.
+
+Sibling to ``question_generator``: same caching / same skeleton-loader
+UX / same 4-tier ``source`` reporting (cached / fresh / pending /
+template fallback). Inputs are aggregated across the user's day rather
+than one record's history.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import re
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _format_context(
+    *, summary_facts: Dict[str, Any], ai_noticed: List[Dict[str, Any]],
+    top_priority: List[Dict[str, Any]], today_outcomes: Dict[str, Any],
+) -> str:
+    """Build the user message containing every source the LLM needs."""
+    lines: List[str] = []
+    lines.append("当前模块视角: " + (summary_facts.get("module") or "全部"))
+    lines.append("用户: " + str(summary_facts.get("user_label") or "(未命名)"))
+    lines.append("")
+    lines.append("过去 24 小时的事件计数:")
+    counts = summary_facts.get("counts") or {}
+    for k, label in [
+        ("interactions", "互动"),
+        ("agent_recent", "AI 自动动作"),
+        ("coach_hints", "AI 焦点"),
+        ("outcome_won",  "成单"),
+        ("outcome_stage", "阶段推进"),
+        ("outcome_first_touch", "首触达"),
+    ]:
+        v = int(counts.get(k) or 0)
+        lines.append(f"- {label}: {v}")
+
+    if today_outcomes:
+        lines.append("")
+        lines.append("今日成单(具体记录):")
+        for o in today_outcomes.get("won_records", [])[:5]:
+            lines.append(f"  - {o.get('name')} ¥{o.get('value', 0)}")
+        if not today_outcomes.get("won_records"):
+            lines.append("  (无)")
+
+    if top_priority:
+        lines.append("")
+        lines.append("今天最该处理的 5 条(按紧迫度):")
+        for it in top_priority[:5]:
+            reasons = "; ".join(r.get("text", "") for r in (it.get("reasons") or [])[:2])
+            lines.append(f"  - [{it.get('module')}] {it.get('name')} ({reasons})")
+
+    if ai_noticed:
+        lines.append("")
+        lines.append("AI 已识别的跨记录模式:")
+        for n in ai_noticed[:3]:
+            sev = n.get("severity", "low")
+            lines.append(f"  - [{sev}/{n.get('signal')}] {n.get('text')}")
+
+    return "\n".join(lines)
+
+
+def _parse_brief(text: str) -> Optional[Dict[str, Any]]:
+    if not text:
+        return None
+    s = text.strip()
+    # Strip markdown fence if model wrapped it.
+    s = re.sub(r"^```(?:json)?\s*", "", s)
+    s = re.sub(r"\s*```$", "", s)
+    # Find outermost JSON object.
+    m = re.search(r"\{.*\}", s, re.DOTALL)
+    if not m:
+        return None
+    try:
+        obj = json.loads(m.group(0))
+    except Exception:
+        return None
+    if not isinstance(obj, dict):
+        return None
+    summary = str(obj.get("summary") or "").strip()
+    raw_sugs = obj.get("suggestions") or []
+    sugs: List[Dict[str, Any]] = []
+    if isinstance(raw_sugs, list):
+        for item in raw_sugs:
+            if not isinstance(item, dict):
+                continue
+            text = str(item.get("text") or "").strip()
+            if not text:
+                continue
+            agent = str(item.get("agent") or "").strip()
+            if agent not in {"draft", "analyst", "research"}:
+                agent = "analyst"
+            sugs.append({"text": text[:200], "agent": agent})
+            # Sanity cap matches the skill prompt's stated upper bound
+            # (see hermes/skills/crm-daily-brief/SKILL.md "上限 10").
+            # The skill is told to size 1-10 by today's signal density;
+            # this cap only kicks in for misbehaving LLMs.
+            if len(sugs) >= 10:
+                break
+    if not summary and not sugs:
+        return None
+    return {"summary": summary, "suggestions": sugs}
+
+
+async def generate_brief(
+    *, summary_facts: Dict[str, Any],
+    ai_noticed: List[Dict[str, Any]],
+    top_priority: List[Dict[str, Any]],
+    today_outcomes: Dict[str, Any],
+    user_id: Optional[int] = None,
+    app: Optional[Any] = None,
+) -> Optional[Dict[str, Any]]:
+    """Charter v2 §定律 4 — route via main agent + ``crm-daily-brief``
+    skill. Returns ``{"summary": str, "suggestions": [{text, agent}]}``
+    on success, ``None`` on any failure; caller falls back to the
+    template empty-state.
+    """
+    if app is None or user_id is None:
+        return None
+
+    user_msg = _format_context(
+        summary_facts=summary_facts, ai_noticed=ai_noticed,
+        top_priority=top_priority, today_outcomes=today_outcomes,
+    )
+
+    from hermes_cloud.app.utility_via_skill import run_utility_skill
+    try:
+        reply = await run_utility_skill(
+            app=app, user_id=int(user_id),
+            skill_name="crm-daily-brief",
+            instruction=user_msg,
+            timeout_sec=60.0,
+        )
+    except Exception:
+        logger.exception("brief_gen_via_skill_crashed")
+        return None
+    if not isinstance(reply, dict):
+        logger.info(
+            "brief_gen_no_parse reply_type=%s", type(reply).__name__,
+        )
+        return None
+    return _parse_brief(json.dumps(reply, ensure_ascii=False))
diff --git a/crm/insights/coach_cards.py b/crm/insights/coach_cards.py
new file mode 100644
index 0000000000..e24cf69800
--- /dev/null
+++ b/crm/insights/coach_cards.py
@@ -0,0 +1,270 @@
+"""Read and render ``coach.proposal`` Action Gateway rows.
+
+Coach proposals are written to ``gateway_actions`` (kind=
+``coach.proposal``) by the ``crm-daily-coach`` skill via the
+``coach_proposal_submit`` tool. This module reads them back:
+``read_coach_proposals`` for the feed, ``count_unread_coach`` for badge
+counts, and ``render_coach_digest`` builds the self-contained IM digest
+the cron scheduler delivers to wechat/feishu. Card history lives in
+``gateway_actions`` (state transitions = user feedback).
+"""
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Dict, List
+
+logger = logging.getLogger(__name__)
+
+
+# Severity → default render_targets (Phase 2.1 of decisions-coach
+# consolidation, docs/2026-05-16-decisions-coach-autodrive-consolidation.md).
+# The skill MAY emit ``render_targets`` per card; when absent we fill in
+# these defaults so every coach.proposal carries explicit surface flags
+# (frontend reads them to decide where to render the card).
+_RENDER_TARGET_DEFAULTS_BY_SEVERITY: Dict[str, Dict[str, bool]] = {
+    "high": {
+        "briefing":      True,   # CRM 默认页顶部 hero 区
+        "chip":          True,   # 右栏 / 边栏 chip
+        "inbox":         True,   # SPA inbox
+        "wechat_card":   True,   # 单独推一条微信
+        "wechat_digest": True,   # 计入每日 digest
+    },
+    "medium": {
+        "briefing":      True,
+        "chip":          True,
+        "inbox":         True,
+        "wechat_card":   False,
+        "wechat_digest": True,
+    },
+    "low": {
+        "briefing":      False,
+        "chip":          True,
+        "inbox":         True,
+        "wechat_card":   False,
+        "wechat_digest": True,
+    },
+}
+
+
+# Feed 兜底 (defense-in-depth): coach cards from runs older than the
+# latest run-cluster are dropped. One crm-daily-coach run emits all its
+# cards within ~1-2 min; runs are hours apart (daily cron). A 15-min
+# window ending at the newest card isolates the latest run, so stale
+# cards from earlier runs never show — even when a prior run targeted
+# the same customer via a different module (tasks/122 vs leads/90) and
+# slipped past the per-(module,id) dedup. COALESCE handles the
+# no-cards-yet case (subquery NULL → -infinity → clause always true).
+_LATEST_RUN_CLAUSE = (
+    "created_at >= COALESCE("
+    "(SELECT max(created_at) FROM gateway_actions "
+    " WHERE kind = 'coach.proposal' AND params->>'user_id' = %s)"
+    " - interval '15 minutes', '-infinity'::timestamptz)"
+)
+
+
+def read_coach_proposals(
+    db,
+    user_id: int,
+    *,
+    since=None,
+    unread_only: bool = False,
+    module: str | None = None,
+    limit: int | None = 20,
+) -> List[Dict[str, Any]]:
+    """Single reader for coach cards across all SPA surfaces.
+
+    Charter v2 §定律 4: replaces every ``FROM coach_hints`` query.
+    Coach lives in ``gateway_actions`` (kind='coach.proposal'); a card's
+    ``state`` carries the user-feedback signal:
+      * ``pending_approval`` → unread / not yet acted on
+      * ``executed``         → user copied the draft (≈ "read")
+      * ``rejected``         → user dismissed it
+
+    Returns rows in the legacy coach-hint shape so callers don't change:
+    ``{id, module, record_id, severity, signal, hint, is_read, created_at}``.
+    """
+    clauses = ["kind = 'coach.proposal'", "params->>'user_id' = %s"]
+    args: List[Any] = [str(int(user_id))]
+    if unread_only:
+        clauses.append("state = 'pending_approval'")
+    else:
+        clauses.append("state IN ('pending_approval','executed')")
+    if since is not None:
+        clauses.append("created_at > %s")
+        args.append(since)
+    if module:
+        clauses.append("target->>'module' = %s")
+        args.append(module)
+    clauses.append(_LATEST_RUN_CLAUSE)
+    args.append(str(int(user_id)))
+    # ``limit=None`` → no LIMIT clause. The digest needs every card of
+    # the run (it must be self-contained); ``_LATEST_RUN_CLAUSE``
+    # already bounds the query to one run so this stays finite.
+    limit_sql = ""
+    if limit is not None:
+        limit_sql = " LIMIT %s"
+        args.append(int(limit))
+    # Dedup by (user, target) — multiple cron triggers (or repeated
+    # signal across days) can emit several coach.proposal rows for the
+    # same record; we only want the most recent one per target so the
+    # SPA / wechat surfaces don't show 5 near-identical bubbles about
+    # the same lead. Implemented via DISTINCT ON over (target.module,
+    # target.id) ordered by created_at DESC. Rows missing target.id
+    # (general / not-record-scoped) are kept as a single bucket per
+    # module to avoid swallowing all of them.
+    sql = (
+        "WITH ranked AS ("
+        "  SELECT id::text AS id, target->>'module' AS module, "
+        "         (target->>'id')::bigint AS record_id, "
+        "         COALESCE(params->>'severity','medium') AS severity, "
+        "         params->>'summary' AS hint, "
+        "         params->>'reasoning' AS reasoning, "
+        "         params->>'context_line' AS context_line, "
+        "         COALESCE(params->'action'->>'draft',"
+        "                  params->'action'->>'body',"
+        "                  params->'action'->>'content',"
+        "                  params->'action'->>'text') AS draft, "
+        "         params->'action'->>'intended_channel' AS intended_channel, "
+        "         params->'render_targets' AS render_targets, "
+        "         state, created_at, "
+        "         row_number() OVER ("
+        "           PARTITION BY target->>'module', target->>'id' "
+        "           ORDER BY created_at DESC"
+        "         ) AS rn "
+        "    FROM gateway_actions "
+        "   WHERE " + " AND ".join(clauses) +
+        ")"
+        " SELECT id, module, record_id, severity, hint, reasoning, "
+        "        context_line, draft, "
+        "        intended_channel, render_targets, state, created_at "
+        "   FROM ranked WHERE rn = 1 "
+        "  ORDER BY (state = 'pending_approval') DESC, created_at DESC"
+        + limit_sql
+    )
+    try:
+        rows = db.fetchall(sql, tuple(args)) or []
+    except Exception:
+        logger.exception("read_coach_proposals failed user=%s", user_id)
+        return []
+    out: List[Dict[str, Any]] = []
+    for r in rows:
+        # Backfill render_targets for cards persisted before Phase 2.1
+        # (pre-render_targets era) — same severity-based defaults as
+        # the persist-time fill.
+        rt = r.get("render_targets")
+        if not isinstance(rt, dict):
+            rt = _RENDER_TARGET_DEFAULTS_BY_SEVERITY.get(
+                (r["severity"] or "medium").lower(),
+                _RENDER_TARGET_DEFAULTS_BY_SEVERITY["medium"],
+            )
+        out.append({
+            "id": r["id"],
+            "module": r.get("module"),
+            "record_id": int(r["record_id"]) if r.get("record_id") else None,
+            "severity": r["severity"],
+            "signal": "coach.proposal",
+            "hint": r["hint"],
+            "reasoning": r.get("reasoning"),
+            "context_line": r.get("context_line"),
+            "draft": r.get("draft"),
+            "intended_channel": r.get("intended_channel"),
+            "render_targets": dict(rt),
+            "is_read": r["state"] == "executed",
+            "created_at": r.get("created_at"),
+        })
+    return out
+
+
+def count_unread_coach(db, user_id: int, *, module: str | None = None) -> Dict[str, int]:
+    """Unread coach-card count + high-severity sub-count for red badges."""
+    clauses = [
+        "kind = 'coach.proposal'",
+        "params->>'user_id' = %s",
+        "state = 'pending_approval'",
+    ]
+    args: List[Any] = [str(int(user_id))]
+    if module:
+        clauses.append("target->>'module' = %s")
+        args.append(module)
+    clauses.append(_LATEST_RUN_CLAUSE)
+    args.append(str(int(user_id)))
+    sql = (
+        "SELECT COUNT(*) AS n, "
+        "       COUNT(*) FILTER (WHERE params->>'severity' = 'high') AS n_high "
+        "  FROM gateway_actions WHERE " + " AND ".join(clauses)
+    )
+    try:
+        row = db.fetchone(sql, tuple(args)) or {}
+    except Exception:
+        logger.exception("count_unread_coach failed user=%s", user_id)
+        return {"n": 0, "n_high": 0}
+    return {"n": int(row.get("n") or 0), "n_high": int(row.get("n_high") or 0)}
+
+
+def _render_digest_text(cards: List[Dict[str, Any]]) -> str | None:
+    """Render coach cards into a self-contained IM digest.
+
+    Pure function: input is the list of dicts produced by
+    ``read_coach_proposals``; output is the exact text delivered to
+    wechat/feishu. Every card's summary, context_line and draft are
+    inlined unconditionally — the renderer never points the user
+    elsewhere. Empty input → ``None`` (caller skips delivery).
+    """
+    if not cards:
+        return None
+
+    def _is_high(c: Dict[str, Any]) -> bool:
+        return (c.get("severity") or "").lower() == "high"
+
+    ordered = sorted(cards, key=lambda c: 0 if _is_high(c) else 1)
+    n = len(ordered)
+    n_high = sum(1 for c in ordered if _is_high(c))
+    n_normal = n - n_high
+
+    if n_high == 0:
+        breakdown = "全部普通"
+    elif n_normal == 0:
+        breakdown = "全部紧急"
+    else:
+        breakdown = f"{n_high} 紧急 · {n_normal} 普通"
+
+    segments = [f"🤖 今日 Coach · 共 {n} 件（{breakdown}）"]
+    for c in ordered:
+        emoji = "🔴" if _is_high(c) else "🟡"
+        lines = [f"{emoji} {(c.get('hint') or '').strip()}"]
+        context_line = (c.get("context_line") or "").strip()
+        if context_line:
+            lines.append(f"   {context_line}")
+        # Render is draft-presence-based, not action.type-based: any card
+        # carrying a draft gets a 话术 line; task_create cards (no draft)
+        # render summary + context only — the summary already states the
+        # suggested action.
+        draft = (c.get("draft") or "").strip()
+        if draft:
+            indented = draft.replace("\n", "\n   ")
+            lines.append(f"   话术：{indented}")
+        segments.append("\n".join(lines))
+
+    return "\n\n".join(segments)
+
+
+def render_coach_digest(db, user_id: int) -> str | None:
+    """Build the IM digest for the latest coach run of ``user_id``.
+
+    Reads back this run's ``coach.proposal`` cards (the
+    ``_LATEST_RUN_CLAUSE`` window isolates them) and renders them.
+    Returns ``None`` when the run produced no cards — the cron
+    scheduler treats that as "nothing to push".
+    """
+    # limit=None — the digest must carry every card of the run; a hard
+    # cap would silently drop reminders the user never sees elsewhere.
+    cards = read_coach_proposals(db, user_id, unread_only=False, limit=None)
+    return _render_digest_text(cards)
+
+
+__all__ = [
+    "read_coach_proposals",
+    "count_unread_coach",
+    "render_coach_digest",
+]
