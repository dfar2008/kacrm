+# Charter §1 渠道闭环 — gateway approval prefix-command pattern.
+# When an iLink user replies "通过 abc12345" / "拒绝 abc12345" to a
+# pending-approval prompt, hermes_cloud's celery intake fast-path picks
+# it up via the Interaction Log tap and routes it into
+# dispatcher.approve/reject. We do NOT also want the local hermes agent
+# to receive the same text and answer with confused LLM chatter, so we
+# swallow the message after the cloud tap fires (see _process_message).
+# The pattern matches the parser in
+# hermes.action_gateway.text_commands.parse_command — keep in sync.
+import re as _re_mod
+_GATEWAY_APPROVAL_RE = _re_mod.compile(
+    r"^\s*/?\s*(?:通过|同意|approve|拒绝|否决|reject|✅|❌|🚫)"
+    r"[\s　]+([0-9a-fA-F-]{4,40})\s*$",
+)
+def _is_gateway_approval_command(text: str) -> bool:
+    if not isinstance(text, str) or not text:
+        return False
+    return _GATEWAY_APPROVAL_RE.match(text.replace("　", " ")) is not None
