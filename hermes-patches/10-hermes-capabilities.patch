@@ -0,0 +1,68 @@
+"""Zhipu GLM web-search provider (independent Web Search API).
+
+Clean results API: POST {base}/web_search with the user's GLM key, returns a
+structured result list. Selected when the user's chat model provider is Zhipu
+(cloud S0 writes web.search_backend=glm + search_key/base). Reuses the user's
+GLM key — no extra credential.
+
+NOTE(2026-06-22): implemented to the official Web Search API doc; not yet
+live-tested (no GLM key on hand). Verify when a GLM-model user is configured.
+"""
+from __future__ import annotations
+import logging
+from typing import Any, Dict, List
+import httpx
+from agent.web_search_provider import WebSearchProvider
+
+logger = logging.getLogger(__name__)
+
+def _webcfg() -> dict:
+    """Read the ``web:`` section (search_key / search_base_url / search_model)
+    from the active profile config.yaml — written by cloud S0 per-user."""
+    try:
+        from hermes_cli.config import load_config
+        return load_config().get("web", {}) or {}
+    except Exception:  # noqa: BLE001
+        return {}
+
+
+class GLMWebSearchProvider(WebSearchProvider):
+    @property
+    def name(self) -> str: return "glm"
+    @property
+    def display_name(self) -> str: return "Zhipu GLM Web Search"
+    def is_available(self) -> bool: return bool(_webcfg().get("search_key"))
+    def supports_search(self) -> bool: return True
+    def supports_extract(self) -> bool: return False
+
+    def search(self, query: str, limit: int = 5) -> Dict[str, Any]:
+        cfg = _webcfg()
+        key = cfg.get("search_key")
+        base = str(cfg.get("search_base_url") or "https://open.bigmodel.cn/api/paas/v4").rstrip("/")
+        if not key:
+            return {"success": False, "error": "GLM search_key 未配置"}
+        url = base + "/web_search"
+        try:
+            r = httpx.post(url, headers={"Authorization": f"Bearer {key}"},
+                           json={"search_engine": "search_pro_sogou", "search_query": query},
+                           timeout=30.0)
+            j = r.json()
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("GLM web_search error: %s", exc)
+            return {"success": False, "error": f"GLM web_search failed: {exc}"}
+        items = j.get("search_result") or j.get("data") or []
+        results: List[Dict[str, Any]] = []
+        for hit in items[: max(1, int(limit))]:
+            results.append({
+                "title": str(hit.get("title") or ""),
+                "url": str(hit.get("link") or hit.get("url") or ""),
+                "description": str(hit.get("content") or hit.get("snippet") or "")[:400],
+                "position": len(results) + 1,
+            })
+        if not results:
+            return {"success": False, "error": f"GLM web_search 无结果: {str(j)[:160]}"}
+        return {"success": True, "data": {"web": results}}
+
+    def get_setup_schema(self) -> Dict[str, Any]:
+        return {"name": "Zhipu GLM Web Search", "badge": "follows GLM model · per-user key",
+                "tag": "GLM 独立联网搜索 API", "env_vars": []}
