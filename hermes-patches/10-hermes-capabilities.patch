index 0000000000..2031d6ff70
--- /dev/null
+++ b/crm/i18n/response_localizer.py
@@ -0,0 +1,67 @@
+from __future__ import annotations
+
+from typing import Any
+
+
+EXACT_TEXT_MAP_EN: dict[str, str] = {
+    "未登录": "Not logged in",
+    "user not login": "user not login",
+    "数据库连接失败": "Database connection failed",
+    "参数不完整": "Incomplete parameters",
+    "参数错误": "Parameter error",
+    "Parameter error": "Parameter error",
+    "Save successfully": "Save successfully",
+    "Delete successfully": "Delete successfully",
+    "Update successful": "Update successful",
+    "Delete successful": "Delete successful",
+    "No this condition": "Condition does not exist",
+    "系统错误，请稍后重试": "System error, please try again later",
+    "Module does not exist": "Module does not exist",
+    "Field does not exist": "Field does not exist",
+    "Missing required parameters": "Missing required parameters",
+    "No permission to execute this operation": "No permission to execute this operation",
+    "Module not found": "Module not found",
+    "Target type not found": "Target type not found",
+    "Params error": "Params error",
+    "Workflow ID does not exist!": "Workflow ID does not exist!",
+    "View does not exist": "View does not exist",
+    "Cannot delete default view": "Cannot delete default view",
+}
+
+PREFIX_TEXT_MAP_EN: list[tuple[str, str]] = [
+    ("Save failed:", "Save failed:"),
+    ("Delete failed:", "Delete failed:"),
+    ("Update failed:", "Update failed:"),
+    ("Import failed:", "Import failed:"),
+    ("Query failed:", "Query failed:"),
+    ("Failed to save workflow:", "Failed to save workflow:"),
+    ("Failed to get user list", "Failed to get user list"),
+    ("Failed to get workflows list:", "Failed to get workflows list:"),
+]
+
+
+def localize_text(text: str, locale: str) -> str:
+    if not text or locale != "en-US":
+        return text
+    if text in EXACT_TEXT_MAP_EN:
+        return EXACT_TEXT_MAP_EN[text]
+    for prefix, translated_prefix in PREFIX_TEXT_MAP_EN:
+        if text.startswith(prefix):
+            return translated_prefix + text[len(prefix):]
+    return text
+
+
+def localize_payload_messages(payload: Any, locale: str) -> Any:
+    if locale != "en-US":
+        return payload
+    if isinstance(payload, dict):
+        out: dict[str, Any] = {}
+        for key, value in payload.items():
+            if key in ("message", "msg") and isinstance(value, str):
+                out[key] = localize_text(value, locale)
+            else:
+                out[key] = localize_payload_messages(value, locale)
+        return out
+    if isinstance(payload, list):
+        return [localize_payload_messages(x, locale) for x in payload]
+    return payload
diff --git a/crm/i18n/service.py b/crm/i18n/service.py
new file mode 100644
index 0000000000..d2971198d9
--- /dev/null
+++ b/crm/i18n/service.py
@@ -0,0 +1,123 @@
+from __future__ import annotations
+
+import json
+from contextvars import ContextVar
+from functools import lru_cache
+from pathlib import Path
+from typing import Any
+
+from fastapi import Request
+
+LOCALES_DIR = Path(__file__).resolve().parents[1] / "locales"
+DEFAULT_LOCALE = "zh-CN"
+FALLBACK_LOCALE = "en-US"
+SUPPORTED_LOCALES = ("zh-CN", "en-US")
+current_locale: ContextVar[str] = ContextVar("current_locale", default=DEFAULT_LOCALE)
+
+
+def _normalize_locale(locale: str | None) -> str:
+    raw = (locale or "").strip()
+    if not raw:
+        return ""
+    lowered = raw.replace("_", "-")
+    if lowered.lower().startswith("zh"):
+        return "zh-CN"
+    if lowered.lower().startswith("en"):
+        return "en-US"
+    return lowered
+
+
+@lru_cache(maxsize=16)
+def load_messages(locale: str) -> dict[str, Any]:
+    normalized = _normalize_locale(locale) or DEFAULT_LOCALE
+    path = LOCALES_DIR / f"{normalized}.json"
+    if not path.exists():
+        return {}
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return {}
+
+
+def _deep_get(data: dict[str, Any], key: str) -> Any:
+    cur: Any = data
+    for part in key.split("."):
+        if not isinstance(cur, dict) or part not in cur:
+            return None
+        cur = cur[part]
+    return cur
+
+
+def _render_params(text: str, params: dict[str, Any] | None = None) -> str:
+    if not params:
+        return text
+    out = text
+    for k, v in params.items():
+        out = out.replace("{" + str(k) + "}", str(v))
+    return out
+
+
+def resolve_locale(request: Request) -> str:
+    # 优先级：query > session > Accept-Language > default
+    q_locale = _normalize_locale(request.query_params.get("locale") or request.query_params.get("lang"))
+    if q_locale in SUPPORTED_LOCALES:
+        session = getattr(request, "session", None)
+        if session is not None:
+            session["locale"] = q_locale
+        return q_locale
+
+    session = getattr(request, "session", None)
+    if isinstance(session, dict):
+        s_locale = _normalize_locale(session.get("locale"))
+        if s_locale in SUPPORTED_LOCALES:
+            return s_locale
+
+    accept_lang = (request.headers.get("Accept-Language") or "").split(",")[0].strip()
+    h_locale = _normalize_locale(accept_lang)
+    if h_locale in SUPPORTED_LOCALES:
+        return h_locale
+
+    return DEFAULT_LOCALE
+
+
+def t(key: str, locale: str, params: dict[str, Any] | None = None) -> str:
+    if not key:
+        return ""
+    normalized = _normalize_locale(locale) or DEFAULT_LOCALE
+
+    target = load_messages(normalized)
+    val = _deep_get(target, key)
+    if isinstance(val, str):
+        return _render_params(val, params)
+
+    fallback = load_messages(DEFAULT_LOCALE)
+    val = _deep_get(fallback, key)
+    if isinstance(val, str):
+        return _render_params(val, params)
+
+    en = load_messages(FALLBACK_LOCALE)
+    val = _deep_get(en, key)
+    if isinstance(val, str):
+        return _render_params(val, params)
+
+    return key
+
+
+def export_locale_bundle(locale: str) -> dict[str, Any]:
+    normalized = _normalize_locale(locale) or DEFAULT_LOCALE
+    if normalized not in SUPPORTED_LOCALES:
+        normalized = DEFAULT_LOCALE
+    return {
+        "locale": normalized,
+        "default_locale": DEFAULT_LOCALE,
+        "supported_locales": list(SUPPORTED_LOCALES),
+        "messages": load_messages(normalized),
+    }
+
+
+def set_current_locale(locale: str) -> None:
+    current_locale.set(_normalize_locale(locale) or DEFAULT_LOCALE)
+
+
+def get_current_locale() -> str:
+    return current_locale.get()
