+"""OpenAI web-search provider — Responses API web_search tool (chat-with-search).
+
+POST {base}/responses with tools=[{type:"web_search"}] → model grounds its
+answer on web results. Returns the grounded answer. Selected when the user's
+chat model provider is OpenAI.
+
+NOTE(2026-06-22): implemented to the Responses API doc; not yet live-tested
+(no OpenAI key; api.openai.com may be unreachable from CN unless the user's
+base_url is a proxy).
+"""
+from __future__ import annotations
+import logging
+from typing import Any, Dict
+import httpx
+from agent.web_search_provider import WebSearchProvider
+logger = logging.getLogger(__name__)
+def _webcfg() -> dict:
+    try:
+        from hermes_cli.config import load_config
+        return load_config().get("web", {}) or {}
+    except Exception:  # noqa: BLE001
+        return {}
+
+
+def _extract_text(j: dict) -> str:
+    if isinstance(j.get("output_text"), str):
+        return j["output_text"]
+    parts = []
+    for item in (j.get("output") or []):
+        for c in (item.get("content") or []):
+            if c.get("type") in ("output_text", "text") and c.get("text"):
+                parts.append(c["text"])
+    return "\n".join(parts).strip()
+
+
+class OpenAIWebSearchProvider(WebSearchProvider):
+    @property
+    def name(self) -> str: return "openai"
+    @property
+    def display_name(self) -> str: return "OpenAI (Responses web_search)"
+    def is_available(self) -> bool: return bool(_webcfg().get("search_key"))
+    def supports_search(self) -> bool: return True
+    def supports_extract(self) -> bool: return False
+
+    def search(self, query: str, limit: int = 5) -> Dict[str, Any]:
+        cfg = _webcfg()
+        key = cfg.get("search_key")
+        base = str(cfg.get("search_base_url") or "https://api.openai.com/v1").rstrip("/")
+        model = cfg.get("search_model") or "gpt-5.5"
+        if not key:
+            return {"success": False, "error": "OpenAI search_key 未配置"}
+        url = base + "/responses"
+        body = {"model": model, "tools": [{"type": "web_search"}],
+                "input": f"Search the web and answer, cite source URLs: {query}"}
+        try:
+            j = httpx.post(url, headers={"Authorization": f"Bearer {key}"}, json=body, timeout=120.0).json()
+            ans = _extract_text(j)
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("OpenAI search error: %s", exc)
+            return {"success": False, "error": f"OpenAI search failed: {exc}"}
+        if not ans:
+            return {"success": False, "error": "OpenAI 联网无答案"}
+        return {"success": True, "data": {"web": [{"title": f"OpenAI 联网: {query[:40]}",
+                "url": "", "description": ans[:4000], "position": 1}]}}
+
+    def get_setup_schema(self) -> Dict[str, Any]:
+        return {"name": "OpenAI Web Search", "badge": "follows OpenAI model · per-user key · grounded",
+                "tag": "OpenAI Responses web_search", "env_vars": []}
