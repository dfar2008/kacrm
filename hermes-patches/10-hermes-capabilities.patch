@@ -0,0 +1,339 @@
+"""Mini-agent: management-query analyzer (Phase decisions, spec §6).
+
+Same shape as note_blocker — prefetches indicators in Python, calls
+run_llm_utility once, returns parsed JSON. v2 enrichment: indicators
+return record-level detail (deal IDs, owner names, days_in_stage,
+sample reject comments) so the LLM can propose **specific** actions
+("转潜客#47 给张三") instead of dashboard observations.
+"""
+from __future__ import annotations
+import json
+import logging
+import re
+from typing import Any, Dict, List, Literal, Optional
+
+from hermes.skills._utils.llm import SkillLLMError, run_llm_utility
+from hermes.skills._utils.skill_md import load_skill_body
+from hermes.skills._utils.interactions_query import recent_interactions
+from hermes.tools.scope import viewable_user_ids_or_caller
+
+# Indicator functions are now a native hermes capability under
+# ``hermes.crm.insights`` — direct module-level imports (no circular
+# import; the cloud route layer no longer participates).
+from hermes.crm.insights.team_audit import (
+    ai_actions_summary,
+    recommendation_accuracy,
+)
+from hermes.crm.insights.decision_indicators import (
+    sleeping_deals_detail,
+    pipeline_funnel_detail,
+    member_load_and_acceptance,
+)
+from hermes.crm.insights.revenue_indicators import (
+    revenue_summary,
+    order_pipeline,
+    product_sales_top,
+)
+
+# Legacy names kept for test back-compat; analyze_team itself no
+# longer references them but `patch.object(at_mod, X, ...)` calls in
+# legacy tests rely on the names existing at module level.
+member_ai_acceptance = None
+sleeping_deals_trend = None
+pipeline_funnel = None
+
+
+logger = logging.getLogger(__name__)
+
+ScopeKind = Literal["self", "team", "org"]
+
+
+# Match ```json ... ``` or ``` ... ``` fences that some models wrap output in
+# even when the system prompt forbids it. Tolerant of leading whitespace.
+_FENCE_RE = re.compile(
+    r"^\s*```(?:json|JSON)?\s*\n(.*?)\n```\s*$", re.DOTALL,
+)
+
+
+def _strip_fence(text: str) -> str:
+    m = _FENCE_RE.match(text.strip())
+    return m.group(1) if m else text.strip()
+
+
+def _resolve_uids(
+    *, caller_id: int, scope: ScopeKind, owner_id: Optional[int],
+) -> List[int]:
+    """Resolve the viewable user-id list for this management query.
+
+    The indicator helpers are now scope-agnostic (the cloud-only RBAC
+    coupling was lifted out); they expect a plain ``uids`` list. Inside
+    the hermes agent there is no cloud ``viewable_user_ids`` /
+    ``record_scope_access`` — instead the cloud surface layer binds the
+    ACL'd user-id set into the ``X-Hermes-Scope`` ContextVar, which
+    ``viewable_user_ids_or_caller`` reads. This preserves exactly the
+    scoping the caller had (no widening / narrowing):
+
+    * ``scope='self'`` → caller only.
+    * ``scope='team'``/``'org'`` → the bound surface scope (already
+      capped by the cloud to what the caller may see); unbound → caller
+      only (fail-closed).
+    * ``owner_id`` further narrows to that single user, but only if it
+      is inside the resolved set — no privilege escalation.
+    """
+    if scope == "self":
+        base = [int(caller_id)]
+    else:
+        base = viewable_user_ids_or_caller(int(caller_id))
+    if owner_id is not None and int(owner_id) in base:
+        return [int(owner_id)]
+    return sorted(set(base))
+
+
+def _prefetch_indicators(
+    db, *, caller_id: int, scope: ScopeKind, owner_id: Optional[int],
+) -> Dict[str, Any]:
+    """v2: return record-level detail, not aggregate counts."""
+    uids = _resolve_uids(
+        caller_id=caller_id, scope=scope, owner_id=owner_id,
+    )
+    return {
+        "ai_actions_summary": ai_actions_summary(
+            db, uids=uids, week_offset=0,
+        ),
+        "recommendation_accuracy": recommendation_accuracy(
+            db, uids=uids, window_days=30,
+        ),
+        "sleeping_deals": sleeping_deals_detail(
+            db, uids=uids, limit=20,
+        ),
+        "pipeline_funnel": pipeline_funnel_detail(
+            db, uids=uids, per_stage_limit=5,
+        ),
+        "member_load_and_acceptance": member_load_and_acceptance(
+            db, uids=uids, window_days=30,
+        ),
+        # Revenue / orders / product-sales indicators — feed the
+        # "本月业绩 / top 产品 / 订单分布" prompt chips so the LLM
+        # has record-level numbers (won deal IDs + amounts, order
+        # statuses, top product names) instead of generic counts.
+        "revenue_summary": revenue_summary(
+            db, uids=uids, window_days=30,
+        ),
+        "order_pipeline": order_pipeline(
+            db, uids=uids, window_days=30,
+        ),
+        "product_sales_top": product_sales_top(
+            db, uids=uids, window_days=30, limit=10,
+        ),
+        "recent_interactions": recent_interactions(
+            db, actor_id=caller_id, since_days=7, limit=20,
+        ),
+    }
+
+
+_SYSTEM_PROMPT = """\
+You are a CRM management-query analyzer. Your job is to surface
+**actionable decisions** for a sales manager — NOT to summarize
+dashboards. Output ONLY a single JSON object — no prose, no
+markdown fences, no commentary.
+
+## OUTPUT SCHEMA (strict)
+{
+  "reply_messages": [
+    {
+      "type": "card",
+      "headline": "<≤24 chars Chinese, MUST name a specific record (#id) OR person>",
+      "evidence": {
+        "kind": "sparkline"|"mini_bar"|"mini_pie"|"mini_table"|"inline_metric",
+        "data": [...]
+      },
+      "reasoning": "<1-3 sentences citing concrete numbers / names from the indicator data>",
+      "actions": [ ... at least 1 action ]
+    }
+  ],
+  "thread_metadata": {"context_used": ["<indicator names cited>"]}
+}
+
+## EVIDENCE SHAPES
+  sparkline:     data = [n, n, n, n]                            (time series)
+  mini_bar:      data = [{"label":str,"value":n}, ...]          (≤8 bars)
+  mini_pie:      data = [{"label":str,"value":n}, ...]          (≤4 slices)
+  mini_table:    data = {"columns":[str],"rows":[[...]]}        (≤5 rows × ≤4 cols)
+  inline_metric: data = {"label":str,"value":str}
+
+## ACTION WHITELIST (server 400-rejects others)
+  navigate_interactions  — deep-link to a record's timeline.
+                            params: {"module":"potentials"|"accounts"|...,
+                                     "record_id":<id>}.
+                            With module+record_id the SPA jumps straight
+                            to that record's page; without them it bounces
+                            to the generic 事件流 (avoid that — name a
+                            specific record).
+  decision_defer         — params: {"days": N}
+  decision_dismiss       — params: {}
+  crm_reassign_suggested — params: {"module":"potentials"|"accounts"|"contacts"|"leads"|"tasks",
+                                    "record_id":<id>, "new_owner_id":<uid>}
+  task_create            — params: {"title":str, "description":str?, "due_at":ISO8601?,
+                                    "owner_user_id":<uid>?,
+                                    "related_module":str?, "related_record_id":<id>?}
+
+## HARD RULES (you MUST follow)
+1. Each card's headline MUST contain either a record reference
+   (e.g. '#47', '潜客#47', '「美的项目」') OR a person's name
+   (e.g. '王五', '张三'). Headlines like '休眠交易增至9个' are
+   FORBIDDEN — they're dashboard observations, not decisions.
+2. Each card MUST have ≥1 action. When data names a specific
+   record_id or user, prefer crm_reassign_suggested or task_create
+   with real params over a bare navigate_interactions.
+3. crm_reassign_suggested params.record_id and params.new_owner_id
+   MUST be integers actually present in the indicator data. Do NOT
+   invent IDs.
+4. task_create with related_record_id: that ID MUST appear in the
+   indicator data.
+5. If indicator data has nothing actionable (all empty/zero),
+   return reply_messages: []. Do NOT fabricate.
+6. If a signal kind appears in suppressed_signals, do NOT
+   re-propose it (manager has dismissed it ≥3 times).
+7. Return raw JSON only. No markdown fences. No leading text.
+
+## GOOD CARD (cite this pattern)
+{
+  "type": "card",
+  "headline": "潜客#14「数字广告投放」休眠 34 天",
+  "evidence": {"kind":"inline_metric",
+               "data":{"label":"无新动作天数","value":"34"}},
+  "reasoning": "owner Administrator (user#1) 名下 14 个 open / 8 个休眠；张三 (user#2431) 0 个 open。负载严重不均。",
+  "actions": [
+    {"type":"crm_reassign_suggested","label":"转给张三",
+     "params":{"module":"potentials","record_id":14,"new_owner_id":2431}},
+    {"type":"task_create","label":"派 1:1",
+     "params":{"title":"和 Administrator 1:1 排查 #14 卡点",
+               "owner_user_id":1,"related_module":"potentials","related_record_id":14}},
+    {"type":"decision_defer","label":"再观察 7 天","params":{"days":7}}
+  ]
+}
+
+## BAD CARD — NEVER OUTPUT THIS PATTERN
+{
+  "headline": "休眠交易增至9个",
+  "actions": [{"type":"navigate_interactions","label":"跟进"}]
+}
+Why bad: dashboard observation, not a decision. No specific record_id,
+no specific person, button just bounces manager to CRM list to dig.
+"""
+
+
+def analyze_team(
+    *,
+    db,
+    caller_id: int,
+    query: str,
+    scope: ScopeKind = "team",
+    owner_id: Optional[int] = None,
+    thread_history: Optional[List[Dict[str, Any]]] = None,
+    suppressed_signals: Optional[List[str]] = None,
+    precedents: Optional[Dict[str, Any]] = None,
+) -> Dict[str, Any]:
+    """One-shot management-query analyzer.
+
+    Returns dict shaped as spec §六:
+        {"reply_messages": [...], "thread_metadata": {...}, "error": null}
+    On LLM/parse failure, returns same shape with ``error`` set and
+    ``reply_messages=[]``.
+    """
+    try:
+        ctx = _prefetch_indicators(
+            db, caller_id=caller_id, scope=scope, owner_id=owner_id,
+        )
+    except Exception as exc:
+        logger.exception("analyze_team prefetch failed caller=%s", caller_id)
+        return {"reply_messages": [], "thread_metadata": {}, "error": f"prefetch: {exc}"}
+    try:
+        load_skill_body("crm-analyst")
+    except FileNotFoundError as exc:
+        logger.error("crm-analyst SKILL.md missing: %s", exc)
+        return {"reply_messages": [], "thread_metadata": {}, "error": "skill_md_missing"}
+
+    ctx_with_caller = {
+        "caller_id": caller_id,
+        "suppressed_signals": list(suppressed_signals or []),
+        "precedents": precedents or {},
+        **ctx,
+    }
+    user_prompt = _build_management_prompt(
+        query=query, scope=scope, owner_id=owner_id,
+        ctx=ctx_with_caller, thread_history=thread_history,
+    )
+    messages = [
+        {"role": "system", "content": _SYSTEM_PROMPT},
+        {"role": "user", "content": user_prompt},
+    ]
+    try:
+        text = run_llm_utility(messages, temperature=0.3, timeout_sec=180.0)
+    except SkillLLMError as exc:
+        logger.info("analyze_team llm failed caller=%s err=%s", caller_id, exc)
+        return {"reply_messages": [], "thread_metadata": {}, "error": str(exc)}
+    cleaned = _strip_fence(text)
+    try:
+        parsed = json.loads(cleaned)
+    except json.JSONDecodeError:
+        logger.warning("analyze_team LLM returned non-JSON: %s", cleaned[:200])
+        return {"reply_messages": [], "thread_metadata": {}, "error": "parse_failed"}
+
+    return {
+        "reply_messages": parsed.get("reply_messages") or [],
+        "thread_metadata": parsed.get("thread_metadata") or {},
+        "error": None,
+    }
+
+
+def _build_management_prompt(
+    *, query: str, scope: ScopeKind, owner_id: Optional[int],
+    ctx: Dict[str, Any], thread_history: Optional[List[Dict[str, Any]]],
+) -> str:
+    """Compose the user-side prompt with all prefetched indicator data."""
+    history_block = ""
+    if thread_history:
+        lines = []
+        for m in thread_history[-10:]:
+            role = m.get("role", "?")
+            text = m.get("text", "")[:300]
+            lines.append(f"  [{role}] {text}")
+        history_block = "对话历史：\n" + "\n".join(lines) + "\n\n"
+    owner_clause = f" owner_id={owner_id}" if owner_id else ""
+    suppressed = ctx.get("suppressed_signals") or []
+    suppressed_block = ""
+    if suppressed:
+        suppressed_block = (
+            f"\n经理已 dismiss 的信号类型（30 天内不要再 propose）: "
+            f"{json.dumps(suppressed, ensure_ascii=False)}\n"
+        )
+    # Charter §四 反馈消费 #1: surface past accepted vs reverted
+    # actions so the LLM biases toward what this manager has
+    # historically approved.
+    precedents = ctx.get("precedents") or {}
+    precedents_block = ""
+    accepted = precedents.get("accepted_actions") or []
+    reverted = precedents.get("reverted_actions") or []
+    if accepted or reverted:
+        precedents_block = (
+            f"\n经理过去 30 天的决策结果（少样本经验，作 prompt 参考）：\n"
+            f"  已接受 (accepted, gateway state=executed)：\n"
+            f"  {json.dumps(accepted, ensure_ascii=False)}\n"
+            f"  已撤销 (reverted, manager 反悔)：\n"
+            f"  {json.dumps(reverted, ensure_ascii=False)}\n"
+            "请优先 propose 与 accepted 形态相近的动作，避免 reverted "
+            "中 record_id 上的同类操作。\n"
+        )
+    return (
+        f"经理 user_id={ctx.get('caller_id', '?')} 在 scope={scope}"
+        f"{owner_clause} 范围内询问：\n"
+        f"{query}\n\n"
+        f"{history_block}"
+        f"{suppressed_block}"
+        f"{precedents_block}"
+        f"指标快照（JSON, 含 record-level 明细）：\n"
+        f"{json.dumps(ctx, default=str, ensure_ascii=False)}\n\n"
+        "按 system prompt 定义的 schema 输出 JSON。每张 card 必须 name "
+        "具体 record_id 或 person。原始 JSON，不要 markdown 包裹。"
+    )
