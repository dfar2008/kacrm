+def _create_formula_field_tool() -> "ToolSpec":
+    """Agent 直接给模块/子明细加 formula 公式字段(只读计算列)。"""
+    return ToolSpec(
+        name="crm_create_formula_field",
+        description=(
+            "Add a FORMULA (computed, read-only) field to a CRM module or "
+            "sub-detail — the north-star 'describe a rule, the system grows "
+            "it' move. Unlike crm_propose_new_field (which only queues a "
+            "proposal), this creates the column immediately and backfills "
+            "every existing row. The expression is a SAME-RECORD arithmetic "
+            "formula referencing other field NAMES on the same module/sub-detail: "
+            "+ - * / parens, unary minus, comparisons, and IF / ROUND / MIN / "
+            "MAX / ABS. Example on a product line: 'price * quantity * (1 - "
+            "discount_rate/100)'. The field is stored NUMERIC and read-only "
+            "(users never type it; it recomputes on every save). Use the "
+            "sub-detail's own name as module_name to add a per-row formula to "
+            "a line-item table. Referenced fields must already exist; a "
+            "circular reference is rejected. Only formula fields go through "
+            "this tool — for plain columns (text/number/picklist) use "
+            "crm_propose_new_field."
+        ),
+        verb="create",
+        module_name="__schema_formula__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "module_name": {"type": "string", "description": "Target module or sub-detail id (snake_case, e.g. 'salesorders_products')."},
+                "field_name": {"type": "string", "description": "Snake_case id; letters/digits/underscore, starts with a letter, <= 32 chars."},
+                "field_label": {"type": "string", "description": "Human label (e.g. '含税小计'), <= 64 chars."},
+                "expression": {"type": "string", "description": "Same-record arithmetic over other field names, e.g. 'price * quantity'."},
+                "reason": {"type": "string", "description": "Why the formula is needed (>= 10 chars) — recorded in the changelog."},
+            },
+            "required": ["module_name", "field_name", "field_label", "expression"],
+            "additionalProperties": False,
+        },
+    )
+
+
+def _dispatch_create_formula_field(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str] = None,
+    agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Agent 直建 formula 公式字段。校验表达式后包 provision_field(原子+回填)。"""
+    from hermes_cloud.app.crm.field_provisioning import provision_field
+    from hermes.crm.formula import extract_refs, detect_cycles, FormulaError
+    from fastapi import HTTPException
+
+    module_name = str(arguments.get("module_name") or "").strip()
+    field_name = str(arguments.get("field_name") or "").strip()
+    field_label = str(arguments.get("field_label") or "").strip()
+    expression = str(arguments.get("expression") or "").strip()
+    if not (module_name and field_name and field_label and expression):
+        return {"success": False, "error": "module_name/field_name/field_label/expression 均必填"}
+
+    actor = {"id": int(user_id or 0), "username": agent_name or f"agent:{profile_id or ''}"}
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        mod = ModulesDb(d).get_module_by_name(module_name)
+        if not mod:
+            return {"success": False, "error": f"unknown module: {module_name!r}"}
+        mfdb = ModuleFieldsDb(d)
+        existing = mfdb.get_module_fields(int(mod["id"])) or []
+        names = {str(f.get("field_name") or "") for f in existing}
+        if field_name in names:
+            return {"success": False, "error": f"field already exists: {field_name!r}"}
+        # 校验1:表达式可解析 + 引用字段都存在
+        try:
+            refs = extract_refs(expression)
+        except FormulaError as e:
+            return {"success": False, "error": f"表达式无法解析: {e}"}
+        unknown = sorted(r for r in refs if r not in names)
+        if unknown:
+            return {"success": False,
+                    "error": f"表达式引用了不存在的字段: {', '.join(unknown)};"
+                             f"可用字段: {', '.join(sorted(names))}"}
+        # 校验2:无循环依赖(连同现有 formula 字段一起判)
+        fmap = {
+            str(f.get("field_name")): ((_coerce_fc(f.get("field_config")) or {})
+                                       .get("formula") or {}).get("expression", "")
+            for f in existing if (f.get("field_type") or "") == "formula"
+        }
+        fmap[field_name] = expression
+        try:
+            cycle = detect_cycles({k: v for k, v in fmap.items() if v})
+        except FormulaError as e:
+            return {"success": False, "error": f"表达式无法解析: {e}"}
+        if cycle:
+            return {"success": False, "error": f"公式存在循环依赖: {' → '.join(cycle)}"}
+
+        sort_order = max([int(f.get("sort_order") or 0) for f in existing] + [0]) + 1
+        field_data = {
+            "field_name": field_name,
+            "field_label": field_label,
+            "field_type": "formula",
+            "is_required": False,
+            "is_searchable": False,
+            "is_readonly": True,
+            "options": None,
+            "default_value": None,
+            "description": None,
+            "field_config": {"formula": {"expression": expression}},
+            "sort_order": sort_order,
+        }
+        if not _actor_is_admin(d, user_id):
+            return _enqueue_schema_proposal(
+                d, kind="field_add", module_id=int(mod["id"]),
+                module_name=module_name, dedup_key=field_name,
+                payload=field_data, reason=arguments.get("reason"),
+                user_id=user_id, profile_id=profile_id, agent_name=agent_name,
+            )
+        try:
+            res = provision_field(d, mod, field_data, actor, arguments.get("reason"))
+        except HTTPException as e:
+            return {"success": False, "error": str(e.detail)}
+        return {"success": True, **res,
+                "message": f"已在「{mod.get('title') or module_name}」加公式字段"
+                           f"「{field_label}」= {expression}(只读,已回填现有记录)。"}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as d:
+        return _run(d)
+
+
+def _coerce_fc(raw):
+    """field_config 可能是 dict 或 JSON 字符串,统一成 dict。"""
+    if isinstance(raw, dict):
+        return raw
+    if isinstance(raw, str):
+        try:
+            import json as _json
+            return _json.loads(raw)
+        except Exception:
+            return {}
+    return {}
+
