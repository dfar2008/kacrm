index 0000000000..2b320d8bd0
--- /dev/null
+++ b/crm/formula.py
@@ -0,0 +1,457 @@
+"""Safe same-record formula engine.
+
+A formula field stores a ``NUMERIC`` value computed from an arithmetic
+expression over other fields of the SAME record. This module provides
+a self-implemented tokenizer + recursive-descent parser + evaluator —
+there is deliberately NO ``eval``/``exec``: the expression text is
+authored by admins and must never reach the Python interpreter.
+
+Grammar (EBNF, precedence low → high)::
+
+    expr        := add
+    add         := mul (("+" | "-") mul)*
+    mul         := unary (("*" | "/") unary)*
+    unary       := "-" unary | atom
+    atom        := NUMBER
+                 | IDENT
+                 | IDENT "(" arglist? ")"        (function call)
+                 | "(" expr ")"
+    arglist     := expr ("," expr)*
+    comparison  := add (">"|"<"|">="|"<="|"=="|"!=") add
+
+``comparison`` is NOT reachable from ``expr`` — it is parsed only as
+the first argument of ``IF(...)``. A bare comparison at top level is a
+parse error (``FormulaError``).
+
+Supported functions: ``IF(cond, a, b)``, ``ROUND(x, n)``, ``MIN(...)``,
+``MAX(...)``, ``ABS(x)``.
+
+Evaluation contract:
+  * all arithmetic is :class:`decimal.Decimal`;
+  * a missing / empty / non-numeric field reference evaluates to
+    ``Decimal(0)``;
+  * division by zero, unknown function, wrong arity, or any parse /
+    tokenize error raises :class:`FormulaError`.
+
+Public API: :func:`evaluate`, :func:`extract_refs`, :class:`FormulaError`.
+"""
+from __future__ import annotations
+
+import re
+from decimal import Decimal, DivisionByZero, InvalidOperation
+from typing import Any, List, Optional, Set, Tuple
+
+__all__ = ["FormulaError", "evaluate", "extract_refs", "detect_cycles"]
+
+
+class FormulaError(Exception):
+    """Raised on tokenize / parse / evaluation failure."""
+
+
+# Function name → (min_args, max_args). ``None`` max means variadic.
+_FUNCTIONS = {
+    "IF": (3, 3),
+    "ROUND": (2, 2),
+    "MIN": (1, None),
+    "MAX": (1, None),
+    "ABS": (1, 1),
+}
+
+_COMPARISONS = {">", "<", ">=", "<=", "==", "!="}
+
+# Token kinds: NUMBER, IDENT, OP, LPAREN, RPAREN, COMMA.
+_TOKEN_RE = re.compile(
+    r"""
+      \s*(?:
+          (?P<NUMBER>\d+\.\d+|\d+\.|\.\d+|\d+)
+        | (?P<IDENT>[A-Za-z_][A-Za-z0-9_]*)
+        | (?P<OP>>=|<=|==|!=|[+\-*/<>])
+        | (?P<LPAREN>\()
+        | (?P<RPAREN>\))
+        | (?P<COMMA>,)
+      )
+    """,
+    re.VERBOSE,
+)
+
+
+class _Token:
+    __slots__ = ("kind", "value")
+
+    def __init__(self, kind: str, value: str) -> None:
+        self.kind = kind
+        self.value = value
+
+    def __repr__(self) -> str:  # pragma: no cover - debug aid
+        return f"_Token({self.kind!r}, {self.value!r})"
+
+
+def _tokenize(expression: str) -> List[_Token]:
+    """Lexer. Raises :class:`FormulaError` on any unrecognised char."""
+    tokens: List[_Token] = []
+    pos = 0
+    n = len(expression)
+    while pos < n:
+        if expression[pos].isspace():
+            pos += 1
+            continue
+        m = _TOKEN_RE.match(expression, pos)
+        if not m or m.end() == pos:
+            raise FormulaError(
+                f"Unexpected character at position {pos}: "
+                f"{expression[pos]!r}"
+            )
+        kind = m.lastgroup
+        value = m.group(kind)
+        tokens.append(_Token(kind, value))
+        pos = m.end()
+    return tokens
+
+
+# ---- AST nodes -------------------------------------------------------
+# The AST is plain tuples: (node_kind, *payload). Keeps the module
+# dependency-free and trivially serialisable.
+#   ("num", Decimal)
+#   ("ref", name)
+#   ("neg", child)
+#   ("binop", op, left, right)
+#   ("cmp", op, left, right)
+#   ("call", func_name, [args])
+
+
+class _Parser:
+    """Recursive-descent parser over the token list."""
+
+    def __init__(self, tokens: List[_Token]) -> None:
+        self._tokens = tokens
+        self._i = 0
+
+    def _peek(self) -> Optional[_Token]:
+        return self._tokens[self._i] if self._i < len(self._tokens) else None
+
+    def _next(self) -> _Token:
+        tok = self._peek()
+        if tok is None:
+            raise FormulaError("Unexpected end of expression")
+        self._i += 1
+        return tok
+
+    def _expect(self, kind: str, value: Optional[str] = None) -> _Token:
+        tok = self._peek()
+        if tok is None or tok.kind != kind or (
+            value is not None and tok.value != value
+        ):
+            want = value if value is not None else kind
+            got = tok.value if tok is not None else "<end>"
+            raise FormulaError(f"Expected {want!r}, got {got!r}")
+        return self._next()
+
+    def parse(self) -> Tuple:
+        """Parse a full expression; reject trailing tokens."""
+        if not self._tokens:
+            raise FormulaError("Empty expression")
+        node = self._parse_add()
+        if self._peek() is not None:
+            raise FormulaError(
+                f"Unexpected trailing token: {self._peek().value!r}"
+            )
+        return node
+
+    # add := mul (("+"|"-") mul)*
+    def _parse_add(self) -> Tuple:
+        node = self._parse_mul()
+        while True:
+            tok = self._peek()
+            if tok is not None and tok.kind == "OP" and tok.value in ("+", "-"):
+                self._next()
+                rhs = self._parse_mul()
+                node = ("binop", tok.value, node, rhs)
+            else:
+                return node
+
+    # mul := unary (("*"|"/") unary)*
+    def _parse_mul(self) -> Tuple:
+        node = self._parse_unary()
+        while True:
+            tok = self._peek()
+            if tok is not None and tok.kind == "OP" and tok.value in ("*", "/"):
+                self._next()
+                rhs = self._parse_unary()
+                node = ("binop", tok.value, node, rhs)
+            else:
+                return node
+
+    # unary := "-" unary | atom
+    def _parse_unary(self) -> Tuple:
+        tok = self._peek()
+        if tok is not None and tok.kind == "OP" and tok.value == "-":
+            self._next()
+            return ("neg", self._parse_unary())
+        if tok is not None and tok.kind == "OP" and tok.value == "+":
+            # tolerate a unary plus
+            self._next()
+            return self._parse_unary()
+        return self._parse_atom()
+
+    # atom := NUMBER | IDENT | call | "(" expr ")"
+    def _parse_atom(self) -> Tuple:
+        tok = self._peek()
+        if tok is None:
+            raise FormulaError("Unexpected end of expression")
+        if tok.kind == "NUMBER":
+            self._next()
+            try:
+                return ("num", Decimal(tok.value))
+            except InvalidOperation:
+                raise FormulaError(f"Invalid number: {tok.value!r}")
+        if tok.kind == "LPAREN":
+            self._next()
+            node = self._parse_add()
+            self._expect("RPAREN")
+            return node
+        if tok.kind == "IDENT":
+            self._next()
+            nxt = self._peek()
+            if nxt is not None and nxt.kind == "LPAREN":
+                return self._parse_call(tok.value)
+            return ("ref", tok.value)
+        raise FormulaError(f"Unexpected token: {tok.value!r}")
+
+    # call := IDENT "(" [arg ("," arg)*] ")"
+    def _parse_call(self, name: str) -> Tuple:
+        self._expect("LPAREN")
+        args: List[Tuple] = []
+        if self._peek() is not None and self._peek().kind != "RPAREN":
+            args.append(self._parse_argument(name, len(args)))
+            while self._peek() is not None and self._peek().kind == "COMMA":
+                self._next()
+                args.append(self._parse_argument(name, len(args)))
+        self._expect("RPAREN")
+        upper = name.upper()
+        if upper not in _FUNCTIONS:
+            raise FormulaError(f"Unknown function: {name!r}")
+        lo, hi = _FUNCTIONS[upper]
+        if len(args) < lo or (hi is not None and len(args) > hi):
+            raise FormulaError(
+                f"{upper} expects "
+                f"{lo}{'' if hi == lo else f'..{hi if hi is not None else chr(78)}'}"
+                f" arguments, got {len(args)}"
+            )
+        return ("call", upper, args)
+
+    def _parse_argument(self, func_name: str, index: int) -> Tuple:
+        """Parse one function argument.
+
+        ``IF``'s first argument is a comparison; every other argument
+        (and every other function) takes a plain arithmetic expr."""
+        if func_name.upper() == "IF" and index == 0:
+            return self._parse_comparison()
+        return self._parse_add()
+
+    # comparison := add CMP add   (only reachable as IF's first arg)
+    def _parse_comparison(self) -> Tuple:
+        left = self._parse_add()
+        tok = self._peek()
+        if tok is None or tok.kind != "OP" or tok.value not in _COMPARISONS:
+            raise FormulaError(
+                "IF condition must be a comparison "
+                "(>, <, >=, <=, ==, !=)"
+            )
+        self._next()
+        right = self._parse_add()
+        return ("cmp", tok.value, left, right)
+
+
+def _to_decimal(value: Any) -> Decimal:
+    """Coerce a field value to ``Decimal``; missing / empty / junk → 0."""
+    if value is None:
+        return Decimal(0)
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, bool):
+        return Decimal(1) if value else Decimal(0)
+    if isinstance(value, (int, float)):
+        try:
+            return Decimal(str(value))
+        except InvalidOperation:
+            return Decimal(0)
+    s = str(value).strip()
+    if not s:
+        return Decimal(0)
+    try:
+        return Decimal(s)
+    except InvalidOperation:
+        return Decimal(0)
+
+
+def _eval_node(node: Tuple, values: dict) -> Decimal:
+    kind = node[0]
+    if kind == "num":
+        return node[1]
+    if kind == "ref":
+        return _to_decimal(values.get(node[1]))
+    if kind == "neg":
+        return -_eval_node(node[1], values)
+    if kind == "binop":
+        _, op, left, right = node
+        lv = _eval_node(left, values)
+        rv = _eval_node(right, values)
+        if op == "+":
+            return lv + rv
+        if op == "-":
+            return lv - rv
+        if op == "*":
+            return lv * rv
+        if op == "/":
+            if rv == 0:
+                raise FormulaError("Division by zero")
+            try:
+                return lv / rv
+            except (DivisionByZero, InvalidOperation) as exc:
+                raise FormulaError(f"Arithmetic error: {exc}")
+        raise FormulaError(f"Unknown operator: {op!r}")
+    if kind == "cmp":
+        _, op, left, right = node
+        lv = _eval_node(left, values)
+        rv = _eval_node(right, values)
+        if op == ">":
+            return Decimal(1) if lv > rv else Decimal(0)
+        if op == "<":
+            return Decimal(1) if lv < rv else Decimal(0)
+        if op == ">=":
+            return Decimal(1) if lv >= rv else Decimal(0)
+        if op == "<=":
+            return Decimal(1) if lv <= rv else Decimal(0)
+        if op == "==":
+            return Decimal(1) if lv == rv else Decimal(0)
+        if op == "!=":
+            return Decimal(1) if lv != rv else Decimal(0)
+        raise FormulaError(f"Unknown comparison: {op!r}")
+    if kind == "call":
+        _, name, args = node
+        return _eval_call(name, args, values)
+    raise FormulaError(f"Unknown AST node: {kind!r}")
+
+
+def _eval_call(name: str, args: List[Tuple], values: dict) -> Decimal:
+    if name == "IF":
+        cond = _eval_node(args[0], values)
+        # comparison nodes yield 1 / 0; treat non-zero as true
+        branch = args[1] if cond != 0 else args[2]
+        return _eval_node(branch, values)
+    if name == "ABS":
+        return abs(_eval_node(args[0], values))
+    if name == "ROUND":
+        x = _eval_node(args[0], values)
+        n = _eval_node(args[1], values)
+        try:
+            places = int(n)
+        except (ValueError, TypeError):
+            raise FormulaError("ROUND digit count must be an integer")
+        if places >= 0:
+            quant = Decimal(1).scaleb(-places)
+        else:
+            quant = Decimal(1).scaleb(-places)
+        try:
+            return x.quantize(quant)
+        except InvalidOperation as exc:
+            raise FormulaError(f"ROUND failed: {exc}")
+    if name in ("MIN", "MAX"):
+        evaluated = [_eval_node(a, values) for a in args]
+        return min(evaluated) if name == "MIN" else max(evaluated)
+    raise FormulaError(f"Unknown function: {name!r}")
+
+
+def _parse(expression: str) -> Tuple:
+    """Tokenize + parse; surface every failure as :class:`FormulaError`."""
+    if expression is None or str(expression).strip() == "":
+        raise FormulaError("Empty expression")
+    tokens = _tokenize(str(expression))
+    return _Parser(tokens).parse()
+
+
+def evaluate(expression: str, values: dict) -> Decimal:
+    """Parse and evaluate ``expression`` against ``values``.
+
+    :param expression: the formula text.
+    :param values: same-record field values keyed by ``field_name``.
+    :returns: the computed :class:`~decimal.Decimal`.
+    :raises FormulaError: on tokenize / parse / arithmetic failure.
+    """
+    ast = _parse(expression)
+    return _eval_node(ast, values or {})
+
+
+def _collect_refs(node: Tuple, acc: Set[str]) -> None:
+    kind = node[0]
+    if kind == "ref":
+        acc.add(node[1])
+    elif kind == "neg":
+        _collect_refs(node[1], acc)
+    elif kind in ("binop", "cmp"):
+        _collect_refs(node[2], acc)
+        _collect_refs(node[3], acc)
+    elif kind == "call":
+        for arg in node[2]:
+            _collect_refs(arg, acc)
+    # "num" has no refs
+
+
+def extract_refs(expression: str) -> Set[str]:
+    """Return the set of field identifiers referenced by ``expression``.
+
+    Function names (``IF``/``ROUND``/``MIN``/``MAX``/``ABS``) are not
+    refs. Raises :class:`FormulaError` on a parse error.
+    """
+    ast = _parse(expression)
+    acc: Set[str] = set()
+    _collect_refs(ast, acc)
+    return acc
+
+
+def detect_cycles(formula_fields: dict) -> Optional[List[str]]:
+    """Detect a dependency cycle among a module's formula fields.
+
+    :param formula_fields: ``{field_name: expression}`` for every
+        formula field on a module.
+    :returns: a list of field names forming a cycle, or ``None`` if the
+        dependency graph is acyclic. References to non-formula fields
+        are ignored (they cannot participate in a formula cycle).
+    :raises FormulaError: if any expression fails to parse.
+
+    Used when a formula expression is saved (field create or PATCH of
+    ``field_config.formula``) — a non-``None`` result must be rejected
+    with a 400 by the route layer.
+    """
+    names = set(formula_fields.keys())
+    # adjacency: field -> formula fields it depends on
+    graph = {
+        name: extract_refs(expr) & names
+        for name, expr in formula_fields.items()
+    }
+    WHITE, GRAY, BLACK = 0, 1, 2
+    color = {name: WHITE for name in names}
+    stack: List[str] = []
+
+    def visit(node: str) -> Optional[List[str]]:
+        color[node] = GRAY
+        stack.append(node)
+        for dep in graph.get(node, set()):
+            if color[dep] == GRAY:
+                # cycle: slice the stack from the first occurrence
+                idx = stack.index(dep)
+                return stack[idx:] + [dep]
+            if color[dep] == WHITE:
+                found = visit(dep)
+                if found is not None:
+                    return found
+        stack.pop()
+        color[node] = BLACK
+        return None
+
+    for name in names:
+        if color[name] == WHITE:
+            found = visit(name)
+            if found is not None:
+                return found
+    return None
