@@ -0,0 +1,180 @@
+"""Non-blocking iLink QR primitives for Weixin/WeChat onboarding."""
+from __future__ import annotations
+
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from gateway.platforms.weixin import qr_poll_once_async, qr_start_async
+
+
+@pytest.mark.asyncio
+async def test_qr_start_returns_qrcode_and_url():
+    """SPA needs both the hex qrcode (for subsequent polls) and the
+    qrcode_url (the scannable liteapp URL to render as a QR image)."""
+    mock_resp = {
+        "qrcode": "abc123def456",
+        "qrcode_img_content": "https://wxapi.weixin.qq.com/ilink/qr/abc123def456",
+    }
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.return_value = mock_resp
+        result = await qr_start_async()
+    assert result["qrcode"] == "abc123def456"
+    assert result["qrcode_url"].startswith("https://wxapi.weixin.qq.com")
+    assert "base_url" in result
+    assert "expire_in" in result
+
+
+@pytest.mark.asyncio
+async def test_qr_start_raises_when_qrcode_missing():
+    """If iLink returns the wrong shape, error early so the SPA shows
+    a clear failure rather than silently producing a non-scannable
+    QR."""
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.return_value = {"qrcode_img_content": "https://x.y"}
+        with pytest.raises(RuntimeError, match="qrcode"):
+            await qr_start_async()
+
+
+@pytest.mark.asyncio
+async def test_qr_start_wraps_transport_errors():
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.side_effect = ConnectionError("network down")
+        with pytest.raises(RuntimeError, match="iLink QR fetch failed"):
+            await qr_start_async()
+
+
+# ---------------------------------------------------------------------------
+# qr_poll_once_async
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_poll_wait_returns_pending():
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.return_value = {"status": "wait"}
+        result = await qr_poll_once_async("abc")
+    assert result["status"] == "pending"
+
+
+@pytest.mark.asyncio
+async def test_poll_scaned_returns_scanned():
+    """'scaned' = user scanned but hasn't tapped confirm yet — SPA
+    shows '请在微信里确认...' state."""
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.return_value = {"status": "scaned"}
+        result = await qr_poll_once_async("abc")
+    assert result["status"] == "scanned"
+
+
+@pytest.mark.asyncio
+async def test_poll_redirect_returns_new_base_url():
+    """iLink load-balances by handing the client a new host mid-scan;
+    subsequent polls must hit the new host."""
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.return_value = {
+            "status": "scaned_but_redirect",
+            "redirect_host": "ilinkai-shenzhen.weixin.qq.com",
+        }
+        result = await qr_poll_once_async("abc")
+    assert result["status"] == "redirect"
+    assert result["base_url"] == "https://ilinkai-shenzhen.weixin.qq.com"
+
+
+@pytest.mark.asyncio
+async def test_poll_redirect_without_host_returns_pending():
+    """Malformed redirect (no redirect_host) is a transient anomaly —
+    behave like 'pending' rather than crashing."""
+    with patch("gateway.platforms.weixin._api_get",
+               new_callable=AsyncMock) as mock_get:
+        mock_get.return_value = {"status": "scaned_but_redirect"}
+        result = await qr_poll_once_async("abc")
+    assert result["status"] == "pending"
+
+
+@pytest.mark.asyncio
