+def _list_related_tool() -> ToolSpec:
+    """Tool spec for ``crm_list_related`` — agents walk one FK hop from
+    a current record to records on a different module.
+
+    Replaces cloud's ``copilot/tools.py:_exec_list_related_records`` so
+    SPA Copilot retirement (Phase 4 §4.2) doesn't lose the
+    "this customer's deals" / "this deal's customer" navigation.
+    """
+    valid_targets = sorted({
+        m2 for (_m1, m2) in _RELATED_RECORDS_MAP.keys()
+    })
+    return ToolSpec(
+        name="crm_list_related",
+        description=(
+            "List records on ANOTHER module that are related to a current "
+            "record by foreign key. Use this to answer 'this account's deals', "
+            "'this contact's deals', 'this deal's customer', 'this deal's "
+            "primary contact', 'this deal's overdue tasks'. Pass "
+            "status_keyword to filter by milestone/status (case-insensitive "
+            "substring; for tasks use e.g. 'open' / 'in_progress' / 'done'). "
+            "target_module must be DIFFERENT from current_module. Supported "
+            "relations: accounts→potentials, accounts→contacts, "
+            "accounts→tasks, contacts→potentials, contacts→tasks, "
+            "potentials→accounts (1 row), potentials→contacts (1 row), "
+            "potentials→tasks, leads→tasks."
+        ),
+        verb="index",
+        module_name="__relation__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "current_module": {
+                    "type": "string",
+                    "description": "Module of the record we're walking FROM.",
+                    "enum": ["accounts", "potentials", "contacts", "leads"],
+                },
+                "current_record_id": {
+                    "type": "integer",
+                    "description": "Record id within current_module.",
+                    "minimum": 1,
+                },
+                "target_module": {
+                    "type": "string",
+                    "description": "Module of the records to list. Must be DIFFERENT from current_module.",
+                    "enum": valid_targets,
+                },
+                "status_keyword": {
+                    "type": "string",
+                    "description": (
+                        "Optional substring filter on milestone/status "
+                        "(case-insensitive). E.g. 'qualified' / 'won' / 'proposal'."
+                    ),
+                },
+                "limit": {
+                    "type": "integer",
+                    "description": "Max rows (default 20, hard cap 50).",
+                    "minimum": 1,
+                    "maximum": 50,
+                },
+            },
+            "required": ["current_module", "current_record_id", "target_module"],
+            "additionalProperties": False,
+        },
+    )
