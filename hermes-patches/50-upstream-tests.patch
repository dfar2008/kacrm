+class TestOutboundPayloadTables(unittest.TestCase):
+    """Markdown tables must not degrade the whole reply to a raw text payload.
+
+    Regression guard: content containing a markdown table used to ship as a
+    plain-text payload with the ORIGINAL markdown — users saw bare ###, **
+    and | markers on the Feishu client. Tables now ride inside the post as
+    fenced code rows so surrounding markdown still renders.
+    """
+
+    _TABLE_REPLY = (
+        "### 本周汇总\n"
+        "\n"
+        "**重点客户**:\n"
+        "\n"
+        "| 客户 | 阶段 |\n"
+        "| --- | --- |\n"
+        "| 华为 | 谈判 |\n"
+        "\n"
+        "下一步 **尽快跟进**。"
+    )
+
+    def _make_adapter(self):
+        from gateway.config import PlatformConfig
+        from plugins.platforms.feishu.adapter import FeishuAdapter
+
+        with patch.dict(os.environ, {"FEISHU_APP_ID": "cli", "FEISHU_APP_SECRET": "sec"}, clear=True):
+            return FeishuAdapter(PlatformConfig())
+
+    def test_table_content_ships_as_post_not_raw_text(self):
+        adapter = self._make_adapter()
+        msg_type, payload = adapter._build_outbound_payload(self._TABLE_REPLY)
+        self.assertEqual(msg_type, "post")
+        rows = json.loads(payload)["zh_cn"]["content"]
+        texts = [element["text"] for row in rows for element in row]
+        fenced = [t for t in texts if t.startswith("```")]
+        self.assertEqual(len(fenced), 1)
+        self.assertIn("| 华为 | 谈判 |", fenced[0])
+        prose = "\n".join(t for t in texts if not t.startswith("```"))
+        self.assertIn("### 本周汇总", prose)
+        self.assertIn("**尽快跟进**", prose)
+        self.assertNotIn("|", prose)
+
+    def test_pure_table_ships_as_single_fenced_post_row(self):
+        adapter = self._make_adapter()
+        msg_type, payload = adapter._build_outbound_payload(
+            "| a | b |\n| --- | --- |\n| 1 | 2 |"
+        )
+        self.assertEqual(msg_type, "post")
+        rows = json.loads(payload)["zh_cn"]["content"]
+        self.assertEqual(len(rows), 1)
+        self.assertTrue(rows[0][0]["text"].startswith("```"))
+        self.assertIn("| 1 | 2 |", rows[0][0]["text"])
+
+    def test_table_inside_existing_code_fence_untouched(self):
+        from plugins.platforms.feishu.adapter import _isolate_markdown_tables
+
+        content = "```\n| a | b |\n| --- | --- |\n```"
+        self.assertEqual(_isolate_markdown_tables(content), content)
+
+    def test_multiple_tables_each_fenced(self):
+        from plugins.platforms.feishu.adapter import _isolate_markdown_tables
+
+        content = "| a |\n| - |\n| 1 |\n\nprose\n\n| b |\n| - |\n| 2 |"
+        isolated = _isolate_markdown_tables(content)
+        self.assertEqual(isolated.count("```"), 4)
+        self.assertIn("prose", isolated)
+
+    def test_content_without_table_unchanged(self):
+        from plugins.platforms.feishu.adapter import _isolate_markdown_tables
+
+        content = "**bold** and `code`\nno tables here | stray pipe"
+        self.assertEqual(_isolate_markdown_tables(content), content)
