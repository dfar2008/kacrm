+# ---------------------------------------------------------------------------
+# crm_draft_feedback_collect — 话术蒸馏信号采集(只读)
+# ---------------------------------------------------------------------------
+
+def _pair_cards_and_logs(
+    cards: list,
+    logs: list,
+    cluster_of,
+) -> Dict[str, Any]:
+    """纯函数:把 contact_log 列表配对到 coach 草稿卡列表。
+
+    Args:
+        cards: 按 created_at 升序的卡字典列表,每个须含
+               ``card_id``, ``created_at`` (datetime, aware 或 naive 均可)。
+        logs:  按 occurred_at 升序的 log 字典列表,每个须含
+               ``occurred_at`` (datetime) 和 ``subjects`` (list[dict] with
+               keys ``module``/``id``)。
+        cluster_of: 可调用 ``cluster_of(card_id) -> set[tuple[str,int]]``,
+                    或 dict ``{card_id: set[...]}``。
+
+    Returns:
+        dict ``{card_id: log_dict 或 None}``;log_dict 额外含键
+        ``_matched_subject_module``(命中簇中那个 subject 的 module 字符串)。
+    """
+    from datetime import timedelta
+
+    if callable(cluster_of):
+        get_cluster = cluster_of
+    else:
+        get_cluster = lambda cid: cluster_of.get(cid, set())
+
+    # matched[card_id] = log_dict 或 None(初始 None)
+    matched: Dict[str, Any] = {c["card_id"]: None for c in cards}
+    # 记录哪些卡已被占槽(card_id set)
+    claimed: set = set()
+
+    for log in logs:
+        log_occ = log["occurred_at"]
+        subjects = log.get("subjects") or []
+        # 把 subject list 转成 set[tuple]
+        subject_set = {
+            (str(s.get("module") or ""), int(s.get("id") or 0))
+            for s in subjects
+            if s.get("module") and s.get("id")
+        }
+        if not subject_set:
+            continue
+
+        # 在所有未占槽的卡中,找满足时间窗 + 客户簇的候选(选 created_at 最晚)
+        best_card = None
+        best_module = None
+        for card in cards:
+            cid = card["card_id"]
+            if cid in claimed:
+                continue
+            card_at = card["created_at"]
+            # 窗口:card_at < log_occ <= card_at + 72h
+            if not (card_at < log_occ <= card_at + timedelta(hours=72)):
+                continue
+            cluster = get_cluster(cid)
+            hit_module = None
+            for (m, i) in subject_set:
+                if (m, i) in cluster:
+                    hit_module = m
+                    break
+            if hit_module is None:
+                continue
+            # 选 created_at 最晚
+            if best_card is None or card["created_at"] > best_card["created_at"]:
+                best_card = card
+                best_module = hit_module
+
+        if best_card is not None:
+            claimed.add(best_card["card_id"])
+            log_copy = dict(log)
+            log_copy["_matched_subject_module"] = best_module
+            matched[best_card["card_id"]] = log_copy
+
+    return matched
+
+
+def _dispatch_draft_feedback_collect(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str],
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """采集该 profile 近 since_days 天的 draft_message coach 卡 +
+    配对 contact_log,供每周蒸馏 job 使用。只读,不走 gateway。"""
+    from datetime import timedelta
+
+    try:
+        raw = arguments.get("since_days")
+        since_days = int(raw) if raw is not None else 14
+        since_days = max(1, min(90, since_days))
+    except (ValueError, TypeError):
+        since_days = 14
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        # ── 1. 查 coach 草稿卡 ──────────────────────────────────────────
+        card_rows = db.fetchall(
+            """
+            SELECT id::text AS card_id,
+                   target,
+                   params,
+                   state,
+                   reject_reason_type,
+                   created_at
+            FROM gateway_actions
+            WHERE kind = 'coach.proposal'
+              AND profile_id = %s
+              AND created_at >= now() - make_interval(days => %s)
+              AND (params->'action'->>'type') = 'draft_message'
+            ORDER BY created_at
+            """,
+            (profile_id, since_days),
+        )
+
+        # ── 2. 查 contact_log ───────────────────────────────────────────
+        import json as _json_cl
+        log_rows = db.fetchall(
+            """
+            SELECT id::text AS log_id,
+                   subjects,
+                   content,
+                   occurred_at
+            FROM interactions
+            WHERE kind = 'contact_log'
+              AND source = 'manual'
+              AND occurred_at >= now() - make_interval(days => %s)
+              AND actors @> %s::jsonb
+            ORDER BY occurred_at
+            """,
+            (since_days, _json_cl.dumps([{"type": "user", "id": int(user_id)}])),
+        )
+
+        # ── 3. 为每张卡构建客户簇 ────────────────────────────────────────
+        cluster_map: Dict[str, set] = {}
+        for card in card_rows:
+            cid = card["card_id"]
+            target = card.get("target") or {}
+            module = str(target.get("module") or "")
+            rec_id = target.get("id")
+
+            if not module or rec_id is None:
+                # target 完全缺失 → 空集,永不配对
+                cluster_map[cid] = set()
+                continue
+
+            try:
+                rec_id = int(rec_id)
+            except (ValueError, TypeError):
+                cluster_map[cid] = set()
+                continue
+
+            # 解析 hub account id
+            hub: Optional[int] = None
+            if module == "accounts":
+                hub = rec_id
+            elif module == "potentials":
+                row = db.fetchone(
+                    "SELECT accounts_id FROM potentials WHERE potentials_id = %s",
+                    (rec_id,),
+                )
+                if row:
+                    hub = row.get("accounts_id")
+            elif module == "contacts":
+                row = db.fetchone(
+                    "SELECT accounts_id FROM contacts WHERE contacts_id = %s",
+                    (rec_id,),
+                )
+                if row:
+                    hub = row.get("accounts_id")
+            elif module == "leads":
+                row = db.fetchone(
+                    "SELECT accounts_id FROM accounts "
+                    "WHERE leads_id = %s AND NOT COALESCE(deleted, FALSE) "
+                    "LIMIT 1",
+                    (rec_id,),
+                )
+                if row:
+                    hub = row.get("accounts_id")
+
+            if hub is None:
+                # 无法解析 hub → 单点簇
+                cluster_map[cid] = {(module, rec_id)}
+                continue
+
+            # 构建完整簇
+            cluster: set = {("accounts", hub), (module, rec_id)}
+
+            pots = db.fetchall(
+                "SELECT potentials_id FROM potentials "
+                "WHERE accounts_id = %s AND NOT COALESCE(deleted, FALSE)",
+                (hub,),
+            )
+            for p in pots:
+                cluster.add(("potentials", int(p["potentials_id"])))
+
+            cons = db.fetchall(
+                "SELECT contacts_id FROM contacts "
+                "WHERE accounts_id = %s AND NOT COALESCE(deleted, FALSE)",
+                (hub,),
+            )
+            for c in cons:
+                cluster.add(("contacts", int(c["contacts_id"])))
+
+            acc_row = db.fetchone(
+                "SELECT leads_id FROM accounts WHERE accounts_id = %s",
+                (hub,),
+            )
+            if acc_row and acc_row.get("leads_id"):
+                cluster.add(("leads", int(acc_row["leads_id"])))
+
+            cluster_map[cid] = cluster
+
+        # ── 4. 配对 ──────────────────────────────────────────────────────
+        matched = _pair_cards_and_logs(card_rows, log_rows, cluster_map)
+
+        # ── 5. 组装返回 ───────────────────────────────────────────────────
+        result_cards = []
+        for card in card_rows:
+            cid = card["card_id"]
+            params = card.get("params") or {}
+            action = params.get("action") or {}
+            log = matched.get(cid)
+
+            matched_log = None
+            if log is not None:
+                content = log.get("content") or {}
+                matched_log = {
+                    "occurred_at": log["occurred_at"].isoformat(),
+                    "channel": content.get("channel"),
+                    "summary": content.get("summary"),
+                    "body": content.get("body"),
+                    "subject_module": log.get("_matched_subject_module"),
+                }
+
+            result_cards.append({
+                "card_id": cid,
+                "created_at": card["created_at"].isoformat(),
+                "target": card.get("target"),
+                "severity": params.get("severity"),
+                "intended_channel": action.get("intended_channel"),
+                "draft": action.get("draft"),
+                # Task 8 起 daily-coach emit 的 coach.proposal 卡 action 含
+                # methodology_skill;老卡无该字段,透传 None 而非缺 key,
+                # 蒸馏 prompt(Task 10)据此分层学习"方法论偏好"。
+                "methodology_skill": action.get("methodology_skill"),
+                "state": card.get("state"),
+                "reject_reason_type": card.get("reject_reason_type"),
+                "matched_contact_log": matched_log,
+            })
+
+        return {"success": True, "cards": result_cards}
+
+    try:
+        if db is not None:
+            return _run(db)
+        with db_session() as owned:
+            return _run(owned)
+    except Exception as exc:
+        return {
+            "success": False,
+            "error": f"draft_feedback_collect_failed: {type(exc).__name__}: {exc}",
+        }
+
+
+def _dispatch_via_gateway(
+    *,
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+    module_id: int,
+    module_name: str,
+    op: str,
+    data: Dict[str, Any],
+    user_id: int,
+    record_id: Optional[int] = None,
+    db: DbWrapper,
+) -> Dict[str, Any]:
+    """Route a write through the Action Gateway for trust gating."""
+    import hermes.action_gateway  # noqa: F401 — ensure executor registered
+    from hermes.action_gateway import dispatcher as gateway_dispatcher
+    from hermes_cloud.app.bridge import origin_context
+
+    params: Dict[str, Any] = {
+        "module_id": module_id,
+        "op": op,
+        "data": data,
+    }
+    if record_id is not None:
+        params["record_id"] = record_id
+
+    # Charter §1: tag the action with whichever channel produced this
+    # invocation. The contextvar is bound by the entry point (celery
+    # intake task / WebUI chat endpoint / channel webhook handler);
+    # fallback is ``{"channel": "webui"}``.
+    result = gateway_dispatcher.submit(
+        profile_id=profile_id or "",
+        agent_name=agent_name or "",
+        kind="crm.write",
+        target={"module": module_name, "id": record_id},
+        params=params,
+        user_id=user_id,
+        origin=origin_context.current(),
+        executing_specialist=agent_name or None,
+        db=db,
+    )
+
+    if result["state"] == "executed":
+        token = result.get("revert_token") or {}
+        rid = token.get("record_id") or record_id
+        return {
+            "success": True,
+            "id": int(rid) if rid else 0,
+            "action_id": str(result["id"]),
+        }
+
+    # Pending approval — Charter §6 + v2.2-final freeze #4: return success=False
+    # with the pending_approval flag so the LLM does not interpret this as a
+    # transient failure to retry. Approval happens on the channel that
+    # originated the action (Charter §1 渠道闭环, see gateway/notifiers.py).
+    if result["state"] == "pending_approval":
+        summary = (
+            result.get("summary")
+            or f"{op} {module_name} 等待人工审批"
+        )
+        return {
+            "success": False,
+            "pending_approval": True,
+            "action_id": str(result["id"]),
+            "summary": summary,
+            "message": (
+                "该写入已提交并等待人工审批；这不是失败，"
+                "也不要重复调用本工具或换字段重试。"
+            ),
+        }
+
+    # Any other non-executed terminal state (blocked, etc) — propagate as error.
+    logger.warning(
+        "crm_write_terminal_non_executed action_id=%s state=%s profile=%s agent=%s op=%s module=%s",
+        result.get("id"),
+        result.get("state"),
+        profile_id,
+        agent_name,
+        op,
+        module_name,
+    )
+    return {
+        "success": False,
+        "status": "error",
+        "action_id": str(result["id"]),
+        "message": (
+            f"CRM 写入未执行（state={result.get('state')!r}）。"
+            "请联系管理员检查 trust_levels / 合规拦截记录。"
+        ),
+    }
+
+
+def _dispatch_crm_delete(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    source: str,
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """Soft-delete a CRM record.
+
+    Agent-sourced calls route through the Action Gateway as
+    ``kind='crm.write'`` / ``op='delete'`` so the delete inherits trust
+    gating, human approval, audit attribution, and undo (revert restores
+    ``deleted = FALSE``). Manual / non-agent callers run :class:`ItemDelete`
+    directly — same RBAC as the SPA delete route.
+    """
+    module_name = arguments.get("module", "")
+    try:
+        record_id = int(arguments.get("record_id") or 0)
+    except (ValueError, TypeError):
+        record_id = 0
+    if not module_name:
+        return {"success": False, "error": "module is required"}
+    if record_id <= 0:
+        return {"success": False, "error": "record_id must be a positive integer"}
+
+    if db is None:
+        with db_session() as owned:
+            return _dispatch_crm_delete(
+                arguments, user_id=user_id, source=source,
+                profile_id=profile_id, agent_name=agent_name, db=owned,
+            )
+
+    mod = ModulesDb(db).get_module_by_name(module_name)
+    if not mod:
+        return {"success": False, "error": f"module {module_name!r} not found"}
+    module_id = int(mod["id"])
+
+    if source.startswith("agent:"):
+        return _dispatch_via_gateway(
+            profile_id=profile_id,
+            agent_name=agent_name or source,
+            module_id=module_id,
+            module_name=module_name,
+            op="delete",
+            data={},
+            record_id=record_id,
+            user_id=user_id,
+            db=db,
+        )
+
+    from hermes.crm.item_delete import ItemDelete
+
+    try:
+        ItemDelete(db).set_params(
+            module_id=module_id,
+            record_id=record_id,
+            user_id=int(user_id),
+        ).execute()
+        return {"success": True, "id": record_id}
+    except (PermissionError, ValueError) as e:
+        return {"success": False, "error": str(e)}
+
+
+def _dispatch_pending_approvals(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """List pending gateway actions for the current user's profiles."""
+    limit = min(int(arguments.get("limit", 10) or 10), 20)
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        rows = db.fetchall(
+            """
+            SELECT id, agent_name, kind, target, params, state, created_at
+            FROM gateway_actions
+            WHERE state = 'pending_approval'
+              AND profile_id IN (
+                  SELECT CAST(id AS TEXT) FROM profiles WHERE user_id = %s
+              )
+            ORDER BY created_at DESC
+            LIMIT %s
+            """,
+            (int(user_id), limit),
+        )
+        actions = []
+        for r in rows:
+            target = r.get("target") or {}
+            params = r.get("params") or {}
+            # Build a human-readable summary
+            summary_parts = []
+            if r.get("kind") == "crm.write":
+                op = params.get("op", "write")
+                module = target.get("module", "")
+                record_id = target.get("id")
+                data = params.get("data", {})
+                field_summary = ", ".join(
+                    f"{k}={v}" for k, v in list(data.items())[:5]
+                )
+                if record_id:
+                    summary_parts.append(f"{op} {module}#{record_id}: {field_summary}")
+                else:
+                    summary_parts.append(f"{op} {module}: {field_summary}")
+            else:
+                summary_parts.append(f"{r.get('kind', '?')}")
+
+            actions.append({
+                "action_id": str(r["id"]),
+                "kind": r.get("kind", ""),
+                "agent": r.get("agent_name", ""),
+                "summary": "; ".join(summary_parts),
+                "created_at": str(r.get("created_at", "")),
+            })
+        return {"pending_count": len(actions), "actions": actions}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
