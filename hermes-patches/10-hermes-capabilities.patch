+"""Tests for ``agent.overlay_resolver`` — three-layer specialist/skill lookup."""
+
+from __future__ import annotations
+
+import logging
+import time
+from pathlib import Path
+
+import pytest
+
+from agent.overlay_resolver import (
+    build_overlay_manifest,
+    list_overlay_entries,
+    manifest_hash,
+    resolve_overlay_entry,
+)
+
+
+@pytest.fixture
+def tmp_env(monkeypatch, tmp_path):
+    """Set HERMES_HOME and create a fake bundled hermes_root."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes_home"))
+    bundled_root = tmp_path / "hermes_repo"
+    (bundled_root / "specialists").mkdir(parents=True)
+    (bundled_root / "skills").mkdir(parents=True)
+    return {
+        "home": tmp_path / "hermes_home",
+        "hermes_root": bundled_root,
+        "profile_id": "1",
+    }
+
+
+def _write_entry(root: Path, kind: str, name: str, *, body: str = "x", **fm) -> Path:
+    """Helper: write an SPECIALIST.md or SKILL.md with frontmatter."""
+    index_filename = "SPECIALIST.md" if kind == "specialists" else "SKILL.md"
+    target_dir = root / name
+    target_dir.mkdir(parents=True, exist_ok=True)
+    target = target_dir / index_filename
+    fm_lines = ["---"]
+    fm_lines.append(f"name: {name}")
+    for k, v in fm.items():
+        fm_lines.append(f"{k}: {v}")
+    fm_lines.append("---")
+    fm_lines.append("")
+    fm_lines.append(body)
+    target.write_text("\n".join(fm_lines), encoding="utf-8")
+    return target
+
+
+def _profile_dir(home: Path, profile_id: str, kind: str) -> Path:
+    p = home / "profiles" / profile_id / kind
+    p.mkdir(parents=True, exist_ok=True)
+    return p
+
+
+def _system_dir(home: Path, kind: str) -> Path:
+    p = home / f"system_{kind}"
+    p.mkdir(parents=True, exist_ok=True)
+    return p
+
+
+# =========================================================================
+# Layer precedence
+# =========================================================================
+
+
+class TestLayerPrecedence:
+    def test_profile_local_wins_over_system_and_bundled(self, tmp_env):
+        kind = "specialists"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "intake", description="bundled")
+        _write_entry(_system_dir(tmp_env["home"], kind), kind, "intake", description="system")
+        _write_entry(
+            _profile_dir(tmp_env["home"], tmp_env["profile_id"], kind),
+            kind,
+            "intake",
+            description="profile",
+        )
+        entry = resolve_overlay_entry(
+            kind, "intake", tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        assert entry is not None
+        assert entry.layer == "profile_local"
+        assert entry.metadata.get("description") == "profile"
+
+    def test_system_wins_over_bundled_when_no_profile(self, tmp_env):
+        kind = "specialists"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "intake", description="bundled")
+        _write_entry(_system_dir(tmp_env["home"], kind), kind, "intake", description="system")
+        entry = resolve_overlay_entry(
+            kind, "intake", tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        assert entry is not None
+        assert entry.layer == "system_shared"
+
+    def test_bundled_only(self, tmp_env):
+        kind = "skills"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "coach", description="bundled")
+        entry = resolve_overlay_entry(
+            kind, "coach", tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        assert entry is not None
+        assert entry.layer == "bundled"
+
+    def test_missing_returns_none(self, tmp_env):
+        assert (
+            resolve_overlay_entry(
+                "specialists", "ghost", tmp_env["profile_id"], tmp_env["hermes_root"]
+            )
+            is None
+        )
+
+
+# =========================================================================
+# Tombstones
+# =========================================================================
+
+
+class TestTombstones:
+    def test_profile_local_disabled_suppresses_entry(self, tmp_env):
+        kind = "specialists"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "intake", description="bundled")
+        _write_entry(
+            _profile_dir(tmp_env["home"], tmp_env["profile_id"], kind),
+            kind,
+            "intake",
+            disabled="true",
+        )
+        # Tombstone in profile_local must NOT fall through to bundled.
+        assert (
+            resolve_overlay_entry(
+                kind, "intake", tmp_env["profile_id"], tmp_env["hermes_root"]
+            )
+            is None
+        )
+
+    def test_tombstoned_entry_omitted_from_list(self, tmp_env):
+        kind = "specialists"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "a", description="x")
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "b", description="y")
+        _write_entry(
+            _profile_dir(tmp_env["home"], tmp_env["profile_id"], kind),
+            kind,
+            "b",
+            disabled="true",
+        )
+        names = [
+            e.name
+            for e in list_overlay_entries(kind, tmp_env["profile_id"], tmp_env["hermes_root"])
+        ]
+        assert "a" in names
+        assert "b" not in names
+
+
+# =========================================================================
+# Slug validation
+# =========================================================================
+
+
+class TestSlugValidation:
+    def test_path_traversal_rejected(self, tmp_env):
+        # Even if a malicious caller asks for "../etc/passwd" we refuse.
+        result = resolve_overlay_entry(
+            "specialists", "../etc/passwd", tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        assert result is None
