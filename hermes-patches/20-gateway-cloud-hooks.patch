+# =============================================================================
+# Non-blocking QR flow — start + poll-once primitives
+#
+# hermes-cloud drives this from HTTP handlers (SPA scan-to-connect),
+# where the synchronous ``qr_register()`` blocking poll loop doesn't
+# fit. The two functions below let the caller own the loop:
+#
+#   start = qr_start(domain="feishu")
+#   # show start["qr_url"] in the browser
+#   while True:
+#       r = qr_poll_once(start["device_code"], start["domain"])
+#       if r["status"] == "completed":
+#           creds = r["creds"]; break
+#       if r["status"] in ("expired", "denied", "error"):
+#           break
+#       sleep(start["interval"])
+#
+# ``qr_register()`` remains the convenience wrapper for the CLI wizard.
+# =============================================================================
+
+
+def qr_start(domain: str = "feishu") -> dict:
+    """Begin the device-code flow and return the QR URL + device_code.
+
+    Non-blocking. Caller drives the poll loop (see :func:`qr_poll_once`).
+    Returns::
+
+        {
+            "device_code": str,    # opaque token to pass to qr_poll_once
+            "user_code":   str,    # human-readable code shown alongside QR
+            "qr_url":      str,    # URL to embed in <img src=> or QR generator
+            "interval":    int,    # recommended seconds between polls
+            "expire_in":   int,    # seconds until device_code expires
+            "domain":      str,    # echoes input — pass into qr_poll_once
+        }
+
+    Raises ``RuntimeError`` if the Feishu registration environment
+    doesn't support client_secret auth (mostly a self-hosted-Lark
+    misconfiguration; standard Feishu / Lark always do).
+    """
+    _init_registration(domain)
+    begin = _begin_registration(domain)
+    return {
+        "device_code": begin["device_code"],
+        "user_code": begin.get("user_code", ""),
+        "qr_url": begin["qr_url"],
+        "interval": begin.get("interval") or 5,
+        "expire_in": begin.get("expire_in") or 600,
+        "domain": domain,
+    }
+
+
+def qr_poll_once(device_code: str, domain: str = "feishu") -> dict:
+    """Poll the registration endpoint exactly once. Non-blocking.
+
+    Returns one of (status discriminated union)::
+
+        {"status": "pending"}                                  # keep polling
+        {"status": "completed", "creds": {...}, "domain": str} # app provisioned
+        {"status": "denied"}                                   # user rejected on phone
+        {"status": "expired"}                                  # device_code stale
+        {"status": "error", "message": str}                    # transport/parse failure
+
+    On ``completed``, ``creds`` matches the shape ``qr_register``
+    returns: ``{app_id, app_secret, domain, open_id, bot_name,
+    bot_open_id}``. The ``domain`` top-level key reflects auto-
+    detection — if the user's tenant is Lark even though we started
+    polling against Feishu, this comes back as ``"lark"``.
+    """
+    base_url = _accounts_base_url(domain)
+    try:
+        res = _post_registration(base_url, {
+            "action": "poll",
+            "device_code": device_code,
+            "tp": "ob_app",
+        })
+    except (URLError, OSError, json.JSONDecodeError) as exc:
+        return {"status": "error", "message": f"transport: {exc}"}
+
+    # Domain auto-detection — Feishu's poll endpoint reports tenant
+    # brand mid-flow. Forward this so the caller's next poll hits the
+    # right base URL on the next iteration.
+    user_info = res.get("user_info") or {}
+    detected_domain = domain
+    if user_info.get("tenant_brand") == "lark":
+        detected_domain = "lark"
+
+    if res.get("client_id") and res.get("client_secret"):
+        creds = {
+            "app_id": res["client_id"],
+            "app_secret": res["client_secret"],
+            "domain": detected_domain,
+            "open_id": user_info.get("open_id"),
+        }
+        # Probe bot info — best-effort, don't fail the registration
+        bot_info = probe_bot(creds["app_id"], creds["app_secret"], creds["domain"])
+        creds["bot_name"] = (bot_info or {}).get("bot_name")
+        creds["bot_open_id"] = (bot_info or {}).get("bot_open_id")
+        return {"status": "completed", "creds": creds, "domain": detected_domain}
+
+    error = res.get("error", "")
+    if error == "access_denied":
+        return {"status": "denied"}
+    if error == "expired_token":
+        return {"status": "expired"}
+    if error and error != "authorization_pending":
+        return {"status": "error", "message": error}
+
+    return {"status": "pending", "domain": detected_domain}
