+"""Anthropic web-search provider — Messages web_search server tool.
+
+POST {base}/v1/messages with tools=[{type:"web_search_20250305"}] → Claude runs
+the search server-side and returns a grounded answer. Selected when the user's
+chat model provider is Anthropic.
+
+NOTE(2026-06-22): implemented to the server-tool doc; not yet live-tested (no
+Anthropic key; api.anthropic.com may be unreachable from CN unless base_url is
+a proxy).
+"""
+from __future__ import annotations
+import logging
+from typing import Any, Dict
+import httpx
+from agent.web_search_provider import WebSearchProvider
+logger = logging.getLogger(__name__)
+def _webcfg() -> dict:
+    try:
+        from hermes_cli.config import load_config
+        return load_config().get("web", {}) or {}
+    except Exception:  # noqa: BLE001
+        return {}
+
+
+class AnthropicWebSearchProvider(WebSearchProvider):
+    @property
+    def name(self) -> str: return "anthropic"
+    @property
+    def display_name(self) -> str: return "Anthropic (web_search tool)"
+    def is_available(self) -> bool: return bool(_webcfg().get("search_key"))
+    def supports_search(self) -> bool: return True
+    def supports_extract(self) -> bool: return False
+
+    def search(self, query: str, limit: int = 5) -> Dict[str, Any]:
+        cfg = _webcfg()
+        key = cfg.get("search_key")
+        base = str(cfg.get("search_base_url") or "https://api.anthropic.com").rstrip("/")
+        model = cfg.get("search_model") or "claude-sonnet-4-6"
+        if not key:
+            return {"success": False, "error": "Anthropic search_key 未配置"}
+        # base may already include /anthropic; Messages path is /v1/messages
+        url = base + ("/v1/messages" if not base.endswith("/v1") else "/messages")
+        H = {"x-api-key": key, "anthropic-version": "2023-06-01", "content-type": "application/json"}
+        body = {"model": model, "max_tokens": 1024,
+                "tools": [{"type": "web_search_20250305", "name": "web_search", "max_uses": 3}],
+                "messages": [{"role": "user", "content": f"搜索网络并回答,给出来源链接: {query}"}]}
+        try:
+            j = httpx.post(url, headers=H, json=body, timeout=120.0).json()
+            ans = "".join(b.get("text", "") for b in (j.get("content") or []) if b.get("type") == "text").strip()
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("Anthropic search error: %s", exc)
+            return {"success": False, "error": f"Anthropic search failed: {exc}"}
+        if not ans:
+            return {"success": False, "error": "Anthropic 联网无答案"}
+        return {"success": True, "data": {"web": [{"title": f"Claude 联网: {query[:40]}",
+                "url": "", "description": ans[:4000], "position": 1}]}}
+
+    def get_setup_schema(self) -> Dict[str, Any]:
+        return {"name": "Anthropic Web Search", "badge": "follows Claude model · per-user key · grounded",
+                "tag": "Anthropic web_search server tool", "env_vars": []}
