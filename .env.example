# hermes-cloud local development env template.
#
# Copy to ``.env`` (which is gitignored) and fill in real values:
#
#   cp .env.example .env
#
# Only the variables that need an explicit choice are listed here.
# Anything not set falls back to the in-code default.

# --------------------------------------------------------------------
# Celery / Redis broker
# --------------------------------------------------------------------
# IMPORTANT: hermes-cloud shares a Redis instance with kacrm in many
# dev setups. kacrm's celery workers run as ``-A app.celery_app`` and
# default to Redis DB 0; if hermes-cloud also uses DB 0, kacrm workers
# will pick up our tasks and reject them as ``NotRegistered`` (their
# task registry is different). Always isolate hermes-cloud onto a
# different DB number. We use 3 by convention.
#
# Symptoms when this is wrong: chat POST returns an interaction_id, but
# the celery intake task never runs and Redis shows
# ``task-meta-* {"status":"FAILURE","result":{"exc_type":"NotRegistered",...}}``.
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# --------------------------------------------------------------------
# Postgres (CRM + dashboard share one DB), fronted by pgbouncer
# --------------------------------------------------------------------
# The app connects through pgbouncer (transaction pooling, port 6432) so
# per-process connection pools don't exhaust PG's max_connections as the
# number of per-profile hermes subprocesses grows. Install + run:
#
#   brew install pgbouncer
#   # config is committed in the repo: pgbouncer/pgbouncer.ini
#   # scripts/run_cloud_supervised.sh starts + supervises it for you
#
# psycopg3 dsn for the dashboard / app code:
HERMES_CLOUD_DB_URL=postgresql+psycopg2://openclaw@localhost:5432/hermes_crm_dev
# CRM subsystem dsn — points at pgbouncer on :6432, NOT PostgreSQL direct:
HERMES_CRM_DATABASE_URL=postgresql+psycopg://openclaw@localhost:6432/hermes_crm_dev
# Direct-to-PostgreSQL dsn for alembic migrations only. DDL and alembic's
# session-level advisory locks need a stable backend connection, which
# transaction-mode pgbouncer cannot guarantee — so migrations bypass it.
ALEMBIC_DATABASE_URL=postgresql+psycopg://openclaw@localhost:5432/hermes_crm_dev
# CRM connection pool ceiling for the web server + celery (this process
# group). Profile subprocesses get a much smaller pool injected by
# ProfileManager — see hermes/crm/db.py:get_pool.
HERMES_CRM_POOL_MAX=20

# --------------------------------------------------------------------
# Dashboard admin seed (dev only — used by hermes_cloud.app.dev_server)
# --------------------------------------------------------------------
HERMES_CLOUD_ADMIN_EMAIL=admin@hermes.local
HERMES_CLOUD_ADMIN_PASSWORD=admin123
HERMES_CLOUD_INTERNAL_KEY=dev-internal-key

# --------------------------------------------------------------------
# ②a scale-to-zero + drain(多租户资源 + 部署韧性)
# --------------------------------------------------------------------
# 空闲的 per-profile 网关子进程自动休眠(SIGTERM + 优雅 drain 在途回合 →
# 进程退出、释放 RAM/CPU),下次有请求/入站时 ProfileManager 按需重生(唤醒)。
# 由 ProfileManager 的 idle reaper 驱动(hermes 内建 HERMES_SCALE_TO_ZERO
# 只在 relay/Fly 拓扑生效,云端网关直连不走那条路)。
#
# 永不休眠的 profile:有启用 cron 任务的(必须 24/7 常驻,cron ticker 活在
# 网关进程内);正在跑在途 agent 回合的(探 /health/detailed 确认)。
#
# dev+prod 都启用:设为 1。留空/0 → 关闭(子进程常驻,行为与旧版一致)。
HERMES_CLOUD_SCALE_TO_ZERO=1
# 空闲多久判休眠(分钟),默认 5。非数值/非正 → 回落 5。
HERMES_CLOUD_IDLE_TIMEOUT_MINUTES=5
#
# ⚠️ prod systemd:云端主进程停子进程时会等最多 ~45s(drain 30s + 余量)让
# 网关走完 _drain_active_agents。kacrm-cloud.service 的 TimeoutStopSec 必须
# ≥ 45s(建议 60s),否则 systemd 会在 drain 中途 SIGKILL 整个 cgroup,反而
# 丢在途会话。检查:systemctl show kacrm-cloud -p TimeoutStopSec
# 修:在 unit [Service] 段设 TimeoutStopSec=60,然后 daemon-reload + restart。

# --------------------------------------------------------------------
# Specialist catalog HMAC signing (v3.3.2c)
# --------------------------------------------------------------------
# Authenticates the cloud → profile SPECIALIST.md mirror written to
# ``~/.hermes/system_specialists/<name>/``. Without it,
# profile_manager bootstrap skips every entry as "unsigned" and
# overlay_resolver falls back to bundled-only — degraded but not broken.
#
# Generate with:    openssl rand -base64 32
# 32 bytes, base64-encoded. NOT reused with HERMES_CLOUD_INTERNAL_KEY
# (per v3.3 决策 11) so a leaked internal key cannot forge catalog
# entries. Production: K8s secret. Dev: this file.
HERMES_SPECIALIST_CATALOG_SIGNING_KEY=
# Up to N=3 historical keys honored on verify so a rotation doesn't
# immediately invalidate every profile's existing .hash.signed file.
# Move the OLD value here when you rotate to a new
# HERMES_SPECIALIST_CATALOG_SIGNING_KEY.
# HERMES_SPECIALIST_CATALOG_SIGNING_KEY_PREV_1=
# HERMES_SPECIALIST_CATALOG_SIGNING_KEY_PREV_2=
# HERMES_SPECIALIST_CATALOG_SIGNING_KEY_PREV_3=

# --------------------------------------------------------------------
# auto_drive 凌晨自动起草 + IM push
# spec: docs/superpowers/specs/2026-05-10-auto-drive-activation-design.md
# --------------------------------------------------------------------
# Beat schedule entry "auto-drive-daily" 每天 22:30 UTC (06:30 SGT)
# 触发；task 内部三道 env gate 决定真不真跑：
#
#   Stage A → AUTO_DRIVE_ENABLED=1 (DRY_RUN 默认 1)
#       验证 cron 触发、_default_hints 检测、interaction emit。
#       不调 LLM、不写 drafts、不 push。
#       SQL 检查：SELECT count(*) FROM interactions
#                 WHERE kind='auto_drive.tick' AND occurred_at >= now()-interval '24h'
#
#   Stage B → +AUTO_DRIVE_DRY_RUN=0 +AUTO_DRIVE_PILOT_USER_IDS=1,<dev_id>
#       仅白名单用户走真路径：调 LLM 起草、写 crm_drafts、推 IM card。
#
#   Stage C → 移除 AUTO_DRIVE_PILOT_USER_IDS（或留空）→ 全用户启用。
#
#   Kill   → AUTO_DRIVE_ENABLED=0 + restart celery beat worker
#
# 决策每日 push（22:00 UTC）和 auto_drive (22:30 UTC) 共享 IM 推送
# 基建，都需要 HERMES_CLOUD_INTERNAL_KEY 已在上面 dashboard 段设了。
#
AUTO_DRIVE_ENABLED=0
AUTO_DRIVE_DRY_RUN=1
# AUTO_DRIVE_PILOT_USER_IDS=1,2

# --------------------------------------------------------------------
# Tinker / RL training (deprecated, retired in v3.4 charter pivot)
# --------------------------------------------------------------------
TINKER_API_KEY=
