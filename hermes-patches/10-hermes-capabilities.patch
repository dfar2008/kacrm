+"""Memory Substrate — charter 原语 ②.
+
+Three coordinated stores:
+
+- ``memories``               vector-indexed distilled knowledge (pgvector)
+- ``memory_entities``        canonical entities (person/org/product/…)
+- ``memory_edges``           typed relations between entities
+
+The public surface is small on purpose:
+
+    from hermes.memory import (
+        embed, upsert_memory, search_memories,
+        upsert_entity, add_edge, subgraph,
+        ingest_interaction,
+    )
+
+Each function accepts an optional DbWrapper so it can participate in
+the caller's transaction. Dev environments without an OpenAI key fall
+back to a deterministic hash-based embedder — retrieval quality is low
+but the code path stays unit-testable offline.
+"""
+from hermes.memory.embedder import embed, EMBEDDING_DIM
+from hermes.memory.vector_store import (
+    upsert_memory,
+    search_memories,
+    delete_memory,
+)
+from hermes.memory.entities import (
+    upsert_entity,
+    find_entity,
+    add_edge,
+    subgraph,
+    link_memory_to_entity,
+    merge_entities,
+)
+from hermes.memory.ingest import ingest_interaction
+
+__all__ = [
+    "embed",
+    "EMBEDDING_DIM",
+    "upsert_memory",
+    "search_memories",
+    "delete_memory",
+    "upsert_entity",
+    "find_entity",
+    "add_edge",
+    "subgraph",
+    "link_memory_to_entity",
+    "merge_entities",
+    "ingest_interaction",
+]
diff --git a/memory/embedder.py b/memory/embedder.py
new file mode 100644
index 0000000000..67d36c2e0e
--- /dev/null
+++ b/memory/embedder.py
@@ -0,0 +1,152 @@
+"""Pluggable text embedder — charter 原语 ②.
+
+Provider resolution order (at import + at every ``embed`` call, so swaps
+take effect without restart):
+
+1. ``HERMES_EMBEDDING_PROVIDER=openai`` + ``OPENAI_API_KEY`` —
+   real embeddings via OpenAI-compatible HTTPS API. Honors
+   ``HERMES_EMBEDDING_BASE_URL`` (for Azure / local vLLM) and
+   ``HERMES_EMBEDDING_MODEL`` (default ``text-embedding-3-small``).
+
+2. ``HERMES_EMBEDDING_PROVIDER=hash`` (or unset when no OpenAI key) —
+   deterministic hash-based fallback. Not semantically meaningful but
+   stable, dimension-correct, and keeps the full code path
+   import/unit-testable offline.
+
+Every embedder returns a Python ``list[float]`` of length
+:data:`EMBEDDING_DIM` (1536 — matches ``text-embedding-3-small`` and
+the ``memories.embedding`` column declared in migration 0002).
+"""
+from __future__ import annotations
+
+import hashlib
+import logging
+import math
+import os
+from typing import List, Optional
+
+logger = logging.getLogger(__name__)
+
+EMBEDDING_DIM = 1536  # locked by migration 0002
+
+
+def _hash_embed(text: str) -> List[float]:
+    """Deterministic PRNG-style embedding derived from SHA-256 of the
+    input. Produces the same vector for the same input, normalized to
+    unit length so cosine distance is well-behaved."""
+    seed = hashlib.sha256(text.encode("utf-8")).digest()
+    # Repeat-hash to fill 1536 floats in [-1, 1).
+    vec: List[float] = []
+    buf = seed
+    while len(vec) < EMBEDDING_DIM:
+        buf = hashlib.sha256(buf).digest()
+        for i in range(0, len(buf), 4):
+            if len(vec) >= EMBEDDING_DIM:
+                break
+            n = int.from_bytes(buf[i:i + 4], "big", signed=False)
+            vec.append((n / 0xFFFFFFFF) * 2 - 1)
+    # L2-normalize
+    norm = math.sqrt(sum(x * x for x in vec)) or 1.0
+    return [x / norm for x in vec]
+
+
+def _openai_embed(text: str) -> Optional[List[float]]:
+    """Call an OpenAI-compatible ``/v1/embeddings`` endpoint. Returns
+    ``None`` on any failure so the caller can fall through to hash."""
+    api_key = os.environ.get("OPENAI_API_KEY")
+    if not api_key:
+        return None
+    base_url = os.environ.get(
+        "HERMES_EMBEDDING_BASE_URL", "https://api.openai.com/v1"
+    ).rstrip("/")
+    model = os.environ.get(
+        "HERMES_EMBEDDING_MODEL", "text-embedding-3-small"
+    )
+    try:
+        import httpx  # optional dep; bail if not installed
+    except ImportError:
+        logger.warning("httpx not installed — falling back to hash embedder")
+        return None
+    try:
+        with httpx.Client(timeout=15.0) as client:
+            resp = client.post(
+                f"{base_url}/embeddings",
+                headers={"Authorization": f"Bearer {api_key}"},
+                json={"model": model, "input": text[:8000]},
+            )
+            resp.raise_for_status()
+            data = resp.json()
+        vec = data["data"][0]["embedding"]
+        if len(vec) != EMBEDDING_DIM:
+            logger.warning(
+                "embedding dim mismatch: expected %d got %d — padding/truncating",
+                EMBEDDING_DIM, len(vec),
+            )
+            if len(vec) > EMBEDDING_DIM:
+                vec = vec[:EMBEDDING_DIM]
+            else:
+                vec = list(vec) + [0.0] * (EMBEDDING_DIM - len(vec))
+        return [float(x) for x in vec]
+    except Exception as exc:
+        logger.warning("openai embedding failed: %r — falling back to hash", exc)
+        return None
+
+
+def _minimax_embed(text: str) -> Optional[List[float]]:
+    """MiniMax 原生 /v1/embeddings(embo-01, 1536 维,国内可达)。
+    用 MINIMAX_EMBEDDING_API_KEY 或现成的 MINIMAX_CODING_API_KEY。
+    格式:请求 {model, texts:[...], type:"db"};响应 {vectors:[[...]]}。失败返回 None 走 hash。"""
+    api_key = (os.environ.get("MINIMAX_EMBEDDING_API_KEY")
+               or os.environ.get("MINIMAX_CODING_API_KEY")
+               or os.environ.get("MINIMAX_API_KEY"))
+    if not api_key:
+        return None
+    base_url = os.environ.get(
+        "MINIMAX_EMBEDDING_BASE_URL", "https://api.minimaxi.com/v1"
+    ).rstrip("/")
+    model = os.environ.get("MINIMAX_EMBEDDING_MODEL", "embo-01")
+    try:
+        import httpx
+    except ImportError:
+        logger.warning("httpx not installed — falling back to hash embedder")
+        return None
+    try:
+        with httpx.Client(timeout=15.0) as client:
+            resp = client.post(
+                f"{base_url}/embeddings",
+                headers={"Authorization": f"Bearer {api_key}"},
+                json={"model": model, "texts": [text[:8000]], "type": "db"},
+            )
+            resp.raise_for_status()
+            data = resp.json()
+        vec = (data.get("vectors") or [None])[0]
+        if not vec:
+            logger.warning("minimax embedding empty: %s", data.get("base_resp"))
+            return None
+        if len(vec) != EMBEDDING_DIM:
+            logger.warning("minimax embedding dim %d != %d — pad/trunc", len(vec), EMBEDDING_DIM)
+            vec = vec[:EMBEDDING_DIM] if len(vec) > EMBEDDING_DIM else list(vec) + [0.0]*(EMBEDDING_DIM-len(vec))
+        return [float(x) for x in vec]
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("minimax embedding failed: %r — falling back to hash", exc)
+        return None
+
+
+def embed(text: str) -> List[float]:
+    """Embed *text* into a :data:`EMBEDDING_DIM`-dim unit vector."""
+    if not text:
+        text = ""
+    provider = os.environ.get("HERMES_EMBEDDING_PROVIDER", "").strip().lower()
+    if provider == "hash":
+        return _hash_embed(text)
+    if provider == "minimax":
+        vec = _minimax_embed(text)
+        return vec if vec is not None else _hash_embed(text)
+    # Default: try OpenAI, fall back to hash.
+    vec = _openai_embed(text) if provider in ("", "openai") else None
+    if vec is None:
+        return _hash_embed(text)
+    return vec
+
+
+__all__ = ["embed", "EMBEDDING_DIM"]
