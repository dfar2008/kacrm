--- /dev/null
+++ b/memory/ingest.py
@@ -0,0 +1,701 @@
+"""Interaction → Memory pipeline — charter 原语 ② ingestion.
+
+Reads recent rows from ``interactions`` and distills them into
+``memories`` + ``memory_entities``.
+
+Phase 0 behaviour (this module):
+- ingest one interaction into at most one ``memories`` row
+- entity extraction via a pluggable callable (default: naive regex on
+  CRM subjects + simple person-name heuristic)
+- no LLM dependency — the point is to get the storage + retrieval paths
+  working end-to-end with deterministic content
+
+Phase 1+ (future): swap the distiller for an LLM summarizer that produces
+richer facts, better entities, and typed edges.
+
+Fact ingestion is allowlisted to genuine customer-touchpoint /
+conversational ``interactions.kind`` values — ``im_message`` /
+``email`` / ``call`` / ``call_transcript`` / ``voice_memo`` /
+``meeting`` / ``meeting_note`` / ``note``. See :func:`_ingestible_kinds`.
+
+Agent execution traces — ``agent.message`` (incl. ``role='tool'`` tool
+results), ``action``, ``copilot_*``, ``auto_drive.*``, etc. — are NOT
+ingested as ``memories`` facts: ``_render_content`` renders them to raw
+JSON, which has no place in the customer-facing "facts" surface.
+``agent.message`` conversational text is still captured for cross-agent
+recall via the ``agent_messages.embedding`` column (filled by
+:func:`_fill_agent_message_embeddings`) — only its fact-ingestion path
+is closed. This narrows the broader vision in
+docs/2026-04-25-agent-message-as-event.md §四.
+
+Memory ingest is intentionally NOT triggered synchronously by emit().
+The celery beat (every 5 min, see celery_app.py memory_ingest_recent)
+processes recent interactions in batch — embedder calls + LLM entity
+extraction would otherwise add latency to every emit() and bottleneck
+the agent loop.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+from typing import Any, Callable, Dict, List, Optional, Tuple
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.memory.entities import (
+    add_edge, link_memory_to_entity, upsert_entity,
+)
+from hermes.memory.vector_store import upsert_memory
+
+
+def _llm_client():
+    """Lazy import — hermes/* must not import hermes_cloud/* at module load."""
+    from hermes_cloud.app.llm.profile_model_client import (
+        chat_once, parse_json_object, resolve_profile_default_model,
+    )
+    return chat_once, parse_json_object, resolve_profile_default_model
+
+logger = logging.getLogger(__name__)
+
+
+# Simple heuristic entity extractor. Good enough to seed the graph before
+# the LLM distiller lands.
+_CN_NAME_RE = re.compile(
+    r"(?:王|李|张|刘|陈|杨|黄|赵|吴|周|徐|孙|马|朱|胡|郭|林|何|高|罗|"
+    r"郑|梁|谢|宋|唐|许|韩|冯|邓|曹|彭|曾|肖|田|董|潘|袁|蔡|蒋|"
+    r"余|于|杜|叶|程|魏|苏|吕|丁|任|沈|姚|卢|傅|钟|姜|崔|谭|廖)"
+    r"[^\s，。！？、；：\d]{1,3}"
+)
+_COMPANY_SUFFIX_RE = re.compile(
+    r"[A-Za-z\u4e00-\u9fff][A-Za-z0-9\u4e00-\u9fff &.\-]{1,40}"
+    r"(?:Corp\.|Corp|Inc\.|Inc|Ltd\.|Ltd|LLC|公司|集团|科技|股份有限公司)"
+)
+
+
+# Noise filter shared by every extractor (regex + LLM). The naive
+# patterns above pick up plenty of non-entities: time words like
+# 「周一」 followed by a stray verb, surname + grammatical tail like
+# 「任何」/「黄了」, sentence fragments containing punctuation, etc.
+# Anything matching one of these traps gets dropped silently before
+# we hit the DB.
+_TIME_PREFIX_RE = re.compile(
+    r"^(?:周[一二三四五六日天]|本周|上周|下周|今[日天]|昨[日天]|明[日天])"
+)
+_STOPWORDS: set = {
+    "任何", "一些", "这个", "那个", "这里", "那里",
+    "他们", "我们", "你们", "自己",
+    "可以", "应该", "需要", "知道",
+    "什么", "怎么", "为啥", "为什么", "没有",
+    "黄了", "丢了", "完了", "好了", "对了",
+    "余文字",
+}
+# Characters that should never appear in a clean entity canonical —
+# they signal we grabbed a sentence fragment, not a name.
+_NOISE_CHARS = set("()（）[]【】《》\"'‘’“”、，。！？；：…—")
+
+
+# Leading-verb / pronoun prefixes — when an extracted canonical starts
+# with one of these we grabbed a sentence fragment, not a name.
+_VERB_PREFIX_RE = re.compile(
+    r"^(?:我|他|她|你|是|不是|实际|实际属|已|已经|已确认|再|再加|"
+    r"这个|那个|看看|找找|帮我|请|麻烦|可以|应该|建议|要|想|"
+    r"今天|刚才|刚刚|刚)"
+)
+
+# Surname + title — keep the title part as the canonical and chop any
+# trailing verb / particle tail. Applies to common honorifics.
+_TITLE_SUFFIX_RE = re.compile(
+    r"^([王李张刘陈杨黄赵吴周徐孙马朱胡郭林何高罗"
+    r"郑梁谢宋唐许韩冯邓曹彭曾肖田董潘袁蔡蒋"
+    r"余于杜叶程魏苏吕丁任沈姚卢傅钟姜崔谭廖])"
+    r"(?:[^\s总姐哥工]{0,2})"
+    r"(总|姐|哥|工|经理|老师|主任|师傅|医生)"
+)
+
+
+def _is_noisy_canonical(canonical: str) -> bool:
+    """True if the canonical looks like an extraction artifact."""
+    c = (canonical or "").strip()
+    if len(c) < 2:
+        return True
+    if c in _STOPWORDS:
+        return True
+    if _TIME_PREFIX_RE.match(c):
+        return True
+    if any(ch in _NOISE_CHARS for ch in c):
+        return True
+    # Surname + single grammatical particle (了/啊/吧/呢/吗/的) is
+    # almost always a sentence fragment, not a name. e.g. 「黄了」.
+    if len(c) == 2 and c[-1] in "了啊吧呢吗的":
+        return True
+    # Leading pronoun / verb — sentence fragment ("我来查这家公司",
+    # "实际属于X", "已确认X"). Real Chinese names rarely start with
+    # these characters.
+    if _VERB_PREFIX_RE.match(c):
+        return True
+    return False
+
+
+def normalize_canonical(entity_type: str, canonical: str) -> str | None:
+    """Return a cleaned canonical, or None if the entry should be
+    dropped entirely.
+
+    Applies the noise filter first. For person-type entities, if the
+    canonical matches surname + title + tail (e.g. 「陈总反馈」), strip
+    everything after the title — the entity's real identity is the
+    "陈总" prefix.
+    """
+    c = (canonical or "").strip()
+    if _is_noisy_canonical(c):
+        return None
+    if entity_type == "person":
+        m = _TITLE_SUFFIX_RE.match(c)
+        if m and m.end() < len(c):
+            # Truncate to the title boundary: keep "陈总", drop "反馈".
+            return c[: m.end()]
+    return c
+
+
+
+def default_extract_entities(
+    content: str, subjects: Optional[List[Dict[str, Any]]]
+) -> List[Tuple[str, str]]:
+    """Return a list of ``(entity_type, canonical)`` pairs."""
+    out: List[Tuple[str, str]] = []
+    seen: set = set()
+
+    # Legacy CRM-subject synthetic entities are now disabled by default.
+    # The canonical link path is direct subject -> record.memory_entity_id.
+    # Keep a compatibility escape hatch for old tooling.
+    if os.getenv("HERMES_MEMORY_LEGACY_CRM_SUBJECT_ENTITIES", "").strip().lower() in (
+        "1", "true", "yes", "on"
+    ):
+        for s in subjects or []:
+            if not isinstance(s, dict):
+                continue
+            mod = str(s.get("module") or "").strip().lower()
+            rid = s.get("id")
+            if mod and rid is not None:
+                key = (mod, str(rid))
+                if key not in seen:
+                    seen.add(key)
+                    out.append((f"crm:{mod}", f"{mod}#{rid}"))
+
+    text = content or ""
+    for m in _COMPANY_SUFFIX_RE.findall(text):
+        canonical = normalize_canonical("org", m)
+        if canonical is None:
+            continue
+        key = ("org", canonical.lower())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(("org", canonical))
+
+    for m in _CN_NAME_RE.findall(text):
+        canonical = normalize_canonical("person", m)
+        if canonical is None:
+            continue
+        key = ("person", canonical.lower())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(("person", canonical))
+
+    return out[:20]  # cap to keep ingestion bounded
+
+
+def _extract_entities_with_profile_model(
+    *,
+    content: str,
+    subjects: Optional[List[Dict[str, Any]]],
+    user_id: Optional[int],
+    db: DbWrapper,
+) -> tuple[List[Tuple[str, str]], Optional[str], Optional[str]]:
+    """Try LLM entity extraction via the user's default profile model."""
+    if not user_id:
+        return [], None, None
+    chat_once, parse_json_object, resolve_profile_default_model = _llm_client()
+    cfg = resolve_profile_default_model(user_id=int(user_id), profile_id=None, db=db)
+    if not cfg:
+        return [], None, None
+    subject_hint = []
+    for s in subjects or []:
+        if isinstance(s, dict):
+            mod = s.get("module")
+            rid = s.get("id")
+            if mod and rid is not None:
+                subject_hint.append(f"{mod}#{rid}")
+    text = (content or "").strip()
+    if len(text) > 3200:
+        text = text[:3200] + "…"
+    messages = [
+        {
+            "role": "system",
+            "content": (
+                "你是 CRM 实体抽取器。请输出 JSON 对象："
+                '{"entities":[{"entity_type":"org|person","canonical":"..."}]}。'
+                "不要输出其它文字。"
+            ),
+        },
+        {
+            "role": "user",
+            "content": (
+                f"subjects={subject_hint}\n"
+                f"text={text}\n"
+                "只抽 person/org，最多 12 个。"
+            ),
+        },
+    ]
+    reply = chat_once(cfg=cfg, messages=messages, max_tokens=280, temperature=0.1)
+    if not reply:
+        return [], cfg.model, cfg.source
+    obj = parse_json_object(reply) or {}
+    entities = obj.get("entities")
+    out: List[Tuple[str, str]] = []
+    seen: set[tuple[str, str]] = set()
+    if isinstance(entities, list):
+        for e in entities:
+            if not isinstance(e, dict):
+                continue
+            etype = str(e.get("entity_type") or "").strip().lower()
+            canonical = str(e.get("canonical") or "").strip()
+            if etype not in {"org", "person"}:
+                continue
+            cleaned = normalize_canonical(etype, canonical)
+            if cleaned is None:
+                continue
+            canonical = cleaned
+            key = (etype, canonical.lower())
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append((etype, canonical))
+            if len(out) >= 12:
+                break
+    return out, cfg.model, cfg.source
+
+
+def _render_content(row: Dict[str, Any]) -> str:
+    """Collapse an interactions row into the searchable text we embed."""
+    kind = row.get("kind") or ""
+    content = row.get("content")
+    if isinstance(content, str):
+        try:
+            content = json.loads(content)
+        except Exception:
+            return str(content)
+    if isinstance(content, dict):
+        parts: List[str] = [f"[{kind}]"]
+        for key in ("title", "subject", "message", "text", "body", "summary"):
+            v = content.get(key)
+            if v:
+                parts.append(str(v))
+        op = content.get("op")
+        if op:
+            fields = content.get("fields")
+            parts.append(f"op={op}")
+            if fields:
+                parts.append("fields=" + ",".join(map(str, fields)))
+        return " ".join(p for p in parts if p)
+    return f"[{kind}] {content}" if content else f"[{kind}]"
+
+
+# ---------------------------------------------------------------------------
+# Scope policy (charter §10 — cross-agent shared memory)
+# ---------------------------------------------------------------------------
+# Default: if an interaction references a CRM record (shared business
+# asset), the resulting memory is org-scoped so every salesperson /
+# agent working that same account benefits from it. Private interactions
+# (no CRM subject — e.g. a 1:1 chat that isn't tied to a record) stay
+# user-scoped.
+#
+# Override via env var HERMES_MEMORY_PRIVATE_KINDS = comma-separated
+# list of interaction.kind values that must always stay user-scoped
+# even when they reference a record (e.g. `personal_note,private_memo`).
+
+_PRIVATE_KINDS_ENV = "HERMES_MEMORY_PRIVATE_KINDS"
+
+
+def _private_kinds() -> set:
+    raw = os.environ.get(_PRIVATE_KINDS_ENV, "").strip()
+    if not raw:
+        return set()
+    return {s.strip() for s in raw.split(",") if s.strip()}
+
+
+# ---------------------------------------------------------------------------
+# Ingestion allowlist — only genuine customer-touchpoint / conversational
+# interactions become ``memories`` facts.
+# ---------------------------------------------------------------------------
+# Agent execution traces (agent.message, action, copilot_*, auto_drive.*,
+# dashboard_message, …) render to raw JSON via _render_content and have no
+# place in the customer-facing "facts" surface. We positively allowlist the
+# conversational kinds rather than denylist the noise: interactions.kind is
+# an open, ever-growing vocabulary, so a new system/agent kind must be
+# excluded by default. agent.message conversational text is still captured
+# for cross-agent recall via agent_messages.embedding (see
+# _fill_agent_message_embeddings) — only its fact-ingestion path is closed.
+#
+# Override via HERMES_MEMORY_INGEST_KINDS = comma-separated extra kinds;
+# the env list extends (never replaces) the defaults.
+
+_DEFAULT_INGESTIBLE_KINDS: frozenset = frozenset({
+    "im_message", "email", "call", "call_transcript", "call_log",
+    "voice_memo", "meeting", "meeting_note", "note",
+})
+_INGEST_KINDS_ENV = "HERMES_MEMORY_INGEST_KINDS"
+
+
+def _ingestible_kinds() -> set:
+    """Interaction kinds eligible for fact ingestion (defaults + env extras)."""
+    kinds = set(_DEFAULT_INGESTIBLE_KINDS)
+    raw = os.environ.get(_INGEST_KINDS_ENV, "").strip()
+    if raw:
+        kinds |= {s.strip() for s in raw.split(",") if s.strip()}
+    return kinds
+
+
+def _has_crm_subject(subjects: Optional[List[Any]]) -> bool:
+    for s in subjects or []:
+        if isinstance(s, dict) and s.get("module") and s.get("id") is not None:
+            return True
+    return False
+
+
+def _resolve_scope(
+    *,
+    interaction_kind: Optional[str],
+    subjects: Optional[List[Any]],
+    user_id: Optional[int],
+) -> Tuple[str, Optional[int]]:
+    """Return ``(scope, memory_user_id)``.
+
+    - interaction.kind in ``HERMES_MEMORY_PRIVATE_KINDS``  → user scope
+    - subjects contains a CRM record                       → org scope
+    - otherwise (no actor, no CRM record)                  → org scope
+    - fallback (has actor, no CRM record)                  → user scope
+    """
+    if interaction_kind and interaction_kind in _private_kinds():
+        return ("user" if user_id else "org", user_id if user_id else None)
+    if _has_crm_subject(subjects):
+        return ("org", None)
+    if user_id:
+        return ("user", user_id)
+    return ("org", None)
+
+
+def _actor_user_id(actors: Optional[List[Dict[str, Any]]]) -> Optional[int]:
+    for a in actors or []:
+        if not isinstance(a, dict):
+            continue
+        if (a.get("type") or "").lower() == "user":
+            try:
+                return int(a.get("id"))
+            except (TypeError, ValueError):
+                return None
+    return None
+
+
+def ingest_interaction(
+    interaction_id: str,
+    *,
+    extract_entities: Callable[[str, Optional[List[Dict[str, Any]]]],
+                               List[Tuple[str, str]]] = default_extract_entities,
+    kind: str = "fact",
+    db: Optional[DbWrapper] = None,
+) -> Optional[int]:
+    """Ingest one row from ``interactions`` into the Memory Substrate.
+
+    Returns the ``memories.id`` that was created, or ``None`` if the row
+    could not be ingested (missing, empty content, already ingested).
+    """
+    def _run(db: DbWrapper) -> Optional[int]:
+        row = db.fetchone(
+            "SELECT id, kind, occurred_at, actors, subjects, content, "
+            "source, provenance "
+            "FROM interactions WHERE id = %s",
+            (str(interaction_id),),
+        )
+        if not row:
+            return None
+
+        # Only genuine customer-touchpoint / conversational interactions
+        # become memories. Agent execution traces (agent.message, action,
+        # copilot_*, …) render to raw JSON and would pollute the
+        # customer-facing "facts" surface — skip them. See
+        # _ingestible_kinds() for the allowlist + HERMES_MEMORY_INGEST_KINDS.
+        if (row.get("kind") or "") not in _ingestible_kinds():
+            logger.debug(
+                "ingest_skip_kind id=%s kind=%s",
+                interaction_id, row.get("kind"),
+            )
+            return None
+
+        # Idempotency: skip if we already memory-ized this interaction.
+        already = db.fetchone(
+            "SELECT id FROM memories "
+            "WHERE source_refs @> %s::jsonb "
+            "LIMIT 1",
+            (json.dumps([{"interaction_id": str(interaction_id)}]),),
+        )
+        if already:
+            return int(already["id"])
+
+        content_text = _render_content(row)
+        stripped = content_text.strip()
+        # Empty, or just the bare ``[kind]`` tag (e.g. an im_message whose
+        # text field is blank) — no fact to store.
+        if not stripped or stripped == f"[{row.get('kind') or ''}]":
+            return None
+
+        user_id = _actor_user_id(row.get("actors"))
+        subjects = row.get("subjects") or []
+        if isinstance(subjects, str):
+            try:
+                subjects = json.loads(subjects)
+            except Exception:
+                subjects = []
+
+        scope, mem_user_id = _resolve_scope(
+            interaction_kind=row.get("kind"),
+            subjects=subjects,
+            user_id=user_id,
+        )
+
+        mem_result = upsert_memory(
+            content=content_text,
+            kind=kind,
+            scope=scope,
+            user_id=mem_user_id,
+            title=row.get("kind"),
+            source_refs=[{"interaction_id": str(interaction_id)}],
+            meta={
+                "interaction_kind": row.get("kind"),
+                "source": row.get("source"),
+                "occurred_at": str(row.get("occurred_at") or ""),
+                "subjects": subjects,
+                "actor_user_id": user_id,  # keep for attribution queries
+            },
+            db=db,
+        )
+        # v2.3: upsert_memory returns UpsertResult; bail out on dedupe /
+        # soft-cap so we don't try to link entities to a non-existent row.
+        if mem_result.memory_id is None:
+            return None
+        mem_id = mem_result.memory_id
+
+        # Entity extraction + linking. Org-scoped memories produce
+        # org-scoped entities (user_id=None) so the graph is shared
+        # across the tenant; user-scoped memories get private entities.
+        entity_user_id = mem_user_id if scope == "user" else None
+
+        # Direct CRM subject → record.memory_entity_id linking.
+        # This closes the architectural gap between the CRM write-path
+        # hook (which populates <table>.memory_entity_id with the canonical
+        # org/person/lead/deal entity) and interaction ingestion (which
+        # used to create parallel ``crm:accounts#<id>`` entities). Now a
+        # memory derived from an interaction touching accounts#209 links
+        # directly to the same ``memory_entities`` row that accounts#209
+        # points at — so MemoryPanel / /entities/{id}/facts "just work".
+        _CRM_TABLES = {"accounts", "contacts", "leads", "potentials"}
+        for s in subjects or []:
+            if not isinstance(s, dict):
+                continue
+            mod = str(s.get("module") or "").strip().lower()
+            rid = s.get("id")
+            if mod not in _CRM_TABLES or rid is None:
+                continue
+            try:
+                # Record tables use ``<tbl>_id`` as PK (accounts_id, …).
+                rec = db.fetchone(
+                    f"SELECT memory_entity_id FROM {mod} WHERE {mod}_id = %s",
+                    (int(rid),),
+                )
+                canonical_eid = (rec or {}).get("memory_entity_id")
+                if canonical_eid:
+                    link_memory_to_entity(
+                        entity_id=int(canonical_eid), memory_id=mem_id,
+                        role="subject", db=db,
+                    )
+            except Exception:
+                logger.exception(
+                    "crm_subject_link_failed module=%s id=%s", mod, rid,
+                )
+
+        # Prefer profile-default model extraction; fallback to deterministic
+        # regex-based extraction when unavailable/failing.
+        llm_pairs, llm_model, llm_source = _extract_entities_with_profile_model(
+            content=content_text,
+            subjects=subjects,
+            user_id=user_id,
+            db=db,
+        )
+        pairs = llm_pairs or extract_entities(content_text, subjects)
+        if llm_pairs:
+            try:
+                db.execute(
+                    "UPDATE memories SET meta = COALESCE(meta, '{}'::jsonb) || %s::jsonb WHERE id = %s",
+                    (
+                        json.dumps(
+                            {
+                                "entity_extractor_source": llm_source or "profile_model",
+                                "entity_extractor_model": llm_model,
+                            },
+                            ensure_ascii=False,
+                        ),
+                        int(mem_id),
+                    ),
+                )
+            except Exception:
+                logger.exception("memory_meta_extractor_update_failed mem_id=%s", mem_id)
+        entity_ids: List[Tuple[str, int]] = []
+        for etype, canonical in pairs:
+            try:
+                eid = upsert_entity(
+                    entity_type=etype,
+                    canonical=canonical,
+                    user_id=entity_user_id,
+                    db=db,
+                )
+                link_memory_to_entity(
+                    entity_id=eid, memory_id=mem_id,
+                    role="mention", db=db,
+                )
+                entity_ids.append((etype, eid))
+            except Exception:
+                logger.exception(
+                    "entity_upsert_failed type=%s canonical=%s",
+                    etype, canonical,
+                )
+
+        # Naive co-mention edges: every pair within the same interaction
+        # gets a 'co_mentioned_in' edge. LLM distiller will refine this.
+        for i, (ta, a) in enumerate(entity_ids):
+            for tb, b in entity_ids[i + 1:]:
+                if a == b:
+                    continue
+                try:
+                    add_edge(
+                        src_entity_id=a, dst_entity_id=b,
+                        relation="co_mentioned",
+                        attributes={"interaction_id": str(interaction_id)},
+                        confidence=0.5,
+                        db=db,
+                    )
+                except Exception:
+                    logger.exception(
+                        "edge_insert_failed src=%s dst=%s", a, b,
+                    )
+
+        return mem_id
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def ingest_batch(
+    *,
+    since_minutes: int = 60,
+    limit: int = 200,
+    db: Optional[DbWrapper] = None,
+) -> int:
+    """Pull recent interactions and run :func:`ingest_interaction` on each.
+
+    Designed for the Celery beat task. Returns the number of rows
+    successfully memory-ized.
+
+    Also fills the ``agent_messages.embedding`` column for any rows
+    landed by ``PgSessionDB.append_message`` since the last beat —
+    Charter §一原语 ② Memory Substrate covers agent.message events
+    too. The embedding fill is gated by the
+    ``agent_messages_pending_embedding`` view (alembic 0032).
+    """
+    def _run(db: DbWrapper) -> int:
+        rows = db.fetchall(
+            """
+            SELECT i.id
+            FROM interactions i
+            LEFT JOIN memories m
+              ON m.source_refs @> jsonb_build_array(
+                   jsonb_build_object('interaction_id', i.id::text)
+                 )
+            WHERE i.created_at > now() - interval '%s minutes'
+              AND m.id IS NULL
+              AND i.kind = ANY(%s)
+            ORDER BY i.created_at ASC
+            LIMIT %s
+            """,
+            (int(since_minutes), list(_ingestible_kinds()), int(limit)),
+        ) or []
+        n = 0
+        for r in rows:
+            try:
+                if ingest_interaction(str(r["id"]), db=db) is not None:
+                    n += 1
+            except Exception:
+                logger.exception(
+                    "interaction_ingest_failed id=%s", r.get("id"),
+                )
+        # Fill agent_messages embeddings (best-effort; embed failures
+        # leave the row queued for next beat).
+        try:
+            n_emb = _fill_agent_message_embeddings(db, limit=int(limit))
+            if n_emb:
+                logger.info("agent_messages_embeddings_filled n=%d", n_emb)
+        except Exception:
+            logger.exception("fill_agent_message_embeddings_failed")
+        return n
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def _fill_agent_message_embeddings(db: DbWrapper, *, limit: int = 200) -> int:
+    """Embed pending ``agent_messages`` rows (Charter §一原语 ②).
+
+    Reads the ``agent_messages_pending_embedding`` view (alembic 0032)
+    which surfaces messages with ``embedding IS NULL AND content IS
+    NOT NULL``. For each batch row, calls the unified embedder and
+    UPDATEs the embedding column. Idempotent: a re-emitted row with
+    NULL embedding gets re-embedded; a row already filled is skipped
+    by the view's WHERE clause.
+    """
+    from hermes.memory.embedder import embed
+
+    rows = db.fetchall(
+        "SELECT id, content FROM agent_messages_pending_embedding "
+        "ORDER BY id ASC LIMIT %s",
+        (int(limit),),
+    ) or []
+    if not rows:
+        return 0
+    n = 0
+    for r in rows:
+        try:
+            vec = embed(r.get("content") or "")
+            if not vec:
+                continue
+            db.execute(
+                "UPDATE agent_messages SET embedding = %s::vector "
+                "WHERE id = %s",
+                (vec, int(r["id"])),
+            )
+            n += 1
+        except Exception:
+            logger.exception(
+                "agent_message_embedding_failed id=%s", r.get("id"),
+            )
+    return n
+
+
+__all__ = [
+    "default_extract_entities",
+    "ingest_interaction",
+    "ingest_batch",
+]
diff --git a/memory/normalize.py b/memory/normalize.py
new file mode 100644
index 0000000000..6c0c061f76
--- /dev/null
+++ b/memory/normalize.py
@@ -0,0 +1,34 @@
+"""Content normalization for stable SHA256 dedupe.
+
+Without normalization, "foo bar" / "foo  bar" / "foo\\nbar" all hash
+to different values and dedupe silently fails (codex round 2 #10).
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import unicodedata
+
+
+_WS_RUN = re.compile(r"\s+")
+
+
+def normalize_text(s: str) -> str:
+    s = unicodedata.normalize("NFC", s)
+    s = _WS_RUN.sub(" ", s).strip()
+    return s
+
+
+def normalize_json(obj) -> str:
+    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+
+
+def content_hash(content) -> str:
+    if isinstance(content, str):
+        canonical = normalize_text(content)
+    elif isinstance(content, (dict, list)):
+        canonical = normalize_json(content)
+    else:
+        canonical = str(content)
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
diff --git a/memory/provenance.py b/memory/provenance.py
new file mode 100644
index 0000000000..73c558b294
--- /dev/null
+++ b/memory/provenance.py
@@ -0,0 +1,37 @@
+"""Provenance helpers for memory retrieval.
+
+When a specialist runs memory.search, every result row should be
+recorded into interactions.content.retrieved_memories so RL training
+(§一原语 ⑦ Training Loop) can attribute cross-specialist memory reads
+back to the source specialist that wrote them.
+
+See docs/2026-04-26-v23-specialist-runtime-design.md §2.5.D.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List
+
+
+def format_retrieved_memories_provenance(
+    rows: List[Dict[str, Any]],
+) -> List[Dict[str, Any]]:
+    """Convert search_memories rows into provenance dicts.
+
+    Output shape per row:
+      {memory_id: int, source_agent: str|None, rank: int, score: float}
+
+    Rank is 1-indexed in result order. Score = similarity (cosine,
+    in [0,1] where 1 = identical).
+    """
+    return [
+        {
+            "memory_id": int(r["id"]),
+            "source_agent": r.get("source_agent"),
+            "rank": idx,
+            "score": float(r.get("similarity") or 0.0),
+        }
+        for idx, r in enumerate(rows, start=1)
+    ]
+
+
+__all__ = ["format_retrieved_memories_provenance"]
diff --git a/memory/quota.py b/memory/quota.py
new file mode 100644
index 0000000000..bc70b69b8a
--- /dev/null
+++ b/memory/quota.py
@@ -0,0 +1,56 @@
+"""Three-tier memory.upsert quota — codex round 2 #9.
+
+Soft (per-minute): logs WARN, returns False so caller skips the upsert
+without raising. Specialist sees no hard error and continues.
+
+Hard (per-hour, per-day): raises QuotaExceeded — escalates to alert.
+"""
+from __future__ import annotations
+
+import logging
+import time
+from collections import deque
+from threading import Lock
+
+
+log = logging.getLogger(__name__)
+
+
+class QuotaExceeded(RuntimeError):
+    pass
+
+
+class MemoryQuota:
+    def __init__(self, *, per_min: int, per_hour: int, per_day: int) -> None:
+        self.per_min = per_min
+        self.per_hour = per_hour
+        self.per_day = per_day
+        self._events: dict[str, deque[float]] = {}
+        self._lock = Lock()
+
+    def try_acquire(self, specialist: str) -> bool:
+        now = time.monotonic()
+        with self._lock:
+            q = self._events.setdefault(specialist, deque())
+            # Drop events older than 24h
+            day_cutoff = now - 86400
+            while q and q[0] < day_cutoff:
+                q.popleft()
+
+            in_min = sum(1 for t in q if t >= now - 60)
+            in_hour = sum(1 for t in q if t >= now - 3600)
+            in_day = len(q)
+
+            if in_day >= self.per_day:
+                raise QuotaExceeded(f"{specialist}: per-day hard cap {self.per_day}")
+            if in_hour >= self.per_hour:
+                raise QuotaExceeded(f"{specialist}: per-hour hard cap {self.per_hour}")
+            if in_min >= self.per_min:
+                log.warning(
+                    "memory.upsert soft cap hit: %s in last minute "
+                    "(per-minute soft cap=%d) — skipping", specialist, self.per_min,
+                )
+                return False
+
+            q.append(now)
+            return True
diff --git a/memory/redaction.py b/memory/redaction.py
new file mode 100644
index 0000000000..ca41c48241
--- /dev/null
+++ b/memory/redaction.py
@@ -0,0 +1,59 @@
+"""Secret-detect → BLOCK; PII-detect → shadow column.
+
+Replaces blanket app.rl.anonymizer for memory.upsert path because
+specialists legitimately need to share customer names / emails as
+context. RL training pipeline reads content_redacted instead of
+content when training cross-agent memory retrieval.
+"""
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+
+class SecretDetected(RuntimeError):
+    pass
+
+
+class ContentDecision:
+    CLEAN = "clean"
+    PII = "pii"
+
+
+@dataclass(frozen=True)
+class _Decision:
+    kind: str
+    content: str
+    content_redacted: str | None
+
+
+_SECRET_PATTERNS = [
+    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),                       # AWS access key
+    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
+    re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}\b"),           # Slack token
+    re.compile(r"\bgh[ps]_[A-Za-z0-9]{30,}\b"),                # GitHub token
+    re.compile(r"\bsk-[A-Za-z0-9]{20,}\b"),                    # OpenAI / Anthropic-style
+]
+
+_PII_REPLACEMENTS = [
+    (re.compile(r"\b[\w.+-]+@[\w-]+\.[\w.-]+\b"), "[email]"),
+    (re.compile(r"\b1[3-9]\d[\s-]?\d{4}[\s-]?\d{4}\b"), "[phone]"),  # CN mobile
+    (re.compile(r"\b(?:\d{15}|\d{18})\b"), "[id]"),                   # CN ID
+]
+
+
+def classify_content(content: str) -> _Decision:
+    for pat in _SECRET_PATTERNS:
+        if pat.search(content):
+            raise SecretDetected("memory upsert blocked: secret-shaped string detected")
+
+    redacted = content
+    has_pii = False
+    for pat, repl in _PII_REPLACEMENTS:
+        if pat.search(redacted):
+            has_pii = True
+            redacted = pat.sub(repl, redacted)
+
+    if has_pii:
+        return _Decision(kind=ContentDecision.PII, content=content, content_redacted=redacted)
+    return _Decision(kind=ContentDecision.CLEAN, content=content, content_redacted=None)
diff --git a/memory/vector_store.py b/memory/vector_store.py
new file mode 100644
index 0000000000..fb7a391d3b
--- /dev/null
+++ b/memory/vector_store.py
@@ -0,0 +1,274 @@
+"""CRUD + kNN over the ``memories`` table (charter 原语 ②).
+
+``memories`` was created in migration 0002 with an HNSW index on the
+``embedding`` column for cosine distance, extended in 0035 with a
+``content_redacted`` shadow column, and in 0036 with ``content_hash`` /
+``source_agent`` for per-specialist dedupe.
+
+This module offers three operations the rest of the app uses:
+
+- :func:`upsert_memory` — insert a distilled memory row, embedding
+  computed on the fly if not supplied. Runs the v2.3 specialist pipeline:
+  three-tier quota → secret/PII classifier → content-hash dedupe → INSERT.
+  Returns an :class:`UpsertResult` (see breaking-change note below).
+- :func:`search_memories` — kNN + scope/kind filters.
+- :func:`delete_memory` — evict a specific memory id.
+
+Breaking change (v2.3): ``upsert_memory`` now returns ``UpsertResult``
+instead of a bare ``int``. Callers should read ``.memory_id``.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional, Sequence
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.memory.embedder import embed, EMBEDDING_DIM
+from hermes.memory.normalize import content_hash as _content_hash
+from hermes.memory.quota import MemoryQuota
+from hermes.memory.redaction import classify_content
+
+logger = logging.getLogger(__name__)
+
+
+# Module-level singleton — the upsert path consults this on every call.
+# Tests monkeypatch this attribute to drop the caps. Per Charter §2.5.E:
+# 30/min soft, 300/h hard, 1500/day hard.
+_QUOTA = MemoryQuota(per_min=30, per_hour=300, per_day=1500)
+
+# Sentinel used as the quota / dedupe key when no specialist attribution
+# is supplied (legacy ingest paths that never identified themselves).
+_DEFAULT_SPECIALIST = "_default"
+
+
+@dataclass(frozen=True)
+class UpsertResult:
+    """Outcome of :func:`upsert_memory`.
+
+    * ``committed=True`` — a row was inserted; ``memory_id`` is its id.
+    * ``committed=False`` — no row inserted. ``reason`` is ``"soft_cap"``
+      (per-minute quota tripped) or ``"dedupe"`` (existing row matched on
+      ``(scope, source_agent, content_hash)``); for the dedupe case
+      ``memory_id`` is the existing row's id.
+
+    Hard-cap (per-hour / per-day) violations raise ``QuotaExceeded`` and
+    do not return. Secret-shaped strings raise ``SecretDetected``.
+    """
+    committed: bool
+    reason: Optional[str]
+    memory_id: Optional[int]
+
+
+def _vector_literal(vec: Sequence[float]) -> str:
+    """pgvector text-literal form: '[0.1,0.2,...]'"""
+    return "[" + ",".join(f"{float(x):.7f}" for x in vec) + "]"
+
+
+def upsert_memory(
+    *,
+    content: str,
+    kind: str = "fact",
+    scope: str = "user",
+    user_id: Optional[int] = None,
+    agent_id: Optional[int] = None,
+    source_agent: Optional[str] = None,
+    title: Optional[str] = None,
+    source_refs: Optional[List[Any]] = None,
+    confidence: float = 1.0,
+    meta: Optional[Dict[str, Any]] = None,
+    embedding: Optional[Sequence[float]] = None,
+    expires_at: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> UpsertResult:
+    """Insert a memory row through the v2.3 specialist pipeline.
+
+    Pipeline order (each step short-circuits the next on failure):
+
+    1. **Quota** — :data:`_QUOTA` keyed on ``source_agent`` (or the
+       ``_default`` sentinel). Soft cap returns ``UpsertResult(committed=
+       False, reason='soft_cap')``; hard caps raise ``QuotaExceeded``.
+    2. **Classify** — :func:`classify_content`. Secret → raises (never
+       returns). PII → fills the ``content_redacted`` shadow column.
+    3. **Dedupe** — sha256 over normalized content; if a row already
+       exists for ``(scope, source_agent, content_hash)`` we skip the
+       INSERT (and the embedding compute) and return the existing id
+       with ``reason='dedupe'``.
+    4. **Insert** — INSERT including the new columns.
+    """
+    if not content:
+        raise ValueError("content is required")
+    if scope not in ("user", "agent", "org"):
+        raise ValueError(f"scope must be user|agent|org, got {scope!r}")
+
+    # 1. Quota — let QuotaExceeded propagate; soft-cap returns False.
+    quota_key = source_agent or _DEFAULT_SPECIALIST
+    if not _QUOTA.try_acquire(quota_key):
+        return UpsertResult(committed=False, reason="soft_cap", memory_id=None)
+
+    # 2. Classify — SecretDetected propagates *before* we compute the
+    #    embedding (saves a model call on the failure path).
+    decision = classify_content(content)
+    content_redacted = decision.content_redacted  # None when CLEAN
+
+    # 3. Dedupe — compute hash and look up by (scope, source_agent, hash).
+    #    Short-circuits the embedding compute on a hit.
+    chash = _content_hash(content)
+
+    def _run(db: DbWrapper) -> UpsertResult:
+        # Dedupe lookup. NULL-safe equality on source_agent so legacy
+        # rows (with the _default sentinel) still dedupe correctly.
+        existing = db.fetchone(
+            """
+            SELECT id FROM memories
+            WHERE scope = %s
+              AND source_agent IS NOT DISTINCT FROM %s
+              AND content_hash = %s
+            LIMIT 1
+            """,
+            (scope, source_agent, chash),
+        )
+        if existing:
+            return UpsertResult(
+                committed=False,
+                reason="dedupe",
+                memory_id=int(existing["id"]),
+            )
+
+        # Only compute the embedding once we know we're inserting.
+        vec = list(embedding) if embedding is not None else embed(content)
+        if len(vec) != EMBEDDING_DIM:
+            raise ValueError(
+                f"embedding dim {len(vec)} != expected {EMBEDDING_DIM}"
+            )
+
+        row = db.fetchone(
+            """
+            INSERT INTO memories
+                (user_id, agent_id, scope, kind, title, content,
+                 content_redacted, content_hash, source_agent,
+                 embedding, source_refs, confidence, meta, expires_at)
+            VALUES (%s, %s, %s, %s, %s, %s,
+                    %s, %s, %s,
+                    %s::vector, %s::jsonb, %s, %s::jsonb, %s)
+            RETURNING id
+            """,
+            (
+                user_id, agent_id, scope, kind, title, content,
+                content_redacted, chash, source_agent,
+                _vector_literal(vec),
+                json.dumps(source_refs or []),
+                float(confidence),
+                json.dumps(meta or {}),
+                expires_at,
+            ),
+        )
+        return UpsertResult(
+            committed=True, reason=None, memory_id=int(row["id"]),
+        )
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def search_memories(
+    *,
+    query: str,
+    user_id: Optional[int] = None,
+    agent_id: Optional[int] = None,
+    scope: Optional[str] = None,
+    kind: Optional[str] = None,
+    top_k: int = 10,
+    min_similarity: float = 0.0,
+    db: Optional[DbWrapper] = None,
+) -> List[Dict[str, Any]]:
+    """kNN search over ``memories``. Returns rows with a ``similarity``
+    field in [0, 1] (1 = identical, via ``1 - cosine_distance``).
+    Filters:
+    - user_id: when set, restricts to that user's rows plus org rows
+    - agent_id: additional scope
+    - scope: explicit filter (overrides user/agent implicit)
+    - kind: fact / summary / preference / entity / skill / …
+    """
+    qv = embed(query)
+    clauses: List[str] = []
+    args: List[Any] = [_vector_literal(qv)]
+
+    if scope:
+        clauses.append("scope = %s")
+        args.append(scope)
+    elif user_id is not None:
+        # Default: user's own rows + org-shared
+        clauses.append("(user_id = %s OR scope = 'org')")
+        args.append(int(user_id))
+
+    if agent_id is not None:
+        clauses.append("(agent_id = %s OR agent_id IS NULL)")
+        args.append(int(agent_id))
+
+    if kind:
+        clauses.append("kind = %s")
+        args.append(kind)
+
+    clauses.append("(expires_at IS NULL OR expires_at > now())")
+
+    where = (" WHERE " + " AND ".join(clauses)) if clauses else ""
+    args.append(int(top_k))
+
+    def _run(db: DbWrapper) -> List[Dict[str, Any]]:
+        rows = db.fetchall(
+            f"""
+            SELECT id, user_id, agent_id, scope, kind, title, content,
+                   source_agent,
+                   source_refs, confidence, meta, created_at,
+                   1 - (embedding <=> %s::vector) AS similarity
+            FROM memories
+            {where}
+            ORDER BY embedding <=> %s::vector ASC
+            LIMIT %s
+            """,
+            # need query vector twice: once for similarity, once for order
+            (args[0], *args[1:-1], args[0], args[-1]),
+        ) or []
+        out: List[Dict[str, Any]] = []
+        for r in rows:
+            sim = float(r.get("similarity") or 0.0)
+            if sim < min_similarity:
+                continue
+            out.append({
+                "id": int(r["id"]),
+                "user_id": r.get("user_id"),
+                "agent_id": r.get("agent_id"),
+                "scope": r.get("scope"),
+                "kind": r.get("kind"),
+                "title": r.get("title"),
+                "content": r.get("content"),
+                "source_agent": r.get("source_agent"),
+                "source_refs": r.get("source_refs"),
+                "confidence": float(r.get("confidence") or 1.0),
+                "meta": r.get("meta"),
+                "created_at": str(r.get("created_at") or ""),
+                "similarity": sim,
+            })
+        return out
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
+def delete_memory(memory_id: int, *, db: Optional[DbWrapper] = None) -> None:
+    def _run(db: DbWrapper) -> None:
+        db.execute("DELETE FROM memories WHERE id = %s", (int(memory_id),))
+    if db is not None:
+        _run(db)
+    else:
+        with db_session() as owned:
+            _run(owned)
+
+
+__all__ = ["upsert_memory", "search_memories", "delete_memory", "UpsertResult"]
diff --git a/plugins/cloud-approval/__init__.py b/plugins/cloud-approval/__init__.py
