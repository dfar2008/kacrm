--- /dev/null
+++ b/crm/approval/__init__.py
@@ -0,0 +1,31 @@
+"""CRM approval engine — kacrm port.
+
+Ports ``app/models/approvals_db.py`` + ``app/api/approval/api.py`` from
+kacrm (MySQL) to PG.
+
+Tables (migration 0013):
+- ``approval_configs`` — per-module step template (``steps`` JSONB)
+- ``approvals`` — one row per submission instance
+- ``approval_steps`` — one row per step in the chain (``approver_ids`` CSV)
+
+Lifecycle::
+
+    create_chain(module_id, record_id, created_by)
+        → reads approval_configs.steps
+        → inserts approvals row (status='pending', current_step=1)
+        → inserts approval_steps rows (step 1 = 'pending', rest = 'waiting')
+
+    approve(approval_id, user_id, remark)
+        → marks current step 'passed'
+        → if last step: marks approval 'passed'
+        → else: advances current_step, flips next step to 'pending'
+
+    reject(approval_id, user_id, remark)
+        → marks current step + approval as 'rejected'
+
+    cancel(approval_id)
+        → marks approval 'cancelled' (revert path)
+"""
+from hermes.crm.approval.engine import ApprovalEngine
+
+__all__ = ["ApprovalEngine"]
diff --git a/crm/approval/engine.py b/crm/approval/engine.py
new file mode 100644
index 0000000000..659dc8193a
--- /dev/null
+++ b/crm/approval/engine.py
@@ -0,0 +1,681 @@
+"""Approval chain engine — PG port of kacrm approval lifecycle.
+
+Steps are stored as CSV ``approver_ids`` (matching kacrm); membership
+checks use PG's ``string_to_array`` instead of MySQL's ``FIND_IN_SET``.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+
+class ApprovalConfigNotFound(Exception):
+    pass
+
+
+class ApprovalEngine:
+    def __init__(self, db: DbWrapper) -> None:
+        self.db = db
+
+    # ---------------------------------------------------- config helpers
+
+    def get_config(self, module_id: int) -> Optional[Dict[str, Any]]:
+        return self.db.fetchone(
+            "SELECT module_id, steps, allow_edit_after_approve "
+            "FROM approval_configs WHERE module_id = %s",
+            (int(module_id),),
+        )
+
+    def save_config(
+        self,
+        module_id: int,
+        steps: List[Dict[str, Any]],
+        allow_edit_after_approve: int = 0,
+    ) -> None:
+        self.db.execute(
+            """
+            INSERT INTO approval_configs (module_id, steps, allow_edit_after_approve)
+            VALUES (%s, %s::jsonb, %s)
+            ON CONFLICT (module_id) DO UPDATE SET
+                steps = EXCLUDED.steps,
+                allow_edit_after_approve = EXCLUDED.allow_edit_after_approve,
+                updated_at = now()
+            """,
+            (int(module_id), json.dumps(steps), int(allow_edit_after_approve)),
+        )
+
+    # --------------------------------------------------------- chain ops
+
+    def has_pending(self, module_id: int, data_id: int) -> bool:
+        n = self.db.fetchone(
+            "SELECT COUNT(*) AS n FROM approvals "
+            "WHERE module_id = %s AND data_id = %s AND status = 'pending'",
+            (int(module_id), int(data_id)),
+        )
+        return int((n or {}).get("n") or 0) > 0
+
+    def has_passed(self, module_id: int, data_id: int) -> bool:
+        row = self.db.fetchone(
+            "SELECT COUNT(*) AS n FROM approvals "
+            "WHERE module_id = %s AND data_id = %s AND status = 'passed'",
+            (int(module_id), int(data_id)),
+        )
+        return int((row or {}).get("n") or 0) > 0
+
+    def submit_for_record(
+        self,
+        module_id: int,
+        data_id: int,
+        user_id: int,
+        steps: Optional[List[Dict[str, Any]]] = None,
+    ) -> Dict[str, Any]:
+        """把一条记录送进审批流。
+
+        - 模块未配 ``approval_config`` 且未显式传 steps -> ``{"skipped": "no_config"}``
+          (审批 = per-module opt-in:没定义就不审批,且不报错)
+        - 已有 pending 审批 -> ``{"skipped": "already_pending"}``
+        - 否则 create_chain -> ``{"submitted": True, "approval_id": int}``
+        """
+        if steps is None and not self.get_config(module_id):
+            return {"skipped": "no_config"}
+        if self.has_pending(module_id, data_id):
+            return {"skipped": "already_pending"}
+        approval_id = self.create_chain(module_id, data_id, user_id, steps)
+        self._writeback_status(module_id, data_id, "pending")
+        return {"submitted": True, "approval_id": approval_id}
+
+    def create_chain(
+        self,
+        module_id: int,
+        data_id: int,
+        created_by: int,
+        steps: Optional[List[Dict[str, Any]]] = None,
+    ) -> int:
+        """Create an approval instance + step rows. Returns approval_id.
+
+        If ``steps`` is omitted, uses ``approval_configs.steps`` for the
+        module. Raises :class:`ApprovalConfigNotFound` when neither is
+        available.
+        """
+        if steps is None:
+            cfg = self.get_config(module_id)
+            if not cfg or not cfg.get("steps"):
+                raise ApprovalConfigNotFound(
+                    f"no approval_configs row for module_id={module_id}"
+                )
+            cfg_steps = cfg["steps"]
+            if isinstance(cfg_steps, str):
+                cfg_steps = json.loads(cfg_steps)
+            steps = list(cfg_steps or [])
+
+        if not steps:
+            raise ValueError("approval chain requires at least one step")
+
+        row = self.db.fetchone(
+            """
+            INSERT INTO approvals (module_id, data_id, status, created_by,
+                                   current_step, created_at, updated_at)
+            VALUES (%s, %s, 'pending', %s, 1, now(), now())
+            RETURNING id
+            """,
+            (int(module_id), int(data_id), int(created_by)),
+        )
+        approval_id = int(row["id"])
+
+        for i, step in enumerate(steps):
+            status = "pending" if i == 0 else "waiting"
+            approver_ids = step.get("approver_ids") or step.get("users") or []
+            if isinstance(approver_ids, list):
+                approver_csv = ",".join(str(int(x)) for x in approver_ids if x)
+            else:
+                approver_csv = str(approver_ids or "")
+            step_name = step.get("step_name") or step.get("name") or f"Step {i + 1}"
+            self.db.execute(
+                """
+                INSERT INTO approval_steps
+                    (approval_id, step_order, step_name, approver_ids, status)
+                VALUES (%s, %s, %s, %s, %s)
+                """,
+                (approval_id, i + 1, step_name, approver_csv, status),
+            )
+
+        logger.info(
+            "approval_chain_created id=%s module=%s data=%s steps=%d",
+            approval_id, module_id, data_id, len(steps),
+        )
+        self._log(
+            "submit", approval_id=approval_id, module_id=int(module_id),
+            data_id=int(data_id), actor_id=int(created_by),
+            step_name=(steps[0].get("step_name") if steps else None),
+        )
+        return approval_id
+
+    # --------------------------------------------------- record writeback
+
+    def _record_approval_columns(self, table_name: str) -> set:
+        """该业务表里存在的审批回写列(approval_status/_user_id/_time)。"""
+        try:
+            rows = self.db.fetchall(
+                "SELECT column_name FROM information_schema.columns "
+                "WHERE table_name = %s AND column_name IN "
+                "('approval_status', 'approval_user_id', 'approval_time')",
+                (table_name,),
+            ) or []
+            return {r["column_name"] for r in rows}
+        except Exception:
+            return set()
+
+    def _writeback_status(
+        self,
+        module_id: int,
+        data_id: int,
+        status: Optional[str],
+        approver_id: Optional[int] = None,
+    ) -> None:
+        """把审批结果回写到业务记录的 approval_status/审批人/审批时间。
+
+        审批状态只活在 ``approvals`` 表是不够的——记录详情、列表筛选、
+        汇总都靠记录自身的 ``approval_status`` 字段。提交/通过/拒绝/撤销
+        时同步它,审批人/时间一并落到记录上。
+
+        全程 best-effort:模块无 table_name、表无这些列、或任何异常都
+        静默跳过,绝不阻断审批流(审批结果已在 approvals 表落库)。
+        """
+        try:
+            m = self.db.fetchone(
+                "SELECT table_name FROM modules WHERE id = %s", (int(module_id),)
+            )
+            table = (m or {}).get("table_name")
+            if not table:
+                return
+            cols = self._record_approval_columns(table)
+            if "approval_status" not in cols:
+                return
+            sets = ["approval_status = %s"]
+            params: List[Any] = [status]
+            if "approval_user_id" in cols:
+                sets.append("approval_user_id = %s")
+                params.append(int(approver_id) if approver_id else None)
+            if "approval_time" in cols:
+                sets.append("approval_time = now()" if approver_id else "approval_time = NULL")
+            params.append(int(data_id))
+            self.db.execute(
+                f'UPDATE "{table}" SET {", ".join(sets)} WHERE {table}_id = %s',
+                tuple(params),
+            )
+            logger.info(
+                "approval_status writeback module=%s data=%s status=%s approver=%s",
+                module_id, data_id, status, approver_id,
+            )
+        except Exception:
+            logger.exception(
+                "approval status writeback failed module=%s data=%s", module_id, data_id
+            )
+
+    def _log(
+        self,
+        action: str,
+        *,
+        approval_id: int,
+        module_id: Optional[int] = None,
+        data_id: Optional[int] = None,
+        step_order: Optional[int] = None,
+        step_name: Optional[str] = None,
+        actor_id: Optional[int] = None,
+        target_id: Optional[int] = None,
+        remark: str = "",
+    ) -> None:
+        """往 append-only ``approval_logs`` 追加一条操作流水(审计)。
+
+        每次 提交/通过/拒绝/退回/改派/撤销 都留痕、永不覆盖,补足
+        ``approval_steps`` 只存末次结果的盲点。best-effort:表不存在
+        (prod 未迁移)或任何异常都静默跳过,绝不阻断审批动作。
+        """
+        try:
+            self.db.execute(
+                "INSERT INTO approval_logs "
+                "(approval_id, module_id, data_id, action, step_order, "
+                " step_name, actor_id, target_id, remark) "
+                "VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)",
+                (
+                    int(approval_id), module_id, data_id, action, step_order,
+                    step_name, actor_id, target_id, remark or "",
+                ),
+            )
+        except Exception:
+            logger.exception(
+                "approval_logs insert failed action=%s approval=%s", action, approval_id
+            )
+
+    # ------------------------------------------------------- approve/reject
+
+    def approve(
+        self,
+        approval_id: int,
+        user_id: int,
+        remark: str = "",
+    ) -> Dict[str, Any]:
+        """Approve the current step as ``user_id``.
+
+        Returns ``{"status": "advanced"|"passed", "next_step": int|None}``.
+        Raises PermissionError if user is not in current step approvers.
+        """
+        approval = self.db.fetchone(
+            "SELECT id, module_id, data_id, current_step, status FROM approvals "
+            "WHERE id = %s FOR UPDATE",
+            (int(approval_id),),
+        )
+        if not approval:
+            raise ValueError(f"approval {approval_id} not found")
+        if approval["status"] != "pending":
+            raise ValueError(
+                f"approval {approval_id} is {approval['status']}, not pending"
+            )
+
+        cur_step = int(approval["current_step"])
+        step = self.db.fetchone(
+            "SELECT id, step_name, approver_ids FROM approval_steps "
+            "WHERE approval_id = %s AND step_order = %s FOR UPDATE",
+            (int(approval_id), cur_step),
+        )
+        if not step:
+            raise ValueError(f"approval {approval_id} step {cur_step} missing")
+
+        if not _user_in_csv(int(user_id), step.get("approver_ids") or ""):
+            raise PermissionError(
+                f"user {user_id} is not an approver of step {cur_step}"
+            )
+
+        self.db.execute(
+            "UPDATE approval_steps "
+            "SET status = 'passed', remark = %s, actual_approver_id = %s, "
+            "    approved_at = now() "
+            "WHERE id = %s",
+            (remark or "", int(user_id), int(step["id"])),
+        )
+        self._log(
+            "approve", approval_id=int(approval_id),
+            module_id=int(approval["module_id"]), data_id=int(approval["data_id"]),
+            step_order=cur_step, step_name=step.get("step_name"),
+            actor_id=int(user_id), remark=remark or "",
+        )
+
+        next_step = self.db.fetchone(
+            "SELECT id, step_order FROM approval_steps "
+            "WHERE approval_id = %s AND step_order = %s",
+            (int(approval_id), cur_step + 1),
+        )
+        if next_step:
+            self.db.execute(
+                "UPDATE approval_steps SET status = 'pending' WHERE id = %s",
+                (int(next_step["id"]),),
+            )
+            self.db.execute(
+                "UPDATE approvals SET current_step = %s, updated_at = now() "
+                "WHERE id = %s",
+                (int(next_step["step_order"]), int(approval_id)),
+            )
+            return {"status": "advanced", "next_step": int(next_step["step_order"])}
+
+        # last step passed
+        self.db.execute(
+            "UPDATE approvals SET status = 'passed', current_step = 0, "
+            "updated_at = now() WHERE id = %s",
+            (int(approval_id),),
+        )
+        self._writeback_status(
+            int(approval["module_id"]), int(approval["data_id"]),
+            "approved", approver_id=int(user_id),
+        )
+        return {"status": "passed", "next_step": None}
+
+    def reject(
+        self,
+        approval_id: int,
+        user_id: int,
+        remark: str = "",
+    ) -> Dict[str, Any]:
+        approval = self.db.fetchone(
+            "SELECT id, module_id, data_id, current_step, status FROM approvals "
+            "WHERE id = %s FOR UPDATE",
+            (int(approval_id),),
+        )
+        if not approval:
+            raise ValueError(f"approval {approval_id} not found")
+        if approval["status"] != "pending":
+            raise ValueError(
+                f"approval {approval_id} is {approval['status']}, not pending"
+            )
+
+        cur_step = int(approval["current_step"])
+        step = self.db.fetchone(
+            "SELECT id, step_name, approver_ids FROM approval_steps "
+            "WHERE approval_id = %s AND step_order = %s FOR UPDATE",
+            (int(approval_id), cur_step),
+        )
+        if not step:
+            raise ValueError(f"approval {approval_id} step {cur_step} missing")
+        if not _user_in_csv(int(user_id), step.get("approver_ids") or ""):
+            raise PermissionError(
+                f"user {user_id} is not an approver of step {cur_step}"
+            )
+
+        self.db.execute(
+            "UPDATE approval_steps "
+            "SET status = 'rejected', remark = %s, actual_approver_id = %s, "
+            "    approved_at = now() "
+            "WHERE id = %s",
+            (remark or "", int(user_id), int(step["id"])),
+        )
+        self.db.execute(
+            "UPDATE approvals SET status = 'rejected', current_step = 0, "
+            "updated_at = now() WHERE id = %s",
+            (int(approval_id),),
+        )
+        self._writeback_status(
+            int(approval["module_id"]), int(approval["data_id"]),
+            "rejected", approver_id=int(user_id),
+        )
+        self._log(
+            "reject", approval_id=int(approval_id),
+            module_id=int(approval["module_id"]), data_id=int(approval["data_id"]),
+            step_order=cur_step, step_name=step.get("step_name"),
+            actor_id=int(user_id), remark=remark or "",
+        )
+        return {"status": "rejected", "next_step": None}
+
+    def cancel(self, approval_id: int) -> None:
+        row = self.db.fetchone(
+            "SELECT module_id, data_id FROM approvals "
+            "WHERE id = %s AND status = 'pending'",
+            (int(approval_id),),
+        )
+        self.db.execute(
+            "UPDATE approvals SET status = 'cancelled', current_step = 0, "
+            "updated_at = now() WHERE id = %s AND status = 'pending'",
+            (int(approval_id),),
+        )
+        if row:
+            # 撤回审批 → 清空记录上的审批状态/审批人/时间
+            self._writeback_status(
+                int(row["module_id"]), int(row["data_id"]), None
+            )
+            self._log(
+                "cancel", approval_id=int(approval_id),
+                module_id=int(row["module_id"]), data_id=int(row["data_id"]),
+            )
+
+    # ------------------------------------------------------------- transfer
+
+    def transfer(
+        self,
+        approval_id: int,
+        from_user_id: int,
+        to_user_id: int,
+    ) -> Dict[str, Any]:
+        """Swap ``from_user_id`` → ``to_user_id`` in every pending/waiting
+        step's ``approver_ids`` for this approval.
+
+        Matches kacrm ``ApprovalStepsDb::update_approval_step_approvers``
+        semantics: only touches in-flight steps (pending + waiting), leaves
+        already-decided steps intact.
+        """
+        approval = self.db.fetchone(
+            "SELECT id, module_id, data_id, status FROM approvals WHERE id = %s FOR UPDATE",
+            (int(approval_id),),
+        )
+        if not approval:
+            raise ValueError(f"approval {approval_id} not found")
+        if approval["status"] != "pending":
+            raise ValueError(
+                f"approval {approval_id} is {approval['status']}, cannot transfer"
+            )
+
+        steps = self.db.fetchall(
+            "SELECT id, approver_ids FROM approval_steps "
+            "WHERE approval_id = %s AND status IN ('pending','waiting')",
+            (int(approval_id),),
+        ) or []
+
+        from_s = str(int(from_user_id))
+        to_s = str(int(to_user_id))
+        touched = 0
+        for s in steps:
+            ids = [p.strip() for p in (s.get("approver_ids") or "").split(",") if p.strip()]
+            if from_s not in ids:
+                continue
+            new_ids = [to_s if p == from_s else p for p in ids]
+            # Dedup while preserving order.
+            seen = set()
+            deduped = []
+            for p in new_ids:
+                if p not in seen:
+                    seen.add(p)
+                    deduped.append(p)
+            self.db.execute(
+                "UPDATE approval_steps SET approver_ids = %s WHERE id = %s",
+                (",".join(deduped), int(s["id"])),
+            )
+            touched += 1
+
+        self.db.execute(
+            "UPDATE approvals SET updated_at = now() WHERE id = %s",
+            (int(approval_id),),
+        )
+        logger.info(
+            "approval_transfer id=%s from=%s to=%s touched_steps=%d",
+            approval_id, from_user_id, to_user_id, touched,
+        )
+        self._log(
+            "transfer", approval_id=int(approval_id),
+            module_id=int(approval["module_id"]), data_id=int(approval["data_id"]),
+            actor_id=int(from_user_id), target_id=int(to_user_id),
+        )
+        return {"touched_steps": touched}
+
+    # ------------------------------------------------------- back-to-step
+
+    def back_to_step(
+        self,
+        approval_id: int,
+        user_id: int,
+        target_step: int,
+        remark: str = "",
+    ) -> Dict[str, Any]:
+        """Send the approval back to an earlier step.
+
+        Current step becomes ``'backed'``; the target step is re-opened as
+        ``'pending'``; any steps between are reset to ``'waiting'`` so the
+        chain re-advances cleanly. ``current_step`` is set to ``target_step``.
+
+        kacrm parity: matches the "回退" behavior in ``approval/api.py``.
+        """
+        approval = self.db.fetchone(
+            "SELECT id, module_id, data_id, current_step, status FROM approvals "
+            "WHERE id = %s FOR UPDATE",
+            (int(approval_id),),
+        )
+        if not approval:
+            raise ValueError(f"approval {approval_id} not found")
+        if approval["status"] != "pending":
+            raise ValueError(
+                f"approval {approval_id} is {approval['status']}, not pending"
+            )
+        cur_step = int(approval["current_step"])
+        target = int(target_step)
+        if target < 1 or target >= cur_step:
+            raise ValueError(
+                f"target_step {target} must be >=1 and < current_step {cur_step}"
+            )
+
+        cur_row = self.db.fetchone(
+            "SELECT id, step_name, approver_ids FROM approval_steps "
+            "WHERE approval_id = %s AND step_order = %s FOR UPDATE",
+            (int(approval_id), cur_step),
+        )
+        if not cur_row:
+            raise ValueError(f"step {cur_step} missing for approval {approval_id}")
+        if not _user_in_csv(int(user_id), cur_row.get("approver_ids") or ""):
+            raise PermissionError(
+                f"user {user_id} is not an approver of step {cur_step}"
+            )
+
+        # Mark current as 'backed', intermediates as 'waiting', target as 'pending'.
+        self.db.execute(
+            "UPDATE approval_steps SET status = 'backed', remark = %s, "
+            "    actual_approver_id = %s, approved_at = now() "
+            "WHERE id = %s",
+            (remark or "", int(user_id), int(cur_row["id"])),
+        )
+        if cur_step - target > 1:
+            self.db.execute(
+                "UPDATE approval_steps SET status = 'waiting' "
+                "WHERE approval_id = %s AND step_order > %s AND step_order < %s",
+                (int(approval_id), target, cur_step),
+            )
+        self.db.execute(
+            "UPDATE approval_steps SET status = 'pending' "
+            "WHERE approval_id = %s AND step_order = %s",
+            (int(approval_id), target),
+        )
+        self.db.execute(
+            "UPDATE approvals SET current_step = %s, updated_at = now() "
+            "WHERE id = %s",
+            (target, int(approval_id)),
+        )
+        logger.info(
+            "approval_back id=%s from_step=%s to_step=%s user=%s",
+            approval_id, cur_step, target, user_id,
+        )
+        # target_id 语义为「改派目标用户」,退回的目标是步号不是用户,故放 remark。
+        _back_remark = f"退回至第{target}步" + (f":{remark}" if remark else "")
+        self._log(
+            "back", approval_id=int(approval_id),
+            module_id=int(approval["module_id"]), data_id=int(approval["data_id"]),
+            step_order=cur_step, step_name=cur_row.get("step_name"),
+            actor_id=int(user_id), remark=_back_remark,
+        )
+        return {
+            "status": "backed",
+            "from_step": cur_step,
+            "to_step": target,
+        }
+
+    # ----------------------------------------------------------- queries
+
+    def pending_for_user(
+        self, user_id: int, limit: int = 50
+    ) -> List[Dict[str, Any]]:
+        return self.db.fetchall(
+            """
+            SELECT a.id, a.module_id, a.data_id, a.created_by,
+                   m.name AS module_name, m.table_name,
+                   s.step_name, s.step_order, a.created_at
+            FROM approvals a
+            JOIN approval_steps s
+              ON s.approval_id = a.id AND s.status = 'pending'
+            JOIN modules m ON m.id = a.module_id
+            WHERE %s = ANY (string_to_array(s.approver_ids, ',')::int[])
+              AND a.status = 'pending'
+            ORDER BY a.created_at DESC
+            LIMIT %s
+            """,
+            (int(user_id), int(limit)),
+        ) or []
+
+    def pending_count_for_user(self, user_id: int) -> int:
+        row = self.db.fetchone(
+            """
+            SELECT COUNT(DISTINCT a.id) AS n
+            FROM approvals a
+            JOIN approval_steps s
+              ON s.approval_id = a.id AND s.status = 'pending'
+            WHERE %s = ANY (string_to_array(s.approver_ids, ',')::int[])
+              AND a.status = 'pending'
+            """,
+            (int(user_id),),
+        )
+        return int((row or {}).get("n") or 0)
+
+    def get_detail(self, approval_id: int) -> Optional[Dict[str, Any]]:
+        approval = self.db.fetchone(
+            "SELECT * FROM approvals WHERE id = %s", (int(approval_id),)
+        )
+        if not approval:
+            return None
+        # 用户 id → 姓名(带缓存),供步骤审批人/操作人/改派目标共用。
+        name_cache: Dict[int, Optional[str]] = {}
+
+        def _name(uid: Optional[int]) -> Optional[str]:
+            if not uid:
+                return None
+            try:
+                key = int(uid)
+            except (TypeError, ValueError):
+                return None
+            if key not in name_cache:
+                try:
+                    u = self.db.fetchone(
+                        "SELECT realname, username FROM users WHERE id = %s", (key,)
+                    )
+                    name_cache[key] = (
+                        (u.get("realname") or u.get("username")) if u else None
+                    )
+                except Exception:
+                    name_cache[key] = None
+            return name_cache[key]
+
+        steps = self.db.fetchall(
+            "SELECT * FROM approval_steps WHERE approval_id = %s "
+            "ORDER BY step_order ASC",
+            (int(approval_id),),
+        ) or []
+        steps_out: List[Dict[str, Any]] = []
+        for s in steps:
+            sd = dict(s)
+            # 配置审批人(approver_ids CSV)→ 姓名列表,供待审/未来步骤
+            # 显示「该由谁审」(下一步审批人)。
+            sd["approver_names"] = [
+                n for n in (
+                    _name(p) for p in str(sd.get("approver_ids") or "").split(",")
+                    if p.strip()
+                ) if n
+            ]
+            # 已操作步骤:实际审批人姓名,前端显示「审批人 王钊」。
+            if sd.get("actual_approver_id"):
+                sd["actual_approver_name"] = _name(sd.get("actual_approver_id"))
+            steps_out.append(sd)
+
+        # 操作流水(审计):append-only，解析操作人/改派目标姓名。
+        # best-effort：approval_logs 未迁移(prod)或异常 → 空列表，不影响详情。
+        logs_out: List[Dict[str, Any]] = []
+        try:
+            logs = self.db.fetchall(
+                "SELECT * FROM approval_logs WHERE approval_id = %s "
+                "ORDER BY created_at ASC, id ASC",
+                (int(approval_id),),
+            ) or []
+            for lg in logs:
+                ld = dict(lg)
+                ld["actor_name"] = _name(ld.get("actor_id"))
+                ld["target_name"] = _name(ld.get("target_id"))
+                logs_out.append(ld)
+        except Exception:
+            logs_out = []
+
+        return {"approval": dict(approval), "steps": steps_out, "logs": logs_out}
+
+
+def _user_in_csv(user_id: int, csv: str) -> bool:
+    if not csv:
+        return False
+    parts = [p.strip() for p in csv.split(",") if p.strip()]
+    try:
+        return int(user_id) in {int(p) for p in parts}
+    except ValueError:
+        return False
diff --git a/crm/approval/guard.py b/crm/approval/guard.py
