+"""Edit / create form payload — Phase 1 slim port of kacrm's
+``app/includes/edit_query.py``.
+
+kacrm's EditQuery produced both ``form_fields`` (field metadata) AND a
+server-rendered ``form_html`` Twig string. hermes is API-first — the
+frontend renders forms from the metadata directly — so we skip the
+``form_html`` piece and return ``form_html = ""`` to preserve the shape.
+
+What we DO port verbatim:
+  * The top-level envelope shape (``success``, ``module_name``, ``data``,
+    ``has_products``, ``product_fields``, ``products``, etc.).
+  * The "initialize owner to current user on create" behaviour, which kacrm
+    does by pre-filling ``_OWNER_FIELD_TYPES`` fields in ``self.item``.
+  * The read-one query used for edit (``SELECT *, {pk} AS id, {name_col}
+    AS name FROM {table} WHERE {pk} = %s``).
+
+What we stub for Phase 2:
+  * ``form_html`` — always empty string (frontend renders).
+  * ``_build_products_payload`` — returns the empty envelope because Phase
+    1 modules have ``has_products = 0``.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.crm.functions import json_serializable
+from hermes.crm.models.module_fields_db import ModuleFieldsDb
+from hermes.crm.models.modules_db import ModulesDb
+
+
+_OWNER_FIELD_TYPES = ("ownerBy", "user")
+
+
+class EditQuery:
+    """Metadata-driven edit/create form loader."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+        self.module_id: Optional[int] = None
+        self.module: Optional[Dict[str, Any]] = None
+        self.table_name: Optional[str] = None
+        self.record_id: int = 0
+        self.item: Dict[str, Any] = {}
+        self.is_create: bool = True
+
+    def _ensure_db(self) -> DbWrapper:
+        if self._db is None:
+            ctx = db_session()
+            self._db = ctx.__enter__()
+        return self._db
+
+    # ---- setters --------------------------------------------------------
+
+    def set_module(self, module_id: int) -> "EditQuery":
+        self.module_id = int(module_id)
+        db = self._ensure_db()
+        self.module = ModulesDb(db).get_module_info(self.module_id)
+        if not self.module:
+            raise ValueError("Module not found")
+        self.table_name = self.module.get("table_name") or self.module.get("name")
+        return self
+
+    def set_record_id(self, record_id: int) -> "EditQuery":
+        self.record_id = int(record_id or 0)
+        self.is_create = self.record_id <= 0
+        return self
+
+    # ---- main -----------------------------------------------------------
+
+    def execute(self, current_user_id: Optional[int] = None) -> Dict[str, Any]:
+        if not self.module or not self.table_name:
+            raise ValueError("Module not set")
+        db = self._ensure_db()
+        pk = f"{self.table_name}_id"
+        name_col = f"{self.table_name}_name"
+
+        # has_products: whitelist mirrors DetailQuery._load_line_items.
+        # The modules table doesn't carry a has_products column in this
+        # schema, so we pattern-match by name — quotes and salesorders
+        # are the only modules with a {module}_products line-item table
+        # (alembic 0011).
+        module_name = str(self.module.get("name") or "")
+        has_products = module_name in {"quotes", "salesorders"}
+        allow_adjust = bool(self.module.get("allow_adjust_product_total"))
+
+        mf_db = ModuleFieldsDb(db)
+        editable_fields = mf_db.get_editable_fields(self.module_id) or []
+
+        if self.is_create:
+            self.item = {"id": 0, "name": ""}
+            if current_user_id is not None:
+                for f in editable_fields:
+                    ft = (f.get("field_type") or "").strip()
+                    if ft not in _OWNER_FIELD_TYPES:
+                        continue
+                    fn = f.get("field_name")
+                    if not fn:
+                        continue
+                    cur = self.item.get(fn)
+                    if (
+                        cur is None
+                        or cur == ""
+                        or (isinstance(cur, str) and cur.strip() == "")
+                        or cur == 0
+                    ):
+                        self.item[fn] = int(current_user_id)
+            # Default-value prefill (spec §6.3). For each editable
+            # field, if its name isn't already populated (owner
+            # prefill above may have set some) and it carries a
+            # non-empty default_value, seed it. Lets the field
+            # builder's "default value" setting actually take effect
+            # on the create form.
+            for f in editable_fields:
+                fn = f.get("field_name")
+                if not fn or fn in self.item:
+                    continue
+                default = f.get("default_value")
+                if default is None or default == "":
+                    continue
+                self.item[fn] = default
+        else:
+            row = db.fetchone(
+                f"SELECT *, {pk} AS id, {name_col} AS name "
+                f"FROM {self.table_name} WHERE {pk} = %s",
+                (self.record_id,),
+            )
+            if not row:
+                raise ValueError("Record does not exist")
+            self.item = dict(row)
+
+        # Load existing line items for edit; create-mode starts empty.
+        # The frontend's LineItemsEditor renders them in a table and
+        # POSTs the updated array back as ``data.products`` on save.
+        line_items: list[Dict[str, Any]] = []
+        if has_products and not self.is_create:
+            line_items = self._load_line_items(module_name)
+
+        out = {
+            "success": True,
+            "module_name": self.module.get("name"),
+            "data": {
+                **self.item,
+                # Phase 1: frontend renders from form_fields. form_html kept
+                # in the envelope so kacrm-shaped consumers don't break.
+                "form_html": "",
+                "form_fields": editable_fields,
+                "relation_field_data": {},
+                "products": line_items,
+            },
+            "has_products": has_products,
+            "product_fields": [],
+            "allow_adjust_product_total": allow_adjust,
+            "products": line_items,
+        }
+        return json_serializable(out)
+
+    def _load_line_items(self, module_name: str) -> list[Dict[str, Any]]:
+        """Mirror of DetailQuery._load_line_items — populates the edit
+        form with the rows the user already has so the LineItemsEditor
+        can show them for tweaking instead of starting blank."""
+        if module_name not in {"quotes", "salesorders"}:
+            return []
+        table = f"{module_name}_products"
+        parent_col = f"{module_name}_id"
+        db = self._ensure_db()
+        try:
+            # SELECT * 把字段管理里给产品行加的自定义列(如 类型/field_picklist_1)
+            # 一并带给编辑表单,LineItemsEditor 才能元数据驱动地显示/回写它们。
+            rows = db.fetchall(
+                f"""
+                SELECT lp.*, lp.{table}_id AS line_id
+                  FROM {table} lp
+                 WHERE lp.{parent_col} = %s
+                 ORDER BY lp.{table}_id
+                """,
+                (int(self.record_id),),
+            )
+            return [dict(r) for r in (rows or [])]
+        except Exception:
+            return []
diff --git a/crm/field_writeback.py b/crm/field_writeback.py
new file mode 100644
index 0000000000..9c2171c336
--- /dev/null
+++ b/crm/field_writeback.py
@@ -0,0 +1,229 @@
+"""Field writeback — PG port of kacrm ``includes/field_writeback.py``.
+
+Propagates a value from a child record to a parent record when the child
+is saved. Supports six calc methods:
+
+- ``original`` — copy the source value verbatim
+- ``sum`` / ``avg`` / ``max`` / ``min`` — aggregate the source field across
+  all child rows sharing the same parent key
+- ``count`` — COUNT(source_field) across siblings
+
+All amount columns are NUMERIC since alembic 0079 — the kacrm-era
+JSONB ``currencyJson`` envelope (``{currency, amount, original_amount}``)
+is gone and the engine treats currency-typed source fields exactly like
+plain numbers.
+
+All dynamic identifiers go through :func:`_safe_ident` to block
+SQL injection via metadata.
+"""
+from __future__ import annotations
+
+import logging
+import re
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper
+
+logger = logging.getLogger(__name__)
+
+_IDENT_RE = re.compile(r"^[a-zA-Z_][a-zA-Z0-9_]*$")
+
+_VALID_CALC_METHODS = {"original", "sum", "avg", "count", "max", "min"}
+
+
+def _safe_ident(name: str) -> str:
+    if not _IDENT_RE.match(name or ""):
+        raise ValueError(f"unsafe identifier: {name!r}")
+    return f'"{name}"'
+
+
+class FieldWriteback:
+    def __init__(self, db: DbWrapper, user_id: int = 0) -> None:
+        self.db = db
+        self.user_id = int(user_id or 0)
+
+    # -------------------------------------------------------------- CRUD
+
+    def list_rules(self, module_id: int) -> List[Dict[str, Any]]:
+        if not module_id:
+            return []
+        return self.db.fetchall(
+            """
+            SELECT fw.*,
+                   m1.name AS source_module_name,
+                   m2.name AS target_module_name,
+                   f1.field_name AS source_field_name,
+                   f1.field_type AS source_field_type,
+                   f1.field_label AS source_field_label,
+                   f2.field_name AS target_field_name,
+                   f2.field_label AS target_field_label
+            FROM field_writeback fw
+            LEFT JOIN modules m1 ON m1.id = fw.source_module_id
+            LEFT JOIN modules m2 ON m2.id = fw.target_module_id
+            LEFT JOIN module_fields f1 ON f1.id = fw.source_field_id
+            LEFT JOIN module_fields f2 ON f2.id = fw.target_field_id
+            WHERE fw.source_module_id = %s
+            ORDER BY fw.id DESC
+            """,
+            (int(module_id),),
+        ) or []
+
+    def create_rule(self, data: Dict[str, Any]) -> Dict[str, Any]:
+        req = ("source_module_id", "source_field_id",
+               "target_module_id", "target_field_id")
+        for k in req:
+            if not data.get(k):
+                return {"success": False, "error": f"{k} is required"}
+        calc = (data.get("calc_method") or "original").lower()
+        if calc not in _VALID_CALC_METHODS:
+            return {"success": False,
+                    "error": f"calc_method must be one of {sorted(_VALID_CALC_METHODS)}"}
+
+        exists = self.db.fetchone(
+            """
+            SELECT id FROM field_writeback
+            WHERE source_module_id = %s AND source_field_id = %s
+              AND target_module_id = %s AND target_field_id = %s
+            """,
+            (int(data["source_module_id"]), int(data["source_field_id"]),
+             int(data["target_module_id"]), int(data["target_field_id"])),
+        )
+        if exists:
+            return {"success": False,
+                    "error": "a writeback rule with the same source/target already exists"}
+
+        row = self.db.fetchone(
+            """
+            INSERT INTO field_writeback
+                (source_module_id, source_field_id,
+                 target_module_id, target_field_id,
+                 calc_method, created_by, updated_by)
+            VALUES (%s, %s, %s, %s, %s, %s, %s)
+            RETURNING id
+            """,
+            (int(data["source_module_id"]), int(data["source_field_id"]),
+             int(data["target_module_id"]), int(data["target_field_id"]),
+             calc, self.user_id, self.user_id),
+        )
+        return {"success": True, "id": int(row["id"])}
+
+    def delete_rule(self, rule_id: int) -> Dict[str, Any]:
+        self.db.execute(
+            "DELETE FROM field_writeback WHERE id = %s", (int(rule_id),)
+        )
+        return {"success": True}
+
+    # -------------------------------------------------------- execution
+
+    def execute_writeback(self, module_id: int, row: Dict[str, Any]) -> None:
+        """Apply all writeback rules for ``module_id`` against ``row``.
+
+        ``row`` must be the just-saved source record (dict of column→value).
+        For each rule, if the row references a target record via
+        ``<target_table>_id`` foreign key, compute the new target value and
+        write it to the target field.
+        """
+        rules = self.db.fetchall(
+            """
+            SELECT fw.*,
+                   m1.table_name AS source_table_name,
+                   m2.table_name AS target_table_name,
+                   f1.field_name AS source_field_name,
+                   f1.field_type AS source_field_type,
+                   f2.field_name AS target_field_name
+            FROM field_writeback fw
+            LEFT JOIN modules m1 ON m1.id = fw.source_module_id
+            LEFT JOIN modules m2 ON m2.id = fw.target_module_id
+            LEFT JOIN module_fields f1 ON f1.id = fw.source_field_id
+            LEFT JOIN module_fields f2 ON f2.id = fw.target_field_id
+            WHERE fw.source_module_id = %s
+            """,
+            (int(module_id),),
+        ) or []
+
+        for rule in rules:
+            try:
+                self._apply_rule(rule, row)
+            except Exception:
+                logger.exception(
+                    "field_writeback rule %s failed", rule.get("id")
+                )
+
+    def _apply_rule(self, rule: Dict[str, Any], row: Dict[str, Any]) -> None:
+        source_field = rule.get("source_field_name") or ""
+        target_field = rule.get("target_field_name") or ""
+        source_table = rule.get("source_table_name") or ""
+        target_table = rule.get("target_table_name") or ""
+        if not (source_field and target_field and source_table and target_table):
+            return
+
+        # Validate every dynamic identifier before we splice it into SQL.
+        sf = _safe_ident(source_field)
+        tf = _safe_ident(target_field)
+        st = _safe_ident(source_table)
+        tt = _safe_ident(target_table)
+
+        target_fk_col = f"{target_table}_id"
+        if not _IDENT_RE.match(target_fk_col):
+            return
+        target_record_id = row.get(target_fk_col)
+        if target_record_id in (None, 0, "", "0"):
+            return
+
+        calc = (rule.get("calc_method") or "original").lower()
+        source_value = row.get(source_field)
+
+        # 'original' copies the row's own value; aggregates hit the
+        # table. The kacrm ``currencyJson`` special-case was removed in
+        # alembic 0079 — every amount column is now NUMERIC, so the
+        # source value is the number itself.
+        target_value: Any = None
+        if calc == "original":
+            if source_value is None:
+                return
+            target_value = source_value
+        else:
+            target_fk_q = _safe_ident(target_fk_col)
+            expr = self._aggregate_expr(calc, sf)
+            if expr is None:
+                return
+            sql = (
+                f"SELECT {expr} AS v FROM {st} "
+                f"WHERE {target_fk_q} = %s "
+                f"AND COALESCE(deleted::text, '0') NOT IN ('1','t','true')"
+                # deleted 列在现代表是 BOOLEAN、kacrm 遗留是 int;强转 text 比较
+                # 兼容两者,且避免 'boolean = integer' 类型错误。
+            )
+            result = self.db.fetchone(sql, (int(target_record_id),))
+            target_value = (result or {}).get("v")
+
+        if target_value is None:
+            return
+
+        self.db.execute(
+            f"UPDATE {tt} SET {tf} = %s, updated_by = %s, updated_at = now() "
+            f"WHERE {_safe_ident(target_table + '_id')} = %s",
+            (target_value, self.user_id, int(target_record_id)),
+        )
+        logger.debug(
+            "field_writeback rule=%s %s.%s -> %s.%s (%s)",
+            rule.get("id"), source_table, source_field,
+            target_table, target_field, calc,
+        )
+
+    @staticmethod
+    def _aggregate_expr(calc: str, source_field_q: str) -> Optional[str]:
+        # All amount columns are NUMERIC since alembic 0079 — no more
+        # JSONB envelope unwrapping. SQL aggregates apply to the column
+        # directly.
+        if calc == "sum":
+            return f"COALESCE(SUM({source_field_q}), 0)"
+        if calc == "avg":
+            return f"AVG({source_field_q})"
+        if calc == "max":
+            return f"MAX({source_field_q})"
+        if calc == "min":
+            return f"MIN({source_field_q})"
+        if calc == "count":
+            return f"COUNT({source_field_q})"
+        return None
