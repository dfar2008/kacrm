@@ -0,0 +1,372 @@
+"""Cloud request metadata carried through the API worker context."""
+
+from typing import Any, Dict, List, Optional
+import logging
+
+try:
+    from aiohttp import web
+except ImportError:
+    web = None
+
+from gateway.platforms.base import BasePlatformAdapter
+
+logger = logging.getLogger(__name__)
+
+
+class CloudAPIRoutesMixin:
+    def attach_peer_adapters(self, adapters: Dict[Any, BasePlatformAdapter]) -> None:
+        """Hand the live ``runner.adapters`` dict to this API server so
+        ``POST /internal/channel/push`` can dispatch a text message to
+        any connected platform by its string name (``feishu`` /
+        ``weixin`` / ``slack`` / …). The dict is kept as a reference
+        so adapters that connect after this call are still reachable.
+        """
+        self._peer_adapters = adapters
+
+    @staticmethod
+    def _cloud_requested_runtime(requested_model, cfg):
+        """Resolve cloud catalog credentials; the caller owns model precedence."""
+        if not isinstance(requested_model, str) or not requested_model.strip():
+            return None
+        requested_model = requested_model.strip()
+        for entry in (cfg or {}).get("custom_providers") or []:
+            if not isinstance(entry, dict) or requested_model not in (entry.get("models") or []):
+                continue
+            return dict(
+                model=requested_model, provider=entry.get("name") or "custom",
+                api_key=entry.get("api_key") or "", base_url=entry.get("base_url") or "",
+                api_mode=entry.get("api_mode") or "",
+                # Never carry the default provider's pool or subprocess transport
+                # into a cloud catalog selection. Construct the selected client once.
+                credential_pool=None, command=None, args=None)
+        return None
+
+    def _overlay_route_table(self) -> List[tuple]:
+        """Cloud-only overlay endpoints registered outside ``_http_route_table``.
+
+        Kept as a method (like ``_http_route_table``) so multiplex tests can
+        assert the /p/<profile>/ push mirror without starting a real listener.
+        """
+        return [
+            # Cloud proactive outbound — cloud pushes a coach hint / weekly
+            # report into whichever platform the user is bound to. Mirrored
+            # under /p/{profile}/ because with multiplex as the default
+            # topology the cloud tenant-prefixes EVERY internal URL
+            # (pm.mux_path_prefix), and a tenant's IM adapters live in
+            # GatewayRunner._profile_adapters, not the shared default map.
+            ("POST", "/internal/channel/push",
+             self._handle_internal_channel_push),
+            ("POST", "/p/{profile}/internal/channel/push",
+             self._handle_internal_channel_push),
+            # Cloud multiplex hot-reload — after a channel bind/rebind/unbind
+            # the cloud POSTs here to reconnect ONE profile's IM adapters
+            # without bouncing the shared gateway. Carries the profile in the
+            # path, so it needs no /p/{profile} mirror.
+            ("POST", "/internal/profiles/{profile}/reload-adapters",
+             self._handle_reload_profile_adapters),
+        ]
+
+    async def _handle_reload_profile_adapters(
+        self, request: "web.Request",
+    ) -> "web.Response":
+        """POST /internal/profiles/{profile}/reload-adapters — hot-reload one
+        multiplexed profile's IM adapters without bouncing the shared gateway.
+
+        Called by the cloud after a channel bind/rebind/unbind. Disconnects and
+        reconnects only the named profile's adapters. The active/default
+        profile is refused (409) because its adapters are owned by the shared
+        gateway and can't be torn down without dropping every tenant.
+
+        Auth: same Bearer token as the other internal endpoints (``API_SERVER_KEY``).
+        """
+        auth_err = self._check_auth(request)
+        if auth_err is not None:
+            return auth_err
+
+        profile = (request.match_info.get("profile") or "").strip()
+        if not profile:
+            return web.json_response(
+                {"error": {"message": "profile path segment is required.",
+                           "code": "missing_profile"}},
+                status=400,
+            )
+
+        runner = self.gateway_runner or request.app.get("gateway_runner")
+        if runner is None:
+            return web.json_response(
+                {"error": {"message": "Gateway runner is not attached yet.",
+                           "code": "runner_not_ready"}},
+                status=503,
+            )
+
+        try:
+            connected = await runner.reload_profile_adapters(profile)
+        except ValueError as e:
+            # Active/default profile → cannot hot-reload the shared gateway.
+            return web.json_response(
+                {"error": {"message": str(e),
+                           "code": "cannot_reload_active_profile"}},
+                status=409,
+            )
+        except Exception as e:
+            logger.error(
+                "reload-adapters failed for profile '%s': %s",
+                profile, e, exc_info=True,
+            )
+            return web.json_response(
+                {"error": {"message": f"reload failed: {e}",
+                           "code": "reload_failed"}},
+                status=500,
+            )
+
+        return web.json_response({"reloaded": profile, "connected": connected})
+
+    async def _handle_internal_channel_push(
+        self, request: "web.Request",
+    ) -> "web.Response":
+        """POST /internal/channel/push — proactive outbound via any adapter.
+
+        Also served at ``/p/{profile}/internal/channel/push``: with multiplex
+        as the default topology the cloud builds tenant-prefixed URLs
+        (``pm.mux_path_prefix``) for every internal call, and a tenant's IM
+        adapters live in ``GatewayRunner._profile_adapters`` — the bare path's
+        ``self._peer_adapters`` only carries the active/default profile's.
+
+        Body: ``{"platform": "feishu"|"weixin"|..., "channel_id": "...",
+        "text": "..."}``
+
+        Dispatches to the named platform adapter's ``send(channel_id,
+        text)`` method so cloud-side jobs (coach-hint push, weekly
+        report) can deliver a message through whichever channel the
+        user is bound to, without needing to reinvent per-platform auth.
+
+        Auth: same Bearer token as the other API Server endpoints
+        (``API_SERVER_KEY`` env / ``cfg.internal_key`` on the cloud
+        side).
+        """
+        auth_err = self._check_auth(request)
+        if auth_err is not None:
+            return auth_err
+
+        try:
+            body = await request.json()
+        except Exception:
+            return web.json_response(
+                {"error": {"message": "Invalid JSON body.",
+                           "code": "invalid_json"}},
+                status=400,
+            )
+        if not isinstance(body, dict):
+            return web.json_response({"error": {"message": "JSON body must be an object.",
+                                                "code": "invalid_json"}}, status=400)
+        platform_name = body.get("platform")
+        channel_id = body.get("channel_id")
+        if not isinstance(platform_name, str) or not isinstance(channel_id, str):
+            return web.json_response({"error": {"message": "platform and channel_id must be strings.",
+                                                "code": "missing_fields"}}, status=400)
+        platform_name = platform_name.strip().lower()
+        channel_id = channel_id.strip()
+        text = body.get("text")
+        if not platform_name or not channel_id or not isinstance(text, str) or text == "":
+            return web.json_response(
+                {"error": {"message": "platform, channel_id, text are required.",
+                           "code": "missing_fields"}},
+                status=400,
+            )
+
+        # Common aliases that cloud callers (or DB rows) use for the same
+        # underlying adapter. Kept narrow; extend here when a new one
+        # shows up in the wild.
+        _PLATFORM_ALIASES = {
+            "wechat": "weixin",
+            "lark": "feishu",
+        }
+        platform_name = _PLATFORM_ALIASES.get(platform_name, platform_name)
+
+        # Import locally — Platform enum and BasePlatformAdapter are the
+        # only touchpoints and keeping the import narrow avoids module
+        # load churn at startup.
+        from gateway.config import Platform
+
+        try:
+            platform = Platform(platform_name)
+        except ValueError:
+            return web.json_response(
+                {"error": {"message": f"Unknown platform: {platform_name}",
+                           "code": "unknown_platform"}},
+                status=400,
+            )
+
+        # Multiplex: a /p/<tenant>/ prefixed push targets that tenant's IM
+        # adapters, which live in GatewayRunner._profile_adapters — NOT in
+        # the shared default map (self._peer_adapters). The profile-prefix
+        # middleware already validated the profile against the served set
+        # and stored it in the request contextvar.
+        adapters = self._peer_adapters
+        from gateway.platforms.api_server import _api_request_profile
+        profile = _api_request_profile.get()
+        if profile:
+            runner = self.gateway_runner or request.app.get("gateway_runner")
+            tenant_maps = getattr(runner, "_profile_adapters", None)
+            tenant_map = (
+                tenant_maps.get(profile) if isinstance(tenant_maps, dict) else None
+            )
+            if tenant_map is not None:
+                adapters = tenant_map
+            elif profile not in (self._own_profile_name, "default"):
+                # A served secondary that never registered an adapter map
+                # (its startup was skipped on a config error). Falling back
+                # to the shared map would push through ANOTHER tenant's
+                # bot — refuse instead.
+                return web.json_response(
+                    {"error": {"message": f"Profile {profile} has no connected adapters.",
+                               "code": "profile_not_connected"}},
+                    status=503,
+                )
+            # else: /p/<active>/ — the gateway's own profile keeps its
+            # adapters in the shared runner.adapters (= self._peer_adapters);
+            # fall through to the default map.
+
+        if adapters is None:
+            return web.json_response(
+                {"error": {"message": "Gateway runner is not attached yet.",
+                           "code": "runner_not_ready"}},
+                status=503,
+            )
+        adapter = adapters.get(platform)
+        if adapter is None:
+            return web.json_response(
+                {"error": {"message": f"Platform {platform_name} is not connected.",
+                           "code": "platform_not_connected"}},
+                status=503,
+            )
+
+        try:
+            result = await adapter.send(channel_id, text)
+        except Exception as exc:
+            logger.exception(
+                "internal channel push: adapter.send failed platform=%s",
+                platform_name,
+            )
+            return web.json_response(
+                {"error": {"message": f"send failed: {exc}",
+                           "code": "adapter_send_failed"}},
+                status=502,
+            )
+
+        # SendResult has .success / .message_id / .error; tolerate an
+        # adapter that returns something else (defensive).
+        success = getattr(result, "success", True)
+        return web.json_response(
+            {
+                "ok": bool(success),
+                "message_id": getattr(result, "message_id", None),
+                "error": getattr(result, "error", None),
+            },
+            status=200 if success else 502,
+        )
+
+
+def bind_request_context(request, session_id):
+
+    # Bug C fix (2026-05-04) — propagate the originating channel
+    # from the cloud's inbound adapter (feishu_bridge / wechat
+    # touchpoint / etc.) into hermes' contextvar so any gateway
+    # action the agent emits gets ``origin.channel`` correctly
+    # tagged. Without this, every channel's gateway_actions row
+    # showed ``origin.channel = "webui"`` (the default), breaking
+    # Charter §1 渠道闭环 routing of approval prompts back to the
+    # source channel.
+    try:
+        _x_origin_ch = (request.headers.get(
+            "X-Hermes-Origin-Channel", "",
+        ) or "").strip()
+        if _x_origin_ch:
+            from hermes_cloud.app.bridge import origin_context as _origin_ctx
+            _origin_payload = {"channel": _x_origin_ch}
+            _ext_uid = (request.headers.get(
+                "X-Hermes-Origin-External-User-Id", "",
+            ) or "").strip()
+            if _ext_uid:
+                _origin_payload["external_user_id"] = _ext_uid
+            _origin_ctx.bind(_origin_payload)
+    except Exception:
+        pass  # never block request on origin tagging
+
+    # Charter v2 §定律 4 — cloud passes its authenticated user_id
+    # via X-Hermes-Cloud-User-Id so agent_sessions.user_id can be
+    # stamped correctly for chatbox / copilot / decisions /
+    # dashboards / TUI (all of which look like 'api_server'
+    # source). Without this, user_id stays NULL and the inbox
+    # can't attribute the session.
+    try:
+        _x_cloud_uid = (request.headers.get(
+            "X-Hermes-Cloud-User-Id", "",
+        ) or "").strip()
+        if _x_cloud_uid:
+            from gateway.session_context import _SESSION_USER_ID
+            _SESSION_USER_ID.set(_x_cloud_uid)
+    except Exception:
+        pass
+
+    # Cloud attachment-association support — expose the conversation id
+    # (X-Hermes-Session-Id) via HERMES_SESSION_ID so emit_business_write
+    # (cloud bridge, runs in this hermes process) can associate files
+    # uploaded in this conversation to records the agent creates this
+    # turn. Harmless for non-cloud callers (session_id is always set).
+    try:
+        from gateway.session_context import set_current_session_id
+        if session_id:
+            set_current_session_id(session_id)
+    except Exception:
+        pass
+
+    # Phase 4 patch 27 — surface ACL parsing.
+    # ``X-Hermes-Surface-ACL`` carries a compact JSON describing
+    # which tools the calling surface (SPA Copilot / 飞书 / iLink /
+    # auto_drive) is allowed to use this request. We bind it to a
+    # ContextVar; ``run_agent.AIAgent._invoke_tool`` enforces it
+    # before any tool dispatch. The LLM cannot see the ACL — it
+    # lives purely at the dispatch layer to defeat prompt-injection.
+    # Missing header = no enforcement (back-compat). Malformed JSON
+    # falls through to the same back-compat path so a typo doesn't
+    # break a request; surfaces should fix the value upstream.
+    try:
+        _x_surface_acl = (request.headers.get(
+            "X-Hermes-Surface-ACL", "",
+        ) or "").strip()
+        if _x_surface_acl:
+            import json as _json_acl
+            from tools.surface_acl import bind_surface_acl
+            try:
+                _acl_payload = _json_acl.loads(_x_surface_acl)
+                if isinstance(_acl_payload, dict):
+                    bind_surface_acl(_acl_payload)
+            except (ValueError, TypeError):
+                pass
+    except Exception:
+        pass  # never block request on ACL parsing
+
+    # Phase 5.1 patch 30 — surface scope parsing.
+    # ``X-Hermes-Scope`` carries {"kind":"team"|"org","user_ids":[...]}
+    # so CRM tools can apply WHERE owner_by = ANY(...) at the SQL
+    # layer. Same ContextVar pattern as surface_acl above.
+    # Missing header / malformed JSON / list shape error → fall
+    # back to caller-only ('self') view (fail-closed but
+    # back-compat for non-team-scope clients).
+    try:
+        _x_surface_scope = (request.headers.get(
+            "X-Hermes-Scope", "",
+        ) or "").strip()
+        if _x_surface_scope:
+            import json as _json_scope
+            from tools.scope import bind_surface_scope
+            try:
+                _scope_payload = _json_scope.loads(_x_surface_scope)
+                if isinstance(_scope_payload, dict):
+                    bind_surface_scope(_scope_payload)
+            except (ValueError, TypeError):
+                pass
+    except Exception:
+        pass  # never block request on scope parsing
+
