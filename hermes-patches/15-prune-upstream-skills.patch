-            xn = np.sin(a * y) - np.cos(b * x)
-            yn = np.sin(c * x) - np.cos(d * y)
-        elif attractor == "bedhead":
-            xn = np.sin(x * y / b) + np.cos(a * x - y)
-            yn = x * np.sin(a * y) + np.cos(b * x - y)
-        else:
-            xn = np.sin(a * y) + c * np.cos(a * x)
