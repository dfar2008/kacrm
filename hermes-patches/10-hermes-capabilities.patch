new file mode 100644
index 0000000000..94da8e0e9e
--- /dev/null
+++ b/crm/item_delete.py
@@ -0,0 +1,269 @@
+"""Record soft-delete — verbatim port of kacrm's
+``app/includes/item_delete.py``.
+
+Flow: load module + record → RBAC check → business-rule check
+(approval / stock) → flip ``deleted = TRUE`` on the main table and wipe
+any ``{table}_products`` line rows (Phase 2 modules only) → emit a
+changelog row.
+
+PG deviations from the MySQL original:
+  * ``deleted = 0`` → ``deleted = FALSE`` everywhere.
+  * ``UPDATE ... SET deleted = 1`` → ``SET deleted = TRUE``.
+  * ``(deleted = 0 OR deleted IS NULL)`` → ``(deleted = FALSE OR deleted IS NULL)``.
+
+Everything else — permission checks, approval gates, product-stock guards,
+the log-field-change emit — is preserved verbatim so future Phase-2 paths
+(``has_approval`` / ``has_products``) light up as soon as the underlying
+metadata is present.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.crm.functions import get_module_id_by_table_name
+from hermes.crm.models.changelog_db import ChangelogDb
+from hermes.crm.models.modules_db import ModulesDb
+from hermes.crm.permission import Permission
+
+
+class ItemDelete:
+    def __init__(self, db: Optional[DbWrapper] = None):
+        self.db = db
+        self.module_id: Optional[int] = None
+        self.record_id: Optional[int] = None
+        self.user_id: Optional[int] = None
+        self.module: Optional[Dict[str, Any]] = None
+        self.table_name: str = ""
+        self.record: Optional[Dict[str, Any]] = None
+        # ``source`` is plumbed into ``interactions.source`` on emit — same
+        # semantics as :class:`Save`. Default ``'manual'``; Phase 2 gateway
+        # overrides with ``'agent:<profile>:<agent_name>'`` for Agent deletes.
+        self.source: str = "manual"
+
+    def _ensure_db(self) -> DbWrapper:
+        if self.db is None:
+            # Borrow from the pool — same lazy pattern as ListQuery.
+            ctx = db_session()
+            self.db = ctx.__enter__()
+            self._owned_ctx = ctx
+        return self.db
+
+    def set_params(
+        self, module_id: int, record_id: int, user_id: int
+    ) -> "ItemDelete":
+        self.module_id = module_id
+        self.record_id = record_id
+        self.user_id = user_id
+        return self
+
+    def set_source(self, source: str) -> "ItemDelete":
+        """Override ``interactions.source`` for this delete."""
+        self.source = str(source or "manual").strip() or "manual"
+        return self
+
+    def execute(self) -> Dict[str, Any]:
+        self._load_module_info()
+        self._load_record_info()
+        self._check_permissions()
+        self._check_business_rules()
+        return self._perform_delete()
+
+    # ---- loaders --------------------------------------------------------
+
+    def _load_module_info(self) -> None:
+        db = self._ensure_db()
+        self.module = ModulesDb(db).get_module_info(self.module_id)
+        if not self.module:
+            raise ValueError("Module not found")
+        self.table_name = self.module["table_name"]
+
+    def _load_record_info(self) -> None:
+        db = self._ensure_db()
+        pk = f"{self.table_name}_id"
+        self.record = db.fetchone(
+            f"SELECT * FROM {self.table_name} "
+            f"WHERE {pk} = %s AND (deleted = FALSE OR deleted IS NULL)",
+            (self.record_id,),
+        )
+        if not self.record:
+            raise ValueError("Record not found")
+
+    # ---- guards ---------------------------------------------------------
+
+    def _check_permissions(self) -> None:
+        db = self._ensure_db()
+        perm = Permission(db)
+        if not perm.check_module_permission(self.user_id, self.module_id, "delete"):
+            raise PermissionError("No permission to execute this operation")
+        owner = self.record.get("owner_by") or 0
+        created = self.record.get("created_by") or 0
+        if not perm.check_record_permission(
+            self.module_id, self.user_id, self.record_id, owner, created, "delete"
+        ):
+            raise PermissionError("No permission to delete this record")
+
+    def _check_business_rules(self) -> None:
+        # 审批写锁:统一走 approval_guard(approvals 表为真相),取代旧的
+        # has_approval 字段判定(per-module approval_config opt-in)。
+        from hermes.crm.approval.guard import approval_guard
+        approval_guard(self._ensure_db(), self.module_id, self.record_id, self.source)
+        has_products = self.module.get("has_products") or 0
+        if has_products:
+            ws = str(
+                self.record.get("warehouse_status_key")
+                or self.record.get("warehouse_status")
+                or ""
+            )
+            if ws in ("stockin", "stockout"):
+                raise ValueError("Record has been stocked, cannot be deleted")
+
+    # ---- mutators -------------------------------------------------------
+
+    def _perform_delete(self) -> Dict[str, Any]:
+        self._delete_product_details()
+        self._soft_delete_main_record()
+        self._log_deletion()
+        self._emit_interaction()
+        self.after_delete()
+        return {"success": True}
+
+    def _emit_interaction(self) -> None:
+        """Append one ``interactions`` row describing this soft-delete.
+
+        Kept best-effort — a failure here must never leave the record
+        un-deleted for the caller's API contract. Phase 2's gateway
+        tightens this to same-txn semantics.
+        """
+        module_name = (self.module or {}).get("name") if self.module else None
+        if not module_name or self.record_id is None:
+            return
+        # Lazy: hermes/* must not import hermes_cloud/* at module load.
+        from hermes_cloud.app.interactions import emit as emit_interaction
+        try:
+            emit_interaction(
+                kind="action",
+                subjects=[
+                    {"module": module_name, "id": int(self.record_id)}
+                ],
+                actors=[{"type": "user", "id": int(self.user_id)}]
+                if self.user_id
+                else None,
+                content={"op": "delete"},
+                source=self.source,
+                db=self._ensure_db(),
+            )
+        except Exception:
+            pass
+
+    def _delete_product_details(self) -> None:
+        if (self.module.get("has_products") or 0) > 0:
+            db = self._ensure_db()
+            products_table = f"{self.table_name}_products"
+            pk = f"{self.table_name}_id"
+            try:
+                db.execute(
+                    f"DELETE FROM {products_table} WHERE {pk} = %s",
+                    (self.record_id,),
+                )
+            except Exception:
+                # The child product table may not yet exist for Phase 1
+                # modules — swallow the error and proceed with the main
+                # soft-delete (same as kacrm's behaviour).
+                pass
+
+    def _soft_delete_main_record(self) -> None:
+        db = self._ensure_db()
+        pk = f"{self.table_name}_id"
+        db.execute(
+            f"UPDATE {self.table_name} SET deleted = TRUE WHERE {pk} = %s",
+            (self.record_id,),
+        )
+
+    def _log_deletion(self) -> None:
+        db = self._ensure_db()
+        ChangelogDb(db).log_field_change(
+            self.module_id,
+            self.record_id,
+            "deleted",
+            "Deleted",
+            "status",
+            "0",
+            "1",
+            self.user_id,
+        )
+
+    # ---- coercion helpers ----------------------------------------------
+
+    @staticmethod
+    def _to_int(value: Any) -> int:
+        try:
+            return int(value or 0)
+        except (TypeError, ValueError):
+            return 0
+
+    @staticmethod
+    def _to_float(value: Any) -> float:
+        try:
+            if value is None or value == "":
+                return 0.0
+            return float(value)
+        except (TypeError, ValueError):
+            return 0.0
+
+    @staticmethod
+    def _as_dict(value: Any) -> dict[str, Any]:
+        if isinstance(value, dict):
+            return value
+        if value is None or value == "":
+            return {}
+        if isinstance(value, (bytes, bytearray)):
+            try:
+                value = value.decode("utf-8")
+            except Exception:
+                return {}
+        if not isinstance(value, str):
+            return {}
+        text = value.strip()
+        if not text:
+            return {}
+        try:
+            parsed = json.loads(text)
+            return parsed if isinstance(parsed, dict) else {}
+        except Exception:
+            return {}
+
+    def _log_if_changed(
+        self,
+        *,
+        table_name: str,
+        data_id: int,
+        field_name: str,
+        field_label: str,
+        field_type: str,
+        old_value: Any,
+        new_value: Any,
+    ) -> None:
+        if int(self.user_id or 0) <= 0:
+            return
+        if str(old_value) == str(new_value):
+            return
+        db = self._ensure_db()
+        module_id = int(get_module_id_by_table_name(table_name, db) or 0)
+        if module_id <= 0:
+            return
+        ChangelogDb(db).log_field_change(
+            module_id,
+            int(data_id or 0),
+            field_name,
+            field_label,
+            field_type,
+            old_value,
+            new_value,
+            int(self.user_id or 0),
+            commit=False,
+        )
+
+    def after_delete(self) -> None:  # pragma: no cover — subclass hook
+        pass
