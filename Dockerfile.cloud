FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed by some extras (ripgrep for code search,
# ffmpeg for media, procps for process management tools used by agent).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libffi-dev \
        ripgrep \
        procps \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency installation.
RUN pip install --no-cache-dir uv

# Copy dependency manifest first so Docker can cache the install layer
# independently of source code changes.
COPY pyproject.toml .
# A minimal stub so "pip install -e ." can resolve the package without the
# full source tree at dependency-install time.
RUN mkdir -p hermes_cloud && touch hermes_cloud/__init__.py

# Install all Python dependencies (no dev extras in production image).
# We install in --system mode because we own the entire container.
RUN uv pip install --system --no-cache "fastapi>=0.104.0,<1" "uvicorn[standard]>=0.24.0,<1" \
        "sqlalchemy>=2.0,<3" "psycopg2-binary>=2.9,<3" \
        "aiohttp>=3.13.3,<4" "pyyaml>=6.0.2,<7" \
        "python-dotenv>=1.2.1,<2" "openai>=2.21.0,<3" \
        "anthropic>=0.39.0,<1" "httpx[socks]>=0.28.1,<1" \
        "rich>=14.3.3,<15" "tenacity>=9.1.4,<10" \
        "jinja2>=3.1.5,<4" "pydantic>=2.12.5,<3" \
        "requests>=2.33.0,<3" "redis>=5.0,<6" \
        "PyJWT[crypto]>=2.12.0,<3"

# Copy full source — after the install layer so source changes don't bust
# the dependency cache.
COPY . .

# Re-install the local package itself (editable not available in non-dev images;
# use a regular install so the entry points are created).
RUN uv pip install --system --no-cache -e ".[all]" 2>/dev/null || \
    uv pip install --system --no-cache .

# Non-root user for security.
RUN useradd -m -u 1000 hermes
USER hermes

# Hermes Cloud writes nothing to the filesystem at runtime when using a
# remote database, but give it a writable home for any ephemeral state.
ENV HERMES_HOME=/home/hermes/.hermes
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

# Run the Hermes Cloud FastAPI app via uvicorn.
# Override CMD or set WORKERS env var to tune worker count.
CMD ["uvicorn", "hermes_cloud.app.dev_server:app", "--host", "0.0.0.0", "--port", "8080"]
