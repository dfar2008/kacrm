+import re as _re_mod_name
+_MODULE_NAME_RE = _re_mod_name.compile(r"^[a-z][a-z0-9_]*$")
+_MODULE_NAME_RESERVED = {
+    "user", "users", "select", "table", "order", "group", "index",
+    "collections", "module_fields", "schema_changelog", "field_proposals",
+}
