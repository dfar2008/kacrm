+# ---------------------------------------------------------------------------
+# §2.5.C — human-only tool registry
+# ---------------------------------------------------------------------------
+# Tools listed here are dangerous (gateway-state mutations, cron writes,
+# config writes, etc.) and must NEVER be exposed to specialist subagents.
+# Task 7's ``build_specialist_toolset()`` set-difference's its requested
+# toolset with this set, fail-closed even if ACL is misconfigured.
+#
+# At this stage the flag is metadata only — it does not affect runtime
+# dispatch. Task 13 will hook the closure-bound wrapper to enforce it.
+HUMAN_ONLY_TOOLS: set[str] = set()
+
+
+# §2.5.C — CRM gateway-state mutators that must NEVER be exposed to specialist
+# subagents. Until Charter v2 Phase 4b'.1.a (94ccbd3, 2026-05-06) these names
+# lived in the ``hermes_cloud.plugins.crm_tools`` entry-point plugin, whose
+# module-level ``HUMAN_ONLY_TOOL_NAMES`` ``bootstrap_plugins()`` folded into
+# :data:`HUMAN_ONLY_TOOLS`. That plugin was deleted when CRM tools became
+# first-class hermes built-ins (``hermes/tools/crm_tools.py``), so the source
+# of truth now lives here — next to ``build_crm_tools`` which builds them.
+# Keep in lock-step with the approval/writeback mutators in build_crm_tools().
+CRM_HUMAN_ONLY_TOOL_NAMES: frozenset[str] = frozenset({
+    "crm_approve_action",
+    "crm_reject_action",
+    "crm_approve_chain_step",
+    "crm_reject_chain_step",
+    "crm_set_approval_chain",
+    "crm_remove_approval_chain",
+    "crm_transfer_approval",
+    "crm_back_approval",
+    "crm_set_field_writeback_rule",
+    "crm_remove_field_writeback_rule",
+})
+
+
+def mark_tool_human_only(*names: str) -> None:
+    """Tag *names* as human-only. Idempotent."""
+    HUMAN_ONLY_TOOLS.update(names)
+
+
+def bootstrap_plugins() -> None:
+    """Import every hermes_cloud plugin module so that its module-level
+    ``HUMAN_ONLY_TOOL_NAMES`` constant is folded into :data:`HUMAN_ONLY_TOOLS`.
+
+    Side-effect: also runs each plugin's ``register(ctx)`` if a real
+    PluginContext is wired up by the caller. For pure metadata queries
+    (the common case in tests and in :func:`build_specialist_toolset`),
+    importing is enough — registration of the human-only flag does not
+    require ``CRM_USER_ID`` or any other runtime context.
+    """
+    import importlib
+    import pkgutil
+
+    import hermes_cloud.plugins as _plugins_pkg
+
+    for mod_info in pkgutil.iter_modules(_plugins_pkg.__path__):
+        full_name = f"{_plugins_pkg.__name__}.{mod_info.name}"
+        try:
+            mod = importlib.import_module(full_name)
+        except Exception as exc:  # pragma: no cover — plugin import failure is non-fatal
+            logger.warning("bootstrap_plugins: failed to import %s: %s", full_name, exc)
+            continue
+        names = getattr(mod, "HUMAN_ONLY_TOOL_NAMES", None)
+        if names:
+            mark_tool_human_only(*names)
+
+    # CRM gateway-state mutators are first-class hermes built-ins
+    # (``hermes/tools/crm_tools.py``) and no longer a ``hermes_cloud.plugins``
+    # module the loop above can discover. Fold their human-only set from the
+    # native source of truth defined in this module (see §2.5.C).
+    mark_tool_human_only(*CRM_HUMAN_ONLY_TOOL_NAMES)
+
+    # TEMP — hermes ships cronjob via legacy hermes/tools/cronjob_tools.py
+    # (registry.register), not the hermes_cloud.plugins protocol. Remove
+    # this hardcode once cronjob_tools migrates to expose
+    # HUMAN_ONLY_TOOL_NAMES and joins the bootstrap_plugins iteration.
+    # See spec §2.5.C — every cron mutator must be human-approved.
+    mark_tool_human_only("cronjob")
+
+
+def wrap_tool_with_ctx(underlying, *, ctx):
+    """Closure-bind a SpecialistRuntimeContext into a tool wrapper.
+
+    Used by hermes_cloud.app.agents.cloud_resolver (patch 12c) when
+    building a child specialist's ``_cloud_tool_overrides`` dict. Each
+    wrapper carries the child's ctx in its closure; when AIAgent's
+    dispatch path calls ``wrapper(**args)``, it forwards ``agent_name``
+    + ``origin`` to the underlying tool from the closure (not from a
+    global / agent attribute).
+
+    Fail-closed: if ``ctx`` is None at call time, raise RuntimeError.
+    NEVER fall back to webui or "manual" defaults (per design §2.5.A).
+    """
+    def wrapped(**kwargs):
+        if ctx is None:
+            raise RuntimeError(
+                "tool dispatched without specialist runtime ctx — "
+                "every cloud-side specialist tool requires explicit ctx"
+            )
+        return underlying(
+            agent_name=ctx.executing_specialist,
+            origin=ctx.origin,
+            **kwargs,
+        )
+
+    wrapped.__name__ = getattr(underlying, "__name__", "wrapped_tool")
+    return wrapped
+
+
+def lookup_underlying_tool(name: str):
+    """Resolve a tool name to the underlying callable from the hermes
+    tools registry. Returns None if the name isn't registered.
+
+    Used by the cloud resolver (patch 12c) to fetch a registered handler
+    before wrapping it with :func:`wrap_tool_with_ctx`.
+    """
+    try:
+        from tools.registry import registry
+    except Exception:  # pragma: no cover — registry import shouldn't fail
+        return None
+    entry = registry.get_entry(name)
+    if entry is None:
+        return None
+    return entry.handler
+
+
+__all__ = [
+    "ToolSpec",
+    "ToolNotFoundError",
+    "ToolPermissionError",
+    "build_crm_tools",
+    "dispatch",
+    "HUMAN_ONLY_TOOLS",
+    "CRM_HUMAN_ONLY_TOOL_NAMES",
+    "mark_tool_human_only",
+    "bootstrap_plugins",
+    "wrap_tool_with_ctx",
+    "lookup_underlying_tool",
+]
+
+
+
+def _dispatch_note_create(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    agent_name: Optional[str],
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """Append a note interaction. Phase 4 patch 28.
+
+    Writes ``kind='note'`` directly to ``interactions`` — no gateway,
+    no Trust Engine, no approval. Notes are pure history; the only
+    failure modes are validation errors (missing fields) and DB errors.
+    """
+    module = str(arguments.get("module") or "").strip()
+    try:
+        record_id = int(arguments.get("record_id") or 0)
+    except (TypeError, ValueError):
+        record_id = 0
+    text = str(arguments.get("text") or "").strip()
+    if not module or record_id <= 0 or not text:
+        return {
+            "success": False,
+            "error": "crm_note_create requires module, record_id, text",
+        }
+    if len(text) > 2000:
+        text = text[:2000]
+
+    actor_label = f"agent:{agent_name}" if agent_name else "agent:hermes"
+    content = {
+        "text": text,
+        "summary": text[:80],
+    }
+    actors = [
+        {"type": "user", "id": int(user_id)} if user_id else None,
+        {"type": "agent", "name": agent_name or "hermes", "profile_id": "hermes"},
+    ]
+    actors = [a for a in actors if a]
+    # Cloud SoT convention: subjects use ``id`` (not ``record_id``).
+    # The SPA timeline filters via ``subjects @> [{"module": ..., "id": ...}]``
+    # so writing ``record_id`` here makes the note silently invisible
+    # in the record page even though it lands in PG. Smoke caught this
+    # 2026-05-09 from a feishu-side ``记一笔`` request.
+    subjects = [{"module": module, "id": int(record_id)}]
+
+    def _do(owned: DbWrapper) -> Dict[str, Any]:
+        import json as _json
+        row = owned.fetchone(
+            """
+            INSERT INTO interactions
+                (kind, actors, subjects, content, source, occurred_at)
+            VALUES ('note', %s::jsonb, %s::jsonb, %s::jsonb, %s, NOW())
+            RETURNING id::text AS id
+            """,
+            (
+                _json.dumps(actors),
+                _json.dumps(subjects),
+                _json.dumps(content),
+                actor_label,
+            ),
+        )
+        return {
+            "success": True,
+            "interaction_id": row["id"] if row else None,
+            "module": module,
+            "record_id": record_id,
+        }
+
+    try:
+        if db is not None:
+            return _do(db)
+        with db_session() as owned:
+            return _do(owned)
+    except Exception as exc:
+        logger.exception("crm_note_create failed module=%s id=%s", module, record_id)
+        return {
+            "success": False,
+            "error": f"crm_note_create_failed: {type(exc).__name__}: {exc}",
+        }
+
+
+def _dispatch_list_related(
+    arguments: Dict[str, Any],
+    *,
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """Walk a FK relation between two CRM modules. Phase 4 patch 28.
+
+    Mirror of cloud's ``copilot/tools.py:_exec_list_related_records``,
+    including the reverse-edge support fixed during the chatbox-warning
+    bug (potentials → accounts/contacts).
+    """
+    current_module = str(arguments.get("current_module") or "").strip()
+    target = str(arguments.get("target_module") or "").strip()
+    status_kw = str(arguments.get("status_keyword") or "").strip()
+    try:
+        current_record_id = int(arguments.get("current_record_id") or 0)
+    except (TypeError, ValueError):
+        current_record_id = 0
+    try:
+        limit = int(arguments.get("limit") or 20)
+    except (TypeError, ValueError):
+        limit = 20
+    limit = max(1, min(limit, 50))
+
+    if not current_module or current_record_id <= 0 or not target:
+        return {
+            "success": False,
+            "error": (
+                "crm_list_related requires current_module, "
+                "current_record_id, target_module"
+            ),
+        }
+
+    spec = _RELATED_RECORDS_MAP.get((current_module, target))
+    if spec is None:
+        valid = sorted(t for (m, t) in _RELATED_RECORDS_MAP.keys()
+                       if m == current_module)
+        if target == current_module:
+            return {
+                "success": False,
+                "error": (
+                    f"target_module={target!r} is the SAME as current_module — "
+                    f"that's not a relation. From {current_module}, valid "
+                    f"target_module values: {valid}."
+                ),
+            }
+        return {
+            "success": False,
+            "error": (
+                f"No supported relation from {current_module!r} → {target!r}. "
+                f"From {current_module}, valid target_module values: {valid}."
+            ),
+        }
+
+    table, pk_col, name_col, fk_col, status_col = spec
+    reverse_fk_col: Optional[str] = None
+    poly_source: Optional[str] = None
+    if fk_col.startswith("_self_"):
+        reverse_fk_col = fk_col[len("_self_"):]
+        fk_col = pk_col
+    elif fk_col.startswith("_poly_"):
+        # Polymorphic FK on target: WHERE related_module=<source>
+        #   AND related_record_id=<current_record_id>.
+        poly_source = fk_col[len("_poly_"):]
+        fk_col = "related_record_id"
+
+    def _existing_columns(owned: DbWrapper, tbl: str) -> set:
+        try:
+            rows = owned.fetchall(
+                "SELECT column_name FROM information_schema.columns "
+                "WHERE table_schema = current_schema() AND table_name = %s",
+                (tbl,),
+            ) or []
+            return {r["column_name"] for r in rows}
+        except Exception:
+            return set()
+
+    def _do(owned: DbWrapper) -> Dict[str, Any]:
+        cols = _existing_columns(owned, table)
+        if pk_col not in cols or name_col not in cols or fk_col not in cols:
+            return {
+                "success": False,
+                "error": (
+                    f"Schema mismatch: {table} missing required column "
+                    f"({pk_col}/{name_col}/{fk_col})."
+                ),
+            }
+        if poly_source is not None and "related_module" not in cols:
+            return {
+                "success": False,
+                "error": (
+                    f"Schema mismatch: {table} missing polymorphic FK "
+                    "column 'related_module' (apply alembic 0094)."
+                ),
+            }
+        extras = [c for c in _RELATED_EXTRA_COLS.get(target, []) if c in cols]
+        select_parts = [f"{pk_col} AS id", f"{name_col} AS name"]
+        select_parts.extend(extras)
+        select_sql = ", ".join(select_parts)
+        where_parts: List[str] = []
+        params: List[Any] = []
+        if reverse_fk_col is not None:
+            cur_pk = f"{current_module}_id"
+            cur_cols = _existing_columns(owned, current_module)
+            if reverse_fk_col not in cur_cols:
+                return {
+                    "success": False,
+                    "error": (
+                        f"Schema mismatch: {current_module} missing FK "
+                        f"column {reverse_fk_col!r}."
+                    ),
+                }
+            cur_row = owned.fetchone(
+                f"SELECT {reverse_fk_col} AS fk FROM {current_module} "
+                f" WHERE {cur_pk} = %s LIMIT 1",
+                (int(current_record_id),),
+            )
+            fk_val = (cur_row or {}).get("fk")
+            if fk_val is None:
+                return {
+                    "success": True,
+                    "target_module": target,
+                    "filter": {},
+                    "count": 0,
+                    "items": [],
+                }
+            where_parts.append(f"{pk_col} = %s")
+            params.append(int(fk_val))
+        else:
+            where_parts.append(f"{fk_col} = %s")
+            params.append(int(current_record_id))
+            if poly_source is not None:
+                where_parts.append("related_module = %s")
+                params.append(poly_source)
+        where_parts.append("deleted = false")
+        if status_kw and status_col and status_col in cols:
+            where_parts.append(f"lower({status_col}) LIKE %s")
+            params.append(f"%{status_kw.lower()}%")
+        where_sql = " AND ".join(where_parts)
+        order_sql = "ORDER BY updated_at DESC NULLS LAST" if "updated_at" in cols else ""
+        sql = (
+            f"SELECT {select_sql} FROM {table} "
+            f" WHERE {where_sql} {order_sql} LIMIT %s"
+        )
+        params.append(limit)
+        rows = owned.fetchall(sql, tuple(params)) or []
+        items: List[Dict[str, Any]] = []
+        for r in rows:
+            item: Dict[str, Any] = {"id": int(r["id"]), "name": r.get("name")}
+            for col in extras:
+                v = r.get(col)
+                if v is None or v == "":
+                    continue
+                item[col] = v if isinstance(v, (int, float, str, bool)) else str(v)
+            items.append(item)
+        return {
+            "success": True,
+            "target_module": target,
+            "filter": {"status_keyword": status_kw} if status_kw else {},
+            "count": len(items),
+            "items": items,
+        }
+
+    try:
+        if db is not None:
+            return _do(db)
+        with db_session() as owned:
+            return _do(owned)
+    except Exception as exc:
+        logger.exception(
+            "crm_list_related failed %s/%s -> %s",
+            current_module, current_record_id, target,
+        )
+        return {
+            "success": False,
+            "error": f"crm_list_related_failed: {type(exc).__name__}: {exc}",
+        }
