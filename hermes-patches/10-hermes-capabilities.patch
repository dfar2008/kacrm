+"""Phase-1 stopgap regressions: .bak exclusion + skills-index budget cap.
+
+Context (2026-07-07 latency audit): 42 skills' frontmatter shipped a 64KB
+skills index into EVERY prompt (81% of the system prompt), and 5 stray
+``kacrm-guide.bak.*`` sync-backup directories were scanned as live skills
+(+8.4KB/call).
+"""
+from __future__ import annotations
+
+import pytest
+
+from agent import skill_utils as sku
+from agent import prompt_builder as pb
+
+
+# ── .bak exclusion ──────────────────────────────────────────────────────
+
+
+def _mk_skill(root, name, description="d"):
+    d = root / name
+    d.mkdir(parents=True)
+    (d / "SKILL.md").write_text(
