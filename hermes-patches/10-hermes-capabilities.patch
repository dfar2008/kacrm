+"""Prefix-stability probe regressions (2026-07-07 latency plan Phase 3).
+
+LongCat doesn't report ``cached_tokens`` even on verified implicit-cache
+hits, so hermes fingerprints the request prefix (system message + tools)
+itself and logs ``prefix=first|stable|changed`` per API call.
+"""
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from agent.conversation_loop import _update_prefix_probe
+
+
+def _msgs(system_text):
+    return [
+        {"role": "system", "content": system_text},
+        {"role": "user", "content": "hi"},
+    ]
+
+
+def test_first_then_stable():
+    agent = SimpleNamespace(tools=[{"name": "crm_search"}])
+    _update_prefix_probe(agent, _msgs("S"))
+    assert agent._prefix_probe_state == "first"
+    _update_prefix_probe(agent, _msgs("S"))
+    assert agent._prefix_probe_state == "stable"
+
+
+def test_system_change_detected():
+    agent = SimpleNamespace(tools=[])
+    _update_prefix_probe(agent, _msgs("S"))
+    _update_prefix_probe(agent, _msgs("S + timestamp 12:01"))
+    assert agent._prefix_probe_state == "changed"
+
+
+def test_tools_change_detected():
+    agent = SimpleNamespace(tools=[{"name": "a"}])
+    _update_prefix_probe(agent, _msgs("S"))
+    agent.tools = [{"name": "b"}]
+    _update_prefix_probe(agent, _msgs("S"))
+    assert agent._prefix_probe_state == "changed"
+
+
+def test_history_growth_is_not_prefix_change():
+    # Appending user/assistant turns must NOT flip the probe — history is
+    # append-only relative to the cached prefix.
+    agent = SimpleNamespace(tools=[{"name": "a"}])
+    _update_prefix_probe(agent, _msgs("S"))
+    longer = _msgs("S") + [
+        {"role": "assistant", "content": "reply"},
+        {"role": "user", "content": "more"},
+    ]
+    _update_prefix_probe(agent, longer)
+    assert agent._prefix_probe_state == "stable"
+
+
+def test_probe_never_raises():
+    agent = SimpleNamespace(tools=object())  # json-unfriendly
+    _update_prefix_probe(agent, [{"role": "system", "content": "S"}])
+    # default=str makes even odd objects serializable; state must be set.
+    assert agent._prefix_probe_state in {"first", "stable", "changed", "?"}
