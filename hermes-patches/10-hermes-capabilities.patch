+             patch('agent.turn_usage.calibrate_from_usage'), \
+             patch('agent.turn_usage.capture_usage_anchor', return_value=None), \
+             patch('agent.relay_llm.complete_logical_call', side_effect=lambda *a, **k: events.append('complete')) as completed:
+            verdict = turn_response_check.check_api_response(
