@@ -0,0 +1,61 @@
+"""Diagnose what's blocking a stuck deal; return short internal note (Phase 4 patch 26)."""
+from __future__ import annotations
+import logging
+from typing import Optional
+from hermes.skills._utils.llm import SkillLLMError, run_llm_utility
+from hermes.skills._utils.records import fetch_record_for_skill
+from hermes.skills._utils.skill_md import load_skill_body
+
+logger = logging.getLogger(__name__)
+_ANSWER_MARKER = "📊"
+
+
+def note_blocker(*, module: str, record_id: int) -> Optional[str]:
+    record = fetch_record_for_skill(module, record_id)
+    if record is None:
+        return None
+    try:
+        skill_body = load_skill_body("crm-analyst")
+    except FileNotFoundError as exc:
+        logger.error("crm-analyst SKILL.md missing: %s", exc)
+        return None
+    user_prompt = _build_user_prompt(record)
+    try:
+        text = run_llm_utility(
+            [{"role": "system", "content": skill_body},
+             {"role": "user", "content": user_prompt}],
+            temperature=0.2,
+        )
+    except SkillLLMError as exc:
+        logger.info("crm_analyst.note_blocker llm failed module=%s id=%s err=%s",
+                    module, record_id, exc)
+        return None
+    text = text.strip()
+    if _ANSWER_MARKER not in text:
+        logger.info("crm_analyst.note_blocker missing 📊 marker module=%s id=%s",
+                    module, record_id)
+        return None
+    return text
+
+
+def _build_user_prompt(record: dict) -> str:
+    name = record.get(f"{record['__module']}_name") or "(未命名)"
+    milestone = record.get("milestone") or "(unknown)"
+    closing = record.get("closing_date") or "(未设置)"
+    interactions = record.get("__recent_interactions") or []
+    int_lines = "\n".join(
+        f"- [{i.get('at', '')[:10]} {i.get('kind', '?')}] {i.get('preview', '')[:120]}"
+        for i in interactions[:5]
+    ) or "(无最近互动)"
+    return f"""分析下列 {record['__module']} 记录为什么卡住：
+
+记录: {name}
+阶段: {milestone}
+预计关闭: {closing}
+
+最近互动（从新到旧）：
+{int_lines}
+
+按 SKILL.md 的格式输出（📊 答案 / 📈 指标 / 💡 洞察 / ⚠️ 数据警告），
+仅输出这 4 段，不要前后解释、不要 markdown 章节标题。
+**只读分析**——不要建议起草邮件、不要建议建任务、不要给执行建议。"""
