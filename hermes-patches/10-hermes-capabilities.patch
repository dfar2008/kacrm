+"""Seed baseline rows into the CRM database.
+
+Run with::
+
+    python -m hermes.crm.seed
+
+This creates the default permissions/roles/departments/admin user so the
+stack is usable right after ``alembic upgrade head``. Safe to run multiple
+times — every insert is idempotent.
+"""
+from __future__ import annotations
+
+import os
+import secrets
+
+from hermes.crm.db import db_session
+from hermes.crm.models.users_db import UsersDb
+from hermes.crm.seed_metadata import seed_module_metadata
+
+
+DEFAULT_PERMISSIONS = [
+    ("index", "index", "Index"),
+    ("create", "create", "Create"),
+    ("update", "update", "Update"),
+    ("delete", "delete", "Delete"),
+    ("view", "view", "View"),
+    ("import", "import", "Import"),
+    ("export", "export", "Export"),
+    ("share", "share", "Share"),
+    ("massupdate", "massupdate", "Mass Update"),
+    ("massdelete", "massdelete", "Mass Delete"),
+]
+
+# Role grants: role_name -> list of (collection_name, [permission_codes])
+# This is the MATRIX that makes hermes_crm usable out of the box. Kept
+# intentionally narrow — production tenants can expand via admin UI later.
+#
+# Intentions:
+#   - General Manager: full control on every collection
+#   - Sales Manager:    full sales pipeline + read-only on supporting modules
+#   - Sales:            CRUD on leads/accounts/contacts; read-only on users/roles
+#   - Accounting:       read + export on everything (audit-style)
+#   - Support:          CRUD on contacts + read on accounts/leads
+#
+# We don't exhaustively enumerate every collection × every action; anything
+# missing simply evaluates to FALSE in the checker. Admins still bypass.
+DEFAULT_ROLE_GRANTS: dict = {
+    "General Manager": {
+        "*": ["index", "create", "update", "delete", "view", "import",
+              "export", "share", "massupdate", "massdelete"],
+    },
+    "Sales Manager": {
+        "accounts":    ["index", "create", "update", "delete", "view", "export", "share"],
+        "contacts":    ["index", "create", "update", "delete", "view", "export", "share"],
+        "leads":       ["index", "create", "update", "delete", "view", "export", "share"],
+        "potentials":  ["index", "create", "update", "delete", "view", "export"],
+        "quotes":      ["index", "create", "update", "delete", "view", "export"],
+        "salesorders": ["index", "create", "update", "delete", "view", "export"],
+        "tasks":       ["index", "create", "update", "view"],
+        "products":    ["index", "create", "update", "delete", "view"],
+        "receivables": ["index", "create", "update", "delete", "view", "export"],
+        "payments":    ["index", "create", "update", "delete", "view", "export"],
+        "users":       ["index", "view"],
+        "roles":       ["index", "view"],
+        "departments": ["index", "view"],
+    },
+    "Sales": {
+        "accounts":    ["index", "create", "update", "view"],
+        "contacts":    ["index", "create", "update", "view"],
+        "leads":       ["index", "create", "update", "view"],
+        "potentials":  ["index", "create", "update", "view"],
+        "quotes":      ["index", "create", "view"],
+        "salesorders": ["index", "view"],
+        "tasks":       ["index", "create", "update", "view"],
+        "products":    ["index", "view"],
+        "receivables": ["index", "view"],
+        "payments":    ["index", "view"],
+        "users":       ["index", "view"],
+        "roles":       ["index", "view"],
+        "departments": ["index", "view"],
+    },
+    "Accounting": {
+        "*": ["index", "view", "export"],
+    },
+    "Support": {
+        "contacts":    ["index", "create", "update", "view"],
+        "accounts":    ["index", "view"],
+        "leads":       ["index", "view"],
+        "tasks":       ["index", "create", "update", "view"],
+        "products":    ["index", "view"],
+        "users":       ["index", "view"],
+        "departments": ["index", "view"],
+    },
+}
+
+DEFAULT_ROLES = [
+    ("General Manager", True),
+    ("Sales Manager", True),
+    ("Sales", True),
+    ("Accounting", True),
+    ("Support", True),
+]
+
+DEFAULT_COLLECTIONS = [
+    ("accounts", "Customer"),
+    ("contacts", "Contacts"),
+    ("leads", "Leads"),
+    ("potentials", "Potentials"),
+    ("quotes", "Quotes"),
+    ("salesorders", "SalesOrder"),
+    ("tasks", "Tasks"),
+    ("products", "Products"),
+    ("receivables", "Receivables"),
+    ("payments", "Payments"),
+    ("users", "Users"),
+    ("roles", "Roles"),
+    ("departments", "Departments"),
+]
+
+DEFAULT_DEPARTMENTS = [
+    ("Company", None),
+]
+
+
+def _seed_role_permissions(db) -> None:  # type: ignore[no-untyped-def]
+    """Wipe-and-rewrite role_permissions from :data:`DEFAULT_ROLE_GRANTS`.
+
+    Safe to run repeatedly — the checker treats missing rows as FALSE, and
+    reinserting the same matrix yields the same effective state.
+    """
+    # Lookup tables
+    role_rows = db.fetchall("SELECT id, name FROM roles")
+    role_by_name = {r["name"]: int(r["id"]) for r in role_rows}
+    perm_rows = db.fetchall("SELECT id, code FROM permissions")
+    perm_by_code = {r["code"]: int(r["id"]) for r in perm_rows}
+    collection_rows = db.fetchall("SELECT id, name FROM collections")
+    collection_by_name = {r["name"]: int(r["id"]) for r in collection_rows}
+    all_collection_ids = list(collection_by_name.values())
+
+    for role_name, grants in DEFAULT_ROLE_GRANTS.items():
+        role_id = role_by_name.get(role_name)
+        if role_id is None:
+            continue
+
+        # Clear only the grants this role will REWRITE, so a re-seed stays
+        # deterministic for built-in modules WITHOUT wiping admin-granted
+        # permissions on custom modules (expenses/projects/… are never named
+        # in DEFAULT_ROLE_GRANTS). A "*" wildcard role manages every
+        # collection; a specific-grant role manages only its named ones.
+        if "*" in grants:
+            _managed_ids = list(all_collection_ids)
+        else:
+            _managed_ids = [
+                collection_by_name[k] for k in grants
+                if k in collection_by_name
+            ]
+        if _managed_ids:
+            db.execute(
+                "DELETE FROM role_permissions WHERE role_id = %s "
+                "AND module_id = ANY(%s)",
+                (role_id, _managed_ids),
+            )
+
+        rows_to_insert: list[tuple] = []
+        for collection_key, codes in grants.items():
+            if collection_key == "*":
+                target_ids = all_collection_ids
+            else:
+                cid = collection_by_name.get(collection_key)
+                if cid is None:
+                    continue
+                target_ids = [cid]
+
+            for module_id in target_ids:
+                for code in codes:
+                    pid = perm_by_code.get(code)
+                    if pid is None:
+                        continue
+                    rows_to_insert.append(
+                        (role_id, pid, module_id, True)
+                    )
+
+        if not rows_to_insert:
+            continue
+
+        placeholders = ", ".join(["(%s, %s, %s, %s)"] * len(rows_to_insert))
+        flat: list = []
+        for row in rows_to_insert:
+            flat.extend(row)
+        db.execute(
+            "INSERT INTO role_permissions "
+            "(role_id, permission_id, module_id, has_permission) VALUES "
+            + placeholders,
+            tuple(flat),
+        )
+
+
+def seed() -> None:
+    admin_username = os.environ.get("HERMES_CRM_ADMIN_USERNAME", "admin")
+    admin_email = os.environ.get("HERMES_CRM_ADMIN_EMAIL", "admin@hermes.local")
+    admin_password = os.environ.get("HERMES_CRM_ADMIN_PASSWORD", "admin123")
+    admin_api_key = os.environ.get("HERMES_CRM_ADMIN_API_KEY") or secrets.token_hex(24)
+
+    with db_session() as db:
+        with db.transaction():
+            # Permissions
+            for name, code, desc in DEFAULT_PERMISSIONS:
+                db.execute(
+                    "INSERT INTO permissions (name, code, description) VALUES (%s, %s, %s) "
+                    "ON CONFLICT (code) DO NOTHING",
+                    (name, code, desc),
+                )
+
+            # Roles (no unique constraint on name; guard with a manual check)
+            for name, is_default in DEFAULT_ROLES:
+                exists = db.fetchcolumn(
+                    "SELECT COUNT(*) FROM roles WHERE name = %s", (name,)
+                )
+                if not exists:
+                    db.insert("roles", {"name": name, "is_default": is_default})
+
+            # Collections
+            for name, title in DEFAULT_COLLECTIONS:
+                db.execute(
+                    "INSERT INTO collections (name, title) VALUES (%s, %s) "
+                    "ON CONFLICT (name) DO NOTHING",
+                    (name, title),
+                )
+
+            # Departments (parent is always NULL for the Company root)
+            for name, parent_id in DEFAULT_DEPARTMENTS:
+                exists = db.fetchcolumn(
+                    "SELECT COUNT(*) FROM departments WHERE name = %s AND parent_id IS NOT DISTINCT FROM %s",
+                    (name, parent_id),
+                )
+                if not exists:
+                    db.insert(
+                        "departments", {"name": name, "parent_id": parent_id}
+                    )
