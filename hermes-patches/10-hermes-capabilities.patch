+_DIRECT_FIELD_TYPES = (
+    "text", "textarea", "number", "currency", "date", "datetime",
+    "picklist", "multiselect", "boolean", "email", "phone", "url",
+    "relation", "user", "department", "autoNumber",
+)
+_OPTION_FIELD_TYPES = ("picklist", "multiselect")
+
+
+def _create_field_tool(module_names: List[str]) -> "ToolSpec":
+    """Agent 直接给模块/子明细加字段(非 propose)。"""
+    return ToolSpec(
+        name="crm_create_field",
+        description=(
+            "Directly add a new field to a CRM module or sub-detail and create "
+            "its column immediately (no admin review). Use this for INTENTIONAL "
+            "schema building — the user explicitly asks for a column, or you are "
+            "deliberately shaping a module the user is describing. Supported "
+            "types: text, textarea, number, currency, date, datetime, picklist, "
+            "multiselect, boolean, email, phone, url, relation, user, "
+            "department, autoNumber. "
+            "Per type: picklist/multiselect need 'options' (allowed values); "
+            "relation needs 'target_module' (the module it links to — stored as "
+            "a foreign key); user/department link to system users/departments "
+            "(no extra config); autoNumber generates a running code (optionally "
+            "pass 'autonumber' = {prefix, date_token in ''/YYYY/YYYYMM/YYYYMMDD, "
+            "digits, start}; it is created read-only). For a computed/read-only "
+            "value use crm_create_formula_field instead. "
+            "IMPORTANT — do NOT use this for PROACTIVE/autonomous suggestions: "
+            "if YOU noticed during normal conversation that a column might be "
+            "useful but the user did not ask for it, use crm_propose_new_field "
+            "(admin reviews) so auto-evolution does not clutter the schema. "
+            "To create an AI-AUTO-FILLED field (value computed by AI per record), pass "
+            "ai_fill={mode, mission, ...} with field_type set to the output type "
+            "(picklist/multiselect → mode=classify)."
+        ),
+        verb="create",
+        module_name="__schema_field__",
+        input_schema={
+            "type": "object",
+            "properties": {
+                "module_name": {"type": "string", "description": "Target module or sub-detail id (snake_case)."},
+                "field_name": {"type": "string", "description": "Snake_case id; starts with a letter, <= 32 chars."},
+                "field_label": {"type": "string", "description": "Human label, <= 64 chars."},
+                "field_type": {"type": "string", "enum": list(_DIRECT_FIELD_TYPES)},
+                "options": {"type": "array", "items": {"type": "string"},
+                            "description": "Allowed values; REQUIRED for picklist/multiselect."},
+                "target_module": {"type": "string",
+                                  "description": "REQUIRED for field_type='relation' — the module this field links to (e.g. 'accounts')."},
+                "autonumber": {
+                    "type": "object",
+                    "description": "Optional config for field_type='autoNumber'.",
+                    "properties": {
+                        "prefix": {"type": "string"},
+                        "date_token": {"type": "string", "enum": ["", "YYYY", "YYYYMM", "YYYYMMDD"]},
+                        "digits": {"type": "integer", "minimum": 1, "maximum": 18},
+                        "start": {"type": "integer", "minimum": 0},
+                    },
+                    "additionalProperties": False,
+                },
+                "ai_fill": {
+                    "type": "object",
+                    "description": (
+                        "Make this an AI-AUTO-FILLED field: the value is computed automatically "
+                        "by AI per record. field_type stays the OUTPUT type (text/number/picklist/"
+                        "boolean); for picklist also pass 'options'. Use when the user wants a column "
+                        "that AI fills on its own (e.g. 'auto-judge customer tier from industry & size')."
+                    ),
+                    "properties": {
+                        "mode": {"type": "string", "enum": ["classify", "summarize", "web_agent", "prompt"], "description": "classify=归类到 picklist/multiselect 选项; summarize=据记录摘要(text); web_agent=联网查找(text/number); prompt=自定义. picklist/multiselect → classify."},
+                        "mission": {"type": "string", "description": "What AI should judge/generate (one sentence)."},
+                        "context_rules": {"type": "string", "description": "Rules/criteria; may reference this module's field names. Optional."},
+                        "input_fields": {"type": "array", "items": {"type": "string"}, "description": "Record fields to consider; empty=all."},
+                        "with_interactions": {"type": "boolean", "description": "Consider the record's linked conversations (Feishu/email)."},
+                    },
+                    "additionalProperties": False,
+                },
+                "is_required": {"type": "boolean", "default": False},
+                "is_searchable": {"type": "boolean", "default": False},
+                "reason": {"type": "string", "description": "Why the field is needed — recorded in the changelog."},
+            },
+            "required": ["module_name", "field_name", "field_label", "field_type"],
+            "additionalProperties": False,
+        },
