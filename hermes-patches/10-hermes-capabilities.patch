index 0000000000..0ed9b63c92
--- /dev/null
+++ b/crm/approval/guard.py
@@ -0,0 +1,32 @@
+"""写锁守卫:审批中/已通过的记录禁止改写。
+
+审批 = per-module opt-in —— 未配 approval_config 的模块直接放行,行为不变。
+内部流转(审批流自身回写)用 source 标记放行。
+"""
+from __future__ import annotations
+
+from hermes.crm.approval.engine import ApprovalEngine
+from hermes.crm.db import DbWrapper
+
+# 审批流自身/系统内部写入,不受写锁约束。
+_BYPASS_SOURCES = {"approval", "workflow-internal", "system"}
+
+
+class ApprovalLockedError(ValueError):
+    """记录处于审批锁定状态(pending,或 passed 且不允许改)。"""
+
+
+def approval_guard(
+    db: DbWrapper, module_id: int, data_id: int, source: str = "user"
+) -> None:
+    """审批中/已通过(且禁止改)的记录拒绝改写;未配链或内部流转放行。"""
+    if source in _BYPASS_SOURCES:
+        return
+    eng = ApprovalEngine(db)
+    cfg = eng.get_config(module_id)
+    if not cfg:  # 未配链模块 → 零影响
+        return
+    if eng.has_pending(module_id, data_id):
+        raise ApprovalLockedError("记录正在审批中,不可修改")
+    if not cfg.get("allow_edit_after_approve") and eng.has_passed(module_id, data_id):
+        raise ApprovalLockedError("审批已通过,不可修改")
diff --git a/crm/autonumber.py b/crm/autonumber.py
new file mode 100644
index 0000000000..e537cc0e08
--- /dev/null
+++ b/crm/autonumber.py
@@ -0,0 +1,75 @@
+"""Auto-increment numbering — pure formatter.
+
+An autoNumber field stores a formatted identifier string
+(``SO-00001``, ``INV-2026050009`` etc.) in a ``VARCHAR(64)`` column.
+The running counter is a Postgres ``SEQUENCE`` named
+``autonum_<module>_<field>`` created by ``provision_field`` (Phase P0);
+this module never touches the DB — it only turns a config dict plus a
+sequence integer plus a timestamp into the stored string.
+
+Config (``field_config.autonumber``, all keys optional)::
+
+    {"prefix": "SO-", "digits": 5, "start": 1, "date_token": "YYYYMM"}
+
+The rendered number is::
+
+    prefix + render(date_token, now) + zero-pad(seq_value, digits)
+
+``date_token`` is one of ``""``, ``"YYYY"``, ``"YYYYMM"``,
+``"YYYYMMDD"`` and is inserted between the prefix and the digits. An
+empty or unrecognised token renders nothing. ``start`` is consumed by
+the SEQUENCE definition (``CREATE SEQUENCE ... START WITH <start>``),
+not by this formatter — it is part of the config shape for symmetry
+with the provisioning layer.
+"""
+from __future__ import annotations
+
+from datetime import datetime
+
+# Strftime pattern per supported token. Anything not in this map
+# (including the empty string) renders to "".
+_DATE_TOKEN_FORMATS = {
+    "YYYY": "%Y",
+    "YYYYMM": "%Y%m",
+    "YYYYMMDD": "%Y%m%d",
+}
+
+
+def _coerce_int(value: object, default: int) -> int:
+    """Tolerate config values that arrived as strings (JSON round-trip
+    or hand-edited ``field_config``)."""
+    try:
+        return int(value)  # type: ignore[arg-type]
+    except (TypeError, ValueError):
+        return default
+
+
+def format_number(config: dict, seq_value: int, now: datetime) -> str:
+    """Render an autoNumber string.
+
+    :param config: ``field_config.autonumber`` dict. All keys optional:
+        ``prefix`` (str, default ""), ``digits`` (int, default 0),
+        ``date_token`` (str, default ""). ``start`` is ignored here.
+    :param seq_value: the integer drawn from the field's SEQUENCE.
+    :param now: timestamp used to render ``date_token``.
+    :returns: ``prefix + date + zero-padded seq_value``.
+
+    The digit group is zero-padded to ``digits`` width; a ``seq_value``
+    wider than ``digits`` is never truncated. ``digits <= 0`` means no
+    padding.
+    """
+    prefix = str(config.get("prefix") or "")
+    digits = _coerce_int(config.get("digits"), 0)
+    date_token = str(config.get("date_token") or "")
+
+    date_part = ""
+    fmt = _DATE_TOKEN_FORMATS.get(date_token)
+    if fmt is not None:
+        date_part = now.strftime(fmt)
+
+    if digits > 0:
+        number_part = str(int(seq_value)).zfill(digits)
+    else:
+        number_part = str(int(seq_value))
+
+    return f"{prefix}{date_part}{number_part}"
diff --git a/crm/constants.py b/crm/constants.py
