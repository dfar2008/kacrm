+            # role_permissions matrix — DEFAULT_ROLE_GRANTS × collections.
+            # Idempotent: each batch is wiped-and-reinserted per role, so
+            # re-seeding always reconverges on the declared matrix.
+            _seed_role_permissions(db)
+
+    # Admin user (outside the txn so we can reuse UsersDb cleanly)
+    users = UsersDb()
+    existing = users.get_user_by_username(admin_username)
+    if existing is None:
+        admin_id = users.insert(
+            {
+                "username": admin_username,
+                "password": UsersDb.hash_password(admin_password),
+                "realname": "Administrator",
+                "email": admin_email,
+                "status": 1,
+                "is_admin": True,
+                "api_key": admin_api_key,
+                "plan": "admin",
+            }
+        )
+        print(f"created admin user id={admin_id} api_key={admin_api_key}")
+    else:
+        admin_id = int(existing["id"])
+        # Backfill an api_key if the existing admin doesn't have one yet.
+        if not existing.get("api_key"):
+            with db_session() as db:
+                db.execute(
+                    "UPDATE users SET api_key = %s WHERE id = %s",
+                    (admin_api_key, admin_id),
+                )
+            print(f"admin user id={admin_id} api_key backfilled={admin_api_key}")
+        else:
+            print(f"admin user id={admin_id} already exists (api_key present)")
+
+    # Module metadata — runs after admin exists because default views are
+    # stamped with ``created_by = admin_id``. Wrapped in its own transaction
+    # so a mid-seed failure doesn't leave partial view/field state behind.
+    with db_session() as db:
+        with db.transaction():
+            seed_module_metadata(db, admin_id)
+    print("seeded module metadata (all CRM modules)")
+
+
+if __name__ == "__main__":  # pragma: no cover
+    seed()
