+def _dispatch_create_workflow(
+    arguments: Dict[str, Any], *, user_id: int,
+    profile_id: Optional[str] = None, agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    import json as _json
+    name = str(arguments.get("name") or "").strip()
+    ttype = str(arguments.get("trigger_type") or "").strip()
+    module = str(arguments.get("module") or "").strip()
+    trigger_on = arguments.get("trigger_on")
+    schedule_cron = arguments.get("schedule_cron")
+    condition = arguments.get("condition") or {}
+    actions = arguments.get("actions") or []
+    if not (name and ttype and module and actions):
+        return {"success": False, "error": "name/trigger_type/module/actions 必填"}
+    if ttype == "event" and trigger_on not in ("create", "update"):
+        return {"success": False, "error": "event 触发需要 trigger_on=create|update"}
+    if ttype == "schedule":
+        if not schedule_cron:
+            return {"success": False, "error": "schedule 触发需要 schedule_cron(5 段 cron)"}
+        try:
+            from croniter import croniter
+            if not croniter.is_valid(str(schedule_cron)):
+                return {"success": False, "error": f"非法 cron: {schedule_cron!r}"}
+        except Exception:
+            pass
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        mod = ModulesDb(d).get_module_by_name(module)
+        if not mod:
+            return {"success": False, "error": f"unknown module: {module!r}"}
+        if not _actor_is_admin(d, user_id):
+            return _enqueue_schema_proposal(
+                d, kind="workflow_add", module_id=int(mod["id"]),
+                module_name=module, dedup_key=name,
+                payload={"name": name, "trigger_type": ttype, "module": module,
+                         "trigger_on": trigger_on, "schedule_cron": schedule_cron,
+                         "condition": condition, "actions": actions},
+                reason=arguments.get("reason"),
+                user_id=user_id, profile_id=profile_id, agent_name=agent_name,
+            )
+        from hermes_cloud.app.crm.workflow_provisioning import provision_workflow
+        actor = {"id": int(user_id or 0), "username": agent_name or f"agent:{profile_id or ''}"}
+        res = provision_workflow(d, {
+            "name": name, "trigger_type": ttype, "module": module,
+            "trigger_on": trigger_on, "schedule_cron": schedule_cron,
+            "condition": condition, "actions": actions,
+        }, actor)
+        when = (f"{module} {trigger_on}" if ttype == "event"
+                else f"定时 {schedule_cron}")
+        return {"success": True, "id": res["id"],
+                "message": f"已建工作流「{name}」(当 {when} 时执行 {len(actions)} 个动作)。"}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as d:
+        return _run(d)
+
+
+def _dispatch_list_workflows(
+    arguments: Dict[str, Any], *, db: Optional[DbWrapper] = None, **_kw,
+) -> Dict[str, Any]:
+    module = str(arguments.get("module") or "").strip()
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        if module:
+            rows = d.fetchall(
+                "SELECT id,name,enabled,trigger_type,module,trigger_on,schedule_cron,"
+                "condition,actions FROM workflows WHERE NOT deleted AND module=%s "
+                "ORDER BY id", (module,))
+        else:
+            rows = d.fetchall(
+                "SELECT id,name,enabled,trigger_type,module,trigger_on,schedule_cron,"
+                "condition,actions FROM workflows WHERE NOT deleted ORDER BY id")
+        return {"success": True, "workflows": [dict(r) for r in (rows or [])]}
+
+    if db is not None:
+        return _run(db)
+    with db_session() as d:
+        return _run(d)
+
+
+def _dispatch_remove_workflow(
+    arguments: Dict[str, Any], *, db: Optional[DbWrapper] = None, **_kw,
+) -> Dict[str, Any]:
+    wid = int(arguments.get("id") or 0)
+
+    def _run(d: "DbWrapper") -> Dict[str, Any]:
+        r = d.fetchone("SELECT name FROM workflows WHERE id=%s AND NOT deleted", (wid,))
+        if not r:
+            return {"success": False, "error": f"workflow {wid} 不存在"}
