+def _dispatch_set_field_writeback_rule(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    profile_id: Optional[str] = None,
+    agent_name: Optional[str] = None,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    src_mod = str(arguments.get("source_module_name") or "").strip()
+    src_field = str(arguments.get("source_field_name") or "").strip()
+    tgt_mod = str(arguments.get("target_module_name") or "").strip()
+    tgt_field = str(arguments.get("target_field_name") or "").strip()
+    calc = str(arguments.get("calc_method") or "original").strip().lower()
+    if not (src_mod and src_field and tgt_mod and tgt_field):
+        raise ValueError(
+            "source_module_name, source_field_name, target_module_name, "
+            "target_field_name are required"
+        )
+
+    from hermes.crm.field_writeback import FieldWriteback
+    from hermes.crm.models.modules_db import ModulesDb
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        sm = ModulesDb(db).get_module_by_name(src_mod)
+        tm = ModulesDb(db).get_module_by_name(tgt_mod)
+        if not sm:
+            raise ValueError(f"source module {src_mod!r} not found")
+        if not tm:
+            raise ValueError(f"target module {tgt_mod!r} not found")
+        sf = _resolve_field(db, int(sm["id"]), src_field)
+        tf = _resolve_field(db, int(tm["id"]), tgt_field)
+        if not sf:
+            raise ValueError(f"source field {src_field!r} not found")
+        if not tf:
+            raise ValueError(f"target field {tgt_field!r} not found")
+        rule_payload = {
+            "source_module_id": int(sm["id"]),
+            "source_field_id": int(sf["id"]),
+            "target_module_id": int(tm["id"]),
+            "target_field_id": int(tf["id"]),
+            "calc_method": calc,
+        }
+        # 与建模(create_*)一致:汇总规则是共享 schema 变更(改的是全员父记录
+        # 的合计口径),故走同一条治理通道 —— 非管理员发起 → 转管理员审批
+        # pending 提案(kind=writeback_add),管理员 → 即时生效。
+        if not _actor_is_admin(db, user_id):
+            return _enqueue_schema_proposal(
+                db, kind="writeback_add", module_id=int(sm["id"]),
+                module_name=src_mod,
+                dedup_key=f"{int(sf['id'])}->{int(tf['id'])}:{calc}",
+                payload={
+                    **rule_payload,
+                    "source_module_name": src_mod,
+                    "source_field_name": src_field,
+                    "target_module_name": tgt_mod,
+                    "target_field_name": tgt_field,
+                },
+                reason=arguments.get("reason"),
+                user_id=user_id, profile_id=profile_id, agent_name=agent_name,
+            )
+        result = FieldWriteback(db, user_id=int(user_id)).create_rule(rule_payload)
+        if result.get("success"):
+            result["message"] = (
+                f"已添加写回规则：{src_mod}.{src_field} "
+                f"→ {tgt_mod}.{tgt_field} ({calc})"
+            )
+        return result
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
+
