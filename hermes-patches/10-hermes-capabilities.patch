diff --git a/tools/crm/dispatch.py b/tools/crm/dispatch.py
new file mode 100644
index 0000000000..91056a540d
--- /dev/null
+++ b/tools/crm/dispatch.py
@@ -0,0 +1,5760 @@
+"""Bridge tool binding — CRM metadata → MCP-shaped tool specs.
+
+Phase 1f (plan §6.3). The hermes Agent Pool (Phase 2) will expose CRM
+operations to tool-using LLMs via MCP. Building the tool catalogue on
+demand from whatever the metadata says — instead of hand-writing one
+function per verb per module — means:
+
+* New modules (Phase 2 quotes / salesorders) ship tools automatically.
+* Admin-edited custom fields show up in the tool's input schema the
+  next time the cache is rebuilt, without a code change.
+* Input validation is centralised: the JSON schema is the source of
+  truth, and the dispatcher feeds it straight into the same
+  :class:`ListQuery` / :class:`DetailQuery` / :class:`Save` pipeline
+  the REST routes use — so REST and MCP can't drift.
+
+Phase 1 ships the **schema generator + dispatcher**. The MCP server
+itself (stdio loop, JSON-RPC framing, tool registration) lives in the
+Agent gateway which doesn't exist yet — wiring this module's
+:func:`build_crm_tools` output to a real MCP server is Phase 2 work.
+
+Each collection emits four tools (plan §6.3 matrix):
+
+* ``crm_search_<collection>`` — paginated list + search
+* ``crm_get_<collection>``    — single-record fetch by id
+* ``crm_create_<collection>`` — create a record
+* ``crm_update_<collection>`` — patch-style update
+
+Field-type → JSON schema rules live in :func:`_field_to_json_schema`.
+Unknown types degrade to ``{"type": "string"}`` rather than raising so
+a botched seed doesn't take the whole tool catalogue down.
+
+Permission enforcement: :func:`dispatch` calls
+:meth:`Permission.check_permission_by_module_name` with the verb
+implied by the tool name (``search`` → ``index``, ``get`` → ``view``,
+``create`` → ``create``, ``update`` → ``update``). Admins pass every
+check, same as the REST layer.
+"""
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.crm.detail_query import DetailQuery
+from hermes.crm.i18n.options import parse_picklist_options
+from hermes.crm.list_query import ListQuery
+from hermes.crm.models.module_fields_db import ModuleFieldsDb
+from hermes.crm.models.modules_db import ModulesDb
+from hermes.crm.models.field_proposals_db import FieldProposalsDb
+from hermes.crm.models.users_db import UsersDb
+from hermes.crm.permission import Permission
+from hermes.crm.save import Save
+
+
+logger = logging.getLogger(__name__)
+
+
+# ---------------------------------------------------------------------------
+# JSON schema mapping
+# ---------------------------------------------------------------------------
+
+# Field types that render as a JSON string (kacrm's widget catalogue).
+_STRING_TYPES = frozenset({
+    "text", "textarea", "email", "url", "phone", "autoNumber",
+    "password", "html", "richtext",
+})
+_NUMERIC_TYPES = frozenset({"number", "currency", "percent", "float"})
+_INTEGER_REF_TYPES = frozenset({"user", "department", "createdBy", "relation"})
+_DATE_TYPES = frozenset({"date"})
+_DATETIME_TYPES = frozenset({"datetime", "timestamp"})
+_BOOL_TYPES = frozenset({"boolean", "bool", "checkbox"})
+_SELECT_TYPES = frozenset({"select", "picklist", "radio"})
+_MULTISELECT_TYPES = frozenset({"multiselect", "multiSelect", "checkboxGroup"})
+
+
+def _field_to_json_schema(field_row: Dict[str, Any]) -> Dict[str, Any]:
+    """Map one ``module_fields`` row → a JSON schema property dict.
+
+    ``description`` is copied through for LLM context. ``enum`` is built
+    from the picklist options for select-shaped fields. Unknown types
+    collapse to ``{"type": "string"}`` — lenient on purpose, a typo in
+    the seed shouldn't brick the tool catalogue.
+    """
+    ftype = (field_row.get("field_type") or "").strip()
+    label = field_row.get("field_label") or field_row.get("field_name") or ""
+    desc_bits: List[str] = []
+    if label:
+        desc_bits.append(label)
+    raw_desc = (field_row.get("description") or "").strip()
+    if raw_desc:
+        desc_bits.append(raw_desc)
+
+    prop: Dict[str, Any] = {}
+    if desc_bits:
+        prop["description"] = " — ".join(desc_bits)
+
+    if ftype in _STRING_TYPES:
+        prop["type"] = "string"
+    elif ftype in _NUMERIC_TYPES:
+        prop["type"] = "number"
+    elif ftype in _INTEGER_REF_TYPES:
+        prop["type"] = "integer"
+        prop.setdefault(
+            "description",
+            f"{label} (id of referenced record)".strip(" —"),
+        )
+    elif ftype in _DATE_TYPES:
+        prop["type"] = "string"
+        prop["format"] = "date"
+    elif ftype in _DATETIME_TYPES:
+        prop["type"] = "string"
+        prop["format"] = "date-time"
+    elif ftype in _BOOL_TYPES:
+        prop["type"] = "boolean"
+    elif ftype in _SELECT_TYPES:
+        prop["type"] = "string"
+        values = [
+            o.get("value") for o in parse_picklist_options(field_row.get("options"))
+            if o.get("value") is not None
+        ]
+        if values:
+            prop["enum"] = [str(v) for v in values]
+    elif ftype in _MULTISELECT_TYPES:
+        prop["type"] = "array"
+        items: Dict[str, Any] = {"type": "string"}
+        values = [
+            o.get("value") for o in parse_picklist_options(field_row.get("options"))
+            if o.get("value") is not None
+        ]
+        if values:
+            items["enum"] = [str(v) for v in values]
+        prop["items"] = items
+    else:
+        # Unknown type — be permissive.
+        prop["type"] = "string"
+
+    return prop
+
