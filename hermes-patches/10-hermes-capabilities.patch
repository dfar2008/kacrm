+def _dispatch_convert_lead(
+    arguments: Dict[str, Any],
+    *,
+    user_id: int,
+    source: str,
+    profile_id: Optional[str],
+    agent_name: Optional[str],
+    db: Optional[DbWrapper],
+) -> Dict[str, Any]:
+    """提交一个 ``lead.convert`` 动作走 gateway。
+
+    前置校验:lead_id 合法、lead 存在且未转化。校验过的 lead 交
+    ``gateway_dispatcher.submit(kind="lead.convert", ...)``,把状态感知的
+    结果折成 LLM 期望的 ``{success, account_id, contact_id, potential_id,
+    action_id}`` / ``{success=false, pending_approval=true}`` 形状。
+    """
+    try:
+        lead_id = int(arguments.get("lead_id") or 0)
+    except (ValueError, TypeError):
+        lead_id = 0
+    if lead_id <= 0:
+        return {"success": False, "error": "convert_lead_id_required"}
+
+    import hermes.action_gateway  # noqa: F401 — 确保 executor 已注册
+    from hermes.action_gateway import dispatcher as gateway_dispatcher
+    from hermes_cloud.app.bridge import origin_context
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        lead = db.fetchone(
+            "SELECT leads_id, convertedstatus FROM leads "
+            "WHERE leads_id = %s AND NOT COALESCE(deleted, FALSE)",
+            (lead_id,),
+        )
+        if not lead:
+            return {"success": False, "error": "convert_lead_not_found"}
+        if str(lead.get("convertedstatus") or "").lower() == "converted":
+            return {"success": False, "error": "convert_lead_already_converted"}
+
+        params: Dict[str, Any] = {"lead_id": lead_id}
+        for key in (
+            "potential_name", "potential_amount",
+            "potential_milestone", "potential_closing_date",
+        ):
+            val = arguments.get(key)
+            if val is not None and val != "":
+                params[key] = val
+
+        try:
+            result = gateway_dispatcher.submit(
+                profile_id=profile_id or "",
+                agent_name=agent_name or "",
+                kind="lead.convert",
+                target={"module": "leads", "id": lead_id},
+                params=params,
+                user_id=user_id,
+                origin=origin_context.current(),
+                executing_specialist=agent_name or None,
+                db=db,
+            )
+        except Exception as exc:
+            return {
+                "success": False,
+                "error": (
+                    f"convert_lead_dispatch_failed: "
+                    f"{type(exc).__name__}: {exc}"
+                ),
+            }
+
+        if result["state"] == "executed":
+            token = result.get("revert_token") or {}
+            return {
+                "success": True,
+                "account_id": int(token.get("account_id") or 0),
+                "contact_id": int(token.get("contact_id") or 0),
+                "potential_id": int(token.get("potential_id") or 0),
+                "action_id": str(result["id"]),
+            }
+        if result["state"] == "pending_approval":
+            return {
+                "success": False,
+                "pending_approval": True,
+                "action_id": str(result["id"]),
+                "summary": result.get("summary") or f"lead {lead_id} 转化等待人工审批",
+                "message": (
+                    "该转化已提交并等待人工审批；这不是失败，"
+                    "不要重试或改写后再次调用。"
+                ),
+            }
+        return {
+            "success": False,
+            "error": f"convert_lead_unexpected_state: {result.get('state')}",
+            "action_id": str(result.get("id") or ""),
+        }
+
+    if db is not None:
+        return _run(db)
+    with db_session() as owned:
+        return _run(owned)
+
