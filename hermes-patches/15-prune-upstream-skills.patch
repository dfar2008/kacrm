-                     padded[1:-1, :-2] +                     padded[1:-1, 2:] +
-                     padded[2:, :-2]  + padded[2:, 1:-1]  + padded[2:, 2:])
-        alive = grid > 0.5
-        new_alive = np.zeros_like(grid, dtype=bool)
-        for b in birth:
