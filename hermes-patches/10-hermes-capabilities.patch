diff --git a/plugins/web/baidu/provider.py b/plugins/web/baidu/provider.py
new file mode 100644
index 0000000000..024a0d24f5
--- /dev/null
+++ b/plugins/web/baidu/provider.py
@@ -0,0 +1,141 @@
+"""Baidu search — HTML-scrape provider (no API key).
+
+www.baidu.com/s is reachable from mainland China and server-renders organic
+results, unlike DuckDuckGo (blocked) and Bing (JS-only shell). Parsing uses
+stdlib ``re`` (bs4 is not a runtime dependency).
+
+Best-effort caveats:
+- Baidu rate-limits aggressive scraping with an anti-bot verification page
+  (a tiny HTML stub). The provider warms a cookie via the homepage, requests
+  gzip (httpx's brotli decoder is buggy), detects the stub, retries once, and
+  finally degrades to ``{"success": False, "error": ...}`` — never hangs.
+- Result URLs prefer the container's ``mu`` attribute (the real destination);
+  otherwise the ``baidu.com/link?url=`` redirect (still resolves on click).
+"""
+
+from __future__ import annotations
+
+import html as _html
+import logging
+import re
+from typing import Any, Dict, List
+
+import httpx
+
+from agent.web_search_provider import WebSearchProvider
+
+logger = logging.getLogger(__name__)
+
+_UA = (
+    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
+    "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
+)
+_HEADERS = {
+    "User-Agent": _UA,
+    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
+    "Accept-Language": "zh-CN,zh;q=0.9",
+    # Force gzip/deflate — httpx's brotli (brotlicffi) decoder intermittently
+    # raises on Baidu's chunked br stream.
+    "Accept-Encoding": "gzip, deflate",
+    "Referer": "https://www.baidu.com/",
+}
+
+
+def _strip(fragment: str) -> str:
+    return _html.unescape(re.sub(r"<[^>]+>", "", fragment)).strip()
+
+
+def _looks_blocked(body: str) -> bool:
+    if len(body) < 5000:
+        return True
+    return ("百度安全验证" in body) or ("wappass.baidu.com" in body) or ("/static/captcha" in body)
+
+
+def _parse(body: str, limit: int) -> List[Dict[str, Any]]:
+    results: List[Dict[str, Any]] = []
+    # Split on each organic result container, then pull title/url/abstract.
+    for blk in re.split(r'(?=<div[^>]*class="[^"]*result[^"]*")', body):
+        mt = re.search(r'<h3[^>]*>\s*<a[^>]*href="([^"]+)"[^>]*>(.*?)</a>', blk, re.S)
+        if not mt:
+            continue
+        title = _strip(mt.group(2))
+        if not title:
+            continue
+        mu = re.search(r'mu="(http[^"]+)"', blk)
+        url = _html.unescape(mu.group(1) if mu else mt.group(1))
+        ab = re.search(
+            r'class="[^"]*(?:c-abstract|content-right_|c-line-clamp)[^"]*"[^>]*>(.*?)</span>',
+            blk,
+            re.S,
+        )
+        desc = _strip(ab.group(1))[:200] if ab else ""
+        results.append(
+            {"title": title, "url": url, "description": desc, "position": len(results) + 1}
+        )
+        if len(results) >= limit:
+            break
+    return results
+
+
+class BaiduWebSearchProvider(WebSearchProvider):
+    """Baidu HTML-scrape search provider. No API key needed."""
+
+    @property
+    def name(self) -> str:
+        return "baidu"
+
+    @property
+    def display_name(self) -> str:
+        return "Baidu (www.baidu.com)"
+
+    def is_available(self) -> bool:
+        return True
+
+    def supports_search(self) -> bool:
+        return True
+
+    def supports_extract(self) -> bool:
+        return False
+
+    def search(self, query: str, limit: int = 5) -> Dict[str, Any]:
+        safe_limit = max(1, int(limit))
+        params = {"wd": query, "rn": str(min(safe_limit * 2, 20)), "ie": "utf-8"}
+        try:
+            with httpx.Client(
+                headers=_HEADERS, timeout=12.0, follow_redirects=True
+            ) as client:
+                # Warm a cookie (BAIDUID) — Baidu serves the verification stub
+                # far more often to cookieless clients.
+                try:
+                    client.get("https://www.baidu.com/")
+                except Exception:  # noqa: BLE001 — warm-up is best-effort
+                    pass
+                body = client.get("https://www.baidu.com/s", params=params).text
+                if _looks_blocked(body):
+                    # One retry — transient anti-bot stub.
+                    body = client.get("https://www.baidu.com/s", params=params).text
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("Baidu search error: %s", exc)
+            return {"success": False, "error": f"Baidu search failed: {exc}"}
+
+        if _looks_blocked(body):
+            return {
+                "success": False,
+                "error": "Baidu returned an anti-bot verification page (rate-limited); try again shortly.",
+            }
+        results = _parse(body, safe_limit)
+        if not results:
+            return {
+                "success": False,
+                "error": "Baidu returned no parseable results (layout may have changed).",
+            }
+        logger.info("Baidu search '%s': %d results (limit %d)", query, len(results), limit)
+        return {"success": True, "data": {"web": results}}
+
+    def get_setup_schema(self) -> Dict[str, Any]:
+        return {
+            "name": "Baidu (www.baidu.com)",
+            "badge": "free · no key · search only · CN-native",
+            "tag": "Baidu HTML search — no API key, works in mainland China",
+            "env_vars": [],
+        }
