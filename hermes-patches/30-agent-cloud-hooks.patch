+def continue_dangling_stop(agent, response, finish_reason, retry, messages, parts) -> bool:
+    """Recover an unfinished lead-in twice; use upstream's continuation trail cleanup."""
+    if (agent.api_mode not in {"chat_completions", "bedrock_converse", "anthropic_messages"}
+            or getattr(agent, "_dangling_stop_retries", 0) >= 2
+            or getattr(agent, "_interrupt_requested", False)):
+        return False
+    transport = agent._get_transport()
+    normalized = (transport.normalize_response(response, strip_tool_prefix=agent._is_anthropic_oauth)
+                  if agent.api_mode == "anthropic_messages" else transport.normalize_response(response))
+    content = getattr(normalized, "content", None)
+    if not isinstance(content, str) or getattr(normalized, "tool_calls", None):
+        return False
+    text = agent._strip_think_blocks(content).rstrip()
+    if not text or not text.endswith(("：", ":", "——", "—")):
+        return False
+    agent._dangling_stop_retries = getattr(agent, "_dangling_stop_retries", 0) + 1
+    agent._vprint(f"{agent.log_prefix}↻ Dangling-stop — requesting continuation "
+                  f"({agent._dangling_stop_retries}/2)...", force=True, diagnostic=True)
+    interim = agent._build_assistant_message(normalized, finish_reason)
+    interim["_length_continuation_fragment"] = True
+    append_message(messages, interim)
+    parts.append((content, False))
+    append_message(messages, {
+        "role": "user", "_length_continuation_nudge": True,
+        "content": "你上一条以冒号结尾就停下了，但你承诺要给的清单/问题/内容还没写出来。"
+                   "请直接接着写完——在这一条回复里把完整内容给全，不要再以冒号结尾停下，"
+                   "也不要重复前面已经说过的部分，直接从该写的内容开始。",
+    })
+    agent._session_messages = messages
+    retry.restart_with_length_continuation = True
+    return True
