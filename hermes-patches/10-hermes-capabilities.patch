diff --git a/crm/memory_compounding.py b/crm/memory_compounding.py
new file mode 100644
index 0000000000..cea1c2dd0b
--- /dev/null
+++ b/crm/memory_compounding.py
@@ -0,0 +1,85 @@
+"""记忆复利 (P1 事件溯源底座 §7.2)。
+
+把 CRM 记录的业务字段:
+  1. 同事务写入 memory_entities.attributes(JSONB 合并)——加厚记忆图谱属性维。
+  2. 同事务调 upsert_memory,把字段文本 embedding 进记忆图谱(External
+     Consistency);embedding 失败不回滚业务写,由批兜底。
+
+只对已 link memory_entity 的记录生效(accounts/contacts/leads/potentials,
+迁移 0018);自定义模块若 link 了 entity 也自动适用。
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.memory_identity import resolve_record_entity
+from hermes.crm.constants import SYSTEM_COLUMNS
+
+
+def _business_fields(payload: Dict[str, Any]) -> Dict[str, Any]:
+    return {
+        k: v for k, v in (payload or {}).items()
+        if k not in SYSTEM_COLUMNS and not k.endswith("_id") and v not in (None, "")
+    }
+
+
+def sync_entity_attributes(
+    db: DbWrapper, table_name: str, record_id: int, payload: Dict[str, Any]
+) -> None:
+    """把 payload 的业务字段合并进该记录 memory_entity 的 attributes(同事务)。"""
+    linked, eid = resolve_record_entity(db, table_name, int(record_id))
+    if not linked or eid is None:
+        return
+    biz = _business_fields(payload)
+    if not biz:
+        return
+    db.execute(
+        "UPDATE memory_entities SET attributes = attributes || %s::jsonb, "
+        "last_seen_at = now() WHERE id = %s",
+        (json.dumps(biz), int(eid)),
+    )
+
+
+def schedule_field_embedding(
+    db: DbWrapper,
+    table_name: str,
+    record_id: int,
+    user_id: int,
+    payload: Dict[str, Any],
+    headline: Optional[str] = None,
+) -> None:
+    """同事务把记录字段文本 embedding 进记忆图谱(External Consistency)。失败由批兜底。"""
+    linked, eid = resolve_record_entity(db, table_name, int(record_id))
+    if not linked or eid is None:
+        return
+    biz = _business_fields(payload)
+    if not biz:
+        return
+    text = "; ".join(f"{k}: {v}" for k, v in biz.items())
+    if headline:
+        text = f"{headline} — {text}"
+
+    # 同事务 External Consistency(宪章 v3 §三):embedding 与业务写在同一事务,
+    # reader 不会看到"有数据无 embedding"的中间态(消除延迟副本)。
+    # 失败不回滚业务写(定律1:业务写是真相),由 memory_ingest_recent 批兜底。
+    try:
+        from hermes.memory.vector_store import upsert_memory
+        upsert_memory(
+            content=text,
+            kind="fact",
+            scope="user",
+            user_id=int(user_id),
+            source_agent="crm",
+            meta={"entity_id": int(eid), "module": table_name,
+                  "record_id": int(record_id)},
+            db=db,
+        )
+    except Exception:  # noqa: BLE001
+        import logging
+        logging.getLogger(__name__).warning(
+            "inline field embedding failed — batch will backfill", exc_info=True)
+
+
+__all__ = ["sync_entity_attributes", "schedule_field_embedding"]
diff --git a/crm/memory_identity.py b/crm/memory_identity.py
new file mode 100644
index 0000000000..35c4831ffa
--- /dev/null
+++ b/crm/memory_identity.py
@@ -0,0 +1,204 @@
+"""CRM ↔ memory identity bridge.
+
+Charter rule: one real-world thing has **one** identity in the system.
+CRM accounts / contacts / leads / potentials all carry
+``memory_entity_id`` pointing at the canonical ``memory_entities`` row
+(migration 0018).
+
+This module centralizes the two places that relationship touches the
+write path:
+
+  * :func:`resolve_for_insert` — before an INSERT into a CRM table,
+    look up (or create) the memory_entity and inject
+    ``memory_entity_id`` into the row payload.
+
+  * :func:`propagate_rename` — after an UPDATE that changes the name
+    field, keep ``memory_entities.canonical`` in sync and preserve
+    the old name as an alias (so backlinks and search still resolve).
+
+The mapping from CRM table → memory entity_type is intentional and
+small. ``potentials`` is a deal attached to an account, so we mint a
+fresh ``deal`` entity keyed on the deal name; facts distilled about
+the underlying org attach to the *account*'s entity, not the deal's.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.memory.entities import upsert_entity
+
+
+# (crm_table, crm_name_col, memory_entity_type)
+_MAP: Dict[str, tuple[str, str]] = {
+    "accounts":   ("accounts_name",   "org"),
+    "contacts":   ("contacts_name",   "person"),
+    "leads":      ("leads_name",      "lead"),
+    "potentials": ("potentials_name", "deal"),
+}
+
+# Tables whose ``memory_entity_id`` is 1:1 with the entity, enforced by the
+# partial unique index ``uniq_<table>_memory_entity`` (migration 0018:
+# ``WHERE memory_entity_id IS NOT NULL AND deleted = FALSE``). ``potentials``
+# is intentionally NOT here — many deals may share a ``deal`` entity.
+_UNIQUE_LINKED: frozenset[str] = frozenset({"accounts", "contacts", "leads"})
+
+
+def _entity_claimed_by_live_row(
+    db: DbWrapper, table_name: str, entity_id: int
+) -> bool:
+    """True if a live (non-deleted) row in ``table_name`` already links
+    ``entity_id``. ``table_name`` is whitelisted by the caller against
+    :data:`_UNIQUE_LINKED` before interpolation.
+    """
+    row = db.fetchone(
+        f"SELECT 1 FROM {table_name} "  # noqa: S608 — _UNIQUE_LINKED whitelist
+        f"WHERE memory_entity_id = %s AND NOT COALESCE(deleted, FALSE) "
+        f"LIMIT 1",
+        (int(entity_id),),
+    )
+    return row is not None
+
+
+def is_linked_table(table_name: str) -> bool:
+    """True if this CRM table carries a ``memory_entity_id`` FK."""
+    return table_name in _MAP
+
+
+def resolve_for_insert(
+    db: DbWrapper, table_name: str, payload: Dict[str, Any]
+) -> Optional[int]:
+    """Look up or create a memory_entity for a new CRM row.
+
+    Returns the entity id (the caller should add it to ``payload`` as
+    ``memory_entity_id`` before the INSERT). Returns ``None`` if this
+    table has no identity link, or if the name field is missing —
+    we never INSERT a blank-canonical entity.
+
+    Entities are always created at **org scope** (``user_id=None``)
+    because CRM records are organization-shared by default. Individual
+    salespeople still see them through their CRM filters; the memory
+    layer is not where access control lives.
+    """
+    mapping = _MAP.get(table_name)
+    if not mapping:
+        return None
+    name_col, etype = mapping
+    raw = payload.get(name_col)
+    if not raw:
+        return None
+    canonical = str(raw).strip()
+    if not canonical:
+        return None
+
+    entity_id = int(upsert_entity(
+        entity_type=etype,
+        canonical=canonical,
+        user_id=None,
+        attributes={"source": "crm", "crm_table": table_name},
+        db=db,
+    ))
+
+    # 1:1 guard. accounts/contacts/leads carry uniq_<table>_memory_entity
+    # (partial: live rows only). upsert_entity dedupes by canonical name, so a
+    # second same-named row resolves to the SAME entity — linking it would
+    # violate the index (the lead.convert / second-same-name-contact 500).
+    # Mirror migration 0018's backfill, which only matched an entity NOT
+    # already claimed: if this entity is taken by a live row, leave the new
+    # row unlinked (memory_entity_id stays NULL — legal, nullable column,
+    # excluded from the partial index). Identity is resolved later by
+    # distillation; we never assert a wrong/duplicate identity here.
+    if (
+        table_name in _UNIQUE_LINKED
+        and _entity_claimed_by_live_row(db, table_name, entity_id)
+    ):
+        return None
+    return entity_id
+
+
+def propagate_rename(
+    db: DbWrapper,
+    table_name: str,
+    record_id: int,
+    old: Dict[str, Any],
+    new_payload: Dict[str, Any],
+) -> None:
+    """Sync ``memory_entities.canonical`` when a CRM row is renamed.
+
+    Old name is pushed into ``aliases`` so existing memory_entity_sources
+    and queries for the previous canonical still resolve. Case-insensitive
+    no-op when the rename is effectively identical.
+    """
+    mapping = _MAP.get(table_name)
+    if not mapping:
+        return
+    name_col, _etype = mapping
+    if name_col not in new_payload:
+        return  # name didn't change
+
+    eid = old.get("memory_entity_id")
+    if not eid:
+        return  # row was never linked — safe to skip; a later save will link
+
+    new_name = (new_payload.get(name_col) or "").strip()
+    old_name = (old.get(name_col) or "").strip()
+    if not new_name or new_name.lower() == old_name.lower():
+        return  # no real change
+
+    # Bring current aliases forward, add old canonical, dedupe.
+    row = db.fetchone(
+        "SELECT canonical, aliases FROM memory_entities WHERE id = %s",
+        (int(eid),),
+    )
+    if not row:
+        return
+    aliases = list(row.get("aliases") or [])
+    if old_name and old_name not in aliases:
+        aliases.append(old_name)
+    # Keep current canonical too, if different from old and new.
+    cur_canon = row.get("canonical")
+    if cur_canon and cur_canon != new_name and cur_canon not in aliases:
+        aliases.append(cur_canon)
+
+    db.execute(
+        """
+        UPDATE memory_entities
+        SET canonical = %s,
+            aliases = %s::jsonb,
+            last_seen_at = now(),
+            updated_at = now()
+        WHERE id = %s
+        """,
+        (new_name, json.dumps(sorted(set(aliases))), int(eid)),
+    )
+
+
+def resolve_record_entity(
+    db: DbWrapper, table_name: str, record_id: int
+) -> tuple[bool, Optional[int]]:
+    """For an EXISTING CRM record, return ``(record_exists, memory_entity_id)``.
+
+    ``record_exists`` is False when no row carries that id. The entity id
+    is None when the row exists but was never linked (the column is
+    nullable — see migration 0018, NOT NULL deferred).
+
+    ``table_name`` is interpolated into SQL; it is whitelisted against
+    :data:`_MAP` first, so only the four identity-linked CRM tables can
+    ever reach the query.
+    """
+    if table_name not in _MAP:
+        return (False, None)
+    pk_col = f"{table_name}_id"
+    row = db.fetchone(
+        f"SELECT memory_entity_id FROM {table_name} "  # noqa: S608 — _MAP whitelist
+        f"WHERE {pk_col} = %s",
+        (int(record_id),),
+    )
+    if row is None:
+        return (False, None)
+    eid = row.get("memory_entity_id")
+    return (True, int(eid) if eid else None)
+
+
+__all__ = ["is_linked_table", "resolve_for_insert", "propagate_rename", "resolve_record_entity"]
