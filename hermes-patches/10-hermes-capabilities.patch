+    def test_uppercase_rejected(self, tmp_env):
+        result = resolve_overlay_entry(
+            "specialists", "Intake", tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        assert result is None
+
+
+# =========================================================================
+# Manifest + hash
+# =========================================================================
+
+
+class TestManifestHash:
+    def test_hash_changes_when_mtime_changes(self, tmp_env):
+        kind = "skills"
+        path = _write_entry(tmp_env["hermes_root"] / kind, kind, "coach", description="v1")
+        manifests1 = build_overlay_manifest(
+            kind, tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        h1 = manifest_hash(manifests1)
+
+        # Bump mtime by writing fresh content with a future timestamp.
+        future = time.time() + 60
+        path.write_text(path.read_text(encoding="utf-8") + "\nedited", encoding="utf-8")
+        import os
+        os.utime(path, (future, future))
+
+        manifests2 = build_overlay_manifest(
+            kind, tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        h2 = manifest_hash(manifests2)
+        assert h1 != h2
+
+    def test_hash_changes_when_file_added(self, tmp_env):
+        kind = "skills"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "coach")
+        h1 = manifest_hash(
+            build_overlay_manifest(kind, tmp_env["profile_id"], tmp_env["hermes_root"])
+        )
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "drafter")
+        h2 = manifest_hash(
+            build_overlay_manifest(kind, tmp_env["profile_id"], tmp_env["hermes_root"])
+        )
+        assert h1 != h2
+
+    def test_hash_changes_when_file_removed(self, tmp_env):
+        kind = "skills"
+        path_a = _write_entry(tmp_env["hermes_root"] / kind, kind, "coach")
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "drafter")
+        h1 = manifest_hash(
+            build_overlay_manifest(kind, tmp_env["profile_id"], tmp_env["hermes_root"])
+        )
+        path_a.unlink()
+        h2 = manifest_hash(
+            build_overlay_manifest(kind, tmp_env["profile_id"], tmp_env["hermes_root"])
+        )
+        assert h1 != h2
+
+    def test_hash_stable_when_no_changes(self, tmp_env):
+        kind = "specialists"
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "intake")
+        manifests = build_overlay_manifest(
+            kind, tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        h1 = manifest_hash(manifests)
+        h2 = manifest_hash(
+            build_overlay_manifest(kind, tmp_env["profile_id"], tmp_env["hermes_root"])
+        )
+        assert h1 == h2
+
+    def test_empty_manifest_has_stable_hash(self, tmp_env):
+        manifests = build_overlay_manifest(
+            "specialists", tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        assert manifests == []
+        # Should not raise; should be deterministic.
+        assert (
+            manifest_hash(manifests)
+            == manifest_hash(
+                build_overlay_manifest(
+                    "specialists", tmp_env["profile_id"], tmp_env["hermes_root"]
+                )
+            )
+        )
+
+
+# =========================================================================
+# YAML failure tolerance
+# =========================================================================
+
+
+class TestYamlFailure:
+    def test_bad_yaml_logged_and_skipped(self, tmp_env, caplog):
+        kind = "specialists"
+        bad_dir = (tmp_env["hermes_root"] / kind / "broken")
+        bad_dir.mkdir(parents=True)
+        # YAML deliberately broken — unterminated string
+        (bad_dir / "SPECIALIST.md").write_text(
+            "---\nname: \"unterminated\nfield: value\n---\nbody",
+            encoding="utf-8",
+        )
+        good_path = _write_entry(tmp_env["hermes_root"] / kind, kind, "intake")
+        with caplog.at_level(logging.WARNING, logger="agent.overlay_resolver"):
+            entries = list_overlay_entries(
+                kind, tmp_env["profile_id"], tmp_env["hermes_root"]
+            )
+        names = [e.name for e in entries]
+        # We don't strictly assert "broken" is dropped — parse_frontmatter
+        # has a fallback path that may yield a partial dict — but "intake"
+        # MUST always come through cleanly regardless.
+        assert "intake" in names
+        assert good_path.is_file()
+
+
+# =========================================================================
+# Hidden / ignored files
+# =========================================================================
+
+
+class TestHiddenIgnored:
+    def test_dotfiles_ignored(self, tmp_env):
+        kind = "skills"
+        # A .hash.signed file at the layer root must not be picked up.
+        (tmp_env["hermes_root"] / kind / ".hash.signed").mkdir(parents=True)
+        _write_entry(tmp_env["hermes_root"] / kind, kind, "coach")
+        entries = list_overlay_entries(
+            kind, tmp_env["profile_id"], tmp_env["hermes_root"]
+        )
+        names = [e.name for e in entries]
+        assert names == ["coach"]
