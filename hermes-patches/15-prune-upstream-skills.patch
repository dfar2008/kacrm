-```javascript
-const STATES = { IDLE: 0, ENTER: 1, ACTIVE: 2, EXIT: 3 };
-let state = STATES.IDLE;
-let stateStart = 0;
-
-function setState(newState) {
-  state = newState;
-  stateStart = millis();
-}
-
-function stateTime() {
-  return millis() - stateStart;
-}
-
-function draw() {
