+++ b/crm/i18n/filter_normalizer.py
@@ -0,0 +1,55 @@
+from __future__ import annotations
+
+from typing import Any
+
+from hermes.crm.i18n.filter_operators import normalize_filter_operator, to_legacy_operator
+from hermes.crm.i18n.options import (
+    normalize_submitted_multiselect_values,
+    normalize_submitted_picklist_value,
+)
+
+
+def normalize_filter_list(
+    filters: list[dict[str, Any]] | Any,
+    field_map: dict[str, dict[str, Any]],
+) -> list[dict[str, Any]]:
+    if not isinstance(filters, list):
+        return []
+    normalized: list[dict[str, Any]] = []
+    for item in filters:
+        if not isinstance(item, dict):
+            continue
+        row = dict(item)
+        if "operator" not in row and "op" in row:
+            row["operator"] = row.get("op")
+        if "operator" in row:
+            row["operator"] = normalize_filter_operator(row.get("operator"))
+            row["op"] = to_legacy_operator(row["operator"])
+
+        field_name = str(row.get("field") or "").strip()
+        if not field_name:
+            normalized.append(row)
+            continue
+        if "#" in field_name:
+            # relation-field filters use "field#moduleId"
+            normalized.append(row)
+            continue
+
+        field = field_map.get(field_name) or {}
+        field_type = str(field.get("field_type") or "").strip()
+        options_raw = field.get("options")
+        value = row.get("value")
+
+        if field_type == "select":
+            row["value"] = normalize_submitted_picklist_value(options_raw, value)
+        elif field_type == "multiSelect":
+            if isinstance(value, list):
+                row["value"] = normalize_submitted_multiselect_values(options_raw, value)
+            elif isinstance(value, str):
+                normalized_text = value.replace("，", ",").replace(";", ",")
+                chunks = [x.strip() for x in normalized_text.split(",") if x.strip()]
+                row["value"] = normalize_submitted_multiselect_values(options_raw, chunks)
+            elif value not in (None, ""):
+                row["value"] = normalize_submitted_multiselect_values(options_raw, [value])
+        normalized.append(row)
+    return normalized
diff --git a/crm/i18n/filter_operators.py b/crm/i18n/filter_operators.py
