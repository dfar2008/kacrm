index 0000000000..f349f471eb
--- /dev/null
+++ b/tests/gateway/test_multiplex_channel_push.py
@@ -0,0 +1,161 @@
+"""Multiplex-aware ``POST /internal/channel/push`` (tenant-prefixed pushes).
+
+With multiplex as the default topology the cloud tenant-prefixes every
+internal URL (``pm.mux_path_prefix``), so coach-hint / weekly-report pushes
+arrive at ``/p/<profile>/internal/channel/push``. The handler must resolve
+that tenant's adapters from ``GatewayRunner._profile_adapters`` — the shared
+default map (``self._peer_adapters``) only carries the active profile's
+adapters, so the old peer-only lookup 404'd (unregistered mirror) or 503'd
+(platform_not_connected) for every non-default tenant.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter, _api_request_profile
+
+
+class _SendResult:
+    def __init__(self, message_id: str):
+        self.success = True
+        self.message_id = message_id
+        self.error = None
+
+
+class _FakeIMAdapter:
+    """Stands in for a connected feishu/weixin adapter; records sends."""
+
+    def __init__(self, name: str):
+        self.name = name
+        self.sent = []
+
+    async def send(self, channel_id: str, text: str) -> _SendResult:
+        self.sent.append((channel_id, text))
+        return _SendResult(message_id=f"{self.name}-mid")
+
+
+class _FakeRequest:
+    def __init__(self, body: dict):
+        self._body = body
+        self.headers = {}
+        self.app = {}
+        # v0.20.1: the error-response paths log a request fingerprint
+        # (_clean_log_value(request.method / request.path_qs / remote)),
+        # so the stub must carry the attributes a real aiohttp Request has.
+        self.method = "POST"
+        self.path_qs = "/internal/channel/push"
+        self.remote = "127.0.0.1"
+
+    async def json(self) -> dict:
+        return self._body
+
+
+def _make_adapter(profile_adapters: dict, peer_adapters: dict) -> APIServerAdapter:
+    cfg = PlatformConfig(enabled=True, extra={"host": "127.0.0.1", "port": 8642})
+    adapter = APIServerAdapter(cfg)
+    adapter._api_key = ""  # no-key branch: skip Bearer auth in unit tests
+    # v0.20.1 hardening: a NAMED profile in _api_request_profile fails closed
+    # unless a profile-scoped API_SERVER_KEY resolves (no scope in unit
+    # tests → 401 before the routing logic under test here even runs). Auth
+    # has its own upstream coverage; stub it out so these tests exercise
+    # adapter RESOLUTION (tenant map / refusal / fallthrough) only.
+    adapter._check_auth = lambda request: None
+    adapter._own_profile_name = "default"  # deterministic, env-independent
+
+    class _Runner:
+        config = GatewayConfig(multiplex_profiles=True)
+        _profile_adapters = profile_adapters
+
+    adapter.gateway_runner = _Runner()
+    adapter.attach_peer_adapters(peer_adapters)
+    return adapter
+
+
+_BODY = {"platform": "feishu", "channel_id": "oc_1", "text": "hi"}
+
+
+async def _push(adapter: APIServerAdapter, profile):
+    """Invoke the handler the way the profile-prefix middleware would."""
+    token = _api_request_profile.set(profile)
+    try:
+        resp = await adapter._handle_internal_channel_push(_FakeRequest(dict(_BODY)))
+    finally:
+        _api_request_profile.reset(token)
+    return resp.status, json.loads(resp.body.decode())
+
+
+class TestOverlayRouteMirror:
+    def test_push_route_is_mirrored_under_profile_prefix(self):
+        adapter = _make_adapter({}, {})
+        rows = {(method, path) for method, path, _h in adapter._overlay_route_table()}
+        assert ("POST", "/internal/channel/push") in rows
+        assert ("POST", "/p/{profile}/internal/channel/push") in rows
+        # reload-adapters carries the profile in its own path — no mirror.
+        assert ("POST", "/internal/profiles/{profile}/reload-adapters") in rows
+
+
+class TestMultiplexChannelPush:
+    @pytest.mark.asyncio
+    async def test_tenant_prefix_uses_that_profiles_adapters(self):
+        default_im = _FakeIMAdapter("default")
+        tenant_im = _FakeIMAdapter("coder")
+        adapter = _make_adapter(
+            {"coder": {Platform.FEISHU: tenant_im}},
+            {Platform.FEISHU: default_im},
+        )
+        status, body = await _push(adapter, "coder")
+        assert status == 200
+        assert body["ok"] is True
+        assert body["message_id"] == "coder-mid"
+        assert tenant_im.sent == [("oc_1", "hi")]
+        assert default_im.sent == []
+
+    @pytest.mark.asyncio
+    async def test_bare_path_still_uses_peer_adapters(self):
+        default_im = _FakeIMAdapter("default")
+        tenant_im = _FakeIMAdapter("coder")
+        adapter = _make_adapter(
+            {"coder": {Platform.FEISHU: tenant_im}},
+            {Platform.FEISHU: default_im},
+        )
+        status, body = await _push(adapter, None)
+        assert status == 200
+        assert body["message_id"] == "default-mid"
+        assert default_im.sent == [("oc_1", "hi")]
+        assert tenant_im.sent == []
+
+    @pytest.mark.asyncio
+    async def test_active_profile_prefix_falls_back_to_peer_adapters(self):
+        """/p/<active>/ — the owner has no _profile_adapters entry by design."""
+        default_im = _FakeIMAdapter("default")
+        adapter = _make_adapter({}, {Platform.FEISHU: default_im})
+        status, body = await _push(adapter, "default")
+        assert status == 200
+        assert body["message_id"] == "default-mid"
+        assert default_im.sent == [("oc_1", "hi")]
+
+    @pytest.mark.asyncio
+    async def test_unregistered_secondary_is_refused_not_crosswired(self):
+        """A served secondary with no adapter map must NOT push through the
+        default tenant's bot — that would deliver from the wrong identity."""
+        default_im = _FakeIMAdapter("default")
+        adapter = _make_adapter({}, {Platform.FEISHU: default_im})
+        status, body = await _push(adapter, "ghost")
+        assert status == 503
+        assert body["error"]["code"] == "profile_not_connected"
+        assert default_im.sent == []
+
+    @pytest.mark.asyncio
+    async def test_tenant_missing_platform_503s(self):
+        tenant_im = _FakeIMAdapter("coder")
+        adapter = _make_adapter(
+            {"coder": {Platform.WEIXIN: tenant_im}},
+            {Platform.FEISHU: _FakeIMAdapter("default")},
+        )
+        status, body = await _push(adapter, "coder")
+        assert status == 503
+        assert body["error"]["code"] == "platform_not_connected"
+        assert tenant_im.sent == []
diff --git a/tests/gateway/test_multiplex_dm_authz.py b/tests/gateway/test_multiplex_dm_authz.py
new file mode 100644
index 0000000000..59c47b2f26
--- /dev/null
+++ b/tests/gateway/test_multiplex_dm_authz.py
@@ -0,0 +1,120 @@
+"""Regression tests for the multiplex private-chat (DM) default-allow.
+
+Under ``gateway.multiplex_profiles``, a per-profile deployment has no env
+allowlist slot, so the profile owner DMing their own bot on channels like
+DingTalk / WeCom was rejected by the env-only default-deny in
+``_is_user_authorized`` ("Unauthorized user … on dingtalk"). The fix admits
+DMs under multiplex when no allowlist is configured, mirroring the Feishu
+adapter's intake DM admission. These tests pin the exact scope:
+
+* multiplex + DM + no allowlist            → authorized (owner can reply)
+* multiplex + GROUP + no allowlist         → still default-deny
+* multiplex + DM + allowlist (not in it)   → still allowlist-denied
+* NON-multiplex + DM + no allowlist        → unchanged default-deny (gated)
+"""
+
+from unittest.mock import MagicMock
+
+from gateway.config import GatewayConfig, Platform
+from gateway.session import SessionSource
+
+
+def _clear_auth_env(monkeypatch) -> None:
+    for key in (
+        "DINGTALK_ALLOWED_USERS",
+        "DINGTALK_ALLOW_ALL_USERS",
+        "GATEWAY_ALLOWED_USERS",
+        "GATEWAY_ALLOW_ALL_USERS",
+    ):
+        monkeypatch.delenv(key, raising=False)
+
+
+def _make_runner(monkeypatch, *, multiplex: bool):
+    """Bare runner with no live adapter for DingTalk (not an own-policy adapter).
+
+    DingTalk does not set ``enforces_own_access_policy``, so authorization falls
+    through to the env-allowlist / multiplex-DM decision — the path under test.
+    """
+    from gateway.run import GatewayRunner
+
+    _clear_auth_env(monkeypatch)
+
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(multiplex_profiles=multiplex)
+    runner.adapters = {}
+    runner._profile_adapters = {}
+    runner.pairing_store = MagicMock()
+    runner.pairing_store.is_approved.return_value = False
+    return runner
+
+
+def test_multiplex_dm_no_allowlist_denied(monkeypatch):
+    """Review R2-1: multiplex DM with no allowlist must NOT be blanket-admitted.
+
+    A previous revision default-allowed any DM sender under multiplex ("DM ==
+    owner"), a privilege-escalation hole for enterprise bots any colleague can
+    DM. The secure behavior falls through to default-deny (same as single
+    profile); owner-reply requires the owner's IM id materialized into the
+    per-profile allowlist / pairing.
+    """
+    runner = _make_runner(monkeypatch, multiplex=True)
+
+    source = SessionSource(
+        platform=Platform.DINGTALK,
+        user_id="random-colleague-999",
+        chat_id="dm-chat",
+        user_name="colleague",
+        chat_type="dm",
+        profile="coder",
+    )
+
+    assert runner._is_user_authorized(source) is False
+
+
+def test_multiplex_group_no_allowlist_still_denied(monkeypatch):
+    """Group traffic is NOT covered by the DM default-allow."""
+    runner = _make_runner(monkeypatch, multiplex=True)
+
+    source = SessionSource(
+        platform=Platform.DINGTALK,
+        user_id="member-123",
+        chat_id="group-chat",
+        user_name="member",
+        chat_type="group",
+        profile="coder",
+    )
+
+    assert runner._is_user_authorized(source) is False
+
+
+def test_multiplex_dm_with_allowlist_still_enforced(monkeypatch):
+    """A configured allowlist still gates DMs — the DM allow does not override it."""
+    runner = _make_runner(monkeypatch, multiplex=True)
+    monkeypatch.setenv("DINGTALK_ALLOWED_USERS", "someone-else")
+
+    source = SessionSource(
+        platform=Platform.DINGTALK,
+        user_id="not-listed",
+        chat_id="dm-chat",
+        user_name="stranger",
+        chat_type="dm",
+        profile="coder",
+    )
+
+    assert runner._is_user_authorized(source) is False
+
+
+def test_non_multiplex_dm_no_allowlist_unchanged(monkeypatch):
+    """Non-multiplex gateways keep the env-only default-deny (fix is gated)."""
+    runner = _make_runner(monkeypatch, multiplex=False)
+
+    source = SessionSource(
+        platform=Platform.DINGTALK,
+        user_id="owner-123",
+        chat_id="dm-chat",
+        user_name="owner",
+        chat_type="dm",
+        profile=None,
+    )
+
+    assert runner._is_user_authorized(source) is False
diff --git a/tests/gateway/test_multiplex_executor_isolation.py b/tests/gateway/test_multiplex_executor_isolation.py
new file mode 100644
index 0000000000..91f6a1220d
--- /dev/null
+++ b/tests/gateway/test_multiplex_executor_isolation.py
@@ -0,0 +1,211 @@
+"""Multiplex executor isolation: adapters must not use the default executor.
+
+Under single-process multiplex (N profiles share one process + one default
+asyncio thread pool ``min(32, cpu+4)``), any adapter that offloads blocking
+work with ``loop.run_in_executor(None, ...)`` competes for those default-pool
+threads. The Feishu WebSocket receive loop is *permanently* blocking, so N
+Feishu profiles pin N default-pool threads forever; stacked with email's
+IMAP/SMTP blocking calls this starves every other consumer of the default
+executor (default-thread-pool starvation).
+
+The fix: each adapter owns its own ThreadPoolExecutor (one per profile, since
+each profile has its own adapter instance) and offloads onto it — never the
+default executor (``None``). This test locks in that the hot offload paths pass
+an adapter-owned executor (not ``None``) and that those executors are shut down
+on disconnect so no threads leak.
+"""
+from __future__ import annotations
+
+import asyncio
+import concurrent.futures
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+
+# ---------------------------------------------------------------------------
+# Feishu WebSocket receive loop
+# ---------------------------------------------------------------------------
+
+
+def _bare_feishu_adapter():
+    """A FeishuAdapter with only the executor/ws fields wired (no __init__)."""
+    from plugins.platforms.feishu.adapter import FeishuAdapter
+
+    adapter = object.__new__(FeishuAdapter)
+    adapter._app_id = "cli_test"
+    adapter._app_secret = "secret"
+    adapter._domain_name = "feishu"
+    adapter._ws_executor = None
+    adapter._ws_executor_lock = threading.Lock()
+    return adapter
+
+
+class _FakeLoop:
+    """Minimal loop stand-in that records the executor passed to run_in_executor."""
+
+    def __init__(self):
+        self.captured_executor = "UNSET"
+
+    def is_closed(self):
+        return False
+
+    def run_in_executor(self, executor, func, *args):
+        self.captured_executor = executor
+        fut = asyncio.get_event_loop().create_future()
+        fut.set_result(None)
+        return fut
+
+
+def test_ws_executor_getter_creates_dedicated_pool():
+    adapter = _bare_feishu_adapter()
+    executor = adapter._get_ws_executor()
+    assert isinstance(executor, concurrent.futures.ThreadPoolExecutor)
+    # Same instance returned while alive.
+    assert adapter._get_ws_executor() is executor
+    adapter._shutdown_ws_executor()
+
+
+def test_ws_executor_shutdown_clears_reference():
+    adapter = _bare_feishu_adapter()
+    ex = adapter._get_ws_executor()
+    adapter._shutdown_ws_executor()
+    assert getattr(ex, "_shutdown", False) is True
+    assert adapter._ws_executor is None
+    # Idempotent.
+    adapter._shutdown_ws_executor()
+
+
+@pytest.mark.asyncio
+async def test_connect_websocket_uses_owned_executor_not_default():
+    """Starting the ws receive client must pass an adapter-owned executor, not None."""
+    adapter = _bare_feishu_adapter()
+    fake_loop = _FakeLoop()
+    adapter._loop = fake_loop
+
+    async def _noop():
+        return None
+
+    adapter._hydrate_bot_identity = _noop
+    adapter._build_lark_client = MagicMock(return_value=MagicMock())
+    adapter._build_event_handler = MagicMock(return_value=MagicMock())
+
+    with patch("plugins.platforms.feishu.adapter.FEISHU_WEBSOCKET_AVAILABLE", True), \
+         patch("plugins.platforms.feishu.adapter.FeishuWSClient", MagicMock()):
+        await adapter._connect_websocket()
+
+    # The receive loop must NOT run on the default executor (None).
+    assert fake_loop.captured_executor is not None
+    assert fake_loop.captured_executor is adapter._ws_executor
+    assert isinstance(fake_loop.captured_executor, concurrent.futures.ThreadPoolExecutor)
+    adapter._shutdown_ws_executor()
+
+
+@pytest.mark.asyncio
+async def test_feishu_disconnect_shuts_down_ws_executor():
+    """A real disconnect must shut the ws executor down (no leaked threads)."""
+    adapter = _bare_feishu_adapter()
+    ws_executor = adapter._get_ws_executor()
+
+    # Wire only the fields disconnect touches; stub the heavy collaborators.
+    adapter._running = True
+    adapter._ws_supervisor = None
+    adapter._pending_text_batch_tasks = {}
+    adapter._pending_media_batch_tasks = {}
+    adapter._pending_text_batches = {}
+    adapter._pending_text_batch_counts = {}
+    adapter._pending_media_batches = {}
+    adapter._ws_client = None
+    adapter._ws_thread_loop = None
+    adapter._ws_future = None
+    adapter._webhook_runner = None
+    adapter._sdk_executor_lock = None  # _shutdown_sdk_executor returns early
+    adapter._persist_seen_message_ids = lambda: None
+    adapter._mark_disconnected = lambda: None
+
+    async def _noop():
+        return None
+
+    adapter._release_app_lock = _noop
+
+    await adapter.disconnect()
+
+    assert getattr(ws_executor, "_shutdown", False) is True
+    assert adapter._ws_executor is None
+
+
+# ---------------------------------------------------------------------------
+# Email IMAP fetch / SMTP send
+# ---------------------------------------------------------------------------
+
+
+def _bare_email_adapter():
+    from plugins.platforms.email.adapter import EmailAdapter
+
+    adapter = object.__new__(EmailAdapter)
+    adapter._io_executor = None
+    adapter._io_executor_lock = threading.Lock()
+    return adapter
+
+
+def test_email_io_executor_getter_creates_pool():
+    adapter = _bare_email_adapter()
+    ex = adapter._get_io_executor()
+    assert isinstance(ex, concurrent.futures.ThreadPoolExecutor)
+    assert adapter._get_io_executor() is ex
+    adapter._shutdown_io_executor()
+    assert adapter._io_executor is None
+
+
+@pytest.mark.asyncio
+async def test_email_check_inbox_uses_owned_executor_not_default():
+    adapter = _bare_email_adapter()
+    adapter._last_fetch_failed = False
+    adapter._fetch_new_messages = lambda authorize: []
+
+    captured = {}
+    real_run_in_executor = asyncio.get_event_loop().run_in_executor
+
+    def _spy(executor, func, *args):
+        captured["executor"] = executor
+        return real_run_in_executor(executor, func, *args)
+
+    loop = asyncio.get_running_loop()
+    with patch.object(loop, "run_in_executor", _spy):
+        await adapter._check_inbox()
+
+    assert captured["executor"] is not None
+    assert captured["executor"] is adapter._io_executor
+    adapter._shutdown_io_executor()
+
+
+@pytest.mark.asyncio
+async def test_email_send_uses_owned_executor_not_default():
+    adapter = _bare_email_adapter()
+    adapter._address = "hermes@test.com"
+    adapter._send_email = lambda chat_id, content, reply_to: "<mid@test.com>"
+
+    async def _noop_tap(**kwargs):
+        return None
+
+    adapter._tap_interaction_log = _noop_tap
+    adapter._outbound_subject_for = lambda chat_id: "Re: x"
+    adapter._outbound_in_reply_to_for = lambda chat_id: None
+
+    captured = {}
+    real_run_in_executor = asyncio.get_event_loop().run_in_executor
+
+    def _spy(executor, func, *args):
+        captured["executor"] = executor
+        return real_run_in_executor(executor, func, *args)
+
+    loop = asyncio.get_running_loop()
+    with patch.object(loop, "run_in_executor", _spy):
+        result = await adapter.send("user@test.com", "hi")
+
+    assert result.success is True
+    assert captured["executor"] is not None
+    assert captured["executor"] is adapter._io_executor
+    adapter._shutdown_io_executor()
diff --git a/tests/gateway/test_multiplex_hot_reload.py b/tests/gateway/test_multiplex_hot_reload.py
new file mode 100644
index 0000000000..645a53949d
--- /dev/null
+++ b/tests/gateway/test_multiplex_hot_reload.py
@@ -0,0 +1,180 @@
+"""Multiplex hot-reload: reload one profile's IM adapters in place.
+
+``GatewayRunner.reload_profile_adapters`` must:
+  - disconnect + clear the target profile's existing adapters, then reconnect
+    them via the same startup path (``_start_one_profile_adapters``);
+  - refuse the active/default profile (its adapters are owned by the shared
+    gateway) by raising ``ValueError`` so the HTTP layer can 409;
+  - never touch other profiles' adapter maps.
+
+The runner is built with ``__new__`` (skipping the heavy __init__) and only the
+attributes the method touches are set, so no real gateway/adapters are created.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from gateway.run import GatewayRunner
+
+
+class _FakeAdapter:
+    """Minimal adapter stand-in; no credential attrs => fingerprint is None."""
+
+    def __init__(self, name: str):
+        self.name = name
+
+
+def _make_runner():
+    runner = GatewayRunner.__new__(GatewayRunner)
+    runner._primary_profile_name = "default"
+    runner.adapters = {}
+    runner._profile_adapters = {}
+    runner._profile_failed_platforms = {}
+    return runner
+
+
+@pytest.fixture
+def patched_profiles(monkeypatch):
+    """Stub hermes_cli.profiles so 'default' is active and 'alice' resolves."""
+    import hermes_cli.profiles as profiles
+
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+    monkeypatch.setattr(
+        profiles,
+        "profiles_to_serve",
+        lambda multiplex=False: [("alice", Path("/tmp/alice-home"))],
+    )
+    monkeypatch.setattr(
+        profiles, "get_profile_dir", lambda name: Path(f"/tmp/{name}-home")
+    )
+    return profiles
+
+
+@pytest.mark.asyncio
+async def test_reload_disconnects_and_reconnects(monkeypatch, patched_profiles):
+    runner = _make_runner()
+
+    # Two live fake adapters for alice, keyed by a platform-ish sentinel.
+    ad1, ad2 = _FakeAdapter("a1"), _FakeAdapter("a2")
+    runner._profile_adapters["alice"] = {"feishu": ad1, "telegram": ad2}
+
+    disconnected: list = []
+
+    async def fake_disconnect(adapter, platform):
+        disconnected.append((adapter, platform))
+
+    start_calls: list = []
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        start_calls.append((profile_name, profile_home, claimed))
+        # Swap-then-disconnect contract: write the fresh adapters into the
+        # scratch target_map; the reload swaps it in and disconnects old.
+        dest = (
+            target_map
+            if target_map is not None
+            else runner._profile_adapters.setdefault(profile_name, {})
+        )
+        dest["feishu"] = _FakeAdapter("new")
+        if stats is not None:
+            stats["attempted"] = 1
+        return 1
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    connected = await runner.reload_profile_adapters("alice")
+
+    # Old adapters were both disconnected.
+    assert {a for a, _ in disconnected} == {ad1, ad2}
+    # Reconnect ran once, for alice, with the resolved home.
+    assert len(start_calls) == 1
+    assert start_calls[0][0] == "alice"
+    assert start_calls[0][1] == Path("/tmp/alice-home")
+    # Return value propagates the reconnect count.
+    assert connected == 1
+
+
+@pytest.mark.asyncio
+async def test_reload_refuses_active_profile(monkeypatch, patched_profiles):
+    runner = _make_runner()
+    called = {"start": False}
+
+    async def fake_start_one(*a, **k):
+        called["start"] = True
+        return 0
+
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    with pytest.raises(ValueError):
+        await runner.reload_profile_adapters("default")
+
+    assert called["start"] is False
+
+
+@pytest.mark.asyncio
+async def test_reload_refuses_active_named_profile(monkeypatch):
+    """A pinned named primary must be refused even under another profile scope."""
+    import hermes_cli.profiles as profiles
+
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "other")
+    runner = _make_runner()
+    runner._primary_profile_name = "alice"
+
+    with pytest.raises(ValueError):
+        await runner.reload_profile_adapters("alice")
+
+
+@pytest.mark.asyncio
+async def test_reload_leaves_other_profiles_untouched(monkeypatch, patched_profiles):
+    runner = _make_runner()
+    bob_map = {"telegram": _FakeAdapter("bob")}
+    runner._profile_adapters["alice"] = {"feishu": _FakeAdapter("alice")}
+    runner._profile_adapters["bob"] = bob_map
+
+    async def fake_disconnect(adapter, platform):
+        return None
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        return 0
+
+    monkeypatch.setattr(runner, "_safe_adapter_disconnect", fake_disconnect)
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    await runner.reload_profile_adapters("alice")
+
+    # bob's adapter map object is untouched.
+    assert runner._profile_adapters["bob"] is bob_map
+
+
+@pytest.mark.asyncio
+async def test_reload_cancels_pending_reconnect(monkeypatch, patched_profiles):
+    import asyncio
+
+    runner = _make_runner()
+    runner._profile_adapters["alice"] = {}
+
+    async def _never():
+        await asyncio.sleep(3600)
+
+    pending_task = asyncio.ensure_future(_never())
+    runner._profile_failed_platforms["alice"] = {"feishu": pending_task}
+
+    async def fake_start_one(
+        profile_name, profile_home, claimed, target_map=None, stats=None
+    ):
+        return 0
+
+    monkeypatch.setattr(runner, "_start_one_profile_adapters", fake_start_one)
+
+    await runner.reload_profile_adapters("alice")
+    await asyncio.sleep(0)  # let the cancellation propagate
+
+    assert pending_task.cancelled()
+    # The profile's pending map was cleared.
+    assert "alice" not in runner._profile_failed_platforms
diff --git a/tests/gateway/test_multiplex_identity_per_turn.py b/tests/gateway/test_multiplex_identity_per_turn.py
new file mode 100644
index 0000000000..22e82c8d2e
--- /dev/null
+++ b/tests/gateway/test_multiplex_identity_per_turn.py
@@ -0,0 +1,269 @@
+"""Per-turn identity resolution under the kacrm single-process multiplexer.
+
+SAFETY-CRITICAL: kacrm runs ONE gateway process serving MANY profiles. The
+active profile is resolved per turn via a context-local ``HERMES_HOME``
+override. If identity (``current_user_id`` / the CRM tool handlers) freezes at
+process start — as it did with ``@lru_cache(maxsize=1)`` and import-time env
+baking — tenant A's operations get recorded under tenant B: a cross-tenant
+data leak.
+
+These tests pin the two safety properties that replace the frozen identity:
+
+  1. Per-turn resolution — the SAME code resolves alice under alice's scope
+     and bob under bob's scope.
+  2. Fail-closed — under multiplexing with NO per-turn scope, resolution RAISES
+     rather than silently attributing the turn to the process default.
+
+Plus: non-multiplex behavior is unchanged, and the slug→id cache is keyed per
+slug (never a single frozen entry that would collapse two tenants).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+# ``hermes_cloud`` lives one directory up from the hermes package root and is
+# not on the gateway test harness's path (PYTHONPATH=hermes). Add the worktree
+# root so ``hermes_cloud.app.identity`` imports, mirroring how the cloud process
+# has both packages installed.
+_WORKTREE_ROOT = Path(__file__).resolve().parents[3]
+if str(_WORKTREE_ROOT) not in sys.path:
+    sys.path.insert(0, str(_WORKTREE_ROOT))
+
+import hermes_cloud.app.identity as identity  # noqa: E402
+import tools.crm_tools as crm_tools  # noqa: E402
+from agent import secret_scope as ss  # noqa: E402
+from hermes_constants import (  # noqa: E402
+    set_hermes_home_override,
+    reset_hermes_home_override,
+)
+
+
+# ---------------------------------------------------------------------------
+# fixtures / helpers
+# ---------------------------------------------------------------------------
+
+@pytest.fixture(autouse=True)
+def _reset_state():
+    """Isolate every test: multiplex flag OFF, identity caches cleared."""
+    ss.set_multiplex_active(False)
+    identity._uid_cache.clear()
+    crm_tools._uid_by_slug.clear()
+    yield
+    ss.set_multiplex_active(False)
+    identity._uid_cache.clear()
+    crm_tools._uid_by_slug.clear()
+
+
+@contextlib.contextmanager
+def _scope(home: Path):
+    """Enter a per-turn profile scope (context-local HERMES_HOME override)."""
+    token = set_hermes_home_override(str(home))
+    try:
+        yield
+    finally:
+        reset_hermes_home_override(token)
+
+
+def _install_fake_db(monkeypatch, id_by_slug, calls):
+    """Route both identity's and crm_tools' slug→id lookups to a fake db.
+
+    identity imports ``hermes.crm.db`` (cloud package layout); crm_tools imports
+    top-level ``crm.db`` (gateway layout). We satisfy both so the tests never
+    touch a real database. ``calls`` collects every queried slug so callers can
+    assert the per-slug cache actually elides repeat lookups.
+    """
+    class _Session:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_a):
+            return False
+
+        def fetchone(self, _sql, params):
+            slug = params[0]
+            calls.append(slug)
+            uid = id_by_slug.get(slug)
+            return {"id": uid} if uid is not None else None
+
+    def db_session():
+        return _Session()
+
+    # Gateway layout: patch the attribute on the real (already-imported) module.
+    import crm.db as real_crm_db
+    monkeypatch.setattr(real_crm_db, "db_session", db_session)
+
+    # Cloud layout: inject a fake ``hermes.crm.db`` chain so identity's primary
+    # import resolves to the fake without importing the heavy real crm package.
+    fake_hermes = types.ModuleType("hermes")
+    fake_hermes.__path__ = []  # mark as a package
+    fake_crm = types.ModuleType("hermes.crm")
+    fake_crm.__path__ = []
+    fake_db = types.ModuleType("hermes.crm.db")
+    fake_db.db_session = db_session
+    fake_crm.db = fake_db
+    fake_hermes.crm = fake_crm
+    monkeypatch.setitem(sys.modules, "hermes", fake_hermes)
+    monkeypatch.setitem(sys.modules, "hermes.crm", fake_crm)
+    monkeypatch.setitem(sys.modules, "hermes.crm.db", fake_db)
+
+
+# ---------------------------------------------------------------------------
+# 1. Two tenants never cross — current_user_id() resolves per scope.
+# ---------------------------------------------------------------------------
+
+def test_current_user_id_resolves_per_scope(tmp_path):
+    ss.set_multiplex_active(True)
+    alice = tmp_path / "alice"
+    bob = tmp_path / "bob"
+    alice.mkdir()
+    bob.mkdir()
+
+    with _scope(alice):
+        assert identity.current_user_id() == "alice"
+    with _scope(bob):
+        # A frozen (lru_cache) impl would still return "alice" here — the leak.
+        assert identity.current_user_id() == "bob"
+    # And back into alice's scope: still correct, not stuck on bob.
+    with _scope(alice):
+        assert identity.current_user_id() == "alice"
+
+
+# ---------------------------------------------------------------------------
+# 2. Fail-closed — multiplex active, no per-turn scope → RAISE, never default.
+# ---------------------------------------------------------------------------
+
+def test_current_user_id_fails_closed_without_scope(monkeypatch):
+    ss.set_multiplex_active(True)
+    # Even with a process HERMES_HOME present, no per-turn override => refuse.
+    monkeypatch.setenv("HERMES_HOME", "/tmp/some/default_profile")
+    assert identity.get_hermes_home_override() is None
+
+    with pytest.raises(identity.UnscopedIdentityError):
+        identity.current_user_id()
+
+    # current_user_id_int inherits the guard (fails before any db access).
+    with pytest.raises(identity.UnscopedIdentityError):
+        identity.current_user_id_int()
+
+
+# ---------------------------------------------------------------------------
+# 3. Non-multiplex — behavior identical to legacy env read (no scope needed).
+# ---------------------------------------------------------------------------
+
+def test_current_user_id_non_multiplex_reads_env(monkeypatch):
+    ss.set_multiplex_active(False)
+    monkeypatch.setenv("HERMES_HOME", str(Path("/srv/profiles/charlie")))
+    # No override installed, no multiplexing: resolves from env, does not raise.
+    assert identity.get_hermes_home_override() is None
+    assert identity.current_user_id() == "charlie"
+
+
+def test_current_user_id_non_multiplex_unset_env_raises(monkeypatch):
+    ss.set_multiplex_active(False)
+    monkeypatch.delenv("HERMES_HOME", raising=False)
+    # Legacy loud failure preserved: never silently resolve ~/.hermes default.
+    with pytest.raises(RuntimeError):
+        identity.current_user_id()
+
+
+# ---------------------------------------------------------------------------
+# 4. crm_tools handler resolves identity PER CALL, not baked at registration.
+# ---------------------------------------------------------------------------
+
+def test_crm_handler_identity_is_per_call(tmp_path, monkeypatch):
+    ss.set_multiplex_active(True)
+    calls: list[str] = []
+    _install_fake_db(monkeypatch, {"alice": 11, "bob": 22}, calls)
+
+    captured = []
+
+    def fake_dispatch(*, tool_name, arguments, user_id, source, profile_id):
+        captured.append(
+            {"tool": tool_name, "user_id": user_id, "profile_id": profile_id}
+        )
+        return {"ok": True}
+
+    alice = tmp_path / "alice"
+    bob = tmp_path / "bob"
+    alice.mkdir()
+    bob.mkdir()
+
+    # Build a handler with DELIBERATELY-WRONG import-time identity (would be
+    # baked by the old code). Per-call resolution must ignore it under multiplex.
+    handler = crm_tools._make_handler("crm_search", uid=999, pid="_wrong_", dispatch_fn=fake_dispatch)
+
+    with _scope(alice):
+        handler({"q": "x"})
+    with _scope(bob):
+        handler({"q": "y"})
+
+    assert captured[0] == {"tool": "crm_search", "user_id": 11, "profile_id": "alice"}
+    assert captured[1] == {"tool": "crm_search", "user_id": 22, "profile_id": "bob"}
+
+
+def test_crm_handler_fails_closed_without_scope(monkeypatch):
+    ss.set_multiplex_active(True)
+
+    # Direct resolver raises the fail-closed error.
+    with pytest.raises(crm_tools.UnscopedCrmIdentityError):
+        crm_tools._resolve_identity(999, "_wrong_")
+
+    # The handler wrapper catches it and returns an error payload (never
+    # dispatches with a fallback identity).
+    dispatched = []
+
+    def fake_dispatch(**kw):
+        dispatched.append(kw)
+        return {"ok": True}
+
+    handler = crm_tools._make_handler("crm_search", uid=999, pid="_wrong_", dispatch_fn=fake_dispatch)
+    import json
+    out = json.loads(handler({}))
+    assert "error" in out
+    assert "scope" in out["error"].lower()
+    assert dispatched == []  # dispatch must NOT run under the leak condition
+
+
+def test_crm_handler_non_multiplex_uses_baked_identity(monkeypatch):
+    ss.set_multiplex_active(False)
+    captured = []
+
+    def fake_dispatch(*, tool_name, arguments, user_id, source, profile_id):
+        captured.append({"user_id": user_id, "profile_id": profile_id})
+        return {"ok": True}
+
+    handler = crm_tools._make_handler("crm_search", uid=7, pid="charlie", dispatch_fn=fake_dispatch)
+    # No scope, no db — legacy single-profile path returns baked identity.
+    handler({})
+    assert captured == [{"user_id": 7, "profile_id": "charlie"}]
+
+
+# ---------------------------------------------------------------------------
+# 5. Per-slug cache — never collapses two tenants, elides repeat db lookups.
+# ---------------------------------------------------------------------------
+
+def test_current_user_id_int_cache_keyed_per_slug(tmp_path, monkeypatch):
+    ss.set_multiplex_active(True)
+    calls: list[str] = []
+    _install_fake_db(monkeypatch, {"alice": 11, "bob": 22}, calls)
+
+    alice = tmp_path / "alice"
+    bob = tmp_path / "bob"
+    alice.mkdir()
+    bob.mkdir()
+
+    with _scope(alice):
+        assert identity.current_user_id_int() == 11
+        # Second lookup for the same slug must hit the cache (no new db call).
+        assert identity.current_user_id_int() == 11
+    with _scope(bob):
+        assert identity.current_user_id_int() == 22
+
+    # alice queried once, bob once — the second alice call was cached.
+    assert calls == ["alice", "bob"]
