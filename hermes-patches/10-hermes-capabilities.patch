+def _validate_module_name_pure(db: "DbWrapper", name: str) -> None:
+    """入队前轻量校验拟建模块名:格式/长度/保留字/已存在。失败抛 ValueError。"""
+    if not name or not _MODULE_NAME_RE.fullmatch(name):
+        raise ValueError(f"invalid module name {name!r}: 必须 [a-z][a-z0-9_]*")
+    if len(name) > 40:
+        raise ValueError(f"module name too long ({len(name)}>40): {name!r}")
+    if name in _MODULE_NAME_RESERVED or name.startswith("pg_"):
+        raise ValueError(f"reserved name: {name!r}")
+    row = db.fetchone("SELECT COUNT(*) AS n FROM collections WHERE name = %s", (name,))
+    if int((row or {}).get("n") or 0) > 0:
+        raise ValueError(f"module exists: {name!r}")
+
+
+def _actor_is_admin(db: "DbWrapper", user_id: int) -> bool:
+    """全局管理员口径 = users.is_admin。取不到身份按非管理员处理(安全默认)。"""
+    if not user_id:
+        return False
+    row = db.fetchone("SELECT is_admin FROM users WHERE id = %s", (int(user_id),))
+    return bool(row and row.get("is_admin"))
+
