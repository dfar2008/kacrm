@@ -0,0 +1,76 @@
+"""Kimi/Moonshot web-search provider — $web_search builtin (chat-with-search).
+
+Moonshot's $web_search is an in-chat builtin (no standalone results API): the
+model emits a $web_search tool_call, we echo the args back, Moonshot runs the
+search server-side, and the model returns a *grounded answer* (not a raw result
+list). We return that answer as a single web result. Selected when the user's
+chat model provider is Moonshot (cloud S0 writes web.search_backend=kimi +
+search_key/base/model). Reuses the user's Moonshot key.
+
+VERIFIED 2026-06-22 live (kimi-k2.6): 2-round flow returns real grounded data
+with cited source URLs. temperature must be 1 for k2.x models.
+"""
+from __future__ import annotations
+import logging
+from typing import Any, Dict
+import httpx
+from agent.web_search_provider import WebSearchProvider
+
+logger = logging.getLogger(__name__)
+
+def _webcfg() -> dict:
+    try:
+        from hermes_cli.config import load_config
+        return load_config().get("web", {}) or {}
+    except Exception:  # noqa: BLE001
+        return {}
+
+_TOOLS = [{"type": "builtin_function", "function": {"name": "$web_search"}}]
+
+
+class KimiWebSearchProvider(WebSearchProvider):
+    @property
+    def name(self) -> str: return "kimi"
+    @property
+    def display_name(self) -> str: return "Kimi (Moonshot $web_search)"
+    def is_available(self) -> bool: return bool(_webcfg().get("search_key"))
+    def supports_search(self) -> bool: return True
+    def supports_extract(self) -> bool: return False
+
+    def search(self, query: str, limit: int = 5) -> Dict[str, Any]:
+        cfg = _webcfg()
+        key = cfg.get("search_key")
+        base = str(cfg.get("search_base_url") or "https://api.moonshot.cn/v1").rstrip("/")
+        model = cfg.get("search_model") or "kimi-k2.6"
+        if not key:
+            return {"success": False, "error": "Kimi search_key 未配置"}
+        url = base + "/chat/completions"
+        H = {"Authorization": f"Bearer {key}", "Content-Type": "application/json"}
+        msgs = [{"role": "user", "content": f"联网搜索:{query}。简洁回答(要点+关键数据),并附信息来源链接。"}]
+        try:
+            with httpx.Client(timeout=150.0) as c:
+                rounds = 0
+                while rounds < 4:
+                    rounds += 1
+                    body = {"model": model, "messages": msgs, "tools": _TOOLS, "temperature": 1}
+                    ch = c.post(url, headers=H, json=body).json()["choices"][0]
+                    if ch.get("finish_reason") != "tool_calls":
+                        ans = (ch.get("message", {}).get("content") or "").strip()
+                        if not ans:
+                            return {"success": False, "error": "Kimi 联网无答案"}
+                        return {"success": True, "data": {"web": [{
+                            "title": f"Kimi 联网搜索结果: {query[:40]}",
+                            "url": "", "description": ans[:4000], "position": 1}]}}
+                    msgs.append(ch["message"])
+                    for tc in (ch["message"].get("tool_calls") or []):
+                        msgs.append({"role": "tool", "tool_call_id": tc["id"],
+                                     "name": tc["function"]["name"],
+                                     "content": tc["function"]["arguments"]})
+            return {"success": False, "error": "Kimi 联网轮次超限"}
+        except Exception as exc:  # noqa: BLE001
+            logger.warning("Kimi web_search error: %s", exc)
+            return {"success": False, "error": f"Kimi web_search failed: {exc}"}
+
+    def get_setup_schema(self) -> Dict[str, Any]:
+        return {"name": "Kimi (Moonshot)", "badge": "follows Kimi model · per-user key · grounded",
+                "tag": "Kimi $web_search 对话内联网", "env_vars": []}
