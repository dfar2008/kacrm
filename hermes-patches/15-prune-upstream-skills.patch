-### Manual Multi-Stop Gradient
-
-```javascript
-function multiLerp(colors, t) {
-  t = constrain(t, 0, 1);
-  let segment = t * (colors.length - 1);
-  let idx = floor(segment);
-  let frac = segment - idx;
-  idx = min(idx, colors.length - 2);
-  return lerpColor(colors[idx], colors[idx + 1], frac);
-}
-```
