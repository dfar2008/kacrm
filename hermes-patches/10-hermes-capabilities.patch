+def localize_field_label(
+    *,
+    table_name: str,
+    field_name: str,
+    field_label: str,
+    field_id: int | None = None,
+    locale: str | None = None,
+    field_config: Any = None,
+) -> str:
+    picked = locale or get_current_locale()
+    raw_label = str(field_label or field_name or "").strip()
+
+    # Highest priority: a per-field explicit translation stored on the
+    # field itself (``field_config.label_i18n[locale]``, edited via the
+    # Schema Hub's 组件属性 → 标签翻译 panel). This is authoritative —
+    # it overrides the locale JSON tables and the heuristic dictionaries
+    # below, which are only a fallback for fields with no explicit i18n.
+    label_i18n = _coerce_field_config(field_config).get("label_i18n")
+    if isinstance(label_i18n, dict):
+        override = str(label_i18n.get(picked) or "").strip()
+        if override:
+            return override
+    field_key = str(field_name or "").strip()
+    table_key = str(table_name or "").strip()
+    field_id_value = int(field_id or 0)
+
+    key_candidates = []
+    if table_key and field_key:
+        key_candidates.append(f"field.{table_key}.{field_key}")
+    if field_key:
+        key_candidates.append(f"field.common.{field_key}")
+
+    # ``field.id.{N}.label`` lookup intentionally NOT used here. The shipped
+    # ``locales/zh-CN.json`` inherited kacrm's 400+ hardcoded field-ID →
+    # label map, but our ``module_fields.id`` sequence is reseeded from
+    # scratch (accounts gets ids 1-N, contacts the next block, etc.) and
+    # doesn't match kacrm's assignments. Trusting the legacy map produced
+    # cross-wired translations: e.g. our ``accounts.mobile`` (id=4) would
+    # pick up kacrm's ``field.id.4`` → "公司名称" instead of "手机".
+    # Tenant-specific overrides can still be expressed via the slug variant
+    # below (``field.id.{N}.{slug}``), which requires the field_name to
+    # match, so cross-talk with legacy entries is impossible.
+    slug = re.sub(r"[^a-z0-9_]+", "_", field_key.lower()).strip("_")
+    if field_id_value > 0 and slug:
+        key_candidates.append(f"field.id.{field_id_value}.{slug}")
+
+    for key in key_candidates:
+        translated = t(key, picked)
+        if translated and translated != key:
+            return translated
+
+    by_name = COMMON_FIELD_LABELS.get(field_key)
+    if by_name:
+        return by_name.get(picked, raw_label)
+
+    if picked == "zh-CN":
+        return TEXT_TO_ZH.get(raw_label, raw_label)
+    if picked == "en-US":
+        return TEXT_TO_EN.get(raw_label, raw_label)
+    return raw_label
diff --git a/crm/i18n/filter_normalizer.py b/crm/i18n/filter_normalizer.py
