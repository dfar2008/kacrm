new file mode 100644
index 0000000000..91dcfdbd9b
--- /dev/null
+++ b/crm/models/users_db.py
@@ -0,0 +1,268 @@
+"""Users table gateway — ported from kacrm's ``app/models/users_db.py``.
+
+Port notes (kacrm MySQL → hermes_crm PostgreSQL):
+  - ``%s`` placeholders unchanged (both pymysql and psycopg3 use them).
+  - ``deleted`` is ``BOOLEAN`` (not ``tinyint(1)``) — so the old
+    ``deleted = 0 OR deleted IS NULL`` guard becomes ``deleted = FALSE``.
+  - ``status`` stays SMALLINT (1=active, 0=disabled) to preserve kacrm semantics.
+  - ``NOW()`` / DB-side defaults supplant the manual
+    ``datetime.now().strftime(...)`` dance.
+  - ``LAST_INSERT_ID()`` is replaced by ``RETURNING id`` via
+    :meth:`DbWrapper.insert`.
+  - The kacrm ``api_key`` / ``plan`` columns are hermes-cloud additions so
+    :meth:`insert` accepts them.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+class UsersDb:
+    """Table gateway over the ``users`` table."""
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        # When called outside a request scope (scripts, tests) you may pass
+        # ``None`` and the gateway will open its own short-lived connection
+        # per method. Inside FastAPI handlers, pass in the request-scoped db.
+        self._db = db
+
+    # ------------------------------------------------------------------
+    # Connection plumbing
+    # ------------------------------------------------------------------
+
+    def _run(self, fn):  # type: ignore[no-untyped-def]
+        """Run *fn(db)* using either the injected db or a short-lived one."""
+        if self._db is not None:
+            return fn(self._db)
+        with db_session() as db:
+            return fn(db)
+
+    # ------------------------------------------------------------------
+    # Reads
+    # ------------------------------------------------------------------
+
+    def get_user_by_id(self, user_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone("SELECT * FROM users WHERE id = %s", (user_id,))
+        )
+
+    def get_active_user_by_id(self, user_id: int) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM users WHERE id = %s AND deleted = FALSE AND status = 1",
+                (user_id,),
+            )
+        )
+
+    def get_user_by_username(self, username: str) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM users WHERE username = %s", (username,)
+            )
+        )
+
+    def get_user_by_email(self, email: str) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone("SELECT * FROM users WHERE email = %s", (email,))
+        )
+
+    def get_user_by_api_key(self, api_key: str) -> Optional[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT * FROM users WHERE api_key = %s AND deleted = FALSE AND status = 1",
+                (api_key,),
+            )
+        )
+
+    def get_user_role_and_admin_status(self, user_id: int) -> Optional[Dict[str, Any]]:
+        """Return the minimal auth triple ``{id, role_id, is_admin}`` for checks.
+
+        Used by :class:`hermes.crm.permission.Permission` so the
+        hot-path permission check doesn't drag the full user row across.
+        """
+        return self._run(
+            lambda db: db.fetchone(
+                "SELECT id, role_id, is_admin FROM users "
+                "WHERE id = %s AND deleted = FALSE AND status = 1",
+                (user_id,),
+            )
+        )
+
+    def get_all_users(self) -> List[Dict[str, Any]]:
+        return self._run(lambda db: db.fetchall("SELECT * FROM users"))
+
+    def get_active_users(self) -> List[Dict[str, Any]]:
+        return self._run(
+            lambda db: db.fetchall(
+                "SELECT * FROM users WHERE status = 1 AND deleted = FALSE"
+            )
+        )
+
+    def username_exists(
+        self, username: str, exclude_id: Optional[int] = None
+    ) -> bool:
+        def _q(db: DbWrapper) -> int:
+            if exclude_id is not None:
+                return db.fetchcolumn(
+                    "SELECT COUNT(*) FROM users WHERE username = %s AND id != %s",
+                    (username, exclude_id),
+                )
+            return db.fetchcolumn(
+                "SELECT COUNT(*) FROM users WHERE username = %s", (username,)
+            )
+
+        return (self._run(_q) or 0) > 0
+
+    def email_exists(
+        self, email: str, exclude_id: Optional[int] = None
+    ) -> bool:
+        if not email:
+            return False
+
+        def _q(db: DbWrapper) -> int:
+            if exclude_id is not None:
+                return db.fetchcolumn(
+                    "SELECT COUNT(*) FROM users WHERE email = %s AND id != %s",
+                    (email, exclude_id),
+                )
+            return db.fetchcolumn(
+                "SELECT COUNT(*) FROM users WHERE email = %s", (email,)
+            )
+
+        return (self._run(_q) or 0) > 0
+
+    def get_users_list(
+        self,
+        page: int = 1,
+        limit: int = 10,
+        search: str = "",
+        department_ids: Optional[List[int]] = None,
+    ) -> Dict[str, Any]:
+        """Paginated listing — kacrm parity (sans tenant-specific where clauses)."""
+        department_ids = department_ids or []
+        offset = (page - 1) * limit
+        where = ["u.deleted = FALSE"]
+        params: List[Any] = []
+        if search:
+            where.append(
+                "(u.username ILIKE %s OR u.realname ILIKE %s "
+                "OR u.mobile ILIKE %s OR u.email ILIKE %s)"
+            )
+            term = f"%{search}%"
+            params.extend([term, term, term, term])
+        if department_ids:
+            placeholders = ",".join(["%s"] * len(department_ids))
+            where.append(f"u.department_id IN ({placeholders})")
+            params.extend(department_ids)
+        where_clause = " AND ".join(where)
+
+        def _q(db: DbWrapper) -> Dict[str, Any]:
+            total = db.fetchcolumn(
+                f"SELECT COUNT(*) FROM users u "
+                f"LEFT JOIN departments d ON u.department_id = d.id "
+                f"LEFT JOIN roles r ON u.role_id = r.id "
+                f"WHERE {where_clause}",
+                tuple(params) if params else None,
+            )
+            rows = db.fetchall(
+                f"SELECT u.*, d.name AS department_name, r.name AS role_name "
+                f"FROM users u "
+                f"LEFT JOIN departments d ON u.department_id = d.id "
+                f"LEFT JOIN roles r ON u.role_id = r.id "
+                f"WHERE {where_clause} "
+                f"ORDER BY u.id DESC "
+                f"LIMIT %s OFFSET %s",
+                tuple(params) + (limit, offset),
+            )
+            return {"total": int(total or 0), "users": rows}
+
+        return self._run(_q)
+
+    # ------------------------------------------------------------------
+    # Writes
+    # ------------------------------------------------------------------
+
+    def insert(self, data: Dict[str, Any]) -> int:
+        """Insert and return the new user id."""
+        # Whitelist to avoid accidental column injection.
+        allowed = {
+            "username", "password", "realname", "email", "mobile",
+            "department_id", "role_id", "report_to_ids",
+            "status", "is_admin", "avatar", "description",
+            "api_key", "plan",
+        }
+        payload = {k: v for k, v in data.items() if k in allowed and v is not None}
+        payload.setdefault("status", 1)
+        payload.setdefault("is_admin", False)
+
+        def _q(db: DbWrapper) -> int:
+            db.insert("users", payload)
+            return db.id() or 0
+
+        return self._run(_q)
+
+    def soft_delete(self, user_id: int) -> bool:
+        def _q(db: DbWrapper) -> bool:
+            db.execute(
+                "UPDATE users SET deleted = TRUE WHERE id = %s", (user_id,)
+            )
+            return True
+
+        return self._run(_q)
+
+    def update_status(self, user_id: int, status: int) -> bool:
+        def _q(db: DbWrapper) -> bool:
+            db.execute(
+                "UPDATE users SET status = %s WHERE id = %s", (status, user_id)
+            )
+            return True
+
+        return self._run(_q)
+
+    # ------------------------------------------------------------------
+    # Password helpers (bcrypt, kacrm-compatible)
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def hash_password(plain: str) -> str:
+        import bcrypt
+
+        return bcrypt.hashpw(plain.encode("utf-8"), bcrypt.gensalt()).decode("utf-8")
+
+    def verify_password(self, user_id: int, plain_password: str) -> bool:
+        row = self._run(
+            lambda db: db.fetchone(
+                "SELECT password FROM users WHERE id = %s", (user_id,)
+            )
+        )
+        if not row or not plain_password:
+            return False
+        stored = (row.get("password") or "").strip()
+        if not stored:
+            return False
+        try:
+            import bcrypt
+
+            raw = stored.encode("utf-8")
+            # kacrm's dump stores ``$2y$`` hashes (PHP); the ``$2b$`` prefix is
+            # the canonical bcrypt form Python accepts.
+            if raw.startswith(b"$2y$"):
+                raw = b"$2b$" + raw[4:]
+            return bcrypt.checkpw(plain_password.encode("utf-8")[:72], raw)
+        except Exception:
+            return False
+
+    def update_password(self, user_id: int, new_password_hash: str) -> bool:
+        if not new_password_hash:
+            return False
+
+        def _q(db: DbWrapper) -> bool:
+            db.execute(
+                "UPDATE users SET password = %s WHERE id = %s",
+                (new_password_hash.strip(), user_id),
+            )
+            return True
+
+        return self._run(_q)
diff --git a/crm/module_product_fields.py b/crm/module_product_fields.py
new file mode 100644
index 0000000000..bb971d63cf
--- /dev/null
+++ b/crm/module_product_fields.py
@@ -0,0 +1,80 @@
+"""Product-fields helpers — verbatim port of kacrm's
+``app/includes/module_product_fields.py``.
+
+Parses ``collections.product_fields`` (a JSON array of column specs) and the
+``module_views.list_show_products`` switch. Modules without products
+(``has_products = 0`` — Phase 1 accounts/contacts/leads) never pass data into
+these helpers, so the parsers default to empty results and everything else
+short-circuits upstream.
+
+The ``_VIRTUAL_STOCK_QTY_BY_TABLE`` map is kacrm's way of surfacing
+``stockout_quantity`` / ``stockin_quantity`` as list-pickable product columns
+even when the tenant hasn't declared them in ``product_fields``. The value
+itself is computed from ``stock_details`` at request time — see
+``ListQuery._fetch_stockout_qty_agg_by_parent``.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any, Literal
+
+
+_VIRTUAL_STOCK_QTY_BY_TABLE: dict[str, tuple[str, ...]] = {
+    "salesorders": ("stockout_quantity",),
+    "purchasesorders": ("stockin_quantity",),
+}
+
+
+def virtual_stock_qty_field_stubs(table_name: str | None) -> list[dict[str, Any]]:
+    """Stub field specs a parent module can mount as product-agg columns."""
+    names = _VIRTUAL_STOCK_QTY_BY_TABLE.get((table_name or "").strip(), ())
+    return [
+        {"field_name": n, "field_type": "number", "is_visible": True}
+        for n in names
+    ]
+
+
+ListProductColumnsMode = Literal["none", "all"]
+
+
+def parse_view_list_product_columns(
+    raw: Any,
+) -> tuple[ListProductColumnsMode, list[dict[str, Any]]]:
+    """Parse the ``module_views.list_show_products`` switch.
+
+    * truthy (1/true/on/all) → ``("all", [])`` — show every product column
+    * falsy / null           → ``("none", [])`` — hide product columns
+    """
+    if raw is None:
+        return "none", []
+    if isinstance(raw, (bytes, bytearray, memoryview)):
+        try:
+            raw = bytes(raw).decode("utf-8")
+        except (TypeError, ValueError, UnicodeDecodeError):
+            return "none", []
+    if isinstance(raw, bool):
+        return ("all", []) if raw else ("none", [])
+    if isinstance(raw, (int, float)):
+        return ("all", []) if int(raw) == 1 else ("none", [])
+    s = str(raw).strip().lower()
+    if s in ("1", "true", "yes", "on", "all"):
+        return "all", []
+    return "none", []
+
+
+def parse_module_product_fields(module: dict[str, Any] | None) -> list[dict[str, Any]]:
+    """Parse ``collections.product_fields`` (JSON array of column specs).
+
+    Phase-1 modules have no ``product_fields`` column, so this returns ``[]``
+    and the product-aggregate code path stays dormant.
+    """
+    if not module or not module.get("product_fields"):
+        return []
+    raw = module["product_fields"]
+    try:
+        parsed = json.loads(raw) if isinstance(raw, str) else raw
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return []
+    if not isinstance(parsed, list):
+        return []
+    return [dict(x) for x in parsed if isinstance(x, dict)]
diff --git a/crm/permission.py b/crm/permission.py
new file mode 100644
index 0000000000..ac1821a423
--- /dev/null
+++ b/crm/permission.py
@@ -0,0 +1,156 @@
+"""Module + record permission checker.
+
+Ported from kacrm's ``app/includes/permission.py``. Semantics preserved verbatim:
+
+  * Admins (``users.is_admin = TRUE``) always pass.
+  * Otherwise the user's ``role_id`` is checked against ``role_permissions``
+    (``has_permission = TRUE``).
+  * For ``view`` / ``index`` / ``update`` there are "global*" escape-hatches
+    (``globalview``, ``globalupdate``) that override record-level ownership.
+  * ``massupdate`` / ``massdelete`` require BOTH the mass verb AND the
+    corresponding single-row verb.
+
+Records:
+  * Pass the module check first.
+  * Admin OR ``globalupdate`` → allow.
+  * Else allow if user is owner_by OR created_by.
+
+One behavior difference from kacrm: kacrm compared ``is_admin == 1`` against an
+integer. We compare against the PG ``BOOLEAN`` — psycopg3 returns Python bools
+from that column so the truthiness test is equivalent.
+
+Intended call site: FastAPI routes take a user_id + module_id + action and
+short-circuit on ``False``. See :func:`hermes.crm.routes.require_permission`
+for the dependency form.
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+from hermes.crm.db import DbWrapper
+from hermes.crm.models.permissions_db import PermissionsDb
+from hermes.crm.models.users_db import UsersDb
+
+
+class Permission:
+    """Run-time access check.
+
+    Either pass in a :class:`DbWrapper` (FastAPI request scope) or let the
+    helpers open short-lived connections via their models' ``None`` default.
+    """
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+        self.permissions_db = PermissionsDb(db)
+        self.users_db = UsersDb(db)
+
+    # ---- module-level --------------------------------------------------
+
+    def check_module_permission(
+        self, user_id: int, module_id: int, action: str
+    ) -> bool:
+        user = self.users_db.get_user_role_and_admin_status(user_id)
+        if not user:
+            return False
+        if user.get("is_admin"):
+            return True
+        role_id = user.get("role_id")
+        if not role_id:
+            return False
+
+        perm_id = self.permissions_db.get_permission_id_by_code(action)
+        if not perm_id:
+            # Unknown action → fall through to kacrm's derived-permission
+            # shortcuts (view/update/mass*).
+            if action in ("view", "index", "detail"):
+                # "detail" is the route-level synonym for "view" — viewing
+                # one record is just a single-row case of the index right.
+                # Without this, /crm/records/{module}/{id} 403s for any
+                # role that has view+index but no explicit "detail" row
+                # in role_permissions (which is the default seeded shape).
+                return self._has_view_or_index(role_id, module_id)
+            if action == "update":
+                return self._has_update(role_id, module_id)
+            if action == "massupdate":
+                return self._has_massupdate(role_id, module_id)
+            if action == "massdelete":
+                return self._has_massdelete(role_id, module_id)
+            return False
+        return self.permissions_db.has_permission(role_id, module_id, perm_id)
+
+    def _has_view_or_index(self, role_id: int, module_id: int) -> bool:
+        for code in ("globalview", "view", "index"):
+            pid = self.permissions_db.get_permission_id_by_code(code)
+            if pid and self.permissions_db.has_permission(role_id, module_id, pid):
+                return True
+        return False
+
+    def _has_update(self, role_id: int, module_id: int) -> bool:
+        for code in ("globalupdate", "update"):
+            pid = self.permissions_db.get_permission_id_by_code(code)
+            if pid and self.permissions_db.has_permission(role_id, module_id, pid):
+                return True
+        return False
+
+    def _has_massupdate(self, role_id: int, module_id: int) -> bool:
+        pid_mass = self.permissions_db.get_permission_id_by_code("massupdate")
+        if not pid_mass or not self.permissions_db.has_permission(
+            role_id, module_id, pid_mass
+        ):
+            return False
+        return self._has_update(role_id, module_id)
+
+    def _has_massdelete(self, role_id: int, module_id: int) -> bool:
+        pid_mass = self.permissions_db.get_permission_id_by_code("massdelete")
+        pid_del = self.permissions_db.get_permission_id_by_code("delete")
+        return bool(
+            pid_mass
+            and pid_del
+            and self.permissions_db.has_permission(role_id, module_id, pid_mass)
+            and self.permissions_db.has_permission(role_id, module_id, pid_del)
+        )
+
+    # ---- record-level --------------------------------------------------
+
+    def check_record_permission(
+        self,
+        module_id: int,
+        user_id: int,
+        record_id: int,  # kept for signature parity with kacrm
+        owner_by: Optional[int],
+        created_by: Optional[int],
+        action: str = "view",
+    ) -> bool:
+        user = self.users_db.get_user_role_and_admin_status(user_id)
+        if user and user.get("is_admin"):
+            return True
+        if not self.check_module_permission(user_id, module_id, action):
+            return False
+        if action == "update" and self.check_module_permission(
+            user_id, module_id, "globalupdate"
+        ):
+            return True
+        if user_id == owner_by or user_id == created_by:
+            return True
+        return False
+
+    # ---- by-name convenience ------------------------------------------
+
+    def check_permission_by_module_name(
+        self, user_id: int, module_name: str, action: str = "view"
+    ) -> bool:
+        """Lookup the module id by collection name, then check module perm."""
+        if self._db is None:
+            from hermes.crm.db import db_session
+
+            with db_session() as db:
+                row = db.fetchone(
+                    "SELECT id FROM collections WHERE name = %s", (module_name,)
+                )
+        else:
+            row = self._db.fetchone(
+                "SELECT id FROM collections WHERE name = %s", (module_name,)
+            )
+        if not row:
+            return False
+        return self.check_module_permission(user_id, int(row["id"]), action)
diff --git a/crm/picklist.py b/crm/picklist.py
new file mode 100644
index 0000000000..71b4df406b
--- /dev/null
+++ b/crm/picklist.py
@@ -0,0 +1,101 @@
+"""Picklist option helpers — pure functions, no DB.
+
+The canonical storage is ``module_fields.options`` as a comma-separated
+string (kacrm inheritance). We parse / normalize / dedup at the edges
+and keep the CSV contract so the rest of the codebase (Save.validate,
+edit_query renderers) stays untouched.
+
+Keep this module stateless and side-effect-free so the dedup / cap /
+normalization rules are testable without Postgres.
+"""
+from __future__ import annotations
+
+from typing import List, Tuple
+
+# Hard caps — see docs/2026-04-20-schema-evolution-adr.md §Safety rails.
+MAX_OPTION_LENGTH = 64
+MAX_OPTIONS_PER_FIELD = 50
+
+# Select-like field types whose value comes from the options CSV.
+# Canonical is picklist/multiselect (alembic 0107 + field_provisioning
+# FIELD_TYPE_ALIASES); the legacy names must keep matching because
+# payloads from un-migrated tenants still carry them. Consumers MUST
+# use is_select_like() instead of hand-rolling tuples — the 0107
+# rename silently killed every hard-coded ("select", "multiSelect")
+# check in list/detail localization.
+SELECT_LIKE_FIELD_TYPES = frozenset(
+    {"picklist", "select", "enum", "option", "radio",
+     "multiselect", "multipicklist"}
+)
+
+
+def is_select_like(field_type: str | None) -> bool:
+    """True when the field's value is constrained to its options list."""
+    return (field_type or "").strip().lower() in SELECT_LIKE_FIELD_TYPES
+
+
+class PicklistError(ValueError):
+    """Validation failure on option mutation — safe to surface verbatim."""
+
+
+def parse_options(raw: str | None) -> List[str]:
+    """Split the ``module_fields.options`` CSV into a list.
+
+    Trims each entry; drops empties. Preserves order — the CSV is what
+    renders in the UI dropdown, so position is meaningful.
+    """
+    if not raw:
+        return []
+    return [p.strip() for p in str(raw).split(",") if p.strip()]
+
+
+def join_options(opts: List[str]) -> str:
+    """Inverse of :func:`parse_options`. Emits the canonical CSV form."""
+    return ",".join(opts)
+
+
+def normalize_value(value: str) -> str:
+    """Canonical form used for dedup / validation. Trims whitespace only.
+
+    Case is preserved in the stored form (``"SaaS"`` is not ``"saas"``),
+    but dedup is case-insensitive — see :func:`append_option`.
+    """
+    return str(value).strip()
+
+
+def append_option(
+    existing: List[str], value: str
+) -> Tuple[List[str], str]:
+    """Return ``(new_list, status)`` after appending ``value``.
+
+    ``status`` is one of:
+      * ``"added"``      — a new option landed
+      * ``"duplicate"``  — case-insensitive match already present; no-op
+      * raises ``PicklistError`` for validation failures
+
+    Never mutates ``existing``. Dedup is case-insensitive; the stored
+    casing stays whatever was there first.
+    """
+    norm = normalize_value(value)
+    if not norm:
+        raise PicklistError("option value is empty")
+    if len(norm) > MAX_OPTION_LENGTH:
+        raise PicklistError(
+            f"option value exceeds {MAX_OPTION_LENGTH} chars"
+        )
+    if "," in norm:
+        # CSV is the wire format; a comma inside a value would silently
+        # split on read. Reject at write time.
+        raise PicklistError("option value must not contain ','")
+
+    lower = norm.lower()
+    for v in existing:
+        if v.lower() == lower:
+            return list(existing), "duplicate"
+
+    if len(existing) >= MAX_OPTIONS_PER_FIELD:
+        raise PicklistError(
+            f"field already has {MAX_OPTIONS_PER_FIELD} options (hard cap)"
+        )
+
+    return [*existing, norm], "added"
