# Deny by default. Build through scripts/build-kacrm-image.py for a clean,
# tracked-file-only context (including a pristine Hermes export).
**
!Dockerfile
!.dockerignore
!pyproject.toml
!LICENSE
!LICENSING.md
!alembic.ini
!hermes_prefork.py
!hermes_cloud/
!hermes_cloud/**
!hermes/
!hermes/**
!hermes-patches/
!hermes-patches/*.patch
!frontend/
!frontend/**
!alembic/
!alembic/**
!deploy/
!deploy/container/
!deploy/container/**
# Defense in depth, including secrets in otherwise allowed directories.
**/.git
**/.git/**
**/.env
**/.env.*
**/.npmrc
**/*credentials*.json
**/auth.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.dump
**/__pycache__
**/*.pyc
**/.venv
**/node_modules
**/dist
**/logs
**/.DS_Store
hermes/tests
hermes/website
hermes/apps
hermes/evals
hermes/contributors
hermes/optional-skills
hermes/.github
hermes/.claude
hermes/.codex
