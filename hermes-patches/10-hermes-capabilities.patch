+def _create_module_tool() -> "ToolSpec":
+    """Agent 直接建顶层自定义模块(北极星:用户讲业务→Agent 当场把系统长成那样)。
+
+    有意偏离字段的 propose-only(charter v2 §定律5):新 spec
+    (2026-06-14 对话即定制)在「建模块」这点上让 Agent 直接建,
+    透明(返回所建内容,Agent 须向用户复述)+ changelog 可审计。
+    策展判断(查重/复用 vs 新建/命名/建前追问)由 schema-evolution skill 教。
+    """
+    return ToolSpec(
+        name="crm_create_module",
+        description=(
+            "Create a brand-new top-level CRM module (a new business object "
+            "/ entity), e.g. expenses(费用), projects(项目), contracts(合同). "
+            "Builds the physical table + system fields + default permissions "
+            "atomically; the module appears in the CRM menu immediately. "
+            "BEFORE calling: (1) call crm_list_modules and check no existing "
+            "module already fits — prefer crm_propose_new_field to extend an "
