index 0000000000..2ea6e3bf1b
--- /dev/null
+++ b/crm/functions.py
@@ -0,0 +1,198 @@
+"""Narrow port of kacrm's ``app/includes/functions.py``.
+
+kacrm's ``functions.py`` is an 800-line grab-bag of helpers for caching,
+settings, currency, permissions, and display. ``list_query`` only needs three
+of them — ``ec_number_format``, ``get_currency_data``, ``json_serializable`` —
+so we port exactly those, backed by our PG schema (``currency_config`` /
+``exchange_rates``) instead of kacrm's ``CurrencyDb`` facade.
+
+The rest of kacrm's ``functions.py`` will be ported on-demand as other
+subsystems (edit, detail, save) land.
+"""
+from __future__ import annotations
+
+from datetime import date, datetime
+from decimal import Decimal
+from typing import Any, Dict, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+
+# ---------------------------------------------------------------------------
+# json_serializable — turn DB rows into JSON-safe Python types.
+# ---------------------------------------------------------------------------
+
+
+def json_serializable(obj: Any) -> Any:
+    """Recursively coerce ``date`` / ``datetime`` / ``Decimal`` / ``bytes``
+    into JSON-safe types. Verbatim port from kacrm.
+    """
+    if obj is None:
+        return None
+    if isinstance(obj, datetime):
+        return obj.strftime("%Y-%m-%d %H:%M:%S")
+    if isinstance(obj, date):
+        return obj.strftime("%Y-%m-%d")
+    if isinstance(obj, Decimal):
+        return float(obj)
+    if isinstance(obj, bytes):
+        return obj.decode("utf-8", errors="replace")
+    if isinstance(obj, dict):
+        return {k: json_serializable(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [json_serializable(v) for v in obj]
+    return obj
+
+
+# ---------------------------------------------------------------------------
+# ec_number_format — kacrm's settings-driven number formatter.
+# In hermes we don't yet have a ``settings`` table; default to 0 decimal
+# digits which matches kacrm's default when the setting is absent.
+# ---------------------------------------------------------------------------
+
+
+_DEFAULT_NUMBER_DIGITS = 0
+
+
+def _add_thousands_sep(n: int, sep: str) -> str:
+    s = str(abs(n))
+    result = []
+    for i, c in enumerate(reversed(s)):
+        if i and i % 3 == 0:
+            result.append(sep)
+        result.append(c)
+    out = "".join(reversed(result))
+    return "-" + out if n < 0 else out
+
+
+def ec_number_format(number: Any, is_edit: bool = False) -> str:
+    """Format *number* with thousands separator (PHP ``number_format`` flavour).
+
+    ``is_edit=True`` drops the grouping separator — used when echoing a number
+    back into an ``<input>`` for editing.
+    """
+    default_digits = _DEFAULT_NUMBER_DIGITS
+    grouping_sep = "" if is_edit else ","
+    try:
+        n = float(str(number).strip())
+    except (TypeError, ValueError):
+        n = 0.0
+    s = f"{n:.{default_digits}f}"
+    if grouping_sep and "." in s:
+        a, b = s.split(".", 1)
+        if len(a.lstrip("-")) > 3:
+            a = _add_thousands_sep(int(a), grouping_sep)
+        s = a + "." + b
+    elif grouping_sep and len(s.lstrip("-")) > 3:
+        try:
+            s = _add_thousands_sep(int(s), grouping_sep)
+        except ValueError:
+            pass
+    return s
+
+
+# ---------------------------------------------------------------------------
+# get_currency_data — pull from currency_config / exchange_rates.
+# ---------------------------------------------------------------------------
+
+
+def _fetch_currency_data(db: DbWrapper) -> Dict[str, Any]:
+    default_currency = "USD"
+    currency_options: Dict[str, Dict[str, str]] = {}
+    exchange_rates: Dict[str, float] = {}
+    try:
+        default_row = db.fetchone(
+            "SELECT currency_code, currency_name, currency_symbol "
+            "FROM currency_config WHERE is_default = TRUE LIMIT 1"
+        )
+        if default_row and default_row.get("currency_code"):
+            default_currency = default_row["currency_code"]
+        rows = db.fetchall(
+            "SELECT currency_code, currency_name, currency_symbol "
+            "FROM currency_config WHERE is_active = TRUE "
+            "ORDER BY sort_order ASC, id ASC"
+        )
+        for r in rows or []:
+            code = r.get("currency_code") or r.get("currency_name") or ""
+            if not code:
+                continue
+            currency_options[code] = {
+                "code": code,
+                "name": r.get("currency_name") or code,
+                "symbol": r.get("currency_symbol") or "",
+            }
+        rate_rows = db.fetchall(
+            "SELECT currency_code, rate_to_default "
+            "FROM exchange_rates WHERE is_active = TRUE"
+        )
+        for r in rate_rows or []:
+            code = r.get("currency_code") or ""
+            if not code:
+                continue
+            try:
+                exchange_rates[code] = float(r.get("rate_to_default") or 1)
+            except (TypeError, ValueError):
+                exchange_rates[code] = 1.0
+    except Exception:
+        pass
+    # Kacrm fallback mirror — keeps the UI happy when the tenant hasn't
+    # seeded its own currency list yet.
+    if not currency_options:
+        currency_options = {
+            "USD": {"code": "USD", "symbol": "$", "name": "US Dollar"},
+            "CNY": {"code": "CNY", "symbol": "¥", "name": "Chinese Yuan"},
+            "EUR": {"code": "EUR", "symbol": "€", "name": "Euro"},
+        }
+    return {
+        "default_currency": default_currency,
+        "currencies": currency_options,
+        "exchange_rates": exchange_rates,
+    }
+
+
+def get_currency_data(db: Optional[DbWrapper] = None) -> Dict[str, Any]:
+    """Return ``{default_currency, currencies, exchange_rates}`` as kacrm's
+    ``get_currency_data`` does. Pulls from ``currency_config`` /
+    ``exchange_rates`` seeded by migration 0005.
+    """
+    if db is not None:
+        return _fetch_currency_data(db)
+    with db_session() as _db:
+        return _fetch_currency_data(_db)
+
+
+# ---------------------------------------------------------------------------
+# get_module_id_by_table_name — verbatim helper used by ItemDelete /
+# SaveBase when they need to look up the module_id from the physical table
+# name (e.g. ``accounts`` → id 1).
+# ---------------------------------------------------------------------------
+
+
+def get_module_id_by_table_name(
+    table_name: str, db: Optional[DbWrapper] = None
+) -> Optional[int]:
+    """Resolve ``collections.id`` from ``collections.name`` (``.name`` is the
+    physical table name in hermes — accounts/contacts/leads/...).
+
+    Returns ``None`` if the table has no matching module row. Matches
+    kacrm's helper signature so ported call-sites drop in unchanged.
+    """
+    if not table_name:
+        return None
+    # Late import avoids a cycle through ``models/modules_db.py`` which
+    # imports from ``crm.db``.
+    from hermes.crm.models.modules_db import ModulesDb
+
+    def _q(d: DbWrapper) -> Optional[int]:
+        row = ModulesDb(d).get_module_by_table_name(table_name)
+        if not row:
+            return None
+        try:
+            return int(row.get("id")) if row.get("id") is not None else None
+        except (TypeError, ValueError):
+            return None
+
+    if db is not None:
+        return _q(db)
+    with db_session() as _db:
+        return _q(_db)
