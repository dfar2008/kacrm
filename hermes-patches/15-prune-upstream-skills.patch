-  // Upload to server, process, etc.
-  let url = URL.createObjectURL(blob);
-  console.log('Blob URL:', url);
-}, 'image/png');
-
-// Canvas to Data URL (for inline embedding)
-let dataUrl = document.querySelector('canvas').toDataURL('image/png');
