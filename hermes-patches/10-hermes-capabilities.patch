+def build_crm_tools(db: Optional[DbWrapper] = None) -> List[ToolSpec]:
+    """Build the unified CRM tool catalogue.
+
+    Instead of 4 tools per module (search/get/create/update × N modules),
+    emits 3 unified tools (crm_search, crm_get, crm_write) plus metadata
+    and agent tools.  Field schemas are loaded on demand via
+    ``crm_get_schema`` — this keeps the tool prompt compact and speeds up
+    LLM decision-making.
+
+    Typical output: 7 tools instead of 44+.
+    """
+    def _collect_modules(db: DbWrapper) -> tuple[List[str], Dict[str, Dict[str, List[str]]]]:
+        modules = ModulesDb(db).get_all_modules()
+        mfields = ModuleFieldsDb(db)
+        names: List[str] = []
+        hints: Dict[str, Dict[str, List[str]]] = {}
+        for mod in modules:
+            name = mod.get("name")
+            if not name:
+                continue
+            # 子明细(parent_module_id 非 NULL)随父记录读写,不出独立 crm 工具。
+            if mod.get("parent_module_id"):
+                continue
+            # Agent-facing catalogue: the agent may write ANY declared
+            # field (``readonly`` only restricts the SPA manual form),
+            # so advertise the full field set in crm_write's hints.
+            all_fields = mfields.get_module_fields(int(mod["id"]))
+            if not all_fields:
+                logger.info(
+                    "tool_binding_skip_collection name=%s reason=no_fields",
+                    name,
+                )
+                continue
+            names.append(name)
+            hints[name] = {
+                "required": [f["field_name"] for f in all_fields if f.get("is_required")],
+                "optional": [f["field_name"] for f in all_fields if not f.get("is_required")],
+            }
+        return names, hints
+
+    if db is not None:
+        module_names, field_hints = _collect_modules(db)
+    else:
+        with db_session() as owned:
+            module_names, field_hints = _collect_modules(owned)
+
+    # Charter v2 Phase 4b'.1.b follow-up (2026-05-06): only the 8 tools
+    # the main agent legitimately needs are exposed to the hermes tool
+    # registry. The 14 admin / approval-config / chain / writeback-rule
+    # tools were previously also bundled here, which let the agent see
+    # SPA-backend administrative surfaces it has no business invoking
+    # (e.g. ``crm_set_approval_chain``). Their dispatch handlers live
+    # below in this module and are still reachable by:
+    #   - the SPA HTTP routes in hermes_cloud/app/crm/routes/__init__.py
+    #   - approval-card actions on Feishu / WeCom (gateway approval flow)
+    # — but agent prompts no longer mention them.
+    tools: List[ToolSpec] = [
+        _unified_search_tool(module_names),
+        _unified_get_tool(module_names),
+        _unified_write_tool(module_names, field_hints),
+        _task_create_tool(),
+        _coach_proposal_submit_tool(),
+        _convert_lead_tool(),
+        _draft_feedback_collect_tool(),
+        _list_modules_tool(),
+        _get_schema_tool(),
+        _semantic_search_tool(),
+        _memory_write_tool(),
+        # Consolidated structural dispatchers (2026-06-19): 14 building/
+        # automation/analytics tools → 3, to shrink the per-call tool prompt
+        # (~5.8k → ~1.5k tokens). The underlying _dispatch_* handlers (and
+        # their RBAC) are unchanged; dispatch() rewrites the dispatcher call
+        # to the legacy tool_name by `action`. Detailed HOW lives in the
+        # schema-evolution skill.
+        _crm_schema_tool(module_names),
+        _crm_workflow_tool(module_names),
+        _crm_dashboard_tool(),
+        # Phase 4 patch 28 — gap-fill before SPA Copilot retirement.
+        # Replaces cloud's copilot/tools.py:add_note + list_related_records.
+        _note_create_tool(),
+        _list_related_tool(),
+        _crm_delete_tool(),
+        _submit_approval_tool(),
+        _pending_approval_chains_tool(),
+        _approve_chain_step_tool(),
+        _reject_chain_step_tool(),
+    ]
+    return tools
+
+
