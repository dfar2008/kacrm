-function fractalTree(x, y, len, angle, depth, branchAngle) {
-  if (depth <= 0 || len < 2) return;
-
-  let x2 = x + Math.cos(angle) * len;
-  let y2 = y + Math.sin(angle) * len;
-
-  strokeWeight(map(depth, 0, 10, 0.5, 4));
-  line(x, y, x2, y2);
