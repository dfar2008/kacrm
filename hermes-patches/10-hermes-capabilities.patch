@@ -0,0 +1,15 @@
+"""CRM Projections — charter 原语 ③.
+
+Read-time derived views. **No materialized columns, no triggers** —
+every projection is a pure SQL query against ``interactions`` (and
+related tables). This is deliberate: the first-principles charter's
+反转 1 ("字段是从事件流里推导出的投影") forbids storing derived
+state, so we can't drift out of sync with the event log.
+
+Call sites attach projections to a record dict right before the API
+serializes it, e.g. in :class:`DetailQuery.execute`.
+"""
+from hermes.crm.projections.contact_stats import (  # noqa: F401
+    contact_stats_for,
+    attach_contact_stats,
+)
diff --git a/crm/projections/contact_stats.py b/crm/projections/contact_stats.py
new file mode 100644
index 0000000000..be523ea09e
--- /dev/null
+++ b/crm/projections/contact_stats.py
@@ -0,0 +1,318 @@
+"""Contact-activity projection — replaces kacrm's ``notes`` side-effects.
+
+kacrm kept four fields on ``accounts`` (and similar on contacts /
+potentials) in sync with the ``notes`` table via an INSERT trigger:
+
+    latest_contact_date   = MAX(notes.contact_date)
+    latest_progress       = notes_name of the most-recent row
+    next_contact_date     = next_contact_date of the most-recent row
+    contact_count         = COUNT(*)
+
+Under the charter those four fields are **projections over the
+Interaction Log** — any touchpoint (email / call / IM / manual note /
+agent action) counts, not just rows that happened to be routed
+through the legacy ``notes`` table. One record, one truth.
+
+All four values come from a single SQL pass against ``interactions``.
+The GIN index on ``subjects`` (migration 0007) makes record-scoped
+containment queries fast enough for per-detail-view calculation.
+
+The shape this returns is intentionally compatible with what the old
+kacrm UI expected, so the ported frontend keeps reading the same keys.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any, Dict, Iterable, List, Optional
+
+from hermes.crm.db import DbWrapper, db_session
+
+logger = logging.getLogger(__name__)
+
+
+# Which interaction kinds count as "contact activity". Deliberately
+# broad — call / email / IM / note / meeting / voice-memo all count.
+# Pure-system events (workflow ticks, agent-internal thinking) do not.
+_CONTACT_KINDS = (
+    "email",
+    "call", "call_transcript",
+    "meeting", "meeting_notes",
+    "im_message",
+    "note", "contact_log",
+    "voice_memo",
+    "doc", "document",
+    "sms",
+)
+
+
+def _kinds_literal() -> str:
+    return "(" + ",".join(f"'{k}'" for k in _CONTACT_KINDS) + ")"
+
+
+def contact_stats_for(
+    module: str,
+    record_id: int,
+    *,
+    db: Optional[DbWrapper] = None,
+) -> Dict[str, Any]:
+    """Return the 4 kacrm-compatible contact-activity projections.
+
+    Keys: ``latest_contact_date`` (ISO string or ``None``),
+    ``latest_progress`` (str), ``next_contact_date`` (ISO or ``None``),
+    ``contact_count`` (int).
+
+    The function never raises for an unknown module — it just returns
+    zeros. Caller decides whether to swallow or surface.
+    """
+    subj_json = json.dumps([{"module": module, "id": int(record_id)}])
+
+    def _run(db: DbWrapper) -> Dict[str, Any]:
+        # Single pass: aggregate + latest-row lookup via window function.
+        row = db.fetchone(
+            f"""
+            WITH touched AS (
+                SELECT id, kind, occurred_at, content
+                FROM interactions
+                WHERE subjects @> %s::jsonb
+                  AND kind IN {_kinds_literal()}
+            ),
+            latest AS (
+                SELECT kind, occurred_at, content
+                FROM touched
+                ORDER BY occurred_at DESC
+                LIMIT 1
+            )
+            SELECT
+                (SELECT COUNT(*) FROM touched)                        AS contact_count,
+                (SELECT MAX(occurred_at) FROM touched)                AS latest_contact_date,
+                (SELECT content FROM latest)                          AS latest_content,
+                (SELECT kind FROM latest)                             AS latest_kind
+            """,
+            (subj_json,),
+        ) or {}
+        content = row.get("latest_content") or {}
+        if isinstance(content, str):
+            try:
+                content = json.loads(content)
+            except Exception:
+                content = {}
+
+        # latest_progress: prefer explicit "summary"/"subject"/"title",
+        # else a truncated body.
+        progress = ""
+        if isinstance(content, dict):
+            for key in ("summary", "subject", "title", "notes_name", "text", "body", "message"):
+                v = content.get(key)
+                if v:
+                    progress = str(v)[:200]
+                    break
+
+        next_dt: Optional[str] = None
+        if isinstance(content, dict):
+            v = content.get("next_contact_date") or content.get("next_action_date")
+            if v:
+                next_dt = str(v)
+
+        latest_dt = row.get("latest_contact_date")
+        return {
+            "latest_contact_date": latest_dt.isoformat() if latest_dt else None,
+            "latest_progress": progress,
+            "next_contact_date": next_dt,
+            "contact_count": int(row.get("contact_count") or 0),
+            "latest_kind": row.get("latest_kind"),
+        }
+
+    try:
+        if db is not None:
+            return _run(db)
+        with db_session() as owned:
+            return _run(owned)
+    except Exception:
+        logger.exception(
+            "contact_stats_failed module=%s record=%s", module, record_id,
+        )
+        return {
+            "latest_contact_date": None,
+            "latest_progress": "",
+            "next_contact_date": None,
+            "contact_count": 0,
+            "latest_kind": None,
+        }
+
+
+# Modules for which the projection is meaningful. Other modules get no
+# attachment (they don't have a "latest contact" concept).
+_PROJECTED_MODULES = frozenset({
+    "accounts", "contacts", "leads", "potentials", "opportunities",
+})
+
+
+def attach_contact_stats(
+    record: Dict[str, Any],
+    *,
+    module: str,
+    record_id: int,
+    db: Optional[DbWrapper] = None,
+) -> None:
+    """Mutate *record* in place, overlaying contact-activity fields.
+
+    Safe to call unconditionally — no-ops for non-projected modules
+    and for records that have no interactions yet (zeros are still
+    written so the frontend has a stable schema).
+
+    Existing keys on the record are **overwritten**. The projection is
+    the source of truth; any lingering column value from a pre-port
+    row is stale by definition.
+    """
+    if module not in _PROJECTED_MODULES:
+        return
+    stats = contact_stats_for(module, record_id, db=db)
+    for k, v in stats.items():
+        record[k] = v
+
+
+def contact_stats_batch(
+    module: str,
+    record_ids: List[int],
+    *,
+    db: Optional[DbWrapper] = None,
+) -> Dict[int, Dict[str, Any]]:
+    """Fetch contact_stats for many records in *one* SQL round-trip.
+
+    Used by list views to avoid N subqueries. Keys in the returned
+    dict are int record_ids present in *record_ids*; records with no
+    interactions map to the zeroed shape (same as the singular
+    helper).
+    """
+    if module not in _PROJECTED_MODULES or not record_ids:
+        return {}
+
+    subj_vals = [json.dumps([{"module": module, "id": int(rid)}]) for rid in record_ids]
+
+    def _run(db: DbWrapper) -> Dict[int, Dict[str, Any]]:
+        # One pass: unnest the subject JSON list, join to interactions,
+        # aggregate. DISTINCT ON picks the latest row per record_id.
+        rows = db.fetchall(
+            f"""
+            WITH want(subj) AS (
+                SELECT unnest(%s::jsonb[])
+            ),
+            touched AS (
+                SELECT
+                    w.subj,
+                    i.id, i.kind, i.occurred_at, i.content
+                FROM want w
+                JOIN interactions i ON i.subjects @> w.subj
+                WHERE i.kind IN {_kinds_literal()}
+            ),
+            latest AS (
+                SELECT DISTINCT ON (subj)
+                    subj, kind, occurred_at, content
+                FROM touched
+                ORDER BY subj, occurred_at DESC
+            ),
+            agg AS (
+                SELECT subj,
+                       COUNT(*) AS contact_count,
+                       MAX(occurred_at) AS latest_contact_date
+                FROM touched
+                GROUP BY subj
+            )
+            SELECT a.subj,
+                   a.contact_count, a.latest_contact_date,
+                   l.kind AS latest_kind,
+                   l.content AS latest_content
+            FROM agg a
+            LEFT JOIN latest l USING (subj)
+            """,
+            (subj_vals,),
+        ) or []
+
+        out: Dict[int, Dict[str, Any]] = {}
+        for row in rows:
+            subj = row.get("subj")
+            if isinstance(subj, str):
+                try: subj = json.loads(subj)
+                except Exception: subj = None
+            if not (isinstance(subj, list) and subj):
+                continue
+            rid = subj[0].get("id")
+            try: rid = int(rid)
+            except Exception: continue
+
+            content = row.get("latest_content") or {}
+            if isinstance(content, str):
+                try: content = json.loads(content)
+                except Exception: content = {}
+            progress = ""
+            if isinstance(content, dict):
+                for key in ("summary", "subject", "title", "notes_name", "text", "body", "message"):
+                    v = content.get(key)
+                    if v:
+                        progress = str(v)[:200]; break
+            next_dt: Optional[str] = None
+            if isinstance(content, dict):
+                v = content.get("next_contact_date") or content.get("next_action_date")
+                if v: next_dt = str(v)
+            latest_dt = row.get("latest_contact_date")
+            out[rid] = {
+                "latest_contact_date": latest_dt.isoformat() if latest_dt else None,
+                "latest_progress": progress,
+                "next_contact_date": next_dt,
+                "contact_count": int(row.get("contact_count") or 0),
+                "latest_kind": row.get("latest_kind"),
+            }
+        return out
+
+    try:
+        if db is not None:
+            return _run(db)
+        with db_session() as owned:
+            return _run(owned)
+    except Exception:
+        logger.exception("contact_stats_batch_failed module=%s n=%d",
+                         module, len(record_ids))
+        return {}
+
+
+def attach_contact_stats_batch(
+    records: List[Dict[str, Any]],
+    *,
+    module: str,
+    db: Optional[DbWrapper] = None,
+    id_key: str = "id",
+) -> None:
+    """Overlay contact_stats on each record in *records*, in place.
+
+    One SQL round-trip instead of N. Records without a matching
+    interaction get the zeroed shape so the frontend has a stable
+    schema for "最近联系 / 联系次数" columns.
+    """
+    if module not in _PROJECTED_MODULES or not records:
+        return
+    ids: List[int] = []
+    for r in records:
+        try: ids.append(int(r.get(id_key)))
+        except Exception: continue
+    if not ids:
+        return
+    stats = contact_stats_batch(module, ids, db=db)
+    zero = {
+        "latest_contact_date": None,
+        "latest_progress": "",
+        "next_contact_date": None,
+        "contact_count": 0,
+        "latest_kind": None,
+    }
+    for r in records:
+        try: rid = int(r.get(id_key))
+        except Exception: continue
+        for k, v in (stats.get(rid) or zero).items():
+            r[k] = v
+
+
+__all__ = [
+    "contact_stats_for", "contact_stats_batch",
+    "attach_contact_stats", "attach_contact_stats_batch",
+]
diff --git a/crm/save.py b/crm/save.py
new file mode 100644
index 0000000000..5a6e60a37c
--- /dev/null
+++ b/crm/save.py
@@ -0,0 +1,1114 @@
+"""Record create / update — Phase 1 slim port of kacrm's
+``app/includes/save.py`` + ``save_base.py``.
+
+kacrm's full Save stack is ~2000 lines spread across ``save.py`` (194),
+``save_base.py`` (1192), ``save_validator.py`` (749). It handles:
+
+  * metadata-driven INSERT / UPDATE on the main table
+  * file upload attachments
+  * approval chain resolution
+  * auto-number generation (``accountno`` etc.)
+  * product-line rollups + currency JSON
+  * formula field re-evaluation
+  * workflow execution + field writeback to parent records
+  * before/after hook registry
+
+For Phase 1 MVP the only path that ships is the core write: validate
+required fields, derive the department from owner, run the INSERT/UPDATE
+against the main table, and emit changelog rows for every changed field.
+Every other kacrm feature is gated behind Phase-2 metadata flags
+(``has_products``, ``has_approval``, workflow tables, etc.) that are off
+for our accounts/contacts/leads seed.
+
+When Phase 2 lands, the dormant branches should be ported verbatim from
+kacrm — they are intentionally NOT structurally included here to avoid
+broken dead-code.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional, Tuple
+
+from hermes.crm.db import DbWrapper, db_session
+from hermes.crm.models.module_fields_db import ModuleFieldsDb
+from hermes.crm.models.modules_db import ModulesDb
+from hermes.crm.permission import Permission
+from hermes.crm import memory_identity
+from hermes.crm import memory_compounding
+
+
+def _pop_line_items(data: Dict[str, Any]) -> Optional[list]:
+    """Pull a ``products`` array off the request payload so the parent
+    write path doesn't see it as an unknown column. Returns None when
+    the caller didn't supply products (signal: leave existing rows
+    alone). Returns ``[]`` when explicitly empty (clear all rows)."""
+    if "products" not in data:
+        return None
+    val = data.pop("products")
+    if val is None:
+        return []
+    if not isinstance(val, list):
+        # Tolerate dict-of-rows shape — kacrm's legacy form posts as
+        # ``products[0][...]``. We map to a plain list of dicts.
+        if isinstance(val, dict):
+            return [v for v in val.values() if isinstance(v, dict)]
+        return []
+    return val
+
+
+def _pop_subdetails(data: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    """从 payload 摘掉 ``details`` (generic 子明细),避免父写路径当未知列。
+    形如 {子明细名: [行dict]}。None=未提供(不动);{}=无。"""
+    if "details" not in data:
+        return None
+    val = data.pop("details")
+    return val if isinstance(val, dict) else {}
+
+
+def _to_int(v: Any, default: int) -> int:
+    try:
+        return int(float(v))
+    except (TypeError, ValueError):
+        return default
+
+
+def _to_float(v: Any, default: float) -> float:
+    if v is None:
+        return default
+    # All money columns are NUMERIC since alembic 0079; psycopg returns
+    # Decimal which float() handles. Leftover dict tolerance is a thin
+    # safety net for line-item input that came in as a JSON envelope
+    # (legacy frontend / external import) — drops away once those
+    # callers are sunset.
+    if isinstance(v, dict):
+        for k in ("amount", "value", "n", "original_amount", "CNY"):
+            if k in v:
+                return _to_float(v[k], default)
+        return default
+    try:
+        return float(v)
+    except (TypeError, ValueError):
+        return default
+
+
+def _money_round(n: float) -> float:
+    """Round money math to 4 decimal places before NUMERIC(18,2) trunc.
+    Replaces the old ``_json_scalar`` which JSON-encoded the value for
+    JSONB columns — those became NUMERIC in alembic 0079."""
+    return round(n, 4)
+
+
+def _denorm_product(db: DbWrapper, products_id: int) -> Dict[str, Any]:
+    """Pull denormalized columns (name / productno / model / spec) from
+    the products row so the line item table can store them without
+    forcing a JOIN at read time."""
+    try:
+        row = db.fetchone(
+            'SELECT products_name AS name, productno, model, specifications '
+            'FROM products WHERE products_id = %s',
+            (int(products_id),),
+        )
+        return dict(row) if row else {}
+    except Exception:
+        return {}
+
+
+class FieldValidationException(Exception):
+    """Raised when a required field is missing or has an invalid shape."""
+
+    def __init__(self, field_name: str, message: str) -> None:
+        super().__init__(f"{field_name}: {message}")
+        self.field_name = field_name
+        self.message = message
+
+
+_PG_INT_TYPES = {"integer", "bigint", "smallint"}
+_PG_NUM_TYPES = {"numeric", "decimal", "double precision", "real"}
+
+
+def _coerce_subdetail_value(value, pg_type: str, label: str, field_type: str):
+    """Coerce a sub-detail cell to its DB column type, or raise a clean 400.
+
+    Sub-detail cells arrive as strings (and an empty cell historically as '').
+    Binding '' or a non-numeric string (e.g. a typed name in a ``user`` FK
+    column) to an integer/numeric/date column makes psycopg raise
+    ``InvalidTextRepresentation`` → HTTP 500. We coerce ''/None → NULL and
+    validate integer/numeric columns up front so the caller (SPA *or* the agent,
+    which can write any field) gets a ``FieldValidationException`` → 400 with a
+    readable message instead of a 500.
+    """
+    if value is None or value == "":
+        return None
+    if pg_type in _PG_INT_TYPES:
+        try:
+            return int(value)
+        except (TypeError, ValueError):
+            ft = (field_type or "").lower()
+            msg = "请选择有效的用户" if ft in ("user", "ownerby") else f"{label} 必须是整数"
+            raise FieldValidationException(label, msg)
+    if pg_type in _PG_NUM_TYPES:
+        try:
+            return float(value)
+        except (TypeError, ValueError):
+            raise FieldValidationException(label, f"{label} 必须是数字")
+    # date / text / picklist / etc: '' already → NULL above; PG validates the rest.
+    return value
+
+
+class Save:
+    """Metadata-driven create / update for hermes record modules.
+
+    Usage::
+
+        s = Save(db).set_module(module_id).set_user(user_id)
+        new_id = s.insert(data)
+        # or
+        s.set_record_id(existing_id)
+        s.update(data)
+    """
+
+    def __init__(self, db: Optional[DbWrapper] = None) -> None:
+        self._db = db
+        self.module_id: int = 0
+        self.module: Optional[Dict[str, Any]] = None
+        self.table_name: str = ""
+        self.record_id: int = 0
+        self.user_id: int = 0
+        self.is_admin: bool = False
+        # ``source`` becomes the ``interactions.source`` column. Defaults to
+        # ``'manual'`` (human-driven write); the Phase 2 gateway will override
+        # with ``'agent:<profile>:<agent_name>'`` when Agents start writing.
+        self.source: str = "manual"
+        self._fields_cache: Optional[List[Dict[str, Any]]] = None
+        self._allow_via_collaborator: bool = False
+
+    def _ensure_db(self) -> DbWrapper:
+        if self._db is None:
+            ctx = db_session()
+            self._db = ctx.__enter__()
+        return self._db
+
+    # ---- setters --------------------------------------------------------
+
+    def set_module(self, module_id: int) -> "Save":
+        self.module_id = int(module_id)
+        db = self._ensure_db()
+        self.module = ModulesDb(db).get_module_info(self.module_id)
+        if not self.module:
+            raise ValueError("Module not found")
+        self.table_name = self.module.get("table_name") or self.module.get("name")
+        return self
+
+    def set_user(self, user_id: int, is_admin: bool = False) -> "Save":
+        self.user_id = int(user_id or 0)
+        self.is_admin = bool(is_admin)
+        return self
+
+    def set_record_id(self, record_id: int) -> "Save":
+        self.record_id = int(record_id or 0)
+        return self
+
+    def set_source(self, source: str) -> "Save":
+        """Override the provenance string written to ``interactions.source``.
+
+        Call sites that know they're Agent-driven pass
+        ``'agent:<profile>:<agent_name>'``; manual UI writes leave the
+        default.
+        """
+        self.source = str(source or "manual").strip() or "manual"
+        return self
+
+    def set_allow_via_collaborator(self, allow: bool) -> "Save":
+        """Cloud route can opt in: skip the record-level owner check.
+
+        Module-level perm check (``_check_permission``) still fires —
+        this only bypasses the owner_by/created_by row-level gate,
+        implementing the "can_edit collaborator + role.update" double-
+        达 semantics.  Default ``False`` keeps behaviour identical for
+        callers who don't set it.
+        """
+        self._allow_via_collaborator = bool(allow)
+        return self
+
+    # ---- metadata helpers ----------------------------------------------
+
+    def _editable_fields(self) -> List[Dict[str, Any]]:
+        """Fields this write path is allowed to set.
+
+        Agent / automation writes (``source`` starting with ``agent:``)
+        may set ANY declared field. ``is_readonly`` only locks a field in
+        the SPA's manual create / edit forms — it is NOT an agent
+        restriction; correcting bad data in any column is part of the
+        agent's job. Manual UI writes stay scoped to the SPA-editable set.
+        """
+        if self._fields_cache is None:
+            db = self._ensure_db()
+            mf = ModuleFieldsDb(db)
+            if self.source.startswith("agent:"):
+                self._fields_cache = mf.get_module_fields(self.module_id) or []
+            else:
+                self._fields_cache = mf.get_editable_fields(self.module_id) or []
+        return self._fields_cache
+
+    def _parse_options(self, raw: Any) -> List[str]:
+        """Parse a field's ``options`` metadata into a list of legal values.
+
+        Three on-disk shapes supported, in order of historical introduction:
+
+        1. Comma-separated string (kacrm classic): ``"a,b,c"``.
+        2. JSON-array of strings: ``'["a","b","c"]'``.
+        3. JSON-array of ``{value, text}`` dicts (Charter v2 i18n form):
+           ``'[{"value":"wechat","text":"微信"}]'``.
+
+        For shape 3 the legal values are the ``value`` keys; ``text`` keys
+        are display labels and don't need to match what the agent submits
+        (though :func:`option_matches_value` lets either match upstream of
+        this validator). Earlier versions of this helper stringified each
+        list item directly, which turned the dict into its Python ``repr``
+        and broke select-option validation against any field stored in
+        the JSON-of-dicts form.
+        """
+        if raw is None:
+            return []
+        if isinstance(raw, list):
+            vals = raw
+        elif isinstance(raw, str):
+            s = raw.strip()
+            if not s:
+                return []
+            if s.startswith("[") and s.endswith("]"):
+                import json as _json
+                try:
+                    vals = _json.loads(s)
+                except Exception:
+                    vals = s[1:-1].split(",")
+            else:
+                vals = s.split(",")
+        else:
+            return []
+        out: List[str] = []
+        for v in vals:
+            if isinstance(v, dict):
+                # value-only matters for the in-set check; text is the i18n
+                # display label and lives in the user-facing render path.
+                key = v.get("value") or v.get("text")
+                if key is None:
+                    continue
+                key_s = str(key).strip()
+                if key_s:
+                    out.append(key_s)
+            else:
+                key_s = str(v).strip()
+                if key_s:
+                    out.append(key_s)
+        return out
+
+    def _field_config(self, field: Dict[str, Any]) -> Dict[str, Any]:
+        """Return a field's ``field_config`` as a dict.
+
+        The column is JSON; psycopg returns a dict, but a raw row read or
+        a hand-edited row may carry a JSON string. Tolerate both and bad
+        JSON (→ empty dict)."""
+        raw = field.get("field_config")
+        if raw is None:
+            return {}
+        if isinstance(raw, dict):
+            return raw
+        if isinstance(raw, str):
+            import json as _json
+            try:
+                parsed = _json.loads(raw)
+                return parsed if isinstance(parsed, dict) else {}
+            except (ValueError, TypeError):
+                return {}
+        return {}
+
+    # Field types that must be one of the declared options (single-choice)
+    _SELECT_LIKE_SINGLE = frozenset({"select", "radio"})
+    # Field types where value is a delimited list, each part must be a legal option
+    _SELECT_LIKE_MULTI = frozenset({"checkbox", "multiselect"})
+
+    def _validate_select_options(self, data: Dict[str, Any]) -> None:
+        """Enforce that ``select``/``radio``/``checkbox`` values live inside
+        the field's declared ``options``. kacrm historically stored any
+        free-form string, so legacy rows may violate this; we only reject
+        **new writes** — existing dirty data is untouched until next edit.
+        """
+        for f in self._editable_fields():
+            ft = str(f.get("field_type") or "").strip().lower()
+            if ft not in self._SELECT_LIKE_SINGLE and ft not in self._SELECT_LIKE_MULTI:
+                continue
+            fn = str(f.get("field_name") or "").strip()
+            if not fn or fn not in data:
+                continue
+            v = data.get(fn)
+            if v is None or (isinstance(v, str) and v.strip() == ""):
+                continue  # empty allowed for non-required; required-check is separate
+            opts = self._parse_options(f.get("options"))
+            if not opts:
+                continue  # field has no declared options → skip (can't enforce)
+            label = f.get("field_label") or fn
+            # Charter v2: when the agent provides a non-conforming select
+            # value, surface the legal options AND direct it to use the
+            # ``clarify`` tool to ask the user — don't silently guess a
+            # mapping. ``__CLARIFY__`` prefix is the contract crm_write
+            # callers check; the legal options are serialised in the
+            # message body so the agent can pass them to clarify(choices=…).
+            if ft in self._SELECT_LIKE_SINGLE:
+                if str(v) not in opts:
+                    raise FieldValidationException(
+                        fn,
+                        f"__CLARIFY__ {label} 字段值 {v!r} 不在合法选项内。"
+                        f"合法选项：{opts}。"
+                        f"请用 clarify 工具问用户："
+                        f"question='请选择 {label}（原值 {v} 不合法）',"
+                        f" choices={opts[:4]} —— 拿到用户回复后再用合法值重试。",
+                    )
+            else:  # multi
+                parts = v if isinstance(v, list) else str(v).split(",")
+                for p in parts:
+                    ps = str(p).strip()
+                    if ps and ps not in opts:
+                        raise FieldValidationException(
+                            fn,
+                            f"__CLARIFY__ {label} 字段值 {ps!r} 不在合法选项内。"
+                            f"合法选项：{opts}。"
+                            f"请用 clarify 工具问用户："
+                            f"question='请选择 {label}（原值 {ps} 不合法）',"
+                            f" choices={opts[:4]} —— 拿到用户回复后再用合法值重试。",
+                        )
+
+    def _validate_required(self, data: Dict[str, Any]) -> None:
+        for f in self._editable_fields():
+            if not (f.get("required") or f.get("is_required")):
+                continue
+            fn = str(f.get("field_name") or "")
+            if not fn:
+                continue
+            v = data.get(fn)
+            if v is None or (isinstance(v, str) and v.strip() == ""):
+                raise FieldValidationException(
+                    fn, f"{f.get('field_label') or fn} is required"
+                )
+
+    def _check_permission(self, verb: str) -> None:
+        if self.is_admin:
+            return
+        db = self._ensure_db()
+        if not Permission(db).check_module_permission(
+            self.user_id, self.module_id, verb
+        ):
+            raise PermissionError(
+                f"No permission to {verb} records in this module"
+            )
+
+    def _derive_department(self, owner_by: Any) -> Optional[int]:
+        """kacrm copies ``users.department_id`` into the record when
+        ``owner_by`` changes. We do the same so reports that group by
+        department stay consistent."""
+        try:
+            uid = int(owner_by or 0)
+        except (TypeError, ValueError):
+            return None
+        if uid <= 0:
+            return None
+        db = self._ensure_db()
+        row = db.fetchone(
+            "SELECT department_id FROM users WHERE id = %s", (uid,)
+        )
+        if not row:
+            return None
+        did = row.get("department_id")
+        try:
+            return int(did) if did is not None else None
+        except (TypeError, ValueError):
+            return None
+
+    def _project_data_to_columns(
+        self, data: Dict[str, Any]
+    ) -> Dict[str, Any]:
+        """Keep only keys that are writable fields on this module —
+        prevents clients from setting arbitrary columns.
+
+        Charter v2: silently dropping unknown keys hides mistakes (a
+        renamed / dropped field gets back ``success`` but nothing
+        changed). Hard-reject, and distinguish the two failure modes so
+        the caller is not told a field "doesn't exist" when it plainly
+        does (which previously made the agent contradict itself):
+
+          * field not on the module at all → ``__CLARIFY__`` so the
+            agent asks the user / picks the closest field;
+          * field exists but is not writable on THIS path (a readonly
+            field reached via the SPA manual form — agents are
+            unrestricted) → a plain error.
+        """
+        writable_names = {
+            str(f.get("field_name") or "").strip()
+            for f in self._editable_fields()
+            if f.get("field_name")
+        }
+        unknown = [k for k in data.keys() if k not in writable_names]
+        if unknown:
+            sample_known = sorted(writable_names)[:25]
+            db = self._ensure_db()
+            all_names = {
+                str(f.get("field_name") or "").strip()
+                for f in ModuleFieldsDb(db).get_module_fields(self.module_id)
+                if f.get("field_name")
+            }
+            nonexistent = [k for k in unknown if k not in all_names]
+            if nonexistent:
+                raise FieldValidationException(
+                    nonexistent[0],
+                    f"__CLARIFY__ 模块 {self.table_name!r} 上不存在字段 "
+                    f"{nonexistent!r}。当前可写字段：{sample_known}。"
+                    f"请用 clarify 工具问用户 question='想改哪个字段？',"
+                    f" choices={sample_known[:4]} 或基于上下文选最贴近的字段重试。",
+                )
+            # Exists but not writable here — a readonly field reached
+            # through the SPA manual form (the agent path can write it).
+            raise FieldValidationException(
+                unknown[0],
+                f"字段 {unknown!r} 在模块 {self.table_name!r} 上是只读字段，"
+                f"不能通过 SPA 表单修改。当前可编辑字段：{sample_known}。",
+            )
+        return {k: v for k, v in data.items() if k in writable_names}
+
+    # ---- order/quote product-line guard --------------------------------
+
+    _PRODUCT_REQUIRED_MODULES = ("salesorders", "quotes")
+
+    def _guard_order_has_products(
+        self, line_items: Optional[list], *, is_update: bool
+    ) -> None:
+        """Enforce that a salesorder / quote always carries ≥1 product line.
+
+        ``final_amount`` is derived from the line items (see
+        :meth:`_save_line_items`), so an order with no products has no
+        meaningful amount and never participates in the
+        ``accounts.deal_amount / deal_count`` aggregation. We reject the
+        empty state at the write boundary rather than letting a shell
+        record land.
+
+        ``line_items`` semantics (from :func:`_pop_line_items`):
+          * ``None``  — caller didn't touch products (key absent)
+          * ``[]``    — caller explicitly cleared all rows
+          * ``[...]`` — caller supplied rows
+
+        On INSERT: products are mandatory, so ``None``/``[]`` both reject.
+        On UPDATE: ``None`` leaves existing rows alone (don't retroactively
+        block an unrelated field edit); only an explicit clear (``[]``)
+        rejects, since it would leave the order empty.
+        """
+        if self.table_name not in self._PRODUCT_REQUIRED_MODULES:
+            return
+        if is_update:
+            if line_items != []:
+                return
+        elif line_items:
+            return
+        raise FieldValidationException(
+            "products",
+            "销售订单/报价单必须至少包含一个产品行(products)。"
+            "金额由产品行自动汇总,不能创建或清空为没有产品的空单。",
+        )
+
+    # ---- tasks: mirror polymorphic related_* into typed FK ------------
+
+    _TASKS_TYPED_FK_BY_MODULE = {
+        "accounts": "accounts_id",
+        "contacts": "contacts_id",
+    }
+
+    def _mirror_tasks_typed_fk(self, data: Dict[str, Any]) -> None:
+        """When the agent creates a ``tasks`` row via the polymorphic
+        ``related_module`` / ``related_record_id`` pair, also fill the
+        typed ``accounts_id`` / ``contacts_id`` column.
+
+        Why: SPA's record-detail "关联任务" tab queries with
+        ``WHERE accounts_id = %s`` (typed FK + indexed). A task created
+        purely against ``related_record_id`` would not show up there,
+        and the user would think the agent silently failed even though
+        the row landed. Mirror at write time so both readers see it.
+
+        No-op if the caller already supplied the typed FK (don't
+        overwrite an explicit choice).
+        """
+        if self.table_name != "tasks":
+            return
+        mod = data.get("related_module")
+        rid = data.get("related_record_id")
+        if not mod or rid in (None, "", 0):
+            return
+        col = self._TASKS_TYPED_FK_BY_MODULE.get(str(mod))
+        if not col:
+            return
+        if data.get(col):
+            return
+        try:
+            data[col] = int(rid)
+        except (TypeError, ValueError):
+            return
+
+    # ---- main paths -----------------------------------------------------
+
+    def insert(self, data: Dict[str, Any]) -> int:
+        if not self.module:
+            raise ValueError("Module not set")
+        self._check_permission("create")
+        # Pop line items before validation/projection — they live in a
+        # sibling table ({module}_products), not on the parent row, so
+        # _project_data_to_columns would reject them as unknown columns.
+        line_items = _pop_line_items(data)
+        details = _pop_subdetails(data)
+        self._guard_order_has_products(line_items, is_update=False)
+        self._mirror_tasks_typed_fk(data)
+        self._validate_required(data)
+        self._validate_select_options(data)
+        db = self._ensure_db()
+        with db.transaction():
+            payload = self._project_data_to_columns(data)
+            owner_by = payload.get("owner_by") or self.user_id
+            payload["owner_by"] = owner_by
+            if "department_id" not in payload or not payload.get("department_id"):
+                dep = self._derive_department(owner_by)
+                if dep is not None:
+                    payload["department_id"] = dep
+            payload["created_by"] = self.user_id
+            payload["updated_by"] = self.user_id
+
+            # salesorders / quotes carry NOT NULL rollup columns
+            # (final_amount, total_with_tax, total_quantity) that are filled
+            # from the line items in _save_line_items — which runs AFTER this
+            # parent INSERT (it needs the parent record_id). Seed zero
+            # placeholders so the initial INSERT satisfies the NOT NULL
+            # constraint; the rollup then overwrites them with the real totals.
+            if self.table_name in self._PRODUCT_REQUIRED_MODULES:
+                for _col in ("final_amount", "total_with_tax", "total_quantity"):
+                    payload.setdefault(_col, 0)
+
+            # Charter: one real thing has one identity (migration 0018).
+            # Resolve / mint the memory_entities row before insert so the
+            # FK is populated atomically with the CRM row.
+            if memory_identity.is_linked_table(self.table_name):
+                eid = memory_identity.resolve_for_insert(
+                    db, self.table_name, payload
+                )
+                if eid is not None:
+                    payload["memory_entity_id"] = eid
+
+            cols = list(payload.keys())
+            placeholders = ", ".join(["%s"] * len(cols))
+            col_list = ", ".join(f'"{c}"' for c in cols)
+            pk = f"{self.table_name}_id"
+            sql = (
+                f'INSERT INTO "{self.table_name}" ({col_list}) VALUES '
+                f"({placeholders}) RETURNING {pk}"
+            )
+            row = db.fetchone(sql, tuple(payload[c] for c in cols))
+            if not row:
+                raise RuntimeError("INSERT did not return a record id")
+            self.record_id = int(row[pk])
+            if line_items is not None:
+                self._save_line_items(line_items)
+            if details:
+                self._save_subdetails(details)
+            self._assign_autonumber_fields(data)
+            self._emit_business_write("create", {}, payload)
+            self._compound_memory(db, payload)
+            self._recompute_formula_fields()
+            self._execute_field_writeback()
+            return self.record_id
+
+    def update(self, data: Dict[str, Any]) -> int:
+        if not self.module:
+            raise ValueError("Module not set")
+        if self.record_id <= 0:
+            raise ValueError("record_id not set for update")
+        self._check_permission("update")
+        # 审批写锁:审批中/已通过(锁定)的记录拒绝改写;未配链或内部流转放行。
+        from hermes.crm.approval.guard import approval_guard
+        approval_guard(self._ensure_db(), self.module_id, self.record_id, self.source)
+        # Same line-item handling as insert — pop before column projection.
+        line_items = _pop_line_items(data)
+        details = _pop_subdetails(data)
+        self._guard_order_has_products(line_items, is_update=True)
+        db = self._ensure_db()
+        with db.transaction():
+            pk = f"{self.table_name}_id"
+            old = db.fetchone(
+                f'SELECT * FROM "{self.table_name}" WHERE {pk} = %s',
+                (self.record_id,),
+            )
+            if not old or old.get("deleted"):
+                raise ValueError("Record does not exist")
+
+            # Per-record write permission: admin/owner/creator only.
+            # 双达语义:cloud 侧确认 can_edit=True 后可通过 set_allow_via_collaborator()
+            # 跳过行级 owner 检查;模块级 _check_permission("update") 已在上方执行。
+            if not self.is_admin and not self._allow_via_collaborator:
+                perm = Permission(db)
+                if not perm.check_record_permission(
+                    self.module_id,
+                    self.user_id,
+                    self.record_id,
+                    old.get("owner_by") or 0,
+                    old.get("created_by") or 0,
+                    "update",
+                ):
+                    raise PermissionError("No permission to update this record")
+
+            self._validate_required({**old, **data})
+            self._validate_select_options(data)
+            payload = self._project_data_to_columns(data)
+            if not payload and line_items is None and not details:
+                return self.record_id  # nothing to change (no fields, no items, no subdetails)
+            if payload:
+                if "owner_by" in payload:
+                    dep = self._derive_department(payload.get("owner_by"))
+                    if dep is not None and "department_id" not in payload:
+                        payload["department_id"] = dep
+                payload["updated_by"] = self.user_id
+
+                # Sync memory_entities.canonical when the CRM name field
+                # changes — old name preserved as an alias.
+                if memory_identity.is_linked_table(self.table_name):
+                    memory_identity.propagate_rename(
+                        db, self.table_name, self.record_id, old, payload
+                    )
+
+                cols = list(payload.keys())
+                set_sql = ", ".join(f'"{c}" = %s' for c in cols)
+                sql = f'UPDATE "{self.table_name}" SET {set_sql} WHERE {pk} = %s'
+                db.execute(sql, tuple(payload[c] for c in cols) + (self.record_id,))
+            if line_items is not None:
+                self._save_line_items(line_items)
+            if details:
+                self._save_subdetails(details)
+            self._emit_business_write("update", old, payload)
+            self._compound_memory(db, payload)
+            self._recompute_formula_fields()
+            self._execute_field_writeback()
+            return self.record_id
+
+    # ---- line items (quotes / salesorders) -----------------------------
+
+    def _save_line_items(self, items: list) -> None:
+        """Replace the parent record's ``{module}_products`` rows.
+
+        DELETE-then-INSERT is the simplest correct strategy for a small
+        list of line items: avoids row-identity tracking on the client,
+        keeps the parent record's product set atomic with the save, and
+        sidesteps partial-update bugs (a row dropped on the client must
+        actually disappear, not silently survive). The trade-off is we
+        churn line_id values on every save — fine since line_id is
+        internal and not user-facing.
+
+        After writing items we recompute the parent's
+        ``total_quantity`` / ``final_amount`` so downstream consumers
+        (list pages, dashboards) see consistent rollups without
+        depending on the client sending those fields.
+        """
+        module_name = (self.module or {}).get("name") if self.module else None
+        if module_name not in {"quotes", "salesorders"}:
+            return
+        if self.record_id <= 0:
+            return
+        db = self._ensure_db()
+        table = f"{module_name}_products"
+        parent_col = f"{module_name}_id"
+
+        db.execute(
+            f'DELETE FROM "{table}" WHERE "{parent_col}" = %s',
+            (self.record_id,),
+        )
+
+        # 额外可配置列:字段管理里给产品行加的自定义字段(如「类型」=
+        # field_picklist_1)。核心计算列(小计/合计/denorm)逻辑不变;这里
+        # 把「已配置、可编辑、且真实存在」的非核心列一并持久化,实现
+        # 「字段管理配什么、产品明细就存什么」。只读/计算列由服务端算,不收客户端值。
+        _CORE_COLS = {
+            parent_col, f"{table}_id", "products_id", "products_name",
+            "productno", "model", "specifications", "quantity", "price",
+            "subtotal", "total", "discount_rate", "tax_rate", "remark",
+            "created_at", "updated_at", "deleted",
+        }
+        _real_cols = {
+            r["column_name"] for r in (db.fetchall(
+                "SELECT column_name FROM information_schema.columns "
+                "WHERE table_schema='public' AND table_name=%s", (table,)
+            ) or [])
+        }
+        extra_cols = [
+            r["field_name"] for r in (db.fetchall(
+                "SELECT mf.field_name FROM module_fields mf "
+                "JOIN collections c ON c.id = mf.module_id "
+                "WHERE c.name = %s "
+                "  AND NOT COALESCE(mf.is_readonly, FALSE) "
+                "  AND NOT COALESCE(mf.is_hidden, FALSE) "
+                "ORDER BY mf.sort_order", (table,)
+            ) or [])
+            if r["field_name"] in _real_cols and r["field_name"] not in _CORE_COLS
+        ]
+
+        total_qty = 0
+        grand_total = 0.0
+        for raw in items:
+            if not isinstance(raw, dict):
+                continue
+            try:
+                products_id = int(raw.get("products_id") or 0)
+            except (TypeError, ValueError):
+                continue
+            if products_id <= 0:
+                continue
+            qty = _to_int(raw.get("quantity"), 0)
+            price = _to_float(raw.get("price"), 0.0)
+            discount_rate = _to_float(raw.get("discount_rate"), 0.0)
+            tax_rate = _to_float(raw.get("tax_rate"), 0.0)
+            net_price = price * (1.0 - discount_rate / 100.0)
+            subtotal = net_price * qty
+            total = subtotal * (1.0 + tax_rate / 100.0)
+            total_qty += qty
+            grand_total += total
+
+            denorm = _denorm_product(db, products_id)
+            products_name = raw.get("products_name") or denorm.get("name") or ""
+            productno = raw.get("productno") or denorm.get("productno") or ""
+            model = raw.get("model") or denorm.get("model") or ""
+            specifications = raw.get("specifications") or denorm.get("specifications") or ""
+            remark = raw.get("remark") or ""
+
+            ins_cols = [
+                parent_col, "products_id", "products_name",
+                "productno", "model", "specifications",
+                "quantity", "price", "subtotal", "total",
+                "discount_rate", "tax_rate", "remark",
+            ]
+            ins_vals = [
+                self.record_id, products_id, products_name,
+                productno, model, specifications,
+                qty, _money_round(price), _money_round(subtotal),
+                _money_round(total),
+                discount_rate, tax_rate, remark,
+            ]
+            # 追加额外配置列(仅 raw 里给了值的)
+            for col in extra_cols:
+                if col in raw:
+                    ins_cols.append(col)
+                    ins_vals.append(raw.get(col))
+            col_sql = ", ".join(f'"{c}"' for c in ins_cols)
+            ph = ", ".join(["%s"] * len(ins_cols))
+            db.execute(
+                f'INSERT INTO "{table}" ({col_sql}) VALUES ({ph})',
+                tuple(ins_vals),
+            )
+
+        # Roll up onto parent. final_amount / total_with_tax are
+        # NUMERIC(18,2) since alembic 0079.
+        db.execute(
+            f'UPDATE "{self.table_name}" '
+            f'SET "total_quantity" = %s, "final_amount" = %s, "total_with_tax" = %s '
+            f'WHERE "{self.table_name}_id" = %s',
+            (
+                total_qty,
+                _money_round(grand_total),
+                _money_round(grand_total),
+                self.record_id,
+            ),
+        )
+
+        # 产品行也触发其子明细的 writeback 规则:内置已算 final_amount/
+        # total_quantity(可靠),writeback 让面板里配置的额外/标准汇总规则
+        # 也生效(标准规则幂等重算同值;用户自定义规则照常滚动)。
+        try:
+            from hermes.crm.field_writeback import FieldWriteback
+            sub = db.fetchone(
+                "SELECT id FROM collections WHERE name = %s",
+                (f"{self.table_name}_products",))
+            if sub:
+                FieldWriteback(db, user_id=self.user_id).execute_writeback(
+                    int(sub["id"]),
+                    {f"{self.table_name}_id": int(self.record_id)})
+        except Exception:
+            pass  # 汇总 advisory,失败不阻断保存
+
+    # ---- autoNumber fields (plan §7) -----------------------------------
+
+    def _assign_autonumber_fields(self, data: Dict[str, Any]) -> None:
+        """Draw + write a number for each autoNumber field with no
+        supplied value. Called from :meth:`insert` after the row INSERT,
+        so the ``UPDATE`` runs in the same implicit transaction.
+
+        The running counter is the per-field Postgres SEQUENCE
+        ``autonum_<table>_<field>`` created by ``provision_field``. An
+        empty / whitespace incoming value is treated as "not supplied" so
+        the engine fills it; a non-empty value is left untouched (lets an
+        import preserve historical numbers).
+        """
+        if not self.module or self.record_id <= 0:
+            return
+        autonumber_fields = [
+            f for f in self._editable_fields()
+            if (f.get("field_type") or "") == "autoNumber"
+        ]
+        if not autonumber_fields:
+            return
+        from datetime import datetime, timezone
+        from hermes.crm.autonumber import format_number
+
+        db = self._ensure_db()
+        pk = f"{self.table_name}_id"
+        now = datetime.now(timezone.utc)
+        for f in autonumber_fields:
+            fname = str(f.get("field_name") or "").strip()
+            if not fname:
+                continue
+            incoming = data.get(fname)
+            if incoming is not None and str(incoming).strip() != "":
+                continue  # caller supplied a value — keep it
+            config = self._field_config(f).get("autonumber") or {}
+            seq_name = f"autonum_{self.table_name}_{fname}"
+            seq_row = db.fetchone(
+                "SELECT nextval(%s) AS nextval", (seq_name,)
+            )
+            seq_value = int(seq_row["nextval"])
+            formatted = format_number(config, seq_value, now)
+            db.execute(
+                f'UPDATE "{self.table_name}" SET "{fname}" = %s '
+                f"WHERE {pk} = %s",
+                (formatted, self.record_id),
+            )
+
+    # ---- event emit (plan §6.4) ----------------------------------------
+
+    def _compound_memory(self, db, payload: Dict[str, Any]) -> None:
+        """记忆复利(P1 §7.2):同事务把业务字段并入 memory_entities.attributes,
+        并经 after_commit 把字段文本 embedding 进记忆图谱。未 link entity 的
+        记录(含自定义模块)自动 no-op。"""
+        memory_compounding.sync_entity_attributes(
+            db, self.table_name, self.record_id, payload)
+        memory_compounding.schedule_field_embedding(
+            db, self.table_name, self.record_id, self.user_id, payload,
+            headline=payload.get(f"{self.table_name}_name"))
+
+    def _save_subdetails(self, details: Dict[str, Any]) -> None:
+        """整组替换本记录的 generic 子明细行(DELETE-then-INSERT)。
+
+        P2b:``details`` 形如 {子明细名: [行dict]}。每个子明细须是本模块的
+        generic 子明细(collections.parent_module_id=本模块, detail_kind=
+        'generic'),否则跳过。只插该子表真实存在的列(防注入/未知列)。
+        权限继承:子明细随父记录写,本方法不单独鉴权(父记录已鉴权)。
+        """
+        if not isinstance(details, dict) or not details:
+            return
+        if self.record_id <= 0:
+            return
+        db = self._ensure_db()
+        parent_col = f"{self.table_name}_id"
+        valid_kids = {
+            r["name"]: int(r["id"]) for r in (db.fetchall(
+                "SELECT id, name FROM collections WHERE parent_module_id = %s "
+                "AND detail_kind = 'generic'", (int(self.module_id),)
+            ) or [])
+        }
+        for child, rows in details.items():
+            if child not in valid_kids:
+                continue
+            if not isinstance(rows, list):
+                continue
+            # 该子表真实列(过滤未知键)+ 列类型(用于把空值/非法值在入库前
+            # 收敛成 NULL 或干净的 400,而不是让 psycopg 抛 500)。
+            _col_rows = db.fetchall(
+                "SELECT column_name, data_type FROM information_schema.columns "
+                "WHERE table_schema='public' AND table_name=%s", (child,)
+            ) or []
+            cols = {r["column_name"] for r in _col_rows}
+            col_types = {r["column_name"]: (r["data_type"] or "").lower() for r in _col_rows}
+            # field_name → (label, field_type),给校验错误用可读标签 + 区分
+            # user/number 的提示文案。
+            field_meta = {
+                str(fr.get("field_name") or ""): (
+                    fr.get("field_label") or fr.get("field_name") or "",
+                    (fr.get("field_type") or "").lower(),
+                )
+                for fr in (db.fetchall(
+                    "SELECT field_name, field_label, field_type FROM module_fields "
+                    "WHERE module_id = %s", (valid_kids[child],),
+                ) or [])
+            }
+            # 行内 formula:该子明细的公式字段(用同行其它字段算出,服务端权威、只读)
+            formula_fields = []
+            for fr in (db.fetchall(
+                "SELECT field_name, field_config FROM module_fields "
+                "WHERE module_id = %s AND field_type = 'formula'",
+                (valid_kids[child],),
+            ) or []):
+                cfg = fr.get("field_config")
+                if isinstance(cfg, str):
+                    try:
+                        cfg = json.loads(cfg)
+                    except Exception:
+                        cfg = {}
+                expr = ((cfg or {}).get("formula") or {}).get("expression")
+                fn = str(fr.get("field_name") or "").strip()
+                if fn and fn in cols and expr and str(expr).strip():
+                    formula_fields.append((fn, str(expr)))
+            db.execute(
+                f'DELETE FROM "{child}" WHERE "{parent_col}" = %s',
+                (int(self.record_id),),
+            )
+            for raw in rows:
+                if not isinstance(raw, dict):
+                    continue
+                payload = {}
+                for k, v in raw.items():
+                    if k not in cols or k in (f"{child}_id", parent_col,
+                                              "created_at", "updated_at"):
+                        continue
+                    _label, _ftype = field_meta.get(k, (k, ""))
+                    payload[k] = _coerce_subdetail_value(
+                        v, col_types.get(k, ""), _label, _ftype,
+                    )
+                payload[parent_col] = int(self.record_id)
+                # 行内公式重算:对同行求值,覆盖任何客户端传入值(formula 只读)
+                if formula_fields:
+                    from hermes.crm.formula import FormulaError, evaluate
+                    for fn, expr in formula_fields:
+                        try:
+                            payload[fn] = evaluate(expr, dict(raw))
+                        except FormulaError:
+                            pass  # 坏公式跳过该字段,不阻断保存
+                keys = list(payload.keys())
+                ph = ", ".join(["%s"] * len(keys))
+                col_list = ", ".join(f'"{k}"' for k in keys)
+                db.execute(
+                    f'INSERT INTO "{child}" ({col_list}) VALUES ({ph})',
+                    tuple(payload[k] for k in keys),
+                )
+            # 触发该子明细的 writeback 汇总规则(如 明细金额 SUM → 父合计字段)。
+            # execute_writeback 按「源.<父表>_id = 父记录」聚合,故 row 传父 FK。
+            try:
+                from hermes.crm.field_writeback import FieldWriteback
+                FieldWriteback(db, user_id=self.user_id).execute_writeback(
+                    valid_kids[child], {parent_col: int(self.record_id)})
+            except Exception:
+                pass  # 汇总失败不阻断子明细保存(advisory)
+
+    def _emit_business_write(
+        self,
+        op: str,
+        old: Dict[str, Any],
+        new: Dict[str, Any],
+    ) -> None:
+        """Thin adapter over :func:`bridge.events.emit_business_write`.
+
+        Keeps the in-class method as the single call site so the
+        hook's field-catalog arg is populated from the already-loaded
+        cache — no redundant ``module_fields`` fetch on the hot write
+        path.
+        """
+        module_name = (self.module or {}).get("name") if self.module else None
+        if not module_name:
+            return
+        # Lazy import — charter §"hermes is the data plane" requires
+        # hermes/* to never import hermes_cloud/* at module load.
+        from hermes_cloud.app.bridge.events import emit_business_write
+        emit_business_write(
+            db=self._ensure_db(),
+            module_id=self.module_id,
+            module_name=module_name,
+            record_id=int(self.record_id),
+            op=op,
+            old=old,
+            new=new,
+            user_id=int(self.user_id),
+            source=self.source,
+            field_catalog=self._editable_fields(),
+        )
+
+    # ---- formula fields — field_config engine (design §8) --------------
+
+    def _recompute_formula_fields(self) -> None:
+        """Re-evaluate every ``field_type='formula'`` column for this
+        record using the safe :mod:`hermes.crm.formula` engine.
+
+        Formulas are same-record only: read the just-written row, evaluate
+        each ``field_config.formula.expression`` against that row's
+        values, and write the ``NUMERIC`` column. Called on both CREATE
+        and UPDATE — values are recomputed every write so the stored
+        column never drifts from its inputs.
+
+        A broken expression (parse error, division by zero) skips just
+        that field — one bad formula must never abort the caller's save.
+        """
+        if not self.module or self.record_id <= 0:
+            return
+        formula_fields = [
+            f for f in self._editable_fields()
+            if (f.get("field_type") or "") == "formula"
+        ]
+        if not formula_fields:
+            return
+        from hermes.crm.formula import FormulaError, evaluate
+
+        db = self._ensure_db()
+        pk = f"{self.table_name}_id"
+        row = db.fetchone(
+            f'SELECT * FROM "{self.table_name}" WHERE {pk} = %s',
+            (self.record_id,),
+        )
+        if not row:
+            return
+        for f in formula_fields:
+            fname = str(f.get("field_name") or "").strip()
+            if not fname:
+                continue
+            expr = (
+                self._field_config(f).get("formula") or {}
+            ).get("expression")
+            if not expr or not str(expr).strip():
+                continue
+            try:
+                result = evaluate(str(expr), dict(row))
+            except FormulaError:
+                # broken formula — skip this field, keep saving the rest
+                continue
+            db.execute(
+                f'UPDATE "{self.table_name}" SET "{fname}" = %s '
+                f"WHERE {pk} = %s",
+                (result, self.record_id),
+            )
+
+    # ---- field writeback (kacrm port, plan §9) -------------------------
+
+    def _execute_field_writeback(self) -> None:
+        """Propagate just-saved values up to parent records per
+        ``field_writeback`` rules. Failures are swallowed.
+
+        Same abort-txn concern as formula recomputation: if any
+        statement here errors, Postgres marks the implicit txn aborted
+        and later writes fail with ``InFailedSqlTransaction``. We
+        ``conn.rollback()`` on the error path so the caller (e.g. the
+        gateway approve flow) can keep using the connection.
+        """
+        if not self.module or self.record_id <= 0:
+            return
+        db = self._ensure_db()
+        conn = db._conn  # type: ignore[attr-defined]
+        try:
+            from hermes.crm.field_writeback import FieldWriteback
+            pk = f"{self.table_name}_id"
+            row = db.fetchone(
+                f'SELECT * FROM "{self.table_name}" WHERE {pk} = %s',
+                (self.record_id,),
+            )
+            if not row:
+                return
+            FieldWriteback(db, user_id=self.user_id).execute_writeback(
+                self.module_id, row
+            )
+        except Exception:
+            try:
+                conn.rollback()  # clear aborted state so caller can continue
+            except Exception:
+                pass
