+"""Recent-interactions query helper for skill mini-agents.
+
+Used by ``crm_analyst.analyze_team`` to fetch a manager's (or any
+actor's) recent activity stream as input context for the LLM.
+
+Returns plain dicts (not ORM objects) so the result is JSON-serializable
+and trivially mockable in tests.
+"""
+from __future__ import annotations
+import datetime as dt
+import json
+from typing import Any, Dict, List, Optional
+
+
+def recent_interactions(
+    db,
+    *,
+    actor_id: int,
+    kind: Optional[str] = None,
+    since_days: int = 14,
+    limit: int = 50,
+) -> List[Dict[str, Any]]:
+    """Return interactions where actors[0].id = actor_id, ordered DESC.
+
+    NOTE: this helper does NOT apply visibility filter — caller is the
+    skill running on behalf of the manager themselves, so self_only
+    rows belong to caller anyway.
+    """
+    since = dt.datetime.utcnow() - dt.timedelta(days=since_days)
+    sql = (
+        "SELECT id, kind, occurred_at, actors, subjects, content, source, provenance "
+        "  FROM interactions "
+        " WHERE actors @> %s::jsonb "
+        "   AND occurred_at >= %s "
+    )
+    params: List[Any] = [json.dumps([{"type": "user", "id": int(actor_id)}]), since]
+    if kind:
+        sql += " AND kind = %s"
+        params.append(kind)
+    sql += " ORDER BY occurred_at DESC LIMIT %s"
+    params.append(int(limit))
+    return db.fetchall(sql, tuple(params)) or []
